    @Override

    public List<Map<String, Object>> getUnitSnapshot(int maxUnits) {

        List<Map<String, Object>> snapshot = new ArrayList<>();

        int limit = Math.min(maxUnits, units.size());

        for (int i = 0; i < limit; i++) {

            Unit u = units.get(i);

            Map<String, Object> data = new java.util.LinkedHashMap<>();

            data.put("id", i);

            data.put("type", u.type.name());

            data.put("x", u.x);

            data.put("y", u.y);

            data.put("z", u.z);

            data.put("mass", u.mass);

            data.put("energy", u.energy);

            data.put("bonds", u.bonds.size());

            snapshot.add(data);

        }

        return snapshot;

    }



