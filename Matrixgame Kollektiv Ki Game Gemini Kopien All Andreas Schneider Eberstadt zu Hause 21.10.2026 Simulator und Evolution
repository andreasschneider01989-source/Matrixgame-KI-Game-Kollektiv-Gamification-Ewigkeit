     * @param dt               Zeitschritt Δt (Kausalkette)
     * @param globalEntropyPool Globaler Entropie-Pool des Systems
     */
    public static void computeGravityAndPhysics(List<Unit> unitList, double dt, double globalEntropyPool) {
        int n = unitList.size();
        if (n < 2) return;

        // 1. Differentieller Kraft- & Beschleunigungs-Vektor (3D: x, y, z)
        double[] ax = new double[n];
        double[] ay = new double[n];
        double[] az = new double[n];

        // 2. Parallele N-Körper Gravitationsberechnung (Wechselwirkung 2n Entropie-Pfade)
        for (int i = 0; i < n; i++) {
            Unit u1 = unitList.get(i);
            if (!u1.updatePositionAktiv && !u1.movable) continue; // Dynamische Trägheit

            for (int j = i + 1; j < n; j++) {
                Unit u2 = unitList.get(j);

                // Distanzvektor Delta r
                double dx = u2.x - u1.x;
                double dy = u2.y - u1.y;
                double dz = u2.z - u1.z;

                // Euklidische Distanz r² mit Gravitations-Softening (Softened Newtonian Gravity)
                double distSq = dx * dx + dy * dy + dz * dz + EPSILON_SINGULARITY;
                double dist = Math.sqrt(distSq);

                // Newton-Kraft: F = G * (m1 * m2) / r²
                // Entropie-Modulation: Niedrige Entropie = Stabilere kohärente Gravitation
                double entropyFactor = Math.max(0.1, 1.0 - (globalEntropyPool / 1000.0));
                double force = (G * u1.mass * u2.mass / distSq) * entropyFactor;

                // Normierter Einheitsvektor
                double fx = force * (dx / dist);
                double fy = force * (dy / dist);
                double fz = force * (dz / dist);

                // Beschleunigung a = F / m
                ax[i] += fx / u1.mass;
                ay[i] += fy / u1.mass;
                az[i] += fz / u1.mass;

                // Gegenwirkungsprinzip (3. Newtonsches Axiom: Actio = Reactio)
                ax[j] -= fx / u2.mass;
                ay[j] -= fy / u2.mass;
                az[j] -= fz / u2.mass;
            }
        }

        // 3. Integration & Kollisionsprüfungs-Schleife (Verlet/Euler-Hybrid)
        for (int i = 0; i < n; i++) {
            Unit u = unitList.get(i);

            if (!u.updatePositionAktiv && !u.movable) continue;

            // Geschwindigkeits-Update: v(t+dt) = v(t) + a * dt
            u.vx += ax[i] * dt;
            u.vy += ay[i] * dt;
            u.vz += az[i] * dt;

            // Relativistischer Geschwindigkeits-Limes (Max Speed = c)
            double currentSpeed = Math.sqrt(u.vx * u.vx + u.vy * u.vy + u.vz * u.vz);
            if (currentSpeed > C_LIGHT) {
                double scale = C_LIGHT / currentSpeed;
                u.vx *= scale;
                u.vy *= scale;
                u.vz *= scale;
            }

            // Positions-Update: r(t+dt) = r(t) + v * dt
            u.x += u.vx * dt;
            u.y += u.vy * dt;
            u.z += u.vz * dt;

            // Kinetische Energie-Kalkulation (E_kin = 0.5 * m * v²)
            u.EKin = 0.5 * u.mass * (u.vx * u.vx + u.vy * u.vy + u.vz * u.vz);

            // Stochastische Entropie-Fluktuation (Bewusstseins-Rauschen)
            if (u.entropieMoveAktiv) {
                u.x += (Math.random() - 0.5) * u.entropieMoveSpeed2ProCent;
                u.y += (Math.random() - 0.5) * u.entropieMoveSpeed2ProCent;
                u.z += (Math.random() - 0.5) * u.entropieMoveSpeed2ProCent;
            }
        }

        // 4. Inelastische Kollision & Masse-Fusion (Akkretion)
        resolveCollisions(unitList);
    }

    /**
     * Behandelt Kollisionen: Verschmilzt Einheiten bei Berührung unter Impulserhaltung.
     */
    private static void resolveCollisions(List<Unit> unitList) {
        for (int i = 0; i < unitList.size(); i++) {
            Unit u1 = unitList.get(i);
            for (int j = i + 1; j < unitList.size(); j++) {
                Unit u2 = unitList.get(j);

                double dx = u2.x - u1.x;
                double dy = u2.y - u1.y;
                double dz = u2.z - u1.z;
                double dist = Math.sqrt(dx * dx + dy * dy + dz * dz);

                // Kollisions-Kriterium: Abstand kleiner als Summe der Radien
                if (dist < (u1.radius + u2.radius)) {
                    // Impulserhaltung: v_neu = (m1*v1 + m2*v2) / (m1 + m2)
                    double totalMass = u1.mass + u2.mass;
                    u1.vx = (u1.mass * u1.vx + u2.mass * u2.vx) / totalMass;
                    u1.vy = (u1.mass * u1.vy + u2.mass * u2.vy) / totalMass;
                    u1.vz = (u1.mass * u1.vz + u2.mass * u2.vz) / totalMass;

                    // Massen- & Volumen-Akkretion
                    u1.mass = totalMass;
                    u1.radius = (int) Math.cbrt(Math.pow(u1.radius, 3) + Math.pow(u2.radius, 3)); // Volumen-Addition

                    // Hawkins-Frequenz-Farb-Verschmelzung (Harmonische Synthese)
                    u1.color = combineColors(u1.color, u2.color);

                    // Die kleiner gegangene Einheit löschen
                    unitList.remove(j);
                    j--; // Index-Korrektur
                }
            }
        }
    }

    private static Color combineColors(Color c1, Color c2) {
        if (c1 == null) return c2;
        if (c2 == null) return c1;
        return new Color(
            (c1.getRed() + c2.getRed()) / 2,
            (c1.getGreen() + c2.getGreen()) / 2,
            (c1.getBlue() + c2.getBlue()) / 2
        );
    }
}
