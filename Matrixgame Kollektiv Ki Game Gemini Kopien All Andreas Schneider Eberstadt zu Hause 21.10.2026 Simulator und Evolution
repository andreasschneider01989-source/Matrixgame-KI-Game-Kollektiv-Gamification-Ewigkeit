public class GravityEngine {

    // Universelle Gravitationskonstante (Skalierbar für Game-Design oder Reallabor)
    public static double G = 6.67430e-11; 
    
    // Planck- / Quanten-Erweichungseinfluss (Verhindert Division-by-Zero & kognitive Singularitäten)
    public static final double EPSILON_SINGULARITY = 1e-4; 
    
    // Lichtgeschwindigkeit c für Relativitäts-Grenzen
