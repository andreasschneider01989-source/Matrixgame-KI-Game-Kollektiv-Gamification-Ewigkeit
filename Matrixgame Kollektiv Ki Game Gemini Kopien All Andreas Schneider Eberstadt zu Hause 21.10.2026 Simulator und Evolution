        }

    }



    @Override public void setBindingEnabled(boolean enabled) { bindingEnabled = enabled; }

    @Override public void setAutoReplication(boolean enabled) { autoReplication = enabled; }



    @Override

    public void reset() {

        initUnits(units.isEmpty() ? DEFAULT_UNIT_COUNT : units.size());

    }



    @Override

    public void triggerManualReplication() {

        if (selected != null) replicate(selected);

    }



    // ===================== MAIN =====================

