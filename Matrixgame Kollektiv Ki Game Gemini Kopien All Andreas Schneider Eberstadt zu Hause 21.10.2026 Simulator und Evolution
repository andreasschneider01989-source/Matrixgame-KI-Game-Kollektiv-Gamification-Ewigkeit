    public boolean leben = true;
    public boolean isSelected = false;
    
    // Entropie & Verhaltens-Flags
    public boolean updatePositionAktiv = true;
    public boolean entropieMoveAktiv = false;
    public double entropieMoveSpeed2ProCent = 10.0;

    public Unit() {
        // Standardkonstruktor
    }

    public Unit(double x, double y, double z, double mass, int radius, Color color) {
        this.x = x;
        this.y = y;
        this.z = z;
        this.mass = mass;
        this.radius = radius;
        this.color = color;
    }

    public double getDistance(Unit other) {
        if (other == null) return Double.MAX_VALUE;
        return getDistanceTo(other.x, other.y, other.z);
    }

    public double getDistanceTo(double tx, double ty, double tz) {
        double dx = tx - x;
        double dy = ty - y;
        double dz = tz - z;
        return Math.sqrt(dx * dx + dy * dy + dz * dz);
    }
