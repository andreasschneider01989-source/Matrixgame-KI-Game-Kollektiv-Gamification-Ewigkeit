        return String.format(Locale.US,

                "[Step %d] Units:%d Bonds:%d AvgE:%.2f AvgBonds:%.2f Isolated:%d Rep:%d Death:%d | A:%d U:%d G:%d C:%d | Mode:%s Binding:%s AutoRep:%s",

                stepCount, units.size(), activeBonds, avgEnergy, avgBonds,

                isolatedCount, replicationCount, deathCount,

                countA, countU, countG, countC,

