package ordner1;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.List;
import java.util.concurrent.CopyOnWriteArrayList;

/**
 * Hauptspielfeld & UI für den Matrixgame Simulator.
 */
public class MainGame extends JPanel {
    private List<Unit> unitList = new CopyOnWriteArrayList<>();
    private double zoom = 15.0;
    private double kameraX = 0;
    private double kameraY = 0;
    private int lastMouseX, lastMouseY;
    private boolean isDraggingCamera = false;
    
    private Timer simulationTimer;
    private double globalEntropyPool = 50.0;
    private long simulationsSchritte = 0;

    public MainGame() {
        setPreferredSize(new Dimension(1200, 900));
        setBackground(Color.BLACK);
        initListeners();
        initUnits();
        startSimulationLoop();
    }

    public void initUnits() {
        // Erzeugt ein harmonisches Start-Universum mit Orbit-Geschwindigkeiten
        for (int i = 0; i < 150; i++) {
            double x = (Math.random() - 0.5) * 40.0;
            double y = (Math.random() - 0.5) * 40.0;
            double z = (Math.random() - 0.5) * 40.0;
            
            double vx = -y * 0.2 + (Math.random() - 0.5) * 0.5;
            double vy = x * 0.2 + (Math.random() - 0.5) * 0.5;
            double vz = (Math.random() - 0.5) * 0.5;
            
            double mass = 5.0 + Math.random() * 20.0;
            int radius = Math.max(2, (int) (mass * 0.3));
            
            Color col = new Color(
                (int)(Math.random() * 155 + 100),
                (int)(Math.random() * 155 + 100),
                (int)(Math.random() * 155 + 100)
            );

            Unit u = new Unit(x, y, z, mass, radius, col);
            u.vx = vx;
            u.vy = vy;
            u.vz = vz;
            u.entropieMoveAktiv = true;
            u.entropieMoveSpeed2ProCent = 20;
            unitList.add(u);
        }
    }

    private void initListeners() {
        addMouseListener(new MouseAdapter() {
            @Override
            public void mousePressed(MouseEvent e) {
                if (SwingUtilities.isLeftMouseButton(e)) {
                    isDraggingCamera = true;
                    lastMouseX = e.getX();
                    lastMouseY = e.getY();
                }
            }
            @Override
            public void mouseReleased(MouseEvent e) {
                isDraggingCamera = false;
            }
        });

        addMouseMotionListener(new MouseMotionAdapter() {
            @Override
            public void mouseDragged(MouseEvent e) {
                if (isDraggingCamera) {
                    int dx = e.getX() - lastMouseX;
                    int dy = e.getY() - lastMouseY;
                    kameraX -= dx / zoom;
                    kameraY -= dy / zoom;
                    lastMouseX = e.getX();
                    lastMouseY = e.getY();
                    repaint();
                }
            }
        });

        addMouseWheelListener(e -> {
            if (e.getWheelRotation() < 0) {
                zoom *= 1.1;
            } else {
                zoom /= 1.1;
            }
            repaint();
        });
    }

    private void startSimulationLoop() {
        // Game-Loop (Ticker alle 20ms = ~50 FPS)
        simulationTimer = new Timer(20, e -> {
            GravityEngine.computeGravityAndPhysics(unitList, 0.05, globalEntropyPool);
            simulationsSchritte++;
            
            // Entropie-Pool dynamisch schwanken lassen
            globalEntropyPool += (Math.random() - 0.48) * 0.1;
            globalEntropyPool = Math.max(10.0, Math.min(100.0, globalEntropyPool));

            repaint();
        });
        simulationTimer.start();
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2d = (Graphics2D) g;
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        int width = getWidth();
        int height = getHeight();
        double centerX = width / 2.0 + kameraX * zoom;
        double centerY = height / 2.0 + kameraY * zoom;

        // Koordinatenachsen
        g2d.setColor(new Color(30, 30, 30));
        g2d.drawLine(0, (int)centerY, width, (int)centerY);
        g2d.drawLine((int)centerX, 0, (int)centerX, height);

        // Einheiten zeichnen
        for (Unit u : unitList) {
            int screenX = (int) (centerX + u.x * zoom);
            int screenY = (int) (centerY + u.y * zoom);
            int r = Math.max(2, (int) (u.radius * Math.sqrt(zoom / 15.0)));

            g2d.setColor(u.color);
            g2d.fillOval(screenX - r, screenY - r, r * 2, r * 2);
            
            // Z-Achsen-Highlight für Tiefe
            if (u.z > 0) {
                g2d.setColor(new Color(255, 255, 255, 80));
                g2d.drawOval(screenX - r - 1, screenY - r - 1, (r + 1) * 2, (r + 1) * 2);
            }
