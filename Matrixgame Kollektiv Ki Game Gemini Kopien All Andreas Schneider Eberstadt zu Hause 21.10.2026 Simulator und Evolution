package ordner1;

import java.awt.Color;
import java.util.List;

/**
 * Universelle Gravitations- und Physik-Engine für das Matrixgame.
 * Vereint Newtonsche N-Körper-Anziehung, Singularitätsschutz, Relativitätslimes & Akkretion.
 */
public class GravityEngine {
    public static double G = 0.5; // Skalierbare Gravitationskonstante für das Spiel
    public static final double EPSILON_SINGULARITY = 1e-3; // Verhindert Division durch Null
    public static final double C_LIGHT = 1000.0; // Relativistischer Geschwindigkeits-Limes

    public static void computeGravityAndPhysics(List<Unit> unitList, double dt, double globalEntropyPool) {
        int n = unitList.size();
        if (n < 2) return;

        double[] ax = new double[n];
        double[] ay = new double[n];
        double[] az = new double[n];

        // 1. Parallele N-Körper Gravitationsberechnung
        for (int i = 0; i < n; i++) {
            Unit u1 = unitList.get(i);
            if (!u1.updatePositionAktiv && !u1.movable) continue;

            for (int j = i + 1; j < n; j++) {
                Unit u2 = unitList.get(j);

                double dx = u2.x - u1.x;
                double dy = u2.y - u1.y;
                double dz = u2.z - u1.z;

                double distSq = dx * dx + dy * dy + dz * dz + EPSILON_SINGULARITY;
                double dist = Math.sqrt(distSq);

                // Entropie-Kopplung: Hohe Entropie streut die Kraft, niedrige bündelt sie
                double entropyFactor = Math.max(0.1, 1.0 - (globalEntropyPool / 200.0));
                double force = (G * u1.mass * u2.mass / distSq) * entropyFactor;

                double fx = force * (dx / dist);
                double fy = force * (dy / dist);
                double fz = force * (dz / dist);

                ax[i] += fx / u1.mass;
                ay[i] += fy / u1.mass;
                az[i] += fz / u1.mass;

                ax[j] -= fx / u2.mass;
                ay[j] -= fy / u2.mass;
                az[j] -= fz / u2.mass;
            }
        }

        // 2. Integration & Geschwindigkeits-Updates
        for (int i = 0; i < n; i++) {
            Unit u = unitList.get(i);
            if (!u.updatePositionAktiv && !u.movable) continue;

            u.vx += ax[i] * dt;
            u.vy += ay[i] * dt;
            u.vz += az[i] * dt;

            // Relativistische Begrenzung (Max Speed = c)
            double speed = Math.sqrt(u.vx * u.vx + u.vy * u.vy + u.vz * u.vz);
            if (speed > C_LIGHT) {
                double scale = C_LIGHT / speed;
                u.vx *= scale;
                u.vy *= scale;
                u.vz *= scale;
            }

            u.x += u.vx * dt;
            u.y += u.vy * dt;
            u.z += u.vz * dt;

            u.EKin = 0.5 * u.mass * (u.vx * u.vx + u.vy * u.vy + u.vz * u.vz);

            // Stochastisches Entropie-Rauschen
            if (u.entropieMoveAktiv) {
                u.x += (Math.random() - 0.5) * (u.entropieMoveSpeed2ProCent * 0.1);
                u.y += (Math.random() - 0.5) * (u.entropieMoveSpeed2ProCent * 0.1);
                u.z += (Math.random() - 0.5) * (u.entropieMoveSpeed2ProCent * 0.1);
            }
        }

        // 3. Inelastische Kollisionen & Masse-Fusion
        resolveCollisions(unitList);
    }

    private static void resolveCollisions(List<Unit> unitList) {
        for (int i = 0; i < unitList.size(); i++) {
            Unit u1 = unitList.get(i);
            for (int j = i + 1; j < unitList.size(); j++) {
                Unit u2 = unitList.get(j);

                double dx = u2.x - u1.x;
                double dy = u2.y - u1.y;
                double dz = u2.z - u1.z;
                double dist = Math.sqrt(dx * dx + dy * dy + dz * dz);

                // Kollisions-Check basierend auf Radius-Berührung
                if (dist < (u1.radius + u2.radius)) {
                    double totalMass = u1.mass + u2.mass;
                    
                    // Impulserhaltung
                    u1.vx = (u1.mass * u1.vx + u2.mass * u2.vx) / totalMass;
                    u1.vy = (u1.mass * u1.vy + u2.mass * u2.vy) / totalMass;
                    u1.vz = (u1.mass * u1.vz + u2.mass * u2.vz) / totalMass;

                    u1.mass = totalMass;
                    u1.radius = (int) Math.cbrt(Math.pow(u1.radius, 3) + Math.pow(u2.radius, 3));
                    u1.color = combineColors(u1.color, u2.color);

                    unitList.remove(j);
                    j--;
                }
            }
        }
    }

    private static Color combineColors(Color c1, Color c2) {
        if (c1 == null) return c2;
        if (c2 == null) return c1;
        return new Color(
            Math.min(255, (c1.getRed() + c2.getRed()) / 2),
            Math.min(255, (c1.getGreen() + c2.getGreen()) / 2),
            Math.min(255, (c1.getBlue() + c2.getBlue()) / 2)
        );
    }
}
