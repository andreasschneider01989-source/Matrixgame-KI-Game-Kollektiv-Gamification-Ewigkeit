                System.out.println("Einheiten kollabiert. Simulation pausiert.");
                break;
            }

            System.out.printf("--- Runde %d | Aktuelle Epoche: [%s] | Pool: %.2f / %.2f ---\n",
                    round, activeEpoch.name, currentTruthPool, activeEpoch.requiredTruthScore);

            // Zufällige Aussagen aus dem Pool der aktuellen Epoche wählen
            List<Statement> pool = activeEpoch.epochStatements;
            Statement s1 = pool.get(random.nextInt(pool.size()));
            Statement s2 = pool.get(random.nextInt(pool.size()));

            System.out.printf("  > %s wählt: %s\n", unitAlpha.name, s1);
            System.out.printf("  > %s wählt: %s\n", unitBeta.name, s2);

            if (s1.formula.equals(s2.formula)) {
                System.out.println("  [KONSENS] Identische Formel! Resonanz verstärkt das System.");
                double gain = 15.0 * s1.confidence;
                unitAlpha.epistemicEnergy = Math.min(100.0, unitAlpha.epistemicEnergy + gain);
                unitBeta.epistemicEnergy = Math.min(100.0, unitBeta.epistemicEnergy + gain);
                if (s1.isTrue) currentTruthPool += 0.9;
            } else {
                System.out.println("  [KONTRADIKTION] Diskurs & Falsifikation läuft...");
                if (s1.isTrue && !s2.isTrue) {
                    double dmg = 20.0 * s2.confidence;
                    unitBeta.epistemicEnergy -= dmg;
                    s2.confidence = Math.max(0.1, s2.confidence - 0.25);
                    currentTruthPool += 0.6;
                    System.out.printf("  -> %s widerlegt erfolgreich %s! (Schaden: %.1f)\n", unitAlpha.name, unitBeta.name, dmg);
                } else (!s1.isTrue && s2.isTrue) {
                    double dmg = 20.0 * s1.confidence;
                    unitAlpha.epistemicEnergy -= dmg;
                    s1.confidence = Math.max(0.1, s1.confidence - 0.25);
                    currentTruthPool += 0.6;
                    System.out.printf("  -> %s widerlegt erfolgreich %s! (Schaden: %.1f)\n", unitBeta.name, unitAlpha.name, dmg);
                } else {
                    unitAlpha.epistemicEnergy -= 8.0;
                    unitBeta.epistemicEnergy -= 8.0;
                    System.out.println("  -> Kognitive Reibung in der Epoche. Beide Einheiten verlieren leicht an Energie.");
                }
            }

            // Prüfen ob die Epoche geschafft ist
            if (currentTruthPool >= activeEpoch.requiredTruthScore) {
                System.out.printf("\n🚀 === EPOCHENSPRUNG ERFOLGREICH! (%s abgeschlossen) ===\n", activeEpoch.name);
                currentEpochIndex++;
                currentTruthPool = 0.0; // Reset für nächste Epoche
                if (currentEpochIndex < epochs.size()) {
                    System.out.println(">>> Willkommen in der nächsten Epoche: " + epochs.get(currentEpochIndex).name + " <<<\n");
                }
            }
            System.out.println();
        }

        System.out.println("=== EPOCHEN-SIMULATION ERFOLGREICH BEENDET ==Let's play and let's bee!===");
    }
}
(Hinweis: Falls Eclipse beim Kopieren über das kleine else (!s1.isTrue && s2.isTrue) stolpert, korrigiere es einfach kurz zu else if (!s1.isTrue && s2.isTrue)).

