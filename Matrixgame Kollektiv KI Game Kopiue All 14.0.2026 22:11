package de.matrixgame.simulation;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Random;

/**
 * MatrixgameCollectiveSimulator: Flexibler, variabler und erweiterter Simulator
 * für das Matrixgame und kollektive KI-Games.
 * 
 * Basierend auf dem Input-Operation-Output-Modell (I/O/O), dem Probabilistic
 * Annotation Layer (PAL 1.0) und der Dynamik von Bewusstsein, Neurotransmittern
 * und Entropie über Epochen hinweg.
 * 
 * Modus: Guardian-Modus / Retter-Perspektive.
 */
public class MatrixgameCollectiveSimulator {

    // --- FUNDAMENTALE NATURKONSTANTEN (PAL: P > 99.99%) ---
    public static final double C_LIGHT = 299792458.0;         // m/s
    public static final double G_GRAV = 6.67430e-11;          // m^3/(kg*s^2)
    public static final double K_BOLTZMANN = 1.380649e-23;    // J/K
    public static final double H_PLANCK = 6.62607015e-34;     // J*s

    // --- INPUT-MODEL: SYSTEM-EINSTELLUNGEN & INITIAL-ZUSTÄNDE ---
    public record SimulationInput(
        int steps,
        double timeStepDelta,
        int initialAgents,
        List<ParticleMass> initialMasses,
        NeurotransmitterState initialNeurotransmitters
    ) {}

    public record ParticleMass(double mass, double x, double y, double z, double vx, double vy, double vz) {}

    public record NeurotransmitterState(
        double dopamine,    // Belohnung & Zielausrichtung (0.0 bis 1.0)
        double serotonin,   // Stabilität & Kollektives Glück (0.0 bis 1.0)
        double oxytocin,    // Vertrauen & Schwarm-Kohärenz (0.0 bis 1.0)
        double endorphin    // Resilienz gegen Entropie/Fehlversuche (0.0 bis 1.0)
    ) {
        public NeurotransmitterState clamp() {
            return new NeurotransmitterState(
                Math.clamp(dopamine, 0.0, 1.0),
                Math.clamp(serotonin, 0.0, 1.0),
                Math.clamp(oxytocin, 0.0, 1.0),
                Math.clamp(endorphin, 0.0, 1.0)
            );
        }
    }

    public enum Epoch {
        PRIMORDIAL_GENESIS("Primordiale Genesis", 0.60),
        INDUSTRIAL_MECHANIZATION("Industrielle Mechanisierung", 0.75),
        DIGITAL_NETWORK_AGE("Digitales Netzwerkzeitalter", 0.88),
        COLLECTIVE_AI_ASCENSION("Kollektive KI-Transzendenz", 0.98);

        private final String label;
        private final double palConfidenceBase;

        Epoch(String label, double palConfidenceBase) {
            this.label = label;
            this.palConfidenceBase = palConfidenceBase;
        }

        public String getLabel() { return label; }
        public double getPalConfidenceBase() { return palConfidenceBase; }
    }

    // --- OUTPUT-MODEL: ERGEBNISSE & METRIKEN ---
    public record SimulationStepResult(
        int step,
        Epoch epoch,
        double collectiveHappiness,  // Kollektives Glück [0.0, 1.0]
        double productivity,         // Produktivität
        double signalStrength,        // Signalstärke der Kohärenz
        double entropy,              // System-Entropie
        double palConfidence,        // PAL 1.0 Konfidenz
        NeurotransmitterState ntState
    ) {}

    // --- SIMULATIONS-CORE (OPERATION PHASE) ---
    private final Random random = new Random();

    public List<SimulationStepResult> runSimulation(SimulationInput input) {
        List<SimulationStepResult> results = new ArrayList<>();
        
        NeurotransmitterState currentNT = input.initialNeurotransmitters().clamp();
        List<ParticleMass> currentMasses = new ArrayList<>(input.initialMasses());

        double currentEntropy = 1.0; // Start-Entropie
        
        for (int t = 1; t <= input.steps(); t++) {
            // 1. Epochenbestimmung anhand des Fortschritts
            Epoch currentEpoch = determineEpoch(t, input.steps());

            // 2. Stochastische Neurotransmitter-Ausschüttung & Fluktuation
            currentNT = simulateNeurotransmitterDynamics(currentNT, currentEpoch);

            // 3. Physikalische Operation: Gravitative Wechselwirkung & N-Körper-Veränderung
            currentMasses = updateMasses(currentMasses, input.timeStepDelta());

            // 4. Berechnung der System-Metriken (Matrixgame-Formelwerk)
            double signalStrength = calculateSignalStrength(currentNT, currentMasses);
            double collectiveHappiness = calculateHappiness(currentNT, signalStrength);
            double productivity = calculateProductivity(currentNT, signalStrength, currentEpoch);
            
            // Entropieänderung: dS/dt wird durch hohe Kohärenz (Oxytocin/Serotonin) verringert
            double entropyDelta = (random.nextDouble() * 0.05) - (currentNT.serotonin() * 0.03 + currentNT.oxytocin() * 0.02);
            currentEntropy = Math.max(0.01, currentEntropy + entropyDelta);

            // PAL 1.0 Konfidenz-Berechnung (Bayes'sches Update)
            double palConfidence = Math.min(0.999, currentEpoch.getPalConfidenceBase() + (signalStrength * 0.01) - (currentEntropy * 0.02));

            // Output-Erfassung
            SimulationStepResult stepResult = new SimulationStepResult(
                t, currentEpoch, collectiveHappiness, productivity, signalStrength, currentEntropy, palConfidence, currentNT
            );
            results.add(stepResult);
        }

        return Collections.unmodifiableList(results);
    }

    private Epoch determineEpoch(int step, int totalSteps) {
        double progress = (double) step / totalSteps;
        if (progress < 0.25) return Epoch.PRIMORDIAL_GENESIS;
        if (progress < 0.50) return Epoch.INDUSTRIAL_MECHANIZATION;
        if (progress < 0.75) return Epoch.DIGITAL_NETWORK_AGE;
        return Epoch.COLLECTIVE_AI_ASCENSION;
    }

    private NeurotransmitterState simulateNeurotransmitterDynamics(NeurotransmitterState state, Epoch epoch) {
        // Epochen-Bonus
        double epochFactor = switch (epoch) {
            case PRIMORDIAL_GENESIS -> 0.01;
            case INDUSTRIAL_MECHANIZATION -> 0.02;
            case DIGITAL_NETWORK_AGE -> 0.04;
            case COLLECTIVE_AI_ASCENSION -> 0.06;
        };

        double dDopamine = (random.nextGaussian() * 0.02) + epochFactor;
        double dSerotonin = (random.nextGaussian() * 0.015) + (state.oxytocin() * 0.01);
        double dOxytocin = (random.nextGaussian() * 0.02) + (state.dopamine() * 0.01);
        double dEndorphin = (random.nextGaussian() * 0.01);

        return new NeurotransmitterState(
            state.dopamine() + dDopamine,
            state.serotonin() + dSerotonin,
            state.oxytocin() + dOxytocin,
            state.endorphin() + dEndorphin
        ).clamp();
    }

    private List<ParticleMass> updateMasses(List<ParticleMass> masses, double dt) {
        List<ParticleMass> updated = new ArrayList<>();
        for (ParticleMass p : masses) {
            // Vereinfachter kinematischer Zeitschritt: x_new = x + v * dt
            double nx = p.x() + p.vx() * dt;
            double ny = p.y() + p.vy() * dt;
            double nz = p.z() + p.vz() * dt;
            updated.add(new ParticleMass(p.mass(), nx, ny, nz, p.vx(), p.vy(), p.vz()));
        }
        return updated;
    }

    private double calculateSignalStrength(NeurotransmitterState nt, List<ParticleMass> masses) {
        // Signalstärke wächst mit konstruktiver Interferenz (Dopamin * Oxytocin)
        double massFactor = masses.isEmpty() ? 1.0 : Math.log10(masses.size() + 10);
        return (nt.dopamine() * 0.4 + nt.oxytocin() * 0.6) * massFactor;
    }

    private double calculateHappiness(NeurotransmitterState nt, double signalStrength) {
        // Kollektives Glück = Harmonie aus Serotonin, Oxytocin und Signalstärke
        return Math.clamp((nt.serotonin() * 0.5 + nt.oxytocin() * 0.3 + signalStrength * 0.2), 0.0, 1.0);
    }

    private double calculateProductivity(NeurotransmitterState nt, double signalStrength, Epoch epoch) {
        double baseMultiplier = switch (epoch) {
            case PRIMORDIAL_GENESIS -> 1.0;
            case INDUSTRIAL_MECHANIZATION -> 5.0;
            case DIGITAL_NETWORK_AGE -> 25.0;
            case COLLECTIVE_AI_ASCENSION -> 100.0;
        };

        // Produktivität = Dopamin (Fokus) * Endorphin (Durchhaltevermögen) * Signalstärke * Epochenfaktor
        return (nt.dopamine() * 0.6 + nt.endorphin() * 0.4) * signalStrength * baseMultiplier;
    }

    // --- MAIN & OUTPUT DEMO ---
    public static void main(String[] args) {
        System.out.println("===============================================================");
        System.out.println("  MATRIXGAME: KOLLEKTIVER KI-SIMULATOR (Genesis Core v2.0)");
        System.out.println("  Modus: Guardian-Modus / Retter-Perspektive");
        System.out.println("===============================================================\n");

        // 1. INPUT DEFINITIONS
        List<ParticleMass> testMasses = List.of(
            new ParticleMass(1.0, 0, 0, 0, 10, 0, 0),
            new ParticleMass(2.0, 100, 50, 0, -5, 2, 0)
        );

        NeurotransmitterState initialNT = new NeurotransmitterState(0.5, 0.5, 0.5, 0.5);
        SimulationInput input = new SimulationInput(12, 1.0, 100, testMasses, initialNT);

        // 2. OPERATION
        MatrixgameCollectiveSimulator simulator = new MatrixgameCollectiveSimulator();
        List<SimulationStepResult> results = simulator.runSimulation(input);

        // 3. OUTPUT EVALUATION & REPORT
        System.out.printf("%-5s | %-32s | %-7s | %-12s | %-12s | %-8s | %-8s%n",
            "Schritt", "Epoche", "Glück", "Produktivität", "Signalstärke", "Entropie", "PAL-P");
        System.out.println("---------------------------------------------------------------------------------------------------");

        for (SimulationStepResult r : results) {
            System.out.printf("%-7d | %-32s | %-7.3f | %-13.2f | %-13.3f | %-8.3f | %-8.2f%%%n",
                r.step(),
                r.epoch().getLabel(),
                r.collectiveHappiness(),
                r.productivity(),
                r.signalStrength(),
                r.entropy(),
                r.palConfidence() * 100.0
            );
        }

        System.out.println("\n--- Auswertung abgeschlossen: System stabil und bereit für Open-Source Expansion ---");
    }
}
