package de.matrixgame.core;

import java.util.ArrayList;
import java.util.List;

/**
 * CollectiveCausalitySimulator: Simuliert Kausalketten, Transaktionsflüsse 
 * und Bewusstseins-Resonanzen im Matrixgame.
 */
public class CollectiveCausalitySimulator {

    public static class EventNode {
        public final int stepId;
        public final double energyInput;
        public final double entropyDelta;
        public double systemicCohesion;

        public EventNode(int stepId, double energyInput, double entropyDelta, double systemicCohesion) {
            this.stepId = stepId;
            this.energyInput = energyInput;
            this.entropyDelta = entropyDelta;
            this.systemicCohesion = systemicCohesion;
        }
    }

    private final List<EventNode> history = new ArrayList<>();
    private double currentCohesion = 0.5;

    public void simulateStep(int stepId, double transactionVolume, double humanIntentFactor) {
        // Kausalitätsberechnung nach Entropie- und Erhaltungsprinzipien
        double entropyDelta = 0.05 * (1.0 - humanIntentFactor) - (transactionVolume * 0.001);
        this.currentCohesion = Math.max(0.0, Math.min(1.0, this.currentCohesion + (humanIntentFactor * 0.1 - entropyDelta)));
        
        EventNode node = new EventNode(stepId, transactionVolume, entropyDelta, this.currentCohesion);
        history.add(node);
        
        System.out.printf("Step %d | Transaktion: %.2f | Entropie-Delta: %.4f | Kohäsion: %.4f%n",
                stepId, transactionVolume, entropyDelta, this.currentCohesion);
    }

    public static void main(String[] args) {
        System.out.println("--- Starte Collective Causality Simulation ---");
        CollectiveCausalitySimulator sim = new CollectiveCausalitySimulator();
        
        // Simulieren von 5 Schritten (Kassensimulator-Kopplung & kollektiver Wille)
        double[] simulatedTransactions = { 150.50, 45.20, 300.00, 12.80, 520.10 };
        for (int i = 0; i < simulatedTransactions.length; i++) {
            sim.simulateStep(i + 1, simulatedTransactions[i], 0.75);
        }
        System.out.println("Simulation erfolgreich abgeschlossen. Bereit für Eclipse-Ausgabe.");
    }
}
