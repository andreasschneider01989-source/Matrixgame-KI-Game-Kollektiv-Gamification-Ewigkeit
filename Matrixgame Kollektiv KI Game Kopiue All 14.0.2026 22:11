Java
package de.matrixgame.core;

import java.util.ArrayList;
import java.util.List;

public class CollectiveCausalitySimulatorV2 {

    public static class EventNode {
        public final int stepId;
        public final double transactionVolume;
        public final double netEntropyDelta;
        public double systemicCohesion;

        public EventNode(int stepId, double transactionVolume, double netEntropyDelta, double systemicCohesion) {
            this.stepId = stepId;
            this.transactionVolume = transactionVolume;
            this.netEntropyDelta = netEntropyDelta;
            this.systemicCohesion = systemicCohesion;
        }
    }

    private final List<EventNode> history = new ArrayList<>();
    private double currentCohesion = 0.5;
    
    // Konstanter Umwelt-Entropie-Faktor (Wärmetod / Reibung)
    private final double ENVIRONMENTAL_DECAY = 0.08;

    public void simulateStep(int stepId, double transactionVolume, double humanIntentFactor) {
        // Netto-Entropie: Umweltzerfall minus bewusster Intention und Transaktions-Wertschöpfung
        double netEntropyDelta = ENVIRONMENTAL_DECAY - (humanIntentFactor * 0.05) - (transactionVolume * 0.0008);
        
        // Kohäsion ändert sich entgegengesetzt zur Netto-Entropie
        this.currentCohesion = Math.max(0.0, Math.min(1.0, this.currentCohesion - netEntropyDelta));
        
        EventNode node = new EventNode(stepId, transactionVolume, netEntropyDelta, this.currentCohesion);
        history.add(node);
        
        System.out.printf("Step %d | Transaktion: %6.2f | Netto-Entropie: %+.4f | Kohäsion: %.4f%n",
                stepId, transactionVolume, netEntropyDelta, this.currentCohesion);
    }

    public static void main(String[] args) {
        System.out.println("--- Starte Collective Causality Simulation V2 (mit Dissipation) ---");
        CollectiveCausalitySimulatorV2 sim = new CollectiveCausalitySimulatorV2();
        
        double[] simulatedTransactions = { 150.50, 45.20, 300.00, 12.80, 520.10 };
        for (int i = 0; i < simulatedTransactions.length; i++) {
            sim.simulateStep(i + 1, simulatedTransactions[i], 0.75);
        }
        System.out.println("Simulation V2 erfolgreich abgeschlossen.");
    }
}
