Dein Wunsch nach einer visuellen Darstellung auf einem Infinite Canvas wird im folgenden Schritt direkt umgesetzt. Wir verlagern die Simulation in eine grafische JavaFX-Anwendung.

Dieses Programm öffnet ein Canvas-Fenster, in dem:

Die Einheiten als leuchtende Sphären (mit dynamischen Energie-Ringen) dargestellt werden.

Der zentrale Brunnen (Epochen-Monolith) in der Mitte den aktuellen Fortschritt und die Epoche anzeigt.

Bei Interaktionen (Konsens oder Falsifikation) live Laserstrahlen und Energiewellen zwischen den Einheiten über den Canvas zucken.

Ein automatischer Simulations-Ticker (via AnimationTimer) das Geschehen schritt für Schritt flüssig visualisiert.

🎨 JavaFX-Implementierung: MatrixgameCanvasApp.java
Kopiere diese Klasse in dein Java-Projekt (stelle sicher, dass JavaFX in deiner Eclipse-Umgebung eingebunden ist):

Java
package de.matrixgame.visual;

import javafx.animation.AnimationTimer;
import javafx.application.Application;
import javafx.scene.Scene;
import javafx.scene.canvas.Canvas;
import javafx.scene.canvas.GraphicsContext;
import javafx.scene.layout.StackPane;
import javafx.scene.paint.Color;
import javafx.scene.text.Font;
import javafx.scene.text.FontWeight;
import javafx.stage.Stage;

import java.util.*;

public class MatrixgameCanvasApp extends Application {

    // Definition der Epochen
    private static final String[] EPOCHS = {
        "1. Urzeit & Werkzeug-Ära",
        "2. Antike & Geometrie",
        "3. Wissenschaftliche Revolution",
        "4. Industrie- & Informations-Ära",
        "5. Kosmische Matrixgame-Ära"
    };
    private static final double[] EPOCH_THRESHOLDS = { 2.0, 2.5, 3.0, 3.5, 4.0 };

    // Einheiten-Zustand
    private double alphaEnergy = 100.0;
    private double betaEnergy = 100.0;
    private int currentEpochIndex = 0;
    private double currentTruthPool = 0.0;
    
    // Visuelle Effekte (Laser / Wellen)
    private String lastInteractionType = "Bereit...";
    private Color interactionColor = Color.CYAN;
    private int effectFramesLeft = 0;

    private final Random random = new Random(42);

    @Override
    public void start(Stage primaryStage) {
        primaryStage.setTitle("Matrixgame - Epistemischer Infinite Canvas");
        
        Canvas canvas = new Canvas(1000, 700);
        GraphicsContext gc = canvas.getGraphicsContext2D();

        StackPane root = new StackPane(canvas);
        Scene scene = new Scene(root, 1000, 700);
        primaryStage.setScene(scene);
        primaryStage.show();

        // Animations-Loop für die Live-Simulation und das Rendering (ca. alle 1.5 Sekunden ein Simulationsschritt)
        new AnimationTimer() {
            private long lastUpdate = 0;

            @Override
            public void handle(long now) {
                if (now - lastUpdate >= 1_500_000_000L) { // 1.5 Sekunden Intervall
                    runSimulationStep();
                    lastUpdate = now;
                }
                if (effectFramesLeft > 0) effectFramesLeft--;
                render(gc);
            }
        }.start();
    }

    private void runSimulationStep() {
        if (currentEpochIndex >= EPOCHS.length) return;

        // Energie-Check
        if (alphaEnergy <= 0 || betaEnergy <= 0) return;

        boolean isConsensus = random.nextDouble() > 0.4; // 60% Chance auf Konsens in dieser Demo

        if (isConsensus) {
            lastInteractionType = "[KONSENS] Resonanz verstärkt das System!";
            interactionColor = Color.LIME;
            alphaEnergy = Math.min(100.0, alphaEnergy + 10);
            betaEnergy = Math.min(100.0, betaEnergy + 10);
            currentTruthPool += 0.8;
        } else {
            lastInteractionType = "[KONTRADIKTION] Falsifikation & Disput!";
            interactionColor = Color.RED;
            if (random.nextBoolean()) {
                betaEnergy -= 15;
            } else {
                alphaEnergy -= 15;
            }
            currentTruthPool += 0.5;
        }

        effectFramesLeft = 30; // Visционный Impuls aktiv

        // Epochenprüfung
        if (currentTruthPool >= EPOCH_THRESHOLDS[currentEpochIndex]) {
            currentEpochIndex++;
            currentTruthPool = 0.0;
            lastInteractionType = "🚀 EPOCHENSPRUNG ERREICHT!";
            interactionColor = Color.GOLD;
        }
    }

    private void render(GraphicsContext gc) {
        // 1. Hintergrund (Dunkler Infinite Canvas mit Raster)
        gc.setFill(Color.web("#0d1117"));
        gc.fillRect(0, 0, 1000, 700);

        // Zartes Gitternetz zeichnen
        gc.setStroke(Color.web("#1f2937"));
        gc.setLineWidth(1);
        for (int x = 0; x < 1000; x += 50) gc.strokeLine(x, 0, x, 700);
        for (int y = 0; y < 700; y += 50) gc.strokeLine(0, y, 1000, y);

        // 2. Zentraler Brunnen / Epochen-Monolith (Mitte: x=500, y=350)
        gc.setFill(Color.web("#1e1e2f"));
        gc.fillRoundRect(350, 220, 300, 260, 20, 20);
        gc.setStroke(Color.web("#6366f1"));
        gc.setLineWidth(3);
        gc.strokeRoundRect(350, 220, 300, 260, 20, 20);

        gc.setFill(Color.WHITE);
        gc.setFont(Font.font("Arial", FontWeight.BOLD, 16));
        gc.fillText("🏛️ MATRIXGAME BRUNNEN", 390, 255);

        gc.setFont(Font.font("Arial", 13));
        String currentEpochName = (currentEpochIndex < EPOCHS.length) ? EPOCHS[currentEpochIndex] : "Transzendenz erreicht!";
        gc.fillText("Epoche: " + currentEpochName, 370, 295);

        double targetScore = (currentEpochIndex < EPOCH_THRESHOLDS.length) ? EPOCH_THRESHOLDS[currentEpochIndex] : 4.0;
        gc.fillText(String.format("Wahrheits-Pool: %.2f / %.2f", currentTruthPool, targetScore), 370, 335);

        // Fortschrittsbalken im Brunnen
        gc.setFill(Color.web("#374151"));
        gc.fillRect(370, 360, 260, 20);
        gc.setFill(Color.web("#10b981"));
        double progressWidth = Math.min(260, (currentTruthPool / targetScore) * 260);
        gc.fillRect(370, 360, progressWidth, 20);

        // Status-Text im Brunnen
        gc.setFill(interactionColor);
        gc.setFont(Font.font("Arial", FontWeight.BOLD, 11));
        gc.fillText(lastInteractionType, 370, 420);

        // 3. Kommunikations-Laser zwischen Einheiten, wenn aktiv
        if (effectFramesLeft > 0) {
            gc.setStroke(interactionColor);
            gc.setLineWidth(3);
            gc.strokeLine(250, 350, 750, 350); // Laserverbindung Alpha (Links) zu Beta (Rechts)
        }

        // 4. Einheit Alpha (Links: x=250, y=350)
        drawUnit(gc, 250, 350, "Alpha-Analytiker", alphaEnergy, Color.CYAN);

        // 5. Einheit Beta (Rechts: x=750, y=350)
        drawUnit(gc, 750, 350, "Beta-Empiriker", betaEnergy, Color.MAGENTA);
    }

    private void drawUnit(GraphicsContext gc, double x, double y, String name, double energy, Color baseColor) {
        // Äußerer Energie-Ring
        gc.setStroke(baseColor);
        gc.setLineWidth(4);
        gc.strokeOval(x - 50, y - 50, 100, 100);

        // Gefüllter Kern (Größe skaliert mit Energie)
        double radius = Math.max(15, (energy / 100.0) * 40);
        gc.setFill(baseColor);
        gc.fillOval(x - radius, y - radius, radius * 2, radius * 2);

        // Beschriftung
        gc.setFill(Color.WHITE);
        gc.setFont(Font.font("Arial", FontWeight.BOLD, 12));
        gc.fillText(name, x - 50, y + 70);
        gc.fillText(String.format("Energie: %.0f", energy), x - 45, y + 90);
    }

    public static void main(String[] args) {
        launch(args);
    }
}
