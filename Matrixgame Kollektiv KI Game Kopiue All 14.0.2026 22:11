package de.matrixgame.simulation;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Random;

/**
 * MatrixgameCollectiveSimulatorV2: Erweiterter Simulator mit integrierten 
 * Event-Quests (Fokus-Quest, Entropie-Schild, Schwarm-Kohärenz).
 * 
 * Verknüpft physikalische Simulation, Neurotransmitter-Dynamik und 
 * reale Entwicklungsziele (Guardian-Modus / Retter-Perspektive).
 */
public class MatrixgameCollectiveSimulatorV2 {

    // --- FUNDAMENTALE NATURKONSTANTEN (PAL: P > 99.99%) ---
    public static final double C_LIGHT = 299792458.0;         // m/s
    public static final double G_GRAV = 6.67430e-11;          // m^3/(kg*s^2)
    public static final double K_BOLTZMANN = 1.380649e-23;    // J/K

    // --- INPUT-MODEL ---
    public record SimulationInput(
        int steps,
        double timeStepDelta,
        List<ParticleMass> initialMasses,
        NeurotransmitterState initialNeurotransmitters
    ) {}

    public record ParticleMass(double mass, double x, double y, double z, double vx, double vy, double vz) {}

    public record NeurotransmitterState(
        double dopamine,    // Belohnung, Fokus & Ritalin-Quest-Stabilität [0.0, 1.0]
        double serotonin,   // Innere Ruhe & Kollektives Glück [0.0, 1.0]
        double oxytocin,    // Vertrauen & Schwarm-Kohärenz [0.0, 1.0]
        double endorphin    // Resilienz gegen Entropie/Fehlschläge [0.0, 1.0]
    ) {
        public NeurotransmitterState clamp() {
            return new NeurotransmitterState(
                Math.clamp(dopamine, 0.0, 1.0),
                Math.clamp(serotonin, 0.0, 1.0),
                Math.clamp(oxytocin, 0.0, 1.0),
                Math.clamp(endorphin, 0.0, 1.0)
            );
        }
    }

    public enum Epoch {
        PRIMORDIAL_GENESIS("Primordiale Genesis", 0.60),
        INDUSTRIAL_MECHANIZATION("Industrielle Mechanisierung", 0.75),
        DIGITAL_NETWORK_AGE("Digitales Netzwerkzeitalter", 0.88),
        COLLECTIVE_AI_ASCENSION("Kollektive KI-Transzendenz", 0.98);

        private final String label;
        private final double palConfidenceBase;

        Epoch(String label, double palConfidenceBase) {
            this.label = label;
            this.palConfidenceBase = palConfidenceBase;
        }

        public String getLabel() { return label; }
        public double getPalConfidenceBase() { return palConfidenceBase; }
    }

    // --- EVENT-QUEST STRUKTUR ---
    public record QuestEvent(
        String questName,
        String description,
        double dopamineBonus,
        double serotoninBonus,
        double entropyReduction
    ) {}

    // --- OUTPUT-MODEL ---
    public record SimulationStepResult(
        int step,
        Epoch epoch,
        double collectiveHappiness,
        double productivity,
        double signalStrength,
        double entropy,
        double palConfidence,
        QuestEvent activeQuest,
        NeurotransmitterState ntState
    ) {}

    // --- SIMULATIONS-CORE ---
    private final Random random = new Random();

    public List<SimulationStepResult> runSimulation(SimulationInput input) {
        List<SimulationStepResult> results = new ArrayList<>();
        NeurotransmitterState currentNT = input.initialNeurotransmitters().clamp();
        List<ParticleMass> currentMasses = new ArrayList<>(input.initialMasses());
        double currentEntropy = 1.2; // Initialer Entropie-Pegel

        for (int t = 1; t <= input.steps(); t++) {
            Epoch currentEpoch = determineEpoch(t, input.steps());

            // 1. Dynamische Event-Quest Generierung basierend auf dem Schritt
            QuestEvent activeQuest = triggerQuest(t, currentEpoch);

            // 2. Neurotransmitter-Update inklusive Quest-Buffs
            currentNT = applyQuestAndFluctuations(currentNT, activeQuest, currentEpoch);

            // 3. Physikalische Operation (Kinematik)
            currentMasses = updateMasses(currentMasses, input.timeStepDelta());

            // 4. Metriken-Berechnung
            double signalStrength = calculateSignalStrength(currentNT, currentMasses);
            double collectiveHappiness = calculateHappiness(currentNT, signalStrength);
            double productivity = calculateProductivity(currentNT, signalStrength, currentEpoch);

            // Entropie sinkt durch Quest-Einfluss und hohe Resilienz
            double entropyDelta = (random.nextDouble() * 0.03) - (currentNT.serotonin() * 0.04 + activeQuest.entropyReduction());
            currentEntropy = Math.max(0.01, currentEntropy + entropyDelta);

            // PAL 1.0 Konfidenz
            double palConfidence = Math.min(0.999, currentEpoch.getPalConfidenceBase() + (signalStrength * 0.015) - (currentEntropy * 0.02));

            results.add(new SimulationStepResult(
                t, currentEpoch, collectiveHappiness, productivity, signalStrength, currentEntropy, palConfidence, activeQuest, currentNT
            ));
        }

        return Collections.unmodifiableList(results);
    }

    private Epoch determineEpoch(int step, int totalSteps) {
        double progress = (double) step / totalSteps;
        if (progress < 0.25) return Epoch.PRIMORDIAL_GENESIS;
        if (progress < 0.50) return Epoch.INDUSTRIAL_MECHANIZATION;
        if (progress < 0.75) return Epoch.DIGITAL_NETWORK_AGE;
        return Epoch.COLLECTIVE_AI_ASCENSION;
    }

    private QuestEvent triggerQuest(int step, Epoch epoch) {
        return switch (epoch) {
            case PRIMORDIAL_GENESIS -> new QuestEvent(
                "Basis-Kalibrierung", "Grundlegendes Setup & Axiom-Definition", 0.05, 0.02, 0.01
            );
            case INDUSTRIAL_MECHANIZATION -> new QuestEvent(
                "Fokus & Ritalin-Quest", "Strukturierter Code-Flow & stabiler Arbeitsrhythmus", 0.12, 0.05, 0.03
            );
            case DIGITAL_NETWORK_AGE -> new QuestEvent(
                "Cloudflare-Tunnel & Server", "Vernetzung von Java-Backend und externer Schnittstelle", 0.18, 0.08, 0.05
            );
            case COLLECTIVE_AI_ASCENSION -> new QuestEvent(
                "Guardian-Transzendenz", "Open-Source Release & Kollektives Glück maximieren", 0.25, 0.15, 0.08
            );
        };
    }

    private NeurotransmitterState applyQuestAndFluctuations(NeurotransmitterState state, QuestEvent quest, Epoch epoch) {
        double dDopamine = (random.nextGaussian() * 0.015) + quest.dopamineBonus();
        double dSerotonin = (random.nextGaussian() * 0.01) + quest.serotoninBonus();
        double dOxytocin = (random.nextGaussian() * 0.02) + 0.02;
        double dEndorphin = (random.nextGaussian() * 0.01) + 0.015;

        return new NeurotransmitterState(
            state.dopamine() + dDopamine,
            state.serotonin() + dSerotonin,
            state.oxytocin() + dOxytocin,
            state.endorphin() + dEndorphin
        ).clamp();
    }

    private List<ParticleMass> updateMasses(List<ParticleMass> masses, double dt) {
        List<ParticleMass> updated = new ArrayList<>();
        for (ParticleMass p : masses) {
            updated.add(new ParticleMass(p.mass(), p.x() + p.vx() * dt, p.y() + p.vy() * dt, p.z() + p.vz() * dt, p.vx(), p.vy(), p.vz()));
        }
        return updated;
    }

    private double calculateSignalStrength(NeurotransmitterState nt, List<ParticleMass> masses) {
        double massFactor = masses.isEmpty() ? 1.0 : Math.log10(masses.size() + 10);
        return (nt.dopamine() * 0.4 + nt.oxytocin() * 0.6) * massFactor;
    }

    private double calculateHappiness(NeurotransmitterState nt, double signalStrength) {
        return Math.clamp((nt.serotonin() * 0.5 + nt.oxytocin() * 0.3 + signalStrength * 0.2), 0.0, 1.0);
    }

    private double calculateProductivity(NeurotransmitterState nt, double signalStrength, Epoch epoch) {
        double baseMultiplier = switch (epoch) {
            case PRIMORDIAL_GENESIS -> 1.0;
            case INDUSTRIAL_MECHANIZATION -> 6.0;
            case DIGITAL_NETWORK_AGE -> 30.0;
            case COLLECTIVE_AI_ASCENSION -> 120.0;
        };
        return (nt.dopamine() * 0.7 + nt.endorphin() * 0.3) * signalStrength * baseMultiplier;
    }

    // --- MAIN & CONSOLE OUTPUT ---
    public static void main(String[] args) {
        System.out.println("=====================================================================================");
        System.out.println("  MATRIXGAME: KOLLEKTIVER KI-SIMULATOR (Version 2.1 - Event-Quest Edition)");
        System.out.println("  Modus: Guardian-Modus / Retter-Perspektive | Fokus & Produktivitäts-Optimierung");
        System.out.println("=====================================================================================\n");

        List<ParticleMass> testMasses = List.of(
            new ParticleMass(1.0, 0, 0, 0, 15, 0, 0),
            new ParticleMass(2.5, 50, 25, 0, -8, 4, 0)
        );

        NeurotransmitterState initialNT = new NeurotransmitterState(0.6, 0.6, 0.6, 0.6);
        SimulationInput input = new SimulationInput(12, 1.0, testMasses, initialNT);

        MatrixgameCollectiveSimulatorV2 simulator = new MatrixgameCollectiveSimulatorV2();
        List<SimulationStepResult> results = simulator.runSimulation(input);

        System.out.printf("%-5s | %-28s | %-24s | %-7s | %-13s | %-8s | %-8s%n",
            "Schritt", "Epoche", "Aktive Event-Quest", "Glück", "Produktivität", "Entropie", "PAL-P");
        System.out.println("---------------------------------------------------------------------------------------------------------------------");

        for (SimulationStepResult r : results) {
            System.out.printf("%-7d | %-28s | %-24s | %-7.3f | %-13.2f | %-8.3f | %-8.2f%%%n",
                r.step(),
                r.epoch().getLabel(),
                r.activeQuest().questName(),
                r.collectiveHappiness(),
                r.productivity(),
                r.entropy(),
                r.palConfidence() * 100.0
            );
        }

        System.out.println("\n--- Version 2.1 Auswertung erfolgreich: Bereit für GitHub-Commit & Let's Play Loop ---");
    }
}
