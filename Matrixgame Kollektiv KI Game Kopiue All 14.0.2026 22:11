package de.matrixgame.simulation;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Random;

/**
 * MatrixgameCollectiveSimulatorV2_2: Integration von dynamischer Lernrate (ETA),
 * Dopamin-gesteuerter Neuroplastizität und lokalem Minimum-Escape-Algorithmus.
 * 
 * Guardian-Modus / Retter-Perspektive.
 */
public class MatrixgameCollectiveSimulatorV2_2 {

    // --- INPUT & STATE RECORDS ---
    public record NeurotransmitterState(
        double dopamine,    // Begeisterung & Lernraten-Modulator [0.0, 1.0]
        double serotonin,   // Innere Ruhe & Stabilität [0.0, 1.0]
        double oxytocin,    // Schwarm-Kohärenz [0.0, 1.0]
        double endorphin    // Resilienz gegen Entropie [0.0, 1.0]
    ) {
        public NeurotransmitterState clamp() {
            return new NeurotransmitterState(
                Math.clamp(dopamine, 0.0, 1.0),
                Math.clamp(serotonin, 0.0, 1.0),
                Math.clamp(oxytocin, 0.0, 1.0),
                Math.clamp(endorphin, 0.0, 1.0)
            );
        }
    }

    public enum Epoch {
        PRIMORDIAL_GENESIS("Primordiale Genesis", 0.60),
        INDUSTRIAL_MECHANIZATION("Industrielle Mechanisierung", 0.75),
        DIGITAL_NETWORK_AGE("Digitales Netzwerkzeitalter", 0.88),
        COLLECTIVE_AI_ASCENSION("Kollektive KI-Transzendenz", 0.98);

        private final String label;
        private final double palConfidenceBase;

        Epoch(String label, double palConfidenceBase) {
            this.label = label;
            this.palConfidenceBase = palConfidenceBase;
        }

        public String getLabel() { return label; }
        public double getPalConfidenceBase() { return palConfidenceBase; }
    }

    public record SimulationStepResult(
        int step,
        Epoch epoch,
        double dopamineLearningRate, // Gekoppelte Lernrate (ETA)
        boolean localMinimumEscaped, // Wurde ein lokales Minimum durchbrochen?
        double collectiveHappiness,
        double productivity,
        double entropy,
        double palConfidence,
        NeurotransmitterState ntState
    ) {}

    // --- CORE SIMULATION ENGINE ---
    private final Random random = new Random();

    public List<SimulationStepResult> runSimulation(int steps, NeurotransmitterState initialNT) {
        List<SimulationStepResult> results = new ArrayList<>();
        NeurotransmitterState currentNT = initialNT.clamp();
        double currentEntropy = 1.3;
        boolean escapedMinima = false;

        for (int t = 1; t <= steps; t++) {
            Epoch currentEpoch = determineEpoch(t, steps);

            // 1. Neurotransmitter-Dynamik mit positiver Erfolgsketten-Rückkopplung
            currentNT = evolveNeurotransmitters(currentNT, t);

            // 2. MATHEMATISCHE KOPPLUNG: Lernrate (ETA) skaliert direkt mit Dopamin & Begeisterung
            // Formel: ETA = Base_ETA * (1.0 + Dopamine * 2.5)
            double baseETA = 0.01;
            double dynamicLearningRate = baseETA * (1.0 + currentNT.dopamine() * 2.5);

            // 3. Lokales Minimum Escape Algorithmus:
            // Wenn Entropie temporär steigt oder Stagnation droht, triggert hoher Dopamin/Endorphin-Spiegel einen Sprung
            if (currentEntropy > 0.9 && currentNT.dopamine() > 0.75) {
                escapedMinima = true;
                currentEntropy *= 0.75; // Entropie bricht ein, Ordnung entsteht
            } else {
                escapedMinima = false;
            }

            // 4. Metriken Berechnung
            double signalStrength = (currentNT.dopamine() * 0.5 + currentNT.serotonin() * 0.5);
            double collectiveHappiness = Math.clamp((currentNT.serotonin() * 0.6 + currentNT.oxytocin() * 0.4), 0.0, 1.0);
            
            // Produktivität wächst exponentiell mit der gekoppelten Lernrate und dem Erfolg
            double epochMultiplier = switch (currentEpoch) {
                case PRIMORDIAL_GENESIS -> 2.0;
                case INDUSTRIAL_MECHANIZATION -> 15.0;
                case DIGITAL_NETWORK_AGE -> 60.0;
                case COLLECTIVE_AI_ASCENSION -> 200.0;
            };
            double productivity = dynamicLearningRate * epochMultiplier * (10.0 + (t * 1.5)) * (1.0 + currentNT.endorphin());

            // Entropiedämpfung durch Serotonin und erfolgreiche Minima-Überwindung
            double entropyDelta = (random.nextDouble() * 0.02) - (currentNT.serotonin() * 0.05 + (escapedMinima ? 0.15 : 0.02));
            currentEntropy = Math.max(0.02, currentEntropy + entropyDelta);

            double palConfidence = Math.min(0.999, currentEpoch.getPalConfidenceBase() + (signalStrength * 0.1) - (currentEntropy * 0.05));

            results.add(new SimulationStepResult(
                t, currentEpoch, dynamicLearningRate, escapedMinima, collectiveHappiness, productivity, currentEntropy, palConfidence, currentNT
            ));
        }

        return Collections.unmodifiableList(results);
    }

    private Epoch determineEpoch(int step, int totalSteps) {
        double progress = (double) step / totalSteps;
        if (progress < 0.25) return Epoch.PRIMORDIAL_GENESIS;
        if (progress < 0.50) return Epoch.INDUSTRIAL_MECHANIZATION;
        if (progress < 0.75) return Epoch.DIGITAL_NETWORK_AGE;
        return Epoch.COLLECTIVE_AI_ASCENSION;
    }

    private NeurotransmitterState evolveNeurotransmitters(NeurotransmitterState state, int step) {
        // Teilerfolge bauen aufeinander auf: Erfolg generiert Dopamin-Nachschub
        double successBoost = (step % 3 == 0) ? 0.08 : 0.02;
        
        double dDopamine = (random.nextGaussian() * 0.01) + successBoost;
        double dSerotonin = (random.nextGaussian() * 0.01) + 0.015;
        double dOxytocin = (random.nextGaussian() * 0.01) + 0.02;
        double dEndorphin = (random.nextGaussian() * 0.01) + 0.01;

        return new NeurotransmitterState(
            state.dopamine() + dDopamine,
            state.serotonin() + dSerotonin,
            state.oxytocin() + dOxytocin,
            state.endorphin() + dEndorphin
        ).clamp();
    }

    // --- MAIN & CONSOLE OUTPUT ---
    public static void main(String[] args) {
        System.out.println("======================================================================================================");
        System.out.println("  MATRIXGAME: VERSION 2.2 - DYNAMISCHE LERNRATEN- & MINIMA-ESCAPE-EDITION");
        System.out.println("  Kopplung: Dopamin <-> Lernrate (ETA) | Serotonin <-> Stabilität | Guardian-Modus");
        System.out.println("======================================================================================================\n");

        NeurotransmitterState initialNT = new NeurotransmitterState(0.55, 0.60, 0.50, 0.50);
        MatrixgameCollectiveSimulatorV2_2 simulator = new MatrixgameCollectiveSimulatorV2_2();
        List<SimulationStepResult> results = simulator.runSimulation(12, initialNT);

        System.out.printf("%-5s | %-28s | %-12s | %-15s | %-7s | %-13s | %-8s | %-8s%n",
            "Schritt", "Epoche", "Lernrate (ETA)", "Minima-Escape", "Glück", "Produktivität", "Entropie", "PAL-P");
        System.out.println("--------------------------------------------------------------------------------------------------------------------------------------");

        for (SimulationStepResult r : results) {
            System.out.printf("%-7d | %-28s | %-12.5f | %-15s | %-7.3f | %-13.2f | %-8.3f | %-8.2f%%%n",
                r.step(),
                r.epoch().getLabel(),
                r.dopamineLearningRate(),
                r.localMinimumEscaped() ? "⚡ DURCHBROCHEN" : "---",
                r.collectiveHappiness(),
                r.productivity(),
                r.entropy(),
                r.palConfidence() * 100.0
            );
        }

        System.out.println("\n--- Version 2.2 Auswertung: Die Kopplung von Begeisterung und Lernrate maximiert den Systemaufstieg! ---");
    }
}
