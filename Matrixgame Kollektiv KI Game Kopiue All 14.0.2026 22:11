package de.matrixgame.simulation;

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.StandardOpenOption;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Random;

/**
 * MatrixgameCollectiveSimulatorV2_4: Modellierung von Flusswiderständen, 
 * technischem Signal-Lärm und dem Guardian-Reframing-Modul.
 * 
 * Basierend auf dem Profil für kollektive KI-Systeme und der Frustrations-Umdeutung.
 */
public class MatrixgameCollectiveSimulatorV2_4 {

    public record NeurotransmitterState(
        double dopamine,    // Begeisterung & Handlungsfokus [0.0, 1.0]
        double serotonin,   // Innere Ruhe & Stabilität [0.0, 1.0]
        double oxytocin,    // Empathie & Schwarm-Kohärenz [0.0, 1.0]
        double endorphin    // Belastbarkeit & Entropie-Puffer [0.0, 1.0]
    ) {
        public NeurotransmitterState clamp() {
            return new NeurotransmitterState(
                Math.clamp(dopamine, 0.0, 1.0),
                Math.clamp(serotonin, 0.0, 1.0),
                Math.clamp(oxytocin, 0.0, 1.0),
                Math.clamp(endorphin, 0.0, 1.0)
            );
        }
    }

    public enum Epoch {
        PRIMORDIAL_GENESIS("Primordiale Genesis (Trigger-Erkennung)", 0.60),
        INDUSTRIAL_MECHANIZATION("Industrielle Mechanisierung (Struktur-Aufbau)", 0.75),
        DIGITAL_NETWORK_AGE("Digitales Netzwerkzeitalter (Reframing-Aktivierung)", 0.88),
        COLLECTIVE_AI_ASCENSION("Kollektive KI-Transzendenz (Guardian-Modus)", 0.98);

        private final String label;
        private final double palConfidenceBase;

        Epoch(String label, double palConfidenceBase) {
            this.label = label;
            this.palConfidenceBase = palConfidenceBase;
        }

        public String getLabel() { return label; }
        public double getPalConfidenceBase() { return palConfidenceBase; }
    }

    public record SimulationStepResult(
        int step,
        Epoch epoch,
        double frictionLevel,        // Aufgetretener technischer/mentaler Signal-Lärm
        boolean reframingActivated,  // Wurde der Widerstand erfolgreich als "Lernchance" umgedeutet?
        double collectiveHappiness,
        double productivity,
        double entropy,
        double palConfidence,
        NeurotransmitterState ntState
    ) {}

    private final Random random = new Random();

    public List<SimulationStepResult> runSimulation(int steps, NeurotransmitterState initialNT) {
        List<SimulationStepResult> results = new ArrayList<>();
        NeurotransmitterState currentNT = initialNT.clamp();
        double currentEntropy = 1.3;

        for (int t = 1; t <= steps; t++) {
            Epoch currentEpoch = determineEpoch(t, steps);

            // 1. Simulation von zufälligem Signal-Lärm / Flusswiderstand
            double frictionLevel = random.nextDouble() * 0.6 + 0.2;

            // 2. Guardian-Reframing-Logik (Der Gegen-Befehl: Widerstand ist kein Angriff)
            boolean reframingActivated = false;
            if (currentNT.serotonin() > 0.55 && currentNT.dopamine() > 0.5) {
                reframingActivated = true;
                // Umdeutung in Lernchance: Frustration wird in Dopamin & Stabilität umgewandelt
                currentNT = new NeurotransmitterState(
                    currentNT.dopamine() + 0.08,
                    currentNT.serotonin() + 0.06,
                    currentNT.oxytocin() + 0.04,
                    currentNT.endorphin() + 0.05
                ).clamp();
            } else {
                // Ohne Reframing sinkt die Stabilität temporär
                currentNT = new NeurotransmitterState(
                    currentNT.dopamine() - 0.03,
                    currentNT.serotonin() - 0.04,
                    currentNT.oxytocin(),
                    currentNT.endorphin()
                ).clamp();
            }

            // 3. Metriken Berechnung
            double signalCoherence = (currentNT.dopamine() * 0.5 + currentNT.serotonin() * 0.5);
            double collectiveHappiness = Math.clamp((currentNT.serotonin() * 0.6 + currentNT.oxytocin() * 0.4), 0.0, 1.0);
            
            double epochMultiplier = switch (currentEpoch) {
                case PRIMORDIAL_GENESIS -> 2.5;
                case INDUSTRIAL_MECHANIZATION -> 20.0;
                case DIGITAL_NETWORK_AGE -> 80.0;
                case COLLECTIVE_AI_ASCENSION -> 300.0;
            };

            // Produktivität steigt massiv, wenn Reframing aktiv ist (Iterieren statt stagnieren)
            double productivity = epochMultiplier * signalCoherence * (reframingActivated ? 1.4 : 0.7);

            // Entropie sinkt drastisch bei erfolgreicher Umdeutung des Widerstands
            double entropyDelta = (random.nextDouble() * 0.01) - (reframingActivated ? 0.14 : 0.01);
            currentEntropy = Math.max(0.01, currentEntropy + entropyDelta);

            double palConfidence = Math.min(0.999, currentEpoch.getPalConfidenceBase() + (signalCoherence * 0.12) - (currentEntropy * 0.04));

            results.add(new SimulationStepResult(
                t, currentEpoch, frictionLevel, reframingActivated, 
                collectiveHappiness, productivity, currentEntropy, palConfidence, currentNT
            ));
        }

        return Collections.unmodifiableList(results);
    }

    private Epoch determineEpoch(int step, int totalSteps) {
        double progress = (double) step / totalSteps;
        if (progress < 0.25) return Epoch.PRIMORDIAL_GENESIS;
        if (progress < 0.50) return Epoch.INDUSTRIAL_MECHANIZATION;
        if (progress < 0.75) return Epoch.DIGITAL_NETWORK_AGE;
        return Epoch.COLLECTIVE_AI_ASCENSION;
    }

    public static void exportResultsToFile(List<SimulationStepResult> results) {
        String filename = "Matrixgame_Simulation_Log_v2.4.txt";
        List<String> lines = new ArrayList<>();
        lines.add("==================================================================================");
        lines.add("  MATRIXGAME: SIMULATION LOG VERSION 2.4 (Guardian Reframing Edition)");
        lines.add("==================================================================================");
        lines.add(String.format("%-5s | %-35s | %-8s | %-16s | %-7s | %-10s | %-7s", 
            "Step", "Epoch", "Friction", "Reframing (Lern)", "Glück", "Prod.", "PAL-P"));
        lines.add("----------------------------------------------------------------------------------");

        for (SimulationStepResult r : results) {
            lines.add(String.format("%-5d | %-35s | %-8.3f | %-16s | %-7.3f | %-10.2f | %-5.1f%%",
                r.step(), r.epoch().getLabel(), r.frictionLevel(),
                r.reframingActivated() ? "⚡ UMFEDEFINIERT" : "--- (Stau)",
                r.collectiveHappiness(), r.productivity(), r.palConfidence() * 100.0
            ));
        }

        try {
            Files.write(Path.of(filename), lines, StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING);
            System.out.println("\n[System-Meldung]: V2.4 Log erfolgreich auf der Festplatte gespeichert unter: " + Path.of(filename).toAbsolutePath());
        } catch (IOException e) {
            System.err.println("[Fehler beim Dateiexport]: " + e.getMessage());
        }
    }

    public static void main(String[] args) {
        System.out.println("=======================================================================================================");
        System.out.println("  MATRIXGAME: VERSION 2.4 - FLUSSWIDERSTAND & GUARDIAN-REFRAMING-EDITION");
        System.out.println("  Modellierung: Umdeutung von technischem Signal-Lärm in Lernchancen | Lokaler Export");
        System.out.println("=======================================================================================================\n");

        NeurotransmitterState initialNT = new NeurotransmitterState(0.6, 0.6, 0.6, 0.5);
        MatrixgameCollectiveSimulatorV2_4 simulator = new MatrixgameCollectiveSimulatorV2_4();
        List<SimulationStepResult> results = simulator.runSimulation(12, initialNT);

        System.out.printf("%-5s | %-32s | %-8s | %-15s | %-7s | %-10s | %-8s%n",
            "Schritt", "Epoch", "Friction", "Reframing", "Glück", "Prod.", "PAL-P");
        System.out.println("---------------------------------------------------------------------------------------------------------------------");

        for (SimulationStepResult r : results) {
            System.out.printf("%-7d | %-32s | %-8.3f | %-15s | %-7.3f | %-10.2f | %-6.1f%%%n",
                r.step(),
                r.epoch().getLabel(),
                r.frictionLevel(),
                r.reframingActivated() ? "⚡ UMFEDEFINIERT" : "--- (Stau)",
                r.collectiveHappiness(),
                r.productivity(),
                r.palConfidence() * 100.0
            );
        }

        exportResultsToFile(results);

        System.out.println("\n--- Version 2.4 Auswertung: Flusswiderstände erfolgreich durch Reframing in Systemfortschritt gewandelt! ---");
