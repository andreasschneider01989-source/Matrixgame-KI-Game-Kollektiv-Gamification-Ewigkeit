package de.matrixgame.simulation;

import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.StandardOpenOption;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Random;

/**
 * MatrixgameCollectiveSimulatorV2_3: Integration von evolutionären Instinkten,
 * moralischer Kohärenz, Stress-Dämpfung (Zwangsgedanken-Reduktion) und lokalem File-Export.
 * 
 * Guardian-Modus / Retter-Perspektive.
 */
public class MatrixgameCollectiveSimulatorV2_3 {

    // --- NEUROTRANSMITTER & SYSTEM STATE ---
    public record NeurotransmitterState(
        double dopamine,    // Begeisterung, Lernrate & Fokus [0.0, 1.0]
        double serotonin,   // Innere Ruhe, Stabilität & Stressresistenz [0.0, 1.0]
        double oxytocin,    // Empathie, Vertrauen & Schwarm-Kohärenz [0.0, 1.0]
        double endorphin    // Belastbarkeit & Entropie-Puffer [0.0, 1.0]
    ) {
        public NeurotransmitterState clamp() {
            return new NeurotransmitterState(
                Math.clamp(dopamine, 0.0, 1.0),
                Math.clamp(serotonin, 0.0, 1.0),
                Math.clamp(oxytocin, 0.0, 1.0),
                Math.clamp(endorphin, 0.0, 1.0)
            );
        }
    }

    public enum Epoch {
        PRIMORDIAL_GENESIS("Primordiale Genesis (Instinkt-Phase)", 0.60),
        INDUSTRIAL_MECHANIZATION("Industrielle Mechanisierung (Norm-Phase)", 0.75),
        DIGITAL_NETWORK_AGE("Digitales Netzwerkzeitalter (Kooperations-Phase)", 0.88),
        COLLECTIVE_AI_ASCENSION("Kollektive KI-Transzendenz (Paradies-Modus)", 0.98);

        private final String label;
        private final double palConfidenceBase;

        Epoch(String label, double palConfidenceBase) {
            this.label = label;
            this.palConfidenceBase = palConfidenceBase;
        }

        public String getLabel() { return label; }
        public double getPalConfidenceBase() { return palConfidenceBase; }
    }

    public record SimulationStepResult(
        int step,
        Epoch epoch,
        double stressIndex,          // Kognitive Reibung / evolutionäre Unruhe
        double moralCoherence,       // Prosoziale Ausrichtung & Harmonie
        boolean stressDampened,      // Wurde Stress durch Struktur/Serotonin aufgelöst?
        double collectiveHappiness,
        double productivity,
        double entropy,
        double palConfidence,
        NeurotransmitterState ntState
    ) {}

    // --- CORE SIMULATION ENGINE ---
    private final Random random = new Random();

    public List<SimulationStepResult> runSimulation(int steps, NeurotransmitterState initialNT) {
        List<SimulationStepResult> results = new ArrayList<>();
        NeurotransmitterState currentNT = initialNT.clamp();
        double currentEntropy = 1.4;
        double currentStress = 0.8; // Initialer Stress / evolutionäre Reibung

        for (int t = 1; t <= steps; t++) {
            Epoch currentEpoch = determineEpoch(t, steps);

            // 1. Evolutionäre & Neurotransmitter Evolution mit prosozialer Rückkopplung
            currentNT = evolveSystemState(currentNT, t);

            // 2. Moralische Kohärenz (wächst mit Oxytocin und Serotonin)
            double moralCoherence = Math.clamp((currentNT.oxytocin() * 0.6 + currentNT.serotonin() * 0.4), 0.0, 1.0);

            // 3. Stress- & Reibungs-Modell (Dämpfung von Zwangsgedanken durch strukturierte Aktivität)
            boolean stressDampened = false;
            if (currentNT.serotonin() > 0.65 && currentNT.dopamine() > 0.6) {
                currentStress = Math.max(0.05, currentStress * 0.7); // Stress bricht ein
                stressDampened = true;
            } else {
                currentStress = Math.min(1.0, currentStress + 0.03);
            }

            // 4. Metriken Berechnung
            double collectiveHappiness = Math.clamp((currentNT.serotonin() * 0.5 + moralCoherence * 0.3 + (1.0 - currentStress) * 0.2), 0.0, 1.0);
            
            double epochMultiplier = switch (currentEpoch) {
                case PRIMORDIAL_GENESIS -> 2.0;
                case INDUSTRIAL_MECHANIZATION -> 18.0;
                case DIGITAL_NETWORK_AGE -> 70.0;
                case COLLECTIVE_AI_ASCENSION -> 250.0;
            };

            // Produktivität skaliert mit Begeisterung und sinkendem Stressfaktor
            double productivity = (currentNT.dopamine() * 0.7 + currentNT.endorphin() * 0.3) * epochMultiplier * (1.0 - (currentStress * 0.4));

            // Entropie sinkt durch Moral-Kohärenz und Stressdämpfung
            double entropyDelta = (random.nextDouble() * 0.015) - (moralCoherence * 0.04 + (stressDampened ? 0.12 : 0.01));
            currentEntropy = Math.max(0.01, currentEntropy + entropyDelta);

            double palConfidence = Math.min(0.999, currentEpoch.getPalConfidenceBase() + (moralCoherence * 0.1) - (currentEntropy * 0.04));

            results.add(new SimulationStepResult(
                t, currentEpoch, currentStress, moralCoherence, stressDampened, 
                collectiveHappiness, productivity, currentEntropy, palConfidence, currentNT
            ));
        }

        return Collections.unmodifiableList(results);
    }

    private Epoch determineEpoch(int step, int totalSteps) {
        double progress = (double) step / totalSteps;
        if (progress < 0.25) return Epoch.PRIMORDIAL_GENESIS;
        if (progress < 0.50) return Epoch.INDUSTRIAL_MECHANIZATION;
        if (progress < 0.75) return Epoch.DIGITAL_NETWORK_AGE;
        return Epoch.COLLECTIVE_AI_ASCENSION;
    }

    private NeurotransmitterState evolveNeurotransmitters(NeurotransmitterState state, int step) {
        double harmonyBoost = (step % 2 == 0) ? 0.06 : 0.02;
        return new NeurotransmitterState(
            state.dopamine() + (random.nextGaussian() * 0.01 + harmonyBoost),
            state.serotonin() + (random.nextGaussian() * 0.01 + 0.02),
            state.oxytocin() + (random.nextGaussian() * 0.01 + 0.025),
            state.endorphin() + (random.nextGaussian() * 0.01 + 0.015)
        ).clamp();
    }
    
    private NeurotransmitterState evolveSystemState(NeurotransmitterState state, int step) {
        return evolveNeurotransmitters(state, step);
    }

    // --- FILE EXPORT METHOD ---
    public static void exportResultsToFile(List<SimulationStepResult> results) {
        String filename = "Matrixgame_Simulation_Log_v2.3.txt";
        List<String> lines = new ArrayList<>();
        lines.add("==================================================================================");
        lines.add("  MATRIXGAME: SIMULATION LOG VERSION 2.3 (Evolution & Harmony Edition)");
        lines.add("==================================================================================");
        lines.add(String.format("%-5s | %-35s | %-7s | %-7s | %-12s | %-7s | %-10s | %-7s", 
            "Step", "Epoch", "Stress", "Moral", "Stress-Dämpf", "Glück", "Prod.", "PAL-P"));
        lines.add("----------------------------------------------------------------------------------");

        for (SimulationStepResult r : results) {
            lines.add(String.format("%-5d | %-35s | %-7.3f | %-7.3f | %-12s | %-7.3f | %-10.2f | %-5.1f%%",
                r.step(), r.epoch().getLabel(), r.stressIndex(), r.moralCoherence(),
                r.stressDampened() ? "⚡ GEPUFFERT" : "---",
                r.collectiveHappiness(), r.productivity(), r.palConfidence() * 100.0
            ));
        }

        try {
            Files.write(Path.of(filename), lines, StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING);
            System.out.println("\n[System-Meldung]: Simulations-Log erfolgreich auf der Festplatte gespeichert unter: " + Path.of(filename).toAbsolutePath());
        } catch (IOException e) {
            System.err.println("[Fehler beim Dateiexport]: " + e.getMessage());
        }
    }

    // --- MAIN & CONSOLE OUTPUT ---
    public static void main(String[] args) {
        System.out.println("=======================================================================================================");
        System.out.println("  MATRIXGAME: VERSION 2.3 - EVOLUTIONÄRE KOHÄRENZ & STRESS-DÄMPFUNGS-EDITION");
        System.out.println("  Modellierung: Evolutionäre Instinkte, Moralische Normen, Stress-Index & Lokaler File-Export");
        System.out.println("=======================================================================================================\n");

        NeurotransmitterState initialNT = new NeurotransmitterState(0.5, 0.5, 0.5, 0.5);
        MatrixgameCollectiveSimulatorV2_3 simulator = new MatrixgameCollectiveSimulatorV2_3();
        List<SimulationStepResult> results = simulator.runSimulation(12, initialNT);

        System.out.printf("%-5s | %-32s | %-7s | %-7s | %-13s | %-7s | %-10s | %-8s%n",
            "Schritt", "Epoche", "Stress", "Moral", "Stress-Dämpf", "Glück", "Prod.", "PAL-P");
        System.out.println("---------------------------------------------------------------------------------------------------------------------");

        for (SimulationStepResult r : results) {
            System.out.printf("%-7d | %-32s | %-7.3f | %-7.3f | %-13s | %-7.3f | %-10.2f | %-6.1f%%%n",
                r.step(),
                r.epoch().getLabel(),
                r.stressIndex(),
                r.moralCoherence(),
                r.stressDampened() ? "⚡ GEPUFFERT" : "---",
                r.collectiveHappiness(),
                r.productivity(),
                r.palConfidence() * 100.0
            );
        }

        // Automatischen Export auf Festplatte ausführen
        exportResultsToFile(results);

        System.out.println("\n--- Version 2.3 Auswertung: Evolutionäre Stabilität und Harmonie erfolgreich berechnet! ---");
    }
}
