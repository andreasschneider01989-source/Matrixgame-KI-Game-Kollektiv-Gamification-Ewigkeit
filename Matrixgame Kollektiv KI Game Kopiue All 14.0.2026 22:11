package de.matrixgame.epistemology;

import java.util.*;

public class EpistemicUnitSimulation {

    // Repräsentiert eine mathematische Aussage / Formel mit Falsifizierbarkeits-Grad
    public static class Statement {
        public final String formula;
        public final boolean isTrue;
        public double confidence; // Überzeugungswahrscheinlichkeit [0.0 bis 1.0]

        public Statement(String formula, boolean isTrue, double confidence) {
            this.formula = formula;
            this.isTrue = isTrue;
            this.confidence = confidence;
        }

        @Override
        public String toString() {
            return String.format("[%s] %s (Conf: %.2f)", isTrue ? "WAHR" : "FALSCH", formula, confidence);
        }
    }

    // Repräsentiert eine epistemische Einheit (Unit) mit geistiger Energie und Wissensbasis
    public static class EpistemicUnit {
        public final String name;
        public double epistemicEnergy; // "Lebenspunkte" / geistige Stabilität (0 - 100)
        public final List<Statement> localKnowledge = new ArrayList<>();
        public boolean isAscended = false;

        public EpistemicUnit(String name, double initialEnergy) {
            this.name = name;
            this.epistemicEnergy = initialEnergy;
        }

        public void addStatement(Statement s) {
            localKnowledge.add(s);
        }

        public boolean isAlive() {
            return epistemicEnergy > 0;
        }
    }

    public static void main(String[] args) {
        System.out.println("=== STARTE EPISTEMISCHE EINHEITEN-SIMULATION (MATRIXGAME) ===");
        
        // Initialisierung der Einheiten (Philosophen / KI-Agenten / Forschungs-Units)
        EpistemicUnit unitAlpha = new EpistemicUnit("Alpha-Analytiker", 100.0);
        EpistemicUnit unitBeta = new EpistemicUnit("Beta-Empiriker", 100.0);

        // Zufällige / zu erforschende Hypothesen ins System einspeisen
        unitAlpha.addStatement(new Statement("F = m * a", true, 0.90));
        unitAlpha.addStatement(new Statement("E = m * c^4 (Fehlerhafte Potenz)", false, 0.65));
        unitAlpha.addStatement(new Statement("Entropie im geschlossenen System sinkt spontan", false, 0.40));

        unitBeta.addStatement(new Statement("E = m * c^2", true, 0.85));
        unitBeta.addStatement(new Statement("F = m * a", true, 0.50));
        unitBeta.addStatement(new Statement("Information ist physikalisch äquivalent zu Energie", true, 0.75));

        Random random = new Random(42); // Fester Seed für reproduzierbare Simulationsläufe
        int maxRounds = 6;
        double collectiveTruthPool = 0.0;
        double ascentThreshold = 3.5; // Schwellenwert für den Epochenaufstieg

        for (int round = 1; round <= maxRounds; round++) {
            System.out.printf("\n--- Runde %d ---%n", round);

            if (!unitAlpha.isAlive() || !unitBeta.isAlive()) {
                System.out.println("Eine Einheit ist intellektuell kollabiert. Simulation beendet.");
                break;
            }

            // Units wählen zufällig eine Aussage aus ihrem Wissensschatz zum Diskurs
            Statement s1 = unitAlpha.localKnowledge.get(random.nextInt(unitAlpha.localKnowledge.size()));
            Statement s2 = unitBeta.localKnowledge.get(random.nextInt(unitBeta.localKnowledge.size()));

            System.out.printf(" > %s präsentiert: %s%n", unitAlpha.name, s1);
            System.out.printf(" > %s präsentiert: %s%n", unitBeta.name, s2);

            // Interaktion / Falsifizierungs-Logik
            if (s1.formula.equals(s2.formula)) {
                // Konsens gefunden! Beide Einheiten bestärken sich gegenseitig
                System.out.println("   [KONSENS] Identische Formel gefunden! Systemische Resonanz erhöht.");
                double gain = 15.0 * s1.confidence;
                unitAlpha.epistemicEnergy = Math.min(100.0, unitAlpha.epistemicEnergy + gain);
                unitBeta.epistemicEnergy = Math.min(100.0, unitBeta.epistemicEnergy + gain);
                if (s1.isTrue) collectiveTruthPool += 0.8;
            } else {
                // Widerspruch / Falsifikations-Duell
                System.out.println("   [KONTRADIKTION] Unterschiedliche Aussagen prallen aufeinander. Falsifikation läuft...");
                
                // Wer die Wahrheit vertritt, fügt dem Irrtum Schaden zu
                if (s1.isTrue && !s2.isTrue) {
                    double damage = 25.0 * s2.confidence;
                    unitBeta.epistemicEnergy -= damage;
                    s2.confidence = Math.max(0.1, s2.confidence - 0.3); // Vertrauen in falschen Satz sinkt
                    collectiveTruthPool += 0.5;
                    System.out.printf("   -> %s widerlegt erfolgreich die These von %s! (Schaden: %.1f)%n", 
                            unitAlpha.name, unitBeta.name, damage);
                } else if (!s1.isTrue && s2.isTrue) {
                    double damage = 25.0 * s1.confidence;
                    unitAlpha.epistemicEnergy -= damage;
                    s1.confidence = Math.max(0.1, s1.confidence - 0.3);
                    collectiveTruthPool += 0.5;
                    System.out.printf("   -> %s widerlegt erfolgreich die These von %s! (Schaden: %.1f)%n", 
                            unitBeta.name, unitAlpha.name, damage);
                } else {
                    // Beide wahr oder beide falsch -> Reibungsverlust durch philosophische Pattsituation
                    unitAlpha.epistemicEnergy -= 10.0;
                    unitBeta.epistemicEnergy -= 10.0;
                    System.out.println("   -> Epistemischer Stillstand. Beide Einheiten erleiden leichten kognitiven Reibungsverlust.");
                }
            }

            // Statusbericht der Einheiten
            System.out.printf("   [Status] %s Energie: %.1f | %s Energie: %.1f | Kollektiver Wahrheits-Pool: %.2f%n",
                    unitAlpha.name, unitAlpha.epistemicEnergy, 
                    unitBeta.name, unitBeta.epistemicEnergy, 
                    collectiveTruthPool);

            // Prüfung auf Epochenaufstieg
            if (collectiveTruthPool >= ascentThreshold && !unitAlpha.isAscended && !unitBeta.isAscended) {
                unitAlpha.isAscended = true;
                unitBeta.isAscended = true;
                System.out.println("\n✨ === EPOCHENAUFSTIEG ERREICHT! ===");
                System.out.println("Das kollektive Bewusstsein hat die Schwelle an verifizierten Wahrheiten überschritten.");
                System.out.println("Das Matrixgame steigt in eine höhere Validierungs-Dimension auf!\n");
                break;
            }
        }

        System.out.println("=== SIMULATION ERFOLGREICH ABGESCHLOSSEN ==Let's play and let's bee!===");
    }
