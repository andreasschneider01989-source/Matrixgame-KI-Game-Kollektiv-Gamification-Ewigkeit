-- Tabellen für die hierarchischen Ebenen des Kollektiven Bewusstseins

-- Tabelle 3: collective_hierarchy_levels
-- Definiert die übergeordneten hierarchischen Ebenen des kollektiven Bewusstseins.
CREATE TABLE collective_hierarchy_levels (
