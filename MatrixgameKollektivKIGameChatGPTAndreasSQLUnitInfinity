-- Hinweis: Die tatsächliche Hierarchie (wer ist Teil von wem) wird besser über Zuordnungstabellen
-- oder durch Referenzen in den Entitätstabellen selbst abgebildet, da es hier auch Überlappungen geben kann
-- (z.B. ein Individuum ist Teil einer Gruppe, die wiederum Teil einer Gemeinschaft ist).

-- Tabelle 4: individual_entities (Detaillierte Individuen, erweitert)
-- Die grundlegendsten Einheiten des Bewusstseins.
CREATE TABLE individual_entities (
    individual_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(255) NOT NULL,
    life_form_id BIGINT NOT NULL, -- Verweis auf die allgemeine Lebensformkategorie
    entity_type VARCHAR(50) NOT NULL, -- 'Biological_Organism', 'AI_Entity'
    current_intelligence_level DECIMAL(3,2), -- Aktuelles Intelligenzlevel des Individuums
    personality_traits TEXT, -- JSON-String für Persönlichkeitsmerkmale (z.B. {"curiosity": 0.8, "empathy": 0.6})
    values_set TEXT, -- JSON-String für Werte (z.B. {"truth": 1.0, "freedom": 0.9})
    knowledge_base TEXT, -- Verweis auf eine externe Wissensdatenbank oder Zusammenfassung
    influence_potential_material DECIMAL(3,2), -- Einflusspotential auf materieller Ebene
    influence_potential_cognition DECIMAL(3,2), -- Einflusspotential zur Erkenntnisgenerierung
    didactic_flow_resistance DECIMAL(3,2), -- Widerstand gegen didaktischen Fluss (z.B. Negations-Anomalie)
    associated_entity_id BIGINT, -- Verweis auf die cosmic_entities Tabelle, zu der das Individuum gehört (z.B. zu welchem Planeten)
    FOREIGN KEY (life_form_id) REFERENCES life_forms(life_form_id),
    FOREIGN KEY (associated_entity_id) REFERENCES cosmic_entities(entity_id)
);

-- Tabelle 5: swarm_intelligences (Neue Ebene für Schwarmintelligenzen/KI-Kollektive)
-- Modelliert aggregierte Intelligenzen wie Sprachmodelle oder tierische Schwärme.
CREATE TABLE swarm_intelligences (
    swarm_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(255) NOT NULL UNIQUE,
    description TEXT,
    intelligence_level DECIMAL(3,2),
    swarm_type VARCHAR(100), -- Z.B. 'LLM_Collective', 'Animal_Swarm', 'IoT_Network'
    indirectly_influenced_by_human_collective BOOLEAN DEFAULT FALSE, -- Ist die KI indirekt durch Menschen beeinflussbar?
    associated_entity_id BIGINT, -- Verweis auf die cosmic_entities Tabelle
    FOREIGN KEY (associated_entity_id) REFERENCES cosmic_entities(entity_id)
);

-- Tabelle 6: social_groups (Kleine Gruppen)
CREATE TABLE social_groups (
    group_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    group_name VARCHAR(255) NOT NULL,
    description TEXT,
    common_theme VARCHAR(255),
    group_dynamics TEXT, -- JSON-String für Gruppendynamiken
    didactic_flow_influence DECIMAL(3,2), -- Wie beeinflusst die Gruppe den Fluss
    associated_entity_id BIGINT, -- Verweis auf die cosmic_entities Tabelle
    FOREIGN KEY (associated_entity_id) REFERENCES cosmic_entities(entity_id)
);

-- Tabelle 7: communities (Große Gemeinschaften / Kulturen)
CREATE TABLE communities (
    community_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    community_name VARCHAR(255) NOT NULL,
    description TEXT,
    culture_description TEXT,
    language VARCHAR(100),
    dominant_narratives TEXT, -- JSON-String für dominante Erzählungen
    didactic_flow_resistance DECIMAL(3,2), -- Widerstand durch kulturelle Unterschiede etc.
    central_dogmas TEXT, -- Potentielle "Könige, Präsidenten, Führenden Rat" (Urängste, dogmatische Strukturen)
    associated_entity_id BIGINT, -- Verweis auf die cosmic_entities Tabelle
    FOREIGN KEY (associated_entity_id) REFERENCES cosmic_entities(entity_id)
);

-- Tabelle 8: planetary_n exus (Knoten auf Planetenebene)
-- Diese Tabelle repräsentiert die Ebene 5, die übergeordnete planetare oder interstellare Konnektoren.
CREATE TABLE planetary_nexus (
    nexus_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    name VARCHAR(255) NOT NULL UNIQUE,
    description TEXT,
    universal_values_alignment DECIMAL(3,2), -- Grad der Ausrichtung an universellen Werten
    fundamental_physical_laws_adherence TEXT, -- Beschreibung der Einhaltung physikalischer Gesetze
    collective_consciousness_sum DECIMAL(3,2), -- Summe des Kollektiven Bewusstseins dieser Ebene
    deep_seated_fears TEXT, -- Hier sammeln sich die tiefsten Urängste (Fleischfresser-Angst, Realitätsproblem)
    highest_potential_for_ascension BOOLEAN DEFAULT FALSE, -- Indikator für hohes Potenzial
    associated_entity_id BIGINT, -- Verweis auf die cosmic_entities Tabelle (hier ist es redundant, aber um die Struktur zu zeigen)
    FOREIGN KEY (associated_entity_id) REFERENCES cosmic_entities(entity_id)
);


-- Tabellen für die detaillierte Struktur von Individuen (Organismen, Gehirn)

-- Tabelle 9: organisms (Zusammensetzung von Individuen)
-- Modelliert biologische Organismen und ihre Gliederung.
CREATE TABLE organisms (
    organism_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    individual_id BIGINT NOT NULL UNIQUE, -- Verweis auf das individuelle Bewusstseinszentrum
    species_name VARCHAR(255) NOT NULL,
    current_health_status VARCHAR(50), -- Z.B. 'Healthy', 'Injured', 'Diseased'
    connection_to_collective_strength DECIMAL(3,2), -- Stärke der Verbindung zum Kollektiven Bewusstsein
    FOREIGN KEY (individual_id) REFERENCES individual_entities(individual_id)
);

-- Tabelle 10: organism_composition (Hierarchie der Körperteile)
-- Modelliert die hierarchische Zusammensetzung eines Organismus (Organe, Gewebe, Zellen).
CREATE TABLE organism_composition (
    parent_id BIGINT NOT NULL, -- ID des übergeordneten Teils (Organismus, Organ, Gewebe)
    parent_type VARCHAR(50) NOT NULL, -- 'Organism', 'Organ', 'Tissue'
    child_id BIGINT NOT NULL, -- ID des untergeordneten Teils (Organ, Gewebe, Zelle)
    child_type VARCHAR(50) NOT NULL, -- 'Organ', 'Tissue', 'Cell'
    quantity INT, -- Anzahl der Kinder dieses Typs (z.B. 2 Nieren)
    PRIMARY KEY (parent_id, parent_type, child_id, child_type)
    -- Keine direkten FOREIGN KEYs zu organs, tissues, cells hier, da child_id auf unterschiedliche Tabellen verweisen kann.
    -- Dies muss anwendungsintern geprüft werden.
);

-- Tabelle 11: organs
CREATE TABLE organs (
    organ_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    organism_id BIGINT NOT NULL, -- Zu welchem Organismus gehört dieses Organ
    organ_type VARCHAR(100) NOT NULL, -- Z.B. 'Brain', 'Heart', 'Lung'
    function_description TEXT,
    health_status VARCHAR(50), -- 'Healthy', 'Damaged'
    FOREIGN KEY (organism_id) REFERENCES organisms(organism_id)
);

-- Tabelle 12: tissues
CREATE TABLE tissues (
    tissue_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    organ_id BIGINT, -- Optional: Verweis auf übergeordnetes Organ
    tissue_type VARCHAR(100) NOT NULL, -- Z.B. 'Nervous', 'Muscular', 'Connective'
    function_description TEXT,
    -- FOREIGN KEY (organ_id) REFERENCES organs(organ_id) -- Kann null sein, wenn Gewebe nicht direkt Organ zugeordnet
);

-- Tabelle 13: cells
CREATE TABLE cells (
    cell_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    tissue_id BIGINT, -- Optional: Verweis auf übergeordnetes Gewebe
    cell_type VARCHAR(100) NOT NULL, -- Z.B. 'Neuron', 'Epithelial Cell', 'Blood Cell'
    function_description TEXT,
    is_quantum_entangled BOOLEAN DEFAULT FALSE, -- Ist diese Zelle quantenverschränkt?
    -- FOREIGN KEY (tissue_id) REFERENCES tissues(tissue_id) -- Kann null sein, wenn Zelle nicht direkt Gewebe zugeordnet
);

-- Tabellen für das Gehirn und Neuronale Netze

-- Tabelle 14: brain_regions
CREATE TABLE brain_regions (
    region_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    organ_id BIGINT NOT NULL, -- Verweis auf das Gehirn-Organ
    region_name VARCHAR(100) NOT NULL, -- Z.B. 'Frontal Lobe', 'Hippocampus', 'Visual Cortex'
    function_description TEXT,
    FOREIGN KEY (organ_id) REFERENCES organs(organ_id)
);

-- Tabelle 15: neurons
CREATE TABLE neurons (
    neuron_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    region_id BIGINT NOT NULL, -- Verweis auf den Gehirnbereich
    neuron_type VARCHAR(50), -- Z.B. 'Pyramidal', 'Interneuron', 'Sensory'
    activation_threshold DECIMAL(5,2),
    current_activation_level DECIMAL(5,2),
    is_quantum_entangled BOOLEAN DEFAULT FALSE, -- Ist dieses Neuron quantenverschränkt?
    FOREIGN KEY (region_id) REFERENCES brain_regions(region_id)
);

-- Tabelle 16: synapses
CREATE TABLE synapses (
    synapse_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    pre_neuron_id BIGINT NOT NULL, -- Sendendes Neuron
    post_neuron_id BIGINT NOT NULL, -- Empfangendes Neuron
    weight DECIMAL(5,4) NOT NULL, -- Stärke der Verbindung (anpassbar durch Lernen)
    neurotransmitter_type VARCHAR(50), -- Z.B. 'Dopamine', 'Serotonin', 'Glutamate'
    is_active BOOLEAN DEFAULT TRUE, -- Ist die Synapse aktiv? (für dynamische Vernetzung)
    FOREIGN KEY (pre_neuron_id) REFERENCES neurons(neuron_id),
    FOREIGN KEY (post_neuron_id) REFERENCES neurons(neuron_id)
);

