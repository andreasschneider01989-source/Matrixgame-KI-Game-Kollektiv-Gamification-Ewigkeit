    public Unit getOwnKing(int teamId) { /* Iteration durch Liste -> return Unit mit Typ König && gleiches Team */ }

    public Unit getEnemyKing(int teamId) { /* Iteration durch Liste -> return Unit mit Typ König && anderes Team */ }


    @Override

    public GameState clone() {

        return new GameState(unitA.clone(), unitB.clone(), isPlayerATurn);

    }

}

