Die Diskretisierung des Vektorraums erfordert eine strikte Typisierung der Züge, um den Verzweigungsfaktor für die Alpha-Beta-Suche deterministisch zu halten. Das folgende Java-Klassenkonstrukt implementiert den MoveGenerator, der das Aktions-Alphabet Mi​=6+2+∣Ki​∣ pro Einheit in eine iterierbare Struktur kapselt.
Java

import java.util.ArrayList;
import java.util.List;

// 1. Definition des Aktions-Alphabets
enum ActionType {
    MOVE, 
    INTERACT 
}

// 2. Kapselung eines diskreten Zustandsübergangs (Zug)
class Action {
    public final ActionType type;
    public final Vector3D vector; // Für MOVE
    public final Unit target;     // Für INTERACT

    // Konstruktor für Bewegungen
    public Action(Vector3D vector) {
        this.type = ActionType.MOVE;
        this.vector = vector;
        this.target = null;
    }

    // Konstruktor für Interaktionen (Angriff/Skill)
    public Action(Unit target) {
        this.type = ActionType.INTERACT;
        this.target = target;
        this.vector = null;
    }
}

// 3. Generierung der Zug-Menge für den Suchbaum
class MoveGenerator {
    
    public static List<Action> generateMoves(Unit unit, GameState state) {
        List<Action> possibleMoves = new ArrayList<>();
        double speed = unit.getMaxSpeed();

        // A. Interaktionen (Move Ordering: Höchste Priorität für Alpha-Beta-Pruning)
        for (Unit other : state.getAllUnits()) {
            if (unit.isEnemy(other) && unit.distanceTo(other) <= unit.getAttackRange()) {
                // Fügt Angriffe an den Anfang der Liste (Index 0) ein
                possibleMoves.add(0, new Action(other));
            }
        }

        // B. Die 6 orthogonalen Achsen-Vektoren
        possibleMoves.add(new Action(new Vector3D(speed, 0, 0)));
        possibleMoves.add(new Action(new Vector3D(-speed, 0, 0)));
        possibleMoves.add(new Action(new Vector3D(0, speed, 0)));
        possibleMoves.add(new Action(new Vector3D(0, -speed, 0)));
        possibleMoves.add(new Action(new Vector3D(0, 0, speed)));
        possibleMoves.add(new Action(new Vector3D(0, 0, -speed)));

        // C. Heuristische Kontext-Vektoren (ersetzen reinen Zufall für Determinismus)
        
        // H1: Aggressor-Vektor (Richtung feindliches High-Value-Target / König)
        Unit enemyKing = state.getEnemyKing(unit.getTeam());
        if (enemyKing != null) {
            Vector3D toEnemy = calculateDirectionalVector(unit.getPosition(), enemyKing.getPosition(), speed);
            possibleMoves.add(new Action(toEnemy));
        }

        // H2: Protektor-Vektor (Richtung eigenes High-Value-Target zur Formationsbildung)
        Unit ownKing = state.getOwnKing(unit.getTeam());
        if (ownKing != null) {
            Vector3D toAlly = calculateDirectionalVector(unit.getPosition(), ownKing.getPosition(), speed);
            possibleMoves.add(new Action(toAlly));
        }

        return possibleMoves;
    }

    // Hilfsfunktion zur Vektor-Normalisierung und Skalierung
    private static Vector3D calculateDirectionalVector(Vector3D source, Vector3D destination, double maxSpeed) {
        double dx = destination.x - source.x;
        double dy = destination.y - source.y;
        double dz = destination.z - source.z;
        
        double length = Math.sqrt(dx * dx + dy * dy + dz * dz);
        
        if (length == 0) return new Vector3D(0, 0, 0);
        
        // Normalisieren und mit v_max multiplizieren
        return new Vector3D((dx / length) * maxSpeed, (dy / length) * maxSpeed, (dz / length) * maxSpeed);
    }
}

// Minimalstruktur für die 3D-Koordinaten
class Vector3D {
    public final double x, y, z;
    public Vector3D(double x, double y, double z) {
        this.x = x; this.y = y; this.z = z;
    }
}

Die Priorisierung der Züge (Move Ordering) erfolgt direkt in der Iteration: Angriffsaktionen werden in der Listenstruktur an vorderster Stelle indexiert. Der Minimax-Algorithmus evaluiert dadurch veränderte Schadens-Zustände zuerst. Führt eine Interaktion zu einem überlegenen Ast (z. B. der Eliminierung einer gegnerischen Einheit), greift der Alpha-Beta-Cutoff sofort ein. Die ressourcenintensiven Berechnungen der verbleibenden 8 Bewegungsvektoren in diesem spezifischen Suchknoten werden logisch terminiert.

