public class Unit implements Cloneable {
    public int x, y;
    public int hp;
    public int cooldown; // Rest-Cooldown in Ticks

    public Unit(int x, int y, int hp, int cooldown) {
        this.x = x;
        this.y = y;
        this.hp = hp;
        this.cooldown = cooldown;
    }

    public double distanceTo(Unit other) {
        return Math.hypot(this.x - other.x, this.y - other.y);
    }

    @Override
    public Unit clone() {
        return new Unit(x, y, hp, cooldown);
    }
}

