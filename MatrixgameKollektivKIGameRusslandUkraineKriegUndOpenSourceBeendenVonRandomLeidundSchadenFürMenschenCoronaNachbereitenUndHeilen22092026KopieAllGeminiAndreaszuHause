    public static final int ATTACK_DAMAGE = 25;
    public static final int ATTACK_COOLDOWN = 2;   // Ticks Cooldown nach Angriff

    public GameState(Unit unitA, Unit unitB, boolean isPlayerATurn) {
        this.unitA = unitA;
        this.unitB = unitB;
        this.isPlayerATurn = isPlayerATurn;
    }

    public boolean isTerminal() {
        return unitA.hp <= 0 || unitB.hp <= 0;
    }

    /**
     * Generiert alle legalen Aktionen für die aktive Einheit.
     */
    public List<ActionType> getLegalActions() {
        List<ActionType> actions = new ArrayList<>();
        if (isTerminal()) return actions;

        Unit active = isPlayerATurn ? unitA : unitB;
        Unit target = isPlayerATurn ? unitB : unitA;

        // 1. Angriff prüfen (nur erlaubt, wenn Cooldown = 0 und Ziel in Reichweite)
        if (active.cooldown == 0 && active.distanceTo(target) <= ATTACK_RANGE) {
            actions.add(ActionType.ATTACK);
        }

        // 2. Bewegungen auf Spielfeldgrenzen und Besetzung prüfen
        for (ActionType move : new ActionType[]{ActionType.MOVE_UP, ActionType.MOVE_DOWN, ActionType.MOVE_LEFT, ActionType.MOVE_RIGHT}) {
            int nx = active.x + move.dx;
            int ny = active.y + move.dy;

            if (nx >= 0 && nx < GRID_SIZE && ny >= 0 && ny < GRID_SIZE) {
                if (!(nx == target.x && ny == target.y)) { // Kein Überlappen auf demselben Feld
                    actions.add(move);
                }
            }
        }

        // 3. Warten ist stets eine valide Option
        actions.add(ActionType.WAIT);
        return actions;
    }

    /**
     * Wendet eine Aktion an und liefert den Folgezustand S' zurück.
     */
    public GameState applyAction(ActionType action) {
        GameState nextState = this.clone();
        Unit active = nextState.isPlayerATurn ? nextState.unitA : nextState.unitB;
        Unit target = nextState.isPlayerATurn ? nextState.unitB : nextState.unitA;

        // Cooldown-Abbau bei Agieren
        if (active.cooldown > 0) {
            active.cooldown--;
        }

        if (action == ActionType.ATTACK) {
            target.hp -= ATTACK_DAMAGE;
            active.cooldown = ATTACK_COOLDOWN;
        } else if (action != ActionType.WAIT) {
            active.x += action.dx;
            active.y += action.dy;
        }

        // Spielerwechsel (wechselseitige Turns)
        nextState.isPlayerATurn = !nextState.isPlayerATurn;
        return nextState;
    }

    /**
     * Heuristische Evaluierungsfunktion V(S) aus der Perspektive von Unit A.
     */
    public double evaluate() {
        if (unitA.hp <= 0) return -10000.0;
        if (unitB.hp <= 0) return 10000.0;

        double hpWeight = 100.0;
        double cdWeight = 10.0;
        double distWeight = 2.0;

        double hpDiff = (unitA.hp - unitB.hp) * hpWeight;
        double cdDiff = (unitB.cooldown - unitA.cooldown) * cdWeight;
        double distPenalty = -unitA.distanceTo(unitB) * distWeight;

        return hpDiff + cdDiff + distPenalty;
    }

    @Override
    public GameState clone() {
        return new GameState(unitA.clone(), unitB.clone(), isPlayerATurn);
    }
}

4. MinimaxAlphaBeta.java

Führt die Baumsuche mit Alpha-Beta-Pruning durch.
Java

import java.util.List;

public class MinimaxAlphaBeta {

    public static class SearchResult {
        public final ActionType bestAction;
        public final double score;

        public SearchResult(ActionType bestAction, double score) {
            this.bestAction = bestAction;
            this.score = score;
        }
    }

    public static SearchResult search(GameState state, int depth) {
        return alphabeta(state, depth, Double.NEGATIVE_INFINITY, Double.POSITIVE_INFINITY, state.isPlayerATurn);
    }

    private static SearchResult alphabeta(GameState state, int depth, double alpha, double beta, boolean maximizingPlayer) {
        if (depth == 0 || state.isTerminal()) {
            return new SearchResult(null, state.evaluate());
        }

        List<ActionType> legalActions = state.getLegalActions();
        if (legalActions.isEmpty()) {
            return new SearchResult(ActionType.WAIT, state.evaluate());
        }

        ActionType bestAction = legalActions.get(0);

        if (maximizingPlayer) {
            double maxEval = Double.NEGATIVE_INFINITY;
            for (ActionType action : legalActions) {
                GameState nextState = state.applyAction(action);
                double eval = alphabeta(nextState, depth - 1, alpha, beta, false).score;

                if (eval > maxEval) {
                    maxEval = eval;
                    bestAction = action;
                }
                alpha = Math.max(alpha, eval);
                if (beta <= alpha) {
                    break; // Alpha-Beta Cut-off (Pruning)
                }
            }
            return new SearchResult(bestAction, maxEval);
        } else {
            double minEval = Double.POSITIVE_INFINITY;
            for (ActionType action : legalActions) {
                GameState nextState = state.applyAction(action);
                double eval = alphabeta(nextState, depth - 1, alpha, beta, true).score;

                if (eval < minEval) {
                    minEval = eval;
                    bestAction = action;
                }
                beta = Math.min(beta, eval);
                if (beta <= alpha) {
                    break; // Alpha-Beta Cut-off (Pruning)
                }
            }
            return new SearchResult(bestAction, minEval);
        }
    }
}

