	public void moveTo(KreisObjekt oponent) {
		double distQ = (this.posX - oponent.posX) * (this.posX - oponent.posX)
				+ (this.posY - oponent.posY) * (this.posY - oponent.posY)
				+ (this.posZ - oponent.posZ) * (this.posZ - oponent.posZ);
		double dist = Math.pow(distQ, 0.5);

		double dx = posX - oponent.posX;
		double dy = posY - oponent.posY;
		double dz = posZ - oponent.posZ;

		double movDist = Math.min(maxSpeed * ((System.currentTimeMillis() - timeBefore) / 1000.0),
				Math.abs(dist - reichweite));
		movDist /= 1.01;

		vx = -dx / dist * movDist;
		vy = -dy / dist * movDist;
		vz = -dz / dist * movDist;

		System.out.println("Move: " + vx + "," + vy + "," + vz);
		move(1);
	}
	
	// NEU: Prädiktives Bewegen (Logisch & Mathematisch effizienter)
	// Berechnet den Vorhaltewinkel basierend auf der Geschwindigkeit des Ziels.
	public void predictiveMoveTo(KreisObjekt oponent) {
		double dist = getDistanceTo(oponent.posX, oponent.posY, oponent.posZ);
		if (dist < 0.001) return;
		
		// Geschätzte Zeit bis zum Kontakt (Distanz / eigene Geschwindigkeit)
		double timeToIntercept = dist / Math.max(1.0, this.maxSpeed);
		
		// Vorhersage der zukünftigen Position des Ziels
		double predictedX = oponent.posX + (oponent.vx * timeToIntercept);
		double predictedY = oponent.posY + (oponent.vy * timeToIntercept);
		double predictedZ = oponent.posZ + (oponent.vz * timeToIntercept);
		
		moveTo(predictedX, predictedY, predictedZ, maxSpeed);
	}

	public void moveToAndKite(KreisObjekt oponent) {
		double distQ = (this.posX - oponent.posX) * (this.posX - oponent.posX)
				+ (this.posY - oponent.posY) * (this.posY - oponent.posY)
				+ (this.posZ - oponent.posZ) * (this.posZ - oponent.posZ);
		double dist = Math.pow(distQ, 0.5);

		double dx = posX - oponent.posX;
		double dy = posY - oponent.posY;
		double dz = posZ - oponent.posZ;

		double movDist = Math.min(maxSpeed, Math.abs(dist - reichweite));

		if (reichweite > dist) {
			movDist = reichweite - dist;
			movDist = -movDist;
		}
		
		if(movDist > 0) movDist = movDist + 0.01;
		else movDist = movDist + 0.01;
			
		vx = -dx / dist * movDist;
		vy = -dy / dist * movDist;
		vz = -dz / dist * movDist;

		System.out.println("Move: " + vx + "," + vy + "," + vz);
		move(1);
	}

	void update() {
		System.out.println("Update: Unit.id = " + this.id+" Unit.posX = "+this.posX+" Unit.posY = "+this.posY+" Unit.posZ = "+this.posZ);
		deltaTime = currentTime - timeBefore;
		timeSeconds = deltaTime / 1000.0;
		
		// NEU: Energie-Regeneration pro Zeitschritt berechnen
		if(this.energy < this.maxEnergy) {
			this.energy = Math.min(this.maxEnergy, this.energy + (this.energyRegen * timeSeconds));
		}

		if (!this.typ.equals("King") && this.target != null) {
			performMove();
		}
		
		if (this.typ.equals("King") && this.target != null && this.target.reichweite >= getDistance(this.target)) {
			performMove();
		}

		if (!legalMove()) {
			posX = posXBefore;
			posY = posYBefore;
			posZ = posZBefore;
		}

		// Angriff nur wenn bereit und in Reichweite
		if (this.target != null) {
			if(getDistance(this.target) <= reichweite) {
				if(canAttack()) {
					performAttack(this.target); 
				}
			} else {
				System.out.println("Reichweite ist zu klein: Reichweite = "+reichweite+" Abstand = "+getDistance(this.target));
			}
		}

		posXBefore = posX;
		posYBefore = posY;
		posZBefore = posZ;
		timeBefore = currentTime;
		
		// Status-Update für saubere Zustandsmaschine
		if (this.leben <= 0) this.currentState = UnitState.DEAD;
		else if (this.target != null && getDistance(this.target) <= reichweite) this.currentState = UnitState.ATTACKING;
		else if (this.target != null) this.currentState = UnitState.MOVING;
		else this.currentState = UnitState.IDLE;
	}

	public void moveTo(double posX, double posY, double posZ, double speedManuel) {
		System.out.println("Zug = moveTo(" + posX + "," + posY + "," + posZ + "," + speedManuel + ")");
		double distQ = (this.posX - posX) * (this.posX - posX) + (this.posY - posY) * (this.posY - posY)
				+ (this.posZ - posZ) * (this.posZ - posZ);

		double dist = Math.pow(distQ, 0.5);

		if (dist < 0.001) {
			vx = 0; vy = 0; vz = 0;
			move(1);
			return;
		}

		double dx = this.posX - posX;
		double dy = this.posY - posY;
		double dz = this.posZ - posZ;

		double movDist = Math.min(speedManuel, Math.min(maxSpeed, Math.abs(dist - 0.0000005)));

		vx = -dx / dist * movDist;
		vy = -dy / dist * movDist;
		vz = -dz / dist * movDist;

		System.out.println("Vektor = " + vx + "," + vy + "," + vz);
		move(1);
	}

