import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.util.ArrayList;
import java.util.List;

public class MatrixgameUnifiedSystem3D extends JFrame {

    private static final double G = 6.67430e-11; // Gravitationskonstante

    // 1. Himmelskörper (Sonnensystem-Proportionen & Newton-Gravitation)
    public static class CelestialBody {
        public String name;
        public double x, y, z;
        public double vx, vy, vz;
        public double fx, fy, fz;
        public double mass;
        public Color color;

        public CelestialBody(String name, double x, double y, double z, double vx, double vy, double vz, double mass, Color color) {
            this.name = name;
            this.x = x; this.y = y; this.z = z;
            this.vx = vx; this.vy = vy; this.vz = vz;
            this.mass = mass;
            this.color = color;
        }

        public void resetForces() {
            this.fx = 0.0; this.fy = 0.0; this.fz = 0.0;
        }
    }

    // 2. Taktische Kampfeinheiten (aus der Unit-Fight-Simulation mit Gewichtungen & HP)
    public static class CombatUnit {
        public String id;
        public double x, y, z;
        public double vx, vy, vz;
        public double health;
        public double attackPower;
        public double weightFactor; // Gewichtung aus der Unit-Fight-Sim
        public boolean isAlive;
        public Color color;

        public CombatUnit(String id, double x, double y, double z, double vx, double vy, double vz, double health, double attackPower, double weightFactor, Color color) {
            this.id = id;
            this.x = x; this.y = y; this.z = z;
            this.vx = vx; this.vy = vy; this.vz = vz;
            this.health = health;
            this.attackPower = attackPower;
            this.weightFactor = weightFactor;
            this.isAlive = true;
            this.color = color;
        }
    }

    private List<CelestialBody> celestialBodies;
    private List<CombatUnit> combatUnits;
    private SimulationCanvas canvas;

    public MatrixgameUnifiedSystem3D() {
        setTitle("Matrixgame Unified System: Sonnensystem & Unit-Fight-Simulation");
        setSize(1000, 1000);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);

        celestialBodies = new ArrayList<>();
        combatUnits = new ArrayList<>();

        // Himmelskörper initialisieren (Sonne, Erde, Mars mit realen Verhältnissen)
        celestialBodies.add(new CelestialBody("Sonne", 0, 0, 0, 0, 0, 0, 1.989e30, Color.YELLOW));
        celestialBodies.add(new CelestialBody("Erde", 1.496e11, 0, 0, 0, 29783, 0, 5.972e24, Color.CYAN));
        celestialBodies.add(new CelestialBody("Mars", 2.279e11, 0, 0, 0, 24077, 0, 6.417e23, Color.ORANGE));

        // Taktische Einheiten aus der Unit-Fight-Simulation initialisieren (mit Gewichtungen)
        combatUnits.add(new CombatUnit("Einheit-Alpha-1", 1.50e11, 1.0e9, 5.0e9, 0, 30000, 100, 100.0, 15.0, 1.2, Color.GREEN));
        combatUnits.add(new CombatUnit("Einheit-Beta-1", 2.28e11, -1.0e9, -5.0e9, 0, -24500, -100, 100.0, 12.0, 1.0, Color.RED));

        canvas = new SimulationCanvas();
        add(canvas, BorderLayout.CENTER);

        // Physik- und Kampf-Timer (Echtzeit-Schleife)
        Timer timer = new Timer(16, new ActionListener() {
            private final double dt = 3600.0 * 4; // 4 Stunden pro Frame

            @Override
            public void actionPerformed(ActionEvent e) {
                updatePhysicsAndCombat(dt);
                canvas.repaint();
            }
        });
        timer.start();
    }

    private void updatePhysicsAndCombat(double dt) {
        // A. Gravitation der Himmelskörper berechnen (Newton / Invers-Quadrat-Gesetz)
        for (CelestialBody b : celestialBodies) {
            b.resetForces();
        }

        for (int i = 0; i < celestialBodies.size(); i++) {
            for (int j = i + 1; j < celestialBodies.size(); j++) {
                CelestialBody b1 = celestialBodies.get(i);
                CelestialBody b2 = celestialBodies.get(j);

                double dx = b2.x - b1.x;
                double dy = b2.y - b1.y;
                double dz = b2.z - b1.z;
                double r2 = dx * dx + dy * dy + dz * dz + 1e-10;
                double r = Math.sqrt(r2);

                double fMag = (G * b1.mass * b2.mass) / r2;
                double nx = dx / r, ny = dy / r, nz = dz / r;

                b1.fx += fMag * nx; b1.fy += fMag * ny; b1.fz += fMag * nz;
                b2.fx -= fMag * nx; b2.fy -= fMag * ny; b2.fz -= fMag * nz;
            }
        }

        // Himmelskörper aktualisieren
        for (CelestialBody b : celestialBodies) {
            double ax = b.fx / b.mass;
            double ay = b.fy / b.mass;
            double az = b.fz / b.mass;
            b.vx += ax * dt; b.vy += ay * dt; b.vz += az * dt;
            b.x += b.vx * dt; b.y += b.vy * dt; b.z += b.vz * dt;
        }

        // B. Einheiten-Logik: Bewegung im Gravitationsfeld & Unit-Fight-Interaktion
        for (CombatUnit unit : combatUnits) {
            if (!unit.isAlive) continue;

            // Vereinfachte Gravitationsanziehung durch die Sonne für die Einheiten
            CelestialBody sun = celestialBodies.get(0);
            double dx = sun.x - unit.x;
            double dy = sun.y - unit.y;
            double dz = sun.z - unit.z;
            double r2 = dx * dx + dy * dy + dz * dz + 1e-10;
            double r = Math.sqrt(r2);
            double fSun = (G * sun.mass * 1000.0) / r2; // Beispielmasse für Einheit

            unit.vx += (fSun * (dx / r) / 1000.0) * dt;
            unit.vy += (fSun * (dy / r) / 1000.0) * dt;
            unit.vz += (fSun * (dz / r) / 1000.0) * dt;

            unit.x += unit.vx * dt;
            unit.y += unit.vy * dt;
            unit.z += unit.vz * dt;

            // Unit-Fight Kollisions- und Kampfprüfung zwischen Einheiten
            for (CombatUnit other : combatUnits) {
                if (other != unit && other.isAlive) {
                    double udistance = Math.sqrt(Math.pow(other.x - unit.x, 2) + Math.pow(other.y - unit.y, 2));
                    if (udistance < 5.0e9) { // Nahkampf-Reichweite im Raummaßstab
                        // Schaden basierend auf Angriffskraft und Gewichtung
                        other.health -= (unit.attackPower * unit.weightFactor) * 0.001;
                        if (other.health <= 0) {
                            other.isAlive = false;
                        }
                    }
                }
            }
        }
    }

    // Grafische Darstellung (Canvas für Sonnensystem und Einheiten)
    private class SimulationCanvas extends JPanel {
        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            setBackground(Color.BLACK);

            Graphics2D g2d = (Graphics2D) g;
            g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            int width = getWidth();
            int height = getHeight();
            int cx = width / 2;
            int cy = height / 2;
            double scale = 2.0e-9; // Skalierungsfaktor für astronomische Distanzen

            // Himmelskörper zeichnen
            for (CelestialBody b : celestialBodies) {
                int sx = cx + (int) (b.x * scale);
                int sy = cy + (int) (b.y * scale);
                int radius = b.name.equals("Sonne") ? 20 : 8;

                g2d.setColor(b.color);
                g2d.fillOval(sx - radius / 2, sy - radius / 2, radius, radius);

                g2d.setColor(Color.WHITE);
                g2d.setFont(new Font("Monospaced", Font.PLAIN, 11));
                g2d.drawString(b.name, sx + 12, sy + 4);
            }

            // Kampfeinheiten der Unit-Fight-Simulation zeichnen
            for (CombatUnit u : combatUnits) {
                if (!u.isAlive) continue;
                int sx = cx + (int) (u.x * scale);
                int sy = cy + (int) (u.y * scale);

                g2d.setColor(u.color);
                g2d.fillRect(sx - 4, sy - 4, 8, 8);

                g2d.setColor(Color.GREEN);
                g2d.drawString(u.id + " [HP: " + (int)u.health + "]", sx + 10, sy - 5);
            }
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            new MatrixgameUnifiedSystem3D().setVisible(true);
        });
    }
