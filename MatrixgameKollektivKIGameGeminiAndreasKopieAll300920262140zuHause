package com.matrixgame.core;

import java.util.ArrayList;
import java.util.List;

/**
 * Berechnet Kausalitaeten und physikalische Wechselwirkungen
 * zwischen allen aktiven MatrixUnits.
 */
public class PhysicsEngine {

    private final List<MatrixUnit> units;
    private double gravitationalConstant = 0.1; // Skalierte Simulationskonstante
    private double epsilon = 0.5; // Daempfungsfaktor zur Vermeidung von Division durch 0

    public PhysicsEngine() {
        this.units = new ArrayList<>();
    }

    public void addUnit(MatrixUnit unit) {
        units.add(unit);
    }

    public List<MatrixUnit> getUnits() {
        return units;
    }

    // Ein Simulationsschritt
    public void step(double dt) {
        // 1. Kraefte zuruecksetzen
        for (MatrixUnit unit : units) {
            unit.resetForces();
        }

        // 2. Wechselwirkungen berechnen (Paarweise Gravitation)
        for (int i = 0; i < units.size(); i++) {
            for (int j = i + 1; j < units.size(); j++) {
                MatrixUnit u1 = units.get(i);
                MatrixUnit u2 = units.get(j);

                double dx = u2.getPosX() - u1.getPosX();
                double dy = u2.getPosY() - u1.getPosY();
                double distSq = dx * dx + dy * dy + epsilon * epsilon;
                double dist = Math.sqrt(distSq);

                // F = G * m1 * m2 / distSq
                double forceMagnitude = (gravitationalConstant * u1.getMass() * u2.getMass()) / distSq;

                double fx = forceMagnitude * (dx / dist);
                double fy = forceMagnitude * (dy / dist);

                u1.addForce(fx, fy);
                u2.addForce(-fx, -fy); // Actio = Reactio
            }
        }

        // 3. Zustaende aktualisieren
        for (MatrixUnit unit : units) {
            unit.updateState(dt);
        }
    }
}
