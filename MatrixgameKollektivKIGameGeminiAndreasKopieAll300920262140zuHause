package com.matrixgame.core;

/**
 * Basis-Unit als fundamentales Datenobjekt im Matrixgame.
 * Nutzt 'double' fuer hohe physikalische und visuelle Praezision.
 */
public class MatrixUnit {

    // Identifikation und Zustand
    private String id;
    private boolean selected;

    // Raum-Zustandsvariablen (Welt-Koordinaten)
    private double posX;
    private double posY;
    private double velX;
    private double velY;
    private double forceX;
    private double forceY;

    // Physikalische und energetische Parameter
    private double mass;
    private double energyValue;
    private double scale; // Individueller Skalierungsfaktor

    public MatrixUnit(String id, double posX, double posY, double mass) {
        this.id = id;
        this.posX = posX;
        this.posY = posY;
        this.velX = 0.0;
        this.velY = 0.0;
        this.forceX = 0.0;
        this.forceY = 0.0;
        this.mass = mass > 0 ? mass : 1.0;
        this.energyValue = 0.0;
        this.scale = 1.0;
        this.selected = false;
    }

    // Physikalische Kraefte zuruecksetzen
    public void resetForces() {
        this.forceX = 0.0;
        this.forceY = 0.0;
    }

    // Kraft aufaddieren (F = m * a)
    public void addForce(double fx, double fy) {
        this.forceX += fx;
        this.forceY += fy;
    }

    // Kausalitaets-Update durchfuehren
    public void updateState(double dt) {
        // Beschleunigung berechnen: a = F / m
        double ax = forceX / mass;
        double ay = forceY / mass;

        // Velocity-Verlet / Euler-Cromer Schritt
        velX += ax * dt;
        velY += ay * dt;

        posX += velX * dt;
        posY += velY * dt;
    }

    // Getter und Setter
    public String getId() { return id; }
    public boolean isSelected() { return selected; }
    public void setSelected(boolean selected) { this.selected = selected; }

    public double getPosX() { return posX; }
    public void setPosX(double posX) { this.posX = posX; }

    public double getPosY() { return posY; }
    public void setPosY(double posY) { this.posY = posY; }

    public double getVelX() { return velX; }
    public double getVelY() { return velY; }

    public double getMass() { return mass; }
    public void setMass(double mass) { this.mass = mass > 0 ? mass : 1.0; }

    public double getEnergyValue() { return energyValue; }
    public void setEnergyValue(double energyValue) { this.energyValue = energyValue; }

    public double getScale() { return scale; }
    public void setScale(double scale) { this.scale = scale; }
}
