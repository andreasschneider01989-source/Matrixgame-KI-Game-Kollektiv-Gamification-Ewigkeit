        combatUnits.add(new CombatUnit(name, 1.496e11 + Math.random()*1e9, 3.0e9, 0, 0, 28000, 0, 1.8e5, 110.0, 20.0, Color.YELLOW));
        System.out.println(">>> [HELDENREISE] Neue Einheit betritt das Spielfeld: " + name);
    }

    private void updatePhysicsAndCombat(double dt) {
        // 1. Gravitation der Himmelskörper
        for (CelestialBody b : celestialBodies) b.resetForces();

        for (int i = 0; i < celestialBodies.size(); i++) {
            for (int j = i + 1; j < celestialBodies.size(); j++) {
                CelestialBody b1 = celestialBodies.get(i);
                CelestialBody b2 = celestialBodies.get(j);

                double dx = b2.x - b1.x;
                double dy = b2.y - b1.y;
                double dz = b2.z - b1.z;
                double r2 = dx * dx + dy * dy + dz * dz + 1e-10;
                double r = Math.sqrt(r2);

                double fMag = (G * b1.mass * b2.mass) / r2;
                double nx = dx / r, ny = dy / r, nz = dz / r;

                b1.fx += fMag * nx; b1.fy += fMag * ny; b1.fz += fMag * nz;
                b2.fx -= fMag * nx; b2.fy -= fMag * ny; b2.fz -= fMag * nz;
            }
        }

        for (CelestialBody b : celestialBodies) {
            double ax = b.fx / b.mass;
            double ay = b.fy / b.mass;
            double az = b.fz / b.mass;
            b.vx += ax * dt; b.vy += ay * dt; b.vz += az * dt;
            b.x += b.vx * dt; b.y += b.vy * dt; b.z += b.vz * dt;
        }

        // 2. Einheiten-Physik (Sonnengravitation + Formelsammlung-Wirkung)
        for (CombatUnit u : combatUnits) {
            if (!u.isAlive) continue;

            CelestialBody sun = celestialBodies.get(0);
            double dx = sun.x - u.x;
            double dy = sun.y - u.y;
            double dz = sun.z - u.z;
            double r2 = dx * dx + dy * dy + dz * dz + 1e-10;
            double r = Math.sqrt(r2);
            double fSun = (G * sun.mass * u.mass) / r2;

            double ax = (fSun * (dx / r)) / u.mass;
            double ay = (fSun * (dy / r)) / u.mass;

            u.vx += ax * dt;
            u.vy += ay * dt;
            u.x += u.vx * dt;
            u.y += u.vy * dt;

            // 3. Unit-Fight Kollision & Kinetische Energie / Impuls-Berechnung
            for (CombatUnit other : combatUnits) {
                if (other != u && other.isAlive) {
                    double dist = Math.sqrt(Math.pow(other.x - u.x, 2) + Math.pow(other.y - u.y, 2));
                    if (dist < 1.0e10) {
                        // Schaden basiert auf Kinetischer Energie & Angriffskraft (Formelsammlung)
                        double impactDamage = (u.attackPower * 0.001) + (u.getKineticEnergy() * 1e-12);
                        other.health -= impactDamage;

                        if (stepCount % 50 == 0) {
                            System.out.printf("[HELDENREISE] %s kollidiert mit %s | E_kin: %.2e J | Schaden: %.2f | HP: %.1f%n",
                                    u.id, other.id, u.getKineticEnergy(), impactDamage, Math.max(0, other.health));
                        }

                        if (other.health <= 0) {
                            other.isAlive = false;
                            u.kills++;
                            System.out.printf(">>> [MATRIXGAME MEILENSTEIN] %s hat %s eliminiert! (Kills: %d)%n",
                                    u.id, other.id, u.kills);
                        }
                    }
                }
            }
        }
    }

    // Interaktives Canvas mit Klick-Auswahl & Zielsteuerung
    private class SimulationCanvas extends JPanel {
        public SimulationCanvas() {
            setBackground(Color.BLACK);

            // Maus-Steuerung für Pan, Selektion und Befehle
            addMouseListener(new MouseAdapter() {
                @Override
                public void mousePressed(MouseEvent e) {
                    mousePrevX = e.getX();
                    mousePrevY = e.getY();

                    int width = getWidth();
                    int height = getHeight();
                    int cx = width / 2 + (int) panX;
                    int cy = height / 2 + (int) panY;

                    // Prüfen, ob eine Einheit angeklickt wurde (Auswahl)
                    for (CombatUnit u : combatUnits) {
                        if (!u.isAlive) continue;
                        int sx = cx + (int) (u.x * scale);
                        int sy = cy + (int) (u.y * scale);
                        if (Math.abs(e.getX() - sx) < 15 && Math.abs(e.getY() - sy) < 15) {
                            for (CombatUnit cu : combatUnits) cu.isSelected = false;
                            u.isSelected = true;
                            selectedUnit = u;
                            System.out.println(">>> [BEFEHL] Einheit ausgewählt: " + u.id + " (E_kin: " + String.format("%.2e", u.getKineticEnergy()) + " J)");
                            repaint();
                            return;
                        }
                    }

                    // Wenn keine Einheit getroffen wurde und eine Einheit ausgewählt ist -> Zielbefehl zuweisen!
                    if (selectedUnit != null && SwingUtilities.isRightMouseButton(e) || SwingUtilities.isLeftMouseButton(e)) {
                        double targetX = (e.getX() - cx) / scale;
                        double targetY = (e.getY() - cy) / scale;
                        
                        // Kursvektor anpassen (Impuls-Steuerung)
                        double angle = Math.atan2(targetY - selectedUnit.y, targetX - selectedUnit.x);
                        double speed = 25000.0;
                        selectedUnit.vx = Math.cos(angle) * speed;
                        selectedUnit.vy = Math.sin(angle) * speed;
                        System.out.printf(">>> [KURSBEFEHL] %s steuert neue Koordinaten an!%n", selectedUnit.id);
                    }
                }
            });

            addMouseMotionListener(new MouseMotionAdapter() {
                @Override
                public void mouseDragged(MouseEvent e) {
                    // Nur pannen, wenn keine Einheit aktiv gesteuert wird
                    int dx = e.getX() - mousePrevX;
                    int dy = e.getY() - mousePrevY;
                    panX += dx;
                    panY += dy;
                    mousePrevX = e.getX();
                    mousePrevY = e.getY();
                    repaint();
                }
            });

            addMouseWheelListener(e -> {
                if (e.getWheelRotation() < 0) scale *= 1.15;
                else scale /= 1.15;
                repaint();
            });
        }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2d = (Graphics2D) g;
            g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            int width = getWidth();
            int height = getHeight();
            int cx = width / 2 + (int) panX;
            int cy = height / 2 + (int) panY;

            // Koordinatenkreuz
            g2d.setColor(new Color(40, 40, 40));
            g2d.drawLine(0, cy, width, cy);
            g2d.drawLine(cx, 0, cx, height);

            // Himmelskörper
            for (CelestialBody b : celestialBodies) {
                int sx = cx + (int) (b.x * scale);
                int sy = cy + (int) (b.y * scale);
                int radius = b.name.equals("Sonne") ? 22 : 8;

                g2d.setColor(b.color);
                g2d.fillOval(sx - radius / 2, sy - radius / 2, radius, radius);

                g2d.setColor(Color.WHITE);
                g2d.setFont(new Font("Monospaced", Font.BOLD, 12));
                g2d.drawString(b.name, sx + 12, sy + 4);
            }

            // Kampfeinheiten & Auswahlanzeige
            for (CombatUnit u : combatUnits) {
                if (!u.isAlive) continue;
                int sx = cx + (int) (u.x * scale);
                int sy = cy + (int) (u.y * scale);

                if (u.isSelected) {
                    g2d.setColor(Color.WHITE);
                    g2d.drawRect(sx - 10, sy - 10, 20, 20); // Markierungsrahmen
                }

                g2d.setColor(u.color);
                g2d.fillRect(sx - 5, sy - 5, 10, 10);

                // HP-Balken
                g2d.setColor(Color.RED);
                g2d.fillRect(sx - 15, sy - 18, 30, 4);
                g2d.setColor(Color.GREEN);
                int hpWidth = (int) (30 * (u.health / u.maxHealth));
                g2d.fillRect(sx - 15, sy - 18, Math.max(0, hpWidth), 4);

                g2d.setColor(Color.CYAN);
                g2d.setFont(new Font("Monospaced", Font.PLAIN, 10));
                g2d.drawString(u.id + " [Kills: " + u.kills + "]", sx + 12, sy - 4);
            }

            // HUD / Overlay
            g2d.setColor(Color.WHITE);
            g2d.setFont(new Font("Monospaced", Font.PLAIN, 12));
            g2d.drawString("Matrixgame Command Engine | Schritt: " + stepCount + " | Ausgewählt: " + (selectedUnit != null ? selectedUnit.id : "Keine"), 15, 25);
            g2d.drawString("Steuerung: Einheit anklicken, ins All klicken für Kursbefehl | 'Spawn'-Button für neue Einheiten", 15, 45);
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            new MatrixgameMasterpiece3D().setVisible(true);
        });
    }
