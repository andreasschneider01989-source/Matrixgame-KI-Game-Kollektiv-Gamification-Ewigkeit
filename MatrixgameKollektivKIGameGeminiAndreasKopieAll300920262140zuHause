                        }

                        if (other.health <= 0) {
                            other.isAlive = false;
                            System.out.printf(">>> [ELIMINIERT] Einheit %s wurde im Raumkampf zerstört!%n", other.id);
                        }
                    }
                }
            }
        }
    }

    // Grafisches Canvas mit Infinity Canvas Zoom- und Pan-Funktion
    private class SimulationCanvas extends JPanel {
        public SimulationCanvas() {
            setBackground(Color.BLACK);

            // Drag zum Verschieben (Pan)
            addMouseListener(new MouseAdapter() {
                @Override
                public void mousePressed(MouseEvent e) {
                    mousePrevX = e.getX();
                    mousePrevY = e.getY();
                }
            });

            addMouseMotionListener(new MouseMotionAdapter() {
                @Override
                public void mouseDragged(MouseEvent e) {
                    int dx = e.getX() - mousePrevX;
                    int dy = e.getY() - mousePrevY;
                    panX += dx;
                    panY += dy;
                    mousePrevX = e.getX();
                    mousePrevY = e.getY();
                    repaint();
                }
            });

            // Mausrad zum stufenlosen Zoomen
            addMouseWheelListener(e -> {
                if (e.getWheelRotation() < 0) {
                    scale *= 1.15;
                } else {
                    scale /= 1.15;
                }
                repaint();
            });
        }

