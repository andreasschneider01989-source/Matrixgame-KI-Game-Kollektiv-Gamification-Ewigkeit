package ordner6;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.ArrayList;
import java.util.List;

public class MatrixgameMasterpiece3D extends JFrame {

    private static final double G = 6.67430e-11; // Gravitationskonstante

    // 1. Himmelskörper
    public static class CelestialBody {
        public String name;
        public double x, y, z;
        public double vx, vy, vz;
        public double fx, fy, fz;
        public double mass;
        public Color color;

        public CelestialBody(String name, double x, double y, double z, double vx, double vy, double vz, double mass, Color color) {
            this.name = name;
            this.x = x; this.y = y; this.z = z;
            this.vx = vx; this.vy = vy; this.vz = vz;
            this.mass = mass;
            this.color = color;
        }

        public void resetForces() {
            this.fx = 0.0; this.fy = 0.0; this.fz = 0.0;
        }
    }

    // 2. Taktische Kampfeinheit & Sternenflotten-Kommandant
    public static class CombatUnit {
        public String id;
        public String commander;
        public double x, y, z;
        public double vx, vy, vz;
        public double mass;
        public double health;
        public double maxHealth;
        public double attackPower;
        public boolean isSelected;
        public boolean isAlive;
        public boolean isAllied; // True = Friedenspakt aktiv
        public int kills;
        public Color color;

        public CombatUnit(String id, String commander, double x, double y, double z, double vx, double vy, double vz, double mass, double health, double attackPower, Color color) {
            this.id = id;
            this.commander = commander;
            this.x = x; this.y = y; this.z = z;
            this.vx = vx; this.vy = vy; this.vz = vz;
            this.mass = mass;
            this.health = health;
            this.maxHealth = health;
            this.attackPower = attackPower;
            this.isSelected = false;
            this.isAlive = true;
            this.isAllied = false;
            this.kills = 0;
            this.color = color;
        }

        // Kinetische Energie E_kin = 0.5 * m * v^2
        public double getKineticEnergy() {
            double v2 = vx * vx + vy * vy + vz * vz;
            return 0.5 * mass * v2;
        }
    }

