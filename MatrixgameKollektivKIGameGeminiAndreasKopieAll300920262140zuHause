        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2d = (Graphics2D) g;
            g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            int width = getWidth();
            int height = getHeight();
            int cx = width / 2 + (int) panX;
            int cy = height / 2 + (int) panY;

            // Achsen / Infinity-Raster einzeichnen
            g2d.setColor(new Color(35, 35, 35));
            g2d.drawLine(0, cy, width, cy);
            g2d.drawLine(cx, 0, cx, height);

            // Himmelskörper rendern
            for (CelestialBody b : celestialBodies) {
                int sx = cx + (int) (b.x * scale);
                int sy = cy + (int) (b.y * scale);
                int radius = b.name.equals("Sonne") ? 22 : 8;

                g2d.setColor(b.color);
                g2d.fillOval(sx - radius / 2, sy - radius / 2, radius, radius);

                g2d.setColor(Color.WHITE);
                g2d.setFont(new Font("Monospaced", Font.BOLD, 12));
                g2d.drawString(b.name, sx + 12, sy + 4);
            }

            // Taktische Einheiten & Unit-Fight-HP-Balken rendern
            for (CombatUnit u : combatUnits) {
                if (!u.isAlive) continue;
                int sx = cx + (int) (u.x * scale);
                int sy = cy + (int) (u.y * scale);

                g2d.setColor(u.color);
                g2d.fillRect(sx - 5, sy - 5, 10, 10);

                // Lebenspunkt-Balken (HP) über der Einheit
                g2d.setColor(Color.RED);
                g2d.fillRect(sx - 15, sy - 15, 30, 4);
                g2d.setColor(Color.GREEN);
                int hpWidth = (int) (30 * (u.health / u.maxHealth));
                g2d.fillRect(sx - 15, sy - 15, Math.max(0, hpWidth), 4);

                g2d.setColor(Color.CYAN);
                g2d.setFont(new Font("Monospaced", Font.PLAIN, 10));
                g2d.drawString(u.id + " [" + (int)u.health + " HP]", sx + 12, sy - 2);
            }

            // HUD / Status-Overlay im Canvas
            g2d.setColor(Color.WHITE);
            g2d.setFont(new Font("Monospaced", Font.PLAIN, 12));
            g2d.drawString("Infinity Canvas | Zoom: " + String.format("%.2e", scale) + " | Schritt: " + stepCount, 15, 25);
            g2d.drawString("Bedienung: Mit gedrückter Maustaste verschieben (Pan) | Mausrad zoomen | Buttons unten", 15, 45);
        }
    }

