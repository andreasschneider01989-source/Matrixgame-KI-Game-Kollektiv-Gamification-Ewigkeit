public class MatrixgameLevel3 {

    // SIMULATIONS-PRESETS
    static long pauseTime = 5;             // Pause pro Zug in Millisekunden (z. B. 500 für Analyse oder 5 für Stresstest)
    static double logProbability = 0.005;  // 1.0 = 100% aller Moves anzeigen | 0.005 = 0.5% (für Massenschlachten)

    static List<Unit> einheiten = new ArrayList<>();
    static int tickCounter = 0;
    static boolean gameRunning = true;

    public static void main(String[] args) {
        init();
        gameLoop();
    }

    // Isoliertes Modul für Startbedingungen – Hier werden zukünftig Szenarien aufgebaut
    public static void init() {
        System.out.println("MATRIXGAME LEVEL 3 - Initialisierung...");

        // Team 0 (Nord)
        for (int i = 0; i < 150; i++) {
            einheiten.add(new Unit(i, 0, "Fighter", Math.random() * 100, Math.random() * 20, Math.random() * 100, 100, 15));
        }

        // Team 3 (Süd)
        for (int i = 150; i < 300; i++) {
            einheiten.add(new Unit(i, 3, "Interceptor", Math.random() * 100, 80 + Math.random() * 20, Math.random() * 100, 100, 15));
        }

        System.out.println(einheiten.size() + " Einheiten geladen.");
        System.out.println("Simulation startet mit logProbability: " + logProbability);
        System.out.println("--------------------------------------------------");
    }

    // Die zentrale Engine
    public static void gameLoop() {
        while (gameRunning && tickCounter < 5000) {
            tickCounter++;
            
            // Reduzierter Tick-Header für Übersichtlichkeit im Log
            if (tickCounter % 100 == 0) {
                System.out.println("=== TICK " + tickCounter + " ===");
            }

            int team0Count = 0;
            int team3Count = 0;

            // Jede Einheit führt ihren Zug aus
            for (Unit u : einheiten) {
                if (u.leben <= 0) continue;

                if (u.team == 0) team0Count++;
                if (u.team == 3) team3Count++;

                // Finde nächsten Gegner (Einfache Zielerfassungs-Heuristik)
                Unit target = null;
                double minDist = Double.MAX_VALUE;

                for (Unit enemy : einheiten) {
                    if (enemy.leben > 0 && enemy.team != u.team) {
                        double dx = enemy.posX - u.posX;
                        double dy = enemy.posY - u.posY;
                        double dz = enemy.posZ - u.posZ;
                        double dist = Math.sqrt(dx * dx + dy * dy + dz * dz);
                        
                        if (dist < minDist) {
                            minDist = dist;
                            target = enemy;
                        }
                    }
                }

                // Aktion ausführen basierend auf Distanz
                if (target != null) {
                    if (minDist <= 2.0) { // Angriffsreichweite
                        u.attackieren(target);
                    } else {
                        u.moveTo(target.posX, target.posY, target.posZ, 0.5); // Konstante Bewegungsgeschwindigkeit
                    }
                }
            }

            // Abbruchbedingung prüfen
            if (team0Count == 0 || team3Count == 0) {
                System.out.println("==================================================");
                System.out.println("SIMULATION BEENDET NACH " + tickCounter + " TICKS.");
                System.out.println("Überlebende Team 0: " + team0Count);
                System.out.println("Überlebende Team 3: " + team3Count);
                gameRunning = false;
            }

            // Thread pausieren, um die Simulation kontrolliert ablaufen zu lassen
            try {
                Thread.sleep(pauseTime);
            } catch (InterruptedException e) {
                e.printStackTrace();
            }
        }
    }
}

class Unit {
    double id;
    int team;
    String typ;
    double posX, posY, posZ;
    double leben;
    double schaden;

    public Unit(double id, int team, String typ, double posX, double posY, double posZ, double leben, double schaden) {
        this.id = id;
        this.team = team;
        this.typ = typ;
        this.posX = posX;
        this.posY = posY;
        this.posZ = posZ;
        this.leben = leben;
        this.schaden = schaden;
    }

    public void moveTo(double targetX, double targetY, double targetZ, double moveSpeed) {
        double oldX = posX;
        double oldY = posY;
        double oldZ = posZ;

        double dx = targetX - posX;
        double dy = targetY - posY;
        double dz = targetZ - posZ;
        double dist = Math.sqrt(dx * dx + dy * dy + dz * dz);

        if (dist > 0.0001) {
            // Vektor-Normalisierung und Bewegung
            posX += (dx / dist) * moveSpeed;
            posY += (dy / dist) * moveSpeed;
            posZ += (dz / dist) * moveSpeed;

            // Probabilistisches Logging
            if (Math.random() <= MatrixgameLevel3.logProbability) {
                System.out.println(String.format(Locale.US,
                    "MOVE   | Unit %.0f (Team %d) von (%.2f, %.2f, %.2f) -> (%.2f, %.2f, %.2f)",
                    this.id, this.team, oldX, oldY, oldZ, posX, posY, posZ));
            }
        }
    }

    public void attackieren(Unit enemy) {
        if (enemy != null && enemy.leben > 0) {
            // Schadensberechnung mit kritischem Multiplikator
            double kritischerMultiplikator = 1.0 + (Math.random() * 2.5);
            double tatsaechlicherSchaden = schaden * kritischerMultiplikator;
            enemy.leben -= tatsaechlicherSchaden;

            // Logik-Filter für die Konsolenausgabe
            if (Math.random() <= MatrixgameLevel3.logProbability || enemy.leben <= 0) {
                System.out.println(String.format(Locale.US,
                    "ATTACK | Unit %.0f greift Unit %.0f an! Schaden: %.2f (Rest-HP: %.2f)",
                    this.id, enemy.id, tatsaechlicherSchaden, enemy.leben));
            }

            // Statusüberprüfung und Zerstörung
            if (enemy.leben <= 0) {
                enemy.leben = 0;
                System.out.println("DESTROY| Unit " + enemy.id + " (" + enemy.typ + ") wurde vernichtet durch Unit " + this.id);
            }
        }
    }
}
