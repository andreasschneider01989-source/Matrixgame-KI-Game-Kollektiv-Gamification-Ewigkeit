package com.matrixgame.core;

/**
 * Rechnet Welt-Koordinaten in Bildschirm-Koordinaten um.
 * Ermoeglicht nahtlosen Infinity-Zoom ueber double-Variablen.
 */
public class ZoomTransform {

    private double cameraX = 0.0;
    private double cameraY = 0.0;
    private double globalZoomLevel = 1.0;

    public void zoomIn(double factor) {
        globalZoomLevel *= factor;
    }

    public void zoomOut(double factor) {
        globalZoomLevel /= factor;
    }

    public double toScreenX(double worldX, double screenWidth) {
        return (worldX - cameraX) * globalZoomLevel + (screenWidth / 2.0);
    }

    public double toScreenY(double worldY, double screenHeight) {
        return (worldY - cameraY) * globalZoomLevel + (screenHeight / 2.0);
    }

    public double toWorldX(double screenX, double screenWidth) {
        return (screenX - (screenWidth / 2.0)) / globalZoomLevel + cameraX;
    }

    public double toWorldY(double screenY, double screenHeight) {
        return (screenY - (screenHeight / 2.0)) / globalZoomLevel + cameraY;
    }

    // Getter und Setter für Kamera
    public void setCameraPosition(double x, double y) {
        this.cameraX = x;
        this.cameraY = y;
    }

    public double getGlobalZoomLevel() { return globalZoomLevel; }
}
