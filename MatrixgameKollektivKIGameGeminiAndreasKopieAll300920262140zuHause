package ordner5;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;

/**
 * Haupteinstiegspunkt und grafische Simulationsfenster fuer das Matrixgame.
 * Verknuepft PhysicsEngine, ZoomTransform und MatrixUnits zu einer interaktiven Simulation.
 */
public class MatrixgameSimMain extends JPanel implements ActionListener {

    private final PhysicsEngine engine;
    private final ZoomTransform zoom;
    private final Timer timer;
    
    private Point lastMousePt;
    private double camX = 0.0;
    private double camY = 0.0;

    public MatrixgameSimMain() {
        this.setBackground(new Color(15, 18, 28)); // Dunkler Weltall-Hintergrund
        
        engine = new PhysicsEngine();
        zoom = new ZoomTransform();

        // 1. Einheiten im Raum erzeugen (z. B. ein Gravitations-System)
        MatrixUnit zentrum = new MatrixUnit("Zentrum_Alpha", 0, 0, 5000.0);
        zentrum.setEnergyValue(100.0);

        MatrixUnit planet1 = new MatrixUnit("Unit_Beta", 200, 0, 50.0);
        // Startimpuls/Geschwindigkeit fuer einen Orbit geben
        planet1.addForce(0, 1500.0);

        MatrixUnit planet2 = new MatrixUnit("Unit_Gamma", -350, -100, 20.0);
        planet2.addForce(0, -800.0);

        // Zur PhysicsEngine hinzufuegen
        engine.addUnit(zentrum);
        engine.addUnit(planet1);
        engine.addUnit(planet2);

        // 2. Interaktion: Maus-Zoom & Kamera-Verschiebung
        MouseAdapter mouseHandler = new MouseAdapter() {
            @Override
            public void mousePressed(MouseEvent e) {
                lastMousePt = e.getPoint();
            }

            @Override
            public void mouseDragged(MouseEvent e) {
                if (lastMousePt != null) {
                    double dx = (e.getX() - lastMousePt.x) / zoom.getGlobalZoomLevel();
                    double dy = (e.getY() - lastMousePt.y) / zoom.getGlobalZoomLevel();
                    camX -= dx;
                    camY -= dy;
                    zoom.setCameraPosition(camX, camY);
                    lastMousePt = e.getPoint();
                    repaint();
                }
            }

            @Override
            public void mouseWheelMoved(MouseWheelEvent e) {
                if (e.getWheelRotation() < 0) {
                    zoom.zoomIn(1.15); // Hineinzoomen
                } else {
                    zoom.zoomOut(1.15); // Herauszoomen
                }
                repaint();
            }
        };

        this.addMouseListener(mouseHandler);
        this.addMouseMotionListener(mouseHandler);
        this.addMouseWheelListener(mouseHandler);

        // 3. Simulations-Schleife (~60 FPS -> alle 16 Millisekunden)
        timer = new Timer(16, this);
        timer.start();
    }

    @Override
    public void actionPerformed(ActionEvent e) {
        // Physikalischen Kausalitaetsschritt ausfuehren (dt = 0.016 Sek.)
        engine.step(0.016);
        repaint();
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2d = (Graphics2D) g;
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        int width = getWidth();
        int height = getHeight();

        // Achsenkreuz / Ursprung zeichnen
        g2d.setColor(new Color(40, 50, 70));
        int originX = (int) zoom.toScreenX(0, width);
        int originY = (int) zoom.toScreenY(0, height);
        g2d.drawLine(0, originY, width, originY);
        g2d.drawLine(originX, 0, originX, height);

        // Alle Units der PhysicsEngine zeichnen
        for (MatrixUnit unit : engine.getUnits()) {
            double screenX = zoom.toScreenX(unit.getPosX(), width);
            double screenY = zoom.toScreenY(unit.getPosY(), height);

            // Groesse basierend auf Masse und Zoom berechnen
            double radius = Math.max(4, Math.log(unit.getMass() + 1) * 3 * zoom.getGlobalZoomLevel());
            int drawX = (int) (screenX - radius);
            int drawY = (int) (screenY - radius);
            int size = (int) (radius * 2);

            // Aussehen je nach Unit-Typ
            if (unit.getMass() > 1000) {
                g2d.setColor(new Color(255, 200, 50)); // Hellgelbes Zentrum
            } else {
                g2d.setColor(new Color(80, 180, 255)); // Blau/Tuerkise Einheiten
            }

            g2d.fillOval(drawX, drawY, size, size);

            // Name und Koordinaten-Info anzeigen
            g2d.setColor(Color.WHITE);
            g2d.drawString(unit.getId(), (int) screenX + 10, (int) screenY - 5);
        }

        // HUD / Status-Overlay oben links
        g2d.setColor(new Color(200, 220, 255));
        g2d.drawString("Matrixgame - Basic Unit Simulation", 15, 25);
        g2d.drawString(String.format("Zoom-Level: %.2fx", zoom.getGlobalZoomLevel()), 15, 45);
        g2d.drawString("Steuerung: Mausrad = Zoom | Linksklick + Ziehen = Kamera bewegen", 15, 65);
    }

    // Main-Methode: Startet die Java-Anwendung
    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            JFrame frame = new JFrame("Matrixgame Simulation - Ordner 5");
            MatrixgameSimMain simPanel = new MatrixgameSimMain();
            
            frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
            frame.add(simPanel);
            frame.setSize(1000, 700);
            frame.setLocationRelativeTo(null);
            frame.setVisible(true);
        });
    }
}
