        SwingUtilities.invokeLater(() -> {
            JFrame f = new JFrame("Matrixgame – Agent Fight Simulator | Level 12+");
            f.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
            AgentFightSimulator panel = new AgentFightSimulator();
