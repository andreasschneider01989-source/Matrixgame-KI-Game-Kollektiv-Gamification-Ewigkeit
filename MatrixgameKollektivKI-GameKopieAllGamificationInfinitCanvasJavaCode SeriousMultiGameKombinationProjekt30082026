class InfinityCanvas extends JPanel {
    private SimulationEngine engine;
    private double offsetX = 0.0; // Welt-Koordinaten-Verschiebung
    private double offsetY = 0.0;
    private double scale = 40.0;   // Pixel pro Einheit (Zoom)
    
    private int dragStartX, dragStartY;
    private Unit selectedUnit = null;
    private Unit clipboardUnit = null;
    private String xAxisLabel = "X-Axis (Double)";
    private String yAxisLabel = "Y-Axis (Double)";

    public InfinityCanvas(SimulationEngine engine) {
        this.engine = engine;
        setBackground(new Color(20, 20, 30));

        addMouseListener(new MouseAdapter() {
            public void mousePressed(MouseEvent e) {
                dragStartX = e.getX();
                dragStartY = e.getY();
                
                // Welt-Koordinaten ermitteln
                double wx = screenToWorldX(e.getX());
                double wy = screenToWorldY(e.getY());
                int gx = (int) Math.floor(wx);
                int gy = (int) Math.floor(wy);

                if (e.getButton() == MouseEvent.BUTTON1) {
                    selectedUnit = engine.getUnitAt(gx, gy);
                    repaint();
                }
            }
        });

        addMouseMotionListener(new MouseMotionAdapter() {
            public void mouseDragged(MouseEvent e) {
                if ((e.getModifiersEx() & MouseEvent.BUTTON3_DOWN_MASK) != 0) {
                    // Pan / Verschieben mit rechter Maustaste
                    double dx = e.getX() - dragStartX;
                    double dy = e.getY() - dragStartY;
                    offsetX -= dx / scale;
                    offsetY -= dy / scale;
                    dragStartX = e.getX();
                    dragStartY = e.getY();
                    repaint();
                }
            }
        });

        addMouseWheelListener(e -> {
            double zoomFactor = 1.1;
            if (e.getWheelRotation() < 0) {
                scale *= zoomFactor;
            } else {
                scale /= zoomFactor;
            }
            repaint();
        });
    }

    public double screenToWorldX(int screenX) {
        return (screenX - getWidth() / 2.0) / scale + offsetX;
    }

    public double screenToWorldY(int screenY) {
        return (screenY - getHeight() / 2.0) / scale + offsetY;
    }

    public int worldToScreenX(double worldX) {
        return (int) ((worldX - offsetX) * scale + getWidth() / 2.0);
    }

    public int worldToScreenY(double worldY) {
        return (int) ((worldY - offsetY) * scale + getHeight() / 2.0);
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2d = (Graphics2D) g;
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        drawGridAndAxes(g2d);
        drawUnits(g2d);
    }

    private void drawGridAndAxes(Graphics2D g2d) {
        g2d.setColor(new Color(40, 40, 60));
        int stepPx = (int) scale;
        if (stepPx < 10) stepPx *= 5; // Dynamisches Grid-Lifting

        // Vertikale & Horizontale Linien für das Infinity Grid
        for (int x = 0; x < getWidth(); x += stepPx) {
            g2d.drawLine(x, 0, x, getHeight());
        }
        for (int y = 0; y < getHeight(); y += height()) { // korrigiert
            g2d.drawLine(0, y, getWidth(), y);
        }

        // Achsenbeschriftung dynamisch nach Double-Variablen
        g2d.setColor(Color.LIGHT_GRAY);
        g2d.drawString("Achsen: " + xAxisLabel + " / " + yAxisLabel, 20, 30);
        g2d.drawString(String.format("Zoom: %.2f | Offset: (%.2f, %.2f)", scale, offsetX, offsetY), 20, 50);
    }

    private void drawUnits(Graphics2D g2d) {
        // Durchsuche sichtbaren Bereich und zeichne Einheiten
        for (int gx = -20; gx < 70; gx++) {
            for (int gy = -20; gy < 70; gy++) {
                Unit u = engine.getUnitAt(gx, gy);
                if (u != null) {
                    int sx = worldToScreenX(u.worldX);
                    int sy = worldToScreenY(u.worldY);
                    
                    if (u.type == UnitType.PLAYER) g2d.setColor(Color.BLUE);
                    else if (u.type == UnitType.BOULDER) g2d.setColor(Color.GRAY);
                    else if (u.type == UnitType.DIAMOND) g2d.setColor(Color.CYAN);
                    else g2d.setColor(Color.WHITE);

                    g2d.fillOval(sx - (int)(scale/4), sy - (int)(scale/4), (int)(scale/2), (int)(scale/2));
                    g2d.setColor(Color.YELLOW);
                    g2d.drawString(u.name, sx, sy - 10);
                }
            }
        }
    }

    public Unit getSelectedUnit() { return selectedUnit; }
    public void setClipboardUnit(Unit u) { this.clipboardUnit = u; }
    public Unit getClipboardUnit() { return clipboardUnit; }
}

