    private void movePlayerWithPhysics(double dx, double dy) {

        double nextX = player.x + dx;

        double nextY = player.y + dy;


        for (Entity e : entities) {

            if (e.active) {

                if (e.type == EntityType.WALL || (e.type == EntityType.LASER_BARRIER && shieldTicksRemaining <= 0)) {

                    if (checkRectCircleCollision(e, nextX, nextY, player.radius)) {

                        return;

                    }

                }

            }

        }


        // Boulder-Physik

        for (Entity e : entities) {

            if (e.type == EntityType.BOULDER && e.active) {

                double dist = Math.sqrt(Math.pow(nextX - e.x, 2) + Math.pow(nextY - e.y, 2));

                if (dist < (player.radius + e.radius)) {

                    double targetBX = e.x + dx * 0.8;

                    double targetBY = e.y + dy * 0.8;


                    boolean blocked = false;

                    for (Entity wall : entities) {

                        if (wall.type == EntityType.WALL && wall.active) {

                            if (checkRectCircleCollision(wall, targetBX, targetBY, e.radius)) {

                                blocked = true;

                                break;

                            }

                        }

                    }


                    if (!blocked) {

                        e.x = targetBX;

                        e.y = targetBY;

                    } else if (shieldTicksRemaining <= 0) {

                        return;

                    }

                }

            }

        }


        player.x = nextX;

        player.y = nextY;

    }


    private boolean checkRectCircleCollision(Entity rect, double cx, double cy, double cradius) {

        double halfW = rect.width / 2.0;

        double halfH = rect.height / 2.0;


        double closestX = Math.max(rect.x - halfW, Math.min(cx, rect.x + halfW));

        double closestY = Math.max(rect.y - halfH, Math.min(cy, rect.y + halfH));


        double distanceX = cx - closestX;

        double distanceY = cy - closestY;


        return (distanceX * distanceX + distanceY * distanceY) < (cradius * cradius);

    }


