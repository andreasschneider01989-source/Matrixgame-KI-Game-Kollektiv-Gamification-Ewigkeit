import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.List;

public class MatrixGameEngine {

    public enum EntityType {
        PLAYER, ENEMY_SKRALL, GATE, BOULDER, BOULDER_FRAGILE, BOMB, STONE_BLACK, STONE_WHITE
    }

    public static class Entity {
        String name;
        EntityType type;
        double x, y;

        public Entity(String name, EntityType type, double x, double y) {
            this.name = name;
            this.type = type;
            this.x = x;
            this.y = y;
        }
    }

    private String gameId;
    private int iteration;
    private String gameStateStatus; // WON, LOST, ACTIVE
    private int coins, maxCoins;
    private List<Entity> entities;
    private char[][] board; // 2D Grid für Go-Logik oder Labyrinth
    private int boardSizeX, boardSizeY;
    private double komi;

    public MatrixGameEngine(String gameId, int boardSizeX, int boardSizeY) {
        this.gameId = gameId;
        this.iteration = 0;
        this.gameStateStatus = "ACTIVE";
        this.coins = 0;
        this.maxCoins = 5;
        this.entities = new ArrayList<>();
        this.boardSizeX = boardSizeX;
        this.boardSizeY = boardSizeY;
        this.board = new char[boardSizeY][boardSizeX];
        this.komi = 5.5;
        initializeBoard();
    }

    private void initializeBoard() {
        for (int y = 0; y < boardSizeY; y++) {
            for (int x = 0; x < boardSizeX; x++) {
                board[y][x] = '-';
            }
        }
    }

    public void addEntity(Entity e) {
        entities.add(e);
    }

    public void applyGravityForce(Entity target, double sourceX, double sourceY, double mass, boolean is3D) {
        double dx = sourceX - target.x;
        double dy = sourceY - target.y;
        double r = Math.sqrt(dx * dx + dy * dy);
        
        if (r == 0) return; // Singularität vermeiden

        double force;
        if (is3D) {
            force = mass / (r * r); // n-Quadrat-Gesetz für 3D
        } else {
            force = mass / r; // Proportional zum Abstand für 2D
        }
        
        // Logik für Vektorverschiebung hier anwenden...
    }

    public void triggerExplosion(double originX, double originY, double radius) {
        entities.removeIf(e -> {
            double r = Math.sqrt(Math.pow(e.x - originX, 2) + Math.pow(e.y - originY, 2));
            return r <= radius && e.type != EntityType.GATE; 
        });
        // Zerstörbare Wände im Grid freigeben
    }

    // Minimax Evaluierungsfunktion für KI-Entscheidungen (Basis: Go-Gebietskontrolle)
    public double evaluateState(char playerColor, char enemyColor) {
        double myScore = calculateTerritoryScore(playerColor);
        double enemyScore = calculateTerritoryScore(enemyColor);
        if (enemyColor == 'w') enemyScore += komi;
        if (playerColor == 'w') myScore += komi;
        
        return myScore - enemyScore;
    }

    private double calculateTerritoryScore(char color) {
        int score = 0;
        // Durchsuche das Grid nach Steinen und umschlossenen Gebieten
        for (int y = 0; y < boardSizeY; y++) {
            for (int x = 0; x < boardSizeX; x++) {
                if (board[y][x] == color) {
                    score++;
                }
                // Hier folgt der Algorithmus zur Flutung (Flood-Fill) leerer Felder
                // um zu prüfen, ob sie ausschließlich von 'color' umschlossen sind.
            }
        }
        return score;
    }

    public String exportGameState() {
        DateTimeFormatter dtf = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
        LocalDateTime now = LocalDateTime.now();
        
        StringBuilder sb = new StringBuilder();
        sb.append("--- MATRIXGAME STATE EXPORT (Iteration ").append(iteration).append(") ---\n");
        sb.append("GameID: ").append(gameId).append("\n");
        sb.append("Timestamp: [").append(dtf.format(now)).append("]\n");
        sb.append("GameState: ").append(gameStateStatus).append("\n");
        sb.append("Coins: ").append(coins).append(" / ").append(maxCoins).append("\n");
        
        for (Entity e : entities) {
            sb.append(String.format("Entity: %-15s | Type: %-15s | X: %7.2f | Y: %7.2f\n", 
                      e.name, e.type, e.x, e.y));
        }
        sb.append("---------------------------------------------------\n");
        return sb.toString();
    }

    public static void main(String[] args) {
        MatrixGameEngine engine = new MatrixGameEngine("MG-GO-TEST-002", 5, 5);
        engine.addEntity(new Entity("Player", EntityType.PLAYER, -9.90, 10.96));
        engine.addEntity(new Entity("Skrall_Hunter", EntityType.ENEMY_SKRALL, -5.84, -0.14));
        engine.addEntity(new Entity("Exit_Gate", EntityType.GATE, -10.00, 10.00));
        engine.addEntity(new Entity("Entropie_Bombe", EntityType.BOMB, 0.0, 0.0));
        
        engine.iteration = 831;
        System.out.println(engine.exportGameState());
    }
