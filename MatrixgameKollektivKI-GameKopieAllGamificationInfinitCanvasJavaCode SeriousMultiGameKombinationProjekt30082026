        entities.add(new Entity("Entropie_Bombe", EntityType.BOMB, 12, 12, Color.ORANGE));
    }

    // --- FLOOD FILL LOGIK (Alpha-Zero Evaluierung) ---
    public int calculateTerritoryScore(char playerColor) {
        int score = 0;
        boolean[][] visited = new boolean[boardSizeY][boardSizeX];

        for (int y = 0; y < boardSizeY; y++) {
            for (int x = 0; x < boardSizeX; x++) {
                if (board[y][x] == '-' && !visited[y][x]) {
                    if (isEnclosedBy(x, y, playerColor, visited)) {
                        score += countAndMarkRegion(x, y, visited);
                    }
                }
                if (board[y][x] == playerColor) {
                    score++; // Eigene Steine zählen mit
                }
            }
        }
        return score;
    }

    private boolean isEnclosedBy(int startX, int startY, char color, boolean[][] globalVisited) {
        boolean[][] localVisited = new boolean[boardSizeY][boardSizeX];
        List<Point> queue = new ArrayList<>();
        queue.add(new Point(startX, startY));
        localVisited[startY][startX] = true;
        
        boolean isEnclosed = true;

        int head = 0;
        while (head < queue.size()) {
            Point p = queue.get(head++);
            int x = p.x;
            int y = p.y;
            
            // Wenn der Rand erreicht wird, ist das Gebiet offen
            if (x == 0 || x == boardSizeX - 1 || y == 0 || y == boardSizeY - 1) {
                isEnclosed = false; 
            }

            // Nachbarn prüfen
            int[][] dirs = {{-1,0}, {1,0}, {0,-1}, {0,1}};
            for (int[] d : dirs) {
                int nx = x + d[0];
                int ny = y + d[1];
                
                if (nx >= 0 && nx < boardSizeX && ny >= 0 && ny < boardSizeY) {
                    if (board[ny][nx] == '-' && !localVisited[ny][nx]) {
                        localVisited[ny][nx] = true;
                        queue.add(new Point(nx, ny));
                    } else if (board[ny][nx] != '-' && board[ny][nx] != color) {
                        isEnclosed = false; // Fremder Stein begrenzt das Gebiet
                    }
                }
            }
        }
        return isEnclosed;
    }

    private int countAndMarkRegion(int startX, int startY, boolean[][] globalVisited) {
        int count = 0;
        List<Point> queue = new ArrayList<>();
        queue.add(new Point(startX, startY));
        globalVisited[startY][startX] = true;
        
        int head = 0;
        while (head < queue.size()) {
            Point p = queue.get(head++);
            count++;
            int x = p.x; int y = p.y;
            
            int[][] dirs = {{-1,0}, {1,0}, {0,-1}, {0,1}};
            for (int[] d : dirs) {
                int nx = x + d[0];
                int ny = y + d[1];
                if (nx >= 0 && nx < boardSizeX && ny >= 0 && ny < boardSizeY) {
                    if (board[ny][nx] == '-' && !globalVisited[ny][nx]) {
                        globalVisited[ny][nx] = true;
                        queue.add(new Point(nx, ny));
                    }
                }
            }
        }
        return count;
    }

    public String exportGameState() {
        DateTimeFormatter dtf = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
        StringBuilder sb = new StringBuilder();
        sb.append("\n--- MATRIXGAME STATE EXPORT (Iteration ").append(iteration).append(") ---\n");
        sb.append("Timestamp: [").append(dtf.format(LocalDateTime.now())).append("]\n");
        for (Entity e : entities) {
            sb.append(String.format("Entity: %-15s | Type: %-15s | X: %3d | Y: %3d\n", 
                      e.name, e.type, e.gridX, e.gridY));
        }
        sb.append("---------------------------------------------------\n");
        return sb.toString();
    }

    // --- RENDER ENGINE ---
    private class GameCanvas extends JPanel {
        public GameCanvas() {
            setBackground(Color.DARK_GRAY);
        }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2d = (Graphics2D) g;
            
            // Antialiasing für flüssige Optik
            g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            // Kamera-Verschiebung (Infinity Canvas Effekt)
            g2d.translate(cameraX, cameraY);

            // 1. Grid & Statische Go-Steine zeichnen
            for (int y = 0; y < boardSizeY; y++) {
                for (int x = 0; x < boardSizeX; x++) {
                    int px = x * tileSize;
                    int py = y * tileSize;
                    
                    g2d.setColor(Color.GRAY);
                    g2d.drawRect(px, py, tileSize, tileSize);
                    
                    if (board[y][x] == 'b') {
                        g2d.setColor(Color.BLACK);
                        g2d.fillOval(px + 2, py + 2, tileSize - 4, tileSize - 4);
                    } else if (board[y][x] == 'w') {
                        g2d.setColor(Color.WHITE);
                        g2d.fillOval(px + 2, py + 2, tileSize - 4, tileSize - 4);
                    }
                }
            }

            // 2. Dynamische Entitäten zeichnen
            for (Entity e : entities) {
                int px = e.gridX * tileSize;
                int py = e.gridY * tileSize;
                
                g2d.setColor(e.color);
                if (e.type == EntityType.PLAYER) {
                    g2d.fillRoundRect(px + 4, py + 4, tileSize - 8, tileSize - 8, 10, 10);
                } else {
                    g2d.fillOval(px + 5, py + 5, tileSize - 10, tileSize - 10);
                }
                
                g2d.setColor(Color.WHITE);
                g2d.setFont(new Font("Consolas", Font.BOLD, 10));
                g2d.drawString(e.name, px, py - 2);
            }
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            MatrixGame game = new MatrixGame();
            game.setVisible(true);
        });
    }
