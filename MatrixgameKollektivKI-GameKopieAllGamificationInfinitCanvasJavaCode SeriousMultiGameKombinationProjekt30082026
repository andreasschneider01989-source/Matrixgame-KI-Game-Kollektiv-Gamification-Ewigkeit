<body>
    <div id="ui">
        <div><strong>--- MATRIXGAME LEVEL 7 ENGINE ---</strong></div>
        <div id="stats">XP: 0 | Coins: 0/15 | Nodes: 0/5 | Cells: 0/4</div>
        <div id="squad">Squad HP: 100% | Alive Units: 2</div>
        <div id="msg" class="status-warn">Auftrag: Sammle alle Ressourcen und erreiche das Ziel-Tor!</div>
    </div>
    <canvas id="canvas"></canvas>

<script>
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');

function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
}
window.addEventListener('resize', resize);
resize();

// --- INFINITY CANVAS CAMERA SYSTEM ---
const camera = { x: 0, y: 0, zoom: 20, isDragging: false, startX: 0, startY: 0 };
const keys = {};

window.addEventListener('keydown', e => keys[e.key.toLowerCase()] = true);
window.addEventListener('keyup', e => keys[e.key.toLowerCase()] = false);

canvas.addEventListener('mousedown', e => {
    if (e.button === 1 || e.button === 2) { // Middle or Right click to pan
        camera.isDragging = true;
        camera.startX = e.clientX - camera.x;
        camera.startY = e.clientY - camera.y;
    } else if (e.button === 0) { // Left click: Target command
        const worldPos = screenToWorld(e.clientX, e.clientY);
        gameState.entities.filter(e => e.team === 'PLAYER' && e.hp > 0).forEach(u => {
            u.targetX = worldPos.x;
            u.targetY = worldPos.y;
        });
    }
});

canvas.addEventListener('mousemove', e => {
    if (camera.isDragging) {
        camera.x = e.clientX - camera.startX;
        camera.y = e.clientY - camera.startY;
    }
});

canvas.addEventListener('mouseup', () => camera.isDragging = false);
canvas.addEventListener('contextmenu', e => e.preventDefault());
canvas.addEventListener('wheel', e => {
    const zoomFactor = e.deltaY < 0 ? 1.1 : 0.9;
    camera.zoom = Math.max(5, Math.min(50, camera.zoom * zoomFactor));
});

function worldToScreen(wx, wy) {
    return {
        x: canvas.width / 2 + (wx * camera.zoom) + camera.x,
        y: canvas.height / 2 + (wy * camera.zoom) + camera.y
    };
}

function screenToWorld(sx, sy) {
    return {
        x: (sx - canvas.width / 2 - camera.x) / camera.zoom,
        y: (sy - canvas.height / 2 - camera.y) / camera.zoom
    };
}

// --- BASE ENTITY CLASS WITH METHOD & VARIABLE SYSTEM ---
class GameObject {
    constructor(id, type, x, y, team = 'NEUTRAL', radius = 0.6) {
        this.id = id;
        this.type = type;
        this.x = x;
        this.y = y;
        this.vx = 0;
        this.vy = 0;
        this.team = team;
        this.radius = radius;
        this.hp = 100;
        this.maxHp = 100;
        this.attackRange = 1.2;
        this.damage = 15;
        this.targetX = x;
        this.targetY = y;
        this.active = true;
    }

    update(dt) {
        if (this.hp <= 0 && this.team !== 'STATIC') {
            this.active = false;
            return;
        }

        // Physical movement step: x(t + dt) = x(t) + v(t)*dt
        this.x += this.vx * dt;
        this.y += this.vy * dt;
        this.vx *= 0.85; // Drag friction
        this.vy *= 0.85;
    }

    takeDamage(amount) {
        this.hp = Math.max(0, this.hp - amount);
    }

    draw(ctx) {
        const p = worldToScreen(this.x, this.y);
        const r = this.radius * camera.zoom;

        ctx.beginPath();
        ctx.arc(p.x, p.y, r, 0, Math.PI * 2);

        if (this.team === 'PLAYER') ctx.fillStyle = '#00ffcc';
        else if (this.team === 'ENEMY') ctx.fillStyle = '#ff3366';
        else ctx.fillStyle = '#ffcc00';

        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.stroke();

        // Draw Health Bar for active units
        if (this.maxHp > 0 && this.team !== 'STATIC' && this.type !== 'COIN') {
            const barW = r * 2;
            const barH = 4;
            ctx.fillStyle = '#ff0000';
            ctx.fillRect(p.x - r, p.y - r - 8, barW, barH);
            ctx.fillStyle = '#00ff00';
            ctx.fillRect(p.x - r, p.y - r - 8, barW * (this.hp / this.maxHp), barH);
        }
    }
}

// --- UNIT CLASSES ---
class Unit extends GameObject {
    constructor(id, type, x, y, team, speed, attackRange, damage) {
        super(id, type, x, y, team, 0.7);
        this.speed = speed;
        this.attackRange = attackRange;
        this.damage = damage;
    }

    update(dt) {
        super.update(dt);
        if (this.hp <= 0) return;

        // Player Movement Logic
        if (this.team === 'PLAYER') {
            let dx = 0, dy = 0;
            if (keys['w'] || keys['arrowup']) dy -= 1;
            if (keys['s'] || keys['arrowdown']) dy += 1;
            if (keys['a'] || keys['arrowleft']) dx -= 1;
            if (keys['d'] || keys['arrowright']) dx += 1;

            if (dx !== 0 || dy !== 0) {
                const len = Math.hypot(dx, dy);
                this.vx = (dx / len) * this.speed;
                this.vy = (dy / len) * this.speed;
                this.targetX = this.x;
                this.targetY = this.y;
            } else if (Math.hypot(this.targetX - this.x, this.targetY - this.y) > 0.2) {
                const angle = Math.atan2(this.targetY - this.y, this.targetX - this.x);
                this.vx = Math.cos(angle) * this.speed;
                this.vy = Math.sin(angle) * this.speed;
            }
        }

        // Enemy AI Hunt Logic
        if (this.team === 'ENEMY') {
            const targets = gameState.entities.filter(e => e.team === 'PLAYER' && e.hp > 0);
            if (targets.length > 0) {
                let nearest = targets[0];
                let minDist = Math.hypot(nearest.x - this.x, nearest.y - this.y);
                for (let t of targets) {
                    let d = Math.hypot(t.x - this.x, t.y - this.y);
                    if (d < minDist) { minDist = d; nearest = t; }
                }

                if (minDist <= this.attackRange) {
                    nearest.takeDamage(this.damage * dt); // Attack player unit
                } else if (minDist < 15.0) {
                    const angle = Math.atan2(nearest.y - this.y, nearest.x - this.x);
                    this.vx = Math.cos(angle) * this.speed;
                    this.vy = Math.sin(angle) * this.speed;
                }
            }
        }
    }
}

// --- GAME STATE MANAGEMENT ---
const gameState = {
    xp: 0,
