    <title>Matrixgame - Level 7 Engine</title>
    <style>
        body { margin: 0; overflow: hidden; background: #0a0a10; font-family: monospace; color: #00ffcc; }
        canvas { display: block; cursor: crosshair; }
        #ui { position: absolute; top: 10px; left: 10px; background: rgba(10, 10, 20, 0.85); padding: 12px; border: 1px solid #00ffcc; border-radius: 4px; pointer-events: none; }
