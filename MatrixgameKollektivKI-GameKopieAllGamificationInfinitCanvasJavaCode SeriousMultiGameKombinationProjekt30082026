// 2. INFINITY CANVAS & DRAG & DROP HANDLER
// ==========================================
class InfinityCanvas extends JPanel {
    private SimulationEngine engine;
    private double offsetX = 0.0;
    private double offsetY = 0.0;
    private double scale = 45.0;   
    
    private int dragStartX, dragStartY;
    private Unit selectedUnit = null;
    private Unit draggedUnit = null; // Für echtes Drag & Drop mit der Maus
    private Unit clipboardUnit = null;

    public InfinityCanvas(SimulationEngine engine) {
        this.engine = engine;
        setBackground(new Color(15, 15, 25));
        setFocusable(true);

        addMouseListener(new MouseAdapter() {
            public void mousePressed(MouseEvent e) {
                requestFocusInWindow();
                dragStartX = e.getX();
                dragStartY = e.getY();
                
                double wx = screenToWorldX(e.getX());
                double wy = screenToWorldY(e.getY());

                if (e.getButton() == MouseEvent.BUTTON1) {
                    // Prüfen, ob eine Einheit angeklickt wurde (für Selektion & Drag)
                    selectedUnit = null;
                    draggedUnit = null;
                    for (Unit u : engine.getAllUnits()) {
                        if (Math.hypot(u.worldX - wx, u.worldY - wy) < 0.8) {
                            selectedUnit = u;
                            draggedUnit = u; // Bereit zum Ziehen per Drag & Drop
                            break;
                        }
                    }
                    repaint();
                } else if (e.getButton() == MouseEvent.BUTTON3) {
                    // Rechtsklick: Selektierte Einheit direkt zum Zielpunkt beamen
                    if (selectedUnit != null) {
                        selectedUnit.worldX = wx;
                        selectedUnit.worldY = wy;
                        repaint();
                    }
                }
            }

            public void mouseReleased(MouseEvent e) {
                draggedUnit = null; // Drag & Drop beenden
            }
        });

        addMouseMotionListener(new MouseMotionAdapter() {
            public void mouseDragged(MouseEvent e) {
                double wx = screenToWorldX(e.getX());
                double wy = screenToWorldY(e.getY());

                if (draggedUnit != null) {
                    // Echtes Drag & Drop von Einheiten im Infinity Canvas!
                    draggedUnit.worldX = wx;
                    draggedUnit.worldY = wy;
                    repaint();
                } else {
                    // Canvas Panning mit der Maus (wenn keine Einheit gegriffen wird)
                    double dx = e.getX() - dragStartX;
                    double dy = e.getY() - dragStartY;
                    offsetX -= dx / scale;
                    offsetY -= dy / scale;
                    dragStartX = e.getX();
                    dragStartY = e.getY();
                    repaint();
                }
            }
        });

        addMouseWheelListener(e -> {
            double zoomFactor = 1.15;
            if (e.getWheelRotation() < 0) scale *= zoomFactor;
            else scale /= zoomFactor;
            repaint();
        });

        // Tastatursteuerung (WASD / Pfeiltasten) für den Spieler
        addKeyListener(new KeyAdapter() {
            public void keyPressed(KeyEvent e) {
                Unit player = engine.getPlayer();
                if (player == null) return;
                double moveSpeed = 0.4;
                
                switch (e.getKeyCode()) {
                    case KeyEvent.VK_W:
                    case KeyEvent.VK_UP: player.worldY -= moveSpeed; break;
                    case KeyEvent.VK_S:
                    case KeyEvent.VK_DOWN: player.worldY += moveSpeed; break;
                    case KeyEvent.VK_A:
                    case KeyEvent.VK_LEFT: player.worldX -= moveSpeed; break;
                    case KeyEvent.VK_D:
                    case KeyEvent.VK_RIGHT: player.worldX += moveSpeed; break;
                }
                repaint();
            }
        });
    }

    public double screenToWorldX(int sx) { return (sx - getWidth() / 2.0) / scale + offsetX; }
    public double screenToWorldY(int sy) { return (sy - getHeight() / 2.0) / scale + offsetY; }
    public int worldToScreenX(double wx) { return (int) ((wx - offsetX) * scale + getWidth() / 2.0); }
    public int worldToScreenY(double wy) { return (int) ((wy - offsetY) * scale + getHeight() / 2.0); }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2d = (Graphics2D) g;
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        drawInfinityGrid(g2d);
        drawUnits(g2d);
        drawHUD(g2d);
    }

    private void drawInfinityGrid(Graphics2D g2d) {
        g2d.setColor(new Color(30, 30, 45));
        int stepPx = (int) scale;
        if (stepPx < 15) stepPx *= 4;
        int w = getWidth(), h = getHeight();

        for (int x = w / 2 - (int)(offsetX * scale) % stepPx; x < w; x += stepPx) g2d.drawLine(x, 0, x, h);
        for (int x = w / 2 - (int)(offsetX * scale) % stepPx; x > 0; x -= stepPx) g2d.drawLine(x, 0, x, h);
        for (int y = h / 2 - (int)(offsetY * scale) % stepPx; y < h; y += stepPx) g2d.drawLine(0, y, w, y);
        for (int y = h / 2 - (int)(offsetY * scale) % stepPx; y > 0; y -= stepPx) g2d.drawLine(0, y, w, y);
    }

    private void drawUnits(Graphics2D g2d) {
        for (Unit u : engine.getAllUnits()) {
            int sx = worldToScreenX(u.worldX);
            int sy = worldToScreenY(u.worldY);
            int radius = (int)(scale * 0.45);

            if (u.type == UnitType.PLAYER) g2d.setColor(new Color(50, 160, 255));
            else if (u.type == UnitType.ENEMY_SKRALL) g2d.setColor(new Color(255, 60, 60)); // Skrall-Gegner
            else if (u.type == UnitType.DIAMOND) g2d.setColor(new Color(0, 255, 220)); // Münzen
            else if (u.type == UnitType.GATE) g2d.setColor(new Color(255, 215, 0)); // Ziel-Tor
            else if (u.type == UnitType.BOULDER) g2d.setColor(new Color(130, 130, 140));
            else if (u.type == UnitType.WALL) g2d.setColor(new Color(80, 80, 100));

            if (u.type == UnitType.GATE) {
                g2d.fillRect(sx - radius/2, sy - radius/2, radius, radius);
            } else {
                g2d.fillOval(sx - radius/2, sy - radius/2, radius, radius);
            }

            if (u == selectedUnit) {
                g2d.setColor(Color.YELLOW);
                g2d.setStroke(new BasicStroke(2.0f));
                g2d.drawRect(sx - radius/2 - 5, sy - radius/2 - 5, radius + 10, radius + 10);
            }

            g2d.setColor(Color.LIGHT_GRAY);
            g2d.setFont(new Font("SansSerif", Font.PLAIN, 11));
            g2d.drawString(u.name, sx + radius/2 + 4, sy + 4);
        }
    }

    private void drawHUD(Graphics2D g2d) {
        g2d.setColor(Color.WHITE);
        g2d.setFont(new Font("SansSerif", Font.BOLD, 14));
        g2d.drawString("Münzen gesammelt: " + engine.getCollectedCoins() + " / " + engine.getTotalCoins(), 20, 30);
        g2d.drawString("Steuerung: [WASD / Pfeiltasten] Bewegen | [Maus Drag & Drop] Einheiten ziehen | [Rechtsklick] Beamen", 20, 55);

        GameState state = engine.getGameState();
        if (state == GameState.WON) {
            g2d.setColor(new Color(0, 255, 100, 220));
            g2d.fillRect(getWidth() / 2 - 200, getHeight() / 2 - 50, 400, 100);
            g2d.setColor(Color.BLACK);
            g2d.setFont(new Font("SansSerif", Font.BOLD, 24));
            g2d.drawString("SIEG! Tor erreicht!", getWidth() / 2 - 110, getHeight() / 2 + 8);
        } else if (state == GameState.GAME_OVER) {
            g2d.setColor(new Color(255, 50, 50, 220));
            g2d.fillRect(getWidth() / 2 - 200, getHeight() / 2 - 50, 400, 100);
            g2d.setColor(Color.WHITE);
            g2d.setFont(new Font("SansSerif", Font.BOLD, 24));
            g2d.drawString("GAME OVER! Skrall hat dich!", getWidth() / 2 - 150, getHeight() / 2 + 8);
        }
    }

    public Unit getSelectedUnit() { return selectedUnit; }
    public void setClipboardUnit(Unit u) { this.clipboardUnit = u; }
    public Unit getClipboardUnit() { return clipboardUnit; }
}

