    private void initializeLogic() {
        board = new char[boardSizeY][boardSizeX];
        for (int y = 0; y < boardSizeY; y++) {
            for (int x = 0; x < boardSizeX; x++) {
                board[y][x] = '-'; // Leeres Feld
            }
        }
        
        // Setze eine Test-Wand für die Flood-Fill Logik (Go-Steine Schwarz)
        board[5][5] = 'b'; board[5][6] = 'b'; board[5][7] = 'b';
        board[6][5] = 'b';                    board[6][7] = 'b';
