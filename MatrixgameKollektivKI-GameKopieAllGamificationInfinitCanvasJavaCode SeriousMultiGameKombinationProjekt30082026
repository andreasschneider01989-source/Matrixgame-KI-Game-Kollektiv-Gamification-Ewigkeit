class GameObjekt7 {
    String id, type, team;
    double x, y, vx = 0, vy = 0;
    double radius;
    double hp = 100, maxHp = 100;
    double speed, attackRange, damage;
    double targetX, targetY;
    boolean active = true;

    public GameObjekt7(String id, String type, double x, double y, String team, double radius, double speed, double attackRange, double damage) {
        this.id = id;
        this.type = type;
        this.x = x;
        this.y = y;
        this.team = team;
        this.radius = radius;
        this.speed = speed;
        this.attackRange = attackRange;
        this.damage = damage;
        this.targetX = x;
        this.targetY = y;
    }

    public void update(double dt, List<GameObjekt7> allEntities) {
        if (hp <= 0 && !team.equals("STATIC") && !type.equals("COIN")) {
            active = false;
            return;
        }

        // Spieler-Logik: Bewegen zum Zielpunkt
        if (team.equals("PLAYER")) {
            double dx = targetX - x;
            double dy = targetY - y;
            double dist = Math.hypot(dx, dy);
            if (dist > 0.2) {
                vx += (dx / dist) * speed * dt;
                vy += (dy / dist) * speed * dt;
            }
        }

        // Gegner-Logik: Jagd auf Spieler
        if (team.equals("ENEMY")) {
            GameObjekt7 nearestPlayer = null;
            double minDist = Double.MAX_VALUE;
            for (GameObjekt7 e : allEntities) {
                if (e.team.equals("PLAYER") && e.active) {
                    double d = Math.hypot(e.x - x, e.y - y);
                    if (d < minDist) {
                        minDist = d;
                        nearestPlayer = e;
                    }
                }
            }

            if (nearestPlayer != null) {
                if (minDist <= attackRange) {
                    nearestPlayer.hp -= damage * dt;
                } else if (minDist < 15.0) {
                    double angle = Math.atan2(nearestPlayer.y - y, nearestPlayer.x - x);
                    vx += Math.cos(angle) * speed * dt;
                    vy += Math.sin(angle) * speed * dt;
                }
            }
        }

        // Physikalische Translation (Euler-Integration)
        x += vx * dt;
        y += vy * dt;
        vx *= 0.85; // Reibung
        vy *= 0.85;
    }

    public void draw(Graphics2D g2d, Camera cam, int screenW, int screenH) {
        int px = (int) (screenW / 2 + (x * cam.zoom) + cam.x);
        int py = (int) (screenH / 2 + (y * cam.zoom) + cam.y);
        int r = (int) (radius * cam.zoom);

        if (team.equals("PLAYER")) g2d.setColor(new Color(0, 255, 204));
        else if (team.equals("ENEMY")) g2d.setColor(new Color(255, 51, 102));
        else if (type.equals("COIN")) g2d.setColor(new Color(255, 215, 0));
        else g2d.setColor(new Color(150, 150, 255)); // STATIC / NEUTRAL

        g2d.fillOval(px - r, py - r, r * 2, r * 2);
        g2d.setColor(Color.WHITE);
        g2d.drawOval(px - r, py - r, r * 2, r * 2);

        // HP Balken rendern
        if (maxHp > 0 && !team.equals("STATIC") && !type.equals("COIN")) {
            int barW = r * 2;
            int barH = 4;
            g2d.setColor(Color.RED);
            g2d.fillRect(px - r, py - r - 8, barW, barH);
            g2d.setColor(Color.GREEN);
            g2d.fillRect(px - r, py - r - 8, (int) (barW * (hp / maxHp)), barH);
        }
    }
}

