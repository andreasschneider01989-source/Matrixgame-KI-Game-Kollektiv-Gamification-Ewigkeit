// --- MAIN GAME ENGINE & DYNAMISCHE LEVEL-FABRIK ---
public class MainGame extends JPanel {
    private final int FRAME_WIDTH = 1920;
    private final int FRAME_HEIGHT = 1080;
    
    // OPTIMIERTER ZOOMFAKTOR: Bringt Weltkoordinaten (z.B. -50 bis +50) optimal auf den Schirm
    private double zoomFactor = 12.0; 
    private double zoomCenterX = 0;
    private double zoomCenterY = 0;

    private List<Unit> unitList = new ArrayList<>();
    private int zeitSchritt = 0;
    private int currentLevelId = 5;
    private boolean gameEnded = false;

    public MainGame() {
        setPreferredSize(new Dimension(FRAME_WIDTH, FRAME_HEIGHT));
        setBackground(Color.BLACK);
        setupMouseListeners();
        
        // Initiales Laden von Level 5 (korrigiert) oder Level 6
        loadLevel(6);
    }

    /**
     * ERWEITERTE LEVEL-FABRIK:
     * Erlaubt das nahtlose Umschalten und die skaliersbare Konfiguration beliebig vieler Level.
     */
    public void loadLevel(int levelId) {
        unitList.clear();
        gameEnded = false;
        zeitSchritt = 0;
        this.currentLevelId = levelId;

        LevelSetup setup;

        if (levelId == 5) {
            setup = new LevelSetup(5, "Entropie-Spur (Balanced)");
            
            // Hero (Team 1)
            Unit hero = new Unit(1, 1, 0.0, 0.0, 0.0, 150.0, 20.0, 1.5, 25.0);
            hero.decisionAlgorithm = "STAND_STILL";
            setup.addUnit(hero);

            // Skrall Hunter v5 (Team 2) - Angepasste Distanz & Reichweite
            Unit skrall = new Unit(2, 2, -35.0, 25.0, 10.0, 200.0, 12.0, 0.8, 15.0);
            skrall.decisionAlgorithm = "NEAREST_ENEMY";
            setup.addUnit(skrall);

            // Patrouillen & Entropie-Knoten
            setup.addUnit(new Unit(3, 2, 30.0, -20.0, -5.0, 50.0, 5.0, 1.0, 10.0));
            setup.addUnit(new Unit(4, 2, -25.0, -30.0, 5.0, 50.0, 5.0, 1.0, 10.0));

            // Lumini-Regenerationsknoten (Team 0)
            for (int i = 0; i < 3; i++) {
                Unit node = new Unit(10 + i, 0, (i - 1) * 20.0, 35.0, 0.0, 500.0, 0.0, 0.0, 0.0);
                node.decisionAlgorithm = "STAND_STILL";
                setup.addUnit(node);
            }
        } else {
            // LEVEL 6: Quanten-Entropie & Swarm-Resonanz
            setup = new LevelSetup(6, "Quanten-Entropie & Swarm-Resonanz");

            // Hero Commander
            Unit hero = new Unit(1, 1, -40.0, 0.0, 0.0, 300.0, 35.0, 2.0, 30.0);
            hero.decisionAlgorithm = "STAND_STILL";
            setup.addUnit(hero);

            // Hero Wingman (Gefährte)
            Unit wingman = new Unit(2, 1, -45.0, -10.0, 0.0, 120.0, 15.0, 2.2, 20.0);
            wingman.decisionAlgorithm = "NEAREST_ENEMY";
            setup.addUnit(wingman);

            // Gegnerischer Swarm (Team 2) in Formation
            for (int i = 0; i < 5; i++) {
                Unit swarm = new Unit(10 + i, 2, 30.0 + (i * 5), -20.0 + (i * 10), (i - 2) * 15.0, 80.0, 10.0, 1.2, 18.0);
                swarm.decisionAlgorithm = "NEAREST_ENEMY";
                setup.addUnit(swarm);
            }

            // Swarm-Boss
            Unit boss = new Unit(99, 2, 55.0, 0.0, 20.0, 450.0, 25.0, 0.6, 22.0);
            boss.decisionAlgorithm = "NEAREST_ENEMY";
            setup.addUnit(boss);

            // Lumini-Resonatoren (Team 0) als strategische Heil- & Pufferzonen
            Unit node1 = new Unit(100, 0, 0.0, -25.0, 0.0, 1000.0, 0, 0, 0);
            Unit node2 = new Unit(101, 0, 0.0, 25.0, 0.0, 1000.0, 0, 0, 0);
            node1.decisionAlgorithm = "STAND_STILL";
            node2.decisionAlgorithm = "STAND_STILL";
            setup.addUnit(node1);
            setup.addUnit(node2);
        }

        this.unitList = setup.units;
        System.out.println("=== MATRIXGAME LEVEL " + setup.levelId + ": " + setup.title + " GELADEN ===");
        System.out.println("Anzahl aktiver Einheiten: " + unitList.size());
        exportGitHubLog("LEVEL_INIT", "Level " + levelId + " erfolgreich initialisiert.");
    }

    private void GameLoop() {
        if (gameEnded) return;
        zeitSchritt++;

        for (int i = 0; i < unitList.size(); i++) {
            Unit u = unitList.get(i);
            if (u.leben <= 0) continue;

            // Z-Ebenen-Regeneration an Neutralen Lumini-Knoten (Team 0)
            for (Unit other : unitList) {
                if (other.team == 0 && u.team != 0 && u.getDistance(other) < 15.0) {
                    if (u.leben < u.maxLeben) {
                        u.leben = Math.min(u.maxLeben, u.leben + 0.5);
                    }
                }
            }

            // KI-Entscheidungs-Verhalten
            switch (u.decisionAlgorithm) {
                case "TARGET_POINT":
                    if (u.targetPosX != null && u.targetPosY != null) {
                        double tz = u.targetPosZ != null ? u.targetPosZ : 0.0;
                        u.moveTo(u.targetPosX, u.targetPosY, tz, u.speed * 0.1);
                        u.move(1.0);
                        if (Math.hypot(u.posX - u.targetPosX, u.posY - u.targetPosY) < 1.5) {
                            u.decisionAlgorithm = "STAND_STILL";
                            u.targetPosX = null;
                        }
                    }
                    break;

                case "NEAREST_ENEMY":
                    Unit enemy = getNearestEnemy(u);
                    if (enemy != null) {
                        double dist = u.getDistance(enemy);
                        if (dist <= u.distance) {
                            enemy.leben -= u.damage * 0.1;
                            if (enemy.leben <= 0) {
                                u.kills++;
                                String logMsg = "Unit " + enemy.id + " eliminiert durch Unit " + u.id;
                                System.out.println("[KILL-LOG] " + logMsg);
                                exportGitHubLog("UNIT_KILL", logMsg);
                            }
                        } else {
                            u.moveTo(enemy.posX, enemy.posY, enemy.posZ, u.speed * 0.1);
                            u.move(1.0);
                        }
                    }
                    break;

                case "STAND_STILL":
                default:
                    u.vx = 0; u.vy = 0; u.vz = 0;
                    break;
            }
        }

        // Besiegte Einheiten entfernen
        unitList.removeIf(u -> u.leben <= 0);

        // Überprüfung der Siegbedingungen
        checkWinCondition();
    }

    private void checkWinCondition() {
        boolean team1Alive = unitList.stream().anyMatch(u -> u.team == 1 && u.leben > 0);
        boolean team2Alive = unitList.stream().anyMatch(u -> u.team == 2 && u.leben > 0);

        if (!team2Alive && team1Alive && !gameEnded) {
            gameEnded = true;
            System.out.println("=== LEVEL " + currentLevelId + " SIEG! Alle Feinde eliminiert. ===");
            exportGitHubLog("LEVEL_COMPLETE", "Sieg in Level " + currentLevelId);
        } else if (!team1Alive && !gameEnded) {
            gameEnded = true;
            System.out.println("=== LEVEL " + currentLevelId + " NIEDERLAGE! Helden-Einheiten zerstört. ===");
            exportGitHubLog("LEVEL_FAILED", "Niederlage in Level " + currentLevelId);
        }
    }

    private Unit getNearestEnemy(Unit current) {
        Unit target = null;
        double minDistance = Double.MAX_VALUE;
        for (Unit u : unitList) {
            if (u.team != current.team && u.team != 0 && u.leben > 0) {
                double dist = current.getDistance(u);
                if (dist < minDistance) {
                    minDistance = dist;
                    target = u;
                }
            }
        }
        return target;
    }

    /**
     * GITHUB-INTEGRATIONS-HELFER: Erzeugt strukturierte Protokolle zur einfachen 
     * Versionsverfolgung und Repository-Dokumentation.
     */
    private void exportGitHubLog(String eventType, String details) {
        String jsonLog = String.format("{\"timestamp\": %d, \"level\": %d, \"event\": \"%s\", \"details\": \"%s\"}",
                System.currentTimeMillis(), currentLevelId, eventType, details);
        System.out.println("[GIT-EXPORT] " + jsonLog);
    }

    public void startGameLoop() {
        Thread t = new Thread(() -> {
            while (!Thread.currentThread().isInterrupted()) {
                try {
                    Thread.sleep(30);
                    GameLoop();
                    repaint();
                } catch (InterruptedException e) {
                    Thread.currentThread().interrupt();
                    break;
                }
            }
        });
        t.setDaemon(true);
        t.start();
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        // Hintergrund
        g2.setColor(new Color(10, 12, 18));
