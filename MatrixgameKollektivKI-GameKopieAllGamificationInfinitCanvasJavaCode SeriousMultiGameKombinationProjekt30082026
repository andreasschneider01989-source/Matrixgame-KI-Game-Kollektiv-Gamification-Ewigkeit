                // Coin Collection
                for (Entity c : entities) {
                    if (c.type == EntityType.COIN && c.active) {
                        double dist = Math.sqrt(Math.pow(p.x - c.x, 2) + Math.pow(p.y - c.y, 2));
                        if (dist < (p.radius + c.radius)) {
                            c.active = false;
