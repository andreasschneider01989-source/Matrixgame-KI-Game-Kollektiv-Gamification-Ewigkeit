class InfinityCanvas extends JPanel {
    private SimulationEngine engine;
    private double offsetX = 0.0; // Welt-Koordinaten-Verschiebung (Double)
    private double offsetY = 0.0;
    private double scale = 40.0;   // Pixel pro Einheit (Zoom-Faktor)
    
    private int dragStartX, dragStartY;
    private Unit selectedUnit = null;
    private Unit clipboardUnit = null;
    private String xAxisLabel = "X-Axis (Double)";
    private String yAxisLabel = "Y-Axis (Double)";

    public InfinityCanvas(SimulationEngine engine) {
        this.engine = engine;
        setBackground(new Color(15, 15, 25));
        setFocusable(true);

        // Maus-Listener für Selektion und Rechtsklick-Steuerung / Panning
        addMouseListener(new MouseAdapter() {
            public void mousePressed(MouseEvent e) {
                requestFocusInWindow();
                dragStartX = e.getX();
                dragStartY = e.getY();
                
                double wx = screenToWorldX(e.getX());
                double wy = screenToWorldY(e.getY());

                if (e.getButton() == MouseEvent.BUTTON1) {
                    // Linksklick: Einheit in der Nähe auswählen (Proximity-Check)
                    selectedUnit = null;
                    for (Unit u : engine.getAllUnits()) {
                        double dist = Math.hypot(u.worldX - wx, u.worldY - wy);
                        if (dist < 0.8) { // Trefferzone im Double-Space
                            selectedUnit = u;
                            break;
                        }
                    }
                    repaint();
                } else if (e.getButton() == MouseEvent.BUTTON3) {
                    // Rechtsklick: Selektierte Einheit direkt zum Zielpunkt im Infinity Canvas steuern
                    if (selectedUnit != null) {
                        selectedUnit.worldX = wx;
                        selectedUnit.worldY = wy;
                        repaint();
                    }
                }
            }
        });

        // Maus-Bewegung für Canvas-Panning (Verschieben mit gedrückter mittlerer Maustaste oder Shift+Rechts)
        addMouseMotionListener(new MouseMotionAdapter() {
            public void mouseDragged(MouseEvent e) {
                double dx = e.getX() - dragStartX;
                double dy = e.getY() - dragStartY;
                offsetX -= dx / scale;
                offsetY -= dy / scale;
                dragStartX = e.getX();
                dragStartY = e.getY();
                repaint();
            }
        });

        // Zoom-Steuerung per Mausrad
        addMouseWheelListener(e -> {
            double zoomFactor = 1.15;
            if (e.getWheelRotation() < 0) {
                scale *= zoomFactor;
            } else {
                scale /= zoomFactor;
            }
            repaint();
        });

        // Tastatur-Steuerung mit WASD & Pfeiltasten für die selektierte Einheit
        addKeyListener(new KeyAdapter() {
            public void keyPressed(KeyEvent e) {
                if (selectedUnit == null) return;
                double moveSpeed = 0.5; // Feinjustierbare Schrittweite im Double-Space
                
                switch (e.getKeyCode()) {
                    case KeyEvent.VK_W:
                    case KeyEvent.VK_UP:
                        selectedUnit.worldY -= moveSpeed;
                        break;
                    case KeyEvent.VK_S:
                    case KeyEvent.VK_DOWN:
                        selectedUnit.worldY += moveSpeed;
                        break;
                    case KeyEvent.VK_A:
                    case KeyEvent.VK_LEFT:
                        selectedUnit.worldX -= moveSpeed;
                        break;
                    case KeyEvent.VK_D:
                    case KeyEvent.VK_RIGHT:
                        selectedUnit.worldX += moveSpeed;
                        break;
                }
                repaint();
            }
        });
    }

    public double screenToWorldX(int screenX) {
        return (screenX - getWidth() / 2.0) / scale + offsetX;
    }

    public double screenToWorldY(int screenY) {
        return (screenY - getHeight() / 2.0) / scale + offsetY;
    }

    public int worldToScreenX(double worldX) {
        return (int) ((worldX - offsetX) * scale + getWidth() / 2.0);
    }

    public int worldToScreenY(double worldY) {
        return (int) ((worldY - offsetY) * scale + getHeight() / 2.0);
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2d = (Graphics2D) g;
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        drawInfinityGrid(g2d);
        drawUnits(g2d);
    }

    private void drawInfinityGrid(Graphics2D g2d) {
        g2d.setColor(new Color(35, 35, 50));
        int stepPx = (int) scale;
        if (stepPx < 15) stepPx *= 4; // Dynamisches Skalierungs-Lifting

        int w = getWidth();
        int h = getHeight();

        // Vertikale & Horizontale Gitternlinien für das unendliche Raster
        for (int x = w / 2 - (int)(offsetX * scale) % stepPx; x < w; x += stepPx) {
            g2d.drawLine(x, 0, x, h);
        }
        for (int x = w / 2 - (int)(offsetX * scale) % stepPx; x > 0; x -= stepPx) {
            g2d.drawLine(x, 0, x, h);
        }
        for (int y = h / 2 - (int)(offsetY * scale) % stepPx; y < h; y += stepPx) {
            g2d.drawLine(0, y, w, y);
        }
        for (int y = h / 2 - (int)(offsetY * scale) % stepPx; y > 0; y -= stepPx) {
            g2d.drawLine(0, y, w, y);
        }

        // Achsenbeschriftung und Status
        g2d.setColor(new Color(180, 180, 200));
        g2d.setFont(new Font("SansSerif", Font.BOLD, 12));
        g2d.drawString("Infinity Canvas | Achsen: " + xAxisLabel + " / " + yAxisLabel, 20, 25);
        g2d.drawString(String.format("Zoom: %.2f | Offset: (%.2f, %.2f) | Iteration: %d", scale, offsetX, offsetY, engine.getCurrentIteration()), 20, 45);
    }

    private void drawUnits(Graphics2D g2d) {
        for (Unit u : engine.getAllUnits()) {
            int sx = worldToScreenX(u.worldX);
            int sy = worldToScreenY(u.worldY);
            int radius = (int)(scale * 0.4);

            // Farbgebung nach Boulder-Dash / Matrixgame Typ
            if (u.type == UnitType.PLAYER) g2d.setColor(new Color(50, 150, 255));
            else if (u.type == UnitType.BOULDER) g2d.setColor(new Color(130, 130, 140));
            else if (u.type == UnitType.DIAMOND) g2d.setColor(new Color(0, 220, 220));
            else if (u.type == UnitType.WALL) g2d.setColor(new Color(90, 90, 110));
            else g2d.setColor(Color.WHITE);

            g2d.fillOval(sx - radius / 2, sy - radius / 2, radius, radius);

            // Markierung für selektierte Einheit
            if (u == selectedUnit) {
                g2d.setColor(Color.YELLOW);
                g2d.setStroke(new BasicStroke(2.5f));
                g2d.drawRect(sx - radius / 2 - 4, sy - radius / 2 - 4, radius + 8, radius + 8);
            }

            // Name und Koordinaten anzeigen
            g2d.setColor(Color.ORANGE);
            g2d.drawString(u.name + String.format(" (%.1f, %.1f)", u.worldX, u.worldY), sx + radius / 2 + 6, sy + 4);
        }
    }

    public Unit getSelectedUnit() { return selectedUnit; }
    public void setClipboardUnit(Unit u) { this.clipboardUnit = u; }
    public Unit getClipboardUnit() { return clipboardUnit; }
    
    public void pasteUnitAtCenter() {
        if (clipboardUnit != null) {
            Unit newU = clipboardUnit.cloneUnit();
            newU.worldX = offsetX;
            newU.worldY = offsetY;
            engine.addUnit(newU);
            selectedUnit = newU;
            repaint();
        }
    }
}

