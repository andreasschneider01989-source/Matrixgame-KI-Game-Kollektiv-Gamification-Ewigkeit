                repaint();
                
                // Debug-Ausgabe des Systemzustands
                if (key == KeyEvent.VK_SPACE) {
                    System.out.println(exportGameState());
                    System.out.println("Current Territory Score (Black): " + calculateTerritoryScore('b'));
                }
