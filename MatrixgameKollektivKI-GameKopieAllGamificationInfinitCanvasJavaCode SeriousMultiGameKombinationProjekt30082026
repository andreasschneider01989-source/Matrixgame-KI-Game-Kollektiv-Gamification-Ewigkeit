    private void updateGameLogic() {
        if (isPlaying) {
            // Skrall-Jäger verfolgt den Spieler
            double dx = player.x - skrall.x;
            double dy = player.y - skrall.y;
            double dist = Math.sqrt(dx * dx + dy * dy);

            if (dist > 0.5) {
                skrall.x += (dx / dist) * 0.08;
                skrall.y += (dy / dist) * 0.08;
            }

            checkCollisions();
            updateInspector();
            canvasPanel.repaint();
        }
    }

    private void checkCollisions() {
        // Münzen einsammeln
        for (Entity e : entities) {
            if (e.type == EntityType.COIN && e.active) {
                double dist = Math.sqrt(Math.pow(player.x - e.x, 2) + Math.pow(player.y - e.y, 2));
                if (dist < (player.radius + e.radius)) {
                    e.active = false;
                    coinsCollected++;
                }
            }
        }

        // Skrall-Treffer
        double distSkrall = Math.sqrt(Math.pow(player.x - skrall.x, 2) + Math.pow(player.y - skrall.y, 2));
        if (distSkrall < (player.radius + skrall.radius)) {
            isPlaying = false;
            JOptionPane.showMessageDialog(this, "Der Skrall-Jäger hat dich erwischt! Level wird zurückgesetzt.", "Game Over", JOptionPane.WARNING_MESSAGE);
            initLevel1Data();
        }

        // Ziel-Tor Prüfung
        double distGate = Math.sqrt(Math.pow(player.x - gate.x, 2) + Math.pow(player.y - gate.y, 2));
        if (distGate < (player.radius + gate.radius)) {
            if (coinsCollected >= totalCoins) {
                isPlaying = false;
                JOptionPane.showMessageDialog(this, "Level 1 ERFOLGREICH MEISTERIERT!\nAlle Münzen gesammelt!", "Victory", JOptionPane.INFORMATION_MESSAGE);
            }
        }
    }

