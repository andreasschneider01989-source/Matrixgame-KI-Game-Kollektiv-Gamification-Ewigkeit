public class MainGame extends JPanel {
    private final int FRAME_WIDTH = 1920;
    private final int FRAME_HEIGHT = 1080;
    private double zoomFactor = 0.0001;
    private double zoomCenterX = 0;
    private double zoomCenterY = 0;
    private double feinheit = 70;
    private double PAN_STEP = feinheit / zoomFactor;

    private List<Unit> unitList = new ArrayList<>();
    private List<Unit> unitsToAdd = new ArrayList<>();
    private int zeitSchritt = 0;
    private boolean gameEnded = false;

    public MainGame() {
        setPreferredSize(new Dimension(FRAME_WIDTH, FRAME_HEIGHT));
        setBackground(Color.BLACK);
        setupMouseListeners();
        
        // MODULARES LEVEL-LOADING: Level 5 direkt injizieren
        loadLevel(5);
    }

    /**
     * MODULARE FABRIKMETHODE: Hier können Level-Setups copy-paste-freundlich
     * ausgetauscht werden, ohne den GameLoop oder die Zeichnungslogik zu berühren.
     */
    public void loadLevel(int levelId) {
        unitList.clear();
        gameEnded = false;
        zeitSchritt = 0;
        System.out.println("=== INITIALISIERE MATRIXGAME LEVEL " + levelId + " ===");

        if (levelId == 5) {
            // Player Hero (Team 1)
            Unit hero = new Unit(1, 1, 17.05, 11.60, 0.0, 100.0, 15.0, 80.0, 500.0);
            hero.decisionAlgorithm = "STAND_STILL";
            unitList.add(hero);

            // Skrall Hunter v5 (Team 2) mit höherer Z-Ebene
            Unit skrall = new Unit(2, 2, 3.21, -22.73, 50.0, 250.0, 25.0, 45.0, 300.0);
            skrall.decisionAlgorithm = "NEAREST_ENEMY";
            unitList.add(skrall);

            // Patrol Einheiten & Lumini-Knoten auf unterschiedlichen Z-Ebenen (-100 bis +100)
            unitList.add(new Unit(3, 2, -0.19, -1.99, -20.0, 40.0, 5.0, 30.0, 150.0));
            unitList.add(new Unit(4, 2, 1.02, 0.55, 10.0, 40.0, 5.0, 30.0, 150.0));

            // Lumini-Entropie-Knoten (Neutral/Team 0) als interaktive Heilpunkte
            for (int i = 0; i < 3; i++) {
                Unit node = new Unit(10 + i, 0, (i - 1) * 12.0, (i - 1) * 5.0, i * 25.0, 500.0, 0.0, 0.0, 0.0);
                node.decisionAlgorithm = "STAND_STILL";
                node.blue = 255; node.red = 0; node.green = 255;
                unitList.add(node);
            }
        }
        System.out.println("Level " + levelId + " erfolgreich geladen mit " + unitList.size() + " Objekten.");
    }

    private void GameLoop() {
        if (gameEnded) return;
        zeitSchritt++;

        for (int i = 0; i < unitList.size(); i++) {
            Unit u = unitList.get(i);
            if (u.leben <= 0) continue;

            // Z-Ebenen Entropie & Newton-Regeneration in der Nähe von Lumini-Knoten (Team 0)
            for (Unit other : unitList) {
                if (other.team == 0 && u.team != 0 && u.getDistance(other) < 100.0) {
                    // Regeneration via Newton-Schritt
                    u.leben = Math.min(u.maxLeben, u.leben + (u.maxLeben - u.leben) * 0.05);
                }
            }

            // Bewegungs- Logik basierend auf Verhaltenszuständen
            switch (u.decisionAlgorithm) {
                case "TARGET_POINT":
                    if (u.targetPosX != null && u.targetPosY != null) {
                        double tz = u.targetPosZ != null ? u.targetPosZ : 0.0;
                        u.moveTo(u.targetPosX, u.targetPosY, tz, u.speed);
                        u.move(1.0);
                        if (Math.hypot(u.posX - u.targetPosX, u.posY - u.targetPosY) < 2.0) {
                            u.decisionAlgorithm = "STAND_STILL";
                            u.targetPosX = null;
                        }
                    }
                    break;
                case "NEAREST_ENEMY":
                    Unit enemy = getNearestEnemy(u);
                    if (enemy != null) {
                        if (u.getDistance(enemy) <= u.distance) {
                            enemy.leben -= u.damage;
                            if (enemy.leben <= 0) {
                                u.kills++;
                                u.printReport(zeitSchritt);
                                System.out.println("[KILL-LOG] Unit " + enemy.id + " eliminiert durch Unit " + u.id);
                            }
                        } else {
                            u.moveTo(enemy.posX, enemy.posY, enemy.posZ, u.speed);
                            u.move(1.0);
                        }
                    }
                    break;
                case "STAND_STILL":
                default:
                    u.vx = 0; u.vy = 0; u.vz = 0;
                    break;
            }
        }

        // Leichen entfernen
        unitList.removeIf(u -> u.leben <= 0);
    }

    private Unit getNearestEnemy(Unit current) {
        Unit target = null;
        double minDistance = Double.MAX_VALUE;
        for (Unit u : unitList) {
            if (u.team != current.team && u.team != 0 && u.leben > 0) {
                double dist = current.getDistance(u);
                if (dist < minDistance) {
                    minDistance = dist;
                    target = u;
                }
            }
        }
        return target;
    }

    public void startGameLoop() {
        Thread t = new Thread(() -> {
            while (!Thread.currentThread().isInterrupted()) {
                try {
                    Thread.sleep(30);
                    GameLoop();
                    repaint();
                } catch (InterruptedException e) {
                    Thread.currentThread().interrupt();
                    break;
                }
            }
        });
        t.setDaemon(true);
        t.start();
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setColor(Color.BLACK);
        g2.fillRect(0, 0, getWidth(), getHeight());

        for (Unit u : unitList) {
            // Z-Achsen-Projektion: Radius skaliert dynamisch mit Höhe (posZ)
            double zScale = 1.0 + (u.posZ / 200.0);
            double effectiveRadius = Math.max(3.0, u.size * zScale);

            double sx = (zoomCenterX + u.posX) * zoomFactor + getWidth() / 2.0;
