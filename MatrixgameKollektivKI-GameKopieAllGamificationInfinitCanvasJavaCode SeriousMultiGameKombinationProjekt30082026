    private void updateGameLogic() {
        if (isPlaying) {
            timeElapsed += 0.033;

            // 1. Skrall-Jäger Logik (Verfolgung)
            double dx = player.x - skrall.x;
            double dy = player.y - skrall.y;
            double dist = Math.sqrt(dx * dx + dy * dy);
            if (dist > 0.4) {
                skrall.x += (dx / dist) * 0.095;
                skrall.y += (dy / dist) * 0.095;
            }

            // 2. Patrouillen-Drohn Logik (Sinus-Wellen-Patrouille)
            patrol.patPhase += 0.05;
            patrol.x = Math.sin(patrol.patPhase) * 8.0;
            patrol.y = Math.cos(patrol.patPhase * 0.5) * 3.0;

            checkCollisions();
            updateInspector();
            canvasPanel.repaint();
        }
    }

    private void checkCollisions() {
        // Münzen (+100 XP)
        for (Entity e : entities) {
            if (e.type == EntityType.COIN && e.active) {
                double dist = Math.sqrt(Math.pow(player.x - e.x, 2) + Math.pow(player.y - e.y, 2));
                if (dist < (player.radius + e.radius)) {
                    e.active = false;
                    coinsCollected++;
                    scoreXP += 100;
                }
            }
        }

        // Lumini-Schaltknoten (+250 XP)
        for (Entity e : entities) {
            if (e.type == EntityType.SWITCH && e.active && !e.triggered) {
                double dist = Math.sqrt(Math.pow(player.x - e.x, 2) + Math.pow(player.y - e.y, 2));
                if (dist < (player.radius + e.radius)) {
                    e.triggered = true;
                    e.color = new Color(0, 255, 100);
                    switchesActivated++;
                    scoreXP += 250;
                }
            }
        }

        // Ausgangstor entriegeln
        if (switchesActivated >= totalSwitches && coinsCollected >= totalCoins) {
            gate.color = new Color(0, 255, 180);
        }

        // Gegner-Treffer
        double distSkrall = Math.sqrt(Math.pow(player.x - skrall.x, 2) + Math.pow(player.y - skrall.y, 2));
        double distPatrol = Math.sqrt(Math.pow(player.x - patrol.x, 2) + Math.pow(player.y - patrol.y, 2));

        if (distSkrall < (player.radius + skrall.radius) || distPatrol < (player.radius + patrol.radius)) {
            isPlaying = false;
            JOptionPane.showMessageDialog(this, "Bedrohungskollision! Level 3 wird neugestartet.", "Matrix System Reboot", JOptionPane.WARNING_MESSAGE);
            initLevel3Data();
        }

        // Ziel-Tor Prüfung
        double distGate = Math.sqrt(Math.pow(player.x - gate.x, 2) + Math.pow(player.y - gate.y, 2));
        if (distGate < (player.radius + gate.radius)) {
            if (switchesActivated >= totalSwitches && coinsCollected >= totalCoins) {
                isPlaying = false;
                int timeBonus = Math.max(0, 1000 - (int)(timeElapsed * 10));
                scoreXP += timeBonus;
                JOptionPane.showMessageDialog(this, String.format("LEVEL 3 ERFOLGREICH GEMEISTERT!\n\nGesamt XP: %d\nZeitbonus: +%d XP\nZeit: %.1f Sekunden", scoreXP, timeBonus, timeElapsed), "Level Completed", JOptionPane.INFORMATION_MESSAGE);
            }
        }
    }

    public String exportGameState() {
