class SimulationEngine {
    private int width, height;
    private Unit[][] grid;
    private boolean running = false;
    private int tickRateMs = 100;
    private int currentIteration = 0;

    public SimulationEngine(int width, int height) {
        this.width = width;
        this.height = height;
        this.grid = new Unit[width][height];
        initDefaultUnits();
    }

    private void initDefaultUnits() {
        // Beispiel-Einheiten im Grid platzieren
        grid[5][5] = new Unit("Player_1", UnitType.PLAYER, 5.0, 5.0);
        grid[8][5] = new Unit("Boulder_1", UnitType.BOULDER, 8.0, 5.0);
        grid[8][7] = new Unit("Diamond_1", UnitType.DIAMOND, 8.0, 7.0);
    }

    public synchronized void step() {
        currentIteration++;
        // Hier greift die Boulder-Dash / Simulations-Logik für einen Iterationsschritt
        for (int x = 0; x < width; x++) {
            for (int y = 0; y < height; y++) {
                Unit u = grid[x][y];
                if (u != null) {
                    u.updateCustomVariables();
                }
            }
        }
    }

    public void runLoop() {
        while (true) {
            if (running) {
                step();
            }
            try {
                Thread.sleep(tickRateMs);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                break;
            }
        }
    }

    public void setRunning(boolean running) { this.running = running; }
    public boolean isRunning() { return running; }
    public int getCurrentIteration() { return currentIteration; }
    public Unit getUnitAt(int x, int y) {
        if (x >= 0 && x < width && y >= 0 && y < height) return grid[x][y];
        return null;
    }
    public void setUnitAt(int x, int y, Unit u) {
        if (x >= 0 && x < width && y >= 0 && y < height) {
            grid[x][y] = u;
            if (u != null) {
                u.worldX = x;
                u.worldY = y;
            }
        }
    }
}

enum UnitType { EMPTY, PLAYER, BOULDER, DIAMOND, WALL }

class Unit {
    public String name;
    public UnitType type;
    public double worldX, worldY;
    public double customVarA = 1.0; // Beliebige Double-Variablen
    public double customVarB = 0.0;

    public Unit(String name, UnitType type, double worldX, double worldY) {
        this.name = name;
        this.type = type;
        this.worldX = worldX;
        this.worldY = worldY;
    }

    public void updateCustomVariables() {
        customVarB += 0.1; // Beispielhafte Dynamik
    }

    public Unit cloneUnit() {
        Unit copy = new Unit(name + "_copy", type, worldX, worldY);
        copy.customVarA = this.customVarA;
        copy.customVarB = this.customVarB;
        return copy;
    }
}

