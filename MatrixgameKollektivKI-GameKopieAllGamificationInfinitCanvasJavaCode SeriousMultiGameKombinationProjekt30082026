            double dist = Math.sqrt(Math.pow(player.x - skrall.x, 2) + Math.pow(player.y - skrall.y, 2));
            g2.drawString(String.format("Distanz zur Bedrohung: %6.2f", dist), 20, 115);
        }
    }

