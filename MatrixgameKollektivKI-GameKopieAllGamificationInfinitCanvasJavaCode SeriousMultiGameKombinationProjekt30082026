    private void GameLoop() {
        if (gameEnded) return;
        zeitSchritt++;

        Unit hero = unitList.stream().filter(u -> u.id == 1).findFirst().orElse(null);

        // Münzen einsammeln
        if (hero != null) {
            for (Coin c : coinList) {
                if (!c.collected && Math.hypot(hero.posX - c.x, hero.posY - c.y) < 2.5) {
                    c.collected = true;
                    collectedCoins++;
                    xpPoints += 50;
                }
            }
        }

        for (int i = 0; i < unitList.size(); i++) {
            Unit u = unitList.get(i);
            if (u.leben <= 0) continue;

            // Lumini Regeneration
            for (Unit other : unitList) {
                if (other.team == 0 && u.team != 0 && u.getDistance(other) < 15.0) {
                    if (u.leben < u.maxLeben) {
                        u.leben = Math.min(u.maxLeben, u.leben + 0.4);
                    }
                }
            }

            // KI-Pfadfindung & Angriff
            switch (u.decisionAlgorithm) {
                case "TARGET_POINT":
                    if (u.targetPosX != null && u.targetPosY != null) {
                        double tz = u.targetPosZ != null ? u.targetPosZ : 0.0;
                        u.moveTo(u.targetPosX, u.targetPosY, tz, u.speed * 0.1);
                        u.move(1.0);
                        if (Math.hypot(u.posX - u.targetPosX, u.posY - u.targetPosY) < 1.5) {
                            u.decisionAlgorithm = "STAND_STILL";
                            u.targetPosX = null;
                        }
                    }
                    break;

                case "NEAREST_ENEMY":
                    Unit enemy = getNearestEnemy(u);
                    if (enemy != null) {
                        double dist = u.getDistance(enemy);
                        if (dist <= u.distance) {
                            enemy.leben -= u.damage * 0.08;
                            if (enemy.leben <= 0) {
                                u.kills++;
                                System.out.printf("[KILL-LOG] %s (ID %.0f) eliminiert durch %s (ID %.0f)%n",
                                        enemy.name, enemy.id, u.name, u.id);
                            }
                        } else {
                            u.moveTo(enemy.posX, enemy.posY, enemy.posZ, u.speed * 0.1);
                            u.move(1.0);
                        }
                    }
                    break;
            }
        }

        unitList.removeIf(u -> u.leben <= 0);

        // Sieg / Niederlage Bedingungen
        boolean heroAlive = unitList.stream().anyMatch(u -> u.team == 1);
        boolean enemiesAlive = unitList.stream().anyMatch(u -> u.team == 2);

        if (!enemiesAlive && heroAlive && !gameEnded) {
            gameEnded = true;
            System.out.println("=== LEVEL " + currentLevelId + " SIEG! Alle Einheiten eliminiert. ===");
            exportStateToConsole();
        } else if (!heroAlive && !gameEnded) {
            gameEnded = true;
            System.out.println("=== LEVEL " + currentLevelId + " NIEDERLAGE! Helden-Einheit zerstört. ===");
            exportStateToConsole();
        }
    }

    private Unit getNearestEnemy(Unit current) {
        Unit target = null;
        double minDistance = Double.MAX_VALUE;
        for (Unit u : unitList) {
            if (u.team != current.team && u.team != 0 && u.leben > 0) {
                double dist = current.getDistance(u);
                if (dist < minDistance) {
                    minDistance = dist;
                    target = u;
                }
            }
        }
        return target;
    }

    public void startGameLoop() {
        Thread t = new Thread(() -> {
            while (!Thread.currentThread().isInterrupted()) {
                try {
                    Thread.sleep(30);
                    GameLoop();
                    repaint();
                } catch (InterruptedException e) {
                    Thread.currentThread().interrupt();
                    break;
                }
            }
        });
        t.setDaemon(true);
        t.start();
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        int cx = getWidth() / 2;
        int cy = getHeight() / 2;

        // Koordinaten-Raster
        g2.setColor(new Color(25, 32, 45));
        for (int i = -1000; i <= 1000; i += 50) {
            int x = (int) (cx + (i + zoomCenterX) * zoomFactor);
            int y = (int) (cy + (i + zoomCenterY) * zoomFactor);
            g2.drawLine(x, 0, x, getHeight());
            g2.drawLine(0, y, getWidth(), y);
        }

        // Wände zeichnen
        g2.setColor(new Color(80, 100, 130));
        for (Wall w : wallList) {
            int wx = (int) (cx + (w.x + zoomCenterX) * zoomFactor);
            int wy = (int) (cy + (w.y + zoomCenterY) * zoomFactor);
            g2.fillRect(wx, wy, (int) (w.width * zoomFactor), (int) (w.height * zoomFactor));
        }

        // Portale zeichnen
        g2.setColor(new Color(180, 50, 220));
        for (Portal p : portalList) {
            int px = (int) (cx + (p.x + zoomCenterX) * zoomFactor);
            int py = (int) (cy + (p.y + zoomCenterY) * zoomFactor);
            g2.drawOval(px - 15, py - 15, 30, 30);
        }

        // Münzen
        g2.setColor(Color.YELLOW);
        for (Coin c : coinList) {
            if (!c.collected) {
                int coinX = (int) (cx + (c.x + zoomCenterX) * zoomFactor);
                int coinY = (int) (cy + (c.y + zoomCenterY) * zoomFactor);
                g2.fillOval(coinX - 4, coinY - 4, 8, 8);
            }
        }

        // Einheiten zeichnen
        for (Unit u : unitList) {
            double zScale = 1.0 + (u.posZ / 150.0);
            double effectiveRadius = Math.max(4.0, u.size * Math.max(0.3, zScale));

            double sx = cx + (u.posX + zoomCenterX) * zoomFactor;
            double sy = cy + (u.posY + zoomCenterY) * zoomFactor;

            if (u.isSelected) {
                g2.setColor(Color.YELLOW);
                g2.drawOval((int) (sx - effectiveRadius - 4), (int) (sy - effectiveRadius - 4),
                            (int) (effectiveRadius * 2 + 8), (int) (effectiveRadius * 2 + 8));
            }

            g2.setColor(new Color((int) u.red, (int) u.green, (int) u.blue));
            g2.fillOval((int) (sx - effectiveRadius), (int) (sy - effectiveRadius),
                        (int) (effectiveRadius * 2), (int) (effectiveRadius * 2));

            // Lebensbalken
            if (u.team != 0) {
                int barWidth = 32;
                int barHeight = 4;
                int barX = (int) (sx - barWidth / 2);
                int barY = (int) (sy - effectiveRadius - 10);
                
                g2.setColor(Color.RED);
                g2.fillRect(barX, barY, barWidth, barHeight);
                g2.setColor(Color.GREEN);
                g2.fillRect(barX, barY, (int) (barWidth * (u.leben / u.maxLeben)), barHeight);
            }
        }

        // HUD Overlay (Analog zu Screenshot/Log Level 4)
        g2.setFont(new Font("Monospaced", Font.BOLD, 13));
        g2.setColor(Color.YELLOW);
        g2.drawString(String.format("Coins: %d / %d", collectedCoins, maxCoins), 20, 30);
        g2.setColor(Color.CYAN);
        long luminiCount = unitList.stream().filter(u -> u.team == 0).count();
        g2.drawString(String.format("Lumini-Knoten: %d / %d", luminiCount, luminiCount), 20, 50);
        g2.setColor(Color.GREEN);
        g2.drawString(String.format("XP-Punkte: %d", xpPoints), 20, 70);
        g2.setColor(Color.WHITE);
        g2.drawString(String.format("Zeit: %.1f s", (System.currentTimeMillis() - startTime) / 1000.0), 20, 90);

        Unit hero = unitList.stream().filter(u -> u.id == 1).findFirst().orElse(null);
        Unit skrall = unitList.stream().filter(u -> u.id == 2).findFirst().orElse(null);

        if (hero != null) {
            g2.setColor(Color.CYAN);
            g2.drawString(String.format("Player POS: X: %6.2f | Y: %6.2f", hero.posX, hero.posY), 20, 115);
        }
        if (skrall != null) {
            g2.setColor(Color.RED);
            g2.drawString(String.format("Skrall POS: X: %6.2f | Y: %6.2f", skrall.posX, skrall.posY), 20, 135);
        }

        g2.setColor(Color.GRAY);
        g2.drawString("Level-Auswahl: Tasten 4, 5, 6 drücken | Linksklick: Selektion | Rechtsklick: Bewegen", 20, getHeight() - 20);
    }

    private void setupControls() {
        addMouseListener(new MouseAdapter() {
            @Override
            public void mousePressed(MouseEvent e) {
                int mx = e.getX();
                int my = e.getY();
                int cx = getWidth() / 2;
                int cy = getHeight() / 2;

                if (SwingUtilities.isLeftMouseButton(e)) {
                    for (Unit u : unitList) {
                        double sx = cx + (u.posX + zoomCenterX) * zoomFactor;
                        double sy = cy + (u.posY + zoomCenterY) * zoomFactor;
                        u.isSelected = Math.hypot(mx - sx, my - sy) <= u.size * 1.5;
                    }
                } else if (SwingUtilities.isRightMouseButton(e)) {
                    double worldTargetX = (mx - cx) / zoomFactor - zoomCenterX;
                    double worldTargetY = (my - cy) / zoomFactor - zoomCenterY;
                    for (Unit u : unitList) {
                        if (u.isSelected && u.team == 1) {
                            u.targetPosX = worldTargetX;
                            u.targetPosY = worldTargetY;
                            u.decisionAlgorithm = "TARGET_POINT";
                        }
                    }
                }
                repaint();
            }
        });

        setFocusable(true);
        addKeyListener(new KeyAdapter() {
            @Override
            public void keyPressed(KeyEvent e) {
                if (e.getKeyCode() == KeyEvent.VK_4) loadLevel(4);
                if (e.getKeyCode() == KeyEvent.VK_5) loadLevel(5);
                if (e.getKeyCode() == KeyEvent.VK_6) loadLevel(6);
            }
        });
    }

