    private void updateGameLogic() {
        if (isPlaying) {
            // Skrall-Jäger verfolgt den Spieler mit dynamischer Beschleunigung
            double dx = player.x - skrall.x;
            double dy = player.y - skrall.y;
            double dist = Math.sqrt(dx * dx + dy * dy);

            double currentSpeed = 0.09 + (switchesActivated * 0.02); // Wird schneller pro aktiviertem Schalter
            if (dist > 0.4) {
                skrall.x += (dx / dist) * currentSpeed;
                skrall.y += (dy / dist) * currentSpeed;
            }

            checkCollisions();
            updateInspector();
            canvasPanel.repaint();
        }
    }

    private void checkCollisions() {
        // 1. Münzen einsammeln
        for (Entity e : entities) {
            if (e.type == EntityType.COIN && e.active) {
                double dist = Math.sqrt(Math.pow(player.x - e.x, 2) + Math.pow(player.y - e.y, 2));
                if (dist < (player.radius + e.radius)) {
                    e.active = false;
                    coinsCollected++;
                }
            }
        }

        // 2. Lumini-Schaltknoten aktivieren
        for (Entity e : entities) {
            if (e.type == EntityType.SWITCH && e.active && !e.triggered) {
                double dist = Math.sqrt(Math.pow(player.x - e.x, 2) + Math.pow(player.y - e.y, 2));
                if (dist < (player.radius + e.radius)) {
                    e.triggered = true;
                    e.color = new Color(0, 255, 100); // Erfolgreich aktiviert
                    switchesActivated++;
                }
            }
        }

        // 3. Ausgangstor Status prüfen & entriegeln
        if (switchesActivated >= totalSwitches && coinsCollected >= totalCoins) {
            gate.color = new Color(0, 255, 180); // Grün = Entriegelt
        }

        // 4. Skrall-Treffer
        double distSkrall = Math.sqrt(Math.pow(player.x - skrall.x, 2) + Math.pow(player.y - skrall.y, 2));
        if (distSkrall < (player.radius + skrall.radius)) {
            isPlaying = false;
            JOptionPane.showMessageDialog(this, "Der Skrall-Jäger v2 hat dich erwischt! Level 2 wird neugestartet.", "Game Over", JOptionPane.WARNING_MESSAGE);
            initLevel2Data();
        }

        // 5. Ziel-Tor Prüfung
        double distGate = Math.sqrt(Math.pow(player.x - gate.x, 2) + Math.pow(player.y - gate.y, 2));
        if (distGate < (player.radius + gate.radius)) {
            if (switchesActivated >= totalSwitches && coinsCollected >= totalCoins) {
                isPlaying = false;
                JOptionPane.showMessageDialog(this, "LEVEL 2 ERFOLGREICH GEPLANT UND GEMEISTERT!\nSicherheitsmatrix überwunden.", "Level Complete", JOptionPane.INFORMATION_MESSAGE);
            }
        }
    }

