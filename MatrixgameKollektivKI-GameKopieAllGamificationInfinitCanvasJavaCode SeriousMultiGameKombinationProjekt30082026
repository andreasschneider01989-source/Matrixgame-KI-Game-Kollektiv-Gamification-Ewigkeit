// 2. INFINITY CANVAS & RENDERER
// ==========================================
class InfinityCanvas extends JPanel {
    private SimulationEngine engine;
    private double offsetX = 0.0, offsetY = 0.0, scale = 40.0;
    private int dragStartX, dragStartY;
    private Unit selectedUnit = null, draggedUnit = null;

    public InfinityCanvas(SimulationEngine engine) {
        this.engine = engine;
        setBackground(new Color(10, 10, 20));
        setFocusable(true);

        addMouseListener(new MouseAdapter() {
            public void mousePressed(MouseEvent e) {
                requestFocusInWindow();
                dragStartX = e.getX(); dragStartY = e.getY();
                double wx = screenToWorldX(e.getX()), wy = screenToWorldY(e.getY());

                if (e.getButton() == MouseEvent.BUTTON1) {
                    selectedUnit = null; draggedUnit = null;
                    for (Unit u : engine.getAllUnits()) {
                        if (Math.hypot(u.worldX - wx, u.worldY - wy) < 0.8) {
                            selectedUnit = u; draggedUnit = u; break;
                        }
                    }
                    repaint();
                } else if (e.getButton() == MouseEvent.BUTTON3 && selectedUnit != null) {
                    if (engine.isPassable(wx, wy, selectedUnit)) {
                        selectedUnit.worldX = wx; selectedUnit.worldY = wy;
                        repaint();
                    }
                }
            }
            public void mouseReleased(MouseEvent e) { draggedUnit = null; }
        });

        addMouseMotionListener(new MouseMotionAdapter() {
            public void mouseDragged(MouseEvent e) {
                double wx = screenToWorldX(e.getX()), wy = screenToWorldY(e.getY());
                if (draggedUnit != null) {
                    // Kollisionsprüfung für Drag & Drop
                    if (engine.isPassable(wx, wy, draggedUnit)) {
                        draggedUnit.worldX = wx; draggedUnit.worldY = wy;
                    }
                    repaint();
                } else {
                    offsetX -= (e.getX() - dragStartX) / scale; offsetY -= (e.getY() - dragStartY) / scale;
                    dragStartX = e.getX(); dragStartY = e.getY();
                    repaint();
                }
            }
        });

        addMouseWheelListener(e -> {
            scale *= (e.getWheelRotation() < 0) ? 1.15 : 1/1.15;
            repaint();
        });

        addKeyListener(new KeyAdapter() {
            public void keyPressed(KeyEvent e) {
                Unit player = engine.getPlayer();
                if (player == null) return;
                double speed = 0.4;
                double nextX = player.worldX;
                double nextY = player.worldY;
                
                switch (e.getKeyCode()) {
                    case KeyEvent.VK_W: case KeyEvent.VK_UP: nextY -= speed; break;
                    case KeyEvent.VK_S: case KeyEvent.VK_DOWN: nextY += speed; break;
                    case KeyEvent.VK_A: case KeyEvent.VK_LEFT: nextX -= speed; break;
                    case KeyEvent.VK_D: case KeyEvent.VK_RIGHT: nextX += speed; break;
                }
                
                // Kollision abfragen, bevor sich der Spieler bewegt
                if (engine.isPassable(nextX, nextY, player)) {
                    player.worldX = nextX;
                    player.worldY = nextY;
                }
                repaint();
            }
        });
    }

    public double screenToWorldX(int sx) { return (sx - getWidth() / 2.0) / scale + offsetX; }
    public double screenToWorldY(int sy) { return (sy - getHeight() / 2.0) / scale + offsetY; }
    public int worldToScreenX(double wx) { return (int) ((wx - offsetX) * scale + getWidth() / 2.0); }
    public int worldToScreenY(double wy) { return (int) ((wy - offsetY) * scale + getHeight() / 2.0); }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2d = (Graphics2D) g;
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        drawInfinityGrid(g2d);
        drawUnits(g2d);
        drawHUD(g2d);
    }

    private void drawInfinityGrid(Graphics2D g2d) {
        g2d.setColor(new Color(25, 25, 35));
        int stepPx = (int) scale;
        if (stepPx < 15) stepPx *= 4;
        int w = getWidth(), h = getHeight();
        for (int x = w / 2 - (int)(offsetX * scale) % stepPx; x < w; x += stepPx) g2d.drawLine(x, 0, x, h);
        for (int x = w / 2 - (int)(offsetX * scale) % stepPx; x > 0; x -= stepPx) g2d.drawLine(x, 0, x, h);
        for (int y = h / 2 - (int)(offsetY * scale) % stepPx; y < h; y += stepPx) g2d.drawLine(0, y, w, y);
        for (int y = h / 2 - (int)(offsetY * scale) % stepPx; y > 0; y -= stepPx) g2d.drawLine(0, y, w, y);
    }

    private void drawUnits(Graphics2D g2d) {
        for (Unit u : engine.getAllUnits()) {
            int sx = worldToScreenX(u.worldX), sy = worldToScreenY(u.worldY), r = (int)(scale * 0.45);
            if (u.type == UnitType.PLAYER) g2d.setColor(new Color(50, 160, 255));
            else if (u.type == UnitType.ENEMY_SKRALL) g2d.setColor(new Color(255, 60, 60));
            else if (u.type == UnitType.DIAMOND) g2d.setColor(new Color(0, 255, 220));
            else if (u.type == UnitType.GATE) g2d.setColor(new Color(255, 215, 0));
            else if (u.type == UnitType.BOULDER) g2d.setColor(new Color(110, 110, 120));
            else if (u.type == UnitType.WALL) g2d.setColor(new Color(60, 60, 80));

            if (u.type == UnitType.GATE || u.type == UnitType.WALL) g2d.fillRect(sx - r/2, sy - r/2, r, r);
            else g2d.fillOval(sx - r/2, sy - r/2, r, r);

            if (u == selectedUnit) {
                g2d.setColor(Color.YELLOW);
                g2d.drawRect(sx - r/2 - 4, sy - r/2 - 4, r + 8, r + 8);
            }
        }
    }

    private void drawHUD(Graphics2D g2d) {
        g2d.setColor(Color.WHITE);
        g2d.setFont(new Font("Consolas", Font.BOLD, 14));
        g2d.drawString(String.format("Coins: %d / %d", engine.getCollectedCoins(), engine.getTotalCoins()), 20, 30);
        
        // Telemetrie: Positionen live anzeigen
        Unit p = engine.getPlayer();
        Unit s = engine.getSkrall();
        if (p != null) {
            g2d.setColor(new Color(50, 160, 255));
            g2d.drawString(String.format("Player POS: [ %.2f , %.2f ]", p.worldX, p.worldY), 20, 60);
        }
        if (s != null) {
            g2d.setColor(new Color(255, 80, 80));
            g2d.drawString(String.format("Skrall POS: [ %.2f , %.2f ]", s.worldX, s.worldY), 20, 80);
            if (p != null) {
                double dist = Math.hypot(p.worldX - s.worldX, p.worldY - s.worldY);
                g2d.drawString(String.format("Distanz zur Bedrohung: %.2f", dist), 20, 100);
            }
        }

        GameState state = engine.getGameState();
        if (state == GameState.WON) {
            g2d.setColor(new Color(0, 255, 100, 220)); g2d.fillRect(getWidth() / 2 - 200, getHeight() / 2 - 50, 400, 100);
            g2d.setColor(Color.BLACK); g2d.setFont(new Font("SansSerif", Font.BOLD, 24));
            g2d.drawString("SIEG! Tor erreicht!", getWidth() / 2 - 110, getHeight() / 2 + 8);
        } else if (state == GameState.GAME_OVER) {
            g2d.setColor(new Color(255, 50, 50, 220)); g2d.fillRect(getWidth() / 2 - 200, getHeight() / 2 - 50, 400, 100);
            g2d.setColor(Color.WHITE); g2d.setFont(new Font("SansSerif", Font.BOLD, 24));
            g2d.drawString("GAME OVER! Skrall hat dich!", getWidth() / 2 - 150, getHeight() / 2 + 8);
        }
    }
    public Unit getSelectedUnit() { return selectedUnit; }
}

