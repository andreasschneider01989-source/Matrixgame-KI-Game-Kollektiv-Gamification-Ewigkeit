    private void updateInspector() {
        if (selectedEntity != null) {
            lblName.setText("Name: " + selectedEntity.name);
            lblType.setText("Typ: " + selectedEntity.type);
            lblX.setText(String.format("Welt-X: %.2f", selectedEntity.x));
