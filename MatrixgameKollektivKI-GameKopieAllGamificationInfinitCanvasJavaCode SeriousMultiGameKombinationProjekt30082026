// ==========================================
// 1. DATA & GAME SIMULATION ENGINE
// ==========================================
enum UnitType { PLAYER, BOULDER, DIAMOND, WALL, ENEMY_SKRALL, GATE }
enum GameState { PLAYING, WON, GAME_OVER }

class SimulationEngine {
    private List<Unit> units;
    private boolean running = false;
    private int tickRateMs = 60; // Etwas schnellerer Game-Loop
    private int currentIteration = 0;
    private GameState gameState = GameState.PLAYING;
    private int totalCoins = 0;
    private int collectedCoins = 0;
    private final double COLLISION_RADIUS = 0.85;

    public SimulationEngine() {
        units = new ArrayList<>();
        initLevel();
    }

    public void initLevel() {
        units.clear();
        currentIteration = 0;
        collectedCoins = 0;
        gameState = GameState.PLAYING;

        // Spieler
        units.add(new Unit("Player", UnitType.PLAYER, 0.0, 0.0));
        
        // Skrall (Gegner) startet weiter weg
        units.add(new Unit("Skrall_Hunter", UnitType.ENEMY_SKRALL, 12.0, -8.0));

        // Ziel-Tor
        units.add(new Unit("Exit_Gate", UnitType.GATE, -10.0, 10.0));

        // Münzen im Labyrinth verteilt
        units.add(new Unit("Coin_1", UnitType.DIAMOND, 4.0, -4.0));
        units.add(new Unit("Coin_2", UnitType.DIAMOND, -6.0, 2.0));
        units.add(new Unit("Coin_3", UnitType.DIAMOND, 8.0, 8.0));
        units.add(new Unit("Coin_4", UnitType.DIAMOND, -2.0, -8.0));
        units.add(new Unit("Coin_5", UnitType.DIAMOND, -10.0, 4.0));
        totalCoins = 5;

        // Generierung eines einfachen Labyrinths (Wände)
        buildMaze();
    }

    private void buildMaze() {
        // Horizontale Wände
        for (double x = -8; x <= 8; x += 1.5) {
            if (Math.abs(x) > 2) units.add(new Unit("Wall", UnitType.WALL, x, -6.0));
            if (x < 4 && x > -4) units.add(new Unit("Wall", UnitType.WALL, x, 6.0));
            units.add(new Unit("Wall", UnitType.WALL, x, -12.0));
        }
        // Vertikale Wände
        for (double y = -12; y <= 12; y += 1.5) {
            if (Math.abs(y) > 3 && y < 8) units.add(new Unit("Wall", UnitType.WALL, 4.0, y));
            if (y > -4 && y < 10) units.add(new Unit("Wall", UnitType.WALL, -4.0, y));
        }
        // Felsen als zusätzliche Hindernisse
        units.add(new Unit("Boulder", UnitType.BOULDER, 2.0, 2.0));
        units.add(new Unit("Boulder", UnitType.BOULDER, -2.0, 2.0));
    }

    public boolean isPassable(double targetX, double targetY, Unit movingUnit) {
        for (Unit u : units) {
            if (u == movingUnit) continue;
            if (u.type == UnitType.WALL || u.type == UnitType.BOULDER || u.type == UnitType.GATE) {
                double dist = Math.hypot(targetX - u.worldX, targetY - u.worldY);
                if (dist < COLLISION_RADIUS) return false;
            }
        }
        return true;
    }

    public synchronized void step() {
        if (gameState != GameState.PLAYING) return;
        currentIteration++;

        Unit player = getPlayer();
        Unit skrall = getSkrall();

        // Skrall-KI mit Kollisionsvermeidung (einfaches Gleiten an Wänden)
        if (skrall != null && player != null) {
            double dx = player.worldX - skrall.worldX;
            double dy = player.worldY - skrall.worldY;
            double dist = Math.hypot(dx, dy);

            if (dist > 0.1) {
                double speed = 0.08; 
                double nextX = skrall.worldX + (dx / dist) * speed;
                double nextY = skrall.worldY + (dy / dist) * speed;

                boolean canMoveX = isPassable(nextX, skrall.worldY, skrall);
                boolean canMoveY = isPassable(skrall.worldX, nextY, skrall);

                if (canMoveX && canMoveY && isPassable(nextX, nextY, skrall)) {
                    skrall.worldX = nextX;
                    skrall.worldY = nextY;
                } else if (canMoveX) {
                    skrall.worldX = nextX; // An der X-Achse entlang gleiten
                } else if (canMoveY) {
                    skrall.worldY = nextY; // An der Y-Achse entlang gleiten
                }
            }

            if (dist < 0.6) {
                gameState = GameState.GAME_OVER;
                running = false;
            }
        }

        // Spieler-Interaktionen (Münzen & Tor)
        if (player != null) {
            List<Unit> toRemove = new ArrayList<>();
            for (Unit u : units) {
                double dist = Math.hypot(player.worldX - u.worldX, player.worldY - u.worldY);

                if (u.type == UnitType.DIAMOND && dist < 0.8) {
                    toRemove.add(u);
                    collectedCoins++;
                } else if (u.type == UnitType.GATE && dist < 1.0) {
                    if (collectedCoins >= totalCoins) {
                        gameState = GameState.WON;
                        running = false;
                    }
                }
            }
            units.removeAll(toRemove);
        }
    }

    public void exportStateForAI() {
        System.out.println("--- MATRIXGAME STATE EXPORT (Iteration " + currentIteration + ") ---");
        System.out.println("GameState: " + gameState);
        System.out.println("Coins: " + collectedCoins + " / " + totalCoins);
        for (Unit u : units) {
            if (u.type == UnitType.WALL) continue; // Wände ausblenden um Log kurz zu halten
            System.out.printf("Entity: %-15s | Type: %-12s | X: %7.2f | Y: %7.2f\n", u.name, u.type, u.worldX, u.worldY);
        }
        System.out.println("---------------------------------------------------");
    }

    public void runLoop() {
        while (true) {
            if (running) step();
            try { Thread.sleep(tickRateMs); } catch (InterruptedException e) { Thread.currentThread().interrupt(); break; }
        }
    }

    public Unit getPlayer() { return units.stream().filter(u -> u.type == UnitType.PLAYER).findFirst().orElse(null); }
    public Unit getSkrall() { return units.stream().filter(u -> u.type == UnitType.ENEMY_SKRALL).findFirst().orElse(null); }
    public boolean isRunning() { return running; }
    public void setRunning(boolean running) { if (gameState == GameState.PLAYING) this.running = running; }
    public int getCurrentIteration() { return currentIteration; }
    public GameState getGameState() { return gameState; }
    public int getCollectedCoins() { return collectedCoins; }
    public int getTotalCoins() { return totalCoins; }
    public List<Unit> getAllUnits() { return units; }
    public void addUnit(Unit u) { units.add(u); }
}

class Unit {
    public String name;
    public UnitType type;
    public double worldX, worldY;

    public Unit(String name, UnitType type, double worldX, double worldY) {
        this.name = name; this.type = type; this.worldX = worldX; this.worldY = worldY;
    }
}

