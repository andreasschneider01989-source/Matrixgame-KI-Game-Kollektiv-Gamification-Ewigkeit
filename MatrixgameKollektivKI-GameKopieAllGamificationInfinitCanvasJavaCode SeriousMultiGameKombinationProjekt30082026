    private void updateLogic(double dt) {
        // Direkte WASD Steuerung überschreibt Zielkoordinaten für Spieler
        double dx = 0, dy = 0;
        if (keys.getOrDefault(KeyEvent.VK_W, false)) dy -= 1;
        if (keys.getOrDefault(KeyEvent.VK_S, false)) dy += 1;
        if (keys.getOrDefault(KeyEvent.VK_A, false)) dx -= 1;
        if (keys.getOrDefault(KeyEvent.VK_D, false)) dx += 1;

        GameObjekt7 gravityWell = null;
        for (GameObjekt7 e : entities) if (e.type.equals("FIELD")) gravityWell = e;

        for (GameObjekt7 e : entities) {
            if (!e.active) continue;

            if (e.team.equals("PLAYER") && (dx != 0 || dy != 0)) {
                e.targetX = e.x;
                e.targetY = e.y;
                double len = Math.hypot(dx, dy);
                e.vx += (dx / len) * e.speed * dt;
                e.vy += (dy / len) * e.speed * dt;
            }

            // Gravitationsfeld (F = G / r^2)
            if (gravityWell != null && (e.team.equals("PLAYER") || e.team.equals("ENEMY"))) {
                double dX = gravityWell.x - e.x;
                double dY = gravityWell.y - e.y;
                double dist = Math.hypot(dX, dY);
                if (dist > 0.5 && dist < 8.0) {
                    double force = 25.0 / (dist * dist);
                    e.vx += (dX / dist) * force * dt;
                    e.vy += (dY / dist) * force * dt;
                }
            }

            e.update(dt, entities);
        }

        // Kollisionen (Coins einsammeln)
        List<GameObjekt7> players = new ArrayList<>();
        for (GameObjekt7 e : entities) if (e.team.equals("PLAYER") && e.active) players.add(e);

        for (GameObjekt7 e : entities) {
            if (!e.active || !e.type.equals("COIN")) continue;
            for (GameObjekt7 p : players) {
                if (Math.hypot(e.x - p.x, e.y - p.y) < e.radius + p.radius) {
                    e.active = false;
                    coinsCollected++;
                }
            }
        }

        // Siegbedingung
        if (coinsCollected >= totalCoins) {
            GameObjekt7 gate = null;
            for (GameObjekt7 e : entities) if (e.type.equals("GATE")) gate = e;
            if (gate != null) {
                for (GameObjekt7 p : players) {
                    if (Math.hypot(gate.x - p.x, gate.y - p.y) < 2.0) victory = true;
                }
            }
        }
    }

