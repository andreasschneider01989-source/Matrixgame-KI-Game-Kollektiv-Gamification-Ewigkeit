            this.radius = Math.max(width, height) / 2.0;
            this.color = color;
        }
    }

    // --- GAME ENGINE STATE ---
    private List<Entity> entities = new ArrayList<>();
    private int coinsCollected = 0;
    private int totalCoins = 15;
    private boolean isVictory = false;
    private Entity gate;

    // --- INFINITY CANVAS & SELECTION ---
    private double cameraX = 0;
    private double cameraY = 0;
    private double zoom = 1.0;
    private Point lastMousePos;
    
    private Point selectionStart = null;
    private Point selectionEnd = null;
    private Rectangle selectionBox = null;

    private CanvasPanel canvasPanel;
    private Timer gameTimer;

    public MatrixgameLevel7() {
        setTitle("Matrixgame - Level 7 Engine");
        setSize(1200, 800);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);

        initLevel7Data();

        canvasPanel = new CanvasPanel();
        add(canvasPanel, BorderLayout.CENTER);

        setupControls();

        gameTimer = new Timer(33, e -> updateGameLogic());
        gameTimer.start();
    }

    private void initLevel7Data() {
        entities.clear();
        coinsCollected = 0;
        isVictory = false;

        Color unitColor = new Color(150, 150, 255);
        entities.add(new Entity("Unit_1", EntityType.PLAYER_UNIT, -4.0, -2.0, 0.8, unitColor));
        entities.add(new Entity("Unit_2", EntityType.PLAYER_UNIT, -2.0, -5.0, 0.8, unitColor));
        entities.add(new Entity("Unit_3", EntityType.PLAYER_UNIT, -6.0, -5.0, 0.8, unitColor));

        gate = new Entity("Exit_Gate", EntityType.GATE, 15.0, 10.0, 1.5, new Color(255, 50, 50));
        entities.add(gate);

        Color wallColor = new Color(50, 60, 75);
        entities.add(new Entity("Wall_1", EntityType.WALL, -10.0, 0.0, 2.0, 20.0, wallColor));
        entities.add(new Entity("Wall_2", EntityType.WALL, 10.0, 5.0, 2.0, 15.0, wallColor));
        entities.add(new Entity("Wall_3", EntityType.WALL, 0.0, -12.0, 30.0, 2.0, wallColor));
        entities.add(new Entity("Wall_4", EntityType.WALL, 0.0, 18.0, 30.0, 2.0, wallColor));

        double[][] coinPositions = {
            {-6, 4}, {-3, 8}, {2, 2}, {5, -5}, {12, -8},
            {-15, -5}, {-14, 10}, {8, 12}, {14, -2}, {-2, -8},
            {4, 14}, {-8, -10}, {16, 5}, {-12, 14}, {0, 6}
        };
        for (int i = 0; i < coinPositions.length; i++) {
            entities.add(new Entity("Coin_" + i, EntityType.COIN, coinPositions[i][0], coinPositions[i][1], 0.5, Color.YELLOW));
        }
    }

    private void setupControls() {
        KeyListener keyControls = new KeyAdapter() {
            @Override
            public void keyPressed(KeyEvent e) {
                if (isVictory) return;

                double speed = 0.5;
                double dx = 0, dy = 0;

                if (e.getKeyCode() == KeyEvent.VK_W || e.getKeyCode() == KeyEvent.VK_UP) dy += speed;
                if (e.getKeyCode() == KeyEvent.VK_S || e.getKeyCode() == KeyEvent.VK_DOWN) dy -= speed;
                if (e.getKeyCode() == KeyEvent.VK_A || e.getKeyCode() == KeyEvent.VK_LEFT) dx -= speed;
                if (e.getKeyCode() == KeyEvent.VK_D || e.getKeyCode() == KeyEvent.VK_RIGHT) dx += speed;

                if (dx != 0 || dy != 0) {
                    moveSelectedUnits(dx, dy);
                    canvasPanel.repaint();
                }
            }
        };

        this.addKeyListener(keyControls);
        canvasPanel.addKeyListener(keyControls);
        canvasPanel.setFocusable(true);
        canvasPanel.requestFocusInWindow();
    }

    private void moveSelectedUnits(double dx, double dy) {
        for (Entity e : entities) {
            if (e.type == EntityType.PLAYER_UNIT && e.selected && e.active) {
                double nextX = e.x + dx;
                double nextY = e.y + dy;
                boolean collision = false;

                for (Entity wall : entities) {
                    if (wall.type == EntityType.WALL && wall.active) {
                        if (checkRectCircleCollision(wall, nextX, nextY, e.radius)) {
                            collision = true;
                            break;
                        }
                    }
                }

                if (!collision) {
                    e.x = nextX;
                    e.y = nextY;
                }
            }
        }
    }

    private boolean checkRectCircleCollision(Entity rect, double cx, double cy, double cradius) {
        double halfW = rect.width / 2.0;
        double halfH = rect.height / 2.0;
        double closestX = Math.max(rect.x - halfW, Math.min(cx, rect.x + halfW));
        double closestY = Math.max(rect.y - halfH, Math.min(cy, rect.y + halfH));
        double distanceX = cx - closestX;
        double distanceY = cy - closestY;
        return (distanceX * distanceX + distanceY * distanceY) < (cradius * cradius);
    }

    private void updateGameLogic() {
        if (isVictory) return;

        for (Entity p : entities) {
            if (p.type == EntityType.PLAYER_UNIT && p.active) {
                
                for (Entity c : entities) {
                    if (c.type == EntityType.COIN && c.active) {
                        double dist = Math.sqrt(Math.pow(p.x - c.x, 2) + Math.pow(p.y - c.y, 2));
                        if (dist < (p.radius + c.radius)) {
                            c.active = false;
                            coinsCollected++;
                        }
                    }
                }

                double distGate = Math.sqrt(Math.pow(p.x - gate.x, 2) + Math.pow(p.y - gate.y, 2));
                if (distGate < (p.radius + gate.radius) && coinsCollected >= totalCoins) {
                    isVictory = true;
                }
            }
        }

        if (coinsCollected >= totalCoins) {
            gate.color = new Color(0, 150, 255); 
        }

        canvasPanel.repaint();
    }

    private class CanvasPanel extends JPanel {
        public CanvasPanel() {
            setBackground(new Color(10, 12, 16));

            MouseAdapter adapter = new MouseAdapter() {
                @Override
                public void mousePressed(MouseEvent e) {
                    canvasPanel.requestFocusInWindow();
                    lastMousePos = e.getPoint();

                    if (SwingUtilities.isLeftMouseButton(e)) {
                        selectionStart = e.getPoint();
                        selectionEnd = selectionStart;
                        selectionBox = new Rectangle(selectionStart);
                    }
                }

                @Override
                public void mouseDragged(MouseEvent e) {
                    if (SwingUtilities.isRightMouseButton(e) || SwingUtilities.isMiddleMouseButton(e)) {
                        int dx = e.getX() - lastMousePos.x;
                        int dy = e.getY() - lastMousePos.y;
                        cameraX += dx;
                        cameraY += dy;
                        lastMousePos = e.getPoint();
                    } 
                    else if (SwingUtilities.isLeftMouseButton(e)) {
                        selectionEnd = e.getPoint();
                        int x = Math.min(selectionStart.x, selectionEnd.x);
                        int y = Math.min(selectionStart.y, selectionEnd.y);
                        int w = Math.abs(selectionStart.x - selectionEnd.x);
                        int h = Math.abs(selectionStart.y - selectionEnd.y);
                        selectionBox = new Rectangle(x, y, w, h);
                    }
                    repaint();
                }

                @Override
                public void mouseReleased(MouseEvent e) {
                    if (SwingUtilities.isLeftMouseButton(e) && selectionBox != null) {
                        applySelectionBox();
                        selectionBox = null;
                        selectionStart = null;
                        selectionEnd = null;
                        repaint();
                    }
                }

                @Override
                public void mouseWheelMoved(MouseWheelEvent e) {
                    if (e.getWheelRotation() < 0) zoom *= 1.1;
                    else zoom /= 1.1;
                    zoom = Math.max(0.2, Math.min(zoom, 5.0));
                    repaint();
                }
            };

            addMouseListener(adapter);
            addMouseMotionListener(adapter);
            addMouseWheelListener(adapter);
        }

        private void applySelectionBox() {
            int cx = getWidth() / 2 + (int) cameraX;
            int cy = getHeight() / 2 + (int) cameraY;

            boolean boxIsClick = selectionBox.width < 5 && selectionBox.height < 5;

            for (Entity ent : entities) {
                if (ent.type != EntityType.PLAYER_UNIT || !ent.active) continue;

                int screenX = cx + (int) (ent.x * 30 * zoom);
                int screenY = cy - (int) (ent.y * 30 * zoom);
                int r = (int) (ent.radius * 30 * zoom);
                
                Rectangle2D.Double entityBounds = new Rectangle2D.Double(screenX - r, screenY - r, r * 2, r * 2);

                if (selectionBox.intersects(entityBounds)) {
                    ent.selected = true;
                } else if (!boxIsClick) {
                    ent.selected = false;
                } else if (boxIsClick) {
                     ent.selected = false; 
                }
            }
            
            if(boxIsClick) {
                 for (Entity ent : entities) {
                     if (ent.type != EntityType.PLAYER_UNIT || !ent.active) continue;
                     int screenX = cx + (int) (ent.x * 30 * zoom);
                     int screenY = cy - (int) (ent.y * 30 * zoom);
                     double dist = Math.sqrt(Math.pow(selectionStart.x - screenX, 2) + Math.pow(selectionStart.y - screenY, 2));
                     if(dist <= (ent.radius * 30 * zoom)) {
                         ent.selected = true;
                         break; 
                     }
                 }
            }
        }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2 = (Graphics2D) g;
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            int cx = getWidth() / 2 + (int) cameraX;
            int cy = getHeight() / 2 + (int) cameraY;

            g2.setColor(new Color(25, 30, 45, 100));
            int gridSize = (int) (30 * zoom);
            for (int x = cx % gridSize; x < getWidth(); x += gridSize) g2.drawLine(x, 0, x, getHeight());
            for (int y = cy % gridSize; y < getHeight(); y += gridSize) g2.drawLine(0, y, getWidth(), y);

            g2.setColor(new Color(50, 60, 80));
            g2.drawLine(cx, 0, cx, getHeight());
            g2.drawLine(0, cy, getWidth(), cy);

            for (Entity e : entities) {
                if (!e.active) continue;

                int screenX = cx + (int) (e.x * 30 * zoom);
                int screenY = cy - (int) (e.y * 30 * zoom);
                g2.setColor(e.color);

                if (e.type == EntityType.WALL) {
                    int w = (int) (e.width * 30 * zoom);
                    int h = (int) (e.height * 30 * zoom);
                    g2.fillRect(screenX - w / 2, screenY - h / 2, w, h);
                } else {
                    int r = (int) (e.radius * 30 * zoom);
                    g2.fillOval(screenX - r, screenY - r, r * 2, r * 2);
                    
                    if (e.selected) {
                        g2.setColor(Color.GREEN);
                        g2.fillRect(screenX - r, screenY - r - 10, r * 2, 4);
                    }
                }
            }

            if (selectionBox != null) {
                g2.setColor(new Color(0, 255, 0, 50));
                g2.fill(selectionBox);
                g2.setColor(Color.GREEN);
                g2.draw(selectionBox);
            }

            g2.setFont(new Font("Consolas", Font.BOLD, 18));
            g2.setColor(Color.CYAN);
            g2.drawString("--- MATRIXGAME LEVEL 7 ---", 20, 30);
            g2.drawString(String.format("Coins: %d / %d", coinsCollected, totalCoins), 20, 60);
            
            if (coinsCollected >= totalCoins) {
                g2.setColor(Color.GREEN);
                g2.drawString("Tor ist offen! Erreiche das blaue Gate.", 20, 90);
            }

            if (isVictory) {
                g2.setFont(new Font("Consolas", Font.BOLD, 48));
                g2.setColor(Color.GREEN);
                String vicText = "VICTORY - LEVEL 7 ABGESCHLOSSEN";
                int textW = g2.getFontMetrics().stringWidth(vicText);
                g2.drawString(vicText, (getWidth() - textW) / 2, getHeight() / 2);
            }
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            new MatrixgameLevel7().setVisible(true);
        });
    }
