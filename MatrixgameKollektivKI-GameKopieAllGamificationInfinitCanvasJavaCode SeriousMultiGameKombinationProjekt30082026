// --- BASISELEMENT: KREISOBJEKT ---
class KreisObjekt {
    double size;
    double red, green, blue;
    double posX, posY, posZ;
    double vx, vy, vz;
    public boolean isSelected = false;

    public KreisObjekt(double size, double red, double green, double blue, double posX, double posY, double posZ, double vx, double vy, double vz) {
        this.size = size;
        this.red = red;
        this.green = green;
        this.blue = blue;
        this.posX = posX;
        this.posY = posY;
        this.posZ = posZ;
        this.vx = vx;
        this.vy = vy;
        this.vz = vz;
    }

    public KreisObjekt() {
        this(10.0, 200, 200, 200, 0, 0, 0, 0, 0, 0);
    }

    public void move(double dt) {
        this.posX += this.vx * dt;
        this.posY += this.vy * dt;
        this.posZ += this.vz * dt;
    }
}

// --- EINHEITEN-KLASSE MIT OPTIMIERTER LOGIK ---
class Unit extends KreisObjekt {
    double maxLeben, leben, damage, distance, speed;
    int team, kills;
    double points1, points2, points3, points4;
    double konstruktionszeit = System.currentTimeMillis();
    
    public String decisionAlgorithm = "NEAREST_ENEMY";
    public Double targetPosX = null, targetPosY = null, targetPosZ = null;
    public Unit manualTarget = null;
    double id;

    public Unit(double id, int team, double x, double y, double z, double leben, double damage, double speed, double distance) {
        super(10.0, team == 1 ? 0 : 255, team == 1 ? 255 : 50, team == 1 ? 100 : 50, x, y, z, 0, 0, 0);
        this.id = id;
        this.team = team;
        this.leben = leben;
        this.maxLeben = leben;
        this.damage = damage;
        this.speed = speed;
        this.distance = distance;
        this.points1 = leben / 5 + damage + speed / 50;
        this.points2 = points1 * 2;
    }

    public void moveTo(double targetX, double targetY, double targetZ, double speedFactor) {
        double dx = targetX - posX;
        double dy = targetY - posY;
        double dz = targetZ - posZ;
        double dist = Math.sqrt(dx * dx + dy * dy + dz * dz);
        if (dist < 0.001) return;

        double movDist = Math.min(speedFactor, speed);
        vx = (dx / dist) * movDist;
        vy = (dy / dist) * movDist;
        vz = (dz / dist) * movDist;
    }

    public double getDistance(KreisObjekt o) {
        double dx = this.posX - o.posX;
        double dy = this.posY - o.posY;
        double dz = this.posZ - o.posZ;
        return Math.sqrt(dx * dx + dy * dy + dz * dz);
    }

    public void printReport(int zeitSchritt) {
        System.out.printf("[EVENT %d ms | Schritt %d] Unit ID %.0f (Team %d) | Pos: (%.1f, %.1f, %.1f) | HP: %.2f/%.2f%n",
                System.currentTimeMillis(), zeitSchritt, id, team, posX, posY, posZ, leben, maxLeben);
    }
}

