        Color color;

        public Entity(String name, EntityType type, int gridX, int gridY, Color color) {
            this.name = name;
            this.type = type;
            this.gridX = gridX;
            this.gridY = gridY;
            this.color = color;
        }
    }

    // --- ENGINE STATE ---
    private String gameId = "MG-GO-TEST-002";
    private int iteration = 831;
    private List<Entity> entities = new ArrayList<>();
    private char[][] board; 
    private int boardSizeX = 20;
    private int boardSizeY = 20;
    private int tileSize = 40;
    
    private Entity player;

    // --- INFINITY CANVAS CAMERA ---
    private int cameraX = 0;
    private int cameraY = 0;

    public MatrixGame() {
        setTitle("Matrixgame Engine - Infinity Canvas & Flood-Fill [Guardian-Modus]");
        setSize(800, 600);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);

        initializeLogic();

        GameCanvas canvas = new GameCanvas();
        add(canvas);
        
        // Tastatursteuerung für Infinity Canvas & Bewegung
        addKeyListener(new KeyAdapter() {
            @Override
            public void keyPressed(KeyEvent e) {
                int key = e.getKeyCode();
                if (key == KeyEvent.VK_W || key == KeyEvent.VK_UP) player.gridY--;
                if (key == KeyEvent.VK_S || key == KeyEvent.VK_DOWN) player.gridY++;
                if (key == KeyEvent.VK_A || key == KeyEvent.VK_LEFT) player.gridX--;
                if (key == KeyEvent.VK_D || key == KeyEvent.VK_RIGHT) player.gridX++;
                
                // Kamera zentriert sich auf den Spieler
                cameraX = (getWidth() / 2) - (player.gridX * tileSize);
                cameraY = (getHeight() / 2) - (player.gridY * tileSize);
                
