// --- GAME LOOP & PHYSICS UPDATE ---
let lastTime = performance.now();

function loop(currentTime) {
    const dt = Math.min((currentTime - lastTime) / 1000, 0.1);
    lastTime = currentTime;

    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Render Grid Background
    const gridStep = camera.zoom * 2;
    ctx.strokeStyle = '#151525';
    ctx.beginPath();
    for (let x = (camera.x + canvas.width/2) % gridStep; x < canvas.width; x += gridStep) {
        ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height);
    }
    for (let y = (camera.y + canvas.height/2) % gridStep; y < canvas.height; y += gridStep) {
        ctx.moveTo(0, y); ctx.lineTo(canvas.width, y);
    }
    ctx.stroke();

    // Gravity Well Physics Field: F = G / r^2
    const well = gameState.entities.find(e => e.type === 'GRAVITY_WELL');
    if (well) {
        gameState.entities.forEach(e => {
            if (e.team === 'PLAYER' || e.team === 'ENEMY') {
                const dx = well.x - e.x;
                const dy = well.y - e.y;
                const dist = Math.hypot(dx, dy);
                if (dist > 0.5 && dist < 8.0) {
                    const force = 12.0 / (dist * dist);
                    e.vx += (dx / dist) * force * dt;
                    e.vy += (dy / dist) * force * dt;
                }
            }
        });
    }

    // Update Entities & Collisions
    const players = gameState.entities.filter(e => e.team === 'PLAYER' && e.hp > 0);

    gameState.entities.forEach(e => {
        if (!e.active) return;
        e.update(dt);

        // Interaction Check with Players
        players.forEach(p => {
            const dist = Math.hypot(e.x - p.x, e.y - p.y);
            if (dist < e.radius + p.radius) {
                if (e.type === 'COIN') {
                    e.active = false;
                    gameState.coinsCollected++;
                    gameState.xp += 100;
                } else if (e.type === 'SWITCH' && e.team === 'NEUTRAL') {
                    e.team = 'PLAYER';
                    gameState.nodesActivated++;
                    gameState.xp += 250;
                }
            }
        });

        e.draw(ctx);
    });

    // Check Victory Condition
    if (gameState.coinsCollected >= gameState.totalCoins && gameState.nodesActivated >= gameState.totalNodes) {
        gameState.gateOpen = true;
    }

    const gate = gameState.entities.find(e => e.type === 'GATE');
    if (gate && gameState.gateOpen) {
        const pAtGate = players.find(p => Math.hypot(p.x - gate.x, p.y - gate.y) < 1.5);
        if (pAtGate) {
            document.getElementById('msg').className = 'status-ok';
            document.getElementById('msg').innerText = 'VICTORY! LEVEL 7 ERFOLGREICH ABGESCHLOSSEN!';
        }
    }

    // UI Updates
    const aliveSquad = players.length;
    document.getElementById('stats').innerText = `XP: ${gameState.xp} | Coins: ${gameState.coinsCollected}/${gameState.totalCoins} | Nodes: ${gameState.nodesActivated}/${gameState.totalNodes}`;
    document.getElementById('squad').innerText = `Squad Active: ${aliveSquad} Units`;

    requestAnimationFrame(loop);
}

initLevel7();
requestAnimationFrame(loop);
