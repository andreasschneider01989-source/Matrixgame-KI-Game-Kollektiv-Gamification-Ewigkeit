class ControlPanel extends JPanel {
    public ControlPanel(SimulationEngine engine, InfinityCanvas canvas) {
        setBackground(new Color(50, 50, 70));

        JButton playPauseBtn = new JButton("Play / Pause");
        playPauseBtn.addActionListener(e -> engine.setRunning(!engine.isRunning()));

        JButton stepBtn = new JButton("Einzelschritt (+1 Iteration)");
        stepBtn.addActionListener(e -> {
            engine.step();
            canvas.repaint();
        });

        JButton copyBtn = new JButton("Copy Unit");
        copyBtn.addActionListener(e -> {
            if (canvas.getSelectedUnit() != null) {
                canvas.setClipboardUnit(canvas.getSelectedUnit().cloneUnit());
            }
        });

        JButton pasteBtn = new JButton("Paste Unit (0,0)");
        pasteBtn.addActionListener(e -> {
            if (canvas.getClipboardUnit() != null) {
                engine.setUnitAt(0, 0, canvas.getClipboardUnit().cloneUnit());
                canvas.repaint();
            }
        });

        add(playPauseBtn);
        add(stepBtn);
        add(copyBtn);
        add(pasteBtn);
    }
}

class PropertyPanel extends JPanel {
    private InfinityCanvas canvas;
    private JLabel infoLabel;

    public PropertyPanel(InfinityCanvas canvas) {
        this.canvas = canvas;
        setPreferredSize(new Dimension(250, getHeight()));
        setBackground(new Color(40, 40, 50));
        infoLabel = new JLabel("<html><font color='white'>Keine Einheit gewählt</font></html>");
        add(infoLabel);

        // Timer um Eigenschaften live anzuzeigen
        Timer updateTimer = new Timer(100, e -> updateProperties());
        updateTimer.start();
    }

    private void updateProperties() {
        Unit u = canvas.getSelectedUnit();
        if (u != null) {
            infoLabel.setText(String.format(
                "<html><font color='white'>" +
                "<b>Name:</b> %s<br>" +
                "<b>Typ:</b> %s<br>" +
                "<b>X (Double):</b> %.2f<br>" +
                "<b>Y (Double):</b> %.2f<br>" +
                "<b>Var A:</b> %.2f<br>" +
                "<b>Var B:</b> %.2f" +
                "</font></html>",
                u.name, u.type, u.worldX, u.worldY, u.customVarA, u.customVarB
            ));
        }
    }
}

