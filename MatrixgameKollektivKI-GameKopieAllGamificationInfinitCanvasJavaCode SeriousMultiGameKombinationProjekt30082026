import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.List;

public class MatrixgameLevel2 extends JFrame {

    // --- ENTITY TYPES & DATA STRUCTURES ---
    public enum EntityType { PLAYER, SKRALL, COIN, BOULDER, GATE, SWITCH }

    public static class Entity {
        String name;
        EntityType type;
        double x, y; // Weltkoordinaten
        double radius;
        Color color;
        boolean active = true;
        boolean triggered = false; // Für Switches

        public Entity(String name, EntityType type, double x, double y, double radius, Color color) {
            this.name = name;
            this.type = type;
            this.x = x;
            this.y = y;
            this.radius = radius;
            this.color = color;
        }
    }

    // --- ENGINE STATE ---
    private List<Entity> entities = new ArrayList<>();
    private Entity player;
    private Entity skrall;
    private Entity gate;
    
    private int coinsCollected = 0;
    private int totalCoins = 8;
    private int switchesActivated = 0;
    private int totalSwitches = 2;
    private boolean isPlaying = false;
    private Entity selectedEntity = null;

    // --- INFINITY CANVAS (TRANSFORMATION) ---
    private double cameraX = 0;
    private double cameraY = 0;
    private double zoom = 1.0;
    private Point lastMousePos;

    // --- UI & TIMERS ---
    private CanvasPanel canvasPanel;
    private JLabel lblName, lblType, lblX, lblY, lblRadius;
    private Timer gameTimer;

    public MatrixgameLevel2() {
        setTitle("Matrixgame - Level 2: Lumini-Knoten & Gravitations-Sperre");
        setSize(1200, 800);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);

        initLevel2Data();
        setupUI();

        // 30 FPS Game Loop
        gameTimer = new Timer(33, e -> updateGameLogic());
        gameTimer.start();
    }

    private void initLevel2Data() {
        entities.clear();
        coinsCollected = 0;
        switchesActivated = 0;
        
        player = new Entity("Player", EntityType.PLAYER, -14.0, 0.0, 0.85, new Color(0, 200, 255));
        skrall = new Entity("Skrall_v2", EntityType.SKRALL, 10.0, 8.0, 0.95, new Color(255, 50, 50));
        gate = new Entity("Exit_Gate", EntityType.GATE, 16.0, -10.0, 1.2, new Color(255, 60, 60)); // Anfeine rot gesperrt

        entities.add(player);
        entities.add(skrall);
        entities.add(gate);

        // Lumini-Schaltknoten (Switches)
        entities.add(new Entity("Lumini_Node_Alpha", EntityType.SWITCH, -8.0, 6.0, 0.7, new Color(0, 255, 255)));
        entities.add(new Entity("Lumini_Node_Beta", EntityType.SWITCH, 6.0, -8.0, 0.7, new Color(0, 255, 255)));

        // 8 Entropie-Münzen
        double[][] coinCoords = {
            {-10, 2}, {-5, 7}, {0, 4}, {4, 6},
            {-2, -5}, {3, -3}, {10, -2}, {12, -7}
        };
        for (int i = 0; i < coinCoords.length; i++) {
            entities.add(new Entity("Coin_" + (i + 1), EntityType.COIN, coinCoords[i][0], coinCoords[i][1], 0.5, Color.YELLOW));
        }

        // Verschiebbare Festonen (Boulders) als Barrikaden
        entities.add(new Entity("Boulder_1", EntityType.BOULDER, -2.0, 1.0, 0.8, Color.GRAY));
        entities.add(new Entity("Boulder_2", EntityType.BOULDER, 2.0, -2.0, 0.8, Color.GRAY));
        entities.add(new Entity("Boulder_3", EntityType.BOULDER, 8.0, 2.0, 0.8, Color.GRAY));

        selectedEntity = player;
    }

    private void setupUI() {
        setLayout(new BorderLayout());

        // 1. TOP TOOLBAR
        JPanel toolbar = new JPanel(new FlowLayout(FlowLayout.CENTER, 10, 5));
        toolbar.setBackground(new Color(30, 35, 45));

        JButton btnPlay = createStyledButton("Start / Jagen (Play)");
        JButton btnPause = createStyledButton("Pause");
        JButton btnRestart = createStyledButton("Level 2 Neustart");
        JButton btnExport = createStyledButton("State für KI exportieren");
        JButton btnAddBoulder = createStyledButton("+ Barrikade spawnen");

        btnPlay.addActionListener(e -> isPlaying = true);
        btnPause.addActionListener(e -> isPlaying = false);
        btnRestart.addActionListener(e -> { isPlaying = false; initLevel2Data(); updateInspector(); canvasPanel.repaint(); });
        btnExport.addActionListener(e -> System.out.println(exportGameState()));

        btnAddBoulder.addActionListener(e -> {
            entities.add(new Entity("Boulder_Dynamic", EntityType.BOULDER, player.x + 2.0, player.y + 2.0, 0.8, Color.GRAY));
            canvasPanel.repaint();
        });

        toolbar.add(btnPlay);
        toolbar.add(btnPause);
        toolbar.add(btnRestart);
        toolbar.add(btnExport);
        toolbar.add(btnAddBoulder);
        add(toolbar, BorderLayout.NORTH);

        // 2. CENTER INFINITY CANVAS
        canvasPanel = new CanvasPanel();
        add(canvasPanel, BorderLayout.CENTER);

        // 3. RIGHT OBJEKT-INSPECTOR
        JPanel inspectorPanel = new JPanel();
        inspectorPanel.setPreferredSize(new Dimension(220, 0));
        inspectorPanel.setBackground(new Color(22, 24, 30));
        inspectorPanel.setLayout(new BoxLayout(inspectorPanel, BoxLayout.Y_AXIS));
        inspectorPanel.setBorder(BorderFactory.createEmptyBorder(15, 15, 15, 15));

        JLabel title = new JLabel("Objekt-Inspector");
        title.setFont(new Font("Consolas", Font.BOLD, 14));
        title.setForeground(Color.LIGHT_GRAY);
        inspectorPanel.add(title);
        inspectorPanel.add(Box.createRigidArea(new Dimension(0, 15)));

        lblName = createInspectorLabel("Name: -");
        lblType = createInspectorLabel("Typ: -");
        lblX = createInspectorLabel("Welt-X: -");
        lblY = createInspectorLabel("Welt-Y: -");
        lblRadius = createInspectorLabel("Kollisionsradius: -");

        inspectorPanel.add(lblName);
        inspectorPanel.add(lblType);
        inspectorPanel.add(lblX);
        inspectorPanel.add(lblY);
        inspectorPanel.add(lblRadius);

        add(inspectorPanel, BorderLayout.EAST);

        // Keyboard Movement & Physics Handling
        addKeyListener(new KeyAdapter() {
            @Override
            public void keyPressed(KeyEvent e) {
                double speed = 0.45;
                double dx = 0, dy = 0;
                
                if (e.getKeyCode() == KeyEvent.VK_W || e.getKeyCode() == KeyEvent.VK_UP) dy += speed;
                if (e.getKeyCode() == KeyEvent.VK_S || e.getKeyCode() == KeyEvent.VK_DOWN) dy -= speed;
                if (e.getKeyCode() == KeyEvent.VK_A || e.getKeyCode() == KeyEvent.VK_LEFT) dx -= speed;
                if (e.getKeyCode() == KeyEvent.VK_D || e.getKeyCode() == KeyEvent.VK_RIGHT) dx += speed;

                movePlayerAndHandlePhysics(dx, dy);
                checkCollisions();
                updateInspector();
                canvasPanel.repaint();
            }
        });

        setFocusable(true);
        updateInspector();
    }

    private void movePlayerAndHandlePhysics(double dx, double dy) {
        double nextX = player.x + dx;
        double nextY = player.y + dy;

        // Verschieben von Festonen (Boulders)
        for (Entity e : entities) {
            if (e.type == EntityType.BOULDER && e.active) {
                double dist = Math.sqrt(Math.pow(nextX - e.x, 2) + Math.pow(nextY - e.y, 2));
                if (dist < (player.radius + e.radius)) {
                    // Schiebe den Boulder in Bewegungsrichtung weg
                    e.x += dx * 0.8;
                    e.y += dy * 0.8;
                }
            }
        }

        player.x = nextX;
        player.y = nextY;
    }

