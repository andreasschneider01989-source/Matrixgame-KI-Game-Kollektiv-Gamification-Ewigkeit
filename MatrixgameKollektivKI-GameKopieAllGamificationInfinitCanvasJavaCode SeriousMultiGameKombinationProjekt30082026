                double nextY = e.y + dy;
                boolean collision = false;

                // Check collision against walls for THIS specific unit
                for (Entity wall : entities) {
                    if (wall.type == EntityType.WALL && wall.active) {
                        if (checkRectCircleCollision(wall, nextX, nextY, e.radius)) {
                            collision = true;
                            break;
