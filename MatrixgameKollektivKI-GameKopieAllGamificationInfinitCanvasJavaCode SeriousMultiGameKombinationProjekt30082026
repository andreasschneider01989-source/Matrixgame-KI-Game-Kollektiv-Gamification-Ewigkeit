            int y = (int) (centerY + (i + zoomCenterY) * (zoomFactor / 10));
            g2.drawLine(x, 0, x, getHeight());
            g2.drawLine(0, y, getWidth(), y);
        }

        // Zeichnen aller Spielobjekte mit Z-Projektion
        for (Unit u : unitList) {
            // Z-Achsen-Projektion: Radius skaliert mit Höhe (posZ)
            double zScale = 1.0 + (u.posZ / 150.0);
            double effectiveRadius = Math.max(4.0, u.size * Math.max(0.3, zScale));

            double sx = centerX + (u.posX + zoomCenterX) * zoomFactor;
            double sy = centerY + (u.posY + zoomCenterY) * zoomFactor;

            // Ausgewählte Einheiten hervorheben
            if (u.isSelected) {
                g2.setColor(Color.YELLOW);
                g2.drawOval((int) (sx - effectiveRadius - 4), (int) (sy - effectiveRadius - 4),
                            (int) (effectiveRadius * 2 + 8), (int) (effectiveRadius * 2 + 8));
            }

            // Haupt-Körper
            g2.setColor(new Color((int) u.red, (int) u.green, (int) u.blue));
            g2.fillOval((int) (sx - effectiveRadius), (int) (sy - effectiveRadius),
                        (int) (effectiveRadius * 2), (int) (effectiveRadius * 2));

            // Lebensbalken über der Einheit
            if (u.team != 0) {
                int barWidth = 30;
                int barHeight = 4;
                int barX = (int) (sx - barWidth / 2);
                int barY = (int) (sy - effectiveRadius - 10);
                
                g2.setColor(Color.RED);
                g2.fillRect(barX, barY, barWidth, barHeight);
                g2.setColor(Color.GREEN);
                g2.fillRect(barX, barY, (int) (barWidth * (u.leben / u.maxLeben)), barHeight);
                g2.setColor(Color.WHITE);
                g2.drawRect(barX, barY, barWidth, barHeight);
            }
        }

        // Overlay Informationen
        g2.setColor(Color.GREEN);
        g2.setFont(new Font("Monospaced", Font.BOLD, 14));
        g2.drawString("MATRIXGAME ENGINE - LEVEL " + currentLevelId, 20, 30);
        g2.drawString("Einheiten aktiv: " + unitList.size() + " | Schritt: " + zeitSchritt, 20, 50);
        g2.drawString("Steuerung: Links-Klick = Auswählen | Rechts-Klick = Bewegen | Taste 5/6 = Level wechseln", 20, 70);
    }

    private void setupMouseListeners() {
        addMouseListener(new MouseAdapter() {
            @Override
            public void mousePressed(MouseEvent e) {
                int mx = e.getX();
                int my = e.getY();
                int centerX = getWidth() / 2;
                int centerY = getHeight() / 2;

                if (SwingUtilities.isLeftMouseButton(e)) {
                    for (Unit u : unitList) {
                        double sx = centerX + (u.posX + zoomCenterX) * zoomFactor;
                        double sy = centerY + (u.posY + zoomCenterY) * zoomFactor;
                        u.isSelected = Math.hypot(mx - sx, my - sy) <= u.size * 1.5;
