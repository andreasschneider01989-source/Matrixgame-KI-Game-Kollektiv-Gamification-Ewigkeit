    private void updateGameLogic() {
        if (isPlaying) {
            timeElapsed += 0.033;

            if (shieldTicksRemaining > 0) {
                shieldTicksRemaining--;
            }

            // OSZILLIERENDE LASER-BEWEGUNG
            movingLaser.y += movingLaser.moveSpeed * movingLaser.moveDir;
            if (movingLaser.y > 6.0 || movingLaser.y < -6.0) {
                movingLaser.moveDir *= -1.0;
            }

            // GRAVITATIONS-PULL & CHRONO-PULSE
            for (Entity e : entities) {
                if (e.type == EntityType.GRAVITY_WELL && e.active) {
                    e.pulsePhase += 0.1;
                    for (Entity target : entities) {
                        if (target.type == EntityType.PLAYER || target.type == EntityType.SKRALL || 
                            target.type == EntityType.PATROL || target.type == EntityType.BOULDER) {
                            
                            double dx = e.x - target.x;
                            double dy = e.y - target.y;
                            double distSq = dx * dx + dy * dy;
                            if (distSq > 0.3 && distSq < 80.0) {
                                double pull = 0.07 / Math.sqrt(distSq);
                                target.x += (dx / Math.sqrt(distSq)) * pull;
                                target.y += (dy / Math.sqrt(distSq)) * pull;
                            }
                        }
                    }
                } else if (e.type == EntityType.CHRONO_FIELD && e.active) {
                    e.pulsePhase += 0.05;
                }
            }

            // Skrall-Jäger KI (Tempo wird im Chrono-Feld ebenfalls gedämpft)
            double skrallSpeed = 0.12;
            for (Entity ent : entities) {
                if (ent.type == EntityType.CHRONO_FIELD && ent.active) {
                    double distToChrono = Math.sqrt(Math.pow(skrall.x - ent.x, 2) + Math.pow(skrall.y - ent.y, 2));
                    if (distToChrono < ent.radius) {
                        skrallSpeed *= 0.35;
                        break;
                    }
                }
            }

            double dx = player.x - skrall.x;
            double dy = player.y - skrall.y;
            double dist = Math.sqrt(dx * dx + dy * dy);
            if (dist > 0.4) {
                skrall.x += (dx / dist) * skrallSpeed;
                skrall.y += (dy / dist) * skrallSpeed;
            }

            // Patrouillen
            patrol1.patPhase += 0.05;
            patrol1.x = -8.0 + Math.sin(patrol1.patPhase) * 6.0;
            patrol1.y = 6.0 + Math.cos(patrol1.patPhase * 0.8) * 4.0;

            patrol2.patPhase += 0.04;
            patrol2.x = 8.0 + Math.cos(patrol2.patPhase) * 5.0;
            patrol2.y = -6.0 + Math.sin(patrol2.patPhase * 1.2) * 5.0;

            patrol3.patPhase += 0.06;
            patrol3.x = 0.0 + Math.sin(patrol3.patPhase * 1.1) * 7.0;
            patrol3.y = 10.0 + Math.cos(patrol3.patPhase) * 3.0;

            checkCollisions();
            updateInspector();
            canvasPanel.repaint();
        }
    }

    private void checkCollisions() {
        long currentTime = System.currentTimeMillis();

        // 1. Quanten-Portale
        for (Entity e : entities) {
            if ((e.type == EntityType.PORTAL_A || e.type == EntityType.PORTAL_B) && e.active) {
                double dist = Math.sqrt(Math.pow(player.x - e.x, 2) + Math.pow(player.y - e.y, 2));
                if (dist < (player.radius + e.radius) && (currentTime - lastTeleportTime > 1500)) {
                    if (e.linkedPortal != null) {
                        player.x = e.linkedPortal.x;
                        player.y = e.linkedPortal.y;
                        lastTeleportTime = currentTime;
                        scoreXP += 150;
                    }
                }
            }
        }

        // 2. Energie-Zellen
        for (Entity e : entities) {
            if (e.type == EntityType.ENERGY_ITEM && e.active) {
                double dist = Math.sqrt(Math.pow(player.x - e.x, 2) + Math.pow(player.y - e.y, 2));
                if (dist < (player.radius + e.radius)) {
                    e.active = false;
                    energyCells++;
                    scoreXP += 200;
                }
            }
        }

        // 3. Münzen
        for (Entity e : entities) {
            if (e.type == EntityType.COIN && e.active) {
                double dist = Math.sqrt(Math.pow(player.x - e.x, 2) + Math.pow(player.y - e.y, 2));
                if (dist < (player.radius + e.radius)) {
                    e.active = false;
                    coinsCollected++;
                    scoreXP += 100;
                }
            }
        }

        // 4. Lumini-Schaltknoten
        for (Entity e : entities) {
            if (e.type == EntityType.SWITCH && e.active && !e.triggered) {
                double dist = Math.sqrt(Math.pow(player.x - e.x, 2) + Math.pow(player.y - e.y, 2));
                if (dist < (player.radius + e.radius)) {
                    e.triggered = true;
                    e.color = new Color(0, 255, 100);
                    switchesActivated++;
                    scoreXP += 250;
                }
            }
        }

        if (switchesActivated >= totalSwitches && coinsCollected >= totalCoins) {
            gate.color = new Color(0, 255, 180);
        }

        // Gefahrenkollision (Skrall, Patrouillen & Laser ohne Schild)
        if (shieldTicksRemaining <= 0) {
            double distSkrall = Math.sqrt(Math.pow(player.x - skrall.x, 2) + Math.pow(player.y - skrall.y, 2));
            double distP1 = Math.sqrt(Math.pow(player.x - patrol1.x, 2) + Math.pow(player.y - patrol1.y, 2));
            double distP2 = Math.sqrt(Math.pow(player.x - patrol2.x, 2) + Math.pow(player.y - patrol2.y, 2));
            double distP3 = Math.sqrt(Math.pow(player.x - patrol3.x, 2) + Math.pow(player.y - patrol3.y, 2));

            boolean hitLaser = false;
            for (Entity laser : entities) {
                if (laser.type == EntityType.LASER_BARRIER && laser.active) {
                    if (checkRectCircleCollision(laser, player.x, player.y, player.radius)) {
                        hitLaser = true;
                        break;
                    }
                }
            }

            if (distSkrall < (player.radius + skrall.radius) || 
                distP1 < (player.radius + patrol1.radius) || 
                distP2 < (player.radius + patrol2.radius) || 
                distP3 < (player.radius + patrol3.radius) || 
                hitLaser) {
                
                isPlaying = false;
                JOptionPane.showMessageDialog(this, "Chrono-Matrix Kollision! Nutze Zeitverzögerungsfelder taktscharf.", "Matrix Reboot - Level 6", JOptionPane.WARNING_MESSAGE);
                initLevel6Data();
                canvasPanel.requestFocusInWindow();
            }
        }

        // ZIEL-TOR
        double distGate = Math.sqrt(Math.pow(player.x - gate.x, 2) + Math.pow(player.y - gate.y, 2));
        if (distGate < (player.radius + gate.radius)) {
            if (switchesActivated >= totalSwitches && coinsCollected >= totalCoins) {
                isPlaying = false;
                int timeBonus = Math.max(0, 1800 - (int)(timeElapsed * 10));
                scoreXP += timeBonus;
                JOptionPane.showMessageDialog(this, String.format("LEVEL 6 MEISTERHAFT VOLLENDET!\n\nChrono-Gitter stabilisiert!\nGesamt XP: %d\nZeitbonus: +%d XP\nZeit: %.1f s", scoreXP, timeBonus, timeElapsed), "Level 6 Master Victory", JOptionPane.INFORMATION_MESSAGE);
            }
        }
    }

    public String exportGameState() {
        DateTimeFormatter dtf = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
        StringBuilder sb = new StringBuilder();
        sb.append("\n--- MATRIXGAME STATE EXPORT (Level 6) ---\n");
        sb.append("Timestamp: [").append(dtf.format(LocalDateTime.now())).append("]\n");
        sb.append(String.format("Coins: %d / %d | Lumini-Knoten: %d / %d | XP: %d | Time: %.1fs | Cells: %d\n", coinsCollected, totalCoins, switchesActivated, totalSwitches, scoreXP, timeElapsed, energyCells));
        for (Entity e : entities) {
            if (e.active) {
                sb.append(String.format("Entity: %-20s | Type: %-14s | X: %7.2f | Y: %7.2f\n", e.name, e.type, e.x, e.y));
            }
        }
        sb.append("------------------------------------------\n");
        return sb.toString();
    }

    // --- CANVAS RENDER ENGINE ---
    private class CanvasPanel extends JPanel {
        public CanvasPanel() {
            setBackground(new Color(13, 15, 24));

            MouseAdapter adapter = new MouseAdapter() {
                @Override
                public void mousePressed(MouseEvent e) {
                    canvasPanel.requestFocusInWindow();
                    lastMousePos = e.getPoint();
                    
                    if (SwingUtilities.isLeftMouseButton(e)) {
                        double worldX = (e.getX() - getWidth() / 2.0 - cameraX) / (30.0 * zoom);
                        double worldY = -(e.getY() - getHeight() / 2.0 - cameraY) / (30.0 * zoom);

                        for (Entity ent : entities) {
                            if (ent.active) {
                                double dist = Math.sqrt(Math.pow(worldX - ent.x, 2) + Math.pow(worldY - ent.y, 2));
                                if (dist <= ent.radius * 1.5) {
                                    selectedEntity = ent;
                                    updateInspector();
                                    repaint();
                                    break;
                                }
                            }
                        }
                    }
                }

                @Override
                public void mouseDragged(MouseEvent e) {
                    if (SwingUtilities.isRightMouseButton(e) || SwingUtilities.isMiddleMouseButton(e)) {
                        int dx = e.getX() - lastMousePos.x;
                        int dy = e.getY() - lastMousePos.y;
                        cameraX += dx;
                        cameraY += dy;
                        lastMousePos = e.getPoint();
                        repaint();
                    }
                }

                @Override
                public void mouseWheelMoved(MouseWheelEvent e) {
                    if (e.getWheelRotation() < 0) zoom *= 1.1;
                    else zoom /= 1.1;
                    zoom = Math.max(0.15, Math.min(zoom, 6.0));
                    repaint();
                }
            };

            addMouseListener(adapter);
            addMouseMotionListener(adapter);
            addMouseWheelListener(adapter);
        }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2 = (Graphics2D) g;
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            int cx = getWidth() / 2 + (int) cameraX;
            int cy = getHeight() / 2 + (int) cameraY;

            // GRID RENDER
            g2.setColor(new Color(25, 30, 45));
            int gridSize = (int) (30 * zoom);
            for (int x = cx % gridSize; x < getWidth(); x += gridSize) g2.drawLine(x, 0, x, getHeight());
            for (int y = cy % gridSize; y < getHeight(); y += gridSize) g2.drawLine(0, y, getWidth(), y);

            g2.setColor(new Color(50, 60, 80));
            g2.drawLine(cx, 0, cx, getHeight());
            g2.drawLine(0, cy, getWidth(), cy);

            // RENDER ENTITIES
            for (Entity e : entities) {
                if (!e.active) continue;

                int screenX = cx + (int) (e.x * 30 * zoom);
                int screenY = cy - (int) (e.y * 30 * zoom);

                if (e == selectedEntity) {
                    g2.setColor(Color.YELLOW);
                    int r = (int) (e.radius * 30 * zoom);
                    g2.drawRect(screenX - r - 4, screenY - r - 4, (r + 4) * 2, (r + 4) * 2);
                }

                g2.setColor(e.color);

                if (e.type == EntityType.WALL) {
                    int w = (int) (e.width * 30 * zoom);
                    int h = (int) (e.height * 30 * zoom);
                    g2.fillRect(screenX - w / 2, screenY - h / 2, w, h);
                    g2.setColor(e.color.brighter());
                    g2.drawRect(screenX - w / 2, screenY - h / 2, w, h);
                } else if (e.type == EntityType.LASER_BARRIER) {
                    int w = (int) (e.width * 30 * zoom);
                    int h = (int) (e.height * 30 * zoom);
                    g2.setColor(new Color(255, 0, 80, 180));
                    g2.fillRect(screenX - w / 2, screenY - h / 2, w, h);
                    g2.setColor(Color.WHITE);
                    g2.drawRect(screenX - w / 2, screenY - h / 2, w, h);
                } else if (e.type == EntityType.CHRONO_FIELD) {
                    int r = (int) (e.radius * 30 * zoom);
                    int pulseR = r + (int) (Math.sin(e.pulsePhase) * 8 * zoom);
                    g2.setColor(new Color(0, 180, 255, 40));
                    g2.fillOval(screenX - pulseR, screenY - pulseR, pulseR * 2, pulseR * 2);
                    g2.setColor(new Color(0, 220, 255));
                    g2.drawOval(screenX - r, screenY - r, r * 2, r * 2);
                } else if (e.type == EntityType.GRAVITY_WELL) {
                    int r = (int) (e.radius * 30 * zoom);
                    int pulseR = r + (int) (Math.sin(e.pulsePhase) * 6 * zoom);
                    g2.setColor(new Color(140, 0, 255, 100));
                    g2.fillOval(screenX - pulseR, screenY - pulseR, pulseR * 2, pulseR * 2);
                    g2.setColor(new Color(200, 100, 255));
                    g2.drawOval(screenX - r, screenY - r, r * 2, r * 2);
                } else if (e.type == EntityType.GATE) {
                    int r = (int) (e.radius * 30 * zoom);
                    g2.fillRect(screenX - r, screenY - r, r * 2, r * 2);
                    g2.setColor(Color.WHITE);
                    g2.drawRect(screenX - r, screenY - r, r * 2, r * 2);
                    if (switchesActivated >= totalSwitches && coinsCollected >= totalCoins) {
                        g2.setColor(Color.CYAN);
                        g2.drawOval(screenX - r / 2, screenY - r / 2, r, r);
                    }
                } else if (e.type == EntityType.PORTAL_A || e.type == EntityType.PORTAL_B) {
                    int r = (int) (e.radius * 30 * zoom);
                    g2.drawOval(screenX - r, screenY - r, r * 2, r * 2);
                    g2.drawOval(screenX - r / 2, screenY - r / 2, r, r);
                } else if (e.type == EntityType.ENERGY_ITEM) {
                    int r = (int) (e.radius * 30 * zoom);
                    g2.fillOval(screenX - r, screenY - r, r * 2, r * 2);
                    g2.setColor(Color.WHITE);
                    g2.drawOval(screenX - r, screenY - r, r * 2, r * 2);
                } else if (e.type == EntityType.COIN) {
                    int r = (int) (e.radius * 30 * zoom);
                    g2.fillRect(screenX - r, screenY - r, r * 2, r * 2);
                } else if (e.type == EntityType.SWITCH) {
                    int r = (int) (e.radius * 30 * zoom);
                    Polygon p = new Polygon();
                    p.addPoint(screenX, screenY - r);
                    p.addPoint(screenX + r, screenY);
                    p.addPoint(screenX, screenY + r);
                    p.addPoint(screenX - r, screenY);
                    g2.fillPolygon(p);
                } else {
                    int r = (int) (e.radius * 30 * zoom);
                    g2.fillOval(screenX - r, screenY - r, r * 2, r * 2);

                    if (e.type == EntityType.PLAYER && shieldTicksRemaining > 0) {
                        g2.setColor(new Color(0, 255, 255, 120));
                        g2.fillOval(screenX - r - 6, screenY - r - 6, (r + 6) * 2, (r + 6) * 2);
                    }
                }
            }

            // HUD OVERLAY
            g2.setFont(new Font("Consolas", Font.BOLD, 14));
            g2.setColor(Color.WHITE);
            g2.drawString(String.format("Coins: %d / %d", coinsCollected, totalCoins), 20, 30);

            g2.setColor(switchesActivated == totalSwitches ? new Color(0, 255, 100) : new Color(0, 200, 255));
            g2.drawString(String.format("Lumini-Knoten: %d / %d", switchesActivated, totalSwitches), 20, 50);

            g2.setColor(Color.GREEN);
            g2.drawString(String.format("Energie-Zellen: %d", energyCells), 20, 70);

            if (shieldTicksRemaining > 0) {
                g2.setColor(Color.CYAN);
                g2.drawString(String.format("SCHILD AKTIV: %.1f s", shieldTicksRemaining / 30.0), 20, 90);
            }

            g2.setColor(Color.ORANGE);
            g2.drawString(String.format("XP-Punkte: %d", scoreXP), 20, 115);
            g2.drawString(String.format("Zeit: %.1f s", timeElapsed), 20, 135);

            if (switchesActivated >= totalSwitches && coinsCollected >= totalCoins) {
                g2.setColor(new Color(0, 255, 180));
                g2.drawString("ZIEL-TOR FREIGESCHALTET! Fliehe zu Position (20, 14)", 20, 160);
            }
        }
    }

