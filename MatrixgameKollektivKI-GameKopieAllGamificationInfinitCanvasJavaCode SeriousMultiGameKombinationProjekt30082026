};

function initLevel7() {
    gameState.entities = [
        // Player Units (Squad)
        new Unit('Player_Hero', 'PLAYER', -18.0, -14.0, 'PLAYER', 8.0, 1.5, 25),
        new Unit('Player_Support', 'PLAYER', -19.5, -14.0, 'PLAYER', 7.5, 2.5, 12),

        // Hostile Units
        new Unit('Skrall_Hunter_v7', 'SKRALL', 18.0, 14.0, 'ENEMY', 6.0, 1.2, 30),
        new Unit('Patrol_Alpha', 'PATROL', -8.0, 6.0, 'ENEMY', 4.5, 1.0, 15),
        new Unit('Patrol_Beta', 'PATROL', 8.0, -6.0, 'ENEMY', 4.5, 1.0, 15),

        // Interactive Gate & Gravity Field
        new GameObject('Exit_Gate', 'GATE', 20.0, 14.0, 'STATIC', 1.5),
        new GameObject('Graviton_Center', 'GRAVITY_WELL', -4.0, -2.0, 'FIELD', 2.0)
    ];

    // Spawn Lumini Switches
    const nodes = [[-16,14], [-16,-14], [0,0], [16,14], [16,-14]];
    nodes.forEach((pos, idx) => {
        const n = new GameObject(`Lumini_Node_${idx+1}`, 'SWITCH', pos[0], pos[1], 'NEUTRAL', 0.8);
        gameState.entities.push(n);
    });

    // Spawn Collectibles (Coins & Energy Cells)
    const coins = [[-14,-12], [-10,12], [-6,10], [6,-12], [8,8], [10,-10], [14,12], [18,-6], [-16,0], [12,4], [-4,-8], [4,14], [-2,4], [2,-4], [14,0]];
    coins.forEach((pos, idx) => {
        const c = new GameObject(`Coin_${idx+1}`, 'COIN', pos[0], pos[1], 'ITEM', 0.4);
