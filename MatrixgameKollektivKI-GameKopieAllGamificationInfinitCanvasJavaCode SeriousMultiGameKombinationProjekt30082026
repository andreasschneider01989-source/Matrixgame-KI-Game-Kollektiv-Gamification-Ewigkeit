// 1. DATA & GAME SIMULATION ENGINE
// ==========================================
enum UnitType { PLAYER, BOULDER, DIAMOND, WALL, ENEMY_SKRALL, GATE }
enum GameState { PLAYING, WON, GAME_OVER }

class SimulationEngine {
    private List<Unit> units;
    private boolean running = false;
    private int tickRateMs = 80;
    private int currentIteration = 0;
    private GameState gameState = GameState.PLAYING;
    private int totalCoins = 0;
    private int collectedCoins = 0;

    public SimulationEngine() {
        units = new ArrayList<>();
        initLevel();
    }

    public void initLevel() {
        units.clear();
        currentIteration = 0;
        collectedCoins = 0;
        gameState = GameState.PLAYING;

        // Spieler im Zentrum
        units.add(new Unit("Player_Hero", UnitType.PLAYER, 0.0, 0.0));
        
        // Gegner (Skrall) der den Spieler jagt
        units.add(new Unit("Skrall_Hunter", UnitType.ENEMY_SKRALL, -6.0, -5.0));

        // Münzen (Diamonds) zum Einsammeln
        units.add(new Unit("Coin_1", UnitType.DIAMOND, 3.0, 2.0));
        units.add(new Unit("Coin_2", UnitType.DIAMOND, -4.0, 4.0));
        units.add(new Unit("Coin_3", UnitType.DIAMOND, 5.0, -4.0));
        
        // Zählen wie viele Münzen es gibt
        totalCoins = 3;

        // Das Ausgangs-Tor
        units.add(new Unit("Exit_Gate", UnitType.GATE, 7.0, 7.0));

        // Ein paar Hindernisse / Felsen
        units.add(new Unit("Boulder_1", UnitType.BOULDER, 2.0, 1.0));
        units.add(new Unit("Boulder_2", UnitType.BOULDER, -2.0, -2.0));
        units.add(new Unit("Wall_1", UnitType.WALL, 4.0, 4.0));
    }

    public synchronized void step() {
        if (gameState != GameState.PLAYING) return;
        currentIteration++;

        Unit player = getPlayer();
        Unit skrall = getSkrall();

        // 1. Skrall-KI: Jede Iteration schrittweise den Spieler verfolgen
        if (skrall != null && player != null) {
            double dx = player.worldX - skrall.worldX;
            double dy = player.worldY - skrall.worldY;
            double dist = Math.hypot(dx, dy);

            if (dist > 0.1) {
                double speed = 0.12; // Skrall-Geschwindigkeit
                skrall.worldX += (dx / dist) * speed;
                skrall.worldY += (dy / dist) * speed;
            }

            // Kollisionsprüfung: Hat der Skrall den Spieler gefangen?
            if (dist < 0.6) {
                gameState = GameState.GAME_OVER;
                running = false;
            }
        }

        // 2. Münzen-Einsammeln & Tor-Prüfung prüfen
        if (player != null) {
            List<Unit> toRemove = new ArrayList<>();
            for (Unit u : units) {
                double dist = Math.hypot(player.worldX - u.worldX, player.worldY - u.worldY);

                if (u.type == UnitType.DIAMOND && dist < 0.7) {
                    toRemove.add(u);
                    collectedCoins++;
                } else if (u.type == UnitType.GATE && dist < 0.8) {
                    if (collectedCoins >= totalCoins) {
                        gameState = GameState.WON;
                        running = false;
                    }
                }
            }
            units.removeAll(toRemove);
        }
    }

    public void runLoop() {
        while (true) {
            if (running) {
                step();
            }
            try {
                Thread.sleep(tickRateMs);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
                break;
            }
        }
    }

    public Unit getPlayer() {
        return units.stream().filter(u -> u.type == UnitType.PLAYER).findFirst().orElse(null);
    }

    public Unit getSkrall() {
        return units.stream().filter(u -> u.type == UnitType.ENEMY_SKRALL).findFirst().orElse(null);
    }

    public boolean isRunning() { return running; }
    public void setRunning(boolean running) { if (gameState == GameState.PLAYING) this.running = running; }
    public int getCurrentIteration() { return currentIteration; }
    public GameState getGameState() { return gameState; }
    public int getCollectedCoins() { return collectedCoins; }
    public int getTotalCoins() { return totalCoins; }
    
    public List<Unit> getAllUnits() { return units; }
    public void addUnit(Unit u) { units.add(u); }
    public void removeUnit(Unit u) { units.remove(u); }
}

class Unit {
    public String name;
    public UnitType type;
    public double worldX, worldY;
    public double customVarA = 1.0; 
    public double customVarB = 0.0;

    public Unit(String name, UnitType type, double worldX, double worldY) {
        this.name = name;
        this.type = type;
        this.worldX = worldX;
        this.worldY = worldY;
    }

    public Unit cloneUnit() {
        Unit copy = new Unit(name + "_copy", type, worldX + 1.0, worldY + 1.0);
        copy.customVarA = this.customVarA;
        copy.customVarB = this.customVarB;
        return copy;
    }
}

