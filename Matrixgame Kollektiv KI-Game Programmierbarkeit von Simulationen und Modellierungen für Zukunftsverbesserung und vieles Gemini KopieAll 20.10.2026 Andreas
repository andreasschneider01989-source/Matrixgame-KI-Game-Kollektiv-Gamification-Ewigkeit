    private static final int MAX_TICKS = 1500; // Der akkumulative Iterations-Horizont
    private static final double G = 6.67430e-11;
    private static final double EPSILON = 1e-10;
    private static final double ENTROPY_THRESHOLD = 50.0; // Schwellenwert für den Flammen-Entropie-Filter

    public static class Node3D {
        public double x, y, z;
        public double fx, fy, fz;
        public double mass;

        public Node3D(double x, double y, double z, double mass) {
            this.x = x; this.y = y; this.z = z; this.mass = mass;
            resetForces();
        }

        public void resetForces() {
            this.fx = 0.0; this.fy = 0.0; this.fz = 0.0;
        }
    }

    /**
     * Führt die Simulation über den 1500er-Horizont aus und wendet den Flammen-Entropie-Filter an.
     */
    public void runEvolutionSimulation(Node3D[] nodes) {
        int n = Math.min(nodes.length, MAX_TICKS);

        // Äußere Schleife: Der 1500er-Akkumulations-Horizont (Summations-Ticks)
        for (int tick = 0; tick < MAX_TICKS; tick++) {
            
            // 1. Reset der Kräfte für den aktuellen Tick
            for (int i = 0; i < n; i++) {
                nodes[i].resetForces();
            }

            // 2. Paarweise Interaktionsschleife mit Invers-Quadrat & Normalisierung
            for (int i = 0; i < n; i++) {
                Node3D nodeI = nodes[i];
                
                for (int j = 0; j < n; j++) {
                    if (i == j) continue;
                    Node3D nodeJ = nodes[j];

                    double dx = nodeJ.x - nodeI.x;
                    double dy = nodeJ.y - nodeI.y;
                    double dz = nodeJ.z - nodeI.z;

                    double distSq = (dx * dx) + (dy * dy) + (dz * dz) + EPSILON;
                    double dist = Math.sqrt(distSq);

                    // 3D-Vektor-Normalisierung
                    double ux = dx / dist;
                    double uy = dy / dist;
                    double uz = dz / dist;

                    // Invers-Quadrat-Gesetz
                    double forceMagnitude = G * (nodeI.mass * nodeJ.mass) / distSq;

                    // --- FLAMMEN-ENTROPIE-FILTER ---
                    // Filtert toxische Kraftspitzen oder radikale Störfaktoren heraus
                    if (forceMagnitude > ENTROPY_THRESHOLD) {
                        // Dämpfung des toxischen/radikalen Rauschens auf Null oder Minimalwert
                        forceMagnitude = 0.0; 
                    }

                    // Kräfte akkumulieren (Summation über die Zeit)
                    nodeI.fx += forceMagnitude * ux;
                    nodeI.fy += forceMagnitude * uy;
                    nodeI.fz += forceMagnitude * uz;
                }
            }
        }
    }
}
