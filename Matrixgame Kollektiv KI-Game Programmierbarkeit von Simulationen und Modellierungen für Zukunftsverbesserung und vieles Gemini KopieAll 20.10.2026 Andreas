import java.util.ArrayList;
import java.util.List;

public class MatrixJournalLogger {

    private static final int MAX_TICKS = 1500;
    private static final double ALIGNMENT_THRESHOLD = 0.25;
    private static final double ENTROPY_THRESHOLD = 50.0;

    public static class LogEntry {
        public int tick;
        public String senderId;
        public String type; // "RESONANCE" oder "REJECTED"
        public double alignmentScore;
        public String details;

        public LogEntry(int tick, String senderId, String type, double alignmentScore, String details) {
            this.tick = tick;
            this.senderId = senderId;
            this.type = type;
            this.alignmentScore = alignmentScore;
            this.details = details;
        }

        @Override
        public String toString() {
            return String.format("[Tick %d] [%s] Sender: %s | Alignment: %.2f | %s", 
                tick, type, senderId, alignmentScore, details);
        }
    }

    // Das integrierte Journal als Speicher-Buffer
    private List<LogEntry> journalBuffer = new ArrayList<>();

    public boolean processAndLogInteraction(int currentTick, String senderId, double vx, double vy, double vz, double targetRx, double targetRy, double targetRz, boolean isToxic) {
        
        // 1. Toxin-Prüfung durch den Flammen-Filter
        if (isToxic) {
            journalBuffer.add(new LogEntry(currentTick, senderId, "REJECTED_TOXIN", 0.0, "Sofortige Abweisung durch Flammen-Filter."));
            return false;
        }

        // 2. Vektor-Normalisierung (Ziel & Interaktion)
        double targetNorm = Math.sqrt(targetRx * targetRx + targetRy * targetRy + targetRz * targetRz);
        double incNorm = Math.sqrt(vx * vx + vy * vy + vz * vz);
        
        if (targetNorm == 0 || incNorm == 0) return false;

        double alignment = ((vx / incNorm) * (targetRx / targetNorm)) +
                           ((vy / incNorm) * (targetRy / targetNorm)) +
                           ((vz / incNorm) * (targetRz / targetNorm));

        // 3. Protokollierung basierend auf der Alignment-Prüfung
        if (alignment >= ALIGNMENT_THRESHOLD) {
            journalBuffer.add(new LogEntry(currentTick, senderId, "RESONANCE", alignment, "Handshake erfolgreich. Konstruktives Signal verstärkt."));
            return true;
        } else {
            journalBuffer.add(new LogEntry(currentTick, senderId, "REJECTED_NOISE", alignment, "Störgeräusch ausgeblendet (Alignment unter Schwellenwert)."));
            return false;
        }
    }

    public void printJournalSummary() {
        System.out.println("=== MATRIXGAME-JOURNAL AUDIT TRAIL ===");
        for (LogEntry entry : journalBuffer) {
            System.out.println(entry);
        }
    }
}
