        if (fluprednidenFilterActive) {
            // Membran geöffnet: Entropie sinkt, Bewusstsein (Hawkins) steigt
            if (systemEntropy > 10.0) systemEntropy -= 0.5;
            if (globalHawkinsLevel < 500.0) globalHawkinsLevel += 1.5; // 500 = Liebe/Resonanz

            for (BioNeuron n : neurons) {
                // Harmonisierung der Potenziale
                n.potential += (0.5 - n.potential) * 0.02; 
                if (n.type == -1) {
                    // Hemmende (alte) Zell-Abwehrsignale werden beruhigt
                    n.potential *= 0.95; 
                }
            }
            for (BioSynapse s : synapses) {
                if (s.source.type == -1) {
                    // Toxische Kausalitäten verlieren an Gewicht
                    s.weight *= 0.98; 
                }
            }
        } else {
            // Standard-Naturzustand
            if (systemEntropy < 100.0) systemEntropy += 0.2;
            if (globalHawkinsLevel > 200.0) globalHawkinsLevel -= 0.5;

            for (BioNeuron n : neurons) {
                n.potential += (Math.random() - 0.5) * 0.05;
                if(n.potential < 0) n.potential = 0;
                if(n.potential > n.threshold) n.potential = 0; // "Feuern"
            }
            for (BioSynapse s : synapses) {
                // Synapsen regenerieren ihr ursprüngliches Evolutions-Gewicht
                s.weight += (s.baseWeight - s.weight) * 0.01;
            }
        }
        
        repaint();
    }

