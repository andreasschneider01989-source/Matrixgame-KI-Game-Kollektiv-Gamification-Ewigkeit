import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.*;
import java.util.List;

/**
 * M3: GUI-Einheit – die SchönerZoom-Kamera als GLOBALES, wiederverwendbares Modul,
 * plus erster Hub-Frame, der M1 (Bewusstseins-Welten) und M2 (Fraktal-Physik)
 * unter einer gemeinsamen Kamera und einem gemeinsamen HUD vereint.
 *
 * Neue zentrale Klasse: SchoenerZoomKamera
 *   - Zoom (ZOOM_STEP 1.2), Feinheit 70, adaptiver PAN_STEP (feinheit/zoomFactor)
 *   - Mausrad-Zoom, Rechtsklick-Drag = Pan, Linksklick-Drag = 3D-Rotation
 *   - project(x,y,z) liefert Bildschirmkoordinaten für ALLE Welten
 *   - Fur jede Simulation wiederverwendbar (M1, M2, spätere EVE-Schnittstelle)
 *
 * Hub: Zwei Ansichten in einem Frame (Tab-Umschaltung):
 *   [Fraktal-Welt]  M2-Physik: Entropie-Urknall, N-Body, Oktett-Zerfall
 *   [Bewusstseins-Welt] M1-Kopplung: 11 Welten als Orbit-Knoten, Harmonie als
 *                      Glow, Spieler-Aktionen (Ausrichten/Wissen) heben die Erd-Harmonie
 *
 * Start:  javac M3_GlobaleKameraHub.java
 *         java M3_GlobaleKameraHub
 */
public class M3_GlobaleKameraHub extends JPanel {

    // ================== GLOBALE KAMERA (SchönerZoom-Fusion, für alles nutzbar) ==================
    public static class SchoenerZoomKamera {
        double zoomFactor = 1.0;
        double feinheit = 70;
        double PAN_STEP;
        static final double ZOOM_STEP = 1.2;
        double angleX = 0.25, angleY = 0.0;
        int panX = 0, panY = 0;
        int w = 1600, h = 1000;
        static final double FOCAL = 580, Z_OFF = 340;

        SchoenerZoomKamera() { PAN_STEP = feinheit; }

        void resize(int w, int h) { this.w = w; this.h = h; }

        void zoomIn()  { zoomFactor *= ZOOM_STEP; PAN_STEP = feinheit / zoomFactor; }
        void zoomOut() { zoomFactor /= ZOOM_STEP; PAN_STEP = feinheit / zoomFactor; }

        /** 3D -> 2D Projektion mit Rotation + SchönerZoom-Pan/Zoom. */
        Point project(double nx, double ny, double nz) {
            double x1 = nx * Math.cos(angleY) - nz * Math.sin(angleY);
            double z1 = nx * Math.sin(angleY) + nz * Math.cos(angleY);
            double y2 = ny * Math.cos(angleX) - z1 * Math.sin(angleX);
            double z2 = ny * Math.sin(angleX) + z1 * Math.cos(angleX);
            double scale = (FOCAL / (FOCAL + z2 + Z_OFF)) * zoomFactor;
            return new Point((int) (w / 2.0 + panX + x1 * scale),
                              (int) (h / 2.0 + panY + y2 * scale));
        }
    }

    // ================== Fraktaler Körper (M2, stabilisiert) ==================
    static class FraktalKoerper {
        double x, y, z, vx, vy, vz, mass;
        int radius; Color color; boolean movable;
        List<FraktalKoerper> unterpunkte;
        FraktalKoerper(double x, double y, double z, double vx, double vy, double vz,
                       double mass, int radius, Color color, boolean movable) {
            this.x = x; this.y = y; this.z = z; this.vx = vx; this.vy = vy; this.vz = vz;
            this.mass = mass; this.radius = radius; this.color = color; this.movable = movable;
        }
        void konstUnterStrukt() {
            unterpunkte = new ArrayList<>();
            double maxM = mass / 8.0;
            for (int i = 0; i < 8; i++) {
                int dx = (i & 1) == 0 ? 1 : -1, dy = (i & 2) == 0 ? 1 : -1, dz = (i & 4) == 0 ? 1 : -1;
                double m = maxM * (0.3 + 0.7 * ((i % 3) + 1) / 3.0);
                FraktalKoerper u = new FraktalKoerper(x + dx * 6, y + dy * 6, z + dz * 6,
                    vx, vy, vz, m, 2, color, true);
                unterpunkte.add(u);
            }
        }
    }

    // ================== Bewusstseins-Welt-Knoten (M1-Kopplung) ==================
    static class WeltKnoten {
        String name; double orbitR, winkel; double harmonie = 50; int zellen = 17;
        WeltKnoten(String n, double r, double w) { name = n; orbitR = r; winkel = w; }
    }

    // ================== Simulationszustand ==================
    final SchoenerZoomKamera kamera = new SchoenerZoomKamera();
    final List<FraktalKoerper> bodies = new ArrayList<>();
    final List<WeltKnoten> welten = new ArrayList<>();
    final Random rng = new Random(42);
    final javax.swing.Timer timer = new javax.swing.Timer(30, e -> tick());
    int ansicht = 0; // 0 = Fraktal-Welt, 1 = Bewusstseins-Welt
    long ticks = 0;
    int zerfaelle = 0;
    int prevX, prevY;

    static final double G = 0.01, DT = 1.0, MIN_DIST = 4.0, MAX_ACC = 0.05;

    void initFraktalWelt() {
        int[] gitter = new int[100];
        gitter[0] = 1024 * 1042;
        for (int step = 0; step < 8; step++)
            for (int i = 0; i < gitter.length; i++)
                for (int j = 0; j < gitter[i]; j += 512) {
                    double rand = Math.random();
                    if (rand < 0.5 && i < 99) { gitter[i] -= 512; gitter[i+1] += 512; }
                    else if (rand > 0.8 && i < 90) { gitter[i] -= 512; gitter[i+10] += 512; }
                }
        for (int i = 0; i < 100; i++) {
            if (gitter[i] < 512) continue;
            double gx = (i % 10) * 240 - 1080 + rng.nextDouble() * 60;
            double gy = (i / 10) * 240 - 1080 + rng.nextDouble() * 60;
            double mass = 800 + gitter[i] / 100.0;
            bodies.add(new FraktalKoerper(gx, gy, (rng.nextDouble() - 0.5) * 100,
                (rng.nextDouble() - 0.5) * 0.4, (rng.nextDouble() - 0.5) * 0.4, 0,
                mass, (int)(3 + Math.log(mass)), new Color(90, 200, 255), true));
        }
        bodies.add(new FraktalKoerper(0, 0, 0, 0, 0, 0, 40000, 14, new Color(255, 205, 40), false));

        // 11 Welten als Orbit-Knoten (Reihenfolge wie M1)
        String[] namen = {"Earth", "Dome World", "Alt. Physik", "Gott-Pflanze", "Orakel-Welt",
                          "Billard-Ratten", "Mrd. Menschen", "Asteroidengürtel", "Dogscape",
                          "Zombie-Welt", "Eiswelten"};
        for (int i = 0; i < 11; i++)
            welten.add(new WeltKnoten(namen[i], 160 + i * 55, i * (2 * Math.PI / 11)));
    }

    void tick() {
        ticks++;
        if (ansicht == 0) {
            int n = bodies.size();
            double[] ax = new double[n], ay = new double[n], az = new double[n];
            for (int i = 0; i < n; i++) {
                if (!bodies.get(i).movable) continue;
                for (int j = 0; j < n; j++) {
                    if (i == j) continue;
                    FraktalKoerper bi = bodies.get(i), bj = bodies.get(j);
                    double dx = bj.x - bi.x, dy = bj.y - bi.y, dz = bj.z - bi.z;
                    double r = Math.max(MIN_DIST, Math.sqrt(dx*dx + dy*dy + dz*dz));
                    double a = Math.min(MAX_ACC, G * bj.mass / (r * r));
                    ax[i] += a * dx / r; ay[i] += a * dy / r; az[i] += a * dz / r;
                }
            }
            List<FraktalKoerper> neu = new ArrayList<>();
            for (int i = bodies.size() - 1; i >= 0; i--) {
                FraktalKoerper b = bodies.get(i);
                if (b.movable) { b.vx += ax[i]*DT; b.vy += ay[i]*DT; b.vz += az[i]*DT; }
                b.x += b.vx * DT; b.y += b.vy * DT; b.z += b.vz * DT;
                if (b.unterpunkte == null && b.movable && b.mass > 1500 &&
                        Math.hypot(b.x, Math.hypot(b.y, b.z)) < 40 + b.radius) {
                    b.konstUnterStrukt(); b.movable = false;
                    neu.addAll(b.unterpunkte); zerfaelle++;
                }
            }
            bodies.addAll(neu);
        } else {
            for (WeltKnoten w : welten) {
                w.winkel += 0.004;
                w.harmonie = Math.max(0, Math.min(100, w.harmonie + (rng.nextDouble() - 0.45) * 0.4));
            }
            welten.get(0).harmonie = Math.min(100, welten.get(0).harmonie + 0.15); // Spieler wirkt auf Earth
        }
        kamera.angleY += 0.0012;
        repaint();
    }

    // ================== Rendering ==================
    @Override protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        kamera.resize(getWidth(), getHeight());
        g2.setColor(Color.BLACK);
        g2.fillRect(0, 0, getWidth(), getHeight());

        if (ansicht == 0) {
            // --- Fraktal-Welt ---
            for (FraktalKoerper b : bodies) {
                Point p = kamera.project(b.x, b.y, b.z);
                int r = (int) Math.max(2, b.radius * kamera.zoomFactor);
                g2.setColor(b.unterpunkte != null ? Color.WHITE : b.color);
                g2.fillOval(p.x - r, p.y - r, r * 2, r * 2);
                if (b.unterpunkte != null) {
                    g2.setColor(new Color(255, 255, 255, 120));
                    g2.drawOval(p.x - r - 3, p.y - r - 3, (r + 3) * 2, (r + 3) * 2);
                }
            }
        } else {
            // --- Bewusstseins-Welt: 11 Welten auf Orbits, Harmonie = Glow ---
            Point zentrum = kamera.project(0, 0, 0);
            g2.setColor(new Color(255, 205, 40));
            int zr = (int)(16 * kamera.zoomFactor);
            g2.fillOval(zentrum.x - zr, zentrum.y - zr, zr * 2, zr * 2);
            g2.setColor(Color.WHITE);
            g2.drawString("Kollektives Bewusstsein", zentrum.x - 60, zentrum.y + zr + 16);
            for (WeltKnoten w : welten) {
                double wx = Math.cos(w.winkel) * w.orbitR;
                double wy = Math.sin(w.winkel) * w.orbitR * 0.4;
                Point p = kamera.project(wx, wy, Math.sin(w.winkel) * 60);
                int glow = (int)(4 + w.harmonie / 12.0 * kamera.zoomFactor);
                g2.setColor(new Color(80, 200, 255, 60));
                    g2.fillOval(p.x - glow - 6, p.y - glow - 6, (glow + 6) * 2, (glow + 6) * 2);
                g2.setColor(w.harmonie >= 70 ? new Color(120, 255, 140) : new Color(90, 170, 255));
                g2.fillOval(p.x - 6, p.y - 6, 12, 12);
                g2.setColor(Color.WHITE);
                g2.setFont(new Font("Monospaced", Font.PLAIN, 10));
                g2.drawString(w.name + " H=" + (int) w.harmonie, p.x - 40, p.y - 12);
            }
        }

        // --- Globales HUD ---
        g2.setColor(Color.WHITE);
        g2.setFont(new Font("Monospaced", Font.BOLD, 13));
        g2.drawString("M3: MatrixGame-Hub - Globale SchönerZoom-Kamera", 16, 22);
        g2.setFont(new Font("Monospaced", Font.PLAIN, 11));
        g2.setColor(new Color(140, 220, 255));
        g2.drawString(String.format(Locale.US,
            "Ansicht: %s | Zoom %.2f | PanX %d PanY %d | Tick %d%s",
            ansicht == 0 ? "Fraktal-Welt (M2)" : "Bewusstseins-Welt (M1, 11 Welten)",
            kamera.zoomFactor, kamera.panX, kamera.panY, ticks,
            ansicht == 0 ? " | Zerfälle: " + zerfaelle : ""), 16, 42);
        g2.setColor(new Color(120, 120, 120));
        g2.drawString("Mausrad=Zoom | Rechts-Drag=Pan | Links-Drag=3D-Rotation", 16, 58);
    }

    // ================== Interaktion (Kamera global) ==================
    void bindInput() {
        addMouseWheelListener(e -> { if (e.getWheelRotation() < 0) kamera.zoomIn(); else kamera.zoomOut(); repaint(); });
        addMouseListener(new MouseAdapter() {
            @Override public void mousePressed(MouseEvent e) { prevX = e.getX(); prevY = e.getY(); }
        });
        addMouseMotionListener(new MouseMotionAdapter() {
            @Override public void mouseDragged(MouseEvent e) {
                int dx = e.getX() - prevX, dy = e.getY() - prevY;
                if (SwingUtilities.isRightMouseButton(e)) { kamera.panX += dx; kamera.panY += dy; }
                else { kamera.angleY += dx * 0.008;
                       kamera.angleX = Math.max(-1.1, Math.min(1.1, kamera.angleX - dy * 0.008)); }
                prevX = e.getX(); prevY = e.getY();
                repaint();
            }
        });
    }

    public M3_GlobaleKameraHub() {
        setBackground(Color.BLACK);
        initFraktalWelt();
        bindInput();
        timer.start();
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            JFrame f = new JFrame("M3 - Globale SchönerZoom-Kamera + MatrixGame-Hub");
            f.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
            M3_GlobaleKameraHub sim = new M3_GlobaleKameraHub();
            f.setLayout(new BorderLayout());

            JPanel top = new JPanel(new FlowLayout(FlowLayout.CENTER, 12, 6));
            top.setBackground(new Color(15, 18, 26));
            JToggleButton fraktal = new JToggleButton("🌌 Fraktal-Welt (M2)", true);
            JToggleButton bewusst = new JToggleButton("🧠 Bewusstseins-Welt (M1, 11 Welten)");
            fraktal.addActionListener(e -> { sim.ansicht = 0; fraktal.setSelected(true); bewusst.setSelected(false); sim.repaint(); });
            bewusst.addActionListener(e -> { sim.ansicht = 1; bewusst.setSelected(true); fraktal.setSelected(false); sim.repaint(); });
            top.add(fraktal); top.add(bewusst);

            f.add(sim, BorderLayout.CENTER);
            f.add(top, BorderLayout.NORTH);
            f.setSize(1600, 1000);
            f.setLocationRelativeTo(null);
            f.setVisible(true);
        });
    }
}

Let's Go M4 – der große Wurf! 🏆 „MatrixGame Total": Der Welten-Hub, in dem die Harmonie zur globalen Währung wird, die alle drei Systeme verbindet – 11 Welten, Fraktal-Physik und Unit-Fight, inklusive Runden-Reset nach King-Tod (dein Log-Befund!) und Level-System bis „Ewig":
import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.*;
import java.util.List;

/**
 * M4: "MATRIXGAME TOTAL" – Welten-Hub mit HARMONIE ALS GLOBALER WÄHRUNG.
 * Vereint M1 (11 Welten + Neuronenkolonie), M2 (Fraktal-Physik) und
 * Unit-Fight (v5) in einem Frame mit der globalen SchoenerZoomKamera.
 *
 * DIE HARMONIE-WÄHRUNG (HarmoniePunkte, HP):
 *   VERDIENEN:  +2 HP  Wissensaustausch (Erde)   +3 HP  Neuronen ausrichten (Erde)
 *               +5 HP  Kampf-Runde gewonnen      +1 HP  Oktett-Zerfall beobachtet
 *               +10 HP Welt geheilt (Harmonie >= 70)
 *   AUSGEBEN:   -20 HP Welt heilen (Dogscape-Rettung erzwingen / Eis tauen)
 *               -15 HP Kolonie-Mitose-Boost (Energie +0.5 für alle Zellen einer Welt)
 *               -30 HP Kampf-Team heilen (+50 HP für alle eigenen Units)
 *
 * LEVEL-SYSTEM (XP): Normal -> Heldenhaft -> Legendär (M1) -> Göttlich (M2)
 *   -> MORE THAN GODLIKE -> EWIG (M4-Abschluss: 10000 XP)
 *
 * RUNDEN-RESET (Fix aus dem Tick-Log): Stirbt ein King, endet die Runde,
 *   der Sieger wird geehrt, alle Kampf-Units respawnen, die Kolonien-Behalten
 *   ihre gelernten Gewichte (Eigen-Evolution überlebt die Runde!).
 *
 * Start:  javac M4_MatrixGameTotal.java
 *         java M4_MatrixGameTotal
 */
public class M4_MatrixGameTotal extends JPanel {

    // ====== Globale Kamera (aus M3) ======
    static class SchoenerZoomKamera {
        double zoomFactor = 1.0, feinheit = 70, PAN_STEP;
        static final double ZOOM_STEP = 1.2;
        double angleX = 0.25, angleY = 0.0;
        int panX, panY, w = 1600, h = 1000;
        static final double FOCAL = 580, Z_OFF = 340;
        SchoenerZoomKamera() { PAN_STEP = feinheit; }
        void resize(int w, int h) { this.w = w; this.h = h; }
        void zoomIn()  { zoomFactor *= ZOOM_STEP; PAN_STEP = feinheit / zoomFactor; }
        void zoomOut() { zoomFactor /= ZOOM_STEP; PAN_STEP = feinheit / zoomFactor; }
        Point project(double nx, double ny, double nz) {
            double x1 = nx * Math.cos(angleY) - nz * Math.sin(angleY);
            double z1 = nx * Math.sin(angleY) + nz * Math.cos(angleY);
            double y2 = ny * Math.cos(angleX) - z1 * Math.sin(angleX);
            double z2 = ny * Math.sin(angleX) + z1 * Math.cos(angleX);
            double scale = (FOCAL / (FOCAL + z2 + Z_OFF)) * zoomFactor;
            return new Point((int)(w / 2.0 + panX + x1 * scale), (int)(h / 2.0 + panY + y2 * scale));
        }
    }

    // ====== Neuron (v5, Fettmaster-frei) ======
    static final double LEAK = 0.985, E_MAX = 4.5;
    static final int MAX_CELLS = 48;
    static class BioNeuron {
        double x, y, z, potential, energy = 1.5; int type; boolean isSensor;
        double[] pw = new double[6]; int[] pulses = new int[6];
        BioNeuron(int id, double x, double y, double z, int type, boolean sensor, Random r) {
            this.x = x; this.y = y; this.z = z; this.type = type; isSensor = sensor;
            for (int i = 0; i < 6; i++) pw[i] = (0.2 + r.nextDouble() * 0.8) * (type == -1 ? -1 : 1);
        }
        boolean update() {
            double in = 0;
            for (int i = 0; i < 6; i++) if (pulses[i] == 1) { in += pw[i] * 1.2; pulses[i] = 0; }
            potential = potential * LEAK + in;
            boolean fired = false;
            if (potential >= 1.0 / 1.1) {
                potential = 0; fired = true;
                energy = Math.min(E_MAX, energy + 0.35);
                for (int i = 0; i < 6; i++) pulses[i] = pw[i] > 0 ? -1 : 0;
            } else for (int i = 0; i < 6; i++) if (pulses[i] == -1) pulses[i] = 0;
            energy = Math.max(0.1, energy - 0.0018);
            return fired;
        }
    }

    // ====== Welt (M1-Kopplung) ======
    static class Welt {
        String name; double orbitR, winkel, harmonie = 50;
        final List<BioNeuron> kolonie = new ArrayList<>();
        boolean geheilt;
        Welt(String n, double r, double w, Random rng) {
            name = n; orbitR = r; winkel = w;
            for (int i = 0; i < 5; i++) kolonie.add(new BioNeuron(i, -150 + i * 75, -180, 0, 1, true, rng));
            for (int i = 5; i < 17; i++) kolonie.add(new BioNeuron(i,
                (rng.nextDouble() - 0.5) * 200, (rng.nextDouble() - 0.5) * 150,
                (rng.nextDouble() - 0.5) * 180, rng.nextDouble() > 0.25 ? 1 : -1, false, rng));
        }
        int tickKolonie() {
            int fires = 0;
            for (BioNeuron n : kolonie) if (n.update()) {
                fires++;
                for (BioNeuron t : kolonie) if (t != n && dist(n, t) < 110) t.pulses[0] = 1;
            }
            List<BioNeuron> kids = new ArrayList<>();
            for (BioNeuron n : kolonie) if (!n.isSensor && n.energy >= 3.6 && kolonie.size() + kids.size() < MAX_CELLS) {
                n.energy = 1.2;
                kids.add(new BioNeuron(kolonie.size() + 100,
                    n.x + (Math.random() - 0.5) * 35, n.y + (Math.random() - 0.5) * 35,
                    n.z + (Math.random() - 0.5) * 35, n.type, false, new Random()));
            }
            kolonie.addAll(kids);
            harmonie = Math.max(0, Math.min(100, harmonie + (fires > 3 ? 0.05 : -0.02)));
            if (!geheilt && harmonie >= 70) geheilt = true;
            return fires;
        }
        static double dist(BioNeuron a, BioNeuron b) {
            double dx = a.x-b.x, dy = a.y-b.y, dz = a.z-b.z; return Math.sqrt(dx*dx+dy*dy+dz*dz);
        }
    }

    // ====== Kampf-Unit (v5, normalisiert) ======
    enum Decision { ANGREIFEN, BEWEGEN, VERTEIDIGEN }
    static class Unit {
        static int nextId = 0;
        final int id, team; boolean king;
        double x, y, hp, maxHp, attack, defense;
        Decision last = Decision.BEWEGEN;
        Unit(int team, boolean king, Random rng) {
            id = nextId++; this.team = team; this.king = king;
            maxHp = king ? 300 : 200; hp = maxHp;
            attack = 5 + rng.nextDouble() * 25; defense = 1 + rng.nextDouble() * 5;
            x = (team == 0 ? -6 : 6) + rng.nextDouble() * 3 * (team == 0 ? 1 : -1);
            y = (rng.nextDouble() - 0.5) * 8;
        }
        boolean alive() { return hp > 0; }
    }

    // ====== Fraktal-Körper (M2, stabilisiert) ======
    static final double G = 0.01, DT = 1.0, MIN_DIST = 4.0, MAX_ACC = 0.05;
    static class Fraktal {
        double x, y, vx, vy, mass; int radius; Color color; boolean movable;
        Fraktal(double x, double y, double vx, double vy, double m, int r, Color c, boolean mv) {
            this.x = x; this.y = y; this.vx = vx; this.vy = vy; mass = m; radius = r; color = c; movable = mv;
        }
    }

    // ====== Globaler Zustand ======
    final SchoenerZoomKamera kam = new SchoenerZoomKamera();
    final Random rng = new Random(42);
    final javax.swing.Timer timer = new javax.swing.Timer(30, e -> tick());
    final List<Welt> welten = new ArrayList<>();
    final List<Fraktal> fraktale = new ArrayList<>();
    final List<Unit> units = new ArrayList<>();
    final JTextArea logArea = new JTextArea();
    JLabel hud;

    int ansicht = 0; // 0 Hub, 1 Fraktal, 2 Kampf
    long ticks = 0;
    double harmoniePunkte = 20;   // STARTKAPITAL der globalen Währung
    double xp = 7500;             // aus M1+M2+M3
    int runde = 1, siege = 0, zerfaelle = 0;
    boolean rundeAktiv = true;

    String[] namen = {"Earth", "Dome World", "Alt. Physik", "Gott-Pflanze", "Orakel-Welt",
                      "Billard-Ratten", "Mrd. Menschen", "Asteroidengürtel", "Dogscape",
                      "Zombie-Welt", "Eiswelten"};

    void initAll() {
        for (int i = 0; i < 11; i++) welten.add(new Welt(namen[i], 160 + i * 55, i * (2 * Math.PI / 11), rng));
        // Fraktal-Welt (verdichtet)
        for (int i = 0; i < 60; i++)
            fraktale.add(new Fraktal((rng.nextDouble() - 0.5) * 1800, (rng.nextDouble() - 0.5) * 1200,
                (rng.nextDouble() - 0.5) * 0.4, (rng.nextDouble() - 0.5) * 0.4,
                800 + rng.nextDouble() * 900, 5, new Color(90, 200, 255), true));
        fraktale.add(new Fraktal(0, 0, 0, 0, 40000, 14, new Color(255, 205, 40), false));
        spawnUnits();
    }

    void spawnUnits() {
        Unit.nextId = 0; units.clear();
        for (int i = 0; i < 10; i++) units.add(new Unit(0, false, rng));
        units.add(new Unit(0, true, rng));
        for (int i = 0; i < 10; i++) units.add(new Unit(3, false, rng));
        units.add(new Unit(3, true, rng));
        rundeAktiv = true;
    }

    // ====== Tick ======
    void tick() {
        ticks++;
        kam.angleY += 0.0012;
        // Kolonien aller Welten lernen weiter
        double globalHarmonie = 0;
        for (Welt w : welten) { w.tickKolonie(); globalHarmonie += w.harmonie; }
        globalHarmonie /= welten.size();

        if (ansicht == 1) { // Fraktal-Physik
            int n = fraktale.size();
            double[] ax = new double[n], ay = new double[n];
            for (int i = 0; i < n; i++) {
                if (!fraktale.get(i).movable) continue;
                for (int j = 0; j < n; j++) {
                    if (i == j) continue;
                    Fraktal bi = fraktale.get(i), bj = fraktale.get(j);
                    double dx = bj.x - bi.x, dy = bj.y - bi.y;
                    double r = Math.max(MIN_DIST, Math.hypot(dx, dy));
                    double a = Math.min(MAX_ACC, G * bj.mass / (r * r));
                    ax[i] += a * dx / r; ay[i] += a * dy / r;
                }
            }
            for (int i = 0; i < n; i++) {
                Fraktal f = fraktale.get(i);
                if (f.movable) { f.vx += ax[i] * DT; f.vy += ay[i] * DT; f.x += f.vx * DT; f.y += f.vy * DT; }
                if (f.movable && f.mass > 1500 && Math.hypot(f.x, f.y) < 40 + f.radius) {
                    f.movable = false; zerfaelle++;
                    if (zerfaelle % 5 == 0) { harmoniePunkte += 1; log("+1 HP: Zerfall beobachtet (" + zerfaelle + ". Zerfall)"); }
                }
            }
        }

        if (ansicht == 2 && rundeAktiv) { // Unit-Fight, Entscheidungen aus globaler Harmonie
            double h = globalHarmonie / 100.0;
            for (Unit u : units) {
                if (!u.alive()) continue;
                double roll = rng.nextDouble();
                Decision d = u.hp < u.maxHp * 0.3 ? Decision.VERTEIDIGEN
                    : roll < 0.25 + h * 0.3 ? Decision.ANGREIFEN
                    : roll > 0.6 ? Decision.BEWEGEN : Decision.VERTEIDIGEN;
                u.last = d;
                if (d == Decision.ANGREIFEN) {
                    Unit target = nearestEnemy(u);
                    if (target != null) {
                        target.hp -= Math.max(0, u.attack * (0.5 + h) * (u.king ? 1.5 : 1.0) - target.defense);
                        if (!target.alive() && target.king) { // RUNDEN-RESET!
                            rundeAktiv = false; siege++;
                            harmoniePunkte += 5; xp += 500;
                            log("★ RUNDE " + runde + " BEENDET: Team " + u.team + " siegt! King gefallen.");
                            log("  +5 HP, +500 XP. Respawn in 3 Sekunden – die Kolonien behalten ihre Gewichte!");
                            Timer respawn = new Timer(3000, ev -> { runde++; spawnUnits(); log("▶ RUNDE " + runde + " beginnt. Alle Units respawnen."); });
                            respawn.setRepeats(false); respawn.start();
                        }
                    }
                } else if (d == Decision.BEWEGEN) {
                    u.x += (rng.nextDouble() - 0.5) * 0.3; u.y += (rng.nextDouble() - 0.5) * 0.3;
                } else {
                    u.defense = Math.min(12, u.defense + 0.02);
                }
            }
        }
        updateHUD();
        repaint();
    }

    Unit nearestEnemy(Unit self) {
        Unit best = null; double min = 1e9;
        for (Unit u : units) {
            if (u.team == self.team || !u.alive()) continue;
            double d = Math.hypot(u.x - self.x, u.y - self.y);
            if (d < min) { min = d; best = u; }
        }
        return best;
    }

    // ====== Spieler-Aktionen (Harmonie-Währung) ======
    void aktionWissen() {
        Welt earth = welten.get(0);
        earth.harmonie = Math.min(100, earth.harmonie + 2);
        harmoniePunkte += 2; xp += 25;
        log("Wissensaustausch auf Earth: +2 HP, +25 XP (Earth-Harmonie " + (int) earth.harmonie + ")");
    }
    void aktionAusrichten() {
        Welt earth = welten.get(0);
        for (BioNeuron n : earth.kolonie) if (!n.isSensor && Math.random() < 0.3) n.pulses[2] = 1;
        earth.harmonie = Math.min(100, earth.harmonie + 3);
        harmoniePunkte += 3; xp += 40;
        log("Neuronen ausrichten: Erd-Kolonie feuert, +3 HP, +40 XP");
    }
    void aktionWeltHeilen() {
        if (harmoniePunkte < 20) { log("Nicht genug HarmoniePunkte (20 nötig)."); return; }
        for (Welt w : welten) if (!w.geheilt && w.harmonie < 70) {
            harmoniePunkte -= 20; w.harmonie = 70; w.geheilt = true; xp += 100;
            log("✨ " + w.name + " GEHEILT! -20 HP, +100 XP");
            return;
        }
        log("Alle Welten sind bereits geheilt oder über Harmonie 70.");
    }
    void aktionMitose() {
        if (harmoniePunkte < 15) { log("Nicht genug HarmoniePunkte (15 nötig)."); return; }
        harmoniePunkte -= 15;
        Welt best = welten.get(0);
        for (BioNeuron n : best.kolonie) n.energy = Math.min(E_MAX, n.energy + 0.5);
        log("Mitose-Boost für Earth: -15 HP, alle Zellen +0.5 Energie");
    }
    void aktionTeamHeilen() {
        if (harmoniePunkte < 30) { log("Nicht genug HarmoniePunkte (30 nötig)."); return; }
        harmoniePunkte -= 30;
        for (Unit u : units) if (u.team == 0 && u.alive()) u.hp = Math.min(u.maxHp, u.hp + 50);
        log("Team 0 geheilt: -30 HP, alle blauen Units +50 HP");
    }

    String level() {
        return xp >= 10000 ? "EWIG 🏆" : xp >= 8500 ? "MORE THAN GODLIKE" : xp >= 7500 ? "GÖTTLICH"
             : xp >= 4000 ? "LEGENDÄR" : xp >= 2500 ? "HELDENHAFT" : "NORMAL";
    }

    // ====== Rendering ======
    @Override protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        kam.resize(getWidth(), getHeight());
        g2.setColor(Color.BLACK); g2.fillRect(0, 0, getWidth(), getHeight());

        if (ansicht == 0) { // HUB: 11 Welten
            Point z = kam.project(0, 0, 0);
            int zr = (int)(16 * kam.zoomFactor);
            g2.setColor(new Color(255, 205, 40)); g2.fillOval(z.x - zr, z.y - zr, zr*2, zr*2);
            g2.setColor(Color.WHITE); g2.drawString("Kollektives Bewusstsein", z.x - 60, z.y + zr + 16);
            for (Welt w : welten) {
                Point p = kam.project(Math.cos(w.winkel) * w.orbitR,
                                      Math.sin(w.winkel) * w.orbitR * 0.4,
                                      Math.sin(w.winkel) * 60);
                int glow = (int)(4 + w.harmonie / 12.0 * kam.zoomFactor);
                g2.setColor(new Color(80, 200, 255, 60));
                g2.fillOval(p.x - glow - 6, p.y - glow - 6, (glow+6)*2, (glow+6)*2);
                g2.setColor(w.geheilt ? new Color(120, 255, 140) : new Color(90, 170, 255));
                g2.fillOval(p.x - 6, p.y - 6, 12, 12);
                g2.setColor(Color.WHITE); g2.setFont(new Font("Monospaced", Font.PLAIN, 10));
                g2.drawString(w.name + " H=" + (int) w.harmonie + (w.geheilt ? " ✨" : ""), p.x - 40, p.y - 12);
            }
        } else if (ansicht == 1) { // FRAKTAL
            for (Fraktal f : fraktale) {
                Point p = kam.project(f.x, f.y, 0);
                int r = (int) Math.max(2, f.radius * kam.zoomFactor);
                g2.setColor(f.movable ? f.color : new Color(255, 255, 255));
                g2.fillOval(p.x - r, p.y - r, r*2, r*2);
            }
        } else { // KAMPF
            for (Unit u : units) {
                if (!u.alive()) continue;
                Point p = kam.project(u.x * 60, -u.y * 60, 0);
                int r = Math.max(5, (int)((6 + (u.hp / u.maxHp) * 6) * kam.zoomFactor));
                g2.setColor(u.team == 0 ? new Color(80, 150, 255) : new Color(255, 150, 60));
                g2.fillOval(p.x - r, p.y - r, r*2, r*2);
                if (u.king) { g2.setColor(new Color(255, 215, 0)); g2.setStroke(new BasicStroke(2.5f));
                    g2.drawOval(p.x - r - 4, p.y - r - 4, (r+4)*2, (r+4)*2); g2.setStroke(new BasicStroke(1f)); }
                g2.setColor(Color.WHITE); g2.setFont(new Font("Monospaced", Font.PLAIN, 9));
                g2.drawString(u.id + (u.last == Decision.ANGREIFEN ? " A" : u.last == Decision.VERTEIDIGEN ? " V" : " M"), p.x - 4, p.y - r - 2);
            }
        }

        g2.setColor(Color.WHITE); g2.setFont(new Font("Monospaced", Font.BOLD, 13));
        g2.drawString("M4: MATRIXGAME TOTAL – Harmonie-Währung verbindet alle Welten", 16, 22);
        g2.setFont(new Font("Monospaced", Font.PLAIN, 11)); g2.setColor(new Color(140, 220, 255));
        g2.drawString(String.format(Locale.US,
            "Ansicht %d | HP-Währung: %.0f | XP %.0f | LEVEL: %s | Runde %d | Siege %d | Tick %d",
            ansicht, harmoniePunkte, xp, level(), runde, siege, ticks), 16, 42);
        g2.setColor(new Color(120,120,120));
        g2.drawString("Mausrad=Zoom | Rechts-Drag=Pan | Links-Drag=Rotation", 16, 58);
    }

