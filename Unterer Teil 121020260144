    FightUnit nearestEnemy(FightUnit self) {
        FightUnit best = null;
        double min = Double.MAX_VALUE;
        for (FightUnit u : units) {
            if (u.team == self.team || !u.alive()) continue;
            double d = Math.hypot(u.x - self.x, Math.hypot(u.y - self.y, u.z - self.z));
            if (d < min) { min = d; best = u; }
        }
        return best;
    }

    private int findClosestPort(BioNeuron src, BioNeuron dst) {
        double dx = dst.x - src.x, dy = dst.y - src.y, dz = dst.z - src.z;
        int best = 0; double maxDot = -999;
        for (int i = 0; i < 6; i++) {
            double dot = dx * HEX_DIRECTIONS[i][0] + dy * HEX_DIRECTIONS[i][1] + dz * HEX_DIRECTIONS[i][2];
            if (dot > maxDot) { maxDot = dot; best = i; }
        }
        return best;
    }

    static double dist(BioNeuron a, BioNeuron b) {
        double dx = a.x - b.x, dy = a.y - b.y, dz = a.z - b.z;
        return Math.sqrt(dx * dx + dy * dy + dz * dz);
    }

    // ======================= 3D-Projektion =======================
    private Point project(double nx, double ny, double nz) {
        double x1 = nx * Math.cos(angleY) - nz * Math.sin(angleY);
        double z1 = nx * Math.sin(angleY) + nz * Math.cos(angleY);
        double y2 = ny * Math.cos(angleX) - z1 * Math.sin(angleX);
        double z2 = ny * Math.sin(angleX) + z1 * Math.cos(angleX);
        double scale = (FOCAL / (FOCAL + z2 + Z_OFF)) * zoom;
        return new Point((int) (getWidth() / 2.0 + panX + x1 * scale),
                         (int) (getHeight() / 2.0 + panY + y2 * scale));
    }

    private Point project(BioNeuron n) { return project(n.x, n.y, n.z); }

