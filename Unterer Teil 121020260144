### Erweiterter Java-Code: `MatrixgameCognitiveSwarm.java`

Folgender vollständiger Java-Code erweitert die bisherige Simulation um eine **Funktions- und Lernschicht**. Das Netzwerk erhält die Aufgabe, eine **logische/mathematische Funktion** (z. B. XOR / Mustererkennung) zu erlernen. Sobald das Netz die richtige Antwort findet, steigt die kollektive Harmonie und die erfolgreichen Pfade stabilisieren sich.

```java
import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.List;
import java.util.concurrent.CopyOnWriteArrayList;
import java.util.Random;

/**
 * Matrixgame :: Kognitiver Neuronenschwarm
 * Abtastung von Input-Mustern -> 3D-Verarbeitung -> Output-Berechnung + Plastizität
 */
public class MatrixgameCognitiveSwarm extends JPanel
        implements ActionListener, MouseListener, MouseMotionListener, MouseWheelListener {

    public static double globalFlow = 1.0;
    public static double globalDrive = 1.0;
    public static double globalClarity = 1.0;

    public static class BioNeuron {
        final int id;
        double x, y, z;
        int type;               // +1 anregend, -1 hemmend
        boolean isSensor;
        boolean isOutput;
        double potential = 0.0;
        double baseThreshold = 1.0;
        double energy = 1.2;
        double trust = 0.5;
        int recentSpikes = 0;

        BioNeuron(int id, double x, double y, double z, int type, boolean isSensor, boolean isOutput) {
            this.id = id;
            this.x = x; this.y = y; this.z = z;
            this.type = type;
            this.isSensor = isSensor;
            this.isOutput = isOutput;
        }

        boolean compute(double external) {
            potential += external;
            double effectiveThreshold = baseThreshold / Math.max(0.25, globalFlow);
            boolean fired = false;
            if (potential >= effectiveThreshold) {
                potential = 0.0;
                energy += 0.4 * globalDrive;
                trust = Math.min(1.0, trust + 0.01 * globalClarity);
                recentSpikes++;
                fired = true;
            }
            double decay = 0.0015 / Math.max(0.15, globalClarity);
            energy = Math.max(0.15, energy - decay);
            return fired;
        }
    }

    public static class BioSynapse {
        final BioNeuron source, target;
        double weight;
        double pulse = -1.0;

        BioSynapse(BioNeuron s, BioNeuron t, double w) {
            source = s; target = t; weight = w;
        }
    }

    private final List<BioNeuron> neurons = new CopyOnWriteArrayList<>();
    private final List<BioSynapse> synapses = new CopyOnWriteArrayList<>();
    private final List<BioNeuron> sensors = new CopyOnWriteArrayList<>();
    private final List<BioNeuron> outputs = new CopyOnWriteArrayList<>();

    private int nextId = 500;
    private double collectiveHarmony = 50.0;
    private int score = 0;
    private int totalTrials = 0;

    // Lern-Aufgabe: XOR / Binäres Muster [Input A, Input B] -> Output
    private final int[][] trainingInputs = {{0, 0}, {0, 1}, {1, 0}, {1, 1}};
    private final int[] expectedOutputs = {0, 1, 1, 0};
    private int currentSampleIndex = 0;
    private int tickCounter = 0;

    private double angleX = 0.3, angleY = 0.0, zoom = 1.0;
    private int panX = 0, panY = 0, prevX, prevY;
    private final Random rng = new Random(42);
    private final Timer timer;
    private final double FOCAL = 580, Z_OFF = 340;

    public MatrixgameCognitiveSwarm() {
        setBackground(new Color(7, 9, 14));

        // 1. Sensorik (Grün)
        for (int i = 0; i < 2; i++) {
            BioNeuron s = new BioNeuron(i, -80 + i * 160, -180, 0, 1, true, false);
            neurons.add(s);
            sensors.add(s);
        }

        // 2. Motorik / Output (Lila)
        BioNeuron out = new BioNeuron(99, 0, 180, 0, 1, false, true);
        neurons.add(out);
        outputs.add(out);

        // 3. Verarbeitendes 3D-Reservoir
        for (int i = 2; i < 18; i++) {
            double rx = (rng.nextDouble() - 0.5) * 220;
            double ry = (rng.nextDouble() - 0.5) * 160;
            double rz = (rng.nextDouble() - 0.5) * 180;
            int type = rng.nextDouble() > 0.3 ? 1 : -1;
            neurons.add(new BioNeuron(i, rx, ry, rz, type, false, false));
        }

        rebuildSynapses();
        addMouseListener(this);
        addMouseMotionListener(this);
        addMouseWheelListener(this);

        timer = new Timer(16, this);
        timer.start();
    }

    private void rebuildSynapses() {
        synapses.clear();
        for (BioNeuron a : neurons) {
            for (BioNeuron b : neurons) {
                if (a == b || b.isSensor || a.isOutput) continue;
                double d = dist(a, b);
                if (d < 140 && rng.nextDouble() > 0.35) {
                    double w = (0.2 + rng.nextDouble() * 0.6) * a.type;
                    synapses.add(new BioSynapse(a, b, w));
                }
            }
        }
    }

    private static double dist(BioNeuron a, BioNeuron b) {
        double dx = a.x - b.x, dy = a.y - b.y, dz = a.z - b.z;
        return Math.sqrt(dx * dx + dy * dy + dz * dz);
    }

    @Override
    public void actionPerformed(ActionEvent e) {
        angleY += 0.0015;
        tickCounter++;

        // Alle 60 Ticks neues Testmuster anlegen & Auswertung durchführen
        if (tickCounter % 60 == 0) {
            evaluateAndReward();
            currentSampleIndex = (currentSampleIndex + 1) % trainingInputs.length;
        }

        // 1. Input-Einspeisung aus dem aktuellen Muster
        int[] inPattern = trainingInputs[currentSampleIndex];
        for (int i = 0; i < sensors.size(); i++) {
            if (inPattern[i] == 1 && rng.nextDouble() < 0.6 * globalDrive) {
                sensors.get(i).compute(1.8);
            }
        }

        // 2. Impulsausbreitung & Hebb'sche Plastizität
        double speed = 0.06 * globalDrive;
        for (BioSynapse s : synapses) {
            if (s.pulse >= 0) {
                s.pulse += speed;
                if (s.pulse >= 1.0) {
                    s.pulse = -1.0;
                    boolean targetFired = s.target.compute(s.weight);
                    
                    // Plastizität (STDP / Hebbian Learning)
                    if (targetFired && s.source.recentSpikes > 0) {
                        s.weight += 0.02 * globalDrive; // Synapse verstärken
                    }
                }
            } else if (s.source.potential > 0.8 && rng.nextDouble() < 0.1) {
                s.pulse = 0.0;
            }
        }

        // Spikeregister abklingen lassen
        if (tickCounter % 10 == 0) {
            for (BioNeuron n : neurons) n.recentSpikes = Math.max(0, n.recentSpikes - 1);
        }

        repaint();
    }

    private void evaluateAndReward() {
        totalTrials++;
        int expected = expectedOutputs[currentSampleIndex];
        BioNeuron out = outputs.get(0);
        int predicted = (out.recentSpikes > 2) ? 1 : 0;

        if (predicted == expected) {
            score++;
            collectiveHarmony += 1.5;
            // Belohnungs-Burst: Dopamin / Drive erhöht Synapsenstärke erfolgreicher Pfade
            for (BioSynapse s : synapses) {
                if (s.weight > 0) s.weight *= 1.02;
            }
        } else {
            collectiveHarmony = Math.max(10.0, collectiveHarmony - 0.5);
            // Synaptischer Zerfall bei Nicht-Übereinstimmung
            for (BioSynapse s : synapses) {
                s.weight *= 0.99;
            }
        }
        out.recentSpikes = 0;
    }

    private Point project(BioNeuron n) {
        double x1 = n.x * Math.cos(angleY) - n.z * Math.sin(angleY);
        double z1 = n.x * Math.sin(angleY) + n.z * Math.cos(angleY);
        double y2 = n.y * Math.cos(angleX) - z1 * Math.sin(angleX);
        double z2 = n.y * Math.sin(angleX) + z1 * Math.cos(angleX);
        double scale = (FOCAL / (FOCAL + z2 + Z_OFF)) * zoom;
        int sx = (int) (getWidth() / 2.0 + panX + x1 * scale);
        int sy = (int) (getHeight() / 2.0 + panY + y2 * scale);
        return new Point(sx, sy);
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        // UI Text
        g2.setColor(Color.WHITE);
        g2.setFont(new Font("Monospaced", Font.BOLD, 13));
        g2.drawString("Matrixgame :: Kognitiver Neuronenschwarm", 16, 22);
        g2.setFont(new Font("Monospaced", Font.PLAIN, 11));
        g2.setColor(new Color(140, 220, 255));
        int[] in = trainingInputs[currentSampleIndex];
        g2.drawString(String.format("Aktueller Input: [%d, %d] -> Erwartet: %d", in[0], in[1], expectedOutputs[currentSampleIndex]), 16, 40);
        g2.setColor(new Color(180, 255, 160));
        g2.drawString(String.format("Kognitiver Score: %d / %d | Harmonie: %.1f", score, totalTrials, collectiveHarmony), 16, 56);

        // Synapsen zeichnen
        for (BioSynapse s : synapses) {
            Point p1 = project(s.source);
            Point p2 = project(s.target);
            int alpha = Math.min(220, Math.max(30, (int) (Math.abs(s.weight) * 180)));
            g2.setColor(s.weight >= 0 ? new Color(40, 150, 255, alpha) : new Color(220, 50, 70, alpha));
            g2.drawLine(p1.x, p1.y, p2.x, p2.y);
            if (s.pulse >= 0) {
                int px = (int) (p1.x + (p2.x - p1.x) * s.pulse);
                int py = (int) (p1.y + (p2.y - p1.y) * s.pulse);
                g2.setColor(Color.WHITE);
                g2.fillOval(px - 2, py - 2, 5, 5);
            }
        }

        // Neuronen zeichnen
        for (BioNeuron n : neurons) {
            Point p = project(n);
            int r = Math.max(5, (int) (14 * zoom));
            if (n.isSensor) g2.setColor(new Color(60, 230, 120));
            else if (n.isOutput) g2.setColor(new Color(200, 80, 255));
            else g2.setColor(n.type > 0 ? new Color(30, 130, 250) : new Color(220, 45, 55));
            
            g2.fillOval(p.x - r, p.y - r, r * 2, r * 2);
            g2.setColor(Color.WHITE);
            g2.drawOval(p.x - r, p.y - r, r * 2, r * 2);
            g2.drawString(n.isSensor ? "In" : (n.isOutput ? "Out" : "ID:" + n.id), p.x - 10, p.y - r - 2);
        }
    }

