import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.*;
import java.util.List;

/**
 * M2: "Fraktal-Physik" – Fusion aus KreisPunkt + GravSim2D/3D + MasseKugel + SchönerZoom1.
 *
 * STABILITÄTS-FIXES (KreisPunkt-Sanierung, "nicht verbieten, sondern überbieten"):
 *   1. move() hatte Math.random() als Zeitfaktor -> deterministische Zeit DT.
 *   2. kpbeschNorm() hatte keine Singularitäts-Sicherung -> MIN_DIST-Cap + Kraft-Limit.
 *   3. Positionen (posX = x/8 * Math.random()) -> Massenschwerpunkt, physikalisch korrekt.
 *   4. Zusatzdimensionen: deterministische Leck-Dynamik statt Zufallsschritt.
 *
 * FUSION:
 *   - Fraktaler Körper (KreisPunkt): 8 Unterpunkte (Oktett), 10 Zusatzdimensionen,
 *     Massenschwerpunkt-Update, bei Kollision Zerfall in Unterpunkte sichtbar.
 *   - N-Body-Gravitation aus GravSim (G, DT), Photonen-Orbit, Zerfall (Masse -> Photonen).
 *   - Entropie-Gitter aus BasicEntro steuert die Massenverteilung beim Urknall-Start.
 *   - SchönerZoom-Kamera: Zoom 1.2er-Schritte, Feinheit 70, Pan mit angepasstem PAN_STEP.
 *
 * Start:  javac M2_FraktalPhysik.java
 *         java M2_FraktalPhysik
 */
public class M2_FraktalPhysik extends JPanel implements ActionListener, MouseWheelListener {

    // ====== Physik-Konstanten ======
    static final double G  = 0.01;
    static final double DT = 1.0;
    static final double MIN_DIST = 4.0;      // FIX: Singularitäts-Sicherung
    static final double MAX_ACC  = 0.05;     // FIX: Kraft-Limit gegen Abschuss
    static final int    TIMER_DELAY = 20;

    // ====== Kamera (SchönerZoom1-Fusion) ======
    double zoomFactor = 1.0;
    double feinheit = 70;
    double PAN_STEP = feinheit;
    static final double ZOOM_STEP = 1.2;
    int panX = 0, panY = 0;
    int zoomCenterX = 0, zoomCenterY = 0;

    // ====== Entropie-Gitter (BasicEntro-Fusion) ======
    int[] gitter = new int[100];

    // ====== Fraktaler Körper ======
    static class FraktalKoerper {
        double x, y, z, vx, vy, vz, mass;
        int radius; Color color; boolean movable;
        double[] zusatzdim = new double[10];       // Zusatzdimensionen
        double[] zusatzLeck = new double[10];      // FIX: deterministische Leck-Dynamik
        List<FraktalKoerper> unterpunkte;         // Oktett (8 Unterpunkte), bei Zerfall sichtbar
        FraktalKoerper kern;                      // Referenz zum Kern (falls Unterpunkt)
        long fireCount = 0;

        FraktalKoerper(double x, double y, double z, double vx, double vy, double vz,
                      double mass, int radius, Color color, boolean movable) {
            this.x = x; this.y = y; this.z = z;
            this.vx = vx; this.vy = vy; this.vz = vz;
            this.mass = mass; this.radius = radius; this.color = color; this.movable = movable;
            for (int i = 0; i < 10; i++) { zusatzdim[i] = Math.random(); zusatzLeck[i] = 0.001 * i; }
        }

        /** FIX: Fraktale Unterteilung deterministisch - Massenschwerpunkt statt Zufallsposition. */
        void konstUnterStrukt() {
            unterpunkte = new ArrayList<>();
            double maxM = mass / 8.0;
            double rSeed = new Random((long) (x * 31 + y * 17 + z)).nextDouble(); // deterministisch je Position
            for (int i = 0; i < 8; i++) {
                double m = maxM * (0.3 + 0.7 * ((i % 3) + 1) / 3.0);  // stabile Massenverteilung
                int size = (int) Math.max(1, Math.round(3 * Math.pow(m / Math.max(0.001, maxM), 0.3333)));
                // Oktett-Geometrie: 8 Richtungen eines Würfels (±x ±y ±z)
                int dx = (i & 1) == 0 ? 1 : -1, dy = (i & 2) == 0 ? 1 : -1, dz = (i & 4) == 0 ? 1 : -1;
                double off = 6.0 + rSeed * 2;
                FraktalKoerper u = new FraktalKoerper(
                    x + dx * off, y + dy * off, z + dz * off,
                    vx, vy, vz, m, size, color, true);
                u.kern = this;
                unterpunkte.add(u);
            }
        }

        /** FIX: deterministische Position + Zusatzdimensionen mit Leck (kein Math.random() mehr). */
        void move() {
            if (!movable) return;
            x += vx * DT; y += vy * DT; z += vz * DT;
            for (int i = 0; i < 10; i++)
                zusatzdim[i] = zusatzdim[i] * (1.0 - zusatzLeck[i]) + 0.5 * zusatzLeck[i]; // Regression zur Mitte
        }

        double speed() { return Math.sqrt(vx*vx + vy*vy + vz*vz); }
        double dist(FraktalKoerper o) {
            double dx = x-o.x, dy = y-o.y, dz = z-o.z; return Math.sqrt(dx*dx+dy*dy+dz*dz);
        }
    }

    private final List<FraktalKoerper> bodies = new ArrayList<>();
    private final javax.swing.Timer timer = new javax.swing.Timer(TIMER_DELAY, this);
    private final Random rng = new Random(42);
    private long ticks = 0;
    private int zerfaelle = 0;

    // ====== Initialisierung: Urknall über Entropie-Gitter ======
    void initBodies() {
        // BasicEntro-Start: alles in Zelle 0, einige Entropie-Schritte zur Verteilung
        gitter[0] = 1024 * 1042;
        for (int step = 0; step < 8; step++) {
            for (int i = 0; i < gitter.length; i++) {
                for (int j = 0; j < gitter[i]; j += 512) {
                    double rand = Math.random();
                    if (rand < 0.5 && i < gitter.length - 1) { gitter[i] -= 512; gitter[i+1] += 512; }
                    else if (rand > 0.8 && i < gitter.length - 10) { gitter[i] -= 512; gitter[i+10] += 512; }
                }
            }
        }
        // Körper gemäß Gitterverteilung spawnen (Gitterwert = Masse)
        for (int i = 0; i < gitter.length; i++) {
            if (gitter[i] < 512) continue;
            double gx = (i % 10) * 240 - 1080 + rng.nextDouble() * 60;
            double gy = (i / 10) * 240 - 1080 + rng.nextDouble() * 60;
            double mass = 800.0 + gitter[i] / 100.0;
            Color c = new Color((int)(40 + gitter[i] / 4000.0 * 200) % 255, 200, 255);
            FraktalKoerper b = new FraktalKoerper(gx, gy, (rng.nextDouble() - 0.5) * 100,
                (rng.nextDouble() - 0.5) * 0.4, (rng.nextDouble() - 0.5) * 0.4, 0,
                mass, Math.max(4, (int)(3 + Math.log(mass))), c, true);
            bodies.add(b);
        }
        // Zentralsonne als fester Kern
        bodies.add(new FraktalKoerper(0, 0, 0, 0, 0, 0, 40000, 14, new Color(255, 205, 40), false));
        System.out.println("Urknall: " + bodies.size() + " Körper aus Entropie-Gitter erzeugt.");
    }

    // ====== Physik-Tick ======
    void physics() {
        int n = bodies.size();
        double[] ax = new double[n], ay = new double[n], az = new double[n];
        for (int i = 0; i < n; i++) { ax[i] = ay[i] = az[i] = 0; }
        for (int i = 0; i < n; i++) {
            FraktalKoerper bi = bodies.get(i);
            if (!bi.movable) continue;
            for (int j = 0; j < n; j++) {
                if (i == j) continue;
                FraktalKoerper bj = bodies.get(j);
                double dx = bj.x - bi.x, dy = bj.y - bi.y, dz = bj.z - bi.z;
                double r = Math.max(MIN_DIST, Math.sqrt(dx*dx + dy*dy + dz*dz)); // FIX: Singularitäts-Cap
                double a = Math.min(MAX_ACC, G * bj.mass / (r * r));             // FIX: Kraft-Limit
                ax[i] += a * dx / r; ay[i] += a * dy / r; az[i] += a * dz / r;
            }
        }
        // Zerfall: schnelle, massive, kollidierende Körper zerfallen in ihr Oktett (Fraktal sichtbar!)
        List<FraktalKoerper> neu = new ArrayList<>();
        for (int i = bodies.size() - 1; i >= 0; i--) {
            FraktalKoerper b = bodies.get(i);
            if (b.movable) { b.vx += ax[i] * DT; b.vy += ay[i] * DT; b.vz += az[i] * DT; }
            b.move();
            if (b.unterpunkte == null && b.kern == null && b.mass > 1500 && b.dist(bodies.get(bodies.size()-1)) < 40 + b.radius) {
                b.konstUnterStrukt();       // FIX: deterministische Oktett-Spaltung
                b.movable = false;
                neu.addAll(b.unterpunkte);
                zerfaelle++;
                System.out.println("[Tick " + ticks + "] Zerfall! Körper (m=" + (int)b.mass + ") spaltet in 8 Fraktal-Unterpunkte. Zerfälle gesamt: " + zerfaelle);
            }
        }
        bodies.addAll(neu);
    }

    // ====== Rendering ======
    @Override protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        g2.setColor(Color.BLACK);
        g2.fillRect(0, 0, getWidth(), getHeight());

        for (FraktalKoerper b : bodies) {
            double sx = zoomCenterX + (b.x - zoomCenterX + panX) * zoomFactor + getWidth() / 2.0;
            double sy = zoomCenterY + (b.y - zoomCenterY + panY) * zoomFactor + getHeight() / 2.0;
            int r = (int) Math.max(2, b.radius * zoomFactor);
            // Zusatzdimensionen färben die Helligkeit (10D-Signal sichtbar)
            double dimAvg = 0; for (int i = 0; i < 10; i++) dimAvg += b.zusatzdim[i];
            dimAvg /= 10;
            g2.setColor(new Color(Math.min(255, b.color.getRed() + (int)(dimAvg * 40)),
                                  b.color.getGreen(), b.color.getBlue()));
            g2.fillOval((int)(sx - r), (int)(sy - r), r * 2, r * 2);
            if (b.unterpunkte != null) {  // Kern eines zerfallenen Körpers markieren
                g2.setColor(Color.WHITE);
                g2.drawOval((int)(sx - r - 3), (int)(sy - r - 3), (r + 3) * 2, (r + 3) * 2);
            }
        }
        g2.setColor(Color.WHITE);
        g2.setFont(new Font("Monospaced", Font.BOLD, 13));
        g2.drawString("M2: Fraktal-Physik - KreisPunkt x GravSim x Entropie (stabilisiert)", 16, 22);
        g2.setFont(new Font("Monospaced", Font.PLAIN, 11));
        g2.setColor(new Color(140, 220, 255));
        g2.drawString(String.format(Locale.US,
            "Körper: %d | Zerfälle (Oktett-Spaltungen): %d | Tick %d | Zoom %.2f | Fettmaster-frei durch MIN_DIST & MAX_ACC",
            bodies.size(), zerfaelle, ticks, zoomFactor), 16, 42);
    }

    // ====== Kamera-Steuerung (SchönerZoom-Fusion) ======
    void zoomIn()  { zoomFactor *= ZOOM_STEP; PAN_STEP = feinheit / zoomFactor; repaint(); }
    void zoomOut() { zoomFactor /= ZOOM_STEP; PAN_STEP = feinheit / zoomFactor; repaint(); }

    @Override public void mouseWheelMoved(MouseWheelEvent e) {
        if (e.getWheelRotation() < 0) zoomIn(); else zoomOut();
    }

    @Override public void actionPerformed(ActionEvent e) {
        ticks++;
        physics();
        repaint();
    }

    public M2_FraktalPhysik() {
        setPreferredSize(new Dimension(1600, 1000));
        setBackground(Color.BLACK);
        initBodies();
        addMouseWheelListener(this);
        timer.start();
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            JFrame f = new JFrame("M2 - Fraktal-Physik (Fusion-Sprint Szenario 2)");
            f.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
            M2_FraktalPhysik sim = new M2_FraktalPhysik();
            f.setLayout(new BorderLayout());
            f.add(sim, BorderLayout.CENTER);

            JPanel ctrl = new JPanel(new FlowLayout(FlowLayout.CENTER, 12, 6));
            ctrl.setBackground(new Color(15, 18, 26));
            JButton zin = new JButton("Zoom In"), zout = new JButton("Zoom Out");
            JButton left = new JButton("← Links"), right = new JButton("Rechts →");
            JButton up = new JButton("↑ Hoch"), down = new JButton("↓ Runter");
            JButton zerfall = new JButton("Erzwinge Zerfall (größter Körper)");
            zin.addActionListener(ev -> sim.zoomIn());
            zout.addActionListener(ev -> sim.zoomOut());
            left.addActionListener(ev -> { sim.panX += sim.PAN_STEP; sim.repaint(); });
            right.addActionListener(ev -> { sim.panX -= sim.PAN_STEP; sim.repaint(); });
            up.addActionListener(ev -> { sim.panY += sim.PAN_STEP; sim.repaint(); });
            down.addActionListener(ev -> { sim.panY -= sim.PAN_STEP; sim.repaint(); });
            zerfall.addActionListener(ev -> {
                FraktalKoerper best = null;
                for (FraktalKoerper b : sim.bodies)
                    if (b.unterpunkte == null && b.kern == null && b.movable && (best == null || b.mass > best.mass)) best = b;
                if (best != null) {
                    best.konstUnterStrukt(); best.movable = false;
                    sim.bodies.addAll(best.unterpunkte); sim.zerfaelle++;
                    System.out.println("Manueller Zerfall: Körper spaltet in 8 Fraktal-Unterpunkte.");
                }
            });
            for (JButton b : new JButton[]{zin, zout, left, right, up, down, zerfall}) ctrl.add(b);
            f.add(ctrl, BorderLayout.NORTH);

            f.setSize(1600, 1000);
            f.setLocationRelativeTo(null);
            f.setVisible(true);
        });
    }
}

