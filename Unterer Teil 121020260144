                    }
                }

            // Units mit Trails
            for (Unit u : world.units) {
                g2.setColor(new Color(205, 215, 235, 45));
                for (int t = 1; t < u.trail.size(); t++) {
                    double[] p1 = u.trail.get(t - 1), p2 = u.trail.get(t);
                    g2.drawLine(px(p1[0]), py(p1[1]), px(p2[0]), py(p2[1]));
                }
                int r = 5 + (int) (u.state.goalProgress * 0.5);
                Color col = driveColor(u.neuro.modulate(u.state.intrinsicDrive()));
                g2.setColor(new Color(col.getRed(), col.getGreen(), col.getBlue(), 60));
                g2.fillOval(px(u.x) - r - 4, py(u.y) - r - 4, (r + 4) * 2, (r + 4) * 2);
                g2.setColor(col);
                g2.fillOval(px(u.x) - r, py(u.y) - r, r * 2, r * 2);
                g2.setColor(new Color(230, 240, 255)); g2.drawOval(px(u.x) - r, py(u.y) - r, r * 2, r * 2);
            }

            // HUD
            g2.setColor(new Color(8, 13, 23, 215));
            g2.fillRoundRect(14, 14, 470, 118, 14, 14);
            g2.setColor(new Color(90, 180, 255));
            g2.setFont(new Font(Font.SANS_SERIF, Font.BOLD, 15));
            g2.drawString("MATRIXGAME · LIVE CANVAS v4", 28, 36);
            g2.setColor(Color.WHITE);
            g2.setFont(new Font(Font.MONOSPACED, Font.PLAIN, 12));
            g2.drawString("Tick " + world.tick + " | Units " + world.units.size()
                + " | Strategie " + world.strategy
                + " | Entropie " + String.format(Locale.US, "%.2f", world.entropy), 28, 58);
            g2.drawString("Ø Antrieb " + String.format(Locale.US, "%.2f", world.avgDrive)
                + " | Ø Neuro-Persistenz " + String.format(Locale.US, "%.3f", world.avgPersistence)
                + " | Koop-Links " + world.coopLinks, 28, 78);
            g2.drawString("Kohäsion " + String.format(Locale.US, "%.2f", world.socialCohesion)
                + " | Zoom " + String.format(Locale.US, "%.2f", zoom), 28, 98);
            g2.setColor(new Color(205, 215, 235));
            g2.setFont(new Font(Font.SANS_SERIF, Font.PLAIN, 11));
            g2.drawString("Farbe = Antrieb (rot niedrig → grün hoch) · Größe = Zielfortschritt · Linien = Kooperation", 28, 120);
            g2.dispose();
        }

        Color driveColor(double d) {
            double t = Math.max(0, Math.min(1, d / 10.0));
            int r = (int) (240 - t * 200), gg = (int) (80 + t * 150), b = 90;
