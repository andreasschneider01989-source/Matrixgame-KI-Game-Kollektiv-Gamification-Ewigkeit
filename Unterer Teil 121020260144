<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Matrixgame - Infinity Canvas & Neuronen-Evolution</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #0d1117;
            font-family: 'Courier New', Courier, monospace;
        }
        canvas {
            display: block;
        }
        #ui-layer {
            position: absolute;
            top: 10px;
            left: 10px;
            color: #58a6ff;
            pointer-events: none;
            background: rgba(13, 17, 23, 0.8);
            padding: 10px;
            border: 1px solid #30363d;
            border-radius: 5px;
        }
    </style>
</head>
<body>

    <div id="ui-layer">
        <h3>Matrixgame: Neuronen-Simulation</h3>
        <p>Steuerung: Klicken & Ziehen zum Bewegen | Mausrad zum Zoomen</p>
        <p>Ressourcen-Punkte: <span id="score">0</span></p>
        <p>Aktiver Prozess: Sequenz-Analyse [3, 4, 6, 8, 10] -> [12, 14, 16]</p>
    </div>

    <canvas id="infinityCanvas"></canvas>

    <script>
        const canvas = document.getElementById('infinityCanvas');
        const ctx = canvas.getContext('2d');
        const scoreElement = document.getElementById('score');

        // Kamera-Variablen für den Infinity Canvas
        let camera = { x: 0, y: 0, zoom: 1 };
        let isDragging = false;
        let dragStart = { x: 0, y: 0 };
        let score = 0;

        // Anpassung an Fenstergröße
        function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            // Kamera zentrieren beim Start
            if(camera.x === 0 && camera.y === 0) {
                camera.x = canvas.width / 2;
                camera.y = canvas.height / 2;
            }
        }
        window.addEventListener('resize', resize);
        resize();

        // Datenstrukturen für Neuronen und Synapsen (Verknüpfungen)
        class Neuron {
            constructor(id, x, y, value, color, type) {
                this.id = id;
                this.x = x;
                this.y = y;
                this.value = value;
                this.color = color;
                this.type = type; // 'input', 'processing', 'output'
                this.activation = 0;
                this.radius = 25;
            }

            draw(ctx) {
                // Pulsierender Effekt basierend auf Aktivierung
                let currentRadius = this.radius + Math.sin(Date.now() / 200 + this.x) * 3 * this.activation;
                
                ctx.beginPath();
                ctx.arc(this.x, this.y, currentRadius, 0, Math.PI * 2);
                ctx.fillStyle = this.color;
                ctx.fill();
                ctx.lineWidth = 3;
                ctx.strokeStyle = '#ffffff';
                ctx.stroke();

                // Text (Wert des Neurons)
                ctx.fillStyle = '#ffffff';
                ctx.font = '16px Courier New';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                ctx.fillText(this.value, this.x, this.y);
            }
        }

        class Synapse {
            constructor(source, target, weight) {
                this.source = source;
                this.target = target;
                this.weight = weight;
                this.particles = [];
            }

            update() {
                // Simuliere Neurotransmitter-Fluss (Entropie-Verknüpfung)
                if (Math.random() < 0.05 * this.weight) {
                    this.particles.push(0); // Partikel startet bei 0 (Source)
                }
                for (let i = 0; i < this.particles.length; i++) {
                    this.particles[i] += 0.02; // Geschwindigkeit
                    if (this.particles[i] >= 1) {
                        this.particles.splice(i, 1);
                        i--;
                        // Ziel-Neuron aktivieren & Punkte sammeln
                        this.target.activation = 1;
                        if(this.target.type === 'output') {
                            score += 10;
                            scoreElement.innerText = score;
                        }
                    }
                }
            }

            draw(ctx) {
                ctx.beginPath();
                ctx.moveTo(this.source.x, this.source.y);
                ctx.lineTo(this.target.x, this.target.y);
                ctx.lineWidth = 2 * this.weight;
                ctx.strokeStyle = 'rgba(88, 166, 255, 0.3)';
                ctx.stroke();

                // Zeichne fließende Signale
                for (let p of this.particles) {
                    let curX = this.source.x + (this.target.x - this.source.x) * p;
                    let curY = this.source.y + (this.target.y - this.source.y) * p;
                    ctx.beginPath();
                    ctx.arc(curX, curY, 4, 0, Math.PI * 2);
                    ctx.fillStyle = '#58a6ff';
                    ctx.fill();
                }
            }
        }

        // Initialisierung des Netzwerks (Das Rätsel-Modul)
        let neurons = [];
        let synapses = [];

        // Input-Reihe: 3, 4, 6, 8, 10
        const inputs = [3, 4, 6, 8, 10];
        let inputNodes = [];
        for(let i=0; i<inputs.length; i++) {
            let n = new Neuron("in_"+i, -300, -200 + i * 100, inputs[i], '#238636', 'input');
            n.activation = 1; // Daueraktiv
            neurons.push(n);
            inputNodes.push(n);
        }

        // Zentrales Verarbeitungsneuron (Kollektive Logik)
        let processorNode = new Neuron("proc", 0, 0, "LOGIK", '#8957e5', 'processing');
        neurons.push(processorNode);

        // Output-Erwartung: 12, 14, 16 (Evolution/Bonus)
        const outputs = [12, 14, 16];
        let outputNodes = [];
        for(let i=0; i<outputs.length; i++) {
            let n = new Neuron("out_"+i, 300, -100 + i * 100, outputs[i], '#d29922', 'output');
            neurons.push(n);
            outputNodes.push(n);
        }

        // Verknüpfungen erstellen
        for(let n of inputNodes) {
            synapses.push(new Synapse(n, processorNode, 1.5));
        }
        for(let n of outputNodes) {
            synapses.push(new Synapse(processorNode, n, 2.0));
        }

        // Event Listeners für Infinity Canvas Steuerung
        canvas.addEventListener('mousedown', (e) => {
            isDragging = true;
            dragStart.x = e.clientX / camera.zoom - camera.x;
            dragStart.y = e.clientY / camera.zoom - camera.y;
        });

        canvas.addEventListener('mousemove', (e) => {
            if (isDragging) {
                camera.x = e.clientX / camera.zoom - dragStart.x;
                camera.y = e.clientY / camera.zoom - dragStart.y;
            }
        });

        canvas.addEventListener('mouseup', () => isDragging = false);
        canvas.addEventListener('mouseleave', () => isDragging = false);

        canvas.addEventListener('wheel', (e) => {
            const zoomAmount = 0.1;
            const mouseX = e.clientX;
            const mouseY = e.clientY;

            // Zoom-Fokus auf Mausposition
            const wheel = e.deltaY < 0 ? 1 : -1;
            const zoomRatio = Math.exp(wheel * zoomAmount);
            
            camera.x = mouseX - (mouseX - camera.x * camera.zoom) * zoomRatio / camera.zoom;
            camera.y = mouseY - (mouseY - camera.y * camera.zoom) * zoomRatio / camera.zoom;
            
            camera.zoom *= zoomRatio;
        });

        // Haupt-Simulations-Schleife (Game Loop)
        function animate() {
            // Hintergrund löschen
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Canvas Transformation anwenden (Kamera)
            ctx.save();
            ctx.translate(camera.x * camera.zoom, camera.y * camera.zoom);
            ctx.scale(camera.zoom, camera.zoom);

            // Grid zeichnen für Raumorientierung
            ctx.strokeStyle = '#30363d';
            ctx.lineWidth = 1 / camera.zoom;
            const gridSize = 100;
            const left = -camera.x - canvas.width / camera.zoom;
            const right = -camera.x + canvas.width * 2 / camera.zoom;
            const top = -camera.y - canvas.height / camera.zoom;
            const bottom = -camera.y + canvas.height * 2 / camera.zoom;

            ctx.beginPath();
            for (let x = Math.floor(left / gridSize) * gridSize; x < right; x += gridSize) {
                ctx.moveTo(x, top);
                ctx.lineTo(x, bottom);
            }
            for (let y = Math.floor(top / gridSize) * gridSize; y < bottom; y += gridSize) {
                ctx.moveTo(left, y);
                ctx.lineTo(right, y);
            }
            ctx.stroke();

            // Logik Update & Zeichnen
            for(let n of neurons) {
                n.activation *= 0.95; // Aktivierung klingt langsam ab
            }

            for(let s of synapses) {
                s.update();
                s.draw(ctx);
            }

            for(let n of neurons) {
                n.draw(ctx);
            }

            ctx.restore();
            requestAnimationFrame(animate);
        }

        // Start
        animate();
    </script>
</body>
</html>

