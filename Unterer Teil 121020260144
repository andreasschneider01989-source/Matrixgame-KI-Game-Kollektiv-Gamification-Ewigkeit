                canvas.repaint();
            });

            solve.addActionListener(e -> {
                boolean awarded = world.quest.solve();

                world.status = awarded
                    ? "Quest gelöst: korrekte Vorhersagen. +100 Punkte."
                    : "Referenzregel +2 bestätigt; keine doppelten Punkte.";

