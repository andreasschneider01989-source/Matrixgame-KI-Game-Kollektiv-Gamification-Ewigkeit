/**
 * MatrixGame v4 – LIVE-Simulation mit bewegten Units im Visual Canvas
 *
 * Kompilieren und starten:
 *   javac MatrixGame_v4.java
 *   java MatrixGame_v4
 *
 * NEU gegenüber v3.1:
 *   1. Units haben jetzt Positionen (x/y) und Geschwindigkeiten und BEWEGEN
 *      SICH live im Canvas: Lernen = zur Wissensquelle, Erholen = nach Hause,
 *      Kooperieren = zum nächsten Nachbarn, Erkunden = Zufallsweg.
 *      Kooperations-Verbindungen werden als Linien sichtbar gezeichnet.
 *   2. Steuerung im Fenster: Strategie wählen, Entropie-Regler,
 *      Geschwindigkeits-Regler, Pause/Weiter, Neue Welt, Reset-Ansicht.
 *   3. NEURO-FIX: Neurotransmitter bauen jetzt pro Tick auch wieder ab
 *      (-0.03), wodurch die Persistenz sich erholen kann. In v3.1 blieb
 *      der Transmitter dauerhaft > 2 -> Persistenz sank monoton auf 0.40
 *      (Toleranz ohne Erholung). Das war die Ursache für den niedrigen
 *      effektiven Antrieb (~3.4) in deiner Ausgabe.
 *
 * Drag = verschieben, Mausrad = Zoom, Doppelklick = Ansicht zurücksetzen.
 * Alle Zahlen und Gewichte sind explizite Modellannahmen – keine empirisch
 * validierten Gesetze, keine medizinische Aussagekraft.
 */
public class MatrixGame_v4 {

    static final int    UNITS        = 24;
    static final double WORLD_SIZE   = 500.0;
    static final double COOP_RADIUS  = 90.0;

    // ======================= State =======================
    static final class State {
        double joy = 5, happiness = 5, interest = 5, motivation = 5,
               discipline = 5, autonomy = 5, competence = 5,
               vitality = 5, goalProgress = 0, cooperation = 5;

        void normalize() {
            joy=cl(joy); happiness=cl(happiness); interest=cl(interest);
            motivation=cl(motivation); discipline=cl(discipline);
            autonomy=cl(autonomy); competence=cl(competence);
            vitality=cl(vitality); goalProgress=cl(goalProgress);
            cooperation=cl(cooperation);
        }
        double intrinsicDrive() {
            return 0.20 * interest + 0.20 * joy + 0.15 * autonomy
                 + 0.15 * competence + 0.15 * vitality + 0.15 * happiness;
        }
    }

    static double cl(double v) { return Math.max(0.0, Math.min(10.0, v)); }

    // ======================= NeuroLayer (mit Erholung, FIX) =======================
    static final class NeuroLayer {
        double transmitter = 1.0;
        double reuptake = 0.0;
        double persistence = 1.0;

        double boost() { return 1.0 / (1.0 + Math.exp(-(transmitter * 2.0 - 1.0))); }

        void tick(double driveStimulus) {
            transmitter += 0.04 + 0.02 * (driveStimulus / 10.0);
            transmitter -= 0.03;                       // FIX: Abbau -> Erholung möglich
            transmitter = Math.max(0.2, Math.min(3.0, transmitter));
            reuptake = Math.min(0.9, reuptake + 0.004);
            if (transmitter > 2.0) persistence = Math.max(0.5, persistence * 0.995);
            else if (transmitter < 0.8) persistence = Math.min(1.0, persistence * 1.004);
        }

        double modulate(double baseDrive) {
            double v = baseDrive * (1.0 + boost() * 0.15) * persistence;
            return Math.max(0.0, Math.min(15.0, v));
        }
    }

    // ======================= Strategien & Aktionen =======================
    enum Action { LEARN, REST, COOPERATE, EXPLORE }
    enum Strategy { BALANCED, GRIND, SOCIAL, CURIOUS }

    static Action chooseAction(Strategy st, State s) {
        if (s.vitality < 3.5) return Action.REST;
        return switch (st) {
            case GRIND   -> Action.LEARN;
            case SOCIAL  -> Action.COOPERATE;
            case CURIOUS -> Action.EXPLORE;
            default -> {
                if (s.interest < 4.5)     yield Action.EXPLORE;
                if (s.cooperation < 5.0) yield Action.COOPERATE;
                yield Action.LEARN;
            }
        };
    }

    // ======================= Unit mit Position und Bewegung =======================
    static final class Unit {
        final State state = new State();
        final NeuroLayer neuro = new NeuroLayer();
        double x, y, vx, vy;
        final double homeX, homeY;
        final List<double[]> trail = new ArrayList<>();

        Unit(Random rnd) {
            x = rnd.nextDouble() * WORLD_SIZE;
            y = rnd.nextDouble() * WORLD_SIZE;
            vx = 0; vy = 0;
            homeX = x; homeY = y;
        }

        double dist(Unit o) { return Math.hypot(x - o.x, y - o.y); }

        void moveToward(double tx, double ty, double speed) {
            double d = Math.hypot(tx - x, ty - y);
            if (d > 1) { vx += (tx - x) / d * speed; vy += (ty - y) / d * speed; }
        }

        void step(double entropy, Random rnd) {
            vx *= 0.85; vy *= 0.85;
            vx += (rnd.nextDouble() - 0.5) * entropy * 1.2;
            vy += (rnd.nextDouble() - 0.5) * entropy * 1.2;
            x = Math.max(0, Math.min(WORLD_SIZE, x + vx));
            y = Math.max(0, Math.min(WORLD_SIZE, y + vy));
            trail.add(new double[]{x, y});
            if (trail.size() > 25) trail.remove(0);
        }
    }

    // ======================= Live-Welt =======================
    static final class LiveWorld {
        final List<Unit> units = new ArrayList<>();
        final Random rnd;
        Strategy strategy = Strategy.CURIOUS;
        double entropy = 0.2;
        double socialCohesion = 0.5;
        double avgDrive = 5, avgPersistence = 1;
        int tick = 0, coopLinks = 0;

        LiveWorld(long seed) {
            this.rnd = new Random(seed);
            for (int i = 0; i < UNITS; i++) units.add(new Unit(rnd));
        }

        void tick() {
            tick++;
            // Wissensquelle in der Mitte: Anziehungspunkt für LEARN
            double cx = WORLD_SIZE / 2, cy = WORLD_SIZE / 2;
            coopLinks = 0;

            for (int i = 0; i < units.size(); i++) {
                Unit u = units.get(i);
                Action a = chooseAction(strategy, u.state);
                switch (a) {
                    case LEARN -> {
                        u.moveToward(cx, cy, 1.6);
                        u.state.goalProgress += 1.0; u.state.competence += 0.4;
                        u.state.vitality -= 0.35; u.state.joy += 0.2;
                    }
                    case REST -> {
                        u.moveToward(u.homeX, u.homeY, 0.9);
                        u.state.vitality += 0.8; u.state.joy += 0.3; u.state.happiness += 0.2;
                    }
                    case COOPERATE -> {
                        Unit n = nearest(u, i);
                        if (n != null) {
                            u.moveToward(n.x, n.y, 1.3);
                            if (u.dist(n) < COOP_RADIUS) {
                                coopLinks++;
                                n.state.happiness = cl(n.state.happiness + 0.1);
                                n.state.cooperation = cl(n.state.cooperation + 0.15);
                            }
                        }
                        u.state.cooperation += 0.4; u.state.goalProgress += 0.4; u.state.joy += 0.3;
                    }
                    case EXPLORE -> {
                        u.vx += (rnd.nextDouble() - 0.5) * 2.4;
                        u.vy += (rnd.nextDouble() - 0.5) * 2.4;
                        u.state.interest += 0.6; u.state.autonomy += 0.25;
                        u.state.goalProgress += 0.3; u.state.vitality -= 0.2;
                    }
                }
                u.state.motivation = 0.4 * u.state.interest + 0.3 * u.state.competence + 0.3 * u.state.vitality;
                u.state.normalize();
                u.neuro.tick(u.state.intrinsicDrive());
                u.step(entropy, rnd);
            }
            // Spillover: Kooperation hebt die Gruppe
            if (coopLinks > 0) socialCohesion = Math.min(1.0, socialCohesion + 0.01);
            avgDrive = units.stream().mapToDouble(u -> u.neuro.modulate(u.state.intrinsicDrive())).average().orElse(5);
            avgPersistence = units.stream().mapToDouble(u -> u.neuro.persistence).average().orElse(1);
        }

        Unit nearest(Unit self, int selfIdx) {
            Unit best = null; double min = Double.MAX_VALUE;
            for (int i = 0; i < units.size(); i++) {
                if (i == selfIdx) continue;
                double d = self.dist(units.get(i));
                if (d < min) { min = d; best = units.get(i); }
            }
            return best;
        }
    }

    // ======================= Live Canvas =======================
    static final class LiveCanvas extends JPanel {
        final LiveWorld world;
        double zoom = 1, panX = 0, panY = 0;
        int lastX, lastY;

        LiveCanvas(LiveWorld world) {
            this.world = world;
            setBackground(new Color(10, 15, 26));

            MouseAdapter m = new MouseAdapter() {
                public void mousePressed(MouseEvent e) { lastX = e.getX(); lastY = e.getY(); }
                public void mouseDragged(MouseEvent e) {
                    panX += e.getX() - lastX; panY += e.getY() - lastY;
                    lastX = e.getX(); lastY = e.getY(); repaint();
                }
                public void mouseClicked(MouseEvent e) {
                    if (e.getClickCount() == 2) { zoom = 1; panX = 0; panY = 0; repaint(); }
                }
            };
            addMouseListener(m); addMouseMotionListener(m);
            addMouseWheelListener((MouseWheelEvent e) -> {
                zoom *= Math.pow(1.12, -e.getPreciseWheelRotation());
                zoom = Math.max(0.2, Math.min(6.0, zoom)); repaint();
            });
        }

        int px(double x) { return (int) (x * zoom + panX + 60); }
        int py(double y) { return (int) (y * zoom + panY + 40); }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2 = (Graphics2D) g.create();
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
