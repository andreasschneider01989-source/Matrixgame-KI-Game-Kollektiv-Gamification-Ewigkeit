    // ---------- Projection helpers ----------
    private double projectZ(BioNeuron n) {
        double zRot = n.x * Math.sin(angleY) + n.z * Math.cos(angleY);
        return zRot;
    }

    private double scaleFactor(BioNeuron n) {
        double zRot = n.x * Math.sin(angleY) + n.z * Math.cos(angleY);
        return FOCAL / (FOCAL + zRot + Z_OFFSET) * zoom;
    }

    private Point project(BioNeuron n) {
        double xRot = n.x * Math.cos(angleY) - n.z * Math.sin(angleY);
        double yRot = n.y * Math.cos(angleX) - (n.x * Math.sin(angleY) + n.z * Math.cos(angleY)) * Math.sin(angleX);
        double zRot = n.x * Math.sin(angleY) + n.z * Math.cos(angleY);
        double scale = FOCAL / (FOCAL + zRot + Z_OFFSET) * zoom;
        int sx = (int) (getWidth() / 2 + panX + xRot * scale);
        int sy = (int) (getHeight() / 2 + panY + yRot * scale);
        return new Point(sx, sy);
    }

    private static double dist(BioNeuron a, BioNeuron b) {
        double dx = a.x - b.x, dy = a.y - b.y, dz = a.z - b.z;
        return Math.sqrt(dx*dx + dy*dy + dz*dz);
    }

