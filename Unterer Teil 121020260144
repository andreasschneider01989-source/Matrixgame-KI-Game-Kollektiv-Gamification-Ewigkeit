    private void interact(boolean isAlignment, String idxText) {
        if (current != WorldType.EARTH) { logLine("Interaktion nur auf der Erde verfügbar (Spieler lebt dort)."); return; }
        if (player.demonizationLevel > 15) { logLine("Dämonisierung zu hoch - bitte meditieren."); return; }
        int idx;
        try { idx = Integer.parseInt(idxText.trim()); } catch (NumberFormatException ex) { logLine("Ungültiger Index."); return; }
        World w = world(WorldType.EARTH);
        if (idx <= 0 || idx >= w.humans.length) { logLine("Index muss zwischen 1 und " + (w.humans.length - 1) + " liegen."); return; }
        Human target = w.humans[idx];
        if (isAlignment) {
            double pa = player.neuronAlignment, ta = target.neuronAlignment;
            player.align(target);
            // Kopplung: neuronale Anziehung feuert die Erd-Kolonie
            for (BioNeuron n : w.colony) if (!n.isSensor && n.type == 1 && Math.random() < 0.3) n.portPulses[2] = 1;
            w.harmony = Math.min(100, w.harmony + 1.0);
            logLine(String.format(Locale.US, "Ausrichtung mit Mensch %d: Spieler %.1f -> %.1f | Ziel %.1f -> %.1f",
                idx, pa, player.neuronAlignment, ta, target.neuronAlignment));
        } else {
            player.exchangeKnowledge(target);
            w.harmony = Math.min(100, w.harmony + 0.5);
            logLine(String.format(Locale.US, "Wissensaustausch mit Mensch %d: Spieler %.2f | Ziel %.2f",
                idx, player.networkedKnowledge, target.networkedKnowledge));
        }
        checkEarthScenarios();
        updateStats();
    }

    private void healEarth() {
        if (current != WorldType.EARTH) { logLine("Heilen nur auf der Erde möglich."); return; }
        World w = world(WorldType.EARTH);
        for (int i = 1; i < w.humans.length; i++) {
            double k = w.humans[i].networkedKnowledge, kp = player.networkedKnowledge;
            w.humans[i].exchangeKnowledge(player);
            w.humans[i].networkedKnowledge = k; player.networkedKnowledge = kp; // Spieler-Wissen unverändert
        }
        double total = 0;
        for (int i = 1; i < w.humans.length; i++) total += w.humans[i].networkedKnowledge;
        double avg = total / (w.humans.length - 1);
        if (avg > w.type.level * 1.2) {
            int red = Math.min(10, player.demonizationLevel);
            player.demonizationLevel -= red;
            logLine("Intervention erfolgreich! Dämonisierung -" + red + " Punkte. Frühkindliche Traumata heilen.");
        } else logLine("Intervention noch nicht erfolgreich - weiter positive Interaktionen aufbauen.");
        updateStats();
    }

    private void checkEarthScenarios() {
        int d = player.demonizationLevel;
        if (d > 0 && d < 5) logLine("Szenario: herausfordernde Kindheit erkennbar.");
        else if (d >= 5 && d < 15) logLine("Szenario: schulische/soziale Leistung leidet.");
        else if (d >= 15 && d < 30) logLine("Szenario: erhebliche Probleme in Schule, Uni und Arbeit.");
        else if (d >= 30) logLine("Szenario: unaufgearbeitetes Trauma beeinträchtigt alles - sofortige Intervention nötig.");
    }

    private void updateStats() {
        World w = world(current);
        stats.setText(String.format(Locale.US,
            "Welt: %s | Harmonie %.1f | Zellen %d | Spieler: Wissen %.2f, Leben %d, Dämonisierung %d | Tick %d",
            current.label, w.harmony, w.colony.size(),
            player.networkedKnowledge, player.life, player.demonizationLevel, tick));
    }

    private void logLine(String s) { log.append(s + "\n"); log.setCaretPosition(log.getDocument().getLength()); }

    @Override public void actionPerformed(ActionEvent e) {
        tick++;
        String effect = world(current).tick();
        if (tick % 10 == 0) { logLine("[Tick " + tick + "] " + effect); updateStats(); }
    }

