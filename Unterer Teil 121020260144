import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.Random;

/**
 * MatrixGame v2 – Kollektiv-Simulator (Version 2 der Ensemble-Architektur)
 *
 * Kompilieren und starten:
 *   javac MatrixGame_v2.java
 *   java MatrixGame_v2
 *
 * Voraussetzungen: Java 17+. Keine externen Bibliotheken.
 *
 * Struktur (anknüpfend an Ration A bis D):
 *   - State:   intrinsische Motivation messbar (Freude, Interesse, Disziplin, ...)
 *   - World:   eine simulierte Welt mit einem Akteur, Seed-gesteuert (Ration A)
 *   - Ensemble: N parallele Zukünfte pro Strategie, Aggregation (Ration D)
 *   - Insights:  extrahierte Kennzahlen (Vorhersage-Güte, Überlebensrate, ...)
 *
 * Alle Zahlen und Gewichte sind explizite Modellannahmen – keine empirisch
 * validierten psychologischen Gesetze. Jede Annahme ist widerlegbar und
 * austauschbar. Das ist der wissenschaftliche Kern.
 */
public class MatrixGame_v2 {

    // ======================= Konfiguration =======================
    static final int   WORLDS_PER_STRATEGY = 64;   // Größe des Ensembles
    static final int   TURNS               = 40;    // Runden pro Welt
    static final double ENTROPY            = 0.15; // Störungsstärke (0 = deterministisch)
    static final long  SEED_BASE           = 42L;  // reproduzierbare Basis

    // ======================= State =======================
    /**
     * Intrinsische Motivation einer Unit, messbar, Bereich 0..10.
     * Felder bewusst als double: kontinuierlich, optimierbar (Newton,
     * multiplikative Updates, Ensemble-Mittelung).
     */
    static final class State {
        double joy          = 5.0;  // Freude
        double happiness    = 5.0;  // Wohlbefinden
        double interest     = 5.0;  // Interesse
        double motivation   = 5.0;  // Handlungsbereitschaft
        double discipline   = 5.0;  // Dranbleiben
        double autonomy     = 5.0;  // Selbstbestimmung
        double competence   = 5.0;  // Wirksamkeit
        double vitality     = 5.0;  // Energie
        double goalProgress = 0.0;  // Zielfortschritt
        double cooperation  = 5.0;  // Kollektiv-Anschluss

        static final String[] FIELDS = {
            "joy","happiness","interest","motivation","discipline",
            "autonomy","competence","vitality","goalProgress","cooperation"
        };

        double get(String f) {
            return switch (f) {
                case "joy" -> joy; case "happiness" -> happiness;
                case "interest" -> interest; case "motivation" -> motivation;
                case "discipline" -> discipline; case "autonomy" -> autonomy;
                case "competence" -> competence; case "vitality" -> vitality;
                case "goalProgress" -> goalProgress; default -> cooperation;
            };
        }

        void set(String f, double v) {
            switch (f) {
                case "joy" -> joy = v; case "happiness" -> happiness = v;
                case "interest" -> interest = v; case "motivation" -> motivation = v;
                case "discipline" -> discipline = v; case "autonomy" -> autonomy = v;
                case "competence" -> competence = v; case "vitality" -> vitality = v;
                case "goalProgress" -> goalProgress = v; default -> cooperation = v;
            }
        }

        void normalize() {
            for (String f : FIELDS) set(f, clamp(get(f)));
        }

        /** Modellkennzahl des Gesamtantriebs (Gewichte = Annahme). */
        double intrinsicDrive() {
            return 0.20 * interest + 0.20 * joy + 0.15 * autonomy
                 + 0.15 * competence + 0.15 * vitality + 0.15 * happiness;
        }

        State copy() {
            State s = new State();
            for (String f : FIELDS) s.set(f, get(f));
            return s;
        }
    }

    // ======================= Aktionen & Strategien =======================
    enum Action { LEARN, REST, COOPERATE, EXPLORE }

    enum Strategy { BALANCED, GRIND, SOCIAL, CURIOUS }

    /** Transparente Entscheidungsschicht – später durch lernende Agenten ersetzbar. */
    static Action chooseAction(Strategy st, State s) {
        if (s.vitality < 3.5) return Action.REST;  // Überlebensschutz zuerst
        return switch (st) {
            case GRIND   -> Action.LEARN;
            case SOCIAL  -> Action.COOPERATE;
            case CURIOUS -> Action.EXPLORE;
            default -> {
                if (s.interest < 4.5)   yield Action.EXPLORE;
                if (s.cooperation < 5.0) yield Action.COOPERATE;
                yield Action.LEARN;
            }
        };
    }

    // ======================= Welt =======================
    /** Eine simulierte Welt: ein Akteur, eigener Random-Seed (Ration A). */
    static final class World {
        final State state = new State();
        final Random rnd;
        final double entropy;
        double resources = 10.0;
        int turn = 0;
        boolean survived = true;
        final Map<Action, Integer> actionCounts = new HashMap<>();
        final List<Double> driveHistory = new ArrayList<>();

        World(long seed, double entropy) {
            this.rnd = new Random(seed);
            this.entropy = entropy;
            // Startzustand: leicht gestörte Neutralität (Ensemble-Diversität)
            for (String f : State.FIELDS) {
                if (!f.equals("goalProgress"))
                    state.set(f, clamp(5.0 + (rnd.nextDouble() - 0.5) * entropy * 10.0));
            }
            for (Action a : Action.values()) actionCounts.put(a, 0);
        }

        void tick(Action a) {
            turn++;
            resources -= 0.15 + rnd.nextDouble() * 0.1;
            actionCounts.merge(a, 1, Integer::sum);

            switch (a) {
                case LEARN -> {
                    state.goalProgress += 1.2;
                    state.competence += 0.5;
                    state.vitality -= 0.7 + entropy * rnd.nextDouble() * 0.6;
                    state.joy += 0.2;
                }
                case REST -> {
                    state.vitality += 1.0;
                    state.joy += 0.3;
                    state.happiness += 0.2;
                }
                case COOPERATE -> {
                    state.cooperation += 0.7;
                    state.goalProgress += 0.6;
                    state.joy += 0.3;
                    state.happiness += 0.1 * (state.cooperation / 10.0);
                }
                case EXPLORE -> {
                    state.interest += 0.8;
                    state.autonomy += 0.3;
                    state.goalProgress += 0.4;
                    state.vitality -= 0.3;
                }
            }

            // randEntropie: gelegentliche Störung eines zufälligen Feldes
            if (rnd.nextDouble() < entropy * 0.15) {
                String f = State.FIELDS[rnd.nextInt(State.FIELDS.length)];
                state.set(f, state.get(f) + (rnd.nextDouble() - 0.5) * 3.0 * entropy);
            }

            // Motivation reagiert modellhaft auf Interesse, Kompetenz, Energie
            state.motivation = 0.4 * state.interest + 0.3 * state.competence + 0.3 * state.vitality;

            state.normalize();
            resources = clamp(resources);

            driveHistory.add(state.intrinsicDrive());

            if (state.vitality <= 0.05 || resources <= 0.05) survived = false;
        }
    }

    // ======================= Ensemble (Ration D) =======================
    /**
     * Aggregierte Kennzahlen über N parallele Zukünfte einer Strategie.
     * Dies ist die "kollektive Strategie-Bibliothek": pro Feld wird der
     * Durchschnitt (und später: der beste Welt-Parametersatz) festgehalten.
     */
    static final class Ensemble {
        final Strategy strategy;
        final int worlds;
        final double avgDrive, avgGoal, avgCooperation, avgVitality, avgJoy;
        final double survivalRate;
        final double driveVariance;      // Vorhersage-Güte: niedrig = berechenbar
        final Map<String, Double> fieldAverages = new HashMap<>();

        Ensemble(Strategy st, List<World> ws) {
            this.strategy = st;
            this.worlds = ws.size();
            this.avgDrive        = ws.stream().mapToDouble(w -> w.state.intrinsicDrive()).average().orElse(0);
            this.avgGoal         = ws.stream().mapToDouble(w -> w.state.goalProgress).average().orElse(0);
            this.avgCooperation   = ws.stream().mapToDouble(w -> w.state.cooperation).average().orElse(0);
            this.avgVitality      = ws.stream().mapToDouble(w -> w.state.vitality).average().orElse(0);
            this.avgJoy           = ws.stream().mapToDouble(w -> w.state.joy).average().orElse(0);
            this.survivalRate     = ws.stream().filter(w -> w.survived).count() / (double) worlds;
            // Varianz des Endantriebs: Maß für Berechenbarkeit der Trajektorien
            this.driveVariance    = ws.stream()
                .mapToDouble(w -> { double d = w.state.intrinsicDrive() - avgDrive; return d * d; })
                .average().orElse(0);
            for (String f : State.FIELDS)
                fieldAverages.put(f, ws.stream().mapToDouble(w -> w.state.get(f)).average().orElse(0));
        }

        /** Kollektive Kennzahl: Antrieb × Überlebensrate. */
        double score() { return avgDrive * survivalRate; }
    }

    // ======================= Simulation & Insights =======================
    static Ensemble runEnsemble(Strategy st, int n, long seedBase, double entropy, int turns) {
        List<World> worlds = new ArrayList<>();
        for (int i = 0; i < n; i++) {
            World w = new World(seedBase + i * 7919L, entropy);
            for (int t = 0; t < turns && w.survived; t++)
                w.tick(chooseAction(st, w.state));
            worlds.add(w);
        }
        return new Ensemble(st, worlds);
    }

    /** extractInsights: Ration A1 – wenige, klare Zahlen pro Strategie. */
    static void printInsights(Ensemble e) {
        System.out.printf(Locale.GERMANY,
            "%nStrategie: %-9s | Welten: %d%n" +
            "  Ø Antrieb %.2f | Ø Ziel %.2f | Ø Kooperation %.2f | Ø Vitalität %.2f%n" +
            "  Überlebensrate %.1f%% | Score %.2f | Antriebs-Varianz %.3f (niedrig = berechenbar)%n",
            e.strategy, e.worlds,
            e.avgDrive, e.avgGoal, e.avgCooperation, e.avgVitality,
            e.survivalRate * 100, e.score(), e.driveVariance);
        StringBuilder sb = new StringBuilder("  End-State: ");
        for (String f : State.FIELDS)
            sb.append(String.format(Locale.GERMANY, "%s=%.2f ", f, e.fieldAverages.get(f)));
        System.out.println(sb);
    }

    static double clamp(double v) { return Math.max(0.0, Math.min(10.0, v)); }

    // ======================= main =======================
    public static void main(String[] args) {
        System.out.println("=== MatrixGame v2 – Kollektiv-Simulator ===");
        System.out.printf(Locale.GERMANY,
            "Ensemble: %d Welten/Strategie | %d Runden | Entropie %.2f | Seed-Basis %d%n",
            WORLDS_PER_STRATEGY, TURNS, ENTROPY, SEED_BASE);
        System.out.println("Hinweis: Alle Regeln und Gewichte sind Startannahmen, "
            + "keine empirisch validierten Gesetze.");

        Strategy[] all = Strategy.values();
        Ensemble[] results = new Ensemble[all.length];
        long t0 = System.currentTimeMillis();
        for (int i = 0; i < all.length; i++)
            results[i] = runEnsemble(all[i], WORLDS_PER_STRATEGY,
                SEED_BASE + (i + 1) * 1_000_003L, ENTROPY, TURNS);
        long ms = System.currentTimeMillis() - t0;

        for (Ensemble e : results) printInsights(e);

        // Ranking nach kollektiver Kennzahl
        System.out.println("%n=== Ranking (Score = Ø Antrieb × Überlebensrate) ===".replace("%n", "\n"));
        java.util.Arrays.stream(results)
            .sorted((a, b) -> Double.compare(b.score(), a.score()))
            .forEach(e -> System.out.printf(Locale.GERMANY,
                "  %-9s Score %.2f%n", e.strategy, e.score()));

        System.out.printf(Locale.GERMANY,
            "%nRechenzeit gesamt: %d ms (%.2f ms/Welt)%n",
            ms, ms / (double) (WORLDS_PER_STRATEGY * all.length));

        // Nächste Schritte (Ration D): erfolgreiche Parameter der besten Strategie
        // als Startwerte der nächsten Generation zurück schreiben -> Evolutionsschleife.
        System.out.println("\nNächste Ration: kollektive Strategie-Bibliothek – "
            + "Bestwelten der Gewinnerstrategie als Startzustand von Generation 2 verwenden.");
    }
}



