            bodies.add(b);
        }
        // Zentralsonne als fester Kern
        bodies.add(new FraktalKoerper(0, 0, 0, 0, 0, 0, 40000, 14, new Color(255, 205, 40), false));
        System.out.println("Urknall: " + bodies.size() + " Körper aus Entropie-Gitter erzeugt.");
    }

    // ====== Physik-Tick ======
    void physics() {
        int n = bodies.size();
        double[] ax = new double[n], ay = new double[n], az = new double[n];
        for (int i = 0; i < n; i++) { ax[i] = ay[i] = az[i] = 0; }
        for (int i = 0; i < n; i++) {
            FraktalKoerper bi = bodies.get(i);
            if (!bi.movable) continue;
            for (int j = 0; j < n; j++) {
                if (i == j) continue;
                FraktalKoerper bj = bodies.get(j);
                double dx = bj.x - bi.x, dy = bj.y - bi.y, dz = bj.z - bi.z;
                double r = Math.max(MIN_DIST, Math.sqrt(dx*dx + dy*dy + dz*dz)); // FIX: Singularitäts-Cap
                double a = Math.min(MAX_ACC, G * bj.mass / (r * r));             // FIX: Kraft-Limit
                ax[i] += a * dx / r; ay[i] += a * dy / r; az[i] += a * dz / r;
            }
        }
        // Zerfall: schnelle, massive, kollidierende Körper zerfallen in ihr Oktett (Fraktal sichtbar!)
        List<FraktalKoerper> neu = new ArrayList<>();
        for (int i = bodies.size() - 1; i >= 0; i--) {
            FraktalKoerper b = bodies.get(i);
            if (b.movable) { b.vx += ax[i] * DT; b.vy += ay[i] * DT; b.vz += az[i] * DT; }
            b.move();
            if (b.unterpunkte == null && b.kern == null && b.mass > 1500 && b.dist(bodies.get(bodies.size()-1)) < 40 + b.radius) {
                b.konstUnterStrukt();       // FIX: deterministische Oktett-Spaltung
                b.movable = false;
                neu.addAll(b.unterpunkte);
                zerfaelle++;
                System.out.println("[Tick " + ticks + "] Zerfall! Körper (m=" + (int)b.mass + ") spaltet in 8 Fraktal-Unterpunkte. Zerfälle gesamt: " + zerfaelle);
            }
        }
        bodies.addAll(neu);
    }

    // ====== Rendering ======
    @Override protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        g2.setColor(Color.BLACK);
        g2.fillRect(0, 0, getWidth(), getHeight());

        for (FraktalKoerper b : bodies) {
            double sx = zoomCenterX + (b.x - zoomCenterX + panX) * zoomFactor + getWidth() / 2.0;
            double sy = zoomCenterY + (b.y - zoomCenterY + panY) * zoomFactor + getHeight() / 2.0;
            int r = (int) Math.max(2, b.radius * zoomFactor);
            // Zusatzdimensionen färben die Helligkeit (10D-Signal sichtbar)
            double dimAvg = 0; for (int i = 0; i < 10; i++) dimAvg += b.zusatzdim[i];
            dimAvg /= 10;
            g2.setColor(new Color(Math.min(255, b.color.getRed() + (int)(dimAvg * 40)),
                                  b.color.getGreen(), b.color.getBlue()));
            g2.fillOval((int)(sx - r), (int)(sy - r), r * 2, r * 2);
            if (b.unterpunkte != null) {  // Kern eines zerfallenen Körpers markieren
                g2.setColor(Color.WHITE);
                g2.drawOval((int)(sx - r - 3), (int)(sy - r - 3), (r + 3) * 2, (r + 3) * 2);
            }
        }
        g2.setColor(Color.WHITE);
        g2.setFont(new Font("Monospaced", Font.BOLD, 13));
        g2.drawString("M2: Fraktal-Physik - KreisPunkt x GravSim x Entropie (stabilisiert)", 16, 22);
        g2.setFont(new Font("Monospaced", Font.PLAIN, 11));
        g2.setColor(new Color(140, 220, 255));
        g2.drawString(String.format(Locale.US,
            "Körper: %d | Zerfälle (Oktett-Spaltungen): %d | Tick %d | Zoom %.2f | Fettmaster-frei durch MIN_DIST & MAX_ACC",
            bodies.size(), zerfaelle, ticks, zoomFactor), 16, 42);
    }

    // ====== Kamera-Steuerung (SchönerZoom-Fusion) ======
    void zoomIn()  { zoomFactor *= ZOOM_STEP; PAN_STEP = feinheit / zoomFactor; repaint(); }
    void zoomOut() { zoomFactor /= ZOOM_STEP; PAN_STEP = feinheit / zoomFactor; repaint(); }

    @Override public void mouseWheelMoved(MouseWheelEvent e) {
        if (e.getWheelRotation() < 0) zoomIn(); else zoomOut();
    }

    @Override public void actionPerformed(ActionEvent e) {
        ticks++;
        physics();
        repaint();
    }

    public M2_FraktalPhysik() {
        setPreferredSize(new Dimension(1600, 1000));
        setBackground(Color.BLACK);
