package ordner1;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.*;
import java.util.List;

/**
 * Matrixgame Infinity Canvas 2.0
 * Java 17+, keine externen Bibliotheken.
 *
 * Enthalten:
 * - 3D-Neuronen mit individuellen Funktionen
 * - Sechs gerichtete Raumverbindungen pro Neuron
 * - Stabiler Signalfluss und begrenzte Aktivierungen
 * - Bewegliche, zoombare 3D-Projektion
 * - Zahlenquest und nachvollziehbare Fitness
 * - Evolution durch Mutation und Selektion
 * - Persönliche Organisationsquest als separates Modul
 */
public class MatrixgameInfinityCanvas {

    static final Random RNG = new Random();
    static final int START_NEURONS = 48;
    static final double WORLD_LIMIT = 260.0;
    static final double LINK_RADIUS = 100.0;

    enum FunctionType {
        SUM, DIFFERENCE, PRODUCT, MEMORY, DECAY
    }

    // ---------- 3D-Mathematik ----------

    static final class Vec3 {
        double x, y, z;

        Vec3(double x, double y, double z) {
            this.x = x;
            this.y = y;
            this.z = z;
        }

        Vec3 add(Vec3 b) {
            return new Vec3(x + b.x, y + b.y, z + b.z);
        }

        Vec3 scale(double k) {
            return new Vec3(x * k, y * k, z * k);
        }

        double distance(Vec3 b) {
            double dx = x - b.x;
            double dy = y - b.y;
            double dz = z - b.z;
            return Math.sqrt(dx * dx + dy * dy + dz * dz);
        }

        void clamp() {
            x = Math.max(-WORLD_LIMIT, Math.min(WORLD_LIMIT, x));
            y = Math.max(-WORLD_LIMIT, Math.min(WORLD_LIMIT, y));
            z = Math.max(-WORLD_LIMIT, Math.min(WORLD_LIMIT, z));
        }
    }

    // ---------- Neuron ----------

    static final class Neuron {
        final int id;
        Vec3 p, v;

        FunctionType function;
        double activation, memory, bias;
        final Neuron[] links = new Neuron[6];
        final double[] weights = new double[6];

        Neuron(int id, Vec3 p) {
            this.id = id;
            this.p = p;

            v = new Vec3(
                RNG.nextDouble() - 0.5,
                RNG.nextDouble() - 0.5,
                RNG.nextDouble() - 0.5
            );

            function = FunctionType.values()[
                RNG.nextInt(FunctionType.values().length)
            ];

            bias = RNG.nextDouble() * 0.4 - 0.2;

            for (int i = 0; i < 6; i++) {
                weights[i] = RNG.nextDouble() * 0.8 - 0.4;
            }
        }

        double compute(Map<Integer, Double> snapshot) {
            double sum = bias;
            double product = 1.0;
            int count = 0;

            for (int i = 0; i < 6; i++) {
                Neuron source = links[i];
                if (source == null) continue;

                double input = snapshot.getOrDefault(source.id, 0.0);
                double signal = input * weights[i];

                sum += signal;
                product *= 1.0
                    + Math.max(-0.5, Math.min(0.5, signal));
                count++;
            }

            double raw;

            switch (function) {
                case DIFFERENCE:
                    raw = count == 0 ? bias : sum / count;
                    break;

                case PRODUCT:
                    raw = count == 0 ? bias : product - 1.0 + bias;
                    break;

                case MEMORY:
                    memory = 0.90 * memory + 0.10 * sum;
                    raw = memory;
                    break;

                case DECAY:
                    raw = 0.82 * sum;
                    break;

                default:
                    raw = sum;
            }

            // Verhindert unkontrolliert anwachsende Aktivierungen.
            activation = Math.tanh(raw);
            return activation;
        }

        void mutate() {
            if (RNG.nextDouble() < 0.12) {
                function = FunctionType.values()[
                    RNG.nextInt(FunctionType.values().length)
                ];
            }

            for (int i = 0; i < 6; i++) {
                if (RNG.nextDouble() < 0.20) {
                    weights[i] = clamp(
                        weights[i] + RNG.nextGaussian() * 0.12,
                        -1.0, 1.0
                    );
                }
            }

            if (RNG.nextDouble() < 0.15) {
                bias = clamp(
                    bias + RNG.nextGaussian() * 0.08,
                    -0.8, 0.8
                );
            }
        }
    }

    static double clamp(double x, double min, double max) {
        return Math.max(min, Math.min(max, x));
    }

    // ---------- Zahlenquest ----------

    static final class NumberQuest {
        final int[] examples = {3, 4, 6, 8, 10};
        final int[] expected = {12, 14, 16};

        int candidateStep = 2;
        int bestFitness = 0;
        int resources = 0;
        boolean solved = false;

        int fitness(int step) {
            int score = 0;

            // Bewertung der beobachteten Differenzen.
            for (int i = 1; i < examples.length; i++) {
                int difference = examples[i] - examples[i - 1];
                if (difference == step) score++;
            }

            // Drei unabhängige Vorhersagen bewerten.
            for (int i = 0; i < expected.length; i++) {
                int prediction = 10 + step * (i + 1);
                if (prediction == expected[i]) score += 2;
            }

            return score; // Maximum: 9
        }

        void evolve() {
            int currentFitness = fitness(candidateStep);
            int proposal = candidateStep
                + (RNG.nextBoolean() ? 1 : -1);

            proposal = Math.max(1, Math.min(5, proposal));

            int proposedFitness = fitness(proposal);

            // Bessere Kandidaten bevorzugen.
            // Gelegentlich schlechtere Kandidaten zulassen,
            // damit die Suche nicht vollständig lokal bleibt.
            if (proposedFitness >= currentFitness
                    || RNG.nextDouble() < 0.10) {
                candidateStep = proposal;
            }

            bestFitness = Math.max(
                bestFitness, fitness(candidateStep)
            );
        }

        boolean solve() {
            if (solved) return false;

            candidateStep = 2;

            if (fitness(candidateStep) == 9) {
                solved = true;
                resources += 100;
                bestFitness = 9;
                return true;
            }

            return false;
        }
    }

    // ---------- Simulationswelt ----------

    static final class World {
        final List<Neuron> neurons = new ArrayList<>();
        final NumberQuest quest = new NumberQuest();

        int tick = 0;
        int generation = 1;
        String status = "Matrixgame initialisiert.";

        World() {
            reset();
        }

        void reset() {
            neurons.clear();
            tick = 0;
            generation = 1;

            quest.candidateStep = 2;
            quest.bestFitness = 0;
            quest.resources = 0;
            quest.solved = false;

            for (int i = 0; i < START_NEURONS; i++) {
                double angle = RNG.nextDouble() * Math.PI * 2;
                double radius = 40 + RNG.nextDouble() * 150;

                Vec3 position = new Vec3(
                    Math.cos(angle) * radius,
                    Math.sin(angle) * radius,
                    (RNG.nextDouble() - 0.5) * 180
                );

                neurons.add(new Neuron(i, position));
            }

            rebuildLinks();
            status = "Neue Welt: Signale, Bewegung und Evolution aktiv.";
        }

        // Slots: +X, -X, +Y, -Y, +Z, -Z
        void rebuildLinks() {
            for (Neuron n : neurons) {
                Arrays.fill(n.links, null);
            }

            for (Neuron n : neurons) {
                double[] bestDistance = {
                    LINK_RADIUS, LINK_RADIUS, LINK_RADIUS,
                    LINK_RADIUS, LINK_RADIUS, LINK_RADIUS
                };

                for (Neuron other : neurons) {
                    if (n == other) continue;

                    double dx = other.p.x - n.p.x;
                    double dy = other.p.y - n.p.y;
                    double dz = other.p.z - n.p.z;

                    double distance = n.p.distance(other.p);
                    if (distance < 0.0001 || distance > LINK_RADIUS) {
                        continue;
                    }

                    int slot;
                    double ax = Math.abs(dx);
                    double ay = Math.abs(dy);
                    double az = Math.abs(dz);

                    if (ax >= ay && ax >= az) {
                        slot = dx >= 0 ? 0 : 1;
                    } else if (ay >= az) {
                        slot = dy >= 0 ? 2 : 3;
                    } else {
                        slot = dz >= 0 ? 4 : 5;
                    }

                    if (distance < bestDistance[slot]) {
                        bestDistance[slot] = distance;
                        n.links[slot] = other;
                    }
                }
            }

            // Neue Verbindungen erhalten vorsichtige Gewichte.
            for (Neuron n : neurons) {
                for (int i = 0; i < 6; i++) {
                    if (n.links[i] == null) continue;

                    if (Math.abs(n.weights[i]) < 0.01) {
                        n.weights[i] = RNG.nextDouble() * 0.4 - 0.2;
                    }
                }
            }
        }

        void step() {
            Map<Integer, Double> snapshot = new HashMap<>();

            for (Neuron n : neurons) {
                snapshot.put(n.id, n.activation);
            }

            // Erst alle neuen Werte berechnen, danach übernehmen.
            double[] next = new double[neurons.size()];

            for (int i = 0; i < neurons.size(); i++) {
                next[i] = neurons.get(i).compute(snapshot);
            }

            for (int i = 0; i < neurons.size(); i++) {
                neurons.get(i).activation = next[i];
            }

            // Begrenzte Bewegung und leichte Zufallsfluktuation.
            for (Neuron n : neurons) {
                Vec3 center = new Vec3(
                    -n.p.x * 0.0003,
                    -n.p.y * 0.0003,
                    -n.p.z * 0.0003
                );

                n.v.x += center.x + (RNG.nextDouble() - 0.5) * 0.015;
                n.v.y += center.y + (RNG.nextDouble() - 0.5) * 0.015;
                n.v.z += center.z + (RNG.nextDouble() - 0.5) * 0.015;

                n.v.x *= 0.985;
                n.v.y *= 0.985;
                n.v.z *= 0.985;

                n.p = n.p.add(n.v);
                n.p.clamp();
            }

            if (tick % 15 == 0) {
                rebuildLinks();
            }

            tick++;
        }

        void evolve() {
            for (Neuron n : neurons) {
                n.mutate();
            }

            quest.evolve();
            generation++;
            rebuildLinks();

            status = "Generation " + generation
                + " | Fitness " + quest.fitness(quest.candidateStep)
                + "/9 | Schrittweite " + quest.candidateStep;
        }

        double meanActivation() {
            if (neurons.isEmpty()) return 0;

            double total = 0;
            for (Neuron n : neurons) {
                total += Math.abs(n.activation);
            }

            return total / neurons.size();
        }
    }

    // ---------- Infinity Canvas ----------

    static final class CanvasPanel extends JPanel {
        final World world;

        double zoom = 1.0;
        double panX = 0, panY = 0;
        int lastX, lastY;
        boolean dragging = false;
        boolean running = true;

        CanvasPanel(World world) {
            this.world = world;

            setBackground(new Color(9, 14, 25));
            setFocusable(true);

            addMouseListener(new MouseAdapter() {
                @Override
                public void mousePressed(MouseEvent e) {
                    dragging = true;
                    lastX = e.getX();
                    lastY = e.getY();
                }

                @Override
                public void mouseReleased(MouseEvent e) {
                    dragging = false;
                }

                @Override
                public void mouseClicked(MouseEvent e) {
                    if (e.getClickCount() == 2) {
                        zoom = 1;
                        panX = 0;
                        panY = 0;
                        repaint();
                    }
                }
            });

            addMouseMotionListener(new MouseMotionAdapter() {
                @Override
                public void mouseDragged(MouseEvent e) {
                    if (!dragging) return;

                    panX += e.getX() - lastX;
                    panY += e.getY() - lastY;

                    lastX = e.getX();
                    lastY = e.getY();
                    repaint();
                }
            });

            addMouseWheelListener(e -> {
                zoom *= Math.pow(1.12, -e.getPreciseWheelRotation());
                zoom = clamp(zoom, 0.15, 4.0);
                repaint();
            });
        }

        Point project(Vec3 p) {
            double sx = (p.x - p.y * 0.48) * zoom
                + getWidth() / 2.0 + panX;

            double sy = (p.x * 0.28 + p.y * 0.28 - p.z * 0.72)
                * zoom + getHeight() / 2.0 + panY;

            return new Point((int) sx, (int) sy);
        }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);

            Graphics2D g2 = (Graphics2D) g.create();
            g2.setRenderingHint(
                RenderingHints.KEY_ANTIALIASING,
                RenderingHints.VALUE_ANTIALIAS_ON
            );

            drawGrid(g2);
            drawConnections(g2);
            drawNeurons(g2);
            drawHud(g2);

            g2.dispose();
        }

        void drawGrid(Graphics2D g) {
            int gap = Math.max(15, (int) (48 * zoom));

            int ox = Math.floorMod(
                (int) (getWidth() / 2.0 + panX), gap
            );
            int oy = Math.floorMod(
                (int) (getHeight() / 2.0 + panY), gap
            );

            g.setColor(new Color(29, 43, 63));

            for (int x = ox; x < getWidth(); x += gap) {
                g.drawLine(x, 0, x, getHeight());
            }

            for (int y = oy; y < getHeight(); y += gap) {
                g.drawLine(0, y, getWidth(), y);
            }

            g.setColor(new Color(60, 90, 130));
            g.drawLine(
                0, getHeight() / 2 + (int) panY,
                getWidth(), getHeight() / 2 + (int) panY
            );
        }

        void drawConnections(Graphics2D g) {
            for (Neuron n : world.neurons) {
                Point a = project(n.p);

                for (int i = 0; i < 6; i++) {
                    Neuron target = n.links[i];
                    if (target == null || n.id >= target.id) continue;

                    Point b = project(target.p);

                    float strength = (float) Math.min(
                        1.0, Math.abs(n.weights[i])
                    );

                    g.setStroke(new BasicStroke(1.0f + strength));
                    g.setColor(new Color(
                        65, 145, 225, 45 + (int) (strength * 110)
                    ));

                    g.drawLine(a.x, a.y, b.x, b.y);

                    // Kleine Partikel symbolisieren Signalaktivität.
                    if (Math.abs(n.activation) > 0.12) {
                        double t = (world.tick % 40) / 40.0;

                        int px = (int) (a.x + (b.x - a.x) * t);
                        int py = (int) (a.y + (b.y - a.y) * t);

                        g.setColor(new Color(100, 220, 255, 190));
                        g.fillOval(px - 2, py - 2, 5, 5);
                    }
                }
            }
        }

        void drawNeurons(Graphics2D g) {
            for (Neuron n : world.neurons) {
                Point p = project(n.p);
                int r = (int) (5 + Math.abs(n.activation) * 6);

                Color c = n.activation > 0.2
                    ? new Color(65, 220, 130)
                    : n.activation < -0.2
                    ? new Color(255, 160, 85)
                    : new Color(105, 145, 215);

                g.setColor(new Color(
                    c.getRed(), c.getGreen(), c.getBlue(), 35
                ));
                g.fillOval(p.x - r - 5, p.y - r - 5,
                    (r + 5) * 2, (r + 5) * 2);

                g.setColor(c);
                g.fillOval(p.x - r, p.y - r, r * 2, r * 2);

                g.setColor(Color.WHITE);
                g.drawOval(p.x - r, p.y - r, r * 2, r * 2);

                g.setFont(new Font(Font.MONOSPACED, Font.PLAIN, 9));
                g.drawString("N" + n.id, p.x + r + 2, p.y - 2);
            }
        }

        void drawHud(Graphics2D g) {
            g.setColor(new Color(8, 13, 23, 230));
            g.fillRoundRect(14, 14, 520, 184, 14, 14);

            g.setColor(new Color(90, 190, 255));
            g.setFont(new Font(Font.SANS_SERIF, Font.BOLD, 16));
            g.drawString("MATRIXGAME | INFINITY CANVAS 2.0", 28, 39);

            g.setFont(new Font(Font.MONOSPACED, Font.PLAIN, 12));
            g.setColor(Color.WHITE);

            g.drawString(
                "Neuronen: " + world.neurons.size()
                    + " | Tick: " + world.tick
                    + " | Zoom: " + String.format(Locale.US, "%.2f", zoom),
                28, 62
            );

            g.drawString(
                "Generation: " + world.generation
                    + " | Ressourcen: " + world.quest.resources,
                28, 82
            );

            g.drawString(
                "Fitness: " + world.quest.fitness(world.quest.candidateStep)
                    + "/9 | Bestwert: " + world.quest.bestFitness
                    + " | Aktivität: "
                    + String.format(Locale.US, "%.3f", world.meanActivation()),
                28, 102
            );

            g.drawString(
                "Quest: 3, 4, 6, 8, 10 -> 12, 14, 16",
                28, 124
            );

            g.setColor(world.quest.solved
                ? new Color(80, 235, 140)
                : new Color(255, 205, 100));

            g.drawString(
                "Kandidat: +" + world.quest.candidateStep
                    + (world.quest.solved ? " | GELÖST" : " | Suche aktiv"),
                28, 146
            );

            g.setColor(new Color(195, 210, 235));
            g.drawString(
                "Ziehen: bewegen | Mausrad: Zoom | Doppelklick: Reset",
                28, 169
            );

            g.drawString(
                world.status,
                16, getHeight() - 18
            );
        }
    }

    // ---------- Persönliche Organisationsquest ----------

    static void showRitalinQuest(JFrame parent) {
        String message =
