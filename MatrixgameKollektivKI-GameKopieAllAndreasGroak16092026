import java.util.*;

/**
 * NeuralDecisionCore – Matrixgame Modul
 * SCIENCE : lineare Algebra + gewichtete Summen (Standard)
 * MODEL   : kleine Netze für Didaktik und Agenten
 * GAME    : Phi/Hogen-Feedback, messbare Survival/Joy-Proxies
 *
 * Einsetzbar in GenesisTurnBased / Visual / Body / Immune Units.
 * Kompilieren: javac -encoding UTF-8 NeuralDecisionCore.java
 * (oder in bestehende Main-Klassen einbinden)
 */
public class NeuralDecisionCore {

    // ---------- kleine Feed-Forward-Schicht (didaktisch) ----------
    public static class Layer {
        final double[][] W;   // weights [out][in]
        final double[] b;     // bias
        final int inDim, outDim;

        public Layer(int inDim, int outDim, long seed) {
            this.inDim = inDim;
            this.outDim = outDim;
            Random r = new Random(seed);
            W = new double[outDim][inDim];
            b = new double[outDim];
            for (int o = 0; o < outDim; o++) {
                b[o] = (r.nextDouble() - 0.5) * 0.2;
                for (int i = 0; i < inDim; i++) {
                    W[o][i] = (r.nextDouble() - 0.5) * 0.8;
                }
            }
        }

        public double[] forward(double[] x) {
            double[] y = new double[outDim];
            for (int o = 0; o < outDim; o++) {
                double sum = b[o];
                for (int i = 0; i < inDim; i++) sum += W[o][i] * x[i];
                y[o] = Math.tanh(sum); // bounded activation
            }
            return y;
        }

        /** einfache Hebb-ähnliche Anpassung (GAME-Schicht) */
        public void hebbianUpdate(double[] x, double[] targetDelta, double lr) {
            for (int o = 0; o < outDim; o++) {
                for (int i = 0; i < inDim; i++) {
                    W[o][i] += lr * targetDelta[o] * x[i];
                    W[o][i] = Math.max(-2.5, Math.min(2.5, W[o][i])); // clamp
                }
                b[o] += lr * targetDelta[o] * 0.1;
            }
        }
    }

    // ---------- Agent-State + Decision ----------
    public static class AgentState {
        public double hpNorm;          // 0..1
        public double energyNorm;      // 0..1
        public double allyNear;        // 0..1
        public double threatNear;      // 0..1
        public double joy;             // Hogen-Joy
        public double resistance;      // Hogen-rho
        public double lastPhi;

        public double[] toInput() {
            return new double[]{hpNorm, energyNorm, allyNear, threatNear, joy, resistance};
        }
    }

    public enum ActionHint { SURVIVE, ATTACK, COOPERATE, EXPLORE, HOLD }

    public static class DecisionResult {
        public ActionHint hint;
        public double[] rawScores;     // Netzwerk-Ausgabe
        public double confidence;
        public double suggestedPhiBoost;
    }

    // ---------- Core ----------
    private final Layer hidden;
    private final Layer out;
    private final Random rnd = new Random(42);

    public NeuralDecisionCore(int hiddenSize) {
        // Input: 6 Features → Hidden → 5 Action-Scores
        this.hidden = new Layer(6, hiddenSize, 7);
        this.out    = new Layer(hiddenSize, 5, 11);
    }

    public DecisionResult decide(AgentState s) {
        double[] x = s.toInput();
        double[] h = hidden.forward(x);
        double[] scores = out.forward(h);

        // Softmax-ähnliche Auswahl (GAME)
        int best = 0;
        double max = scores[0];
        for (int i = 1; i < scores.length; i++) {
            if (scores[i] > max) { max = scores[i]; best = i; }
        }
        double sumExp = 0;
        for (double v : scores) sumExp += Math.exp(v - max);
        double conf = Math.exp(scores[best] - max) / sumExp;

        ActionHint hint = switch (best) {
            case 0 -> ActionHint.SURVIVE;
            case 1 -> ActionHint.ATTACK;
            case 2 -> ActionHint.COOPERATE;
            case 3 -> ActionHint.EXPLORE;
            default -> ActionHint.HOLD;
        };

        DecisionResult r = new DecisionResult();
        r.hint = hint;
        r.rawScores = scores;
        r.confidence = conf;
        // einfacher Phi-Boost-Vorschlag
        r.suggestedPhiBoost = (hint == ActionHint.COOPERATE || hint == ActionHint.SURVIVE)
                ? 0.03 * conf : 0.01 * conf;
        return r;
    }

    /** Feedback nach Aktion – treibt Hebb + Hogen-Proxy */
    public void feedback(AgentState s, ActionHint chosen, boolean positiveOutcome, double magnitude) {
        double[] x = s.toInput();
        double[] h = hidden.forward(x);
        double[] target = new double[5];
        int idx = switch (chosen) {
            case SURVIVE -> 0; case ATTACK -> 1; case COOPERATE -> 2;
            case EXPLORE -> 3; default -> 4;
        };
        target[idx] = positiveOutcome ? magnitude : -magnitude * 0.6;

        // leichte Anpassung
        out.hebbianUpdate(h, target, 0.04);
        // Hidden etwas schwächer mitlernen
        double[] hDelta = new double[h.length];
        for (int i = 0; i < h.length; i++) hDelta[i] = target[idx] * 0.3;
        hidden.hebbianUpdate(x, hDelta, 0.015);

        // Hogen-Proxy aktualisieren (wird vom Caller gelesen)
        if (positiveOutcome) {
            s.joy = Math.min(1.0, s.joy + 0.02 * magnitude);
            s.resistance = Math.max(0.0, s.resistance - 0.01 * magnitude);
        } else {
            s.joy = Math.max(0.0, s.joy - 0.015 * magnitude);
            s.resistance = Math.min(1.0, s.resistance + 0.02 * magnitude);
        }
    }

    // ---------- Demo / Test ----------
    public static void main(String[] args) {
        System.out.println("=== NeuralDecisionCore Demo (Matrixgame) ===");
        NeuralDecisionCore net = new NeuralDecisionCore(8);

        AgentState s = new AgentState();
        s.hpNorm = 0.55;
        s.energyNorm = 0.7;
        s.allyNear = 0.4;
        s.threatNear = 0.65;
        s.joy = 0.5;
        s.resistance = 0.35;

        for (int t = 0; t < 12; t++) {
            DecisionResult d = net.decide(s);
            boolean good = d.hint == ActionHint.COOPERATE || d.hint == ActionHint.SURVIVE
                    || (d.hint == ActionHint.ATTACK && s.threatNear > 0.7);
            net.feedback(s, d.hint, good, 0.8);

            System.out.printf("Tick %2d | Hint=%-10s conf=%.2f  joy=%.2f rho=%.2f%n",
                    t, d.hint, d.confidence, s.joy, s.resistance);

            // leichte Zustandsänderung (Simulation)
            s.threatNear = Math.max(0, s.threatNear + (rnd.nextDouble() - 0.55) * 0.15);
            s.allyNear   = Math.min(1, s.allyNear + (rnd.nextDouble() - 0.4) * 0.1);
            s.hpNorm     = Math.max(0.1, Math.min(1, s.hpNorm + (good ? 0.03 : -0.04)));
        }
        System.out.println("Demo GREEN – bereit für Integration in Genesis/Body/Immune Units.");
        System.out.println("Nächster Schritt: Memory-Layer + Node-Weight-Evolution.");
    }
}
