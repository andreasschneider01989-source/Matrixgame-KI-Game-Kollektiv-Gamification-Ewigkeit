import java.util.*;

/**
 * MemoryNodeSystem – Matrixgame Modul
 * SCIENCE : Hebb, LTP-ähnlich, Encoding/Consolidation/Retrieval (Standard-Neuro)
 * MODEL   : kleine Netze + Nodes für Didaktik und Agenten
 * GAME    : messbare Joy/Survival/Phi-Proxies, Node-Evolution, offene Schnittstelle
 *
 * Kann Decision-Trees, einfache Approximationen und Agenten-Entscheidungen tragen.
 * Kompilieren: javac -encoding UTF-8 MemoryNodeSystem.java
 */
public class MemoryNodeSystem {

    // =========================================================
    // 1. NODE – atomare Wissenseinheit (Input → Operation → Output)
    // =========================================================
    public static class Node {
        public final String id;
        public final String type;          // AI, PHY, BIO, SYM, META, MEM
        public double weight = 1.0;
        public int success = 0;
        public int fail = 0;
        public String description = "";
        public List<Node> children = new ArrayList<>();   // für einfache Bäume / Ketten

        public Node(String id, String type) {
            this.id = id;
            this.type = type;
        }

        public double score(double match) {
            return match * weight;
        }

        public void success(double magnitude) {
            success++;
            weight = Math.min(3.0, weight + 0.08 * magnitude);
        }

        public void fail(double magnitude) {
            fail++;
            weight = Math.max(0.15, weight - 0.05 * magnitude);
        }

        public void addChild(Node child) {
            children.add(child);
        }

        @Override
        public String toString() {
            return id + "[" + type + "|w=" + String.format("%.2f", weight)
                    + "|s=" + success + "|f=" + fail + "]";
        }
    }

    // =========================================================
    // 2. MEMORY TRACE – Encoding + Consolidation (Schlaf-Replay)
    // =========================================================
    public static class MemoryTrace {
        public final double[] pattern;     // Encoding
        public double strength;            // 0..1
        public int age;                    // Ticks seit Encoding
        public boolean consolidated;       // nach Replay

        public MemoryTrace(double[] pattern) {
            this.pattern = Arrays.copyOf(pattern, pattern.length);
            this.strength = 0.35;
            this.age = 0;
            this.consolidated = false;
        }

        /** einfache Consolidation (Hippocampus → Cortex-ähnlich) */
        public void consolidate(double sleepQuality) {
            strength = Math.min(1.0, strength + 0.15 * sleepQuality);
            consolidated = true;
            age = 0;
        }

        public void decay() {
            age++;
            if (!consolidated) strength *= 0.97;      // schneller Zerfall ohne Consolidation
            else strength *= 0.995;                    // langsamer Zerfall nach Consolidation
        }
    }

    // =========================================================
    // 3. KLEINES NETZ – approximiert Entscheidungen / einfache Funktionen
    // =========================================================
    public static class TinyNet {
        final double[][] W1;   // input → hidden
        final double[] b1;
        final double[][] W2;   // hidden → output
        final double[] b2;
        final int inDim, hid, outDim;
        final Random rnd;

        public TinyNet(int inDim, int hid, int outDim, long seed) {
            this.inDim = inDim;
            this.hid = hid;
            this.outDim = outDim;
            this.rnd = new Random(seed);
            W1 = new double[hid][inDim];
            b1 = new double[hid];
            W2 = new double[outDim][hid];
            b2 = new double[outDim];
            init(W1, b1, 0.7);
            init(W2, b2, 0.5);
        }

        private void init(double[][] W, double[] b, double scale) {
            for (int o = 0; o < W.length; o++) {
                b[o] = (rnd.nextDouble() - 0.5) * 0.2;
                for (int i = 0; i < W[0].length; i++)
                    W[o][i] = (rnd.nextDouble() - 0.5) * scale;
            }
        }

        public double[] forward(double[] x) {
            double[] h = new double[hid];
            for (int o = 0; o < hid; o++) {
                double s = b1[o];
                for (int i = 0; i < inDim; i++) s += W1[o][i] * x[i];
                h[o] = Math.tanh(s);
            }
            double[] y = new double[outDim];
            for (int o = 0; o < outDim; o++) {
                double s = b2[o];
                for (int i = 0; i < hid; i++) s += W2[o][i] * h[i];
                y[o] = Math.tanh(s);
            }
            return y;
        }

        /** sehr leichte Hebb-ähnliche Anpassung (GAME) */
        public void hebb(double[] x, double[] targetDelta, double lr) {
            double[] h = new double[hid];
            for (int o = 0; o < hid; o++) {
                double s = b1[o];
                for (int i = 0; i < inDim; i++) s += W1[o][i] * x[i];
                h[o] = Math.tanh(s);
            }
            for (int o = 0; o < outDim; o++) {
                for (int i = 0; i < hid; i++) {
                    W2[o][i] += lr * targetDelta[o] * h[i];
                    W2[o][i] = clamp(W2[o][i], -2.2, 2.2);
                }
            }
            for (int o = 0; o < hid; o++) {
                for (int i = 0; i < inDim; i++) {
                    W1[o][i] += lr * 0.3 * targetDelta[0] * x[i]; // vereinfacht
                    W1[o][i] = clamp(W1[o][i], -2.2, 2.2);
                }
            }
        }

        static double clamp(double v, double lo, double hi) {
            return Math.max(lo, Math.min(hi, v));
        }
    }

    // =========================================================
    // 4. MEMORY + NODE MANAGER
    // =========================================================
    public static class Manager {
        public final List<Node> nodes = new ArrayList<>();
        public final List<MemoryTrace> traces = new ArrayList<>();
        public final TinyNet net;
        public double globalJoy = 0.55;
        public double globalRho = 0.30;   // Widerstand

        public Manager(int hidden) {
            this.net = new TinyNet(6, hidden, 5, 42);
        }

        public void addNode(Node n) { nodes.add(n); }

        public Node selectBest(double match) {
            Node best = null;
            double bestScore = -1e9;
            for (Node n : nodes) {
                double s = n.score(match);
                if (s > bestScore) {
                    bestScore = s;
                    best = n;
                }
            }
            return best;
        }

        /** Encoding eines neuen Musters */
        public void encode(double[] pattern) {
            traces.add(new MemoryTrace(pattern));
            if (traces.size() > 40) traces.remove(0); // begrenzter Speicher
        }

        /** Consolidation (Schlaf / Replay) – GAME-Schicht */
        public void consolidateAll(double sleepQuality) {
            for (MemoryTrace t : traces) {
                if (!t.consolidated && t.age > 3) {
                    t.consolidate(sleepQuality);
                }
                t.decay();
            }
            // leichte Joy-Erhöhung bei guter Consolidation
            globalJoy = Math.min(1.0, globalJoy + 0.02 * sleepQuality);
            globalRho = Math.max(0.05, globalRho - 0.01 * sleepQuality);
        }

        /** Entscheidung mit Netz + bestem Node */
        public String decide(double[] state) {
            double[] scores = net.forward(state);
            int bestIdx = 0;
            for (int i = 1; i < scores.length; i++)
                if (scores[i] > scores[bestIdx]) bestIdx = i;

            String[] labels = {"SURVIVE", "ATTACK", "COOPERATE", "EXPLORE", "HOLD"};
            String action = labels[bestIdx];

            // Node-Unterstützung
            Node n = selectBest(0.6 + scores[bestIdx] * 0.4);
            if (n != null && n.weight > 1.1) {
                action = action + "+" + n.id;
            }
            return action;
        }

        public void feedback(String action, boolean positive, double magnitude) {
            // Netz anpassen
            double[] dummyTarget = new double[5];
            int idx = switch (action.split("\\+")[0]) {
                case "SURVIVE" -> 0; case "ATTACK" -> 1; case "COOPERATE" -> 2;
                case "EXPLORE" -> 3; default -> 4;
            };
            dummyTarget[idx] = positive ? magnitude : -magnitude * 0.5;
            net.hebb(new double[]{0.5,0.5,0.5,0.5,0.5,0.5}, dummyTarget, 0.03);

            // Nodes belohnen / bestrafen
            for (Node n : nodes) {
                if (action.contains(n.id) || action.startsWith(n.type)) {
                    if (positive) n.success(magnitude);
                    else n.fail(magnitude);
                }
            }

            if (positive) {
                globalJoy = Math.min(1.0, globalJoy + 0.015 * magnitude);
                globalRho = Math.max(0.05, globalRho - 0.01 * magnitude);
            } else {
                globalJoy = Math.max(0.1, globalJoy - 0.02 * magnitude);
                globalRho = Math.min(0.9, globalRho + 0.015 * magnitude);
            }
        }

        public String status() {
            return String.format("Joy=%.2f Rho=%.2f Traces=%d Nodes=%d",
                    globalJoy, globalRho, traces.size(), nodes.size());
        }
    }

    // =========================================================
    // 5. DEMO – Encoding, Consolidation, Decision, Node-Evolution
    // =========================================================
    public static void main(String[] args) {
        System.out.println("=== MemoryNodeSystem Demo (Matrixgame) ===");
        System.out.println("SCIENCE: Encoding / Consolidation / Retrieval");
        System.out.println("MODEL  : TinyNet + Nodes");
        System.out.println("GAME   : Joy/Rho + Evolution\n");

        Manager mgr = new Manager(8);

        // Beispiel-Nodes
        Node nSurvive = new Node("MG-MEM-SURV", "MEM");
        nSurvive.description = "Priorisiere Überleben bei niedrigem HP";
        Node nCoop    = new Node("MG-SYM-001", "SYM");
        nCoop.description = "Kooperiere mit nahen Verbündeten";
        Node nAttack  = new Node("MG-AI-ATK", "AI");
        nAttack.description = "Greife hohe Bedrohung an";
        mgr.addNode(nSurvive);
        mgr.addNode(nCoop);
        mgr.addNode(nAttack);

        // Einfacher Entscheidungsbaum (Node-Kinder)
        nSurvive.addChild(nCoop);
        nSurvive.addChild(nAttack);

        Random rnd = new Random(7);
        for (int t = 0; t < 16; t++) {
            // State: hp, energy, ally, threat, joy, rho
            double[] state = {
                0.4 + rnd.nextDouble() * 0.5,
                0.5 + rnd.nextDouble() * 0.4,
                rnd.nextDouble(),
                rnd.nextDouble(),
                mgr.globalJoy,
                mgr.globalRho
            };

            // Encoding
            mgr.encode(state);

            // Entscheidung
            String action = mgr.decide(state);

            // Outcome (einfache Heuristik)
            boolean good = action.contains("COOPERATE") || action.contains("SURV")
                    || (action.contains("ATTACK") && state[3] > 0.6);
            mgr.feedback(action, good, 0.7);

            // Alle paar Ticks Consolidation (Schlaf)
            if (t % 4 == 3) {
                mgr.consolidateAll(0.8);
                System.out.println("  [CONSOLIDATE] Sleep quality 0.8");
            }

            System.out.printf("Tick %2d | %-22s | %s%n", t, action, mgr.status());
        }

        System.out.println("\n--- Node-Status nach Evolution ---");
        for (Node n : mgr.nodes) {
            System.out.println("  " + n + "  " + n.description);
        }
        System.out.println("\n[✓] MemoryNodeSystem GREEN – bereit für Genesis / Body / Immune Integration");
        System.out.println("Nächste Ausbaustufen: Memory-Flag in Unit, Node-JSON-Export, Binärbaum-Evaluator");
    }
}
