### 🚀 Die integrierte Matrixgame-Engine (Java)

Dieser Code enthält das progressive Level-System, die neuen Bit-Shift/Logik-Operationen, Typ-Sicherheit (Casting für Bitwise) und den **automatischen Validator**, der den Code des Spielers testet.

```java
package ordner1;

import java.util.*;

public class MatrixgameEngine {

    // =====================================================================
    // 1. DATENSTRUKTUR & KONFIGURATION
    // =====================================================================
    static class LevelConfig {
        int levelNumber, minSteps, maxSteps, minVal, maxVal, baseElo;
        String[] variables, operations;
        boolean useConstants, useBitwise;

        LevelConfig(int levelNumber, int minSteps, int maxSteps, String[] variables,
                    String[] operations, boolean useConstants, int minVal, int maxVal, int baseElo, boolean useBitwise) {
            this.levelNumber = levelNumber; this.minSteps = minSteps; this.maxSteps = maxSteps;
            this.variables = variables; this.operations = operations; this.useConstants = useConstants;
            this.minVal = minVal; this.maxVal = maxVal; this.baseElo = baseElo; this.useBitwise = useBitwise;
        }
    }

    static LevelConfig generiereLevel(int difficulty) {
        if (difficulty < 1) difficulty = 1;
        if (difficulty > 50) difficulty = 50;

        int minSteps = 2 + (difficulty / 12);
        int maxSteps = 2 + (difficulty / 10);

        String[] vars = (difficulty <= 15) ? new String[]{"X", "Y"} : new String[]{"X", "Y", "Z"};

        String[] ops;
        boolean useBitwise = false;
        if (difficulty <= 10) ops = new String[]{"+", "-"};
        else if (difficulty <= 20) ops = new String[]{"+", "-", "*", "/"};
        else if (difficulty <= 28) ops = new String[]{"+", "-", "*", "/", "%"};
        else if (difficulty <= 35) {
            ops = new String[]{"+", "-", "*", "/", "%", "AND", "OR", "XOR"};
            useBitwise = true;
        } else if (difficulty <= 42) {
            ops = new String[]{"+", "-", "*", "/", "%", "AND", "OR", "XOR", "<<", ">>"};
            useBitwise = true;
        } else {
            ops = new String[]{"+", "-", "*", "/", "%", "AND", "OR", "XOR", "NOT", "<<", ">>", ">>>", ">", "<", "=="};
            useBitwise = true;
        }

        boolean useConstants = difficulty > 20;
        int minVal, maxVal;
        if (difficulty <= 20) { minVal = 0; maxVal = 3; }
        else if (difficulty <= 35) { minVal = 0; maxVal = 15; } // 4-Bit Raum
        else if (difficulty <= 42) { minVal = 0; maxVal = 31; } // 5-Bit Raum (Shifts)
        else { minVal = 0; maxVal = 63; }

        int baseElo = 800 + (difficulty * 25);
        return new LevelConfig(difficulty, minSteps, maxSteps, vars, ops, useConstants, minVal, maxVal, baseElo, useBitwise);
    }

    // =====================================================================
    // 2. GENERATOR & BLACK-BOX LOGIK
    // =====================================================================
    private static final int ANZAHL_MESSUNGEN = 20;

    private static class Gleichung {
        final String name, links, operation, rechts;
        Gleichung(String name, String links, String operation, String rechts) {
            this.name = name; this.links = links; this.operation = operation; this.rechts = rechts;
        }
    }

    private static double zufallsZahl(Random random, int min, int max) {
        return random.nextInt(max - min + 1) + min;
    }

    private static String zufallsElement(Random random, String[] array) {
        return array[random.nextInt(array.length)];
    }

    private static List<Gleichung> erzeugeFormel(Random random, LevelConfig config) {
        int anzahlSchritte = random.nextInt(config.maxSteps - config.minSteps + 1) + config.minSteps;
        List<Gleichung> formel = new ArrayList<>();
        for (int i = 1; i <= anzahlSchritte; i++) {
            String name = "A" + i;
            String links, rechts;
            if (i == 1) {
                links = zufallsElement(random, config.variables);
                List<String> andere = new ArrayList<>(List.of(config.variables));
                andere.remove(links);
                rechts = zufallsElement(random, andere.toArray(new String[0]));
            } else {
                links = "A" + (i - 1);
                if (config.useConstants && random.nextBoolean()) {
                    rechts = Double.toString(zufallsZahl(random, 1, 5));
                } else {
                    rechts = zufallsElement(random, config.variables);
                }
            }
            formel.add(new Gleichung(name, links, zufallsElement(random, config.operations), rechts));
        }
        return formel;
    }

    private static double berechne(Gleichung g, Map<String, Double> werte) {
        double a = werte.get(g.links);
        double b = werte.containsKey(g.rechts) ? werte.get(g.rechts) : Double.parseDouble(g.rechts);
        
        // Typ-Sicherheit für Bit-Operationen
        int ai = (int) a;
        int bi = (int) b;

        switch (g.operation) {
            case "+": return a + b;
            case "-": return a - b;
            case "*": return a * b;
            case "/": return b != 0 ? a / b : a;
            case "%": return b != 0 ? a % b : a;
            case "AND": return ai & bi;
            case "OR": return ai | bi;
            case "XOR": return ai ^ bi;
            case "NOT": return ~ai; // Unär, ignoriert 'rechts'
            case "<<": return ai << (bi & 0x1F);
            case ">>": return ai >> (bi & 0x1F);
            case ">>>": return ai >>> (bi & 0x1F);
            case ">": return a > b ? 1.0 : 0.0;
            case "<": return a < b ? 1.0 : 0.0;
            case "==": return a == b ? 1.0 : 0.0;
            default: throw new IllegalStateException("Unbekannte Operation: " + g.operation);
        }
    }

    // =====================================================================
    // 3. DAS GYM-INTERFACE & VALIDATOR (Option A + B)
    // =====================================================================
    
    /**
     * Das Interface, das der Trainierende (oder eine KI) implementieren muss.
     * Das Ziel: Reverse-Engineering der Black-Box durch Code.
     */
    public interface MatrixPlayer {
        double solve(double x, double y, double z);
    }

    /**
     * Der Validator testet den Code des Spielers gegen die generierten Messdaten.
     */
    public static void validiereLoesung(int level, MatrixPlayer spieler) {
        LevelConfig config = generiereLevel(level);
        // Deterministischer Seed für reproduzierbare Tests
        Random random = new Random(level * 1337L); 
        List<Gleichung> formel = erzeugeFormel(random, config);
        String zielVariable = formel.get(formel.size() - 1).name;
        
        System.out.println("============================================================");
        System.out.println(" 🎮 MATRIXGAME VALIDATOR | LEVEL " + level);
        System.out.println(" 📏 Schritte: " + formel.size() + " | Puzzle-Elo: ~" + config.baseElo);
        System.out.println(" 🔣 Variablen: " + String.join(", ", config.variables));
        System.out.println(" ➕ Operationen: " + String.join(", ", config.operations));
        System.out.println(" 🔢 Zahlenraum: " + config.minVal + " bis " + config.maxVal);
        System.out.println("============================================================");
        System.out.println("Starte Black-Box-Test mit " + ANZAHL_MESSUNGEN + " Messungen...\n");
        
        int korrekt = 0;
        for (int i = 1; i <= ANZAHL_MESSUNGEN; i++) {
            Map<String, Double> werte = new LinkedHashMap<>();
            for (String v : new String[]{"X", "Y", "Z"}) {
                if (List.of(config.variables).contains(v)) {
                    werte.put(v, zufallsZahl(random, config.minVal, config.maxVal));
                } else {
                    werte.put(v, 0.0);
                }
            }
            for (Gleichung g : formel) werte.put(g.name, berechne(g, werte));
            
            double erwartet = werte.get(zielVariable);
            double spielerResultat = spieler.solve(werte.get("X"), werte.get("Y"), werte.get("Z"));
            
            // Toleranz für Fließkomma-Ungenauigkeiten
            if (Math.abs(erwartet - spielerResultat) < 0.0001) {
                korrekt++;
            } else {
                System.out.printf("❌ Abweichung bei Test %02d | X=%.0f, Y=%.0f, Z=%.0f | Erwartet: %.0f | Dein Code: %.0f%n", 
                    i, werte.get("X"), werte.get("Y"), werte.get("Z"), erwartet, spielerResultat);
            }
        }
        
        System.out.println("------------------------------------------------------------");
        System.out.println("🏆 Ergebnis: " + korrekt + " / " + ANZAHL_MESSUNGEN + " Messungen korrekt.");
        if (korrekt == ANZAHL_MESSUNGEN) {
            System.out.println("✅ Perfekt! Du hast das Black-Box-System vollständig reverse-engineered.");
            System.out.println("📈 Elo-Gewinn: +" + (config.baseElo / 10));
        } else {
            System.out.println("⚠️ Dein Code enthält noch logische Fehler oder Edge-Cases.");
        }
        System.out.println("============================================================");
    }

    // =====================================================================
    // 4. HAUPTPROGRAMM (Startpunkt für das Training)
    // =====================================================================
    public static void main(String[] args) {
        int level = 10; // Testlevel
        
        // HIER TRITT DER SPIELER (ODER EINE KI) IN AKTION:
        MatrixPlayer meinCode = new MatrixPlayer() {
            @Override
            public double solve(double x, double y, double z) {
                // DEINE LÖSUNG FÜR LEVEL 10:
                return x + 2 * y; 
            }
        };

        validiereLoesung(level, meinCode);
    }
}
```

