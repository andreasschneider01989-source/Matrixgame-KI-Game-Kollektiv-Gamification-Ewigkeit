				k.randEntropie4(unitList.get((int)(unitList.size()*Math.random())));
			}
			simulationsSchritte++;
			if (selectedKugel != null)
				updateInfoText();
			repaint();
		});
		simulationTimer.start();
	}

	private void updateInfoText() {
		infoText.setLength(0);
