                ctx.beginPath(); ctx.moveTo(-1000, i); ctx.lineTo(1000, i); ctx.stroke();
            }

            // Nodes
            nodes.forEach(n => {
                ctx.fillStyle = n.type === 'AI' ? '#00d2ff' : n.type === 'PHYSICS' ? '#ff5555' : n.type === 'BIO' ? '#00ff88' : '#aa88ff';
