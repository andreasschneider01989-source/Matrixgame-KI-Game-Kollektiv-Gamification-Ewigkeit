		infoText.append(
				String.format("Abgelaufen: %d.%03d s | Schritte: %d\n", sekunden, millisekunden, simulationsSchritte));
		infoText.append(String.format("Achse H (H): %s | Achse V (V): %s\n", verfuegbareVariablen[indexAxisX],
