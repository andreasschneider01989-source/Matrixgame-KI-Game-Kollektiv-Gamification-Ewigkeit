        function updateCount() { document.getElementById('node-count').innerText = nodes.length; }

        function exportJSON() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(nodes, null, 2));
            const a = document.createElement('a'); a.href = dataStr; a.download = `matrixgame_kollektiv_${Date.now()}.json`; a.click();
