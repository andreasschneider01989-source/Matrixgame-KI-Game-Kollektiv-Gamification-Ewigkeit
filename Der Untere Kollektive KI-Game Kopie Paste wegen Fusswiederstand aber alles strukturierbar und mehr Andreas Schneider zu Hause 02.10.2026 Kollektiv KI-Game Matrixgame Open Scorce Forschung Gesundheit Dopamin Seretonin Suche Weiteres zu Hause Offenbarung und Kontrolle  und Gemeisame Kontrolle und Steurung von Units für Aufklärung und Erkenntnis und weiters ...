                    <button class="node-type-btn" data-type="SYM">SYM</button>
                    <button class="node-type-btn" data-type="STORY">STORY</button>
                    <button class="node-type-btn" data-type="META">META</button>
                </div>
            </div>
            
            <button id="add-node-btn">➕ Node an Zentrum platzieren</button>
            
            <div style="margin-top: 15px; border-top: 1px solid #444; padding-top: 15px;">
                <h3 style="margin: 0 0 10px 0; color: #00d2ff;">Speichern & Laden</h3>
                <button id="save-btn" class="success"> Lokal speichern</button>
                <button id="load-btn" style="margin-top: 5px;">📂 Lokal laden</button>
                <button id="export-btn" class="success" style="margin-top: 5px;"> JSON Exportieren</button>
                <button id="import-btn" style="margin-top: 5px;">📥 JSON Importieren</button>
                <input type="file" id="import-file" accept=".json" style="display: none;">
            </div>
            
            <div id="room-info" style="margin-top: 15px;">
                <strong> Raum-Code (Demo):</strong>
                <div id="room-code">LOCAL_ONLY</div>
                <p style="font-size: 11px; margin-top: 5px;">
                    Für echten Multiplayer: Firebase-Setup nötig (siehe Anleitung)
                </p>
            </div>
        </div>

        <div id="bottom-center" class="panel">
            <button id="clear-btn" class="danger">🗑️ Alle Nodes löschen</button>
            <button id="reset-view-btn"> Ansicht zurücksetzen</button>
        </div>
    </div>

    <script>
        const canvas = document.getElementById('infinityCanvas');
        const ctx = canvas.getContext('2d');

        // --- STATE ---
        let camera = { x: 0, y: 0, zoom: 1 };
        let nodes = [];
        let isDragging = false;
        let lastMouse = { x: 0, y: 0 };
        let selectedNodeType = 'AI';

        // Node-Typen mit Farben (aus deinem Dokument)
        const NODE_TYPES = {
            'AI': { color: '#00d2ff', icon: '' },
            'PHYSICS': { color: '#ff6b6b', icon: '️' },
            'BIO': { color: '#51cf66', icon: '🧬' },
            'SYM': { color: '#cc5de8', icon: '' },
            'STORY': { color: '#ffd43b', icon: '' },
            'META': { color: '#868e96', icon: '️' }
        };

        // --- INIT ---
        function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resize);
        resize();

        // Automatisch laden beim Start
        loadFromLocalStorage();

        // Beispiel-Nodes wenn nichts gespeichert ist
        if (nodes.length === 0) {
            nodes.push({ x: 0, y: 0, label: "ZENTRUM", type: "META", color: NODE_TYPES['META'].color, radius: 20, timestamp: Date.now() });
            nodes.push({ x: 300, y: -200, label: "KI-Agent 1", type: "AI", color: NODE_TYPES['AI'].color, radius: 15, timestamp: Date.now() });
            nodes.push({ x: -300, y: 200, label: "Symbiose", type: "SYM", color: NODE_TYPES['SYM'].color, radius: 15, timestamp: Date.now() });
        }

        // --- KOORDINATEN-TRANSFORMATION ---
        function screenToWorld(sx, sy) {
            return {
                x: (sx - camera.x) / camera.zoom,
                y: (sy - camera.y) / camera.zoom
            };
        }

        function worldToScreen(wx, wy) {
            return {
                x: wx * camera.zoom + camera.x,
                y: wy * camera.zoom + camera.y
            };
        }

        // --- RENDERING ---
        function drawGrid() {
            const width = canvas.width;
            const height = canvas.height;
            const gridSize = 100 * camera.zoom;

            ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
            ctx.lineWidth = 1;
            ctx.beginPath();

            const offsetX = camera.x % gridSize;
            const offsetY = camera.y % gridSize;

            for (let x = offsetX; x < width; x += gridSize) {
                ctx.moveTo(x, 0); ctx.lineTo(x, height);
            }
            for (let y = offsetY; y < height; y += gridSize) {
                ctx.moveTo(0, y); ctx.lineTo(width, y);
            }
            ctx.stroke();

            // Hauptachsen
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(camera.x, 0); ctx.lineTo(camera.x, height);
            ctx.moveTo(0, camera.y); ctx.lineTo(width, camera.y);
            ctx.stroke();
        }

        function drawNodes() {
            nodes.forEach(node => {
                const screenPos = worldToScreen(node.x, node.y);
                const r = node.radius * camera.zoom;

                // Kreis
                ctx.beginPath();
                ctx.arc(screenPos.x, screenPos.y, r, 0, Math.PI * 2);
                ctx.fillStyle = node.color;
                ctx.fill();
                ctx.strokeStyle = '#fff';
                ctx.lineWidth = 2;
                ctx.stroke();

                // Icon
                const typeInfo = NODE_TYPES[node.type] || { icon: '❓' };
                ctx.font = `${Math.max(12, 16 * camera.zoom)}px Arial`;
                ctx.textAlign = 'center';
                ctx.fillText(typeInfo.icon, screenPos.x, screenPos.y + 5);

                // Label
                ctx.fillStyle = '#fff';
                ctx.font = `bold ${Math.max(10, 14 * camera.zoom)}px Arial`;
                ctx.fillText(node.label, screenPos.x, screenPos.y + r + (20 * camera.zoom));
            });
        }

        function render() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            drawGrid();
            drawNodes();
            updateUI();
            requestAnimationFrame(render);
        }

        function updateUI() {
            document.getElementById('zoom-val').innerText = camera.zoom.toFixed(2);
            const centerWorld = screenToWorld(canvas.width / 2, canvas.height / 2);
            document.getElementById('pos-x').innerText = centerWorld.x.toFixed(0);
            document.getElementById('pos-y').innerText = centerWorld.y.toFixed(0);
            document.getElementById('node-count').innerText = nodes.length;
        }

        // --- INTERAKTION ---
        canvas.addEventListener('mousedown', e => {
            if (e.button === 0) {
                isDragging = true;
                lastMouse = { x: e.clientX, y: e.clientY };
            } else if (e.button === 2) {
                const worldPos = screenToWorld(e.clientX, e.clientY);
                const name = document.getElementById('node-name').value || "Node";
                const typeInfo = NODE_TYPES[selectedNodeType];
                
                nodes.push({
                    x: worldPos.x, y: worldPos.y, 
                    label: name, type: selectedNodeType, color: typeInfo.color, 
                    radius: 15, timestamp: Date.now()
                });
                autoSave();
            }
        });

        canvas.addEventListener('mousemove', e => {
            if (isDragging) {
                camera.x += e.clientX - lastMouse.x;
                camera.y += e.clientY - lastMouse.y;
                lastMouse = { x: e.clientX, y: e.clientY };
            }
        });

        canvas.addEventListener('mouseup', () => isDragging = false);
        canvas.addEventListener('mouseleave', () => isDragging = false);
        canvas.addEventListener('contextmenu', e => e.preventDefault());

        canvas.addEventListener('wheel', e => {
            e.preventDefault();
            const zoomSensitivity = 0.001;
            const delta = -e.deltaY * zoomSensitivity;
            const newZoom = Math.max(0.01, Math.min(100, camera.zoom * Math.exp(delta)));
            
            const mouseWorldBefore = screenToWorld(e.clientX, e.clientY);
            camera.zoom = newZoom;
            const mouseWorldAfter = screenToWorld(e.clientX, e.clientY);
            
            camera.x += (mouseWorldAfter.x - mouseWorldBefore.x) * camera.zoom;
            camera.y += (mouseWorldAfter.y - mouseWorldBefore.y) * camera.zoom;
        }, { passive: false });

        // Node-Typ Selektor
        document.querySelectorAll('.node-type-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.node-type-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                selectedNodeType = btn.dataset.type;
            });
        });

        // UI Buttons
        document.getElementById('add-node-btn').addEventListener('click', () => {
            const name = document.getElementById('node-name').value || "Node";
            const typeInfo = NODE_TYPES[selectedNodeType];
            nodes.push({
                x: 0, y: 0,
                label: name, type: selectedNodeType, color: typeInfo.color, 
                radius: 15, timestamp: Date.now()
            });
            autoSave();
        });

        document.getElementById('save-btn').addEventListener('click', () => {
            saveToLocalStorage();
            alert('✅ Canvas lokal gespeichert!');
        });

        document.getElementById('load-btn').addEventListener('click', () => {
            loadFromLocalStorage();
            alert('📂 Canvas geladen!');
        });

        document.getElementById('export-btn').addEventListener('click', () => {
            const data = JSON.stringify({ camera, nodes, version: '2.0' }, null, 2);
            const blob = new Blob([data], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url; a.download = `matrixgame_${Date.now()}.json`; a.click();
        });

        document.getElementById('import-btn').addEventListener('click', () => {
            document.getElementById('import-file').click();
        });

        document.getElementById('import-file').addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (event) => {
                try {
                    const data = JSON.parse(event.target.result);
                    if (data.nodes && data.camera) {
                        nodes = data.nodes;
                        camera = data.camera;
                        autoSave();
                        alert('✅ JSON importiert!');
                    } else {
                        alert('❌ Ungültiges Format!');
                    }
                } catch (err) {
                    alert('❌ Fehler beim Lesen: ' + err.message);
                }
            };
            reader.readAsText(file);
        });

        document.getElementById('clear-btn').addEventListener('click', () => {
            if (confirm('Wirklich alle Nodes löschen?')) {
                nodes = [];
                autoSave();
            }
        });

        document.getElementById('reset-view-btn').addEventListener('click', () => {
            camera = { x: 0, y: 0, zoom: 1 };
        });

        // --- LOCALSTORAGE FUNKTIONEN ---
        function autoSave() {
            try {
                localStorage.setItem('matrixgame_canvas', JSON.stringify({ camera, nodes, version: '2.0' }));
            } catch (e) {
                console.warn('Auto-Save fehlgeschlagen:', e);
            }
        }

        function saveToLocalStorage() {
            autoSave();
        }

        function loadFromLocalStorage() {
            try {
                const data = localStorage.getItem('matrixgame_canvas');
                if (data) {
                    const parsed = JSON.parse(data);
                    if (parsed.nodes && parsed.camera) {
                        nodes = parsed.nodes;
                        camera = parsed.camera;
                    }
                }
            } catch (e) {
                console.warn('Load fehlgeschlagen:', e);
            }
        }

        // Start
        render();
    </script>
</body>
</html>
```

