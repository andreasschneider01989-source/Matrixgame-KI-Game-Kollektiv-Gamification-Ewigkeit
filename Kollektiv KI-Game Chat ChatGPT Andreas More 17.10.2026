python
# knowledge_gap.py
from dataclasses import dataclass, field
from typing import Dict, List
from enum import Enum

class InfoStatus(Enum):
    FAKT = "fakt"
    WAHRSCHEINLICH = "wahrscheinlich"
    BEHAUPTUNG = "behauptung"
    UNKLAR = "unklar"
    WIDERLEGT = "widerlegt"

@dataclass
class KnowledgeGap:
    real_infected: int = 0
    official_infected: int = 0
    day: int = 0
    
    @property
    def gap(self) -> int:
        return max(0, self.real_infected - self.official_infected)
    
    @property
    def gap_ratio(self) -> float:
        if self.real_infected == 0:
            return 0.0
        return self.gap / self.real_infected
    
    def tick(self, new_real: int, new_official: int):
        self.day += 1
        self.real_infected = new_real
        self.official_infected = new_official
python
# agent.py
@dataclass
class Agent:
    name: str
    trust: float = 0.5  # 0..1
    insight_points: int = 0
    known_facts: List[str] = field(default_factory=list)
    active_rumors: List[str] = field(default_factory=list)
    
    def observe(self, gap: KnowledgeGap):
        # Vertrauen sinkt, wenn die Lücke wächst
        self.trust = max(0.0, min(1.0, self.trust - gap.gap_ratio * 0.1))
    
    def close_gap(self, verified_fact: str, points: int = 10):
        self.known_facts.append(verified_fact)
        self.insight_points += points
        self.trust = min(1.0, self.trust + 0.05)
python
