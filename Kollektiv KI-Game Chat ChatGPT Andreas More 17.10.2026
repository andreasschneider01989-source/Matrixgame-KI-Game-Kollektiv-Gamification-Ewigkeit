python
# knowledge_gap.py
from dataclasses import dataclass, field
from typing import Dict, List
from enum import Enum

class InfoStatus(Enum):
    FAKT = "fakt"
    WAHRSCHEINLICH = "wahrscheinlich"
    BEHAUPTUNG = "behauptung"
    UNKLAR = "unklar"
    WIDERLEGT = "widerlegt"

@dataclass
class KnowledgeGap:
    real_infected: int = 0
    official_infected: int = 0
    day: int = 0
    
    @property
    def gap(self) -> int:
        return max(0, self.real_infected - self.official_infected)
    
    @property
    def gap_ratio(self) -> float:
        if self.real_infected == 0:
            return 0.0
        return self.gap / self.real_infected
    
    def tick(self, new_real: int, new_official: int):
        self.day += 1
        self.real_infected = new_real
        self.official_infected = new_official
python
# agent.py
@dataclass
class Agent:
    name: str
    trust: float = 0.5  # 0..1
    insight_points: int = 0
    known_facts: List[str] = field(default_factory=list)
    active_rumors: List[str] = field(default_factory=list)
    
    def observe(self, gap: KnowledgeGap):
        # Vertrauen sinkt, wenn die Lücke wächst
        self.trust = max(0.0, min(1.0, self.trust - gap.gap_ratio * 0.1))
    
    def close_gap(self, verified_fact: str, points: int = 10):
        self.known_facts.append(verified_fact)
        self.insight_points += points
        self.trust = min(1.0, self.trust + 0.05)
python
# dashboard.py
def render_dashboard(agents: List[Agent], gap: KnowledgeGap):
    avg_trust = sum(a.trust for a in agents) / len(agents)
    
    # Ampel
    if gap.gap_ratio < 0.2 and avg_trust > 0.6:
        ampel = "🟢 STABIL"
    elif gap.gap_ratio < 0.5 and avg_trust > 0.35:
        ampel = "🟡 FRAGIL"
    else:
        ampel = "🔴 KRITISCH"
    
    print(f"\n=== TAG {gap.day} ===")
    print(f"Real Infiziert:      {gap.real_infected}")
    print(f"Offiziell Bekannt:   {gap.official_infected}")
    print(f"LÜCKE:               {gap.gap} ({gap.gap_ratio*100:.1f}%)")
    print(f"Ø Vertrauen:         {avg_trust:.2f}")
    print(f"Status:              {ampel}")
python
# passenger312_scenario.py
def run_scenario():
    gap = KnowledgeGap()
    # Passenger 312 als "Seed" - der eine unbekannte Fall
    real = 1
    official = 0
    agents = [Agent(f"Tracer_{i}") for i in range(5)]
    
    # Simulationsdaten aus dem Video (vereinfacht)
    timeline = [
        (1, 1, 0),   # Tag 1: 1 real, 0 bekannt
        (2, 24, 0),  # Tag 2: 24 im Flugzeug infiziert, noch niemand weiß
        (3, 60, 5),
        (4, 150, 20),
        (5, 400, 80),
        (7, 1800, 500),
        (14, 1400, 1200),
    ]
    
    for day, real, official in timeline:
        gap.tick(real, official)
        for agent in agents:
            agent.observe(gap)
        # Insight Point: Agent entdeckt Kausalität
        if gap.gap_ratio > 0.3:
            agent.close_gap(f"Tag {day}: Lücke bei {gap.gap}", 20)
        render_dashboard(agents, gap)

if __name__ == "__main__":
    run_scenario()
