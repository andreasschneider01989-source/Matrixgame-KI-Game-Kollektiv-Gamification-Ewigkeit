        public UnitPipe(AIUnit source, LuminiAxiom targetAxiom, Color color) {
            this.source = source;
            this.targetAxiom = targetAxiom;
            this.laserColor = color;
        }

        public double getTargetX() {
            return targetUnit != null ? targetUnit.x : targetAxiom.x;
        }

        public double getTargetY() {
            return targetUnit != null ? targetUnit.y : targetAxiom.y;
        }

        public void update() {
            pulsePos += 0.04;
            if (pulsePos > 1.0) pulsePos = 0.0;
        }

        public void draw(Graphics2D g2d) {
            double tx = getTargetX();
            double ty = getTargetY();

            // 1. Outer Glow Line
            g2d.setStroke(new BasicStroke(4.0f));
            g2d.setColor(new Color(laserColor.getRed(), laserColor.getGreen(), laserColor.getBlue(), 60));
            g2d.drawLine((int) source.x, (int) source.y, (int) tx, (int) ty);

            // 2. Inner Bright Beam
            g2d.setStroke(new BasicStroke(1.5f));
            g2d.setColor(new Color(220, 255, 255, 200));
            g2d.drawLine((int) source.x, (int) source.y, (int) tx, (int) ty);

            // 3. Traveling Pulse Packet
            double px = source.x + (tx - source.x) * pulsePos;
            double py = source.y + (ty - source.y) * pulsePos;

            g2d.setColor(Color.WHITE);
