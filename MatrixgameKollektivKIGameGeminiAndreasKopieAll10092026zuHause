package ordner3;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.awt.geom.AffineTransform;
import java.awt.geom.Ellipse2D;
import java.util.ArrayList;
import java.util.List;

// =====================================================================
// MATRIXGAME: SWARM CONTROL, MULTI-SELECTION & COMBAT ENGINE
// =====================================================================
class Unit {
    double x, y, z;
    double vx, vy, vz;
    double mass, radius;
    Color color;
    
    boolean updatePositionAktiv = true;
    boolean entropieMoveAktiv = true;
    double entropieMoveSpeed2ProCent = 70;
    double pe4 = 0.5;

    public Unit() {}

    public double getVariable(String varName) {
        switch (varName) {
            case "x": return x;
            case "y": return y;
            case "z": return z;
            case "vx": return vx;
            case "vy": return vy;
            case "vz": return vz;
            case "mass": return mass;
            case "radius": return radius;
            case "ekin": return 0.5 * mass * (vx*vx + vy*vy + vz*vz);
            default: return 0.0;
        }
    }

    public void setVariable(String varName, double val) {
        switch (varName) {
            case "x": x = val; break;
            case "y": y = val; break;
            case "z": z = val; break;
            case "vx": vx = val; break;
            case "vy": vy = val; break;
            case "vz": vz = val; break;
            case "mass": mass = Math.max(0.1, val); radius = Math.min(12, Math.max(2, Math.cbrt(mass))); break;
            case "radius": radius = val; break;
        }
    }

    public void update() {
        if (updatePositionAktiv) {
            x += vx * 0.05;
            y += vy * 0.05;
            z += vz * 0.05;
        }
        if (entropieMoveAktiv && Math.random() * 100 < entropieMoveSpeed2ProCent) {
            vx += (Math.random() - 0.5) * pe4;
            vy += (Math.random() - 0.5) * pe4;
            vz += (Math.random() - 0.5) * pe4;
        }
    }

    public void randEntropie4(Unit other) {
        double dx = other.x - this.x;
        double dy = other.y - this.y;
        double dist = Math.sqrt(dx*dx + dy*dy);
        if (dist > 0 && dist < 50) {
            vx += (dx / dist) * 0.02;
            vy += (dy / dist) * 0.02;
        }
    }

    public double getDistance(Unit other) {
        return Math.sqrt(Math.pow(other.x - x, 2) + Math.pow(other.y - y, 2) + Math.pow(other.z - z, 2));
    }

    public void fressen(Unit other) {
        this.mass += other.mass * 0.1;
        this.radius = Math.min(15, Math.max(2, Math.cbrt(this.mass)));
    }
}

