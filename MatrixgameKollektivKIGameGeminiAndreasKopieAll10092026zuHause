                g2d.fillOval((int) (x - radius), (int) (y - radius), (int) (radius * 2), (int) (radius * 2));
                g2d.setColor(Color.RED);
                g2d.drawOval((int) (x - radius), (int) (y - radius), (int) (radius * 2), (int) (radius * 2));
                g2d.setColor(Color.WHITE);
                g2d.setFont(new Font("Monospaced", Font.BOLD, 11));
                g2d.drawString("CHAOS/BLOCKADE: " + (int) chaosLevel + "%", (int) (x - 55), (int) (y - radius - 5));
            }
        }
    }

    public static class AIUnit {
        double x, y;
        double targetX, targetY;
        boolean hasTarget = false;
        double speed = 2.8;
        AIType type;
        boolean selected = false;
        boolean overrideMode = false;

        // Positive Mood / Alternative Action stats
        double mood = 70.0; // 0-100
        int alternativesCreated = 0;

        public AIUnit(double x, double y, AIType type) {
            this.x = x;
            this.y = y;
            this.targetX = x;
            this.targetY = y;
            this.type = type;
        }

        public void update(EntropyAnomaly anomaly) {
            if (overrideMode && hasTarget) {
                moveTowardsTarget();
                return;
            }

            // Autonomous movement toward harmony, fleeing chaos unless mood is high
            if (anomaly != null && !anomaly.harmonized) {
                double dx = x - anomaly.x;
                double dy = y - anomaly.y;
                double dist = Math.sqrt(dx * dx + dy * dy);

                if (dist < 250 && mood < 80) {
                    // Flee from negative entropy if low mood
                    targetX = x + (dx / dist) * 60;
                    targetY = y + (dy / dist) * 60;
                    hasTarget = true;
                } else {
                    wander();
                }
            } else {
                wander();
            }

            if (hasTarget) moveTowardsTarget();
        }

        private void wander() {
            if (!hasTarget || Math.random() < 0.02) {
                targetX = x + (Math.random() - 0.5) * 180;
                targetY = y + (Math.random() - 0.5) * 180;
                hasTarget = true;
            }
        }

        private void moveTowardsTarget() {
            double dx = targetX - x;
            double dy = targetY - y;
            double dist = Math.sqrt(dx * dx + dy * dy);

            if (dist > speed) {
                x += (dx / dist) * speed;
                y += (dy / dist) * speed;
            } else {
                x = targetX;
                y = targetY;
                if (overrideMode) overrideMode = false;
                hasTarget = false;
            }
        }

        public void draw(Graphics2D g2d) {
            // Body color dynamically brightened by high mood
            Color baseColor = type.color;
            if (mood > 85) {
                baseColor = baseColor.brighter();
            }

            g2d.setColor(baseColor);
            int size = overrideMode ? 26 : 18;
            g2d.fillOval((int) (x - size / 2.0), (int) (y - size / 2.0), size, size);

            if (selected) {
                g2d.setColor(Color.CYAN);
                g2d.setStroke(new BasicStroke(2.0f));
                g2d.drawOval((int) (x - size / 2.0 - 3), (int) (y - size / 2.0 - 3), size + 6, size + 6);

                if (hasTarget && overrideMode) {
                    g2d.setColor(new Color(0, 255, 255, 150));
                    g2d.setStroke(new BasicStroke(1.5f, BasicStroke.CAP_BUTT, BasicStroke.JOIN_BEVEL, 0, new float[]{4}, 0));
                    g2d.drawLine((int) x, (int) y, (int) targetX, (int) targetY);
                }
            }
        }

        public boolean containsWorldPoint(double wx, double wy) {
            double dx = wx - x;
            double dy = wy - y;
            return (dx * dx + dy * dy) <= (18 * 18);
        }
    }

    // --- CANVAS PANEL & SYSTEM ENGINE ---
    public static class CanvasPanel extends JPanel implements MouseListener, MouseMotionListener, MouseWheelListener {

