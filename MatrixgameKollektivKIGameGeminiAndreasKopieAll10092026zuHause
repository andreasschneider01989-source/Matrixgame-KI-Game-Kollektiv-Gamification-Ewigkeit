import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.ArrayList;
import java.util.List;

// ==========================================
// 1. DER ZUSTANDSRAUM (Data Model)
// ==========================================
class Unit {
    double x, y, z;
    double vx, vy, vz;
    double mass, radius;
    Color color;

    public Unit(double x, double y, double z, double mass) {
        this.x = x; 
        this.y = y; 
        this.z = z; 
        this.mass = mass;
        this.radius = Math.max(1, Math.cbrt(mass)); // Radius skaliert mit der Masse
        this.color = Color.WHITE;
    }
}

// ==========================================
// 2. DER DISKRETE INTEGRATOR (Physics & Logic)
// ==========================================
interface PhysicsEngine {
    void computeNextState(List<Unit> units, double dt);
}

class EntropieEngine implements PhysicsEngine {
    @Override
    public void computeNextState(List<Unit> units, double dt) {
        // Hier werden die Methoden wie update(), randEntropie4(), fressen() gekapselt
        for (Unit u : units) {
            // Kinematische Integration
            u.x += u.vx * dt;
            u.y += u.vy * dt;
            u.z += u.vz * dt;
            
            // Zukünftiger Hook: Kollektive Schwarm-Logik oder N-Body Gravitation
        }
    }
}

// ==========================================
// 3. DIE PROJEKTIONS-PIPELINE (Rendering)
// ==========================================
interface MatrixRenderer {
    void render(Graphics2D g2d, List<Unit> units, int width, int height);
}

class CanvasRenderer implements MatrixRenderer {
    double cameraX = 0, cameraY = 0;

    @Override
    public void render(Graphics2D g2d, List<Unit> units, int width, int height) {
        g2d.setColor(Color.BLACK);
        g2d.fillRect(0, 0, width, height);
        
        for (Unit u : units) {
            // Projektion R^3 -> R^2 mit Kamera-Offset
            int screenX = (int) (u.x - cameraX + width / 2.0);
            int screenY = (int) (u.y - cameraY + height / 2.0);
            int r = (int) u.radius;
            
            g2d.setColor(u.color);
            g2d.fillOval(screenX - r, screenY - r, 2 * r, 2 * r);
        }
    }

    public void moveCamera(double dx, double dy) {
        this.cameraX += dx;
        this.cameraY += dy;
    }
}

