    public static class AIUnit {
        double x, y;
        double targetX, targetY;
        boolean hasTarget = false;
        double speed = 3.0;
        AIType type;
        boolean selected = false;
        boolean overrideMode = false;
        double mood = 75.0;

        public AIUnit(double x, double y, AIType type) {
            this.x = x;
            this.y = y;
            this.targetX = x;
            this.targetY = y;
            this.type = type;
        }

        public void update(EntropyAnomaly anomaly) {
            if (overrideMode && hasTarget) {
                moveTowardsTarget();
                return;
            }

            if (anomaly != null && !anomaly.harmonized) {
                double dx = x - anomaly.x;
                double dy = y - anomaly.y;
                double dist = Math.sqrt(dx * dx + dy * dy);

                if (dist < 260 && mood < 85) {
                    targetX = x + (dx / dist) * 70;
                    targetY = y + (dy / dist) * 70;
                    hasTarget = true;
                } else {
                    wander();
                }
            } else {
                wander();
            }

            if (hasTarget) moveTowardsTarget();
        }

        private void wander() {
            if (!hasTarget || Math.random() < 0.02) {
                targetX = x + (Math.random() - 0.5) * 200;
                targetY = y + (Math.random() - 0.5) * 200;
                hasTarget = true;
            }
        }

        private void moveTowardsTarget() {
            double dx = targetX - x;
            double dy = targetY - y;
            double dist = Math.sqrt(dx * dx + dy * dy);

            if (dist > speed) {
                x += (dx / dist) * speed;
                y += (dy / dist) * speed;
            } else {
                x = targetX;
                y = targetY;
                if (overrideMode) overrideMode = false;
                hasTarget = false;
            }
        }

        public void draw(Graphics2D g2d) {
            Color baseColor = type.color;
            if (mood > 85) baseColor = baseColor.brighter();

