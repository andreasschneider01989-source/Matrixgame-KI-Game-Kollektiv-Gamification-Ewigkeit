    public void panLeft() { zoomCenterX += PAN_STEP; repaint(); }
    public void panRight() { zoomCenterX -= PAN_STEP; repaint(); }
    public void panUp() { zoomCenterY += PAN_STEP; repaint(); }
    public void panDown() { zoomCenterY -= PAN_STEP; repaint(); }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        g2.setColor(Color.BLACK);
        g2.fillRect(0, 0, getWidth(), getHeight());

        // Rendern aller Einheiten
        for (int i = 0; i < unitList.size(); i++) {
            Unit unit = unitList.get(i);
            if (unit.leben <= 0) continue;
            double radius = unit.size;
            Color color = new Color((int) Math.min(255, Math.max(0, unit.red)), 
                                      (int) Math.min(255, Math.max(0, unit.green)), 
                                      (int) Math.min(255, Math.max(0, unit.blue)));
            double sx = (zoomCenterX + unit.posX) * zoomFactor + getWidth() / 2.0;
            double sy = (zoomCenterY + unit.posY) * zoomFactor + getHeight() / 2.0;
            
            g2.setColor(color);
            g2.fillOval((int) (sx - radius), (int) (sy - radius), (int) (radius * 2), (int) (radius * 2));
            
            if (unit.isSelected) {
                g2.setColor(Color.WHITE);
                g2.drawOval((int) (sx - radius - 2), (int) (sy - radius - 2), (int) (radius * 2 + 4), (int) (radius * 2 + 4));
            }
        }

        // HUD / Gamification Overlay (Entropie & Ticks)
        g2.setColor(new Color(0, 255, 128));
        g2.setFont(new Font("Monospaced", Font.BOLD, 14));
        g2.drawString("Matrixgame Entropie-Pool: " + String.format("%.2f", globalEntropyPool), 20, 30);
        g2.drawString("Simulation Ticks: " + simulationTicks, 20, 55);
    }

    public void zoomIn() {
        zoomFactor *= ZOOM_STEP;
        PAN_STEP = feinheit / zoomFactor;
        repaint();
    }

    public void zoomOut() {
        zoomFactor /= ZOOM_STEP;
        PAN_STEP = feinheit / zoomFactor;
        repaint();
    }

    long pauseTime = 100;
    long kompletteRechenzeitDerSimulation = 0;
    double avgRechenzeitProUnitProEinheitenZug = 0;
    double count = 0;

    public void gameLoop() {
        while (true) {
            simulationTicks++;
            // Regenerativer Entropie-Ausgleich
            if (globalEntropyPool < 100.0) {
                globalEntropyPool += 0.05;
            }

            repaint();
            if (unitList.isEmpty()) continue;
            
            int randNumber = (int) (unitList.size() * Math.random());
            Unit current = unitList.get(randNumber);
            
            if (current.leben <= 0) {
                if ("King".equals(current.typ)) return;
                continue;
            }

            // Aktiver Latenz-Check
            if (current.rechenzeitProZug > avgRechenzeitProUnitProEinheitenZug && avgRechenzeitProUnitProEinheitenZug > 0) {
                if (Math.random() > 0.5) {
                    try { Thread.sleep(10); } catch (InterruptedException e) { e.printStackTrace(); }
                    continue; 
                }
            }

            if ("TARGET_POINT".equals(current.decisionAlgorithm) && current.targetPosX != null && current.targetPosY != null) {
                current.moveTo(current.targetPosX, current.targetPosY, current.posZ, current.speed);
                double distToTarget = current.getDistanceTo(current.targetPosX, current.targetPosY, current.posZ);
                if (distToTarget < 0.001) {
                    current.decisionAlgorithm = "NEAREST_ENEMY";
                    current.targetPosX = null; 
                    current.targetPosY = null; 
                }
            } else if ("TARGET_ENEMY".equals(current.decisionAlgorithm) && current.manualTarget != null) {
                current.target = current.manualTarget;
                if (current.getDistance(current.target) <= current.reichweite) {
                    current.attackieren(current.target);
                } else {
                    current.moveTo(current.target);
                }
            } else {
                long startTime = System.nanoTime();
                count++;

                if (current.target == null || current.target.leben <= 0)
                    current.target = nextGegner(current);

                if (current.team == 3) {
                    if (Math.random() > 0.7) {
                        current.vx = Math.random() - Math.random();
                    } else if (Math.random() > 0.7) {
                        current.vy = Math.random() - Math.random();
                        current.move(1);
                    }
                } else if ("Unit".equals(current.typ)) {
                    current.moveTo(current.target);
                    if (current.team == 1 && current.target != null) {
                        double angle = Math.atan2(current.target.posY - current.posY, current.target.posX - current.posX);
                        current.vx = Math.cos(angle) * 0.15;
                        current.vy = Math.sin(angle) * 0.15;
                        current.move(1);
                    }
                }

                if (current.target != null && current.getDistance(current.target) <= current.reichweite) {
                    current.attackieren(current.target);
                    if ("King".equals(current.target.typ) && current.target.leben <= 0)
                        return;
                }
                
                long endTime = System.nanoTime();
                long zugZeit = endTime - startTime;
                
                current.zuletztVerbrauchteZeit = zugZeit;
                current.kompletteRechenzeitInSimulation += zugZeit;
                current.rechenzeitProZug = zugZeit;
                
                kompletteRechenzeitDerSimulation += zugZeit;
                avgRechenzeitProUnitProEinheitenZug = kompletteRechenzeitDerSimulation / count;
            }

            try {
                Thread.sleep(pauseTime);
            } catch (InterruptedException e) {
                e.printStackTrace();
            }
        }
    }

    public Unit nextGegner(Unit current) {
        Unit gegner = null;
        double min = Double.MAX_VALUE;
        for (Unit ziel : unitList) {
            if (current.team != ziel.team && ziel.leben > 0) {
