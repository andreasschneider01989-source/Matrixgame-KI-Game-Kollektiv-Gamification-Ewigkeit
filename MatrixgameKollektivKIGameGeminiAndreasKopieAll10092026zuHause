import javax.swing.*;

import java.awt.*;

import java.util.ArrayList;

import java.util.List;

import java.awt.event.MouseAdapter;

import java.awt.event.MouseEvent;


public class MainGeminiSimulator extends JPanel {


    public List<Unit> unitList = new ArrayList<>();


    int FRAME_WIDTH = 1920;

    int FRAME_HEIGHT = 1080;


    double zoomFactor = 1.0;

    double zoomCenterX = 0;

    double zoomCenterY = 0;

    static final double ZOOM_STEP = 1.2;

    double feinheit = 50;

    double PAN_STEP = feinheit * zoomFactor;


    public MainGeminiSimulator() {

        setPreferredSize(new Dimension(FRAME_WIDTH, FRAME_HEIGHT));

        setBackground(Color.BLACK);

        

        MouseAdapter mouseHandler = new MouseAdapter() {

            @Override

            public void mousePressed(MouseEvent e) {

                if (SwingUtilities.isLeftMouseButton(e)) {

                    int mouseX = e.getX();

                    int mouseY = e.getY();

                    boolean unitFound = false;


                    for (Unit u : unitList) {

                        double sx = (zoomCenterX + u.posX) * zoomFactor + getWidth() / 2.0;

                        double sy = (zoomCenterY + u.posY) * zoomFactor + getHeight() / 2.0;

                        double radius = Math.abs(u.size);


                        if (Math.hypot(mouseX - sx, mouseY - sy) <= radius) {

                            u.isSelected = true;

                            System.out.println("Unit " + u.id + " wurde vom Spieler ausgewählt");

                            unitFound = true;

                        } else if (!e.isShiftDown()) {

                            u.isSelected = false;

                        }

                    }


                    if (!unitFound && !e.isShiftDown()) {

                        for (Unit u : unitList) {

                            u.isSelected = false;

                        }

                    }

                    repaint();

                }

                else if (SwingUtilities.isRightMouseButton(e)) {

                    int mouseX = e.getX();

                    int mouseY = e.getY();

                    

                    double worldTargetX = (mouseX - getWidth() / 2.0) / zoomFactor - zoomCenterX;

                    double worldTargetY = (mouseY - getHeight() / 2.0) / zoomFactor - zoomCenterY;


                    Unit clickedEnemy = null;

                    for (Unit u : unitList) {

                        double sx = (zoomCenterX + u.posX) * zoomFactor + getWidth() / 2.0;

                        double sy = (zoomCenterY + u.posY) * zoomFactor + getHeight() / 2.0;

                        double radius = Math.abs(u.size);

                        

                        if (Math.hypot(mouseX - sx, mouseY - sy) <= radius) {

                            clickedEnemy = u;

                            break;

                        }

                    }


                    for (Unit u : unitList) {

                        if (u.isSelected) {

                            if (clickedEnemy != null) {

                                u.manualTarget = clickedEnemy;

                                u.targetPosX = null;

                                u.targetPosY = null;

                                u.decisionAlgorithm = "TARGET_ENEMY";

                            } else {

                                u.targetPosX = worldTargetX;

                                u.targetPosY = worldTargetY;

                                u.manualTarget = null;

                                u.decisionAlgorithm = "TARGET_POINT";

                            }

                        }

                    }

                    repaint();

                }

            }

        };


        this.addMouseListener(mouseHandler);

        this.addMouseMotionListener(mouseHandler);

    }


    public void init() {

        double counterId = 0;

        for (int i = 0; i < 20; i++) {

            Unit unit = new Unit();

            unit.team = 1;

            unit.posX = (int) (Math.round(10 * Math.random()));

            unit.posY = (int) (Math.round(10 * Math.random()));

            unit.blue = 255;

            unit.id = counterId++;

            unitList.add(unit);

        }

        

        Unit king1 = new Unit();

        king1.typ = "King";

        king1.size = 15;

        king1.team = 1;

        king1.posX = 5;

        king1.posY = 5;

        king1.blue = 254;

        king1.id = counterId++;

        unitList.add(king1);


        for (int i = 0; i < 20; i++) {

            Unit unit = new Unit();

            unit.team = 2;

            unit.posX = (int) (Math.round(10 * Math.random()));

            unit.posY = (int) (Math.round(-10 * Math.random()));

            unit.red = 255;

            unit.id = counterId++;

            unitList.add(unit);

        }

        

        Unit king2 = new Unit();

        king2.typ = "King";

        king2.size = 15;

        king2.team = 2;

        king2.posX = 5;

        king2.posY = -5;

        king2.red = 255;

        king2.id = counterId++;

        unitList.add(king2);


        repaint();

    }


    public void panLeft() { zoomCenterX += PAN_STEP; repaint(); }

    public void panRight() { zoomCenterX -= PAN_STEP; repaint(); }

    public void panUp() { zoomCenterY += PAN_STEP; repaint(); }

    public void panDown() { zoomCenterY -= PAN_STEP; repaint(); }


    @Override

    protected void paintComponent(Graphics g) {

        super.paintComponent(g);

        Graphics2D g2 = (Graphics2D) g;

        g2.setColor(Color.BLACK);

        g2.fillRect(0, 0, getWidth(), getHeight());


        for (int i = 0; i < unitList.size(); i++) {

            Unit unit = unitList.get(i);

            if (unit.leben <= 0) continue;

            double radius = unit.size;

            Color color = new Color((int) (unit.red), (int) (unit.green), (int) (unit.blue));

            double sx = (zoomCenterX + unit.posX) * zoomFactor + getWidth() / 2.0;

            double sy = (zoomCenterY + unit.posY) * zoomFactor + getHeight() / 2.0;

            

            g2.setColor(color);

            g2.fillOval((int) (sx - radius), (int) (sy - radius), (int) (radius * 2), (int) (radius * 2));

            

            if (unit.isSelected) {

                g2.setColor(Color.WHITE);

                g2.drawOval((int) (sx - radius - 2), (int) (sy - radius - 2), (int) (radius * 2 + 4), (int) (radius * 2 + 4));

            }

        }

    }


    public void zoomIn() {

        zoomFactor *= ZOOM_STEP;

        PAN_STEP = feinheit / zoomFactor;

        repaint();

    }


    public void zoomOut() {

        zoomFactor /= ZOOM_STEP;

        PAN_STEP = feinheit / zoomFactor;

        repaint();

    }


    long pauseTime = 100;

    long kompletteRechenzeitDerSimulation = 0;

    double avgRechenzeitProUnitProEinheitenZug = 0;

    double count = 0;


    public void gameLoop() {

        while (true) {

            repaint();

            int randNumber = (int) (unitList.size() * Math.random());

            Unit current = unitList.get(randNumber);

            

            if (current.leben <= 0) {

                if ("King".equals(current.typ)) return;

                continue;

            }


            // AKTIVER LATENZ-CHECK: Wenn diese Unit zuvor überdurchschnittlich viel Rechenzeit 

            // benötigt hat, wird sie mit einer Wahrscheinlichkeit von 50% in diesem Takt ausgebremst (Cooldown).

            if (current.rechenzeitProZug > avgRechenzeitProUnitProEinheitenZug && avgRechenzeitProUnitProEinheitenZug > 0) {

                if (Math.random() > 0.5) {

                    // Unit "zögert" aufgrund ineffizienter Berechnung

                    try { Thread.sleep(10); } catch (InterruptedException e) { e.printStackTrace(); }

                    continue; 

                }

            }


            if ("TARGET_POINT".equals(current.decisionAlgorithm) && current.targetPosX != null && current.targetPosY != null) {

                current.moveTo(current.targetPosX, current.targetPosY, current.posZ, current.speed);

                double distToTarget = current.getDistanceTo(current.targetPosX, current.targetPosY, current.posZ);

                if (distToTarget < 0.001) {

                    current.decisionAlgorithm = "NEAREST_ENEMY";

                    current.targetPosX = null; 

                    current.targetPosY = null; 

                }

            } else if ("TARGET_ENEMY".equals(current.decisionAlgorithm) && current.manualTarget != null) {

                current.target = current.manualTarget;

                if (current.getDistance(current.target) <= current.reichweite) {

                    current.attackieren(current.target);

                } else {

                    current.moveTo(current.target);

                }

            } else {

                // ZEITMESSUNG FÜR DIE ENTSCHEIDUNGSFINDUNG

                long startTime = System.nanoTime();

                count++;


                if (current.target == null || current.target.leben <= 0)

                    current.target = nextGegner(current);


                if (current.team == 3) {

                    if (Math.random() > 0.7) {

                        current.vx = Math.random() - Math.random();

                    } else if (Math.random() > 0.7) {

                        current.vy = Math.random() - Math.random();

                        current.move(1);

                    }

                } else if ("Unit".equals(current.typ)) {

                    current.moveTo(current.target);

                    if (current.team == 1 && current.target != null) {

                        double angle = Math.atan2(current.target.posY - current.posY, current.target.posX - current.posX);

                        current.vx = Math.cos(angle) * 0.15;

                        current.vy = Math.sin(angle) * 0.15;

                        current.move(1);

                    }

                }


                if (current.target != null && current.getDistance(current.target) <= current.reichweite) {

                    current.attackieren(current.target);

                    if ("King".equals(current.target.typ) && current.target.leben <= 0)

                        return;

                }

                

                long endTime = System.nanoTime();

                long zugZeit = endTime - startTime;

                

                // Aktualisiere Messwerte der Unit

                current.zuletztVerbrauchteZeit = zugZeit;

                current.kompletteRechenzeitInSimulation += zugZeit;

                current.rechenzeitProZug = zugZeit; // Speichert exakt die Zeit dieses Zuges

                

                kompletteRechenzeitDerSimulation += zugZeit;

                avgRechenzeitProUnitProEinheitenZug = kompletteRechenzeitDerSimulation / count;

            }


            try {

                Thread.sleep(pauseTime);

            } catch (InterruptedException e) {

                e.printStackTrace();

            }

        }

    }


    public Unit nextGegner(Unit current) {

        Unit gegner = null;

        double min = Double.MAX_VALUE;

        for (Unit ziel : unitList) {

            if (current.team != ziel.team && ziel.leben > 0) {

                double dist = current.getDistance(ziel);

                if (dist < min) {

                    min = dist;

                    gegner = ziel;

                }

            }

        }

        return gegner;

    }


