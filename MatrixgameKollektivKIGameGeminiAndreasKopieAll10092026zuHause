    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        g2.setColor(Color.BLACK);
        g2.fillRect(0, 0, getWidth(), getHeight());

        // Aether Grid
        g2.setColor(new Color(25, 35, 45, 120));
        double gridSpacing = 50 * zoomFactor;
        for (double x = (getWidth()/2.0 + (zoomCenterX * zoomFactor)) % gridSpacing; x < getWidth(); x += gridSpacing) {
            g2.drawLine((int)x, 0, (int)x, getHeight());
        }
        for (double y = (getHeight()/2.0 + (zoomCenterY * zoomFactor)) % gridSpacing; y < getHeight(); y += gridSpacing) {
            g2.drawLine(0, (int)y, getWidth(), (int)y);
        }

        for (int i = 0; i < unitList.size(); i++) {
            Unit unit = unitList.get(i);
            if (unit.leben <= 0) continue;
            double radius = unit.size;
            Color color = new Color((int) Math.min(255, Math.max(0, unit.red)), 
                                      (int) Math.min(255, Math.max(0, unit.green)), 
                                      (int) Math.min(255, Math.max(0, unit.blue)));
            double sx = (zoomCenterX + unit.posX) * zoomFactor + getWidth() / 2.0;
            double sy = (zoomCenterY + unit.posY) * zoomFactor + getHeight() / 2.0;
            
            g2.setColor(color);
            g2.fillOval((int) (sx - radius), (int) (sy - radius), (int) (radius * 2), (int) (radius * 2));
            
            if (unit.leben < unit.maxLeben) {
                g2.setColor(Color.RED);
                g2.fillRect((int)(sx - radius), (int)(sy - radius - 6), (int)(radius * 2), 3);
                g2.setColor(Color.GREEN);
                double hpRatio = Math.max(0, unit.leben / unit.maxLeben);
                g2.fillRect((int)(sx - radius), (int)(sy - radius - 6), (int)(radius * 2 * hpRatio), 3);
            }

            if (unit.isSelected) {
                g2.setColor(Color.WHITE);
                g2.drawOval((int) (sx - radius - 3), (int) (sy - radius - 3), (int) (radius * 2 + 6), (int) (radius * 2 + 6));
            }
        }

        if (isDragging) {
            g2.setColor(new Color(0, 255, 128, 60));
            int x = Math.min(dragStartX, currentMouseX);
            int y = Math.min(dragStartY, currentMouseY);
            int w = Math.abs(currentMouseX - dragStartX);
            int h = Math.abs(currentMouseY - dragStartY);
            g2.fillRect(x, y, w, h);
            g2.setColor(new Color(0, 255, 128));
            g2.drawRect(x, y, w, h);
        }

        drawHUD(g2);
        
        if (isGameOver) {
            g2.setColor(new Color(0, 0, 0, 180));
            g2.fillRect(0, 0, getWidth(), getHeight());
            g2.setColor(Color.YELLOW);
            g2.setFont(new Font("Monospaced", Font.BOLD, 36));
            FontMetrics fm = g2.getFontMetrics();
            int strWidth = fm.stringWidth(gameResultText);
            g2.drawString(gameResultText, (getWidth() - strWidth) / 2, getHeight() / 2);
        }
    }

