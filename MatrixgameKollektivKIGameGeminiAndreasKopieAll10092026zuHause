    public static final int INVARIANT_N = 11016; // (m_p / m_e) * 6 abgerundet
    public static final int CUBE_BIN_FAC = 8;    // 2^3 (Binäres Raummodul)
    public static final int CUBE_TRI_FAC = 27;   // 3^3 (Ternäres Raummodul)
    public static final int BLOCK_UNIT_216 = CUBE_BIN_FAC * CUBE_TRI_FAC; // 6^3 = 216
    public static final int NOBLE_CORE_BLOCKS = INVARIANT_N / BLOCK_UNIT_216; // Exakt 51 Einheitsblöcke

    public static class Vector3D {
        public double x, y, z;

        public Vector3D(double x, double y, double z) {
            this.x = x;
            this.y = y;
            this.z = z;
        }

        public double distance(Vector3D other) {
            double dx = this.x - other.x;
            double dy = this.y - other.y;
            double dz = this.z - other.z;
            return Math.sqrt(dx * dx + dy * dy + dz * dz);
        }

        public Vector3D add(Vector3D v) {
            return new Vector3D(this.x + v.x, this.y + v.y, this.z + v.z);
        }

        public Vector3D scale(double factor) {
            return new Vector3D(this.x * factor, this.y * factor, this.z * factor);
        }
    }

    public static class Particle {
        public int id;
        public Vector3D position;
        public Vector3D velocity;
        public int massUnits; // In diskreten 1/11016 Protonen-Einheiten
        public boolean isValenceParticle; // Das einzelne Außenteilchen

        public Particle(int id, Vector3D position, int massUnits, boolean isValenceParticle) {
            this.id = id;
            this.position = position;
            this.velocity = new Vector3D(0, 0, 0);
            this.massUnits = massUnits;
            this.isValenceParticle = isValenceParticle;
        }
    }

    public static class VoxelGridSimulation {
        private final List<Particle> coreGrid = new ArrayList<>();
        private Particle valenceParticle;
        private final double minDistanceLimit = 0.05; // Pauli-Verdrängungs-Radius (Mindestabstand)

        public void initializeNobleGasCore() {
            int particleId = 0;
            int blocksPlaced = 0;

            // Anordnung der 51 Blöcke (je 216 Einheiten) im 3D-Gitterraum
            for (int bx = 0; bx < 4 && blocksPlaced < NOBLE_CORE_BLOCKS; bx++) {
                for (int by = 0; by < 4 && blocksPlaced < NOBLE_CORE_BLOCKS; by++) {
                    for (int bz = 0; bz < 4 && blocksPlaced < NOBLE_CORE_BLOCKS; bz++) {
                        double cx = bx * 1.5;
                        double cy = by * 1.5;
                        double cz = bz * 1.5;

                        coreGrid.add(new Particle(particleId++, new Vector3D(cx, cy, cz), BLOCK_UNIT_216, false));
                        blocksPlaced++;
                    }
                }
            }

            // Das 1 exklusive Valenzteilchen knapp außerhalb der Kernsymmetrie
            valenceParticle = new Particle(particleId, new Vector3D(2.5, 2.5, 5.0), 1, true);
            System.out.println("Kern initialisiert: " + coreGrid.size() + " Blöcke à 216 Einheiten (" 
                    + (NOBLE_CORE_BLOCKS * BLOCK_UNIT_216) + " Einheiten gesamt) + 1 Valenz-Teilchen.");
        }

        public void step(double dt) {
            Vector3D netForce = new Vector3D(0, 0, 0);

            // Wechselwirkung: Anziehung durch den Kern + Abstoßung bei Annäherung
            for (Particle coreBlock : coreGrid) {
                double dist = valenceParticle.position.distance(coreBlock.position);
                if (dist < minDistanceLimit) dist = minDistanceLimit;

                // Kraftgesetz: Coulomb-ähnliche Anziehung vs. Pauli-Abstoßung (Polarität)
                double forceMagnitude = (1.0 / (dist * dist)) - (0.05 / Math.pow(dist, 4));

                double dirX = (coreBlock.position.x - valenceParticle.position.x) / dist;
                double dirY = (coreBlock.position.y - valenceParticle.position.y) / dist;
                double dirZ = (coreBlock.position.z - valenceParticle.position.z) / dist;

                netForce = netForce.add(new Vector3D(dirX * forceMagnitude, dirY * forceMagnitude, dirZ * forceMagnitude));
            }

            // Numerische Integration (Anpassung der Flugbahn des Valenzteilchens)
            valenceParticle.velocity = valenceParticle.velocity.add(netForce.scale(dt));
            valenceParticle.position = valenceParticle.position.add(valenceParticle.velocity.scale(dt));
        }

        public Particle getValenceParticle() {
            return valenceParticle;
        }
    }

