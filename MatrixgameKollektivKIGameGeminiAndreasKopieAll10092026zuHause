    public void anzieheGravitation(Unit other, double gKonstante) {
        double dx = other.x - this.x;
        double dy = other.y - this.y;
        double dz = other.z - this.z;
        double distSq = dx*dx + dy*dy + dz*dz + 10.0; // Puffer gegen Division durch Null
        double dist = Math.sqrt(distSq);
        
        if (dist > 1.0 && dist < 300.0) { // Wirkungsbereich der Gravitation
            double kraft = (gKonstante * this.mass * other.mass) / (distSq * dist);
            this.vx += dx * kraft;
            this.vy += dy * kraft;
            this.vz += dz * kraft;
        }
    }

