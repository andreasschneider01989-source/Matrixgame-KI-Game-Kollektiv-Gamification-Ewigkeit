package ordner3;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.awt.geom.AffineTransform;
import java.awt.geom.Ellipse2D;
import java.util.ArrayList;
import java.util.List;

// =====================================================================
// MATRIXGAME: UNIVERSAL UNIT SIMULATION (Vollständig & Paketkonform)
