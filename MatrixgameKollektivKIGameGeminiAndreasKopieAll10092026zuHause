import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.ArrayList;
import java.util.List;

// ==========================================
// 1. DER ZUSTANDSRAUM & LUMINI PROTOKOLL
// ==========================================
class Unit {
    double x, y, z;
    double vx, vy, vz;
    double fx, fy, fz; // Kraftvektoren für N-Body
    double mass, radius;
    Color color;

    public Unit(double x, double y, double z, double mass) {
        this.x = x; 
        this.y = y; 
        this.z = z; 
        this.mass = mass;
        this.radius = Math.max(2, Math.cbrt(mass) * 1.5);
        this.color = new Color(200, 220, 255);
    }

    // Lumini-Protokoll: Serialisierung des Zustandsvektors für Netzwerke / Swarm Connect
    public String toLuminiStream() {
        return String.format("LUMINI_NODE[x:%.2f,y:%.2f,z:%.2f,m:%.2f]", x, y, z);
    }
}

// ==========================================
// 2. DIE SCHWARM- & ENTROPPIE-ENGINE (N-Body)
// ==========================================
interface PhysicsEngine {
    void computeNextState(List<Unit> units, double dt);
}

class NBodyEntropieEngine implements PhysicsEngine {
    private static final double G = 1.0; // Gravitationskonstante im Simulationsraum
    private static final double SOFTENING = 10.0; // Verhindert Singularitäten bei Kollisionen

    @Override
    public void computeNextState(List<Unit> units, double dt) {
        int n = units.size();

        // Schritt 1: Kräfte zurücksetzen
        for (int i = 0; i < n; i++) {
            Unit u = units.get(i);
            u.fx = 0;
            u.fy = 0;
            u.fz = 0;
        }

        // Schritt 2: N-Body Gravitationsberechnung O(N^2)
        for (int i = 0; i < n; i++) {
            Unit u1 = units.get(i);
            for (int j = i + 1; j < n; j++) {
                Unit u2 = units.get(j);

                double dx = u2.x - u1.x;
                double dy = u2.y - u1.y;
                double dz = u2.z - u1.z;

                double distSq = dx * dx + dy * dy + dz * dz + SOFTENING;
                double dist = Math.sqrt(distSq);

                // Gravitationskraft: F = G * (m1 * m2) / dist^3 * vector
                double forceMagnitude = (G * u1.mass * u2.mass) / (distSq * dist);

                double fx = forceMagnitude * dx;
                double fy = forceMagnitude * dy;
                double fz = forceMagnitude * dz;

                u1.fx += fx;
                u1.fy += fy;
                u1.fz += fz;

                u2.fx -= fx;
                u2.fy -= fy;
                u2.fz -= fz;
            }
        }

        // Schritt 3: Integration (Euler-Verfahren mit Geschwindigkeitsupdate)
        for (int i = 0; i < n; i++) {
            Unit u = units.get(i);
            
            // a = F / m
            double ax = u.fx / u.mass;
            double ay = u.fy / u.mass;
            double az = u.fz / u.mass;

            u.vx += ax * dt;
            u.vy += ay * dt;
            u.vz += az * dt;

            u.x += u.vx * dt;
            u.y += u.vy * dt;
            u.z += u.vz * dt;
        }
    }
}

// ==========================================
// 3. DIE PROJEKTIONS-PIPELINE (Rendering)
// ==========================================
interface MatrixRenderer {
    void render(Graphics2D g2d, List<Unit> units, int width, int height);
}

class CanvasRenderer implements MatrixRenderer {
    double cameraX = 0, cameraY = 0;
    double zoom = 1.0;

    @Override
    public void render(Graphics2D g2d, List<Unit> units, int width, int height) {
        g2d.setColor(Color.BLACK);
        g2d.fillRect(0, 0, width, height);
        
        // Zentrum des Koordinatensystems auf die Bildschirmmitte legen
        double cx = width / 2.0 + cameraX;
        double cy = height / 2.0 + cameraY;

        // Zeichne Verbindungen (Lumini / Swarm Links)
        g2d.setColor(new Color(40, 60, 90));
        for (int i = 0; i < units.size(); i++) {
            for (int j = i + 1; j < units.size(); j++) {
                Unit u1 = units.get(i);
                Unit u2 = units.get(j);
                g2d.drawLine(
                    (int)(cx + u1.x * zoom), (int)(cy + u1.y * zoom),
                    (int)(cx + u2.x * zoom), (int)(cy + u2.y * zoom)
                );
            }
        }

        // Zeichne Einheiten (Knotenpunkte)
        for (Unit u : units) {
            int screenX = (int) (cx + u.x * zoom);
            int screenY = (int) (cy + u.y * zoom);
            int r = Math.max(3, (int) (u.radius * zoom));
            
            g2d.setColor(u.color);
            g2d.fillOval(screenX - r, screenY - r, 2 * r, 2 * r);
        }
    }

    public void moveCamera(double dx, double dy) {
        this.cameraX += dx;
        this.cameraY += dy;
    }
}

