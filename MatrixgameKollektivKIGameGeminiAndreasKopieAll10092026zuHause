        public void updateAutonomousBehavior(List<AIUnit> swarm, EntropyAnomaly currentAnomaly) {
            if (overrideMode && hasTarget) {
                // Guardian is in control
                moveTowardsTarget();
                return;
            }

            // Autonomous Behavior: N-Body like attraction to Tengen, repulsion from Entropy
            if (currentAnomaly != null && !currentAnomaly.neutralized) {
                double dx = x - currentAnomaly.x;
                double dy = y - currentAnomaly.y;
                double dist = Math.sqrt(dx * dx + dy * dy);
                
                // Entropy causes autonomous algorithms to fail/flee
                if (dist < 300) {
                    targetX = x + (dx / dist) * 50;
                    targetY = y + (dy / dist) * 50;
                    hasTarget = true;
                } else {
                    wander();
                }
            } else {
                wander();
            }
            
            if (hasTarget) moveTowardsTarget();
        }

        private void wander() {
            if (!hasTarget || Math.random() < 0.02) {
                targetX = x + (Math.random() - 0.5) * 200;
                targetY = y + (Math.random() - 0.5) * 200;
                hasTarget = true;
            }
        }

        private void moveTowardsTarget() {
            double dx = targetX - x;
            double dy = targetY - y;
            double dist = Math.sqrt(dx * dx + dy * dy);

            if (dist > speed) {
                x += (dx / dist) * speed;
                y += (dy / dist) * speed;
            } else {
                x = targetX;
                y = targetY;
                if (overrideMode) overrideMode = false; // Revert to autonomous after reaching Guardian target
                hasTarget = false;
            }
        }

