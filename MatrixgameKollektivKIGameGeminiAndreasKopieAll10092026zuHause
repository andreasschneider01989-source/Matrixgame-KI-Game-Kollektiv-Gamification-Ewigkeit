public class UnitPipeEngine {

    public static class UnitPipe {
        private final String sourceId;
        private final String targetId;
        private double signalPurity; // 0.0 bis 1.0

        public UnitPipe(String sourceId, String targetId) {
            this.sourceId = sourceId;
            this.targetId = targetId;
            this.signalPurity = 0.5; // Startwert
        }

        // Mathematische Entropie-Reduktion via exponentieller Dämpfung
        public double transmitAndElevate(double rawDataNoise, double currentFrequencyHz) {
            this.signalPurity = Math.min(1.0, this.signalPurity + (1.0 - rawDataNoise) * 0.1);
            
            // Frequenzgewinn berechnet sich aus Signalreinheit und System-Resonanz
            double frequencyGain = (this.signalPurity * 15.0) * Math.exp(-rawDataNoise);
            return currentFrequencyHz + frequencyGain;
        }

        public String getStatusLog() {
            return String.format("[PIPE %s -> %s] Signal-Reinheit: %.2f%%", 
                sourceId, targetId, signalPurity * 100.0);
        }
    }

