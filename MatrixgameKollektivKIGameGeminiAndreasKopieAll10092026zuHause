import numpy as np

# Systemparameter
d = 1.0         # Voxel-Gitterabstand
G_m = 1.0       # Gravitationskonstante * Voxelmasse (GM_voxel)
dt = 0.01       # Zeitschritt
steps = 500     # Simulationsschritte

# 7-Voxel-Oktaeder Kernkoordinaten
core_voxels = np.array([
    [ 0.0,  0.0,  0.0], # Zentrum
    [   d,  0.0,  0.0], [-d,  0.0,  0.0], # X-Achse
    [ 0.0,    d,  0.0], [ 0.0,  -d,  0.0], # Y-Achse
    [ 0.0,  0.0,    d], [ 0.0,  0.0,  -d]  # Z-Achse
])

def compute_acceleration(pos):
    acc = np.zeros(3)
    for v in core_voxels:
        r_vec = v - pos
        dist = np.linalg.norm(r_vec)
        if dist > 1e-5:
            acc += G_m * r_vec / (dist**3)
    return acc

# Initialisierung des Valenzteilchens
pos = np.array([0.0, 2.5, 2.5])  # Diagonale Startposition im Nahfeld
vel = np.array([1.1, 0.0, 0.2])  # Tangentiale Startgeschwindigkeit für Orbit

a = compute_acceleration(pos)

print(f"=== MATRIXGAME 7-VOXEL ORBIT SIMULATION ===")
print(f"Schritt 000 | Pos: ({pos[0]:.4f}, {pos[1]:.4f}, {pos[2]:.4f}) | |r|: {np.linalg.norm(pos):.4f}")

for step in range(1, steps + 1):
    # Velocity-Verlet Integration
    pos += vel * dt + 0.5 * a * (dt**2)
    a_new = compute_acceleration(pos)
    vel += 0.5 * (a + a_new) * dt
    a = a_new
    
    if step % 50 == 0:
        r_mag = np.linalg.norm(pos)
        print(f"Schritt {step:03d} | Pos: ({pos[0]:.4f}, {pos[1]:.4f}, {pos[2]:.4f}) | |r|: {r_mag:.4f}")

