import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.awt.geom.AffineTransform;
import java.awt.geom.Point2D;
import java.util.ArrayList;
import java.util.List;

/**
 * MatrixGame Unified Infinite Canvas - Standard JDK 8+
 * Integration:
 * - State-based Right-Click (Panning vs. RTS Unit Command)
 * - Russell-Norvig 4-Quadrant AI Overlay
 * - Interactive Unit Fights & Minimax/Neural Tactical Simulations
 */
public class MatrixGameUnifiedCanvas extends JFrame {

    public MatrixGameUnifiedCanvas() {
        setTitle("MatrixGame - Unified AI Infinite Canvas & RTS Engine");
        setSize(1280, 720);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);

        CanvasPanel canvasPanel = new CanvasPanel();
        add(canvasPanel);
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            MatrixGameUnifiedCanvas frame = new MatrixGameUnifiedCanvas();
            frame.setVisible(true);
        });
    }

    // --- ENUMS & DATA STRUCTURES ---
    public enum AIType {
        SYMBOLIC("Symbolic AI (Minimax / Rules)", new Color(41, 128, 185)),
        NEURAL("Neural AI (Deep Learning / MCTS)", new Color(142, 68, 173)),
        RATIONAL("Rational Agent (Utility Max)", new Color(39, 174, 96)),
        HUMAN_LIKE("Human Behavior (Heuristic)", new Color(230, 126, 34));

        final String label;
        final Color color;

        AIType(String label, Color color) {
            this.label = label;
            this.color = color;
        }
    }

    public static class AIUnit {
        double x, y; // World coordinates
        double targetX, targetY;
        boolean hasTarget = false;
        double speed = 3.5;
        AIType type;
        boolean selected = false;
        int hp = 100;
        double attackRange = 40.0;
        
        // Minimax / Eval Stats for Simulation Display
        double evalScore = 0.0;
        int searchDepth = 4;

        public AIUnit(double x, double y, AIType type) {
            this.x = x;
            this.y = y;
            this.targetX = x;
            this.targetY = y;
            this.type = type;
        }

        public void update() {
            if (hasTarget) {
                double dx = targetX - x;
                double dy = targetY - y;
                double dist = Math.sqrt(dx * dx + dy * dy);

                if (dist > speed) {
                    x += (dx / dist) * speed;
                    y += (dy / dist) * speed;
                    // Dynamic evaluation update based on movement
                    evalScore = Math.sin(x * 0.01) * Math.cos(y * 0.01) * 100.0;
                } else {
                    x = targetX;
                    y = targetY;
                    hasTarget = false;
                }
            }
        }

        public void draw(Graphics2D g2d) {
            // Unit Body
            g2d.setColor(type.color);
            int size = 24;
            g2d.fillOval((int) (x - size / 2.0), (int) (y - size / 2.0), size, size);

            // Selection Indicator
            if (selected) {
                g2d.setColor(Color.CYAN);
                g2d.setStroke(new BasicStroke(2.0f));
                g2d.drawOval((int) (x - size / 2.0 - 4), (int) (y - size / 2.0 - 4), size + 8, size + 8);

                // Vector Line to Target
                if (hasTarget) {
                    g2d.setColor(new Color(0, 255, 255, 120));
                    g2d.setStroke(new BasicStroke(1.5f, BasicStroke.CAP_BUTT, BasicStroke.JOIN_BEVEL, 0, new float[]{6}, 0));
                    g2d.drawLine((int) x, (int) y, (int) targetX, (int) targetY);
                }
            }

            // Health & Label
            g2d.setColor(Color.WHITE);
            g2d.setFont(new Font("Monospaced", Font.BOLD, 10));
            g2d.drawString(type.name().substring(0, 3), (int) (x - 10), (int) (y - 14));
        }

        public boolean containsWorldPoint(double wx, double wy) {
            double dx = wx - x;
            double dy = wy - y;
            return (dx * dx + dy * dy) <= (16 * 16);
        }
    }

    // --- CANVAS PANEL ENGINE ---
    public static class CanvasPanel extends JPanel implements MouseListener, MouseMotionListener, MouseWheelListener {

        // Canvas View Transform State
        private double zoom = 1.0;
        private double offsetX = 0.0;
        private double offsetY = 0.0;
        
        // Panning Drag State
        private Point dragStartScreen;
        private boolean isPanning = false;

        // Entities & Simulation State
        private final List<AIUnit> units = new ArrayList<>();
        private AIUnit selectedUnit = null;

        public CanvasPanel() {
            setBackground(new Color(20, 24, 30));

            // Populate Units across the Russell-Norvig Quadrants
            units.add(new AIUnit(-200, -200, AIType.SYMBOLIC));   // Thinking / Rational
            units.add(new AIUnit(200, -200, AIType.NEURAL));      // Thinking / Human-like
            units.add(new AIUnit(-200, 200, AIType.RATIONAL));    // Acting / Rational
            units.add(new AIUnit(200, 200, AIType.HUMAN_LIKE));  // Acting / Human-like

            addMouseListener(this);
            addMouseMotionListener(this);
            addMouseWheelListener(this);

            // Game Loop Thread (60 FPS)
            Timer timer = new Timer(16, e -> {
                for (AIUnit unit : units) {
                    unit.update();
                }
                repaint();
            });
            timer.start();
        }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2d = (Graphics2D) g;
            g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            int width = getWidth();
            int height = getHeight();

            // Save original transform for HUD
            AffineTransform origTx = g2d.getTransform();

            // Apply Infinite Canvas Camera Transformations
            g2d.translate(width / 2.0, height / 2.0);
            g2d.scale(zoom, zoom);
            g2d.translate(offsetX, offsetY);

            // 1. Draw World Grid & Russell-Norvig Quadrants
            drawWorldBackground(g2d);

            // 2. Draw Units & Target Vectors
            for (AIUnit unit : units) {
                unit.draw(g2d);
            }

            // Restore Transform to Render Static Screen HUD
            g2d.setTransform(origTx);
            drawHUD(g2d);
        }

        private void drawWorldBackground(Graphics2D g2d) {
            // Quadrant Division Lines (Russell & Norvig Grid)
            g2d.setStroke(new BasicStroke(2.0f));
            g2d.setColor(new Color(255, 255, 255, 40));
            g2d.drawLine(-2000, 0, 2000, 0); // X Axis: Thinking vs. Acting
            g2d.drawLine(0, -2000, 0, 2000); // Y Axis: Human vs. Rational

            // Quadrant Labels
            g2d.setFont(new Font("SansSerif", Font.BOLD, 16));
            g2d.setColor(new Color(255, 255, 255, 70));
            
            g2d.drawString("QUADRANT I: Thinking Rationally (Logik / Symbolik)", -550, -350);
            g2d.drawString("QUADRANT II: Thinking Humanly (Kognition / Neuronal)", 100, -350);
            g2d.drawString("QUADRANT III: Acting Rationally (Utility Optimization)", -550, 380);
            g2d.drawString("QUADRANT IV: Acting Humanly (Turing-Behavior)", 100, 380);

            // Grid Lines
            g2d.setStroke(new BasicStroke(0.5f));
            g2d.setColor(new Color(255, 255, 255, 15));
            int gridSize = 100;
            for (int x = -2000; x <= 2000; x += gridSize) {
                g2d.drawLine(x, -2000, x, 2000);
            }
            for (int y = -2000; y <= 2000; y += gridSize) {
                g2d.drawLine(-2000, y, 2000, y);
            }

            // Center Point (Tengen / Center Axiom)
            g2d.setColor(new Color(231, 76, 60, 180));
            g2d.fillOval(-6, -6, 12, 12);
            g2d.drawString("Tengen (0,0)", 10, -10);
        }

        private void drawHUD(Graphics2D g2d) {
            // Top Status Panel
            g2d.setColor(new Color(10, 14, 20, 220));
            g2d.fillRect(10, 10, 420, 140);
            g2d.setColor(Color.CYAN);
            g2d.drawRect(10, 10, 420, 140);

            g2d.setFont(new Font("Monospaced", Font.BOLD, 12));
            g2d.setColor(Color.WHITE);
            g2d.drawString("=== MATRIXGAME UNIFIED CANVAS CONTROL ===", 20, 30);
            g2d.drawString("Zoom: " + String.format("%.2f", zoom) + "x | Offset: (" + (int)offsetX + ", " + (int)offsetY + ")", 20, 50);
            g2d.drawString("Linksklick:   Einheit / Entity selektieren", 20, 70);
            g2d.drawString("Rechtsklick:  [Einheit selektiert] -> Befehl geben", 20, 90);
            g2d.drawString("              [Keine Selektion]    -> Canvas Ziehen", 20, 110);
            g2d.drawString("Mausrad:      Infinite Zoom (In / Out)", 20, 130);

            // Selected Unit Inspector Panel
            if (selectedUnit != null) {
                g2d.setColor(new Color(10, 14, 20, 220));
                g2d.fillRect(getWidth() - 310, 10, 300, 160);
                g2d.setColor(selectedUnit.type.color);
                g2d.drawRect(getWidth() - 310, 10, 300, 160);

                g2d.setColor(Color.WHITE);
                g2d.drawString("SELEKTIERTE EINHEIT INSPETOOR", getWidth() - 295, 30);
                g2d.drawString("Typ: " + selectedUnit.type.label, getWidth() - 295, 55);
                g2d.drawString("Position: (" + (int)selectedUnit.x + ", " + (int)selectedUnit.y + ")", getWidth() - 295, 75);
                g2d.drawString("Status: " + (selectedUnit.hasTarget ? "In Bewegung..." : "Bereit / Idle"), getWidth() - 295, 95);
                g2d.drawString("Minimax Depth: " + selectedUnit.searchDepth + " Ply", getWidth() - 295, 115);
                g2d.drawString("Eval Score: " + String.format("%.3f", selectedUnit.evalScore), getWidth() - 295, 135);
            }
        }

        // --- COORDINATE CONVERSION UTILITIES ---
        private Point2D.Double screenToWorld(Point screenPt) {
            double wx = (screenPt.x - getWidth() / 2.0) / zoom - offsetX;
            double wy = (screenPt.y - getHeight() / 2.0) / zoom - offsetY;
            return new Point2D.Double(wx, wy);
        }

        // --- INTERACTION LOGIC (STATE-BASED CONTEXT CLICK) ---
        @Override
        public void mousePressed(MouseEvent e) {
            Point2D.Double worldPt = screenToWorld(e.getPoint());

            if (SwingUtilities.isLeftMouseButton(e)) {
                // Left Click: Unit Selection Logic
                boolean found = false;
                for (AIUnit unit : units) {
                    if (unit.containsWorldPoint(worldPt.x, worldPt.y)) {
                        if (selectedUnit != null) selectedUnit.selected = false;
                        selectedUnit = unit;
                        selectedUnit.selected = true;
                        found = true;
                        break;
                    }
                }
                if (!found && selectedUnit != null) {
                    selectedUnit.selected = false;
                    selectedUnit = null;
                }
            } else if (SwingUtilities.isRightMouseButton(e)) {
                // Right Click: State-Based Dispatcher
                if (selectedUnit != null) {
                    // STATE A: Unit Selected -> Send Command Vector
                    selectedUnit.targetX = worldPt.x;
                    selectedUnit.targetY = worldPt.y;
                    selectedUnit.hasTarget = true;
                } else {
                    // STATE B: No Unit Selected -> Initiate Canvas Panning
                    dragStartScreen = e.getPoint();
                    isPanning = true;
                }
            }
        }

        @Override
        public void mouseDragged(MouseEvent e) {
            if (isPanning && dragStartScreen != null) {
                double dx = (e.getX() - dragStartScreen.x) / zoom;
                double dy = (e.getY() - dragStartScreen.y) / zoom;

                offsetX += dx;
                offsetY += dy;

                dragStartScreen = e.getPoint();
                repaint();
            }
        }

        @Override
        public void mouseReleased(MouseEvent e) {
            if (SwingUtilities.isRightMouseButton(e)) {
                isPanning = false;
                dragStartScreen = null;
            }
        }

        @Override
        public void mouseWheelMoved(MouseWheelEvent e) {
            double zoomFactor = 1.1;
            if (e.getWheelRotation() < 0) {
                zoom *= zoomFactor; // Zoom In
            } else {
                zoom /= zoomFactor; // Zoom Out
            }
            // Clamp Zoom Boundaries
            zoom = Math.max(0.1, Math.min(zoom, 15.0));
            repaint();
        }

        @Override public void mouseClicked(MouseEvent e) {}
        @Override public void mouseEntered(MouseEvent e) {}
        @Override public void mouseExited(MouseEvent e) {}
        @Override public void mouseMoved(MouseEvent e) {}
    }
