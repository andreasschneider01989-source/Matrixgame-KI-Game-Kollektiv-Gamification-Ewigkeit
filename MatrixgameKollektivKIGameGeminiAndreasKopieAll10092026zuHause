                    g2d.drawLine((int) x, (int) y, (int) targetX, (int) targetY);
                }
            }
        }

        public boolean containsWorldPoint(double wx, double wy) {
            double dx = wx - x;
            double dy = wy - y;
            return (dx * dx + dy * dy) <= (20 * 20);
        }
    }

