    long pauseTime = 60;

    public void gameLoop() {
        while (true) {
            if (!isGameOver) {
                simulationTicks++;
                if (globalEntropyPool < 150.0) {
                    globalEntropyPool += 0.15;
                }

                evaluateBoardState();
                
                // Prüfe, ob Könige noch leben
                boolean king1Alive = false;
                boolean king2Alive = false;
                for (Unit u : unitList) {
                    if ("King".equals(u.typ) && u.leben > 0) {
                        if (u.team == 1) king1Alive = true;
                        if (u.team == 2) king2Alive = true;
                    }
                }

                if (!king1Alive) {
                    isGameOver = true;
                    gameResultText = "NIEDERLAGE: Dein King wurde vernichtet!";
                    System.out.println(">>> " + gameResultText);
                } else if (!king2Alive) {
                    isGameOver = true;
                    gameResultText = "SIEG: Der feindliche King wurde eliminiert!";
                    System.out.println(">>> " + gameResultText);
                }

                if (!isGameOver && !unitList.isEmpty()) {
                    int randNumber = (int) (unitList.size() * Math.random());
                    Unit current = unitList.get(randNumber);
                    
                    if (current.leben > 0) {
                        if (current.team == 1) {
                            if ("ALPHA_MANEUVER".equals(current.decisionAlgorithm) && current.targetPosX != null && current.targetPosY != null) {
                                current.moveTo(current.targetPosX, current.targetPosY, current.posZ, current.speed);
                                if (current.getDistanceTo(current.targetPosX, current.targetPosY, current.posZ) < 0.1) {
                                    current.targetPosX = null;
                                    current.targetPosY = null;
                                    current.decisionAlgorithm = "IDLE";
                                }
                            } else if ("ALPHA_FOCUS".equals(current.decisionAlgorithm) && current.manualTarget != null) {
                                current.target = current.manualTarget;
                                if (current.target.leben <= 0) {
                                    current.decisionAlgorithm = "IDLE";
                                    current.manualTarget = null;
                                } else if (current.getDistance(current.target) <= current.reichweite) {
                                    current.attackieren(current.target);
                                } else {
                                    current.moveTo(current.target);
                                }
                            }
                        } else {
                            if (current.target == null || current.target.leben <= 0) {
                                current.target = selectAlphaTarget(current);
                            }
                            current.moveTo(current.target);
                            if (current.target != null && current.getDistance(current.target) <= current.reichweite) {
                                current.attackieren(current.target);
                            }
                        }
                    }
                }
            }
            
            repaint();
            try {
                Thread.sleep(pauseTime);
            } catch (InterruptedException e) {
                e.printStackTrace();
            }
        }
    }

    public void evaluateBoardState() {
        double score = 0;
        for (Unit u : unitList) {
            double weight = "King".equals(u.typ) ? 5.0 : ("Heavy".equals(u.typ) ? 2.5 : 1.0);
            if (u.team == 1) score += (u.leben / u.maxLeben) * weight;
            else score -= (u.leben / u.maxLeben) * weight;
        }
        currentBoardEvaluation = score;
    }

    public Unit selectAlphaTarget(Unit current) {
        Unit bestTarget = null;
        double minMetric = Double.MAX_VALUE;
        for (Unit ziel : unitList) {
            if (current.team != ziel.team && ziel.leben > 0) {
                double dist = current.getDistance(ziel);
                double healthRatio = ziel.leben / ziel.maxLeben;
                double priorityWeight = "King".equals(ziel.typ) ? 0.3 : ("Heavy".equals(ziel.typ) ? 0.7 : 1.0);
                double metric = dist * healthRatio * priorityWeight;
                if (metric < minMetric) {
                    minMetric = metric;
                    bestTarget = ziel;
                }
            }
        }
        return bestTarget;
    }

