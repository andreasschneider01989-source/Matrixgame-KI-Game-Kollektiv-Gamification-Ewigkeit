Der Hauptfehler in deinem Snippet liegt im statischen Kontext: Die main-Methode ist static. Wenn du dort einfach addKeyListener(...) oder repaint() aufrufst, weiß Java nicht, welches Fenster gemeint ist. Zudem waren Variablen wie width, hight, achsenSichtbar oder die Klasse selectedKugel nicht deklariert.

Für eine logisch saubere und performante Architektur (wie für das Matrixgame gefordert) lagern wir den KeyListener direkt in den Konstruktor der MainGame-Klasse aus. Dadurch kann der Listener nativ und ohne Umwege auf alle Instanzvariablen und Methoden (wie repaint() oder updateInfoText()) zugreifen.

Hier ist der vollständige, kompilierbare und logisch korrigierte Code in einem einzigen Codeblock. Ich habe die fehlenden Variablen und eine Dummy-Klasse für Kugel ergänzt, damit die Logik sofort funktioniert:
Java

package ordner1;

import java.awt.Color;
import java.awt.Graphics;
import java.awt.event.KeyAdapter;
import java.awt.event.KeyEvent;
import java.util.ArrayList;
import java.util.List;
import javax.swing.JFrame;

// Neue Klasse für die Kugel-Logik passend zu deinen Variablen
class Kugel {
    boolean updatePositionAktiv = false;
    boolean entropieMoveAktiv = false;
}

// Definition der Unit-Klasse für die Positionsdaten
class Unit {
    double x;
    double y;
    double z;
}

public class MainGame extends JFrame {

    List<Unit> UnitList = new ArrayList<Unit>();

    // Steuerungsvariablen (als Klassenvariablen definiert, damit der KeyListener sie direkt nutzen kann)
    boolean achsenSichtbar = false;
    int indexAxisX = 0;
    int indexAxisY = 0;
    String[] verfuegbareVariablen = {"X", "Y", "Z"}; 
    Kugel selectedKugel = new Kugel(); // Dummy-Zuweisung, damit es keine NullPointerException gibt

    // Konstruktor: Hier wird die Logik für das Objekt sauber initialisiert
    public MainGame() {
        // KeyAdapter direkt an die Instanz binden
        this.addKeyListener(new KeyAdapter() {
            @Override
            public void keyPressed(KeyEvent e) {
                if (e.getKeyCode() == KeyEvent.VK_A) {
                    achsenSichtbar = !achsenSichtbar;
                    repaint(); // Ruft nun korrekt die repaint()-Methode dieser JFrame-Instanz auf
                } else if (e.getKeyCode() == KeyEvent.VK_H) {
                    indexAxisX = (indexAxisX + 1) % verfuegbareVariablen.length;
                    updateInfoText();
                    repaint();
                } else if (e.getKeyCode() == KeyEvent.VK_V) {
                    indexAxisY = (indexAxisY + 1) % verfuegbareVariablen.length;
                    updateInfoText();
                    repaint();
                }

                // OBJEKT-STEUERUNG
                else if (e.getKeyCode() == KeyEvent.VK_P) {
                    if (selectedKugel != null) {
                        selectedKugel.updatePositionAktiv = !selectedKugel.updatePositionAktiv;
                        updateInfoText();
                    }
                } else if (e.getKeyCode() == KeyEvent.VK_E) {
                    if (selectedKugel != null) {
                        selectedKugel.entropieMoveAktiv = !selectedKugel.entropieMoveAktiv;
                        updateInfoText();
                    }
                }
