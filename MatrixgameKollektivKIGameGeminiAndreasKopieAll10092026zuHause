    static final double ZOOM_STEP = 1.15;
    double feinheit = 40;
    double PAN_STEP = feinheit * zoomFactor;

    // Globale Entropie- und AlphaZero-Trainingsmetriken
    double globalEntropyPool = 150.0;
    long simulationTicks = 0;
    int currentLevel = 4;
    double currentBoardEvaluation = 0.0;

