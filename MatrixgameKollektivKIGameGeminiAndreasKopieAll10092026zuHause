package ordner3;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.awt.geom.AffineTransform;
import java.awt.geom.Ellipse2D;
import java.awt.geom.Rectangle2D;
import java.util.ArrayList;
import java.util.List;

// =====================================================================
// MATRIXGAME: RTS STRATEGY, BOX SELECTION & MISSION ENGINE
// =====================================================================
class Unit {
    double x, y, z;
    double vx, vy, vz;
    double targetX = Double.NaN, targetY = Double.NaN; // Wegpunkt-Navigation
    double mass, radius;
    Color color;
    
    boolean updatePositionAktiv = true;
    boolean entropieMoveAktiv = true;
    double entropieMoveSpeed2ProCent = 70;
    double pe4 = 0.5;

    public Unit() {}

    public double getVariable(String varName) {
        switch (varName) {
            case "x": return x;
            case "y": return y;
            case "z": return z;
            case "vx": return vx;
            case "vy": return vy;
            case "vz": return vz;
            case "mass": return mass;
            case "radius": return radius;
            case "ekin": return 0.5 * mass * (vx*vx + vy*vy + vz*vz);
            default: return 0.0;
        }
    }

    public void setVariable(String varName, double val) {
        switch (varName) {
            case "x": x = val; break;
            case "y": y = val; break;
            case "z": z = val; break;
            case "vx": vx = val; break;
            case "vy": vy = val; break;
            case "vz": vz = val; break;
            case "mass": mass = Math.max(0.1, val); radius = Math.min(12, Math.max(2, Math.cbrt(mass))); break;
            case "radius": radius = val; break;
        }
    }

    public void update(String axisXName, String axisYName) {
        // Wenn ein Wegpunkt (Rechtsklick) gesetzt ist, steuere diesen an
        if (!Double.isNaN(targetX) && !Double.isNaN(targetY)) {
            double curX = getVariable(axisXName);
            double curY = getVariable(axisYName);
            double dx = targetX - curX;
            double dy = targetY - curY;
            double dist = Math.hypot(dx, dy);
            
            if (dist > 1.0) {
                double speed = 3.0;
                vx = (dx / dist) * speed;
                vy = (dy / dist) * speed;
            } else {
                vx *= 0.8;
                vy *= 0.8;
                targetX = Double.NaN;
                targetY = Double.NaN;
            }
        }

        if (updatePositionAktiv) {
            x += vx * 0.05;
            y += vy * 0.05;
            z += vz * 0.05;
        }
        if (entropieMoveAktiv && Math.random() * 100 < entropieMoveSpeed2ProCent && Double.isNaN(targetX)) {
            vx += (Math.random() - 0.5) * pe4;
            vy += (Math.random() - 0.5) * pe4;
            vz += (Math.random() - 0.5) * pe4;
        }
    }

    public void randEntropie4(Unit other) {
        double dx = other.x - this.x;
        double dy = other.y - this.y;
        double dist = Math.sqrt(dx*dx + dy*dy);
        if (dist > 0 && dist < 50) {
            vx += (dx / dist) * 0.02;
            vy += (dy / dist) * 0.02;
        }
    }

    public double getDistance(Unit other) {
        return Math.sqrt(Math.pow(other.x - x, 2) + Math.pow(other.y - y, 2) + Math.pow(other.z - z, 2));
    }

    public void fressen(Unit other) {
        this.mass += other.mass * 0.1;
        this.radius = Math.min(15, Math.max(2, Math.cbrt(this.mass)));
    }
}

public class MainGame extends JPanel {
    private List<Unit> unitList = new ArrayList<>();
    private List<Unit> selectedUnits = new ArrayList<>();
    private double zoom = 15.0;
    private StringBuilder infoText = new StringBuilder();

    private double kameraX = 0;
    private double kameraY = 0;

    private boolean isDraggingCamera = false;
    private boolean isSelectingBox = false;
    private int boxStartX, boxStartY, boxCurrentX, boxCurrentY;
    private int lastMouseX, lastMouseY;

    private String[] verfuegbareVariablen = { "x", "y", "z", "vx", "vy", "vz", "mass", "radius", "ekin" };
    private int indexAxisX = 0;
    private int indexAxisY = 1;

    private long startZeit;
    private int simulationsSchritte = 0;
    private Timer simulationTimer;
    private boolean achsenSichtbar = true;
    
    // Steuerungs-Zustände & Missionen
    private boolean skaliereRadiusMitZoom = false;
    private boolean inVacuumMode = false; 
    private boolean keyW = false, keyA = false, keyS = false, keyD = false;
    private int currentMission = 1;

    int randChar() { return (int) (Math.random() * 256); }
    Color randColor() { return new Color(randChar(), randChar(), randChar()); }

    public void init() {
        for (int i = 0; i < 1500; i++) {
            Unit unit = new Unit();
            unit.x = (Math.random() - 0.5) * 100;
            unit.y = (Math.random() - 0.5) * 100;
            unit.z = (Math.random() - 0.5) * 100;
            unit.vx = (Math.random() - 0.5) * 2;
            unit.vy = (Math.random() - 0.5) * 2;
            unit.vz = (Math.random() - 0.5) * 2;
            unit.mass = 10 + Math.random() * 100;
            unit.radius = Math.min(10, Math.max(2, Math.cbrt(unit.mass)));
            unit.color = randColor();
            unitList.add(unit);
        }
    }

    public MainGame() {
        setPreferredSize(new Dimension(1200, 900));
        setBackground(Color.BLACK);
        startZeit = System.currentTimeMillis();
        init();

        addMouseListener(new MouseAdapter() {
            public void mousePressed(MouseEvent e) {
                lastMouseX = e.getX();
                lastMouseY = e.getY();

                if (SwingUtilities.isRightMouseButton(e)) {
                    // Rechtsklick: Entweder Kamera-Pan (mit Shift) oder Wegpunkt-Befehl für Schwarm
                    if (e.isShiftDown()) {
                        isDraggingCamera = true;
                    } else if (!selectedUnits.isEmpty()) {
                        // Berechne Weltkoordinaten des Rechtsklicks
                        double targetWorldX = kameraX + (e.getX() - getWidth() / 2.0) / zoom;
                        double targetWorldY = kameraY + (getHeight() / 2.0 - e.getY()) / zoom;
                        for (Unit u : selectedUnits) {
                            u.targetX = targetWorldX;
                            u.targetY = targetWorldY;
                        }
                    }
                } else if (SwingUtilities.isLeftMouseButton(e)) {
                    // Prüfe ob direkt auf eine Unit geklickt wurde
                    Unit anklickZiel = null;
                    for (Unit k : unitList) {
                        double valX = k.getVariable(verfuegbareVariablen[indexAxisX]);
                        double valY = k.getVariable(verfuegbareVariablen[indexAxisY]);
                        int screenX = (int) (getWidth() / 2.0 + (valX - kameraX) * zoom);
                        int screenY = (int) (getHeight() / 2.0 - (valY - kameraY) * zoom);
                        int distanz = (int) Math.hypot(e.getX() - screenX, e.getY() - screenY);
                        int hitRadius = skaliereRadiusMitZoom ? (int)(k.radius * zoom) : (int)Math.max(4, Math.cbrt(k.mass) * 1.5);
                        if (distanz <= hitRadius + 4) {
                            anklickZiel = k;
                            break;
                        }
                    }

                    if (anklickZiel != null) {
                        if (e.isShiftDown()) {
                            if (selectedUnits.contains(anklickZiel)) selectedUnits.remove(anklickZiel);
                            else selectedUnits.add(anklickZiel);
                        } else {
                            if (!selectedUnits.contains(anklickZiel)) {
                                selectedUnits.clear();
                                selectedUnits.add(anklickZiel);
                            }
                        }
                    } else {
                        // Kein direkter Klick auf Unit -> Starte Box-Selektion (Marquee)
                        isSelectingBox = true;
                        boxStartX = e.getX();
                        boxStartY = e.getY();
                        boxCurrentX = e.getX();
                        boxCurrentY = e.getY();
                        if (!e.isShiftDown()) {
                            selectedUnits.clear();
                        }
                    }
                    updateInfoText();
                    repaint();
                }
            }

            public void mouseReleased(MouseEvent e) {
                if (SwingUtilities.isRightMouseButton(e)) {
                    isDraggingCamera = false;
                } else if (SwingUtilities.isLeftMouseButton(e)) {
                    if (isSelectingBox) {
                        isSelectingBox = false;
                        // Konvertiere Auswahl-Rechteck in Weltkoordinaten und selektiere Units
                        int x1 = Math.min(boxStartX, e.getX());
                        int x2 = Math.max(boxStartX, e.getX());
                        int y1 = Math.min(boxStartY, e.getY());
                        int y2 = Math.max(boxStartY, e.getY());

                        if (Math.abs(x2 - x1) > 5 || Math.abs(y2 - y1) > 5) {
                            for (Unit k : unitList) {
                                double valX = k.getVariable(verfuegbareVariablen[indexAxisX]);
                                double valY = k.getVariable(verfuegbareVariablen[indexAxisY]);
                                int screenX = (int) (getWidth() / 2.0 + (valX - kameraX) * zoom);
                                int screenY = (int) (getHeight() / 2.0 - (valY - kameraY) * zoom);
                                if (screenX >= x1 && screenX <= x2 && screenY >= y1 && screenY <= y2) {
                                    if (!selectedUnits.contains(k)) {
                                        selectedUnits.add(k);
                                    }
                                }
                            }
                        }
                    }
                    updateInfoText();
                    repaint();
                }
            }
        });

        addMouseMotionListener(new MouseMotionAdapter() {
            public void mouseDragged(MouseEvent e) {
                if (isDraggingCamera) {
                    kameraX -= (e.getX() - lastMouseX) / zoom;
                    kameraY += (e.getY() - lastMouseY) / zoom;
                    lastMouseX = e.getX();
                    lastMouseY = e.getY();
                    repaint();
                } else if (isSelectingBox) {
                    boxCurrentX = e.getX();
                    boxCurrentY = e.getY();
                    repaint();
                }
            }
        });

        addMouseWheelListener(e -> {
            if (e.getWheelRotation() < 0) zoom *= 1.1;
            else zoom /= 1.1;
            if (zoom < 0.0001) zoom = 0.0001;
            repaint();
        });

        setFocusable(true);
        addKeyListener(new KeyAdapter() {
            public void keyPressed(KeyEvent e) {
                switch (e.getKeyCode()) {
                    case KeyEvent.VK_W: keyW = true; break;
                    case KeyEvent.VK_A: keyA = true; break;
                    case KeyEvent.VK_S: keyS = true; break;
                    case KeyEvent.VK_D: keyD = true; break;
                    
                    case KeyEvent.VK_H: indexAxisX = (indexAxisX + 1) % verfuegbareVariablen.length; updateInfoText(); repaint(); break;
                    case KeyEvent.VK_V: indexAxisY = (indexAxisY + 1) % verfuegbareVariablen.length; updateInfoText(); repaint(); break;
                    case KeyEvent.VK_R: skaliereRadiusMitZoom = !skaliereRadiusMitZoom; updateInfoText(); repaint(); break;
                    case KeyEvent.VK_M: inVacuumMode = !inVacuumMode; updateInfoText(); break;
                    case KeyEvent.VK_NUMPAD1: case KeyEvent.VK_1: currentMission = 1; updateInfoText(); break;
                    case KeyEvent.VK_NUMPAD2: case KeyEvent.VK_2: currentMission = 2; updateInfoText(); break;
                    
                    case KeyEvent.VK_SPACE:
                        for (Unit u : selectedUnits) {
                            u.targetX = Double.NaN; u.targetY = Double.NaN; // Stoppe Wegpunkt bei Kampf
                            for (int i = 0; i < unitList.size(); i++) {
                                Unit other = unitList.get(i);
                                if (other != u && u.getDistance(other) < 35.0) {
                                    u.fressen(other);
                                    other.vx += (Math.random() - 0.5) * 4;
                                    other.vy += (Math.random() - 0.5) * 4;
                                }
                            }
                        }
                        updateInfoText();
                        break;

                    case KeyEvent.VK_F:
                        List<Unit> neueProjektile = new ArrayList<>();
                        for (Unit u : selectedUnits) {
                            Unit p = new Unit();
                            p.x = u.x; p.y = u.y; p.z = u.z;
                            p.vx = u.vx * 1.5 + (Math.random() - 0.5) * 5;
                            p.vy = u.vy * 1.5 + (Math.random() - 0.5) * 5;
                            p.mass = 5.0; p.radius = 2.5; p.color = Color.CYAN;
                            neueProjektile.add(p);
                        }
                        unitList.addAll(neueProjektile);
                        updateInfoText();
                        break;
                }
            }

            public void keyReleased(KeyEvent e) {
                switch (e.getKeyCode()) {
                    case KeyEvent.VK_W: keyW = false; break;
                    case KeyEvent.VK_A: keyA = false; break;
                    case KeyEvent.VK_S: keyS = false; break;
                    case KeyEvent.VK_D: keyD = false; break;
                }
            }
        });

        // Simulations- und RTS-Schwarm-Loop (30 FPS)
        simulationTimer = new Timer(30, e -> {
            if (!selectedUnits.isEmpty()) {
                double fx = 0, fy = 0;
                if (keyW) { fy += 1.0; clearTargets(); }
                if (keyS) { fy -= 1.0; clearTargets(); }
                if (keyA) { fx -= 1.0; clearTargets(); }
                if (keyD) { fx += 1.0; clearTargets(); }

                for (Unit u : selectedUnits) {
                    if (inVacuumMode) {
                        if (fx != 0 || fy != 0) {
                            u.vx += fx * 0.2;
                            u.vy += fy * 0.2;
                        }
                    } else {
                        if (fx != 0 || fy != 0) {
                            u.vx = fx * 3.5;
                            u.vy = fy * 3.5;
                            u.updatePositionAktiv = true;
                        } else if (Double.isNaN(u.targetX)) {
                            u.vx *= 0.85;
                            u.vy *= 0.85;
                        }
                    }
                }
            }

            // Physik & Update für alle Units
            String axisXName = verfuegbareVariablen[indexAxisX];
            String axisYName = verfuegbareVariablen[indexAxisY];
            for (int i = 0; i < unitList.size(); i++) {
                Unit k = unitList.get(i);
                k.update(axisXName, axisYName);
                int posOther = (int) (Math.abs(i + k.mass) % unitList.size());
                if (posOther != i) {
                    k.randEntropie4(unitList.get(posOther));
                    if (Math.random() > 0.999 && k.getDistance(unitList.get(posOther)) < 20) {
                        k.fressen(unitList.get(posOther));
                    }
                }
            }
            simulationsSchritte++;
            if (!selectedUnits.isEmpty()) updateInfoText();
            repaint();
        });
        simulationTimer.start();
    }

    private void clearTargets() {
        for (Unit u : selectedUnits) {
            u.targetX = Double.NaN;
            u.targetY = Double.NaN;
        }
    }

    private void updateInfoText() {
        infoText.setLength(0);
        long abgelaufeneZeit = System.currentTimeMillis() - startZeit;
        infoText.append("=== MATRIXGAME: RTS & MISSION ENGINE ===\n");
        infoText.append(String.format("Zeit: %.1fs | Schritte: %d | Total Units: %d\n", abgelaufeneZeit / 1000.0, simulationsSchritte, unitList.size()));
        infoText.append(String.format("Mission [%d]: %s\n", currentMission, currentMission == 1 ? "Schwarm-Stabilisierung & Entropie-Bändigung" : "Interstellares Imperium & KI-Optimierung"));
        infoText.append(String.format("Achse H [H]: %s | Achse V [V]: %s\n", verfuegbareVariablen[indexAxisX], verfuegbareVariablen[indexAxisY]));
        infoText.append(String.format("Flugmodus [M]: %s | Selektiert: %d Units\n\n", inVacuumMode ? "VAKUUM (Trägheit)" : "ÄTHER (Reibung)", selectedUnits.size()));

        if (!selectedUnits.isEmpty()) {
            Unit lead = selectedUnits.get(0);
            infoText.append("=== SCHWARM-FÜHRER / KONTROLLE ===\n");
            infoText.append(String.format("Leader Pos: x: %.2f | y: %.2f\n", lead.x, lead.y));
            infoText.append("Steuerung: [Box-Ziehen] Schwarm wählen | [Rechtsklick] Wegpunkt | [WASD] Manuell\n");
        } else {
            infoText.append("Ziehe einen Rahmen mit der Maus, um Einheiten als Schwarm zu wählen!");
        }
    }

    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        
        int breite = getWidth();
        int hoehe = getHeight();

        AffineTransform oldTransform = g2.getTransform();
        
        g2.translate(breite / 2.0 - kameraX * zoom, hoehe / 2.0 + kameraY * zoom);
        g2.scale(zoom, -zoom);

        if (achsenSichtbar) {
            g2.setColor(new Color(0, 100, 0, 150));
            g2.setStroke(new BasicStroke((float)(1.0 / zoom)));
            g2.drawLine(-1000000, 0, 1000000, 0);
            g2.drawLine(0, -1000000, 0, 1000000);
        }

        for (Unit k : unitList) {
            double valX = k.getVariable(verfuegbareVariablen[indexAxisX]);
            double valY = k.getVariable(verfuegbareVariablen[indexAxisY]);
            
            double r;
            if (skaliereRadiusMitZoom) {
                r = Math.max(0.2, k.radius);
            } else {
                double pixelSize = Math.max(3.0, Math.min(10.0, Math.cbrt(k.mass) * 1.5));
                r = pixelSize / zoom;
            }
            
            g2.setColor(k.color);
            g2.fill(new Ellipse2D.Double(valX - r, valY - r, r * 2, r * 2));

            if (selectedUnits.contains(k)) {
                g2.setColor(Color.YELLOW);
                double border = (skaliereRadiusMitZoom ? 2.0 : 3.0) / zoom;
                g2.setStroke(new BasicStroke((float) border));
                g2.draw(new Ellipse2D.Double(valX - r - border, valY - r - border, (r + border) * 2, (r + border) * 2));
            }
        }

        g2.setTransform(oldTransform);

        // --- Box-Selektions-Rechteck auf dem Bildschirm zeichnen ---
        if (isSelectingBox) {
            g2.setColor(new Color(0, 255, 255, 100));
            g2.setStroke(new BasicStroke(1.5f, BasicStroke.CAP_BUTT, BasicStroke.JOIN_MITER, 10.0f, new float[]{5.0f}, 0.0f));
            int x = Math.min(boxStartX, boxCurrentX);
            int y = Math.min(boxStartY, boxCurrentY);
            int w = Math.abs(boxCurrentX - boxStartX);
            int h = Math.abs(boxCurrentY - boxStartY);
            g2.drawRect(x, y, w, h);
            g2.setColor(new Color(0, 255, 255, 30));
            g2.fillRect(x, y, w, h);
        }

        // --- HUD / UI ---
        if (infoText.length() > 0) {
            g2.setColor(Color.WHITE);
            g2.setFont(new Font("Monospaced", Font.PLAIN, 12));
            String[] zeilen = infoText.toString().split("\n");
            for (int i = 0; i < zeilen.length; i++) {
                g2.drawString(zeilen[i], 20, 25 + i * 16);
            }
        }

        g2.setColor(Color.GRAY);
        g2.setFont(new Font("Monospaced", Font.PLAIN, 11));
        g2.drawString(String.format("Zoom: %.4f | Box-Ziehen: Schwarm wählen | Rechtsklick: Wegpunkt | 1/2: Missionen", zoom), 20, hoehe - 15);
    }

    public static void main(String[] args) {
        JFrame frame = new JFrame("Matrixgame: RTS Strategy & Mission Engine");
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.add(new MainGame());
        frame.setSize(1200, 900);
        frame.setLocationRelativeTo(null);
        frame.setVisible(true);
    }
