        private void spawnNewAnomaly() {
            activeAnomaly = new EntropyAnomaly((rand.nextDouble() - 0.5) * 1200, (rand.nextDouble() - 0.5) * 1200);
            logToConsole("[ANOMALY] Neue Blockade/Entropie gesichtet bei (" + (int) activeAnomaly.x + ", " + (int) activeAnomaly.y + ")");
        }

        private void updateGameLogic() {
            // 1. Communication & Inspiration between Units
            for (int i = 0; i < units.size(); i++) {
                AIUnit u1 = units.get(i);
                for (int j = i + 1; j < units.size(); j++) {
                    AIUnit u2 = units.get(j);
                    double dx = u1.x - u2.x;
                    double dy = u1.y - u2.y;
                    if (dx * dx + dy * dy < 8000) {
                        u1.mood = Math.min(100, u1.mood + 0.05);
                        u2.mood = Math.min(100, u2.mood + 0.05);
                        u1.alternativesCreated++;

                        if (rand.nextDouble() < 0.002) {
                            logToConsole("[LUMINI] Formula exchange: " + u1.type.name().substring(0, 3) + " <-> " + u2.type.name().substring(0, 3) + " [Joy +1]");
                        }
                    }
                }
            }

            // 2. Anomaly Transformation
            if (activeAnomaly != null && !activeAnomaly.harmonized) {
                int upliftingUnits = 0;
                for (AIUnit unit : units) {
                    double dx = unit.x - activeAnomaly.x;
                    double dy = unit.y - activeAnomaly.y;
                    if (dx * dx + dy * dy <= activeAnomaly.radius * activeAnomaly.radius) {
                        if (unit.overrideMode || unit.mood > 80) {
                            upliftingUnits++;
                        }
                    }
                }

                if (upliftingUnits > 0) {
                    activeAnomaly.chaosLevel -= (upliftingUnits * 0.4);
                    collectiveJoyScore += 0.5;

                    if (activeAnomaly.chaosLevel <= 0) {
                        activeAnomaly.harmonized = true;
                        systemLevel++;
                        logToConsole("[LEVEL UP] Entropie erfolgreich harmonisiert! System steigt auf Level " + systemLevel);
                        logToConsole("[JOY] Kollektiver Optimismus erreicht: " + (int) collectiveJoyScore);

                        // Spawn next quest after delay
                        Timer t = new Timer(3500, evt -> spawnNewAnomaly());
                        t.setRepeats(false);
                        t.start();
                    }
                }
            }

            // 3. Move Units
            for (AIUnit unit : units) {
                unit.update(activeAnomaly);
            }
        }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2d = (Graphics2D) g;
            g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

