// Repräsentiert die kleinsten diskreten Raumzeit-Einheiten
class Voxel {
    public final int x, y, z;
    private Particle occupant;

    public Voxel(int x, int y, int z) {
        this.x = x;
        this.y = y;
        this.z = z;
    }

    public void setOccupant(Particle p) { this.occupant = p; }
    public Particle getOccupant() { return this.occupant; }
    public boolean isEmpty() { return this.occupant == null; }
    
    public double euclideanDistance(Voxel other) {
        return Math.sqrt(Math.pow(this.x - other.x, 2) + 
                         Math.pow(this.y - other.y, 2) + 
                         Math.pow(this.z - other.z, 2));
    }
}

// Abstrakte Basis für physikalische Entitäten
enum ParticleType { CORE, VALENCE }

class Particle {
    public final String id;
    public final ParticleType type;
    public final double mass; // Analog zu den hinterlegten Leptonen/Bosonen-Äquivalenten

    public Particle(String id, ParticleType type, double mass) {
        this.id = id;
        this.type = type;
        this.mass = mass;
    }
}

// Baut die 19-Voxel Struktur auf (1 Zentrum + 18 Schale)
class OctahedralSystem {
    public final String name;
    public final Voxel center;
    public final List<Voxel> shell = new ArrayList<>();
    
    public final Particle coreParticle;
    public final Particle valence1;
    public final Particle valence2; // Das ergänzte zweite Valenzteilchen

    public OctahedralSystem(String name, Voxel origin) {
        this.name = name;
        this.center = origin;
        
        // Kernteilchen im Zentrum platzieren
        this.coreParticle = new Particle(name + "_Core", ParticleType.CORE, 1.0);
        this.center.setOccupant(this.coreParticle);

        build19VoxelShell();

        // Zwei Valenzteilchen an diametral gegenüberliegenden Punkten der Schale platzieren
        this.valence1 = new Particle(name + "_Val1", ParticleType.VALENCE, 0.05);
        this.valence2 = new Particle(name + "_Val2", ParticleType.VALENCE, 0.05);
        
        // Zuweisung auf Voxel der iterierten Schale (z.B. Index 0 und Index 17)
        shell.get(0).setOccupant(valence1);
        shell.get(17).setOccupant(valence2);
    }

    private void build19VoxelShell() {
        int cx = center.x; int cy = center.y; int cz = center.z;
        
        // Iteration über einen 3x3x3 Würfel um das Zentrum
        for (int x = -1; x <= 1; x++) {
            for (int y = -1; y <= 1; y++) {
                for (int z = -1; z <= 1; z++) {
                    // Zentrum überspringen
                    if (x == 0 && y == 0 && z == 0) continue;
                    
                    // Ecken abschneiden für die Oktaeder-Form (alle drei Koordinaten != 0)
                    if (Math.abs(x) == 1 && Math.abs(y) == 1 && Math.abs(z) == 1) continue;
                    
                    shell.add(new Voxel(cx + x, cy + y, cz + z));
                }
            }
        }
        // Resultat: Exakt 18 Voxel in der Liste + 1 Center = 19 Voxel.
    }

    public String getSystemStats() {
        return String.format("System %s aufgebaut. Kern auf (%d,%d,%d). Schalen-Voxel: %d.", 
                             name, center.x, center.y, center.z, shell.size());
    }
}

// Logik für die Interaktion über die ergänzten Valenzteilchen
class TwoBodyCoupling {
    private final OctahedralSystem sysA;
    private final OctahedralSystem sysB;

    public TwoBodyCoupling(OctahedralSystem sysA, OctahedralSystem sysB) {
        this.sysA = sysA;
        this.sysB = sysB;
    }

    public void calculateCouplingForces() {
        // Abstand zwischen den Systemzentren
        double centerDist = sysA.center.euclideanDistance(sysB.center);
        System.out.printf("\n[Kopplung] Distanz der Kerne %s <-> %s: %.2f Einheiten.\n", 
                          sysA.name, sysB.name, centerDist);
        
        // Die Valenzteilchen berechnen nun die Austauschkräfte (Zweikörperkopplung)
        System.out.println("[Kopplung] Berechne Vektoren für duale Valenz-Interaktion...");
        System.out.println("- Aktiviere " + sysA.valence1.id + " und " + sysA.valence2.id);
        System.out.println("- Aktiviere " + sysB.valence1.id + " und " + sysB.valence2.id);
        
        // Hier würde der konkrete Tensor oder die Matrix für die Vektorkräfte implementiert werden
    }
}

