package ordner1;

import java.awt.Color;
import java.awt.Graphics;
import java.awt.event.KeyAdapter;
import java.awt.event.KeyEvent;
import java.util.ArrayList;
import java.util.List;
import javax.swing.JFrame;
import javax.swing.Timer; // Wichtig für den GameLoop in Swing

// Unit-Klasse für die Positionsdaten
class Unit {
    double x;
    double y;
    double z;
    
    // Platzhalter für zukünftige Bewegungsvektoren
    double speedX = (Math.random() - 0.5) * 2; 
    double speedY = (Math.random() - 0.5) * 2;
}

public class MainGame extends JFrame {

    static int width = 1920;
    static int hight = 1080;

    double mitteX = 0;
    double mitteY = 0;

    double zoomFaktor = 1.0;

    List<Unit> UnitList = new ArrayList<Unit>();

    public MainGame() {
        addKeyListener(new KeyAdapter() {
            public void keyPressed(KeyEvent e) {
                // Bewegung links, rechts, hoch, runter dividieren durch zoomFaktor damit bei
                // großem Zoom die Bewegung langsamer wird
                if (e.getKeyCode() == KeyEvent.VK_A) {
                    mitteX = mitteX - 10.0 / zoomFaktor;
                    // repaint(); wird nun vom GameLoop übernommen
                } else if (e.getKeyCode() == KeyEvent.VK_D) {
                    mitteX = mitteX + 10.0 / zoomFaktor;
                } else if (e.getKeyCode() == KeyEvent.VK_W) {
                    mitteY = mitteY - 10.0 / zoomFaktor;
                } else if (e.getKeyCode() == KeyEvent.VK_S) {
                    mitteY = mitteY + 10.0 / zoomFaktor;
                } else if (e.getKeyCode() == KeyEvent.VK_Q) {
                    zoomFaktor /= 1.2;
                } else if (e.getKeyCode() == KeyEvent.VK_E) {
                    zoomFaktor *= 1.2;
                }
            }
        });
    }

    public static void main(String[] args) {
        // Instance der MainGame Klasse mit default Konstruktor erzeugen und in der
        // Klasse definierte Methoden aufrufen von oben nach unten
        MainGame mainGame = new MainGame();

        mainGame.init();
        mainGame.printText("Hello Universe");

        // Klasse Erbt von JFrame und erzeugt so ein canvas das wir sichtbar stellen
        mainGame.setVisible(true);

        // Und die größe einstellen
        mainGame.setSize(width, hight);

        // Und die Hintergrundfarbe
        mainGame.getContentPane().setBackground(new Color(0, 0, 0));
        
        // --- DER GAMELOOP ---
        // Ein Timer, der ca. 60 mal pro Sekunde (alle 16ms) tickt
        Timer gameLoop = new Timer(16, e -> {
            mainGame.updateLogic(); // Berechnet neue Positionen
            mainGame.repaint();     // Zeichnet das Bild neu
        });
        gameLoop.start();
    }

    // Input=String -> kein direkter Output aber Konsolenausgabe des Input Strings
    void printText(String text) {
        System.out.println(text);
    }

    void init() {
        for (int i = 0; i < 100; i++) {
            Unit u = new Unit();
            u.x = 500 * Math.random();
            u.y = 500 * Math.random();
            u.z = 500 * Math.random();
            UnitList.add(u);
        }
    }
    
    // NEU: Methode zur Aktualisierung der Spiel-Logik (unabhängig vom Zeichnen)
    void updateLogic() {
        for (Unit u : UnitList) {
            // Hier passiert später die Magie (z.B. Gravitation, Kollision, Entropie)
            u.x += u.speedX;
            u.y += u.speedY;
        }
    }

    // Erstelle Methode die ein erstes Objekt in das canvas zeichnet und dieses
    // vorher cleart und dann alle objekte neu zeichnet
    @Override
    public void paint(Graphics g) {

        super.paint(g);

        for (int i = 0; i < UnitList.size(); i++) {

            Unit unit = UnitList.get(i);
            g.setColor(new Color(255, 0, 0));

            // Wenn der Mittelpunt größer als die Position der Unit dann liegt die Unit
            // weiter links bzw. oben -> position Unit - mittelpunkt
            g.fillOval((int) (Math.round(unit.x * zoomFaktor) - mitteX * zoomFaktor + width / 2.0),
                    (int) (Math.round(unit.y * zoomFaktor - mitteY * zoomFaktor + hight / 2.0)), 10, 10);
        }
    }
}

