kannst du hier ein KListener Beispiel kurz definieren?

Hier ist ein kurzes und sauberes Beispiel, wie du einen KeyListener direkt in deine MainGame-Klasse einbindest, um Tastatureingaben (z. B. für Steuerungsbefehle) abzufangen.

Das Ganze ist wieder in einem einzigen Codeblock gehalten:
Java

package ordner1;

import java.awt.Color;
import java.awt.Graphics;
import java.awt.event.KeyEvent;
import java.awt.event.KeyListener;
import java.util.ArrayList;
import java.util.List;
import javax.swing.JFrame;

class Unit {
    double x;
    double y;
    double z;
}

public class MainGame extends JFrame implements KeyListener {

    List<Unit> UnitList = new ArrayList<Unit>();

    public MainGame() {
        // 1. KeyListener registrieren und sicherstellen, dass das Fenster den Fokus hat
        this.addKeyListener(this);
        this.setFocusable(true);
        this.requestFocusInWindow();
    }

    public static void main(String[] args) {
        MainGame mainGame = new MainGame();
        mainGame.init();

        mainGame.setVisible(true);
        mainGame.setSize(1920, 1080);
        mainGame.getContentPane().setBackground(new Color(0, 0, 0));
    }

    void init() {
        for (int i = 0; i < 100; i++) {
            Unit u = new Unit();
            u.x = 1800 * Math.random();
            u.y = 1000 * Math.random();
            UnitList.add(u);
        }
    }

    @Override
    public void paint(Graphics g) {
        super.paint(g);

        for (int i = 0; i < UnitList.size(); i++) {
            Unit unit = UnitList.get(i);
            g.setColor(new Color(255, 0, 0));
            g.fillOval((int) Math.round(unit.x), (int) Math.round(unit.y), 10, 10);
        }
    }

    // --- KeyListener Methoden (Pflichtüberschreibungen durch das Interface) ---

    @Override
    public void keyPressed(KeyEvent e) {
        // Reagiert, sobald eine Taste heruntergedrückt wird
        int keyCode = e.getKeyCode();
        System.out.println("Taste gedrückt: " + KeyEvent.getKeyText(keyCode));

        // Beispiel: Wenn 'W' gedrückt wird
        if (keyCode == KeyEvent.VK_W) {
            System.out.println("W-Taste erkannt! Hier kannst du Einheiten bewegen.");
        }
    }

    @Override
    public void keyReleased(KeyEvent e) {
        // Reagiert, wenn eine Taste losgelassen wird
    }

    @Override
    public void keyTyped(KeyEvent e) {
        // Reagiert auf tatsächliche Zeichen (z. B. Tippen in Textfelder)
    }
}

Wichtig für den KeyListener:

    implements KeyListener an der Klasse.

    this.addKeyListener(this) und this.setFocusable(true) im Konstruktor, damit das Fenster überhaupt mitbekommt, wenn du auf der Tastatur tippst.

