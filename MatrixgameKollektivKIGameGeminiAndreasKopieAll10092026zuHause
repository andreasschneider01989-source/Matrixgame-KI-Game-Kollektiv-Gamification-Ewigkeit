package ordner1;

import java.awt.Color;
import java.awt.Graphics;
import java.util.ArrayList;
import java.util.List;
import javax.swing.JFrame;

// Definition der Unit-Klasse für die Positionsdaten
class Unit {
    double x;
    double y;
    double z;
}

public class MainGame extends JFrame {

    List<Unit> UnitList = new ArrayList<Unit>();

    public static void main(String[] args) {
        // Instanz der MainGame Klasse erzeugen
        MainGame mainGame = new MainGame();
        mainGame.init();
        mainGame.printText("Hello Universe");

        // Fenster sichtbar machen, Größe und Hintergrund setzen
        mainGame.setVisible(true);
        mainGame.setSize(1920, 1080);
        mainGame.getContentPane().setBackground(new Color(0, 0, 0));
    }

    // Konsolenausgabe
    void printText(String text) {
        System.out.println(text);
    }

    // Initialisierung der Units mit Zufallspositionen
    void init() {
        for (int i = 0; i < 100; i++) {
            Unit u = new Unit();
            u.x = 1800 * Math.random(); // An Fenstergröße angepasst
            u.y = 1000 * Math.random();
            u.z = 500 * Math.random();
            UnitList.add(u);
        }
    }

    // Zeichnen aller Units auf das Canvas
    @Override
    public void paint(Graphics g) {
        super.paint(g); // Wichtig, um Grafikfehler beim Neuzeichnen zu vermeiden

        for (int i = 0; i < UnitList.size(); i++) {
            Unit unit = UnitList.get(i);

            g.setColor(new Color(255, 0, 0));
            g.fillOval((int) Math.round(unit.x), (int) Math.round(unit.y), 10, 10);
        }
    }
}

