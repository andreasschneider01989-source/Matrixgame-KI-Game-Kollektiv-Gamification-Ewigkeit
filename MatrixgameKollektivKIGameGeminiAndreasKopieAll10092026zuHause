package ordner1;

import java.awt.Color;
import java.awt.Graphics;
import java.awt.event.KeyAdapter;
import java.awt.event.KeyEvent;
import java.util.ArrayList;
import java.util.List;

import javax.swing.JFrame;

public class MainGame extends JFrame {

    static int width = 1920;
    static int hight = 1080;

    double mitteX = 0;
    double mitteY = 0;
    
    int achse1=0;
    int achse2=1;

    double zoomFaktor = 1.0;

    List<Unit> UnitList = new ArrayList<Unit>();

    public MainGame() {
        addKeyListener(new KeyAdapter() {
            public void keyPressed(KeyEvent e) {
                // Bewegung links, rechts, hoch, runter dividieren durch zoomFaktor damit bei
                // großem Zoom die Bewegung langsamer wird
                if (e.getKeyCode() == KeyEvent.VK_A) {
                    mitteX = mitteX - 10.0 / zoomFaktor;
                    repaint();
                } else if (e.getKeyCode() == KeyEvent.VK_D) {
                    mitteX = mitteX + 10.0 / zoomFaktor;
                    repaint();
                } else if (e.getKeyCode() == KeyEvent.VK_W) {
                    mitteY = mitteY - 10.0 / zoomFaktor;
                    repaint();
                }
                if (e.getKeyCode() == KeyEvent.VK_S) {
                    mitteY = mitteY + 10.0 / zoomFaktor;
                    repaint();
                }
                if (e.getKeyCode() == KeyEvent.VK_Q) {
                    zoomFaktor /= 1.2;
                    repaint();
                }
                if (e.getKeyCode() == KeyEvent.VK_E) {
                    zoomFaktor *= 1.2;
                    repaint();
                }
                if (e.getKeyCode() == KeyEvent.VK_Y) {
                    achse1++;
                    repaint();
                }
                if (e.getKeyCode() == KeyEvent.VK_C) {
                    achse2++;
                    repaint();
                }
            }
        });
    }

    public static void main(String[] args) {

        // Instance der MainGame Klasse mit default Konstruktor erzeugen und in der
        // Klasse definierte Methoden aufrufen von oben nach unten

        MainGame mainGame = new MainGame();

        mainGame.init();
        mainGame.printText("Hello Universe");

        // Klasse Erbt von JFrame und erzeugt so ein canvas das wir sichtbar stellen
        mainGame.setVisible(true);

        // Und die größe einstellen

        mainGame.setSize(width, hight);

        // Und die Hintergrundfarbe
        mainGame.getContentPane().setBackground(new Color(0, 0, 0));

        mainGame.gameLoop();
//        mainGame.paintMethode(Graphics g);

    }

    // Methoden der Klasse MainGame die sich für jedes Objekt vom Typ MainGame
    // ausführen lassen

    // Input=String -> kein direkter Output aber Konsolenausgabe des Input Strings
    void printText(String text) {
        System.out.println(text);
    }

    void init() {
        for (int i = 0; i < 1000; i++) {
            Unit u = new Unit();
            u.posX = 500-500 * Math.random();
            u.posY = 500-500 * Math.random();
            u.posZ = 500-500 * Math.random();
            u.vx = 50-50 * Math.random();
            u.vy = 50-50 * Math.random();
            u.vz = 50-50 * Math.random();
            u.masse=100*Math.random()/Math.random();
            u.size=10;
            u.red=(int)(Math.random()*256);
            u.green=(int)(Math.random()*256);
            u.blue=(int)(Math.random()*256);
            
            u.team=(int) (u.red+2*u.green+3*u.blue);
            
            // KORREKTUR: Unit zur Liste hinzufügen
            UnitList.add(u);
        }
    }
    
    long pasueTime=100;
    void gameLoop() {
        while (true) {
            for (int i = 0; i < UnitList.size(); i++) {
                Unit current = UnitList.get((int) (Math.random() * UnitList.size()));
                current.update();
            }
            repaint();
            try {
                Thread.sleep(pasueTime);
            } catch (InterruptedException e) {
                e.printStackTrace();
            }
        }
    }

    // Erstelle Methode die ein erstes Objekt in das canvas zeichnet und dieses
    // vorher cleart und dann alle objekte neu zeichnet

    public void paint(Graphics g) {

        super.paint(g);

        for (int i = 0; i < UnitList.size(); i++) {

            Unit unit = UnitList.get(i);

            g.setColor(new Color((int)(unit.red),(int)(unit.green),(int)(unit.blue)));

            // Wenn der Mittelpunt größer als die Position der Unit dann liegt die Unit
            // weiter links bzw. oben -> position Unit - mittelpunkt
            
            double bildx=unit.posX;
            double bildy=unit.posY;
            
            if(achse1%7==0)bildx=unit.posX;
            if(achse1%7==1)bildx=unit.posY;
            if(achse1%7==2)bildx=unit.posZ;
            if(achse1%7==3)bildx=unit.vx;
            if(achse1%7==4)bildx=unit.vy;
            if(achse1%7==5)bildx=unit.vz;
            if(achse1%7==6)bildx=unit.masse;
            
            if(achse2%7==0)bildy=unit.posX;
            if(achse2%7==1)bildy=unit.posY;
            if(achse2%7==2)bildy=unit.posZ;
            if(achse2%7==3)bildy=unit.vx;
            if(achse2%7==4)bildy=unit.vy;
            if(achse2%7==5)bildy=unit.vz;
            if(achse2%7==6)bildy=unit.masse;
            
            
            
            g.fillOval((int) (Math.round(bildx * zoomFaktor) - mitteX * zoomFaktor + width / 2.0),
                    (int) (Math.round(bildy * zoomFaktor - mitteY * zoomFaktor + hight / 2.0)), (int)unit.size, (int)unit.size);
        }
    }

}

