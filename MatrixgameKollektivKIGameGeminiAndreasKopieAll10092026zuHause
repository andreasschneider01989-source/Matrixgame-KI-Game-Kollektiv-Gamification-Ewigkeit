        // --- AUDIO-SENSE / RESONANCE WAVE VISUALIZER ---
        private void drawAudioSenseWave(Graphics2D g2d) {
            int x = getWidth() - 320;
            int y = 10;
            int width = 300;
            int height = 80;

            g2d.setColor(new Color(10, 15, 25, 220));
            g2d.fillRect(x, y, width, height);
            g2d.setColor(new Color(142, 68, 173));
            g2d.drawRect(x, y, width, height);

            g2d.setFont(new Font("Monospaced", Font.BOLD, 10));
            g2d.setColor(Color.LIGHT_GRAY);
            g2d.drawString("HÖRERSINN: RESONANZ-SCHWINGUNG", x + 10, y + 18);

            g2d.setColor(new Color(0, 220, 255));
            g2d.setStroke(new BasicStroke(1.5f));

            int prevX = x + 10;
            int prevY = y + 50;
            for (int i = 0; i < width - 20; i += 4) {
                double wave = Math.sin((i * 0.05) + audioPhase) * 15.0 
                            + Math.sin((i * 0.1) - audioPhase * 0.5) * 8.0;
                int currentX = x + 10 + i;
                int currentY = (int) (y + 50 + wave);
                g2d.drawLine(prevX, prevY, currentX, currentY);
                prevX = currentX;
                prevY = currentY;
            }
        }

        private Point2D.Double screenToWorld(Point screenPt) {
            double wx = (screenPt.x - getWidth() / 2.0) / zoom - offsetX;
            double wy = (screenPt.y - getHeight() / 2.0) / zoom - offsetY;
            return new Point2D.Double(wx, wy);
        }

        @Override
        public void mousePressed(MouseEvent e) {
            Point2D.Double worldPt = screenToWorld(e.getPoint());

            if (SwingUtilities.isLeftMouseButton(e)) {
                boolean found = false;
                for (AIUnit unit : units) {
                    if (unit.containsWorldPoint(worldPt.x, worldPt.y)) {
                        if (selectedUnit != null) selectedUnit.selected = false;
                        selectedUnit = unit;
                        selectedUnit.selected = true;
                        found = true;
                        logToConsole("[SELECT] Unit " + unit.type.label + " angewählt.");
                        break;
                    }
                }
                if (!found && selectedUnit != null) {
                    selectedUnit.selected = false;
                    selectedUnit = null;
                }
            } else if (SwingUtilities.isRightMouseButton(e)) {
                if (selectedUnit != null) {
                    selectedUnit.targetX = worldPt.x;
                    selectedUnit.targetY = worldPt.y;
                    selectedUnit.hasTarget = true;
                    selectedUnit.overrideMode = true;
                    logToConsole("[GUARDIAN] Override-Vektor gesendet an (" + (int) worldPt.x + ", " + (int) worldPt.y + ")");
                } else {
                    dragStartScreen = e.getPoint();
                    isPanning = true;
                }
            }
        }

        @Override
        public void mouseDragged(MouseEvent e) {
            if (isPanning && dragStartScreen != null) {
                double dx = (e.getX() - dragStartScreen.x) / zoom;
                double dy = (e.getY() - dragStartScreen.y) / zoom;

                offsetX += dx;
                offsetY += dy;

                dragStartScreen = e.getPoint();
                repaint();
            }
        }

        @Override
        public void mouseReleased(MouseEvent e) {
            if (SwingUtilities.isRightMouseButton(e)) {
                isPanning = false;
                dragStartScreen = null;
            }
        }

        @Override
        public void mouseWheelMoved(MouseWheelEvent e) {
            double zoomFactor = 1.1;
            if (e.getWheelRotation() < 0) {
                zoom *= zoomFactor;
            } else {
                zoom /= zoomFactor;
            }
            zoom = Math.max(0.1, Math.min(zoom, 15.0));
            repaint();
        }

        @Override public void mouseClicked(MouseEvent e) {}
        @Override public void mouseEntered(MouseEvent e) {}
        @Override public void mouseExited(MouseEvent e) {}
        @Override public void mouseMoved(MouseEvent e) {}
    }
