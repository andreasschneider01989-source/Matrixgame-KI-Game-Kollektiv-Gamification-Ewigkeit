package package5;

import java.awt.Color;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public class Unit {

    public enum Type { A, U, G, C }

    // 4D Koordinaten & Geschwindigkeiten
    public double x, y, z, d4;
    public double vx, vy, vz, vd4;
    public double ax, ay, az, ad4;
    
    public double mass = 1.0;
    public int radius = 5;
    public Color color;
    public int team = 1;
    public int id;

    // Physische & Ressourcen-Zustände
    public double maxLeben = 100.0;
    public double leben = 100.0;
    public double damage = 15.0;
    public double moveSpeed = 0.5;
    public double reichweite = 0.8;
    
    // Egoismus & Macht-Parameter
    public double energy = 1.0;
    public double machtScore = 1.0;
    public double angstLevel = 0.0;
    public double gierLevel = 0.8;

    // Beziehungs- & Vertrauensnetzwerk
    public Map<Integer, Double> trustMap = new HashMap<>();
    public Unit target = null;
    public List<Unit> bonds = new ArrayList<>();
    public Type type = Type.A;

    // --- GRUNDLEGENDE BERECHNUNGEN ---

    public double calculatePower() {
        this.machtScore = (this.leben / Math.max(1.0, this.maxLeben)) * this.energy * this.mass;
        return this.machtScore;
    }

    public double getDistance(Unit other) {
        if (other == null) return Double.MAX_VALUE;
        double dx = other.x - this.x;
        double dy = other.y - this.y;
        double dz = other.z - this.z;
        double dd4 = other.d4 - this.d4;
        return Math.sqrt(dx * dx + dy * dy + dz * dz + dd4 * dd4);
    }

    // Wichtige Getter-Methode für MainGame (Abfrage über String-Namen)
    public double get(String name) {
        return switch (name) {
            case "x"      -> x;
            case "y"      -> y;
            case "z"      -> z;
            case "d4"     -> d4;
            case "vx"     -> vx;
            case "vy"     -> vy;
            case "vz"     -> vz;
            case "vd4"    -> vd4;
            case "mass"   -> mass;
            case "energy" -> energy;
            case "leben"  -> leben;
            default       -> 0.0;
        };
    }

    // --- SPIELTHEORETISCHE ENTSCHEIDUNGSMETHODE ---

    public void decideAndAct(List<Unit> allUnits) {
        calculatePower();
        this.angstLevel = Math.max(0.0, (1.0 - (this.leben / Math.max(1.0, this.maxLeben))));

        Unit bestPartner = null;
        Unit targetEnemy = null;
        double maxUtility = -999;
        double minTrust = 0.0;

        for (Unit other : allUnits) {
            if (other == this || other.leben <= 0) continue;
            double dist = getDistance(other);
            if (dist > 6.0) continue; // Sichtfeld / Wahrnehmungsradius

            double trust = trustMap.getOrDefault(other.id, 0.0);
            
            // Partner-Suche bei Symbiose
            if (trust > 0.2 && isComplementaryTo(other)) {
                bestPartner = other;
            }

            // Feind-Bewertung
            double utility = evaluateActionUtility(other);
            if (trust < minTrust || (other.team != this.team && utility > maxUtility)) {
                maxUtility = utility;
                targetEnemy = other;
            }
        }

        // AKTIONSAUSWAHL
        if (this.angstLevel > 0.6 && targetEnemy != null) {
            fleeFrom(targetEnemy);
        } else if (targetEnemy != null && maxUtility > 0.5) {
            this.target = targetEnemy;
            if (getDistance(targetEnemy) <= reichweite) {
                attackieren(targetEnemy);
            } else {
                moveTo(targetEnemy);
            }
        } else if (bestPartner != null) {
            cooperateWith(bestPartner);
        } else if (target != null && target.leben > 0) {
            if (getDistance(target) <= reichweite) {
                attackieren(target);
            } else {
                moveTo(target);
            }
        }
    }

    public double evaluateActionUtility(Unit other) {
        if (other == null) return -999;
        double meineMacht = calculatePower();
        double gegnerMacht = other.calculatePower();
        double beuteGewinn = other.energy * gierLevel;
        double risikoSchaden = (gegnerMacht / (meineMacht + 1e-5)) * 40.0;
        return beuteGewinn - risikoSchaden;
    }

    public void fleeFrom(Unit enemy) {
        double dist = getDistance(enemy) + 1e-5;
        vx -= ((enemy.x - x) / dist) * moveSpeed * 0.03;
        vy -= ((enemy.y - y) / dist) * moveSpeed * 0.03;
        vz -= ((enemy.z - z) / dist) * moveSpeed * 0.03;
        vd4 -= ((enemy.d4 - d4) / dist) * moveSpeed * 0.03;
    }

    public void cooperateWith(Unit partner) {
        moveTo(partner);
        if (getDistance(partner) < 1.5 && this.energy > 0.4) {
            this.energy += 0.003;
            this.mass += 0.0005;
        }
    }

    public void attackieren(Unit ziel) {
        if (ziel == null || ziel.leben <= 0) return;
        
        double schaden = this.damage * (0.8 + Math.random() * 0.4);
        ziel.leben -= schaden;
        
        if (ziel.energy > 0.2) {
            double gestohleneEnergie = 0.08;
            ziel.energy -= gestohleneEnergie;
            this.energy += gestohleneEnergie;
        }

        trustMap.put(ziel.id, -1.0);
        ziel.trustMap.put(this.id, -1.0);

        System.out.println(String.format("EGO-ATTACK | Unit %d (Macht: %.1f) greift Unit %d an! Schaden: %.2f (Rest-HP: %.2f)",
                this.id, this.machtScore, ziel.id, schaden, ziel.leben));
    }

    public void moveTo(Unit ziel) {
        if (ziel == null) return;
        double dist = getDistance(ziel) + 1e-5;
        vx += ((ziel.x - x) / dist) * moveSpeed * 0.02;
        vy += ((ziel.y - y) / dist) * moveSpeed * 0.02;
        vz += ((ziel.z - z) / dist) * moveSpeed * 0.02;
        vd4 += ((ziel.d4 - d4) / dist) * moveSpeed * 0.02;
    }

    public boolean isComplementaryTo(Unit other) {
        return (this.type == Type.A && other.type == Type.U) ||
               (this.type == Type.U && other.type == Type.A) ||
               (this.type == Type.G && other.type == Type.C) ||
               (this.type == Type.C && other.type == Type.G);
    }

    public static Color colorForType(Type t) {
        return switch (t) {
            case A -> new Color(255, 80, 80);
            case U -> new Color(80, 180, 255);
            case G -> new Color(80, 220, 120);
            case C -> new Color(255, 200, 60);
        };
    }
}
