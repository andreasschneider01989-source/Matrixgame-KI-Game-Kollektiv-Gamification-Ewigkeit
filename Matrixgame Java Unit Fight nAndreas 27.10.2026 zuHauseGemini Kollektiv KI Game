package package5;

import java.awt.Color;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public class Unit {

    public enum Type { A, U, G, C }

    // 4D Koordinaten & Geschwindigkeiten
    public double x, y, z, d4;
    public double vx, vy, vz, vd4;
    public double ax, ay, az, ad4;
    
    public double mass;
    public int radius;
    public Color color;
    public int team = 1; // Team-Zugehörigkeit
    public int id;       // Eindeutige ID für saubere Logs

    // Attribute für Kampf & Interaktion
    public double maxLeben = 100.0;
    public double leben = 100.0;
    public double damage = 15.0;
    public double moveSpeed = 0.5;
    public double reichweite = 0.8;

    // Beziehungs-Gedächtnis: Unit ID -> Vertrauenswert (-1.0 = Feind, +1.0 = Allianz)
    public Map<Integer, Double> trustMap = new HashMap<>();
    public Unit target = null;

    public List<Unit> bonds = new ArrayList<>();
    public Type type = Type.A;

    public double energy = 1.0;
    public static final double MAX_ENERGY = 3.0;
    public static final double MIN_ENERGY_FOR_BOND = 0.25;
    public static final double MIN_ENERGY_FOR_REPLICATION = 1.6;

    // --- ENTSCHEIDUNGS- & DYNAMIKMETHODEN ---

    public double getDistance(Unit other) {
        if (other == null) return Double.MAX_VALUE;
        double dx = other.x - this.x;
        double dy = other.y - this.y;
        double dz = other.z - this.z;
        double dd4 = other.d4 - this.d4;
        return Math.sqrt(dx * dx + dy * dy + dz * dz + dd4 * dd4);
    }

    public void attackieren(Unit ziel) {
        if (ziel == null || ziel.leben <= 0) return;
        
        double schaden = this.damage * (0.8 + Math.random() * 0.4);
        ziel.leben -= schaden;
        
        // Vertrauen sinkt drastisch durch Angriff -> Feindschaft entsteht
        double aktuellerTrust = trustMap.getOrDefault(ziel.id, 0.0);
        trustMap.put(ziel.id, Math.max(-1.0, aktuellerTrust - 0.6));
        ziel.trustMap.put(this.id, Math.max(-1.0, ziel.trustMap.getOrDefault(this.id, 0.0) - 0.6));

        System.out.println(String.format("ATTACK | Unit %d (Team %d) greift Unit %d (Team %d) an! Schaden: %.2f (Rest-HP: %.2f)",
                this.id, this.team, ziel.id, ziel.team, schaden, ziel.leben));
    }

    public void moveTo(Unit ziel) {
        if (ziel == null) return;
        double dist = getDistance(ziel) + 1e-5;
        double dirX = (ziel.x - x) / dist;
        double dirY = (ziel.y - y) / dist;
        double dirZ = (ziel.z - z) / dist;
        double dirD4 = (ziel.d4 - d4) / dist;

        vx += dirX * moveSpeed * 0.02;
        vy += dirY * moveSpeed * 0.02;
        vz += dirZ * moveSpeed * 0.02;
        vd4 += dirD4 * moveSpeed * 0.02;
    }

    public double get(String name) {
        return switch (name) {
            case "x"      -> x;
            case "y"      -> y;
            case "z"      -> z;
            case "d4"     -> d4;
            case "vx"     -> vx;
            case "vy"     -> vy;
            case "vz"     -> vz;
            case "vd4"    -> vd4;
            case "mass"   -> mass;
            case "energy" -> energy;
            default       -> 0.0;
        };
    }

    public boolean isComplementaryTo(Unit other) {
        return (this.type == Type.A && other.type == Type.U) ||
               (this.type == Type.U && other.type == Type.A) ||
               (this.type == Type.G && other.type == Type.C) ||
               (this.type == Type.C && other.type == Type.G);
    }

    public static Color colorForType(Type t) {
        return switch (t) {
            case A -> new Color(255, 80, 80);
            case U -> new Color(80, 180, 255);
            case G -> new Color(80, 220, 120);
            case C -> new Color(255, 200, 60);
        };
    }
}
