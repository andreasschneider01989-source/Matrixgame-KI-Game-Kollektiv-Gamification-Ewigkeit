child.y = u.y + (Math.random() - 0.5) * 0.5;

child.z = u.z + (Math.random() - 0.5) * 0.5;

child.d4 = u.d4 + (Math.random() - 0.5) * 0.5;

toAdd.add(child);

repCount++;

}

}

units.addAll(toAdd);



// 4. WICHTIG: Bonds aufräumen (tote Units aus Bonds löschen verhindert NPE!)

