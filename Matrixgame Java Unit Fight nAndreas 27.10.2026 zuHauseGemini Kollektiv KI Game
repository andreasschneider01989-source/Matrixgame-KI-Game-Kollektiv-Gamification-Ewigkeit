private Unit findNearest(int sx, int sy) {

Unit best = null;

double bestD = 20;

for (Unit u : units) {

if (u == null || u.leben <= 0) continue;

int px = worldToScreenX(u.get(axisNames[axisX]));

int py = worldToScreenY(u.get(axisNames[axisY]));

double d = Math.hypot(sx - px, sy - py);

if (d < bestD) {

bestD = d;

best = u;

}

}

return best;

}



