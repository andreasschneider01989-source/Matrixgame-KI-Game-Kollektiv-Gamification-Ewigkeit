@Override

public void mouseDragged(MouseEvent e) {

if (draggingCamera) {

camX -= (e.getX() - lastMouseX) / zoom;

camY += (e.getY() - lastMouseY) / zoom;

lastMouseX = e.getX();

lastMouseY = e.getY();

repaint();

}

}

});

addMouseWheelListener(e -> {

