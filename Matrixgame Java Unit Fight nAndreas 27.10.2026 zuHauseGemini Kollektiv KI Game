package package4;



import javax.swing.*;

import java.awt.*;

import java.awt.event.*;

import java.util.ArrayList;

import java.util.List;

import java.util.Locale;

import java.util.Map;



/**

 * MatrixGame – N-Körper + Bindung + Energie + Replikation + Tod + 4 Typen (A/U/G/C)

 *

 * Tasten:

 *   1 = Newton | 2 = Stochastic | 3 = Mixed

 *   B = Binding an/aus

 *   T = Auto-Replikation an/aus

 *   C = Manuelle Replikation der selektierten Unit

 *   H / V = Achsen

 *   R = Reset

 */

public class MainGame extends JPanel implements CollectiveGameInterface {



    // ===================== KONFIGURATION =====================

    private static final int DEFAULT_UNIT_COUNT = 420;

    private static final double G = 0.85;

    private static final double SOFTENING = 0.14;

    private static final double DT = 0.016;



    // Bindung

    private static final double BIND_DISTANCE = 0.55;

    private static final double BIND_STRENGTH = 0.04;

    private static final double BIND_BREAK_DISTANCE = 1.8;

    private boolean bindingEnabled = true;



    // Energie

    private static final double ENERGY_GAIN_PER_STEP = 0.004;

    private static final double BOND_COST = 0.18;

    private static final double REPLICATION_COST = 1.3;

    private static final double REPLICATION_CHANCE = 0.0008;

    private boolean autoReplication = true;



    // Tod

    private static final double DEATH_CHANCE = 0.025;



    // Mutation

    private static final double MUTATION_CHANCE = 0.04;



    public enum ForceMode { NEWTON, STOCHASTIC, MIXED }

    private ForceMode forceMode = ForceMode.NEWTON;



    // ===================== ZUSTAND =====================

    private final List<Unit> units = new ArrayList<>();

    private Unit selected = null;



    private double zoom = 50.0;

    private double camX = 0.0, camY = 0.0;

    private boolean draggingCamera = false;

    private boolean draggingObject = false;

    private int lastMouseX, lastMouseY;



    private final String[] axisNames = {"x", "y", "z","d4", "vx", "vy", "vz","vd4", "mass", "energy"};

    private int axisX = 0, axisY = 1;



    private int stepCount = 0;

    private final Timer timer;



    // Diagnostik

    private double totalKinetic, totalPotential;

    private double momentumX, momentumY, momentumZ;

    private double comX, comY, comZ;

    private int activeBonds = 0;



    private double avgEnergy = 0;

    private double avgBonds = 0;

    private int isolatedCount = 0;

    private int replicationCount = 0;

    private int deathCount = 0;



    // Typ-Verteilung

    private int countA, countU, countG, countC;



    // ===================== KONSTRUKTOR =====================

    public MainGame() {

        setPreferredSize(new Dimension(1200, 800));

        setBackground(Color.BLACK);

        setFocusable(true);



        initUnits(DEFAULT_UNIT_COUNT);

        setupInput();



        timer = new Timer(16, e -> {

            gameLoop();

            stepCount++;

            repaint();

        });

        timer.start();

    }



    // ===================== INITIALISIERUNG =====================

    private void initUnits(int count) {

        units.clear();

        Unit.Type[] types = Unit.Type.values();



        for (int i = 0; i < count; i++) {

            Unit u = new Unit();

            u.x  = (Math.random() - 0.5) * 10.0;

            u.y  = (Math.random() - 0.5) * 10.0;

            u.z  = (Math.random() - 0.5) * 10.0;

            u.d4  = (Math.random() - 0.5) * 10.0;

            u.vx = (Math.random() - 0.5) * 0.22;

            u.vy = (Math.random() - 0.5) * 0.22;

            u.vz = (Math.random() - 0.5) * 0.22;

            u.vd4 = (Math.random() - 0.5) * 0.22;

            u.mass = 0.45 + Math.random() * 2.1;

            u.radius = (int) (2.0 + Math.sqrt(u.mass) * 2.6);

            u.energy = 0.8 + Math.random() * 1.2;

            u.bonds = new ArrayList<>();



            u.type = types[(int) (Math.random() * types.length)];

            u.color = Unit.colorForType(u.type);



            units.add(u);

        }

        selected = null;

        stepCount = 0;

        replicationCount = 0;

        deathCount = 0;

        computeDiagnostics();

    }



    // ===================== GAME LOOP =====================

    private void gameLoop() {

        applyForces();



        if (bindingEnabled) {

            updateBonds();

            applyBondForces();

        }



        regenerateEnergy();



        if (autoReplication) {

            tryAutoReplication();

        }



        applyDeathRule();

        integrate();

        computeDiagnostics();



        // Status alle ~1,5 Sekunden in die Konsole

        if (stepCount % 90 == 0) {

            System.out.println(getStatusReport());

        }

    }



    // ===================== KRÄFTE =====================

    private void applyForces() {

        int n = units.size();

        double[] ax = new double[n];

        double[] ay = new double[n];

        double[] az = new double[n];

        double[] ad4 = new double[n];



        if (forceMode == ForceMode.NEWTON || forceMode == ForceMode.MIXED) {

            for (int i = 0; i < n; i++) {

                Unit a = units.get(i);

                for (int j = i + 1; j < n; j++) {

                    Unit b = units.get(j);

                    double dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z, dd4 = b.d4 - a.d4;

                    double r2 = dx*dx + dy*dy + dz*dz + dd4*dd4 + SOFTENING*SOFTENING;

                    double r = Math.sqrt(r2);

                    double f = G * a.mass * b.mass / r2 / r;

                    double fx = f * dx / r, fy = f * dy / r, fz = f * dz / r, fd4 = f * dd4 / r;



                    ax[i] += fx / a.mass; ay[i] += fy / a.mass; az[i] += fz / a.mass ;ad4[i]+= fd4 / a.mass;

                    ax[j] -= fx / b.mass; ay[j] -= fy / b.mass; az[j] -= fz / b.mass; ad4[j] -= fd4 / b.mass;

                }

            }

        }



        if (forceMode == ForceMode.STOCHASTIC || forceMode == ForceMode.MIXED) {

            int attempts = n * 2;

            for (int k = 0; k < attempts; k++) {

                int i = (int) (Math.random() * n);

                int j = (int) (Math.random() * n);

                if (i == j) continue;



                Unit a = units.get(i);

                Unit b = units.get(j);

                double dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z, dd4 = b.d4 -a.d4;

                double dist = Math.sqrt(dx*dx + dy*dy + dz*dz + dd4*dd4) + 1e-6;

                double prob = 0.06 / (1.0 + dist * dist);

                if (Math.random() > prob) continue;



                double strength = 0.0015 * (a.mass + b.mass) / dist;

                double ix = strength * dx / dist;

                double iy = strength * dy / dist;

                double iz = strength * dz / dist;

                double id4 = strength * dd4 / dist;



                a.vx += ix / a.mass; a.vy += iy / a.mass; a.vz += iz / a.mass;  a.vd4 += id4 / a.mass;

                b.vx -= ix / b.mass; b.vy -= iy / b.mass; b.vz -= iz / b.mass;  b.vd4 += id4 / b.mass;

            }

        }



        for (int i = 0; i < n; i++) {

            Unit u = units.get(i);

            u.ax = ax[i];

            u.ay = ay[i];

            u.az = az[i];

            u.ad4 = ad4[i];

        }

    }



    // ===================== BINDUNG (mit Typ-Präferenz) =====================

    private void updateBonds() {

        activeBonds = 0;

        int n = units.size();



        for (Unit u : units) {

            u.bonds.removeIf(other -> {

                double dx = other.x - u.x, dy = other.y - u.y, dz = other.z - u.z;

                double dist = Math.sqrt(dx*dx + dy*dy + dz*dz);

                return dist > BIND_BREAK_DISTANCE;

            });

            activeBonds += u.bonds.size();

        }

        activeBonds /= 2;



        for (int i = 0; i < n; i++) {

            Unit a = units.get(i);

            if (a.energy < Unit.MIN_ENERGY_FOR_BOND) continue;



            for (int j = i + 1; j < n; j++) {

                Unit b = units.get(j);

                if (b.energy < Unit.MIN_ENERGY_FOR_BOND) continue;

                if (a.bonds.contains(b)) continue;



                double dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z, dd4 = b.d4 - a.d4;

                double dist = Math.sqrt(dx*dx + dy*dy + dz*dz + dd4*dd4);



                double baseChance = 0.012;

                if (a.isComplementaryTo(b)) {

                    baseChance *= 3.5;   // komplementäre Paare stark bevorzugt

                } else {

                    baseChance *= 0.35;  // andere Paare deutlich seltener

                }



                if (dist < BIND_DISTANCE && Math.random() < baseChance) {

                    a.energy -= BOND_COST;

                    b.energy -= BOND_COST;

                    if (a.energy < 0) a.energy = 0;

                    if (b.energy < 0) b.energy = 0;



                    a.bonds.add(b);

                    b.bonds.add(a);

                }

            }

        }

    }



    private void applyBondForces() {

        for (Unit u : units) {

            for (Unit other : u.bonds) {

                double dx = other.x - u.x, dy = other.y - u.y, dz = other.z - u.z;

                double dist = Math.sqrt(dx*dx + dy*dy + dz*dz) + 1e-6;



                double force = BIND_STRENGTH * (dist - BIND_DISTANCE * 0.7);

                double fx = force * dx / dist;

                double fy = force * dy / dist;

                double fz = force * dz / dist;



                u.ax += fx / u.mass;

                u.ay += fy / u.mass;

                u.az += fz / u.mass;

            }

        }

    }



    // ===================== ENERGIE =====================

    private void regenerateEnergy() {

        for (Unit u : units) {

            u.energy += ENERGY_GAIN_PER_STEP;

            if (u.energy > Unit.MAX_ENERGY) {

                u.energy = Unit.MAX_ENERGY;

            }

        }

    }



    // ===================== REPLIKATION =====================

    private void tryAutoReplication() {

        List<Unit> snapshot = new ArrayList<>(units);

        for (Unit parent : snapshot) {

            if (parent.energy < Unit.MIN_ENERGY_FOR_REPLICATION) continue;

            if (Math.random() > REPLICATION_CHANCE) continue;

            replicate(parent);

        }

    }



    private void replicate(Unit parent) {

        if (parent.energy < REPLICATION_COST) return;



        parent.energy -= REPLICATION_COST;

        replicationCount++;



        Unit child = new Unit();

        child.x = parent.x + (Math.random() - 0.5) * 0.6;

        child.y = parent.y + (Math.random() - 0.5) * 0.6;

        child.z = parent.z + (Math.random() - 0.5) * 0.6;

        child.d4 = parent.d4 + (Math.random() - 0.5) * 0.6;



        child.vx = parent.vx * 0.7 + (Math.random() - 0.5) * 0.15;

        child.vy = parent.vy * 0.7 + (Math.random() - 0.5) * 0.15;

        child.vz = parent.vz * 0.7 + (Math.random() - 0.5) * 0.15;

        child.vd4 = parent.vd4 * 0.7 + (Math.random() - 0.5) * 0.15;



        child.mass = parent.mass * (0.85 + Math.random() * 0.3);

        child.radius = (int) (2.0 + Math.sqrt(child.mass) * 2.6);

        child.energy = 0.4 + Math.random() * 0.5;

        child.bonds = new ArrayList<>();



        // Vererbung + Mutation

        child.type = parent.type;

        if (Math.random() < MUTATION_CHANCE) {

            Unit.Type[] types = Unit.Type.values();

            child.type = types[(int) (Math.random() * types.length)];

        }

        child.color = Unit.colorForType(child.type);



        units.add(child);

    }



    // ===================== TOD =====================

    private void applyDeathRule() {

        for (int i = units.size() - 1; i >= 0; i--) {

            Unit u = units.get(i);



            if (u.energy <= 0.0 && u.bonds.isEmpty()) {

                if (Math.random() < DEATH_CHANCE) {

                    for (Unit other : units) {

                        other.bonds.remove(u);

                    }

                    units.remove(i);

                    deathCount++;

                    if (selected == u) selected = null;

                }

            }

        }

    }



    // ===================== INTEGRATION =====================

    private void integrate() {

        for (Unit u : units) {

            u.vx += u.ax * DT;

            u.vy += u.ay * DT;

            u.vz += u.az * DT;

            u.vd4 += u.ad4 * DT;

            u.x  += u.vx * DT;

            u.y  += u.vy * DT;

            u.z  += u.vz * DT;

            u.d4 += u.vd4 *DT;

        }

    }



    // ===================== DIAGNOSTIK =====================

    private void computeDiagnostics() {

        totalKinetic = totalPotential = 0;

        momentumX = momentumY = momentumZ = 0;

        comX = comY = comZ = 0;

        double totalMass = 0;



        double sumEnergy = 0;

        int sumBonds = 0;

        isolatedCount = 0;

        countA = countU = countG = countC = 0;



        for (Unit u : units) {

            double v2 = u.vx*u.vx + u.vy*u.vy + u.vz*u.vz;

            totalKinetic += 0.5 * u.mass * v2;

            momentumX += u.mass * u.vx;

            momentumY += u.mass * u.vy;

            momentumZ += u.mass * u.vz;

            comX += u.mass * u.x;

            comY += u.mass * u.y;

            comZ += u.mass * u.z;

            totalMass += u.mass;



            sumEnergy += u.energy;

            sumBonds += u.bonds.size();

            if (u.bonds.isEmpty()) isolatedCount++;



            switch (u.type) {

                case A -> countA++;

                case U -> countU++;

                case G -> countG++;

                case C -> countC++;

            }

        }



        int n = units.size();

        avgEnergy = n > 0 ? sumEnergy / n : 0;

        avgBonds  = n > 0 ? (double) sumBonds / n : 0;



        if (totalMass > 0) {

            comX /= totalMass;

            comY /= totalMass;

            comZ /= totalMass;

        }



        if (forceMode != ForceMode.STOCHASTIC) {

            for (int i = 0; i < n; i++) {

                for (int j = i + 1; j < n; j++) {

                    Unit a = units.get(i);

                    Unit b = units.get(j);

                    double dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z;

                    double r = Math.sqrt(dx*dx + dy*dy + dz*dz + SOFTENING*SOFTENING);

                    totalPotential -= G * a.mass * b.mass / r;

                }

            }

        }

    }



    // ===================== EINGABE =====================

    private void setupInput() {

        addMouseListener(new MouseAdapter() {

            @Override

            public void mousePressed(MouseEvent e) {

                if (SwingUtilities.isRightMouseButton(e)) {

                    draggingCamera = true;

                    lastMouseX = e.getX();

                    lastMouseY = e.getY();

                } else {

                    selected = findNearest(e.getX(), e.getY());

                    if (selected != null) {

                        draggingObject = true;

                        lastMouseX = e.getX();

                        lastMouseY = e.getY();

                    }

                    repaint();

                }

            }



            @Override

            public void mouseReleased(MouseEvent e) {

                draggingCamera = false;

                draggingObject = false;

            }

        });



        addMouseMotionListener(new MouseMotionAdapter() {

            @Override

            public void mouseDragged(MouseEvent e) {

                if (draggingCamera) {

                    camX -= (e.getX() - lastMouseX) / zoom;

                    camY += (e.getY() - lastMouseY) / zoom;

                    lastMouseX = e.getX();

                    lastMouseY = e.getY();

                    repaint();

                } else if (draggingObject && selected != null) {

                    selected.x += (e.getX() - lastMouseX) / zoom;

                    selected.y -= (e.getY() - lastMouseY) / zoom;

                    lastMouseX = e.getX();

                    lastMouseY = e.getY();

                    repaint();

                }

            }

        });



        addMouseWheelListener(e -> {

            if (e.getWheelRotation() < 0) zoom *= 1.13;

            else zoom /= 1.13;

            if (zoom < Double.MIN_NORMAL) zoom = Double.MIN_NORMAL;

            if (Double.isInfinite(zoom) || Double.isNaN(zoom)) zoom = 1.0;

            repaint();

        });



        addKeyListener(new KeyAdapter() {

            @Override

            public void keyPressed(KeyEvent e) {

                switch (e.getKeyCode()) {

                    case KeyEvent.VK_1 -> forceMode = ForceMode.NEWTON;

                    case KeyEvent.VK_2 -> forceMode = ForceMode.STOCHASTIC;

                    case KeyEvent.VK_3 -> forceMode = ForceMode.MIXED;

                    case KeyEvent.VK_B -> bindingEnabled = !bindingEnabled;

                    case KeyEvent.VK_T -> autoReplication = !autoReplication;

                    case KeyEvent.VK_C -> {

                        if (selected != null) replicate(selected);

                    }

                    case KeyEvent.VK_H -> axisX = (axisX + 1) % axisNames.length;

                    case KeyEvent.VK_V -> axisY = (axisY + 1) % axisNames.length;

                    case KeyEvent.VK_R -> initUnits(units.size());

                }

                repaint();

            }

        });

    }



    private Unit findNearest(int sx, int sy) {

        Unit best = null;

        double bestD = 16;

        for (Unit u : units) {

            int px = worldToScreenX(u.get(axisNames[axisX]));

            int py = worldToScreenY(u.get(axisNames[axisY]));

            double d = Math.hypot(sx - px, sy - py);

            if (d < bestD) {

                bestD = d;

                best = u;

            }

        }

        return best;

    }



    // ===================== ZEICHNEN =====================

    @Override

    protected void paintComponent(Graphics g) {

        super.paintComponent(g);

        Graphics2D g2 = (Graphics2D) g;

        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);



        g2.setColor(new Color(25, 55, 25));

        g2.drawLine(0, worldToScreenY(0), getWidth(), worldToScreenY(0));

        g2.drawLine(worldToScreenX(0), 0, worldToScreenX(0), getHeight());



        if (bindingEnabled) {

            g2.setStroke(new BasicStroke(1.0f));

            g2.setColor(new Color(180, 180, 255, 80));

            for (Unit u : units) {

                for (Unit other : u.bonds) {

                    if (System.identityHashCode(u) < System.identityHashCode(other)) {

                        int x1 = worldToScreenX(u.get(axisNames[axisX]));

                        int y1 = worldToScreenY(u.get(axisNames[axisY]));

                        int x2 = worldToScreenX(other.get(axisNames[axisX]));

                        int y2 = worldToScreenY(other.get(axisNames[axisY]));

                        g2.drawLine(x1, y1, x2, y2);

                    }

                }

            }

        }



        for (Unit u : units) {

            int sx = worldToScreenX(u.get(axisNames[axisX]));

            int sy = worldToScreenY(u.get(axisNames[axisY]));

            g2.setColor(u.color);

            g2.fillOval(sx - u.radius, sy - u.radius, u.radius * 2, u.radius * 2);



            if (u == selected) {

                g2.setColor(Color.YELLOW);

                g2.setStroke(new BasicStroke(2f));

                g2.drawOval(sx - u.radius - 3, sy - u.radius - 3,

                        (u.radius + 3) * 2, (u.radius + 3) * 2);

            }

        }



        // HUD

        g2.setColor(Color.WHITE);

        g2.setFont(new Font("Monospaced", Font.PLAIN, 13));

        int y = 20;



        g2.drawString(String.format(Locale.US,

                "Mode: %s  Binding: %s  AutoRep: %s  Units: %d  Bonds: %d",

                forceMode, bindingEnabled ? "ON" : "OFF", autoReplication ? "ON" : "OFF",

                units.size(), activeBonds), 14, y); y += 17;



        g2.drawString(String.format(Locale.US,

                "AvgEnergy: %.2f  AvgBonds: %.2f  Isolated: %d  Rep: %d  Death: %d",

                avgEnergy, avgBonds, isolatedCount, replicationCount, deathCount), 14, y); y += 17;



        g2.drawString(String.format(Locale.US,

                "Types  A:%d  U:%d  G:%d  C:%d", countA, countU, countG, countC), 14, y); y += 17;



        g2.drawString(String.format(Locale.US,

                "E_kin: %.1f  E_pot: %.1f  Steps: %d", totalKinetic, totalPotential, stepCount), 14, y); y += 20;



        g2.setColor(Color.LIGHT_GRAY);

        g2.drawString("1/2/3=Mode  B=Binding  T=AutoRep  C=Replicate  H/V=Achsen  R=Reset  Mausrad=Zoom", 14, getHeight() - 14);



        if (selected != null) {

            g2.setColor(Color.CYAN);

            g2.drawString(String.format(Locale.US,

                    "Selected  Type:%s  mass=%.2f  energy=%.2f  bonds=%d",

                    selected.type, selected.mass, selected.energy, selected.bonds.size()), 14, y);

        }

        

        g2.drawString(String.format(Locale.US,

                "Aktive Achsen -> [H]: %s  |  [V]: %s",

                axisNames[axisX].toUpperCase(), axisNames[axisY].toUpperCase()), 14, y); y += 17;

    }



    private int worldToScreenX(double wx) {

        return (int) (getWidth() / 2.0 + (wx - camX) * zoom);

    }



    private int worldToScreenY(double wy) {

        return (int) (getHeight() / 2.0 - (wy - camY) * zoom);

    }



    // =====================================================================

    //          COLLECTIVE GAME INTERFACE

    // =====================================================================



    @Override public int getUnitCount() { return units.size(); }

    @Override public int getBondCount() { return activeBonds; }

    @Override public double getAverageEnergy() { return avgEnergy; }

    @Override public double getAverageBonds() { return avgBonds; }

    @Override public int getIsolatedCount() { return isolatedCount; }

    @Override public int getReplicationCount() { return replicationCount; }

    @Override public int getDeathCount() { return deathCount; }

    @Override public int getStepCount() { return stepCount; }

    @Override public String getForceMode() { return forceMode.name(); }

    @Override public boolean isBindingEnabled() { return bindingEnabled; }

    @Override public boolean isAutoReplicationEnabled() { return autoReplication; }



    @Override

    public String getStatusReport() {

        return String.format(Locale.US,

                "[Step %d] Units:%d Bonds:%d AvgE:%.2f AvgBonds:%.2f Isolated:%d Rep:%d Death:%d | A:%d U:%d G:%d C:%d | Mode:%s Binding:%s AutoRep:%s",

                stepCount, units.size(), activeBonds, avgEnergy, avgBonds,

                isolatedCount, replicationCount, deathCount,

                countA, countU, countG, countC,

                forceMode, bindingEnabled ? "ON" : "OFF", autoReplication ? "ON" : "OFF");

    }



    @Override

    public List<Map<String, Object>> getUnitSnapshot(int maxUnits) {

        List<Map<String, Object>> snapshot = new ArrayList<>();

        int limit = Math.min(maxUnits, units.size());

        for (int i = 0; i < limit; i++) {

            Unit u = units.get(i);

            Map<String, Object> data = new java.util.LinkedHashMap<>();

            data.put("id", i);

            data.put("type", u.type.name());

            data.put("x", u.x);

            data.put("y", u.y);

            data.put("z", u.z);

            data.put("mass", u.mass);

            data.put("energy", u.energy);

            data.put("bonds", u.bonds.size());

            snapshot.add(data);

        }

        return snapshot;

    }



    @Override

    public void setForceMode(String mode) {

        try {

            forceMode = ForceMode.valueOf(mode.toUpperCase());

        } catch (IllegalArgumentException e) {

            System.out.println("Unbekannter ForceMode: " + mode);

        }

    }



    @Override public void setBindingEnabled(boolean enabled) { bindingEnabled = enabled; }

    @Override public void setAutoReplication(boolean enabled) { autoReplication = enabled; }



    @Override

    public void reset() {

        initUnits(units.isEmpty() ? DEFAULT_UNIT_COUNT : units.size());

    }



    @Override

    public void triggerManualReplication() {

        if (selected != null) replicate(selected);

    }



    // ===================== MAIN =====================

    public static void main(String[] args) {

        SwingUtilities.invokeLater(() -> {

            JFrame frame = new JFrame("MatrixGame – A/U/G/C + Energy + Bond + Replication + Death");

            frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

            frame.add(new MainGame());

            frame.pack();

            frame.setLocationRelativeTo(null);

            frame.setVisible(true);

        });

    }

