import java.awt.Color;

import java.util.ArrayList;

import java.util.List;



public class Unit {



    public enum Type { A, U, G, C }



    public double x, y, z, d4;          // Für hinzufügen von weiterer Raumdimension mit Pytagoras und Interagierbarkeit wie zu erwarten in 4D mit Pytagoras und 4 Variablen für Positionierung der Unit

    public double vx, vy, vz, vd4;

    public double ax, ay, az, ad4;

    public double mass;

    public int radius;

    public Color color;

    

    public String typ;

    public String algorithmus;

    

    public double maxLeben;

    public double leben;

    public double damage;

    public double moveSpeed;

    public double reichweite;

    public double geschicklichkeit;

    



    public List<Unit> bonds = new ArrayList<>();

    public Type type = Type.A;



    public double energy = 1.0;



    public static final double MAX_ENERGY = 3.0;

    public static final double MIN_ENERGY_FOR_BOND = 0.25;

    public static final double MIN_ENERGY_FOR_REPLICATION = 1.6;



    public double get(String name) {

        return switch (name) {

            case "x"      -> x;

            case "y"      -> y;

            case "z"      -> z;

            case "d4"     -> d4;

            case "vx"     -> vx;

            case "vy"     -> vy;

            case "vz"     -> vz;

            case "vd4"    -> vd4;

            case "mass"   -> mass;

            case "energy" -> energy;

            default       -> 0.0;

        };

    }



    /** Komplementäre Basenpaarung (vereinfacht) */

    public boolean isComplementaryTo(Unit other) {

        return (this.type == Type.A && other.type == Type.U) ||

               (this.type == Type.U && other.type == Type.A) ||

               (this.type == Type.G && other.type == Type.C) ||

               (this.type == Type.C && other.type == Type.G);

    }



    public static Color colorForType(Type t) {

        return switch (t) {

            case A -> new Color(255, 80, 80);    // Rot

            case U -> new Color(80, 180, 255);   // Blau

            case G -> new Color(80, 220, 120);   // Grün

            case C -> new Color(255, 200, 60);   // Gelb

        };

    }

} Wo findet die Replikation der Units eigendlich genau statt?

Die Replikation der Units findet an zentralen Stellen im Quellcode von MainGame.java statt:

Automatische Replikation (tryAutoReplication()): Im gameLoop() wird bei aktiviertem autoReplication-Modus periodisch geprüft, ob eine Unit ausreichend Energie (MIN_ENERGY_FOR_REPLICATION) besitzt und die Zufallswahrscheinlichkeit (REPLICATION_CHANCE) erfüllt ist. Trifft dies zu, wird die Methode replicate(parent) aufgerufen.

Manuelle Replikation (VK_C / triggerManualReplication()): Über das Drücken der Taste C oder den Interface-Aufruf triggerManualReplication() kann die aktuell selektierte Unit (selected) manuell repliziert werden.

Die Kern-Methode (replicate(Unit parent)): Diese Methode steuert den eigentlichen Kopiervorgang:

Es wird überprüft, ob das Elternteil die Replikationskosten (REPLICATION_COST) tragen kann.

Die Energie wird abgezogen und der Zähler replicationCount erhöht.

Ein neues Unit-Objekt (child) wird instanziiert, wobei Position, Geschwindigkeit und Masse mit leichten Variationen vom Elternteil übernommen werden.

Der type wird vererbt, wobei über die MUTATION_CHANCE die Möglichkeit besteht, dass das Kind zu einem anderen Typ mutiert.

Das neue Kind wird der globalen Liste units hinzugefügt (units.add(child)).

Möchtest du die Replikationsregeln oder die Vererbung und Mutation der Typen (A/U/G/C) gezielt anpassen?

Replikations-Parameter anpassen: Energie-Schwellenwerte, Kosten oder Mutationsraten verändern.

Typen-Dynamik erweitern: Die Interaktion und Paarung der 4 Typen optimieren.

Weitere Module betrachten: Ein anderes Simulations- oder Informatikthema im Matrixgame vertiefen.

