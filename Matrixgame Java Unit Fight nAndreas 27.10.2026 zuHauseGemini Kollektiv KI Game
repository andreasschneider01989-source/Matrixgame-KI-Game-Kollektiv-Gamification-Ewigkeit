private void gameLoop() {

// 1. KI-Entscheidungen & Interaktionen

for (Unit u : units) {

if (u.leben > 0) {

u.decideAndAct(units);

}

}



// 2. Physik / Integration

for (Unit u : units) {

u.x += u.vx;

u.y += u.vy;

u.z += u.vz;

u.d4 += u.vd4;


// Reibung

u.vx *= 0.95;

u.vy *= 0.95;

u.vz *= 0.95;

u.vd4 *= 0.95;


// Energie-Regeneration

u.energy = Math.min(3.0, u.energy + 0.001);

}



// 3. Cleanup & Replikation (Thread-Sicher durch Iterator)

Iterator<Unit> it = units.iterator();

List<Unit> toAdd = new ArrayList<>();


while (it.hasNext()) {

Unit u = it.next();

if (u.leben <= 0) {

deathCount++;

