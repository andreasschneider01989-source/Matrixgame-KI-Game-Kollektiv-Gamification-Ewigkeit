public class Unit {

public enum Type { A, U, G, C }



// 4D Koordinaten & Geschwindigkeiten

public double x, y, z, d4;

public double vx, vy, vz, vd4;


// Basis-Attribute

public int id;

public int team;

public Type type;

public Color color;

public double mass = 1.0;

public int radius = 6;


// Zustand

public double maxLeben = 100.0;

public double leben = 100.0;

public double energy = 1.0;

public double damage = 15.0;

public double moveSpeed = 0.4;

public double reichweite = 1.2;


// Egoismus & KI-Parameter

public double machtScore = 1.0;

public double angstLevel = 0.0;

public double gierLevel = 0.8;


// Beziehungen (NIEMALS NULL initialisieren!)

public Map<Integer, Double> trustMap = new HashMap<>();

public List<Unit> bonds = new ArrayList<>();

public Unit target = null;



public Unit(int id, Type type, int team) {

this.id = id;

this.type = type;

this.team = team;

this.color = colorForType(type);

this.x = (Math.random() - 0.5) * 10.0;

this.y = (Math.random() - 0.5) * 10.0;

this.z = (Math.random() - 0.5) * 10.0;

this.d4 = (Math.random() - 0.5) * 10.0;

}



public double calculatePower() {

this.machtScore = (this.leben / Math.max(1.0, this.maxLeben)) * this.energy * this.mass;

return this.machtScore;

}



public double getDistance(Unit other) {

if (other == null) return Double.MAX_VALUE;

double dx = other.x - this.x;

double dy = other.y - this.y;

double dz = other.z - this.z;

double dd4 = other.d4 - this.d4;

return Math.sqrt(dx * dx + dy * dy + dz * dz + dd4 * dd4);

}



// --- DIE EGOISTISCHE ENTSCHEIDUNGSMASCHINE ---

public void decideAndAct(List<Unit> allUnits) {

calculatePower();

this.angstLevel = Math.max(0.0, (1.0 - (this.leben / Math.max(1.0, this.maxLeben))));


Unit bestPartner = null;

Unit targetEnemy = null;

double maxUtility = -999;


for (Unit other : allUnits) {

if (other == this || other.leben <= 0) continue;

double dist = getDistance(other);

if (dist > 5.0) continue; // Sichtfeld / Wahrnehmungsradius


double trust = trustMap.getOrDefault(other.id, 0.0);


// 1. Partner-Suche (Symbiose für Win-Win)

if (trust > 0.2 && isComplementaryTo(other)) {

bestPartner = other;

}


// 2. Feind-Bewertung (Ressourcenraub)

double utility = evaluateActionUtility(other);

if (other.team != this.team && utility > maxUtility) {

maxUtility = utility;

targetEnemy = other;

}

}


// --- AKTIONSAUSWAHL ---

if (this.angstLevel > 0.6 && targetEnemy != null && getDistance(targetEnemy) < 3.0) {

fleeFrom(targetEnemy); // Selbsterhaltung (Anti-Gravitation)

} else if (targetEnemy != null && maxUtility > 0.5) {

this.target = targetEnemy;

if (getDistance(targetEnemy) <= reichweite) {

attackieren(targetEnemy);

} else {

moveTo(targetEnemy);

}

} else if (bestPartner != null) {

cooperateWith(bestPartner);

} else {

// Zufälliges Umherschweifen (Entropie)

vx += (Math.random() - 0.5) * 0.05;

vy += (Math.random() - 0.5) * 0.05;

}

}



public double evaluateActionUtility(Unit other) {

if (other == null) return -999;

double meineMacht = calculatePower();

double gegnerMacht = other.calculatePower();

double beuteGewinn = other.energy * gierLevel;

double risikoSchaden = (gegnerMacht / (meineMacht + 1e-5)) * 40.0;

return beuteGewinn - risikoSchaden; // Egoistischer Nutzen

}



public void fleeFrom(Unit enemy) {

double dist = getDistance(enemy) + 1e-5;

vx -= ((enemy.x - x) / dist) * moveSpeed * 0.05;

vy -= ((enemy.y - y) / dist) * moveSpeed * 0.05;

vz -= ((enemy.z - z) / dist) * moveSpeed * 0.05;

vd4 -= ((enemy.d4 - d4) / dist) * moveSpeed * 0.05;

}



public void cooperateWith(Unit partner) {

moveTo(partner);

if (getDistance(partner) < 1.5 && this.energy > 0.4) {

this.energy += 0.005; // Win-Win Entropiereduktion

this.mass += 0.001; // Wachstum

// Vertrauen aufbauen

this.trustMap.put(partner.id, Math.min(1.0, this.trustMap.getOrDefault(partner.id, 0.0) + 0.01));

partner.trustMap.put(this.id, Math.min(1.0, partner.trustMap.getOrDefault(this.id, 0.0) + 0.01));


// Bond bilden (Allianz)

if (!this.bonds.contains(partner) && this.bonds.size() < 3) {

this.bonds.add(partner);

partner.bonds.add(this);

}

}

}



public void attackieren(Unit ziel) {

System.out.println("Unit "+this.id+" Attackiert Unit "+ziel.id);

if (ziel == null || ziel.leben <= 0) return;

double schaden = this.damage * (0.8 + Math.random() * 0.4);

ziel.leben -= schaden;


// Ressourcenraub (Egoismus!)

if (ziel.energy > 0.2) {

double gestohleneEnergie = 0.08;

ziel.energy -= gestohleneEnergie;

this.energy += gestohleneEnergie;

}


trustMap.put(ziel.id, -1.0);

ziel.trustMap.put(this.id, -1.0);


// Bonds brechen bei Verrat/Angriff

this.bonds.remove(ziel);

ziel.bonds.remove(this);

}



public void moveTo(Unit ziel) {

if (ziel == null) return;

double dist = getDistance(ziel) + 1e-5;

vx += ((ziel.x - x) / dist) * moveSpeed * 0.02;

vy += ((ziel.y - y) / dist) * moveSpeed * 0.02;

vz += ((ziel.z - z) / dist) * moveSpeed * 0.02;

vd4 += ((ziel.d4 - d4) / dist) * moveSpeed * 0.02;

}



public boolean isComplementaryTo(Unit other) {

return (this.type == Type.A && other.type == Type.U) ||

(this.type == Type.U && other.type == Type.A) ||

(this.type == Type.G && other.type == Type.C) ||

(this.type == Type.C && other.type == Type.G);

}



public static Color colorForType(Type t) {

return switch (t) {

case A -> new Color(255, 80, 80);

case U -> new Color(80, 180, 255);

case G -> new Color(80, 220, 120);

case C -> new Color(255, 200, 60);

};

}


public double get(String name) {

return switch (name) {

case "x" -> x; case "y" -> y; case "z" -> z; case "d4" -> d4;

case "vx" -> vx; case "vy" -> vy; case "vz" -> vz; case "vd4" -> vd4;

case "mass" -> mass; case "energy" -> energy; case "leben" -> leben;

default -> 0.0;

};

}

}

Das ist ein hervorragender Diagnose-Schritt! Der Code läuft stabil, aber der Screenshot und dein Feedback zeigen das Kernproblem: Die Units befinden sich in einer Art „friedlicher Isolation“ im Raum – es gibt kaum Angriffe (Deaths: 0), und die Population explodiert unkontrolliert bis in Tausender-Bereiche (Units: 3655), weil die Replikationsrate viel zu hoch und die Reichweite/Aggression zu gering eingestellt ist. Dadurch driften sie nur ziellos umher, statt echte spieltheoretische Interaktionen zu starten.

Warum es keine Angriffe gibt:
Reichweite (reichweite = 1.2) ist zu klein: Bei 300 Einheiten im unendlichen 4D-Raum ist die Distanz zueinander meist größer als 1.2, weshalb sie sich gegenseitig kaum im Nahbereich erreichen können.

Der Nutzen-Schwellenwert (maxUtility > 0.5) blockiert: Die egoistische Formel ist zu streng, sodass Angriffe fast nie ausgelöst werden.

Keine Tode / Kein Druck: Da niemand stirbt (Deaths: 0), fehlt der evolutionäre Druck. Die Einheiten vermehren sich unaufhörlich.

