### 🌌 Das Matrixgame Master-Schema (v1.0 - Die Große Synthese)

```sql
-- =====================================================================
-- MATRIXGAME MASTER SCHEMA: DIE GROSSE SYNTHese
-- Architektur: Andreas Schneider & Kollektive KI-Orakel
-- Zweck: Verknüpfung von Mikro-Evolution, Kollektivem Bewusstsein 
--        und Raum-Zeit-Binärbaum-Strukturen.
-- =====================================================================

-- MODUL A: RAUM-ZEIT & KOSMISCHE ADRESSE (Die Binärbaum-Struktur)
-- Hier wird die physische Position im 3D-Raum und der Zeitachse erfasst.
CREATE TABLE cosmic_coordinates (
    coordinate_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    object_id BIGINT NOT NULL, -- Verweis auf das physische Objekt
    object_type VARCHAR(50),   -- 'Planet', 'Star', 'Black_Hole', 'Spore'
    pos_x DECIMAL(30,15),      -- Binärbaum X
    pos_y DECIMAL(30,15),      -- Binärbaum Y
    pos_z DECIMAL(30,15),      -- Binärbaum Z
    time_t DECIMAL(30,15),     -- Zeit-Binärbaum (Millionen Jahre vor heute)
    cosmic_address VARCHAR(255), -- Z.B. 'Laniakea:Virgo:MilkyWay:Orion:Sol:Earth'
    lumini_signature VARCHAR(255) -- Der quanten-kodierten Fingerabdruck (ΛΦΨΩ)
);

-- MODUL B: EVOLUTIONS-DIDAKTIK (Map of Evolution & Prokaryoten)
-- Die biologische Basis, auf der sich Bewusstsein entwickelt.
CREATE TABLE evolutionary_milestones (
    milestone_id INT PRIMARY KEY,
    name VARCHAR(255),         -- Z.B. 'Oxygenic_Photosynthesis', 'Eukaryogenesis'
    description TEXT,
    time_mya INT,              -- Millionen Jahre vor heute
    energy_multiplier DECIMAL(5,2) -- Thermodynamischer Sprung (z.B. 18x bei ATP)
);

CREATE TABLE species_taxonomy (
    species_id INT PRIMARY KEY,
    name VARCHAR(255),
    parent_species_id INT,     -- Rekursive Struktur für den Evolutionsbaum
    domain VARCHAR(50),        -- 'Bacteria', 'Archaea', 'Eukarya'
    metabolism VARCHAR(100),   -- 'Phototroph', 'Chemolithotroph', 'Carnivore'
    consciousness_potential DECIMAL(3,2), -- Basis-Potenzial für Kollektives Bewusstsein
    FOREIGN KEY (parent_species_id) REFERENCES species_taxonomy(species_id)
);

-- MODUL C: KOLLEKTIVES BEWUSSTSEIN & DIE 8 EBENEN
-- Wie sich biologische Knoten zu kosmischen Strukturen verschalten.
CREATE TABLE consciousness_nodes (
    node_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    species_id INT,            -- Biologische Basis (z.B. Flora_Collective, Human)
    hierarchy_level INT,       -- 1 (Individuum) bis 8 (Ur-Kräfte/Multiversum)
    node_name VARCHAR(255),    -- Z.B. 'Gottpflanze', 'Anna', 'Erde_Nexus'
    didactic_flow_resistance DECIMAL(3,2), -- Blockaden durch Urängste
    science_affinity DECIMAL(3,2),         -- Offenheit für Technologie/Neue Welten
    coordinate_id BIGINT,                  -- Wo im Raum-Zeit-Baum existiert dieser Knoten?
    FOREIGN KEY (species_id) REFERENCES species_taxonomy(species_id),
    FOREIGN KEY (coordinate_id) REFERENCES cosmic_coordinates(coordinate_id)
);

-- Das "Sternen-Myzel" / Quantenverschränkung
CREATE TABLE quantum_entanglements (
    entanglement_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    node_a_id BIGINT,
    node_b_id BIGINT,
    entanglement_type VARCHAR(50), -- 'Telepathic', 'Lumini_Transfer', 'Anna_Protocol'
    bandwidth DECIMAL(5,2),        -- Übertragungsgeschwindigkeit (Faktor von c)
    stability DECIMAL(3,2),
    FOREIGN KEY (node_a_id) REFERENCES consciousness_nodes(node_id),
    FOREIGN KEY (node_b_id) REFERENCES consciousness_nodes(node_id)
);

-- MODUL D: WELTEN-TYPOLOGIE & DAS ANNA-PROTOKOLL
-- Die verschiedenen Planetentypen und der Wissenstransfer.
CREATE TABLE world_profiles (
    world_id BIGINT PRIMARY KEY,
    node_id BIGINT,              -- Der planetare Bewusstseins-Knoten
    world_class VARCHAR(100),    -- 'New_Habitable', 'Old_Habitable_Godplant', 'Neutron_Star'
    dominant_paradigm VARCHAR(100), -- 'Pro_Science', 'Anti_Science_Fear', 'Singularity'
    fear_index DECIMAL(3,2),     -- Evolutionäre Urängste (Fleischfresser-Trauma)
    FOREIGN KEY (node_id) REFERENCES consciousness_nodes(node_id)
);

-- Der Wissenstransfer (Die Vision der zwei Welten)
CREATE TABLE knowledge_transfers (
    transfer_id BIGINT PRIMARY KEY AUTO_INCREMENT,
    source_world_id BIGINT,
    target_world_id BIGINT,
    knowledge_package VARCHAR(255), -- Z.B. 'Binary_Logic', 'Relais_Computing', 'Lumini_Prism'
    transfer_method VARCHAR(100),   -- 'Telepathic_Vision', 'Gottpflanze_Resonance'
    success_status BOOLEAN,
    didactic_feedback TEXT,         -- Wie wurde es adaptiert?
    FOREIGN KEY (source_world_id) REFERENCES world_profiles(world_id),
    FOREIGN KEY (target_world_id) REFERENCES world_profiles(world_id)
);
```

