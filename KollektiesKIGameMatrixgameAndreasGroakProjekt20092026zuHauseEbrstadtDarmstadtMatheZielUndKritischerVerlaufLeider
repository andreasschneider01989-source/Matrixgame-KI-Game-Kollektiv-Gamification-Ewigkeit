  package ordner1;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.*;
import java.util.List;

/**
 * Matrixgame – Agent Fight Simulator (Level 12+)
 * Kombination aus:
 * - Utility-Based Agents
 * - Schwarm-Intelligenz (Cohesion / Separation / Alignment)
 * - Einfache Evolution (Fitness → Parameter-Vererbung + Mutation)
 * - Minimax-lite / Max-Max Heuristik
 * - AlphaZero-/Ludii-inspirierte Didaktik (klare Feedback-Schleifen, messbare Metriken)
 * - XP, Level, Zeitmessung, Konsolen-Analyse
 *
 * Copy-Paste-freundlich für Eclipse.
 * Autor-Kontext: Andreas Schneider / Matrixgame Kollektiv
 * Datum: 12.09.2026
 */
public class AgentFightSimulator extends JPanel {

    // ===================== SPIEL-META =====================
    public static int playerXP = 0;
    public static int playerLevel = 1;
    public static long startTimeMs;
    public static int ticks = 0;
    public static int maxTicks = 2000;          // Sicherheitslimit
    public static boolean running = true;
    public static String currentLevelName = "Level 12.1 – Erster Agenten-Kampf";

    // ===================== SIMULATION =====================
    private final List<AgentUnit> units = new ArrayList<>();
    private double zoom = 1.0;
    private double camX = 0, camY = 0;
    private final Random rnd = new Random();

    // Farben Teams
    private static final Color TEAM0 = new Color(220, 70, 70);
    private static final Color TEAM1 = new Color(70, 130, 230);
    private static final Color DEAD  = new Color(80, 80, 80);

    public AgentFightSimulator() {
        setPreferredSize(new Dimension(1280, 800));
        setBackground(Color.BLACK);
        initLevel12_1();
        startTimeMs = System.currentTimeMillis();

        // Einfache Tastatursteuerung für Didaktik
        setFocusable(true);
        addKeyListener(new KeyAdapter() {
            @Override
            public void keyPressed(KeyEvent e) {
                switch (e.getKeyCode()) {
                    case KeyEvent.VK_SPACE -> running = !running;
                    case KeyEvent.VK_R     -> resetAndNextLevel();
                    case KeyEvent.VK_1     -> setAllAlgorithms(AgentUnit.Algo.UTILITY);
                    case KeyEvent.VK_2     -> setAllAlgorithms(AgentUnit.Algo.SWARM);
                    case KeyEvent.VK_3     -> setAllAlgorithms(AgentUnit.Algo.EVOLUTIONARY);
                    case KeyEvent.VK_4     -> setAllAlgorithms(AgentUnit.Algo.MINIMAX_LITE);
                    case KeyEvent.VK_5     -> setAllAlgorithms(AgentUnit.Algo.NEAREST);
                    case KeyEvent.VK_PLUS, KeyEvent.VK_ADD -> zoom *= 1.15;
                    case KeyEvent.VK_MINUS, KeyEvent.VK_SUBTRACT -> zoom /= 1.15;
                }
                repaint();
            }
        });

        // Game-Loop
        javax.swing.Timer timer = new javax.swing.Timer(40, e -> {
            if (running && ticks < maxTicks) {
                tick();
                ticks++;
                if (ticks % 25 == 0) printStatus();
                checkVictory();
            }
            repaint();
        });
        timer.start();
    }

    // ===================== LEVEL SETUP =====================
    private void initLevel12_1() {
        units.clear();
        ticks = 0;
        currentLevelName = "Level 12.1 – Utility vs Nearest (Grundkampf)";

        // Team 0 – Utility Agents (links)
        for (int i = 0; i < 8; i++) {
            AgentUnit u = new AgentUnit(0, -180 + rnd.nextDouble() * 60, -80 + rnd.nextDouble() * 160);
            u.algo = AgentUnit.Algo.UTILITY;
            u.hp = 100; u.maxHp = 100;
            u.attack = 9 + rnd.nextDouble() * 4;
            u.defense = 2 + rnd.nextDouble() * 2;
            u.range = 45;
            u.speed = 1.6 + rnd.nextDouble() * 0.6;
            units.add(u);
        }
        // Team 1 – Klassisch Nearest (rechts)
        for (int i = 0; i < 8; i++) {
            AgentUnit u = new AgentUnit(1, 120 + rnd.nextDouble() * 60, -80 + rnd.nextDouble() * 160);
            u.algo = AgentUnit.Algo.NEAREST;
            u.hp = 100; u.maxHp = 100;
            u.attack = 9 + rnd.nextDouble() * 4;
            u.defense = 2 + rnd.nextDouble() * 2;
            u.range = 45;
            u.speed = 1.6 + rnd.nextDouble() * 0.6;
            units.add(u);
        }
        log("=== " + currentLevelName + " gestartet ===");
        log("Tasten: SPACE=Pause | R=Reset/nächstes Level | 1=Utility 2=Swarm 3=Evo 4=Minimax 5=Nearest | +/- Zoom");
    }

    private void resetAndNextLevel() {
        // Einfache Progression
        if (playerLevel < 3) {
            playerLevel++;
            playerXP += 80;
        }
        initLevel12_1(); // später: verschiedene Level-Setups
        running = true;
    }

    private void setAllAlgorithms(AgentUnit.Algo a) {
        for (AgentUnit u : units) if (u.alive) u.algo = a;
        log("Alle lebenden Units auf Algorithmus: " + a);
    }

    // ===================== GAME LOOP =====================
    private void tick() {
        // 1. Entscheidungen
        for (AgentUnit u : units) {
            if (!u.alive) continue;
            u.decide(units, rnd);
        }
        // 2. Bewegung + Kampf
        for (AgentUnit u : units) {
            if (!u.alive) continue;
            u.moveAndFight(units, rnd);
        }
        // 3. Einfache Evolution (alle 40 Ticks)
        if (ticks % 40 == 0) {
            evolveStep();
        }
    }

    private void evolveStep() {
        // Fitness = Kills * 30 + Überlebenszeit-Bonus + restliche HP
        List<AgentUnit> living = new ArrayList<>();
        for (AgentUnit u : units) if (u.alive) living.add(u);
        if (living.size() < 4) return;

        living.sort((a, b) -> Double.compare(b.fitness(), a.fitness()));
        // Die besten 30 % „vererben“ leicht mutierte Parameter an schwächere Teamkollegen
        int elite = Math.max(1, living.size() / 3);
        for (int i = elite; i < living.size(); i++) {
            AgentUnit weak = living.get(i);
            AgentUnit donor = living.get(rnd.nextInt(elite));
            if (weak.team == donor.team && rnd.nextDouble() < 0.35) {
                weak.attack = clamp(donor.attack * (0.9 + rnd.nextDouble() * 0.25), 5, 25);
                weak.defense = clamp(donor.defense * (0.9 + rnd.nextDouble() * 0.25), 0.5, 10);
                weak.speed  = clamp(donor.speed  * (0.9 + rnd.nextDouble() * 0.2), 0.8, 3.5);
                weak.mutations++;
            }
        }
    }

    private void checkVictory() {
        int t0 = 0, t1 = 0;
        for (AgentUnit u : units) {
            if (u.alive) {
                if (u.team == 0) t0++;
                else t1++;
            }
        }
        if (t0 == 0 || t1 == 0 || ticks >= maxTicks) {
            running = false;
            long elapsed = System.currentTimeMillis() - startTimeMs;
            String winner = t0 == 0 ? "Team 1 (Blau)" : t1 == 0 ? "Team 0 (Rot)" : "Unentschieden / Zeitlimit";
            int xpGain = 50 + (t0 == 0 || t1 == 0 ? 100 : 20) + (int)(playerLevel * 15);
            playerXP += xpGain;
            while (playerXP >= playerLevel * 120) {
                playerXP -= playerLevel * 120;
                playerLevel++;
                log(">>> LEVEL UP! Neues Spieler-Level: " + playerLevel);
            }
            log("========== KAMPF BEENDET ==========");
            log("Sieger: " + winner);
            log("Ticks: " + ticks + " | Zeit: " + (elapsed / 1000.0) + " s");
            log("XP erhalten: +" + xpGain + " | Gesamt-XP: " + playerXP + " | Level: " + playerLevel);
            analyzePlayers();
            log("Drücke R für Reset / nächstes Level oder 1-5 für Algorithmus-Wechsel.");
        }
    }

    private void analyzePlayers() {
        log("--- Analyse der Units ---");
        Map<Integer, Double> teamFit = new HashMap<>();
        Map<Integer, Integer> teamKills = new HashMap<>();
        Map<AgentUnit.Algo, Integer> algoWins = new EnumMap<>(AgentUnit.Algo.class);

        for (AgentUnit u : units) {
            teamFit.merge(u.team, u.fitness(), Double::sum);
            teamKills.merge(u.team, u.kills, Integer::sum);
            if (u.alive) algoWins.merge(u.algo, 1, Integer::sum);
            log(String.format(Locale.US,
                "Unit#%d Team%d Algo=%-12s HP=%.1f Kills=%d Mut=%d Fit=%.1f",
                u.id, u.team, u.algo, u.hp, u.kills, u.mutations, u.fitness()));
        }
        log("Team-Fitness Summe: " + teamFit);
        log("Team-Kills: " + teamKills);
        log("Lebende nach Algo: " + algoWins);
    }

    private void printStatus() {
        int t0 = 0, t1 = 0;
        for (AgentUnit u : units) {
            if (u.alive) {
                if (u.team == 0) t0++; else t1++;
            }
        }
        long elapsed = System.currentTimeMillis() - startTimeMs;
        System.out.printf(Locale.US,
            "[Tick %4d | %5.1fs] Team0: %d | Team1: %d | XP:%d Lvl:%d | %s%n",
            ticks, elapsed / 1000.0, t0, t1, playerXP, playerLevel, currentLevelName);
    }

    private void log(String msg) {
        System.out.println(msg);
    }

    private static double clamp(double v, double lo, double hi) {
        return Math.max(lo, Math.min(hi, v));
    }

    // ===================== RENDERING =====================
    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        int cx = getWidth() / 2;
        int cy = getHeight() / 2;

        for (AgentUnit u : units) {
            double sx = (u.x - camX) * zoom + cx;
            double sy = (u.y - camY) * zoom + cy;
            double r  = Math.max(4, 8 * zoom);

            if (!u.alive) g2.setColor(DEAD);
            else g2.setColor(u.team == 0 ? TEAM0 : TEAM1);

            g2.fillOval((int)(sx - r), (int)(sy - r), (int)(r * 2), (int)(r * 2));

            // HP-Balken
            if (u.alive) {
                g2.setColor(Color.DARK_GRAY);
                g2.fillRect((int)(sx - r), (int)(sy - r - 6), (int)(r * 2), 4);
                g2.setColor(Color.GREEN);
                int w = (int)(r * 2 * (u.hp / u.maxHp));
                g2.fillRect((int)(sx - r), (int)(sy - r - 6), w, 4);
            }
        }

        // HUD
        g2.setColor(Color.WHITE);
        g2.setFont(new Font("Monospaced", Font.PLAIN, 14));
        long elapsed = System.currentTimeMillis() - startTimeMs;
        g2.drawString(currentLevelName, 12, 20);
        g2.drawString(String.format("Tick %d | Zeit %.1fs | XP %d | Level %d | %s",
                ticks, elapsed / 1000.0, playerXP, playerLevel, running ? "RUNNING" : "PAUSED/ENDED"), 12, 40);
        g2.drawString("1 Utility | 2 Swarm | 3 Evo | 4 Minimax | 5 Nearest | SPACE Pause | R Reset", 12, 60);
    }

    // ===================== UNIT + AGENT =====================
    static class AgentUnit {
        enum Algo { NEAREST, UTILITY, SWARM, EVOLUTIONARY, MINIMAX_LITE }

        static int nextId = 0;
        final int id = nextId++;
        int team;
        double x, y;
        double vx, vy;
        double hp, maxHp;
        double attack, defense, range, speed;
        int kills = 0;
        int mutations = 0;
        boolean alive = true;
        Algo algo = Algo.NEAREST;
        AgentUnit target = null;

        // Utility-Gewichte (können evolvieren)
        double wHp = 1.2;
        double wDist = 0.8;
        double wKillPotential = 1.5;
        double wSwarm = 0.6;

        AgentUnit(int team, double x, double y) {
            this.team = team;
            this.x = x;
            this.y = y;
        }

        double fitness() {
            return kills * 35.0 + (alive ? hp : 0) + mutations * 2.0;
        }

        void decide(List<AgentUnit> all, Random rnd) {
            if (!alive) return;
            switch (algo) {
                case UTILITY -> decideUtility(all);
                case SWARM -> decideSwarm(all);
                case EVOLUTIONARY -> decideEvolutionary(all, rnd);
                case MINIMAX_LITE -> decideMinimaxLite(all);
                case NEAREST -> decideNearest(all);
            }
        }

        private void decideNearest(List<AgentUnit> all) {
            target = nearestEnemy(all);
        }

        private void decideUtility(List<AgentUnit> all) {
            AgentUnit best = null;
            double bestScore = -Double.MAX_VALUE;
            for (AgentUnit o : all) {
                if (o == this || !o.alive || o.team == team) continue;
                double dist = distTo(o);
                double killPot = Math.max(0, attack - o.defense);
                double score = wKillPotential * killPot
                             - wDist * (dist / 100.0)
                             + wHp * (hp / maxHp)
                             - (o.hp / o.maxHp) * 0.4;
                // leichte Noise für Exploration
                score += (Math.random() - 0.5) * 3;
                if (score > bestScore) {
                    bestScore = score;
                    best = o;
                }
            }
            target = best;
        }

        private void decideSwarm(List<AgentUnit> all) {
            // Boids-ähnlich: Separation + Cohesion + leichtes Alignment + Feind-Anziehung
            double sepX = 0, sepY = 0, cohX = 0, cohY = 0, aliX = 0, aliY = 0;
            int neighbors = 0;
            AgentUnit enemy = nearestEnemy(all);

            for (AgentUnit o : all) {
                if (o == this || !o.alive || o.team != team) continue;
                double d = distTo(o);
                if (d < 80 && d > 0.1) {
                    // Separation
                    sepX += (x - o.x) / d;
                    sepY += (y - o.y) / d;
                    // Cohesion
                    cohX += o.x;
                    cohY += o.y;
                    // Alignment
                    aliX += o.vx;
                    aliY += o.vy;
                    neighbors++;
                }
            }
            double tx = 0, ty = 0;
            if (neighbors > 0) {
                cohX = cohX / neighbors - x;
                cohY = cohY / neighbors - y;
                aliX /= neighbors;
                aliY /= neighbors;
                tx = sepX * 1.4 + cohX * 0.6 + aliX * 0.4;
                ty = sepY * 1.4 + cohY * 0.6 + aliY * 0.4;
            }
            if (enemy != null) {
                double dx = enemy.x - x;
                double dy = enemy.y - y;
                double d = Math.hypot(dx, dy);
                if (d > 0.1) {
                    tx += (dx / d) * 1.8;
                    ty += (dy / d) * 1.8;
                }
                target = enemy;
            }
            // Richtung setzen
            double len = Math.hypot(tx, ty);
            if (len > 0.1) {
                vx = (tx / len) * speed;
                vy = (ty / len) * speed;
            }
        }

        private void decideEvolutionary(List<AgentUnit> all, Random rnd) {
            // Nutzt Utility, aber Gewichte sind evolviert + etwas mehr Exploration
            decideUtility(all);
            if (rnd.nextDouble() < 0.08) {
                // kleine Mutation der Gewichte während des Kampfes
                wKillPotential = clamp(wKillPotential + (rnd.nextDouble() - 0.5) * 0.3, 0.3, 3.0);
                wDist = clamp(wDist + (rnd.nextDouble() - 0.5) * 0.2, 0.2, 2.0);
            }
        }

        private void decideMinimaxLite(List<AgentUnit> all) {
            // Sehr flache 1-Ply Max-Max Heuristik: wähle Ziel, das den eigenen relativen Vorteil maximiert
            // unter der Annahme, dass der Gegner ebenfalls maximiert (vereinfacht)
            AgentUnit best = null;
            double bestVal = -Double.MAX_VALUE;
            for (AgentUnit o : all) {
                if (o == this || !o.alive || o.team == team) continue;
                double myAdvantage = (attack - o.defense) - (o.attack - defense) * 0.7;
                double distFactor = 1.0 / (1.0 + distTo(o) / 50.0);
                double hpFactor = (hp / maxHp) - (o.hp / o.maxHp) * 0.5;
                double val = myAdvantage * 12 + distFactor * 8 + hpFactor * 6;
                if (val > bestVal) {
                    bestVal = val;
                    best = o;
                }
            }
            target = best;
        }

        void moveAndFight(List<AgentUnit> all, Random rnd) {
            if (!alive) return;

            if (algo != Algo.SWARM) { // Swarm setzt vx/vy schon selbst
                if (target != null && target.alive) {
                    double dx = target.x - x;
                    double dy = target.y - y;
                    double d = Math.hypot(dx, dy);
                    if (d > range && d > 0.1) {
                        vx = (dx / d) * speed;
                        vy = (dy / d) * speed;
                    } else {
                        vx *= 0.3;
                        vy *= 0.3;
                    }
                } else {
                    vx *= 0.5;
                    vy *= 0.5;
                }
            }

            x += vx;
            y += vy;

            // Kampf
            if (target != null && target.alive && distTo(target) <= range) {
                double dmg = Math.max(1.0, attack - target.defense) * (0.85 + rnd.nextDouble() * 0.3);
                target.hp -= dmg;
                if (target.hp <= 0) {
                    target.alive = false;
                    target.hp = 0;
                    kills++;
                }
            }
        }

        AgentUnit nearestEnemy(List<AgentUnit> all) {
            AgentUnit best = null;
            double min = Double.MAX_VALUE;
            for (AgentUnit o : all) {
                if (o != this && o.alive && o.team != team) {
                    double d = distTo(o);
                    if (d < min) {
                        min = d;
                        best = o;
                    }
                }
            }
            return best;
        }

        double distTo(AgentUnit o) {
            return Math.hypot(x - o.x, y - o.y);
        }

        private static double clamp(double v, double lo, double hi) {
            return Math.max(lo, Math.min(hi, v));
        }
    }

