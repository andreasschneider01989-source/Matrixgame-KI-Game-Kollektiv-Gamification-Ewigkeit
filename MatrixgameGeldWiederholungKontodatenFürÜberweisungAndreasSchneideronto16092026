    static class Climate {
        double tC, rh, mammalBar;
        Climate(double tC, double rh, double mammalBar) {
            this.tC = tC; this.rh = rh; this.mammalBar = mammalBar;
        }
        Climate copy() { return new Climate(tC, rh, mammalBar); }
    }

    static class Indicators {
        int civilianHarmEvents, armedAttacks, verifiedAgreements, aidCorridors, exchanges;
        Indicators(int harm, int attacks, int agree, int aid, int exch) {
            this.civilianHarmEvents = harm;
            this.armedAttacks = attacks;
            this.verifiedAgreements = agree;
            this.aidCorridors = aid;
            this.exchanges = exch;
        }
        Indicators copy() {
            return new Indicators(civilianHarmEvents, armedAttacks,
                    verifiedAgreements, aidCorridors, exchanges);
        }
        double harmLoad() { return civilianHarmEvents + 0.5 * armedAttacks; }
        double cooperationLoad() { return verifiedAgreements + aidCorridors + exchanges; }
        double peaceBar() {
            double h = harmLoad();
            double c = cooperationLoad();
            double raw = 100.0 * (c + 1.0) / (c + 1.0 + h);
            if (raw < 0) return 0;
            if (raw > 100) return 100;
            return raw;
        }
    }

    static class Lumini {
        final String id, k, r, z, v, s, q, b;
        final double p;
        final Mark mark;
        Lumini(String id, String k, String r, String z, double p, String v, String s,
               String q, String b, Mark mark) {
            this.id = id; this.k = k; this.r = r; this.z = z; this.p = p;
            this.v = v; this.s = s; this.q = q; this.b = b; this.mark = mark;
        }
        boolean guardianOk() {
            if (p < 0.0 || p > 1.0) return false;
            if (p < 0.70 && SCIENCE.equals(s)) return false;
            if (mark == Mark.SPEC && SCIENCE.equals(s)) return false;
            if (mark == Mark.W && INTERPRET.equals(s)) return false;
            if (k == null || k.isEmpty() || v == null || v.isEmpty()) return false;
            if (q == null || q.isEmpty()) return false;
            return true;
