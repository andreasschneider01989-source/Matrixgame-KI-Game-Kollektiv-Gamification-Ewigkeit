        System.out.println();
        System.out.println("5) Total energy (conserved in continuous case):");
        System.out.println("   E = T + U");
        System.out.println("   T = sum_i  1/2 * m_i * |v_i|^2");
        System.out.println("   U = sum_{i<j}  -G * m_i * m_j / r_ij");
        System.out.println();
        System.out.println("6) Relative energy drift (quality metric):");
        System.out.println("   relDrift = |E(t) - E(0)| / |E(0)|");
        System.out.println("   (smaller is better for the discrete integrator + double)");
        System.out.println();
        System.out.println("Note: general 3-body problem has no elementary closed-form solution.");
        System.out.println("      Numerical integration + monitoring of invariants is the practical path.");
        System.out.println();
    }

    // ---------- Guardian ----------
    static class Guardian {
        static boolean rejectAnalyticClaim(String s) {
            String c = s.toLowerCase();
            return c.contains("closed-form solution of general 3-body")
                || c.contains("analytic solution of three-body problem")
                || c.contains("solved the three-body problem completely");
        }
        static boolean rejectRealCosmosClaim(String s) {
            String c = s.toLowerCase();
            return c.contains("controls real planets")
                || c.contains("alters real solar system")
                || c.contains("predicts real trisolaran fleet");
        }
        static boolean acceptModel(String s) {
            return !rejectAnalyticClaim(s) && !rejectRealCosmosClaim(s);
        }
    }

    // ---------- simple double-precision probe ----------
    static void doublePrecisionNotes() {
        System.out.println("--- Double precision notes (IEEE-754 binary64) ---");
        System.out.println("mantissa bits approx 52 + 1 implicit => ~15-16 decimal digits");
        System.out.println("Machine epsilon (double) ~ 2.22e-16");
