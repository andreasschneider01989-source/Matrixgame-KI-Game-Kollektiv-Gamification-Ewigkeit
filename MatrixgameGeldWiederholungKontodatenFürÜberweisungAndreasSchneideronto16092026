public class ThreeBodyNewtonQuest {

    public static final String SCIENCE   = "SCIENCE";
    public static final String MODEL     = "MODEL";
    public static final String GAME      = "GAME";
    public static final String INTERPRET = "INTERPRET";

    // ---------- physical / numerical constants (named doubles) ----------
    public static final double G              = 6.67430e-11;   // CODATA-ish
    public static final double R_MIN          = 1.0e3;         // softening length [m]
    public static final double DT             = 60.0;          // timestep [s]
    public static final int    TICKS          = 500;
    public static final double ENERGY_GUARD   = 1.0e-8;        // relative drift limit
    public static final double EPS            = 1.0e-30;       // avoid /0

    // ---------- body ----------
    static class Body {
        final String id;
        double m;
        double x, y, z;
        double vx, vy, vz;
        double ax, ay, az;

        Body(String id, double m, double x, double y, double z,
             double vx, double vy, double vz) {
            this.id = id;
            this.m = m;
            this.x = x; this.y = y; this.z = z;
            this.vx = vx; this.vy = vy; this.vz = vz;
        }

        double kinetic() {
            return 0.5 * m * (vx * vx + vy * vy + vz * vz);
        }

        boolean isFinite() {
            return Double.isFinite(x) && Double.isFinite(y) && Double.isFinite(z)
                && Double.isFinite(vx) && Double.isFinite(vy) && Double.isFinite(vz)
                && Double.isFinite(m) && m > 0.0;
        }
    }

    // ---------- distance & potential helpers ----------
    static double dist(Body a, Body b) {
        double dx = b.x - a.x;
        double dy = b.y - a.y;
        double dz = b.z - a.z;
        return Math.sqrt(dx * dx + dy * dy + dz * dz);
    }

    /** Softened pairwise potential U = -G m1 m2 / r_soft */
    static double pairPotential(Body a, Body b) {
        double r = Math.max(dist(a, b), R_MIN);
        return -G * a.m * b.m / r;
    }

    static double totalPotential(Body[] bodies) {
        double u = 0.0;
        for (int i = 0; i < bodies.length; i++) {
            for (int j = i + 1; j < bodies.length; j++) {
                u += pairPotential(bodies[i], bodies[j]);
            }
        }
        return u;
    }

    static double totalKinetic(Body[] bodies) {
        double t = 0.0;
        for (Body b : bodies) t += b.kinetic();
        return t;
    }

    static double totalEnergy(Body[] bodies) {
        return totalKinetic(bodies) + totalPotential(bodies);
    }

    // ---------- acceleration from Newtonian gravity ----------
    static void computeAccelerations(Body[] bodies) {
        for (Body b : bodies) {
            b.ax = 0.0; b.ay = 0.0; b.az = 0.0;
        }
        for (int i = 0; i < bodies.length; i++) {
            for (int j = i + 1; j < bodies.length; j++) {
                Body a = bodies[i];
                Body b = bodies[j];
                double dx = b.x - a.x;
                double dy = b.y - a.y;
                double dz = b.z - a.z;
                double r2 = dx * dx + dy * dy + dz * dz;
                double r  = Math.sqrt(r2);
                double rc = Math.max(r, R_MIN);
                // F = G m1 m2 / rc^2 , direction unit vector
                // a_on_a = + (G m_b / rc^3) * r_vec
                // a_on_b = - (G m_a / rc^3) * r_vec
                double invR3 = 1.0 / (rc * rc * rc);
                double factorA = G * b.m * invR3;
                double factorB = G * a.m * invR3;
                a.ax += factorA * dx;
                a.ay += factorA * dy;
                a.az += factorA * dz;
                b.ax -= factorB * dx;
                b.ay -= factorB * dy;
                b.az -= factorB * dz;
            }
        }
    }

    // ---------- velocity Verlet step ----------
    static void verletStep(Body[] bodies, double dt) {
        // half-kick
        for (Body b : bodies) {
            b.vx += 0.5 * b.ax * dt;
            b.vy += 0.5 * b.ay * dt;
            b.vz += 0.5 * b.az * dt;
        }
        // drift
        for (Body b : bodies) {
            b.x += b.vx * dt;
            b.y += b.vy * dt;
            b.z += b.vz * dt;
        }
        // new accelerations
        computeAccelerations(bodies);
        // half-kick
        for (Body b : bodies) {
            b.vx += 0.5 * b.ax * dt;
            b.vy += 0.5 * b.ay * dt;
            b.vz += 0.5 * b.az * dt;
        }
    }

    // ---------- equation forms (console "text tasks") ----------
    static void printEquationForms() {
        System.out.println("--- Key equation forms (Newton + gravity) ---");
        System.out.println("1) Newton's 2nd law:");
        System.out.println("   F = m * a          =>  a = F / m");
        System.out.println();
        System.out.println("2) Newtonian gravity (pairwise):");
