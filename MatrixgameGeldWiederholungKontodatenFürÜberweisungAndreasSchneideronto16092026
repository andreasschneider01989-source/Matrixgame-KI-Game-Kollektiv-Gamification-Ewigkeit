    /** GAME quality vector - not a scientific ranking. */
    static class QVector {
        final double R, V, F, O, T, N, E, A, P;
        QVector(double R, double V, double F, double O, double T,
                double N, double E, double A, double P) {
            this.R = R; this.V = V; this.F = F; this.O = O; this.T = T;
