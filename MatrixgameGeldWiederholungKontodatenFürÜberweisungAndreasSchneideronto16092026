    static class Body {
        final String id;
        double m, x, y, z, vx, vy, vz, ax, ay, az;
        Body(String id, double m, double x, double y, double z,
             double vx, double vy, double vz) {
            this.id = id; this.m = m;
            this.x = x; this.y = y; this.z = z;
            this.vx = vx; this.vy = vy; this.vz = vz;
        }
        double kinetic() { return 0.5 * m * (vx * vx + vy * vy + vz * vz); }
        Body copy() {
            Body c = new Body(id, m, x, y, z, vx, vy, vz);
            c.ax = ax; c.ay = ay; c.az = az;
            return c;
        }
