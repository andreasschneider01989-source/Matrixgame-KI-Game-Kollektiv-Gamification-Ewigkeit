                clamp01(T), clamp01(N), clamp01(E), clamp01(A), clamp01(P));
    }

    static double clamp01(double x) {
        if (x < 0) return 0;
        if (x > 1) return 1;
        return x;
    }

    /** a dominates b if all >= and at least one > */
    static boolean dominates(QVector a, QVector b) {
        double[] xa = a.arr(), xb = b.arr();
