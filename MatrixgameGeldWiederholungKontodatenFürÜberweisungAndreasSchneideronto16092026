    static Op parseOp(String k) {
        if (k == null) return Op.UNKNOWN;
        String u = k.toUpperCase();
        if (u.contains("ACTION=ATTRACT")) return Op.ATTRACT;
        if (u.contains("ACTION=COOL")) return Op.COOL;
        if (u.contains("ACTION=AID")) return Op.AID;
        if (u.contains("ACTION=COUNT")) return Op.COUNT;
        return Op.UNKNOWN;
    }

    static String parseObject(String k) {
        if (k == null) return "";
        int i = k.indexOf("OBJECT=");
        if (i < 0) return "";
        String rest = k.substring(i + 7);
        int semi = rest.indexOf(';');
        return semi < 0 ? rest : rest.substring(0, semi);
    }

    static Action compile(Lumini L) {
        return new Action(L.id, parseOp(L.k), parseObject(L.k));
    }

    static double dist(Body a, Body b) {
        double dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z;
        return Math.sqrt(dx * dx + dy * dy + dz * dz);
    }

    static double pairU(Body a, Body b) {
        double r = Math.max(dist(a, b), R_MIN);
        return -G * a.m * b.m / r;
    }

    static void accel(Body a, Body b) {
        double dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z;
        double r = Math.sqrt(dx * dx + dy * dy + dz * dz);
        double rc = Math.max(r, R_MIN);
        double f = G * b.m / (rc * rc * rc);
        a.ax += f * dx; a.ay += f * dy; a.az += f * dz;
    }

    static void clearAcc(Body a) { a.ax = a.ay = a.az = 0; }

    static void verletPair(Body a, Body b, double dt) {
        a.vx += 0.5 * a.ax * dt; a.vy += 0.5 * a.ay * dt; a.vz += 0.5 * a.az * dt;
        b.vx += 0.5 * b.ax * dt; b.vy += 0.5 * b.ay * dt; b.vz += 0.5 * b.az * dt;
        a.x += a.vx * dt; a.y += a.vy * dt; a.z += a.vz * dt;
        b.x += b.vx * dt; b.y += b.vy * dt; b.z += b.vz * dt;
        clearAcc(a); clearAcc(b);
        accel(a, b); accel(b, a);
        a.vx += 0.5 * a.ax * dt; a.vy += 0.5 * a.ay * dt; a.vz += 0.5 * a.az * dt;
        b.vx += 0.5 * b.ax * dt; b.vy += 0.5 * b.ay * dt; b.vz += 0.5 * b.az * dt;
    }

    static double energy(Body a, Body b) {
        return a.kinetic() + b.kinetic() + pairU(a, b);
    }

    static double wetBulb(double tC, double rhFrac) {
        double rh = rhFrac * 100.0;
        return tC * Math.atan(0.151977 * Math.pow(rh + 8.313659, 0.5))
             + Math.atan(tC + rh) - Math.atan(rh - 1.676331)
             + 0.00391838 * Math.pow(rh, 1.5) * Math.atan(0.023101 * rh)
             - 4.686035;
    }

    static void apply(Action a, Climate c, Indicators p) {
