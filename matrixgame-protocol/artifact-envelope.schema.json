{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/andreasschneider01989-source/Matrixgame-KI-Game-Kollektiv-Gamification-Ewigkeit/main/matrixgame-protocol/artifact-envelope.schema.json",
  "title": "Matrixgame Artifact Envelope 0.1.0",
  "description": "Shared metadata contract for connecting specialized Matrixgame artifacts without replacing their domain-specific schemas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "artifact_type",
    "title",
    "version",
    "summary",
    "created_at",
    "updated_at",
    "epistemic_status",
    "implementation_status",
    "evidence_level",
    "privacy_class",
    "provenance",
    "relationships",
    "validation"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "artifact_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._/-]{1,127}$",
      "description": "Stable identifier; do not use a person's name or private identifier."
    },
    "artifact_type": { "$ref": "#/$defs/artifactType" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "summary": { "type": "string", "maxLength": 2000 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "epistemic_status": {
      "type": ["string", "null"],
      "enum": ["FACT", "MODEL", "HYPOTHESIS", "OPEN", "FICTION", null],
      "description": "Kind of knowledge claim; null when the artifact is not itself a claim."
    },
    "implementation_status": {
      "type": "string",
      "enum": ["PLANNED", "PROTOTYPE", "IMPLEMENTED", "TESTED", "VERIFIED", "NOT_APPLICABLE"]
    },
    "evidence_level": {
      "type": "string",
      "enum": ["E0_UNASSESSED", "E1_SOURCE_LINKED", "E2_CORROBORATED", "E3_REPRODUCED", "E4_REVIEWED_OR_FORMALIZED", "NOT_APPLICABLE"]
    },
    "privacy_class": {
      "type": "string",
      "enum": ["PUBLIC", "INTERNAL", "PRIVATE", "SENSITIVE"],
      "description": "Default to the least-disclosing classification that still permits the intended use."
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "validation": { "$ref": "#/$defs/validation" },
    "payload_ref": {
      "description": "Optional pointer to the domain-specific payload. The payload remains governed by its own schema.",
      "$ref": "#/$defs/payloadRef"
    }
  },
  "$defs": {
    "artifactType": {
      "type": "string",
      "enum": [
        "knowledge_node",
        "evidence_record",
        "equation",
        "experiment",
        "dataset",
        "simulation",
        "source",
        "quest",
        "decision",
        "software_module",
        "lumini_model_ir",
        "world_snapshot",
        "simulation_event",
        "run_manifest"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_by", "source_refs"],
      "properties": {
        "created_by": { "type": "string", "minLength": 1, "maxLength": 120 },
        "source_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "transformation_note": { "type": "string", "maxLength": 2000 }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "uri", "kind"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "uri": { "type": "string", "minLength": 1, "format": "uri-reference" },
        "kind": {
          "type": "string",
          "enum": ["repository_file", "web_resource", "dataset", "conversation", "other"]
        },
        "accessed_at": { "type": "string", "format": "date-time" },
        "license_note": { "type": "string", "maxLength": 500 }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target_id"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "REQUIRES",
            "DERIVES_FROM",
            "SUPPORTS",
            "CHALLENGES",
            "CONTRADICTS",
            "MODELS",
            "TESTS",
            "IMPLEMENTS",
            "TEACHES",
            "RELATED_TO",
            "SUPERSEDES"
          ]
        },
        "target_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "rationale": { "type": "string", "maxLength": 1000 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": { "type": "string", "enum": ["NOT_RUN", "PARTIAL", "PASS", "FAIL"] },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/validationCheck" }
        }
      }
    },
    "validationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status"],
      "properties": {
        "check_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "enum": ["NOT_RUN", "PASS", "FAIL", "SKIPPED"] },
        "details": { "type": "string", "maxLength": 2000 },
        "environment": { "type": "string", "maxLength": 500 },
        "executed_at": { "type": "string", "format": "date-time" },
        "evidence_ref": { "type": "string", "format": "uri-reference" }
      }
    },
    "payloadRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": {
        "uri": { "type": "string", "minLength": 1, "format": "uri-reference" },
        "schema_ref": { "type": "string", "minLength": 1, "format": "uri-reference" }
      }
    }
  }
}