  package ordner1;
import java.util.ArrayList;
import java.util.List;
import java.util.Random;

public class BattlefieldPredictorEngine {

    // Hilfsklasse zur Demonstration der Struktur
    public static class Unit {
        public double id;
        public int team;
        public String typ;
        public String decisionAlgorithm;
        public double posX, posY, posZ;
        public double posXBefore, posYBefore, posZBefore;
        public double leben, maxLeben;
        public double damage;
        public double attackSpeed;
        public double moveSpeed;
        public double kritchance;
        public double maxSpeed;
        public double reichweite;
        public double geschicklichkeit;
        public double currentDefense;
        public int red, green, blue;
        public double size = 10;

        // Klon-Konstruktor für die Zukunftssimulation (Deep Copy)
        public Unit cloneUnit() {
            Unit copy = new Unit();
            copy.id = this.id;
            copy.team = this.team;
            copy.typ = this.typ;
            copy.decisionAlgorithm = this.decisionAlgorithm;
            copy.posX = this.posX; copy.posY = this.posY; copy.posZ = this.posZ;
            copy.posXBefore = this.posXBefore; copy.posYBefore = this.posYBefore; copy.posZBefore = this.posZBefore;
            copy.leben = this.leben; copy.maxLeben = this.maxLeben;
            copy.damage = this.damage; copy.attackSpeed = this.attackSpeed;
            copy.moveSpeed = this.moveSpeed; copy.kritchance = this.kritchance;
            copy.maxSpeed = this.maxSpeed; copy.reichweite = this.reichweite;
            copy.geschicklichkeit = this.geschicklichkeit; copy.currentDefense = this.currentDefense;
            copy.red = this.red; copy.green = this.green; copy.blue = this.blue;
            copy.size = this.size;
            return copy;
        }

        public void printWerte() {
            // Debug-Ausgabe
        }
    }

    public List<Unit> unitList = new ArrayList<>();

    // Korrigierte Init-Methode mit echtem Seed-Verhalten
    public void initSimulation() {
        unitList.clear();
        Random rand = new Random(12345); // Fester Seed = Immer gleiches Match garantiert!

        double counterId = 0;

        // --- TEAM 1 (Blau) ---
        for (int j = 0; j < 50; j++) {
            for (int i = 0; i < 20; i++) {
                Unit u1 = new Unit();
                u1.typ = "Unit";
                u1.geschicklichkeit = 100;
                u1.maxSpeed = 100;
                u1.moveSpeed = 100;
                u1.decisionAlgorithm = "Player";
                u1.team = 1;
                
                u1.posX = -rand.nextDouble() * 40;
                u1.posY =  rand.nextDouble() * 40;
                u1.posZ =  rand.nextDouble() * 40;
                u1.posXBefore = u1.posX;
                u1.posYBefore = u1.posY;
                u1.posZBefore = u1.posZ;
                
                // Kontrollierte Werte statt ungesicherter Division durch 0
                u1.maxLeben = 1.0 + rand.nextDouble() * 4.0;
                u1.leben = u1.maxLeben;
                u1.damage = 1.0 + rand.nextDouble() * 4.0;
                u1.attackSpeed = 1.0 + rand.nextDouble() * 4.0;
                u1.moveSpeed = 1.0 + rand.nextDouble() * 7.0;
                u1.kritchance = 0.2;
                u1.maxSpeed = 1.0 + rand.nextDouble() * 14.0;
                u1.reichweite = 1.0 + rand.nextDouble() * 23.0;
                u1.geschicklichkeit = 1.0 + rand.nextDouble() * 7.0;
                u1.currentDefense = 1.0 + rand.nextDouble() * 4.0;
                
                u1.decisionAlgorithm = "Wait";
                u1.red = 0; u1.green = 0; u1.blue = 255;
                u1.id = counterId++;
                unitList.add(u1);
            }
        }

        // --- TEAM 2 (Rot) ---
        for (int i = 0; i < 1000; i++) {
            Unit u2 = new Unit();
            u2.team = 2;
            u2.decisionAlgorithm = "BotUpdate";
            u2.typ = "Unit";
            if (i == 0) { u2.typ = "King"; u2.size += 5; }
            
            u2.posX = rand.nextDouble() * 40;
            u2.posY = rand.nextDouble() * 40;
            u2.posZ = rand.nextDouble() * 40;
            u2.posXBefore = u2.posX;
            u2.posYBefore = u2.posY;
            u2.posZBefore = u2.posZ;
            
            u2.maxLeben = 1.0 + rand.nextDouble() * 4.0;
            u2.leben = u2.maxLeben;
            u2.damage = 1.0 + rand.nextDouble() * 4.0;
            u2.attackSpeed = 1.0 + rand.nextDouble() * 4.0;
            u2.moveSpeed = 1.0 + rand.nextDouble() * 4.0;
            u2.kritchance = 0.2;
            u2.currentDefense = 1.0 + rand.nextDouble() * 4.0;
            u2.geschicklichkeit = 1.0 + rand.nextDouble() * 4.0;
            u2.maxSpeed = 1.0 + rand.nextDouble() * 4.0;
            u2.reichweite = 1.0 + rand.nextDouble() * 4.0;
            
            u2.decisionAlgorithm = "WAIT";
            u2.red = 255; u2.green = 0; u2.blue = 0;
            u2.id = counterId++;
            unitList.add(u2);
        }
    }

    // Zukunfts-Prognose-Engine: Simuliert X Ticks im Voraus
    public List<Unit> simulateFuture(int targetTicks) {
        // 1. Zustand klonen, damit das echte Spiel nicht verändert wird
        List<Unit> simulatedList = new ArrayList<>();
        for (Unit u : unitList) {
            simulatedList.add(u.cloneUnit());
        }

        // 2. Schnelldurchlauf der Physik- und Kampf-Ticks
        for (int t = 0; t < targetTicks; t++) {
            for (Unit u : simulatedList) {
                if (u.leben <= 0) continue;
                
                // Beispielhafter Vektor-Schritt basierend auf moveSpeed und Position
                // Hier greift die Logik der Bewegung und Kollisionsprüfung im Voraus
                u.posXBefore = u.posX;
                u.posYBefore = u.posY;
                u.posZBefore = u.posZ;
                
                // Einfache Dummy-Bewegung zur Simulation
                if (u.team == 1) {
                    u.posX += 0.1; // Team 1 drückt vor
                } else {
                    u.posX -= 0.1; // Team 2 drückt vor
                }
            }
        }
        
        return simulatedList; // Liefert den Zustand nach Ticks zurück
    }

    public void repaint() {
        // Grafisches Update
    }
}


