        controlPanel.setLayout(new FlowLayout(FlowLayout.CENTER, 20, 10));

        JSlider serSlider = createModulatorSlider("Serotonin (Fluss / Widerstand)", 10, 300, 100, val -> globalSerotonin = val / 100.0);
        JSlider dopSlider = createModulatorSlider("Dopamin (Plastizität / Mitose)", 10, 300, 100, val -> globalDopamine = val / 100.0);
        JSlider purSlider = createModulatorSlider("Ritalin-Purity (Stoffwechsel-Reinheit)", 50, 400, 100, val -> globalPurity = val / 100.0);

        controlPanel.add(serSlider);
        controlPanel.add(dopSlider);
        controlPanel.add(purSlider);

        frame.add(controlPanel, BorderLayout.SOUTH);

        frame.setLocationRelativeTo(null);
        frame.setVisible(true);
    }

    private static JSlider createModulatorSlider(String title, int min, int max, int init, java.util.function.Consumer<Integer> action) {
        JSlider slider = new JSlider(min, max, init);
        slider.setBackground(new Color(20, 20, 25));
        slider.setForeground(Color.WHITE);
        slider.setPaintTicks(true);
        slider.setMajorTickSpacing(100);
        
        TitledBorder border = BorderFactory.createTitledBorder(BorderFactory.createLineBorder(Color.CYAN), title);
        border.setTitleColor(Color.WHITE);
        slider.setBorder(border);

        slider.addChangeListener(e -> action.accept(slider.getValue()));
        return slider;
    }
