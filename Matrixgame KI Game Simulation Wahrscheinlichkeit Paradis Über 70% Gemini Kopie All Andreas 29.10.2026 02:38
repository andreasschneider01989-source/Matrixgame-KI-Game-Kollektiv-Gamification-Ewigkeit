import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.List;
import java.util.concurrent.CopyOnWriteArrayList;
import java.util.Random;

public class DynamicNeuronSimulation extends JPanel implements ActionListener, MouseListener, MouseMotionListener, MouseWheelListener {

    public static class BioPort {
        int directionIndex;
        boolean active = false;
        double lastSignal = 0.0;

        public BioPort(int index) {
            this.directionIndex = index;
        }
    }

    public static class BioNeuron {
        int id;
        double x, y, z;
        int type; // 1 = anregend, -1 = hemmend
        double potential = 0.0;
        double threshold = 1.0;
        double energy = 2.0; // Startenergie für Mitose
        
        BioPort[] ports = new BioPort[6];
        
        public BioNeuron(int id, double x, double y, double z, int type) {
            this.id = id;
            this.x = x; this.y = y; this.z = z;
            this.type = type;
            for(int i = 0; i < 6; i++) {
                ports[i] = new BioPort(i);
            }
        }

        public void computeInternalState(double externalInput) {
            double sum = externalInput;
            for(BioPort p : ports) {
                if(p.active) sum += p.lastSignal;
            }
            this.potential += sum;
            if(this.potential >= this.threshold) {
                this.potential = 0.0;
                this.energy += 0.5; // Erfolg belohnt die Zelle mit Energie
            }
            // Lebend-Metabolismus: Energie verbraucht sich langsam
            this.energy = Math.max(0.1, this.energy - 0.002);
        }

        public boolean canDivide() {
            return this.energy >= 5.0; // Schwelle für Mitose
        }
    }

    public static class BioSynapse {
        BioNeuron source;
        BioNeuron target;
        double weight;
        double pulseProgress = -1.0;

        public BioSynapse(BioNeuron source, BioNeuron target, double weight) {
            this.source = source;
            this.target = target;
            this.weight = weight;
        }
    }

    // --- Engine State ---
    private List<BioNeuron> neurons = new CopyOnWriteArrayList<>();
    private List<BioSynapse> synapses = new CopyOnWriteArrayList<>();
    private BioNeuron selectedNeuron = null;
    private int nextId = 100;

    private Timer animTimer;
    private double angleX = 0.3;
    private double angleY = 0.0;
    private double zoom = 1.0;
    private int panX = 0, panY = 0;
    private int mousePrevX, mousePrevY;
    private boolean isDraggingNeuron = false;

    private final double FOCAL_LENGTH = 600.0;
    private final double Z_OFFSET = 350.0;

    public DynamicNeuronSimulation() {
        setBackground(new Color(10, 12, 18));

        // Start-Knoten erzeugen
        Random rand = new Random();
        for (int i = 0; i < 10; i++) {
            double rx = (rand.nextDouble() - 0.5) * 180;
            double ry = (rand.nextDouble() - 0.5) * 180;
            double rz = (rand.nextDouble() - 0.5) * 180;
            int type = (rand.nextDouble() > 0.3) ? 1 : -1;
            neurons.add(new BioNeuron(i, rx, ry, rz, type));
        }

        addMouseListener(this);
        addMouseMotionListener(this);
        addMouseWheelListener(this);

        animTimer = new Timer(16, this);
        animTimer.start();
    }

    @Override
    public void actionPerformed(ActionEvent e) {
        angleY += 0.002; // Sanfte Rotation

        // 1. Signal-Propagation & Pulse
        for (BioSynapse s : synapses) {
            if (s.pulseProgress >= 0) {
                s.pulseProgress += 0.07;
                if (s.pulseProgress >= 1.0) {
                    s.pulseProgress = -1.0;
                    s.target.computeInternalState(s.weight);
                }
            } else if (Math.random() < 0.04) {
                s.pulseProgress = 0.0;
            }
        }

        // 2. Zellteilung (Mitose) prüfen
        List<BioNeuron> newBorns = new CopyOnWriteArrayList<>();
        for (BioNeuron n : neurons) {
            n.computeInternalState(0.0);
            if (n.canDivide() && neurons.size() < 40) { // Limit zum Schutz der Performance
                n.energy = 2.5; // Energie aufteilen
                BioNeuron child = new BioNeuron(nextId++, n.x + (Math.random() - 0.5) * 40, 
                                                                 n.y + (Math.random() - 0.5) * 40, 
                                                                 n.z + (Math.random() - 0.5) * 40, n.type);
                newBorns.add(child);
                synapses.add(new BioSynapse(n, child, 1.0)); // Direkte synaptische Verbindung zur Mutterzelle
            }
        }
        neurons.addAll(newBorns);

        repaint();
    }

    private Point project3D(double x, double y, double z) {
        double radX = angleX, radY = angleY;
        double x1 = x * Math.cos(radY) - z * Math.sin(radY);
        double z1 = x * Math.sin(radY) + z * Math.cos(radY);
        double y1 = y;

        double y2 = y1 * Math.cos(radX) - z1 * Math.sin(radX);
        double z2 = y1 * Math.sin(radX) + z1 * Math.cos(radX);
        double x2 = x1;

        double scale = (FOCAL_LENGTH / (FOCAL_LENGTH + z2 + Z_OFFSET)) * zoom;
        int screenX = (int) ((getWidth() / 2 + panX) + x2 * scale);
        int screenY = (int) ((getHeight() / 2 + panY) + y2 * scale);
        return new Point(screenX, screenY);
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2d = (Graphics2D) g;
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        // UI Header
        g2d.setColor(Color.WHITE);
        g2d.setFont(new Font("Monospaced", Font.BOLD, 14));
        g2d.drawString("Matrixgame :: Evolutionäre 3D-Zellkolonie & Mitose", 20, 30);
        g2d.drawString("Steuerung: Linksklick = Auswählen/Verschieben (Unit-Control) | Rechtsklick-Drag = Kamera Pan", 20, 50);
        g2d.drawString("Gesamt-Zellen: " + neurons.size() + " | Aktive Synapsen: " + synapses.size(), 20, 70);

        // Synapsen zeichnen
        for (BioSynapse s : synapses) {
            Point p1 = project3D(s.source.x, s.source.y, s.source.z);
            Point p2 = project3D(s.target.x, s.target.y, s.target.z);

            g2d.setColor(s.weight > 0 ? new Color(0, 150, 255, 120) : new Color(220, 50, 50, 120));
            g2d.setStroke(new BasicStroke(1.5f));
            g2d.drawLine(p1.x, p1.y, p2.x, p2.y);

            if (s.pulseProgress >= 0) {
                int px = (int) (p1.x + (p2.x - p1.x) * s.pulseProgress);
                int py = (int) (p1.y + (p2.y - p1.y) * s.pulseProgress);
                g2d.setColor(Color.WHITE);
                g2d.fillOval(px - 3, py - 3, 6, 6);
            }
        }

        // Neuronen zeichnen
        for (BioNeuron n : neurons) {
            Point p = project3D(n.x, n.y, n.z);
            int radius = (int) (14 * zoom);
            if(radius < 4) radius = 4;

            if (n == selectedNeuron) {
                g2d.setColor(Color.YELLOW);
                g2d.drawOval(p.x - radius - 6, p.y - radius - 6, (radius * 2) + 12, (radius * 2) + 12);
            }

            g2d.setColor(n.type > 0 ? new Color(0, 130, 240) : new Color(220, 50, 50));
            g2d.fillOval(p.x - radius, p.y - radius, radius * 2, radius * 2);
            g2d.setColor(Color.WHITE);
            g2d.drawOval(p.x - radius, p.y - radius, radius * 2, radius * 2);

            g2d.setFont(new Font("Monospaced", Font.PLAIN, 10));
            g2d.drawString("ID:" + n.id, p.x + radius + 4, p.y);
        }

        // HUD
        if (selectedNeuron != null) {
            drawHUD(g2d, getWidth(), getHeight());
        }
    }

    private void drawHUD(Graphics2D g2d, int width, int height) {
        int w = 300, h = 190;
        int x = width - w - 20, y = 20;

        g2d.setColor(new Color(0, 0, 0, 230));
        g2d.fillRoundRect(x, y, w, h, 15, 15);
        g2d.setColor(Color.CYAN);
        g2d.drawRoundRect(x, y, w, h, 15, 15);

        g2d.setColor(Color.WHITE);
        g2d.setFont(new Font("Monospaced", Font.BOLD, 13));
        g2d.drawString("--- EINHEITEN-DIAGNOSE ---", x + 15, y + 25);

        g2d.setFont(new Font("Monospaced", Font.PLAIN, 11));
        g2d.drawString("Zell-ID: " + selectedNeuron.id, x + 15, y + 48);
        g2d.drawString("Typ: " + (selectedNeuron.type > 0 ? "Exzitatorisch (+)" : "Inhibitorisch (-)"), x + 15, y + 68);
        g2d.drawString(String.format("Energie (Mitose): %.1f / 5.0", selectedNeuron.energy), x + 15, y + 88);

        // Energie-Balken
        g2d.setColor(Color.DARK_GRAY);
        g2d.fillRect(x + 15, y + 98, 260, 8);
        g2d.setColor(Color.GREEN);
        int barW = (int) (260 * Math.min(1.0, selectedNeuron.energy / 5.0));
        g2d.fillRect(x + 15, y + 98, barW, 8);

        g2d.setColor(Color.WHITE);
        g2d.drawString("Status: " + (selectedNeuron.canDivide() ? "BEREIT ZUR MITOSE" : "Wächst & Sammelt Energie"), x + 15, y + 130);
        g2d.drawString("Tipp: Ziehe die Einheit mit der Maus im Raum!", x + 15, y + 155);
    }

    // --- Interaktive Steuerung (Unit-Control & Dragging) ---
    @Override
    public void mousePressed(MouseEvent e) {
