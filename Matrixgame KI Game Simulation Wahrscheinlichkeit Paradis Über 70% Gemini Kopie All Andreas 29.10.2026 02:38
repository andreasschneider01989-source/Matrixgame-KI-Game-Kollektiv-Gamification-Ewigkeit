import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.List;
import java.util.concurrent.CopyOnWriteArrayList;
import java.util.Random;

public class DynamicNeuronSimulation extends JPanel implements ActionListener, MouseListener, MouseMotionListener, MouseWheelListener {

    // --- 6 Entropie-Ports pro Neuron ---
    public static class BioPort {
        int directionIndex; // 0: N, 1: S, 2: E, 3: W, 4: UP, 5: DOWN
        boolean active = false;
        double lastSignal = 0.0;

        public BioPort(int index) {
            this.directionIndex = index;
        }
    }

    // --- Neuron mit 6 Ports und interner Berechnung ---
    public static class BioNeuron {
        int id;
        double x, y, z;          // 3D Raumkoordinaten
        int type;                // 1 = anregend (blau), -1 = hemmend (rot)
        double potential = 0.0;
        double threshold = 1.0;
        
        // Exakt 6 raum-bezogene Entropie-Verbindungen
        BioPort[] ports = new BioPort[6];
        
        public BioNeuron(int id, double x, double y, double z, int type) {
            this.id = id;
            this.x = x; this.y = y; this.z = z;
            this.type = type;
            for(int i = 0; i < 6; i++) {
                ports[i] = new BioPort(i);
            }
        }

        // Interne mathematische Operation (Summation der Eingänge gegen Schwellenwert)
        public void computeInternalState(double externalInput) {
            double sum = externalInput;
            for(BioPort p : ports) {
                if(p.active) {
                    sum += p.lastSignal;
                }
            }
            this.potential += sum;
            // Aktivierungsfunktion / Schwellenwertprüfung
            if(this.potential >= this.threshold) {
                this.potential = 0.0; // Reset nach Zündung
            }
        }
    }

    public static class BioSynapse {
        BioNeuron source;
        BioNeuron target;
        double weight;
        double pulseProgress = -1.0; // Neurotransmitter Animation [0.0 bis 1.0]

        public BioSynapse(BioNeuron source, BioNeuron target, double weight) {
            this.source = source;
            this.target = target;
            this.weight = weight;
        }
    }

    // --- Engine State ---
    private List<BioNeuron> neurons = new CopyOnWriteArrayList<>();
    private List<BioSynapse> synapses = new CopyOnWriteArrayList<>();
    private BioNeuron selectedNeuron = null;

    private Timer animTimer;
    private double angleX = 0.3;
    private double angleY = 0.0;
    private double zoom = 1.0;         // Zoom-Faktor für Infinity Canvas
    private int panX = 0, panY = 0;    // Kamera-Verschiebung
    private int mousePrevX, mousePrevY;

    private final double FOCAL_LENGTH = 600.0;
    private final double Z_OFFSET = 350.0;

    public DynamicNeuronSimulation() {
        setBackground(new Color(12, 14, 20));

        // 1. Neuronen erzeugen
        Random rand = new Random();
        for (int i = 0; i < 14; i++) {
            double rx = (rand.nextDouble() - 0.5) * 220;
            double ry = (rand.nextDouble() - 0.5) * 220;
            double rz = (rand.nextDouble() - 0.5) * 220;
            int type = (rand.nextDouble() > 0.25) ? 1 : -1;
            neurons.add(new BioNeuron(i, rx, ry, rz, type));
        }

        // 2. Initiale Synapsen aufbauen
        for (BioNeuron n1 : neurons) {
            for (BioNeuron n2 : neurons) {
                if (n1 != n2) {
                    double dist = Math.sqrt(Math.pow(n2.x - n1.x, 2) + Math.pow(n2.y - n1.y, 2) + Math.pow(n2.z - n1.z, 2));
                    if (dist < 130 && Math.random() > 0.4) {
                        synapses.add(new BioSynapse(n1, n2, (rand.nextDouble() * 0.8 + 0.2) * n1.type));
                    }
                }
            }
        }

        // Listener für Steuerung (Canvas-Navigation & Raycasting)
        addMouseListener(this);
        addMouseMotionListener(this);
        addMouseWheelListener(this);

        animTimer = new Timer(16, this);
        animTimer.start();
    }

    @Override
    public void actionPerformed(ActionEvent e) {
        angleY += 0.003; // Sanfte automatische Grundrotation

        // Neurotransmitter-Pulse entlang der Synapsen bewegen
        for (BioSynapse s : synapses) {
            if (s.pulseProgress >= 0) {
                s.pulseProgress += 0.08;
                if (s.pulseProgress >= 1.0) {
                    s.pulseProgress = -1.0;
                    s.target.computeInternalState(s.weight);
                }
            } else if (Math.random() < 0.03) {
                s.pulseProgress = 0.0; // Impuls starten
            }
        }

        repaint();
    }

    // --- 3D zu 2D Projektion mit Zoom und Pan ---
    private Point project3D(double x, double y, double z) {
        // Rotation um X und Y Achsen
        double radX = angleX, radY = angleY;
        
        // Y Rotation
        double x1 = x * Math.cos(radY) - z * Math.sin(radY);
        double z1 = x * Math.sin(radY) + z * Math.cos(radY);
        double y1 = y;

        // X Rotation
        double y2 = y1 * Math.cos(radX) - z1 * Math.sin(radX);
        double z2 = y1 * Math.sin(radX) + z1 * Math.cos(radX);
        double x2 = x1;

        double scale = (FOCAL_LENGTH / (FOCAL_LENGTH + z2 + Z_OFFSET)) * zoom;
        int screenX = (int) ((getWidth() / 2 + panX) + x2 * scale);
        int screenY = (int) ((getHeight() / 2 + panY) + y2 * scale);
        return new Point(screenX, screenY);
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2d = (Graphics2D) g;
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        // UI Header
        g2d.setColor(Color.WHITE);
        g2d.setFont(new Font("Monospaced", Font.BOLD, 14));
        g2d.drawString("Matrixgame :: Organische 3D-Zellkolonie & Entropie-Ports", 20, 30);
        g2d.drawString("Navigation: Drag = Drehen/Verschieben | Mausrad = Zoomen | Klick = Diagnose", 20, 50);

        // 1. Synapsen & Neurotransmitter zeichnen
        for (BioSynapse s : synapses) {
            Point p1 = project3D(s.source.x, s.source.y, s.source.z);
            Point p2 = project3D(s.target.x, s.target.y, s.target.z);

            float alpha = Math.min(1.0f, (float) Math.abs(s.weight));
            g2d.setColor(s.weight > 0 ? new SafeColor(0, 150, 255, (int)(alpha * 200)) : new SafeColor(220, 50, 50, (int)(alpha * 200)));
            g2d.setStroke(new BasicStroke((float) Math.abs(s.weight) * 1.5f));
            g2d.drawLine(p1.x, p1.y, p2.x, p2.y);

            // Neurotransmitter-Punkt
            if (s.pulseProgress >= 0) {
                int px = (int) (p1.x + (p2.x - p1.x) * s.pulseProgress);
                int py = (int) (p1.y + (p2.y - p1.y) * s.pulseProgress);
                g2d.setColor(Color.WHITE);
                g2d.fillOval(px - 3, py - 3, 6, 6);
            }
        }

        // 2. Neuronen und ihre 6 Entropie-Ports zeichnen
        for (BioNeuron n : neurons) {
            Point p = project3D(n.x, n.y, n.z);
            int radius = (int) (16 * zoom);
            if(radius < 4) radius = 4;

            // Highlight für selektiertes Neuron
            if (n == selectedNeuron) {
                g2d.setColor(Color.YELLOW);
                g2d.drawOval(p.x - radius - 6, p.y - radius - 6, (radius * 2) + 12, (radius * 2) + 12);
            }

            // Hauptkörper
            g2d.setColor(n.type > 0 ? new Color(0, 120, 220) : new Color(200, 40, 40));
            g2d.fillOval(p.x - radius, p.y - radius, radius * 2, radius * 2);
            g2d.setColor(Color.WHITE);
            g2d.drawOval(p.x - radius, p.y - radius, radius * 2, radius * 2);

            // 6 Entropie-Ports als kleine Punkte um die Zelle darstellen
            for (int i = 0; i < 6; i++) {
                double anglePort = i * (Math.PI / 3);
                int portX = p.x + (int) ((radius + 6) * Math.cos(anglePort));
                int portY = p.y + (int) ((radius + 6) * Math.sin(anglePort));
                g2d.setColor(n.ports[i].active ? Color.GREEN : Color.GRAY);
                g2d.fillOval(portX - 2, portY - 2, 5, 5);
            }

            g2d.setFont(new Font("Monospaced", Font.PLAIN, 10));
            g2d.drawString("ID:" + n.id, p.x + radius + 4, p.y);
        }

        // 3. HUD für das ausgewählte Neuron
        if (selectedNeuron != null) {
            drawHUD(g2d, getWidth(), getHeight());
        }
    }

    private void drawHUD(Graphics2D g2d, int width, int height) {
        int w = 300, h = 210;
        int x = width - w - 20, y = 20;

        g2d.setColor(new Color(0, 0, 0, 220));
        g2d.fillRoundRect(x, y, w, h, 15, 15);
        g2d.setColor(Color.CYAN);
        g2d.drawRoundRect(x, y, w, h, 15, 15);

        g2d.setColor(Color.WHITE);
        g2d.setFont(new Font("Monospaced", Font.BOLD, 13));
        g2d.drawString("--- NEURON INTRANET HUD ---", x + 15, y + 25);

        g2d.setFont(new Font("Monospaced", Font.PLAIN, 11));
        g2d.drawString("ID: " + selectedNeuron.id, x + 15, y + 48);
        g2d.drawString("Typ: " + (selectedNeuron.type > 0 ? "Exzitatorisch (+)" : "Inhibitorisch (-)"), x + 15, y + 68);
        g2d.drawString(String.format("Potenzial: %.2f / Thresh: %.1f", selectedNeuron.potential, selectedNeuron.threshold), x + 15, y + 88);

        // Potenzial-Balken
        g2d.setColor(Color.DARK_GRAY);
        g2d.fillRect(x + 15, y + 98, 260, 8);
        g2d.setColor(selectedNeuron.type > 0 ? Color.BLUE : Color.RED);
        int barW = (int) (260 * Math.min(1.0, selectedNeuron.potential / selectedNeuron.threshold));
        g2d.fillRect(x + 15, y + 98, barW, 8);

        g2d.setColor(Color.WHITE);
        g2d.drawString("6 Entropie-Ports Status:", x + 15, y + 125);
        for(int i = 0; i < 6; i++) {
            String status = selectedNeuron.ports[i].active ? "AKTIV (Sig: " + String.format("%.2f", selectedNeuron.ports[i].lastSignal) + ")" : "Bereit / Offen";
            g2d.drawString("  Port " + i + ": " + status, x + 15, y + 142 + (i * 10));
        }
    }

    // Hilfsklasse für sichere Alpha-Farben
    private static class SafeColor extends Color {
        public SafeColor(int r, int g, int b, int a) {
            super(Math.max(0, Math.min(255, r)), Math.max(0, Math.min(255, g)), Math.max(0, Math.min(255, b)), Math.max(0, Math.min(255, a)));
        }
    }

    // --- Maus-Interaktionen für Zoom, Pan und Raycasting ---
    @Override
    public void mousePressed(MouseEvent e) {
        mousePrevX = e.getX();
        mousePrevY = e.getY();

        // Raycasting / Klick-Erkennung für Neuronen-Auswahl
        if(e.getButton() == MouseEvent.BUTTON1) {
            BioNeuron clicked = null;
            for (BioNeuron n : neurons) {
                Point p = project3D(n.x, n.y, n.z);
                if (Math.hypot(p.x - e.getX(), p.y - e.getY()) < 18 * zoom) {
                    clicked = n;
                    break;
                }
            }
            selectedNeuron = clicked;
        }
    }

    @Override
    public void mouseDragged(MouseEvent e) {
        int dx = e.getX() - mousePrevX;
        int dy = e.getY() - mousePrevY;

        if (SwingUtilities.isRightMouseButton(e)) {
            // Pan / Verschieben
            panX += dx;
            panY += dy;
        } else {
            // Rotation um X und Y
            angleY += dx * 0.01;
            angleX -= dy * 0.01;
        }
        mousePrevX = e.getX();
        mousePrevY = e.getY();
    }

    @Override
    public void mouseWheelMoved(MouseWheelEvent e) {
        // Stufenloses Zoomen (Infinity Canvas Zoom)
        if (e.getWheelRotation() < 0) {
            zoom *= 1.1;
        } else {
            zoom /= 1.1;
        }
        zoom = Math.max(0.3, Math.min(5.0, zoom)); // Grenzen setzen
    }

    @Override public void mouseClicked(MouseEvent e) {}
    @Override public void mouseReleased(MouseEvent e) {}
    @Override public void mouseEntered(MouseEvent e) {}
    @Override public void mouseExited(MouseEvent e) {}
    @Override public void mouseMoved(MouseEvent e) {}

    public static void main(String[] args) {
        JFrame frame = new JFrame("Matrixgame :: Infinity Canvas 3D Neuronen");
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setSize(1100, 850);
        frame.add(new DynamicNeuronSimulation());
        frame.setLocationRelativeTo(null);
        frame.setVisible(true);
    }
