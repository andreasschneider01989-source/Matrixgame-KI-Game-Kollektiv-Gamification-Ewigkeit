        int barW = (int) (270 * Math.min(1.0, selectedNeuron.energy / 3.5));
        g2d.fillRect(x + 15, y + 98, barW, 8);

        g2d.setColor(Color.WHITE);
        g2d.drawString("Status: " + (selectedNeuron.canDivide() ? "TEILT SICH JETZT!" : "Sammelt Energie..."), x + 15, y + 125);
        g2d.drawString("Tipp: Ziehe die Zelle mit der Maus im Raum!", x + 15, y + 150);
