public final class MatrixgameSpaceEngine {
    
    public record Vector3D(double x, double y, double z) {
        public Vector3D add(Vector3D o) { return new Vector3D(x + o.x, y + o.y, z + o.z); }
        public Vector3D sub(Vector3D o) { return new Vector3D(x - o.x, y - o.y, z - o.z); }
        public Vector3D mult(double s) { return new Vector3D(x * s, y * s, z * s); }
        public double magnitude() { return Math.sqrt(x * x + y * y + z * z); }
    }
    
    public enum ShipClass {
        STRIKE_BATTLESHIP(1.2e8, 500000.0, 200000.0),
        STRIKE_CRUISER(7.0e7, 300000.0, 150000.0),
        HEAVY_CRUISER(5.5e7, 250000.0, 50000.0),
        SARN_SUICIDE_DESTROYER(2.5e7, 50000.0, 0.0),
        INSECTOID_CORE_NODE(5.0e9, 1000000.0, 500000.0);
        
        public final double baseMassKg;
        public final double maxShieldEnergyJ;
        public final double maxAblativeMassKg;
        
        ShipClass(double baseMassKg, double maxShieldEnergyJ, double maxAblativeMassKg) {
            this.baseMassKg = baseMassKg;
            this.maxShieldEnergyJ = maxShieldEnergyJ;
            this.maxAblativeMassKg = maxAblativeMassKg;
        }
    }
    
    public static class CombatUnit {
        private final String id;
        private final ShipClass shipClass;
        private Vector3D position;
        private Vector3D velocity;
        private double currentMassKg;
        private double shieldEnergyJ;
        private double ablativeMassKg;
        private boolean isDestroyed = false;
        
        public void takeDamage(double kineticEnergyJoules) {
            if (isDestroyed) return;
            double remainingDamage = kineticEnergyJoules;
            
            // 1. Schilde absorbieren
            if (shieldEnergyJ > 0) {
                if (shieldEnergyJ >= remainingDamage) {
                    shieldEnergyJ -= remainingDamage;
                    remainingDamage = 0;
                } else {
                    remainingDamage -= shieldEnergyJ;
                    shieldEnergyJ = 0;
                }
            }
            
            // 2. Ablative Panzerung
            if (remainingDamage > 0 && ablativeMassKg > 0) {
                double massEjectedKg = remainingDamage / 1.0e6;
                if (ablativeMassKg >= massEjectedKg) {
                    ablativeMassKg -= massEjectedKg;
                    currentMassKg -= massEjectedKg;
                    remainingDamage = 0;
                } else {
                    remainingDamage -= ablativeMassKg * 1.0e6;
                    currentMassKg -= ablativeMassKg;
                    ablativeMassKg = 0;
                }
            }
            
            // 3. Hüllenschaden
            if (remainingDamage > 0) {
                isDestroyed = true;
            }
        }
    }
}
