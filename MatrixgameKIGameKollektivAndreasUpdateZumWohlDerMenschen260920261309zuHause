public final class MatrixgameSpaceEngine {

    // --- MATHEMATISCHE VEKTOR-KLASSE (SI-EINHEITEN) ---
    public record Vector3D(double x, double y, double z) {
        public Vector3D add(Vector3D o) { return new Vector3D(x + o.x, y + o.y, z + o.z); }
        public Vector3D sub(Vector3D o) { return new Vector3D(x - o.x, y - o.y, z - o.z); }
        public Vector3D mult(double s) { return new Vector3D(x * s, y * s, z * s); }
        public double magnitude() { return Math.sqrt(x * x + y * y + z * z); }
        public Vector3D normalize() {
            double m = magnitude();
            return m == 0 ? new Vector3D(0, 0, 0) : new Vector3D(x / m, y / m, z / m);
        }
    }

    // --- FRAKTIONS- UND INTELLIGENZ-TYPEN ---
    public enum IntelligenceType {
        SKYWATCH_TACTICAL_AI,  // Stratagems, Schirmformationen, Ablativ-Nutzen
        SARN_KAMIKAZE_SWARM,   // Kollisionsvektor-Optimierung, Frequenzänderung
        INSECTOID_HIVE_MIND    // Schwarm-Regeneration, Flutungs-Taktik
    }

    // --- SCHIFFSKLASSEN MIT MASSENPROFILEN ---
    public enum ShipClass {
        STRIKE_BATTLESHIP(1.2e8, 500000.0, 200000.0), // Mass (kg), Shield Joules, Ablative Armor kg
        STRIKE_CRUISER(7.0e7, 300000.0, 150000.0),
        HEAVY_CRUISER(5.5e7, 250000.0, 50000.0),
        SARN_SUICIDE_DESTROYER(2.5e7, 50000.0, 0.0),
        INSECTOID_CORE_NODE(5.0e9, 1000000.0, 500000.0);

        public final double baseMassKg;
        public final double maxShieldEnergyJ;
        public final double maxAblativeMassKg;

        ShipClass(double baseMassKg, double maxShieldEnergyJ, double maxAblativeMassKg) {
            this.baseMassKg = baseMassKg;
            this.maxShieldEnergyJ = maxShieldEnergyJ;
            this.maxAblativeMassKg = maxAblativeMassKg;
        }
    }

    // --- COMBAT UNIT (MASSEPUNKT MIT KAMPF- UND PANZERUNGSSTATI) ---
    public static class CombatUnit {
        private final String id;
        private final ShipClass shipClass;
        private final IntelligenceType intelligence;
        private Vector3D position; // in Metern
        private Vector3D velocity; // in m/s
        private double currentMassKg;
        private double shieldEnergyJ;
        private double ablativeMassKg;
        private boolean isDestroyed = false;

        public CombatUnit(String id, ShipClass shipClass, IntelligenceType intelligence, Vector3D pos, Vector3D vel) {
            this.id = id;
            this.shipClass = shipClass;
            this.intelligence = intelligence;
            this.position = pos;
            this.velocity = vel;
            this.currentMassKg = shipClass.baseMassKg + shipClass.maxAblativeMassKg;
            this.shieldEnergyJ = shipClass.maxShieldEnergyJ;
            this.ablativeMassKg = shipClass.maxAblativeMassKg;
        }

        public void updatePhysics(double deltaSeconds) {
            if (isDestroyed) return;
            this.position = this.position.add(this.velocity.mult(deltaSeconds));
        }

        // Ablative Panzerungs- und Treffermechanik
        public void takeDamage(double kineticEnergyJoules) {
            if (isDestroyed) return;

            double remainingDamage = kineticEnergyJoules;

            // 1. Schilde absorbieren Energie
            if (shieldEnergyJ > 0) {
                if (shieldEnergyJ >= remainingDamage) {
                    shieldEnergyJ -= remainingDamage;
                    remainingDamage = 0;
                } else {
                    remainingDamage -= shieldEnergyJ;
                    shieldEnergyJ = 0;
                }
            }

            // 2. Ablative Panzerung trennt sich ab und nimmt kinetische Energie auf
            if (remainingDamage > 0 && ablativeMassKg > 0) {
                double massEjectedKg = remainingDamage / 1.0e6; // Energy/Sublimation Constant
                if (ablativeMassKg >= massEjectedKg) {
                    ablativeMassKg -= massEjectedKg;
                    currentMassKg -= massEjectedKg; // Masse verringert sich!
                    remainingDamage = 0;
                    System.out.printf("[%s] Ablativ-Panzerung abgesprengt: -%.2f kg. Hülle geschützt.%n", id, massEjectedKg);
                } else {
                    remainingDamage -= ablativeMassKg * 1.0e6;
                    currentMassKg -= ablativeMassKg;
                    ablativeMassKg = 0;
                }
            }

            // 3. Hüllenschaden
            if (remainingDamage > 0) {
                isDestroyed = true;
                System.out.printf("💥 [%s] Katastrophale Hüllen-Umlagerung! Einheitsauflösung.%n", id);
            }
        }

        public String exportToInfiniteCanvasJSON() {
            return String.format(Locale.US,
                "{\"id\":\"%s\",\"type\":\"%s\",\"pos\":[%.2f,%.2f,%.2f],\"destroyed\":%b,\"mass\":%.2f}",
                id, shipClass.name(), position.x(), position.y(), position.z(), isDestroyed, currentMassKg);
        }
    }

    // --- GEFECHTS-SIMULATION UND RECHNER ---
