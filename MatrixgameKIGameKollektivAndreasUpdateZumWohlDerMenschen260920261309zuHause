            printStatus();
            System.out.println("\nWas trainierst du heute?");
            System.out.println("1) Kleine Herausforderung angehen (Self-Efficacy + Agency)");
            System.out.println("2) Freundlich mit einem Fehler umgehen (Self-Compassion)");
            System.out.println("3) Etwas Neues lernen oder üben (Growth Mindset)");
            System.out.println("4) Drei Dinge notieren, für die du dankbar bist (Gratitude)");
            System.out.println("5) Eine Emotion bewusst regulieren (Emotional Regulation)");
            System.out.println("6) Status anzeigen und beenden");

            int choice = scanner.nextInt();
            processChoice(choice);

            // Kleiner zufälliger Alltagseinfluss (Realismus)
            applyDailyNoise();

            System.out.println("\nBalance-Score heute: " + String.format("%.2f", calculateBalanceScore()));
            System.out.println("(Je näher an 1.0 und je ausgewogener, desto besser)\n");
        }

        System.out.println("=== 7-Tage-Training beendet ===");
        printStatus();
        System.out.println("Endgültiger Balance-Score: " + String.format("%.2f", calculateBalanceScore()));
        System.out.println("Weiter so – kleine, wiederholte Handlungen compoundieren.");
    }

    static void processChoice(int choice) {
        switch (choice) {
            case 1:
                selfEfficacy = Math.min(1.0, selfEfficacy + 0.04 + random.nextDouble() * 0.03);
                agency = Math.min(1.0, agency + 0.03);
                System.out.println("→ Du bist eine kleine Herausforderung angegangen. Self-Efficacy und Agency steigen.");
                break;
            case 2:
                selfCompassion = Math.min(1.0, selfCompassion + 0.05);
                emotionalRegulation = Math.min(1.0, emotionalRegulation + 0.02);
                System.out.println("→ Du bist freundlich mit dir umgegangen. Self-Compassion und Regulation steigen.");
                break;
            case 3:
                growthMindset = Math.min(1.0, growthMindset + 0.04);
                selfEfficacy = Math.min(1.0, selfEfficacy + 0.02);
                System.out.println("→ Du hast gelernt oder geübt. Growth Mindset und Self-Efficacy steigen.");
                break;
            case 4:
                gratitude = Math.min(1.0, gratitude + 0.05);
                optimism = Math.min(1.0, optimism + 0.02);
                System.out.println("→ Du hast Dankbarkeit praktiziert. Gratitude und Optimism steigen.");
                break;
            case 5:
                emotionalRegulation = Math.min(1.0, emotionalRegulation + 0.05);
                resilience = Math.min(1.0, resilience + 0.03);
                System.out.println("→ Du hast eine Emotion bewusst reguliert. Regulation und Resilience steigen.");
                break;
            case 6:
                System.out.println("Training vorzeitig beendet.");
                System.exit(0);
            default:
                System.out.println("Ungültige Wahl – kein Trainingseffekt.");
        }
    }

    static void applyDailyNoise() {
        // Kleine realistische Schwankungen
        selfEfficacy += (random.nextDouble() - 0.5) * 0.02;
        optimism += (random.nextDouble() - 0.5) * 0.02;
        // Clamp auf [0,1]
        selfEfficacy = clamp(selfEfficacy);
        optimism = clamp(optimism);
        // ... (weitere können analog geclampt werden)
    }

    static double clamp(double v) {
        return Math.max(0.0, Math.min(1.0, v));
    }

    static double calculateBalanceScore() {
        // Einfacher Score: Durchschnitt minus Abweichungsstrafe
        double avg = (selfEfficacy + selfCompassion + growthMindset + agency +
                      optimism + emotionalRegulation + gratitude + resilience) / 8.0;

        double variance = 0.0;
        double[] vals = {selfEfficacy, selfCompassion, growthMindset, agency,
                         optimism, emotionalRegulation, gratitude, resilience};
        for (double v : vals) {
            variance += Math.pow(v - avg, 2);
        }
        variance /= 8.0;

        // Je höher der Durchschnitt und je geringer die Varianz, desto besser
        return avg * (1.0 - Math.min(0.4, variance * 2));
    }

    static void printStatus() {
        System.out.printf("Self-Efficacy:        %.2f%n", selfEfficacy);
        System.out.printf("Self-Compassion:      %.2f%n", selfCompassion);
        System.out.printf("Growth Mindset:       %.2f%n", growthMindset);
        System.out.printf("Agency:               %.2f%n", agency);
        System.out.printf("Optimism:             %.2f%n", optimism);
        System.out.printf("Emotional Regulation: %.2f%n", emotionalRegulation);
        System.out.printf("Gratitude:            %.2f%n", gratitude);
        System.out.printf("Resilience:           %.2f%n", resilience);
    }
}
```

