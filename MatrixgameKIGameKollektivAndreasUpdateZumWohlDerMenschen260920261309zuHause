import java.time.LocalDateTime;
import java.util.Locale;
import java.util.Random;

public class MatrixPeaceDecisionEngine {

    // ============================================================
    // MATRIXGAME: PEACE / DECISION / COLLECTIVE LEARNING ENGINE
    // Simulation only:
    // Die Werte sind Spielmetriken und keine Messungen der Realität.
    // ============================================================

    static class State {

        // Positive Spielindikatoren: 0..100
        double peace = 70.0;
        double trust = 60.0;
        double hope = 65.0;
        double love = 55.0;
        double happiness = 60.0;
        double enthusiasm = 70.0;
        double motivation = 65.0;
        double intuition = 50.0;
        double productivity = 60.0;

        // Belastungsindikatoren: 0..100
        double conflict = 25.0;
        double uncertainty = 30.0;
        double resistance = 20.0;

        // Meta-Werte
        double informationQuality = 70.0;
        double communication = 65.0;
        double cooperation = 65.0;

        double time = 0.0;
    }

    static class Action {

        String name;

        double peace;
        double trust;
        double hope;
        double love;
        double happiness;
        double enthusiasm;
        double motivation;
        double intuition;
        double productivity;

        double conflict;
        double uncertainty;
        double resistance;

        double informationQuality;
        double communication;
        double cooperation;

        Action(
                String name,
                double peace,
                double trust,
                double hope,
                double love,
                double happiness,
                double enthusiasm,
                double motivation,
                double intuition,
                double productivity,
                double conflict,
                double uncertainty,
                double resistance,
                double informationQuality,
                double communication,
                double cooperation
        ) {
            this.name = name;
            this.peace = peace;
            this.trust = trust;
            this.hope = hope;
            this.love = love;
            this.happiness = happiness;
            this.enthusiasm = enthusiasm;
            this.motivation = motivation;
            this.intuition = intuition;
            this.productivity = productivity;
            this.conflict = conflict;
            this.uncertainty = uncertainty;
            this.resistance = resistance;
            this.informationQuality = informationQuality;
            this.communication = communication;
            this.cooperation = cooperation;
        }
    }

    // ------------------------------------------------------------
    // Hilfsfunktionen
    // ------------------------------------------------------------

    static double clamp(double x) {
        return Math.max(0.0, Math.min(100.0, x));
    }

    static double positiveAverage(State s) {

        return (
                s.peace +
                s.trust +
                s.hope +
                s.love +
                s.happiness +
                s.enthusiasm +
                s.motivation +
                s.intuition +
                s.productivity +
                s.informationQuality +
                s.communication +
                s.cooperation
        ) / 12.0;
    }

    static double negativeAverage(State s) {

        return (
                s.conflict +
                s.uncertainty +
                s.resistance
        ) / 3.0;
    }

    // ------------------------------------------------------------
    // Zielentfernung
    // ------------------------------------------------------------

    static double goalDistance(State s) {

        double positive = positiveAverage(s);
        double negative = negativeAverage(s);

        // Höher = näher am gewünschten Spielziel
        double score =
                positive * 0.75
                - negative * 0.25;

        score = clamp(score);

        return 100.0 - score;
    }

    // ------------------------------------------------------------
    // Risikoindikator
    // ------------------------------------------------------------

    static double risk(State s) {

        double instability =
                s.conflict * 0.40 +
                s.uncertainty * 0.25 +
                s.resistance * 0.15;

        double protectiveFactors =
                s.trust * 0.10 +
                s.communication * 0.10;

        double result = instability - protectiveFactors;

        return clamp(result);
    }

    // ------------------------------------------------------------
    // Friedenskompatibilität
    // ------------------------------------------------------------

    static double peaceAlignment(State s) {

        double result =
                s.peace * 0.25 +
                s.trust * 0.15 +
                s.communication * 0.15 +
                s.cooperation * 0.15 +
                s.informationQuality * 0.10 +
                s.hope * 0.10 +
                s.happiness * 0.10
                -
                s.conflict * 0.20;

        return clamp(result);
    }

    // ------------------------------------------------------------
    // Aktion bewerten
    // ------------------------------------------------------------

    static double evaluateAction(State s, Action a) {

        State copy = copyState(s);
        apply(copy, a);

        double before = peaceAlignment(s);
        double after = peaceAlignment(copy);

        return after - before;
    }

    // ------------------------------------------------------------
    // Aktion anwenden
    // ------------------------------------------------------------

    static void apply(State s, Action a) {

        s.peace += a.peace;
        s.trust += a.trust;
        s.hope += a.hope;
        s.love += a.love;
        s.happiness += a.happiness;
        s.enthusiasm += a.enthusiasm;
        s.motivation += a.motivation;
        s.intuition += a.intuition;
        s.productivity += a.productivity;

        s.conflict += a.conflict;
        s.uncertainty += a.uncertainty;
        s.resistance += a.resistance;

        s.informationQuality += a.informationQuality;
        s.communication += a.communication;
        s.cooperation += a.cooperation;

        normalize(s);
    }

    static void normalize(State s) {

        s.peace = clamp(s.peace);
        s.trust = clamp(s.trust);
        s.hope = clamp(s.hope);
        s.love = clamp(s.love);
        s.happiness = clamp(s.happiness);
        s.enthusiasm = clamp(s.enthusiasm);
        s.motivation = clamp(s.motivation);
        s.intuition = clamp(s.intuition);
        s.productivity = clamp(s.productivity);

        s.conflict = clamp(s.conflict);
        s.uncertainty = clamp(s.uncertainty);
        s.resistance = clamp(s.resistance);

        s.informationQuality = clamp(s.informationQuality);
        s.communication = clamp(s.communication);
        s.cooperation = clamp(s.cooperation);
    }

    static State copyState(State s) {

        State c = new State();

        c.peace = s.peace;
        c.trust = s.trust;
        c.hope = s.hope;
        c.love = s.love;
        c.happiness = s.happiness;
        c.enthusiasm = s.enthusiasm;
        c.motivation = s.motivation;
        c.intuition = s.intuition;
        c.productivity = s.productivity;

        c.conflict = s.conflict;
        c.uncertainty = s.uncertainty;
        c.resistance = s.resistance;

        c.informationQuality = s.informationQuality;
        c.communication = s.communication;
        c.cooperation = s.cooperation;

        c.time = s.time;

        return c;
    }

    // ------------------------------------------------------------
    // Zufallskomponente
    // ------------------------------------------------------------

    static void randomInteraction(State s, Random random) {

        double noise = (random.nextDouble() - 0.5) * 2.0;

        s.intuition += noise;
        s.uncertainty -= noise * 0.20;

        normalize(s);
    }

    // ------------------------------------------------------------
