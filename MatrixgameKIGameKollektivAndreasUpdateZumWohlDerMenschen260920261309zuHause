**Schritt 2: Konkrete Verhaltensweisen (Bottom-up)**
Erstelle für jedes aktuelle Verhalten eine Klasse. Hier ist das Modul für den Standard-Angriff. Wenn wir später die Schwarm-Logik optimieren, arbeiten wir nur in dieser Datei.

```java
package ordner1;
import java.util.List;

public class NearestEnemyBehavior implements UnitBehavior {
    @Override
    public void execute(Unit unit, List<Unit> allUnits) {
        if (unit.target == null || unit.target.leben <= 0) {
            unit.target = findNearestEnemy(unit, allUnits);
        }
        
        if (unit.target != null) {
            if (unit.getDistance(unit.target) > unit.reichweite + unit.maxSpeed) {
                unit.target = findNearestEnemy(unit, allUnits);
            }
            
            // Führt den eigentlichen Move/Attack-Befehl aus der Unit-Klasse aus
            if(unit.getDistance(unit.target) <= unit.reichweite) {
                unit.performAttack(unit.target);
            } else {
                unit.performMove();
            }
        }
    }

    private Unit findNearestEnemy(Unit current, List<Unit> allUnits) {
        Unit gegner = null;
        double min = Double.MAX_VALUE;
        for (Unit ziel : allUnits) {
            if (current.team != ziel.team && ziel.leben > 0) {
                double dist = current.getDistance(ziel);
                if (dist < min) {
                    min = dist;
                    gegner = ziel;
                }
            }
        }
        return gegner;
    }
}

```

