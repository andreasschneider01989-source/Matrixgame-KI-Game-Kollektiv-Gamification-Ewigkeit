// === Persönlichkeits- und Identitäts-Parameter (0.0 – 1.0) ===
public double bindungssicherheit = 0.5;   // Wie stabil die frühe Bindung war
public double selbstwahrnehmung  = 0.5;   // Fähigkeit, sich selbst zu erkennen
public double theoryOfMind       = 0.5;   // Verständnis für andere Units
public double impulskontrolle    = 0.5;   // Fähigkeit, Impulse zu steuern
public double narrativeKohaerenz = 0.5;   // Wie klar die eigene Geschichte ist
public double selbstvertrauen    = 0.5;   // Vertrauen in eigene Entscheidungen

// Optional: Früher Bindungsstil (als Text)
public String bindungsstil = "sicher";    // "sicher", "vermeidend", "ambivalent"

// Optional: Kurze Lebensgeschichte (kann später erweitert werden)
public String lebensgeschichte = "";
2. Methode zum Initialisieren der Persönlichkeit (beim Spawnen aufrufen)
/**
 * Initialisiert die Persönlichkeitswerte einer Unit.
 * Werte werden zufällig, aber kontrolliert gesetzt (kein extremes Chaos).
 */
public void initPersonality(java.util.Random rand) {
    // Basiswerte zwischen 0.25 und 0.85, damit extreme Ausreißer selten sind
    this.bindungssicherheit = 0.25 + rand.nextDouble() * 0.60;
    this.selbstwahrnehmung  = 0.25 + rand.nextDouble() * 0.60;
    this.theoryOfMind       = 0.25 + rand.nextDouble() * 0.60;
    this.impulskontrolle    = 0.25 + rand.nextDouble() * 0.60;
    this.narrativeKohaerenz = 0.25 + rand.nextDouble() * 0.60;
    this.selbstvertrauen    = 0.25 + rand.nextDouble() * 0.60;

    // Bindungsstil ableiten
    if (bindungssicherheit > 0.65) {
        this.bindungsstil = "sicher";
    } else if (bindungssicherheit < 0.40) {
        this.bindungsstil = "vermeidend";
    } else {
        this.bindungsstil = "ambivalent";
    }

    this.lebensgeschichte = "Geboren in Tick 0. Noch ohne große Geschichte.";
}
3. Kurze Ausgabe-Methode (zum Debuggen / Beobachten)
