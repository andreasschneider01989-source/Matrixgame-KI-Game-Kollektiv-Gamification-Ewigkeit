package ordner1; // Beachte: Muss im Ordner p1 liegen!

import javax.swing.*;
import java.awt.*;
import java.util.ArrayList;
import java.util.List;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import javax.swing.SwingUtilities;

// Ziel: Das Optimieren der Entscheidungsfindung für die Unit Fight Simulationen um definierte Ziele wie das vernichten des gegnerischen Königs durch möglichst effiziente Algorithmen und Entscheidungsfindungen auf allen Ebenen der Matrix Kollektiv zu optimieren und zu Gamifizieren und mit den LLMs und allen weiteren Intelligenzen und Open Source so das alle gewinnen erlernen zu können und zu wollen und weiteres, ich hoffe sehr auf menschiche Unterstützung und Fusion von Projekten wie diesem und weiteren
// Mein Facebook: https://www.facebook.com/andreas.schneider.7393264

public class MainGame extends JPanel {

	// Die Unit List als Basis für den GameLoop
	public List<Unit> unitList = new ArrayList<>();

	// --- Panalgrößen ---
	int FRAME_WIDTH = 1920;
	int FRAME_HEIGHT = 1080;

	// --- Zoom-Variablen ---
	double zoomFactor = 1.0;

	double zoomCenterX = 0;
	double zoomCenterY = 0;
	static final double ZOOM_STEP = 1.2; // Feinheit beim Zoomen

	double feinheit = 50;
	double PAN_STEP = feinheit * zoomFactor; // Verschiebung pro Button-Klick

	// --- Konstruktor --- init1
	public MainGame() {
		// Canvas mit schwarzem Hintergrund erstellen
		setPreferredSize(new Dimension(FRAME_WIDTH, FRAME_HEIGHT));
		setBackground(Color.BLACK);

		MouseAdapter mouseHandler = new MouseAdapter() {
			@Override
			public void mousePressed(MouseEvent e) {
				// 1. Linksklick: Einheiten selektieren
				if (SwingUtilities.isLeftMouseButton(e)) {
					int mouseX = e.getX();
					int mouseY = e.getY();
					boolean unitFound = false;

					for (Unit u : unitList) {
						double sx = (zoomCenterX + u.posX) * zoomFactor + getWidth() / 2.0;
						double sy = (zoomCenterY + u.posY) * zoomFactor + getHeight() / 2.0;
						double radius = Math.abs(u.size);

						if (Math.hypot(mouseX - sx, mouseY - sy) <= radius) {
							u.isSelected = true;
							System.out.println("Unit " + u.id + " Wurde vom Spieler ausgewählt");
							unitFound = true;
						} else if (!e.isShiftDown()) {
							u.isSelected = false;
						}
					}

					if (!unitFound && !e.isShiftDown()) {
						for (Unit u : unitList) {
							u.isSelected = false;
						}
					}
					repaint();
				}
				// 2. Rechtsklick: Befehle an ausgewählte Einheiten verteilen
				// 2. Rechtsklick: Befehle an ausgewählte Einheiten verteilen
				else if (SwingUtilities.isRightMouseButton(e)) {// 2. Rechtsklick: Befehle an ausgewählte Einheiten
																// verteilen

					int mouseX = e.getX();
					int mouseY = e.getY();

					// KORRIGIERTE MATHEMATISCHE INVERSION: Screen -> World
					double worldTargetX = (mouseX - getWidth() / 2.0) / zoomFactor - zoomCenterX;
					double worldTargetY = (mouseY - getHeight() / 2.0) / zoomFactor - zoomCenterY;

					System.out.println("--- Befehlsausgabe (Rechtsklick) ---");
					System.out.println("Maus Screen-X: " + mouseX + " | Screen-Y: " + mouseY);
					System.out.println("Berechnete Welt-X: " + worldTargetX + " | Welt-Y: " + worldTargetY);

					Unit clickedEnemy = null;
					for (Unit u : unitList) {
						// Hier bleibt die World -> Screen Transformation korrekt,
						// da wir prüfen, wo die Einheit auf dem Bildschirm gerendert wird.
						double sx = (zoomCenterX + u.posX) * zoomFactor + getWidth() / 2.0;
						double sy = (zoomCenterY + u.posY) * zoomFactor + getHeight() / 2.0;
						double radius = Math.abs(u.size);

						if (Math.hypot(mouseX - sx, mouseY - sy) <= radius) {
							clickedEnemy = u;
							System.out.println("Gegnerische Einheit für Angriff anvisiert: ID " + u.id);
							break;
						}
					}

					for (Unit u : unitList) {
						if (u.isSelected) {
							if (clickedEnemy != null) {
								// Angriffsbefehl
								u.manualTarget = clickedEnemy;
								u.targetPosX = null;
								u.targetPosY = null;
								u.decisionAlgorithm = "TARGET_ENEMY";
							} else {
								// Bewegungs-Befehl
								u.targetPosX = worldTargetX;
								u.targetPosY = worldTargetY;
								u.manualTarget = null;
								u.decisionAlgorithm = "TARGET_POINT";
								System.out.println("Einheit ID " + u.id + " bewegt sich zu Zielpunkt.");
							}
						}
					}
					repaint();
				}
			}
		};

		this.addMouseListener(mouseHandler);
		this.addMouseMotionListener(mouseHandler);
	}

	// Init Methode zum Füllen der UnitList
	public void init() {
		unitList.clear(); // Wichtig: Altes Aufräumen
		java.util.Random rand = new java.util.Random(12345); // Fester Seed = Immer gleiches Match

		int unitsPerTeam = 1;
		double counterId = 0;

		for (int i = 0; i < 100; i++) {
			// 1. Stats WÜRFELN (Aber kontrolliert! Keine Division durch 0)
//			double hp = 1; 
//			double dmg = 1; 
//			double spd =3*Math.random(); 
//			double rng = 3*Math.random(); ; 
//			double attackSpeed=1;
//			double kritChance=0.25;
//			double geschicklichkeit=1;
//			double currentDefense=1;
//			double moveSpeed=3*Math.random();;

			

			// --- TEAM 1 (Blau) ---
			Unit u1 = new Unit();
			u1.team = 1;
			u1.typ = "Unit";
			
			u1.currentTime=System.currentTimeMillis();
			u1.timeBefore=System.currentTimeMillis();
			u1.posX = Math.random() * 50;
			u1.posY = Math.random() * 50;
			u1.posZ = Math.random() * 50;
			u1.posXBefore=u1.posX;
			u1.posYBefore=u1.posY;
			u1.posZBefore=u1.posZ;
			u1.maxLeben = 1;
			u1.leben = 1; // WICHTIG: Auch leben setzen!
			u1.damage = 1;
			u1.attackSpeed=1;
			u1.moveSpeed=8*Math.random();
			u1.kritchance=0.2;
			u1.maxSpeed = 3*Math.random();;
			u1.reichweite = 3*Math.random();;
			u1.geschicklichkeit=5*Math.random();
			u1.currentDefense=5*Math.random();
			u1.decisionAlgorithm = "TRIGONOMETRIC"; // <--- HIER: Taktik A
			u1.red = 0;
			u1.green = 0;
			u1.blue = 255;
			u1.id = counterId++;
			u1.printWerte();
			unitList.add(u1);}

		for (int i = 0; i < 10; i++) {
			// --- TEAM 2 (Rot) - EXAKTE KOPIE, NUR Y GESPIEGELT ---
			Unit u2 = new Unit();
			u2.team = 2;
			u2.typ = "Unit";
			u2.currentTime=System.currentTimeMillis();
			u2.timeBefore=System.currentTimeMillis();
			u2.posX = Math.random() * 50;
			u2.posY = -Math.random() * 50;
			u2.posZ = Math.random() * 50;// Spiegelung an der X-Achse
			u2.posXBefore=u2.posX;
			u2.posYBefore=u2.posY;
			u2.posZBefore=u2.posZ;
			u2.maxLeben = 1;
			u2.leben = 1; // Exakt gleiche HP!
			u2.damage = 1;
			u2.attackSpeed=1;
			u2.moveSpeed=8*Math.random();
			u2.kritchance=0.2;
			u2.currentDefense=5*Math.random();
			u2.geschicklichkeit=6;
			u2.maxSpeed = 4;
			u2.reichweite = 9.5; // Exakt gleiche Stats!
			u2.decisionAlgorithm = "NEAREST_ENEMY"; // <--- HIER: Taktik B
			u2.red = 255;
			u2.green = 0;
			u2.blue = 0;
			u2.id = counterId++;
			u2.printWerte();
			unitList.add(u2);
		}

		// Könige exakt gespiegelt spawnen
		Unit king1 = new Unit();
		king1.typ = "King";
		king1.size = 15;
		king1.team = 1;
		king1.posX = 25;
		king1.posY = 25;
		king1.posZ = 25;
		king1.posXBefore=king1.posX;
		king1.posYBefore=king1.posY;
		king1.posZBefore=king1.posZ;

		king1.maxLeben = 3; 
		king1.leben = king1.maxLeben;
		king1.damage =1;
		king1.attackSpeed=1;
		king1.moveSpeed=3;
		king1.kritchance=0.25;
		king1.maxSpeed =5; ;
		king1.reichweite = 5;
		king1.currentDefense=3;
		king1.geschicklichkeit=5;
		king1.id = counterId++;
		king1.grid = false;
		king1.red = 0;
		king1.green = 0;
		king1.blue = 255;
		king1.decisionAlgorithm = "NEAREST_ENEMY";
		king1.printWerte();
		unitList.add(king1);

		Unit king2 = new Unit();
		king2.typ = "King";
		king2.size = 15;
		king2.team = 2;
		king2.posX = 25;
		king2.posY = -25;
		king2.posZ = 25;
		king2.posXBefore=king2.posX;
		king2.posYBefore=king2.posY;
		king2.posZBefore=king2.posZ;
		king2.maxLeben = 3; 
		king2.leben = king2.maxLeben;
		king2.damage =1; 
		king2.kritchance=0.25;
		king2.attackSpeed=1;
		king2.moveSpeed=5;
		king2.currentDefense=3;
		king2.geschicklichkeit=3;
		king2.maxSpeed = 5; 
		king2.reichweite = 5; 
		king2.id = counterId++;
		king2.grid = false;
		king2.red = 255;
		king2.green = 0;
		king2.blue = 0;
		king2.printWerte();
		king2.decisionAlgorithm = "NEAREST_ENEMY";
		unitList.add(king2);

		repaint();
	}

	// --- Pan-Methoden ---
	public void panLeft() {
		zoomCenterX += PAN_STEP;
		repaint();
	}

	public void panRight() {
		zoomCenterX -= PAN_STEP;
		repaint();
	}

	public void panUp() {
		zoomCenterY += PAN_STEP;
		repaint();
	}

	public void panDown() {
		zoomCenterY -= PAN_STEP;
		repaint();
	}

	// Gelogene Methode
	@Override
	protected void paintComponent(Graphics g) {
		super.paintComponent(g);
		Graphics2D g2 = (Graphics2D) g;
		g2.setColor(Color.BLACK);
		g2.fillRect(0, 0, getWidth(), getHeight());

		// Loop für alle Units aus UnitList
		for (int i = 0; i < unitList.size(); i++) {
			Unit unit = unitList.get(i);
			if (unit.leben <= 0)
				continue;
			double radius = unit.size;
			Color color = new Color((int) (unit.red), (int) (unit.green), (int) (unit.blue));
			double posX = unit.posX;
			double posY = unit.posY;
			// Berücksichtige Pan und Zoom bei der Positionierung
			double sx = (zoomCenterX + posX) * zoomFactor + getWidth() / 2.0;
			double sy = (zoomCenterY + posY) * zoomFactor + getHeight() / 2.0;
//			int r = (int) Math.max(body.radius * zoomFactor, MIN_RADIUS_DRAW);
			g2.setColor(color);
			g2.fillOval((int) (sx - radius), (int) (sy - radius), (int) (radius * 2), (int) (radius * 2));
			// Innerhalb von paintComponent(Graphics g) in der for-Schleife:
			if (unit.isSelected) {
				g2.setColor(Color.WHITE);
				// Einen etwas größeren Ring um die Unit zeichnen
				g2.drawOval((int) (sx - radius - 2), (int) (sy - radius - 2), (int) (radius * 2 + 4),
						(int) (radius * 2 + 4));
			}

		}
	}

	// Zoom-Funktionen
	public void zoomIn() {
		zoomFactor *= ZOOM_STEP;
		PAN_STEP = feinheit / zoomFactor;
		repaint();
	}

	public void zoomOut() {
		zoomFactor /= ZOOM_STEP;
		PAN_STEP = feinheit / zoomFactor;
		repaint();
	}

