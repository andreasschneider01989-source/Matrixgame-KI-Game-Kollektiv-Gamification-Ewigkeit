public class Unit extends KreisObjekt {
	String typ;

	long currentTime = System.currentTimeMillis();

	long timeBefore = System.currentTimeMillis();

	long timeBeforeAttack = System.currentTimeMillis();

	long deltaTime = currentTime - timeBefore;

	double timeSeconds;
	long lastAttackTime; // Zeitpunkt des letzten Angriffs (in Millisekunden)
	long lastMoveTime;

	double posXBefore;
	double posYBefore;
	double posZBefore;

	double maxLeben;
	double leben;
	double damage;
	double reichweite;
	double maxSpeed;
	double attackSpeed; // Aufladezeit in Sekunden 1.0 / attackSpeed
	double moveSpeed;
	double geschicklichkeit = Math.random();
	double defenseProTurn = Math.random();
	double currentDefense = defenseProTurn;
	double kritchance = 0.2;

	int team;
	int kills;

	double recheneffiziens;
	double zuletztVerbrauchteZeit;
	double kompletteRechenzeitInSimulation;
	double rechenzeitProZug;

	double points1;
	double points2;
	double points3;
	double points4;
	double konstruktionszeit = System.currentTimeMillis();
	public Unit target = null;

	// Neue Variablen für Entscheidungsalgorithmen und Steuerung
	public String decisionAlgorithm = "NEAREST_ENEMY"; // "TARGET_POINT", "STAND_STILL", "NEAREST_ENEMY"
	public boolean isSelectable = true;
	public boolean isInfluencable = true;

	public double maxCarryCapacity = 50.0; // statt 10.0 – Träger sollen echte Transportarbeit leisten können

	// Zielkoordinaten im 3D-Raum (x, y, z) für manuelle oder algorithmische
	// Bewegung
	public Double targetPosX = null;
	public Double targetPosY = null;
	public Double targetPosZ = null;

	// Spezifisches Ziel für einen manuellen Angriffsbefehl
	public Unit manualTarget = null;

	double id;

	double pPrint = 0.01;

	public void moveTo(KreisObjekt oponent) {
		double distQ = (this.posX - oponent.posX) * (this.posX - oponent.posX)
				+ (this.posY - oponent.posY) * (this.posY - oponent.posY)
				+ (this.posZ - oponent.posZ) * (this.posZ - oponent.posZ);
		double dist = Math.pow(distQ, 0.5);

		double dx = posX - oponent.posX;
		double dy = posY - oponent.posY;
		double dz = posZ - oponent.posZ;

		double movDist = Math.min(maxSpeed * ((System.currentTimeMillis() - timeBefore) / 1000.0),
				Math.abs(dist - reichweite));
		movDist /= 1.01;

		vx = -dx / dist * movDist;
		vy = -dy / dist * movDist;
		vz = -dz / dist * movDist;

		System.out.println("Move: " + vx + "," + vy + "," + vz);

		move(1);

	}

	public void moveToAndKite(KreisObjekt oponent) {
		double distQ = (this.posX - oponent.posX) * (this.posX - oponent.posX)
				+ (this.posY - oponent.posY) * (this.posY - oponent.posY)
				+ (this.posZ - oponent.posZ) * (this.posZ - oponent.posZ);
		double dist = Math.pow(distQ, 0.5);

		double dx = posX - oponent.posX;
		double dy = posY - oponent.posY;
		double dz = posZ - oponent.posZ;

		double movDist = Math.min(maxSpeed, Math.abs(dist - reichweite));

		if (reichweite > dist) {
			movDist = reichweite - dist;
			movDist = -movDist;
		}

		if (movDist > 0)
			movDist = movDist + 0.01;
		else
			movDist = movDist + 0.01;

//		if(grid) {
//			entropieMove2(1/8.0-dx / dist * movDist,1/8.0-dy / dist * movDist,1/8.0-dz / dist * movDist,1/8.0+dx / dist * movDist,1/8.0+dy / dist * movDist,1/8.0+dz / dist * movDist);
//		}
//		else {
		vx = -dx / dist * movDist;
		vy = -dy / dist * movDist;
		vz = -dz / dist * movDist;

		if (Math.random() < pPrint)
			System.out.println("Move: " + vx + "," + vy + "," + vz);

//		if (Math.abs(vx) <= 1 && Math.abs(vy) <= 1 && Math.abs(vz) <= 1) {
			double px = 2.0/8;
			double pxInv = 2.0/8;
			double py = 2.0/8;
			double pyInv = 2.0/8;
			double pz = 2.0/8;
			double pzInv = 2.0/8;
			if (vx > 0)
				px += vx;
			else
				pxInv = +vx;
			if (vy > 0)
				py += vy;
			else
				pyInv += vy;
			if (vz > 0)
				pz += vz;
			else
				pxInv += vz;
			entropieMove(px, pxInv, py, pyInv, pz, pzInv);
//		} else
//			move(1);
	}

//	}

	void update() {
		if (Math.random() < pPrint) {
			System.out.println("System.currentTimeMillis() = " + System.currentTimeMillis() + " this.id = " + this.id
					+ " this.posX = " + this.posX + " this.posY = " + this.posY + " this.posZ = " + this.posZ);
			if (pPrint > Math.random())
				this.printWerte();
			pPrint = 1;
		} else
			pPrint = 0;
		deltaTime = currentTime - timeBefore;
		timeSeconds = deltaTime / 1000.0;

		if (!this.typ.equals("King") && this.target != null) {

			if (canMove())
				performMove();
		}

		if (this.typ.equals("King") && this.target != null && this.target.reichweite >= getDistance(this.target)) {

			if (canMove())
				performMove();
		}

//		if (!true) {
//			posX = posXBefore;
//			posY = posYBefore;
//			posZ = posZBefore;
//		}

		// Angriff nur wenn bereit und in Reichweite
		if (this.target != null)
			if (getDistance(this.target) <= reichweite) {
				if (canAttack()) {
					performAttack(this.target); // Neue Methode verwenden
				}
			} else if (pPrint > Math.random())
				System.out.println("Reichweite  ist zu klein: Reichweite = " + reichweite + "Abstand = "
						+ getDistance(this.target));

		posXBefore = posX;
		posYBefore = posY;
		posZBefore = posZ;
		timeBefore = currentTime;
		pPrint = 0.003 + 0.003 * kills;

	}

	public void moveTo(double posX, double posY, double posZ, double speedManuel) {
		System.out.println("Zug = moveTo(" + posX + "," + posY + "," + posZ + "," + speedManuel + ")");
		double distQ = (this.posX - posX) * (this.posX - posX) + (this.posY - posY) * (this.posY - posY)
				+ (this.posZ - posZ) * (this.posZ - posZ);

		// FEHLER 3 BEHOBEN: targetPosX hier NICHT auf null setzen!
		// Das macht der MainGame-Loop sicherer.

		double dist = Math.pow(distQ, 0.5);

		// Verhindert Division durch Null, falls wir exakt auf dem Punkt stehen
		if (dist < 0.001) {
			vx = 0;
			vy = 0;
			vz = 0;
			move(1);
			return;
		}

		double dx = this.posX - posX;
		double dy = this.posY - posY;
		double dz = this.posZ - posZ;

		double movDist = Math.min(speedManuel, Math.min(maxSpeed, Math.abs(dist - 0.0000005)));

		vx = -dx / dist * movDist;
		vy = -dy / dist * movDist;
		vz = -dz / dist * movDist;

		System.out.println("Vektor = " + vx + "," + vy + "," + vz);

		// FEHLER 1 BEHOBEN: Die Bewegung muss ausgeführt werden!
		move(1);
	}

	// entropieMove das Objekt kann sich hier per Zufall in jeder Positionsvariable
	// incrementiert oder decrementiert werden. Die Summe aller Differenzen
	// multipliziert mit ihrer Wahrscheinlichkeit kann nicht größer als die
	// Geschwindigkeit sein bzw. es darf nicht möglich sein, das sich ein Objekt per
	// Zufall pro Zeitschritt in einer Art und Weise verändern kann die für die
	// moveTo Methode zu schnell bzw. zu weit wäre
	// Zufälliges Incrementieren oder decrementieren der x Position
	public void entropieMoveX1(double px, double pxInv) {
		if (px > Math.random())
			this.posX++;
		if (pxInv > Math.random())
			this.posX--;
	}

	// Zufälliges Incrementieren oder decrementieren der y Position
	public void entropieMoveY1(double py, double pyInv) {
		if (py > Math.random())
			this.posY++;
		if (pyInv > Math.random())
			this.posY--;
	}

	// Zufälliges Incrementieren oder decrementieren der z Position
	public void entropieMoveZ1(double pz, double pzInv) {
		if (pz > Math.random())
			this.posZ++;
		if (pzInv > Math.random())
			this.posZ--;
	}

	public void entropieMove(double px, double pxInv, double py, double pyInv, double pz, double pzInv) {
		if(px>1||pxInv>1||py>1||pyInv>1||pz>1||pzInv>1)entropieMove(px-1,pxInv-1,py-1,pyInv-1,pz-1,pzInv-1);
		
		entropieMoveX1(px, pxInv);
		entropieMoveY1(py, pyInv);
		entropieMoveZ1(pz, pzInv);
	}

	public void entropieMove2(double px, double pxInv, double py, double pyInv, double pz, double pzInv) {
		if (px > Math.random())
			posX++;
		else if (pxInv > Math.random())
			posX--;
		else if (py > Math.random())
			posY++;
		else if (pyInv > Math.random())
			posY--;
		else if (pz > Math.random())
			posZ++;
		else if (pzInv > Math.random())
			posZ--;

	}

//	public void entropieMove(double dx, double dy, double dz) {
//		if(dx>=0)entropieMoveX1(dx, 0);
//		else
//		entropieMoveX1(py, pyInv);
//		entropieMoveX1(pz, pzInv);
//	}

	public void moveTrigonometric(Unit target) {
		if (target == null || target.leben <= 0)
			return;

		double dx = target.posX - this.posX;
		double dy = target.posY - this.posY;
		double dist = Math.hypot(dx, dy);

		if (dist < 0.001)
			return;

		double angle = Math.atan2(dy, dx);
		double moveAngle = angle;

		// TAKTIK: Wenn wir Fernkämpfer sind, aber der Feind zu nah kommt ->
		// Kiting/Orbit
		if (this.reichweite > 3.0 && dist < this.reichweite * 1.5) {
			// Wir laufen nicht direkt weg, sondern seitlich (Flanken)
			moveAngle = angle + (Math.PI / 2.5);
		}

		this.vx = Math.cos(moveAngle) * this.maxSpeed;
		this.vy = Math.sin(moveAngle) * this.maxSpeed;

		move(1);
	}

	public double getDistance(Unit oponent) {
		double distQ = (this.posX - oponent.posX) * (this.posX - oponent.posX)
				+ (this.posY - oponent.posY) * (this.posY - oponent.posY)
				+ (this.posZ - oponent.posZ) * (this.posZ - oponent.posZ);
		double dist = Math.pow(distQ, 0.5);
		return dist;
	}

	public double getDistanceTo(double x, double y, double z) {
		double distQ = (this.posX - x) * (this.posX - x) + (this.posY - y) * (this.posY - y)
				+ (this.posZ - z) * (this.posZ - z);
		double dist = Math.pow(distQ, 0.5);
		return dist;
	}

	/**
	 * Prüft ob die Unit angreifen darf basierend auf attackSpeed
	 * 
	 * @return true wenn Angriff bereit, false wenn noch Cooldown
	 */
	public boolean canAttack() {
		long currentTime = System.currentTimeMillis();

		// Wenn noch nie angegriffen, sofort bereit
		if (lastAttackTime == 0) {
			return true;
		}

		// Berechne benötigte Wartezeit in Millisekunden
		double cooldownMillis = (1.0 / attackSpeed) * 1000.0;

		// Prüfe ob Cooldown abgelaufen ist
		return (currentTime - lastAttackTime) >= cooldownMillis;
	}

	public boolean canMove() {
		long currentTime = System.currentTimeMillis();

		// Wenn noch nie bewegt, sofort bereit
		if (lastMoveTime == 0) {
			return true;
		}

		// Berechne benötigte 


