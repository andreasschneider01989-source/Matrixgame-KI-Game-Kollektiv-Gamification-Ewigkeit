    System.out.println("Unit " + id + " [" + typ + "] Persönlichkeit:");
    System.out.printf("  Bindungssicherheit : %.2f (%s)%n", bindungssicherheit, bindungsstil);
    System.out.printf("  Selbstwahrnehmung  : %.2f%n", selbstwahrnehmung);
    System.out.printf("  Theory of Mind     : %.2f%n", theoryOfMind);
    System.out.printf("  Impulskontrolle    : %.2f%n", impulskontrolle);
    System.out.printf("  Narrative Kohärenz : %.2f%n", narrativeKohaerenz);
    System.out.printf("  Selbstvertrauen    : %.2f%n", selbstvertrauen);
    System.out.println("  Geschichte         : " + lebensgeschichte);
}
