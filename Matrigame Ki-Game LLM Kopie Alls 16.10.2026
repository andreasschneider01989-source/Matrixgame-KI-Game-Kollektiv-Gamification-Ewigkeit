python_code = '''"""MatrixMind CRISPR Governance Quest — illustrative decision-support toy model.
Not a scientific risk calculator, medical advice, or gene-editing protocol.
"""
from dataclasses import dataclass

@dataclass
class State:
    benefit: float = 75
    evidence: float = 55
    uncertainty: float = 65
    unintended_effects: float = 70
    equity: float = 45
    oversight: float = 60
    intergenerational_impact: float = 85
    coercion: float = 55

def clamp(x):
    return max(0.0, min(100.0, x))

def evaluate(s: State) -> dict:
    # Explicitly chosen discussion weights; not empirically validated.
    benefit_signal = 0.30*s.benefit + 0.25*s.evidence + 0.20*s.equity + 0.25*s.oversight
    concern_signal = (
        0.20*s.uncertainty
        + 0.20*s.unintended_effects
        + 0.25*s.intergenerational_impact
        + 0.20*s.coercion
        + 0.15*(100-s.oversight)
    )
    return {
        "benefit_signal": round(clamp(benefit_signal), 1),
        "concern_signal": round(clamp(concern_signal), 1),
        "human_review_required": (
            s.uncertainty >= 60
            or s.unintended_effects >= 60
            or s.intergenerational_impact >= 60
            or s.coercion >= 50
        ),
        "warning": "Illustrative scores; do not use as a real-world authorization rule."
    }

def apply_action(s: State, action: str) -> State:
    changes = {
        "evidence": {"evidence": 12, "oversight": 10, "uncertainty": -8},
        "equity": {"equity": 15, "oversight": 4},
        "heritable_safeguards": {"intergenerational_impact": -8, "oversight": 12, "coercion": -5},
        "public_participation": {"oversight": 12, "coercion": -8},
    }
    if action not in changes:
        raise ValueError(f"Unknown action: {action}")
    data = vars(s).copy()
    for key, delta in changes[action].items():
        data[key] = clamp(data[key] + delta)
    return State(**data)

if __name__ == "__main__":
    state = State()
    print("Baseline:", evaluate(state))
    for action in ("evidence", "equity", "heritable_safeguards", "public_participation"):
        candidate = apply_action(state, action)
        print(action, evaluate(candidate))
'''
(base / "crispr_governance_sim.py").write_text(python_code, encoding="utf-8")

readme = """# MatrixMind CRISPR Quest v0.1

Ein offenes, textbasiertes Szenariopaket, das das bereitgestellte Transkript des Kurzgesagt-Videos „CRISPR - Gentechnik wird alles für immer verändern“ (2019) in ein strukturiertes Governance-Modell überführt.

## Dateien
- `crispr-governance-model.json` — kanonisches, maschinenlesbares Zwischenmodell
- `crispr-governance-pseudocode.txt` — sprachneutrale Entscheidungslogik
- `crispr_governance_sim.py` — einfache Python-Simulation transparenter Diskussionswerte
- `README.md` — Beschreibung und Grenzen
- `LICENSE` — MIT-Lizenz

## Was das Modell aus dem Video übernimmt
Es greift die im Transkript angesprochenen Chancen (z. B. Forschung und mögliche Therapien), Risiken (unerwünschte Veränderungen, Langzeitfolgen), vererbbare Eingriffe, Enhancement, ungleichen Zugang, Diskriminierung, staatlichen Zwang und die Bedeutung von Transparenz und Aufsicht auf.

## Wichtig zur Quellenlage
Das Video stammt aus 2019. Seine Aussagen über künftige Therapien, HIV, Krebs, Altern oder mögliche Fähigkeiten genetisch veränderter Menschen sind teils historische Aussagen, Prognosen oder Spekulationen. Dieses Paket bestätigt sie nicht als heutigen Forschungsstand. Für aktuelle Fakten braucht es eine separate Prüfung anhand aktueller Fachquellen, klinischer Studien, regulatorischer Leitlinien und Ethikgremien.

## Ausführen
Python 3 ist ausreichend:
```bash
python crispr_governance_sim.py
```
Die Skalen und Gewichte sind frei gesetzte, illustrative Heuristiken. Sie messen keine echten biologischen Risiken und dürfen keine Forschung, klinische Entscheidung oder gesetzliche Genehmigung ersetzen.

## Sicherheitsrahmen
Das Paket ist auf Ethik, Governance und transparente Entscheidungshilfe ausgerichtet. Es enthält keine Laborprotokolle und keine Anleitungen zur genetischen Veränderung.

## Lizenz
MIT.
"""
