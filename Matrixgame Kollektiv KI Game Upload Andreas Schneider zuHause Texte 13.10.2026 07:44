}

private AIAction runNMaxMax(Unit activeUnit, List<Unit> globalState, int depth, boolean isMaximizing) {
    if (depth == 0) {
        // Abbruchbedingung der Rekursion: Bewerte die aktuelle Konstellation
        double score = evaluateGameState(activeUnit.team, globalState);
        return new AIAction(UnitActionType.ATTACK_TARGET, null, score);
    }

    AIAction bestMove = new AIAction(null, null, isMaximizing ? -Double.MAX_VALUE : Double.MAX_VALUE);

    // Generiere alle logischen Makro-Züge (Branching)
    // Zur Optimierung: Wir betrachten nur die 3 nächsten Feinde, nicht alle 50!
    List<Unit> closestEnemies = getClosestEnemies(activeUnit, globalState, 3);

    for (Unit enemy : closestEnemies) {
        // 1. Simuliere den Zug (Zustandsänderung)
        double originalEnemyHp = enemy.leben;
        double originalUnitX = activeUnit.posX;
        double originalUnitY = activeUnit.posY;
        
        // Simuliere: Wenn in Reichweite, simuliere Schaden. Wenn nicht, simuliere Annäherung.
        if (activeUnit.getDistance(enemy) <= activeUnit.reichweite) {
            enemy.leben -= activeUnit.schaden; // Deterministischer Minimax ignoriert hier den Random-Krit
        } else {
            // Vektor in Richtung Feind berechnen (1 Tick Vorhersage)
            double dist = activeUnit.getDistance(enemy);
            activeUnit.posX += ((enemy.posX - activeUnit.posX) / dist) * activeUnit.speed;
            activeUnit.posY += ((enemy.posY - activeUnit.posY) / dist) * activeUnit.speed;
        }

        // 2. Rekursion (Der nächste Tick wird vom Feind gespielt -> Minimizing)
        // In einem echten N-Max-Max würden wir hier über alle Einheiten iterieren. 
        // Für Performance-Gründe simulieren wir den direkten Gegenschlag des anvisierten Ziels.
        AIAction childAction = runNMaxMax(enemy, globalState, depth - 1, !isMaximizing);

        // 3. Rollback (Zustand wiederherstellen für den nächsten Schleifendurchlauf)
        enemy.leben = originalEnemyHp;
        activeUnit.posX = originalUnitX;
        activeUnit.posY = originalUnitY;

        // 4. Minimax-Logik
        if (isMaximizing) {
            if (childAction.evaluationScore > bestMove.evaluationScore) {
                bestMove.evaluationScore = childAction.evaluationScore;
                bestMove.targetObject = enemy;
                bestMove.type = UnitActionType.ATTACK_TARGET;
            }
        } else {
            if (childAction.evaluationScore < bestMove.evaluationScore) {
                bestMove.evaluationScore = childAction.evaluationScore;
                bestMove.targetObject = enemy;
                bestMove.type = UnitActionType.ATTACK_TARGET;
            }
        }
    }
    return bestMove;
}

// Die Fitness-Funktion: Logische und mathematische Bewertung des Boards
private double evaluateGameState(int myTeam, List<Unit> allUnits) {
    double myTeamHp = 0;
    double enemyTeamHp = 0;
    
    for (Unit u : allUnits) {
        if (u.leben <= 0) continue;
        if (u.team == myTeam) {
            myTeamHp += u.leben;
            if ("King".equals(u.typ)) myTeamHp += 500; // König stark priorisieren
        } else {
            enemyTeamHp += u.leben;
            if ("King".equals(u.typ)) enemyTeamHp -= 500;
        }
    }
    return myTeamHp - enemyTeamHp;
}

// Hilfsfunktion zur Limitierung des Suchraums (Branching Factor Reduktion)
private List<Unit> getClosestEnemies(Unit active, List<Unit> allUnits, int limit) {
    return allUnits.stream()
            .filter(u -> u.team != active.team && u.leben > 0)
            .sorted((u1, u2) -> Double.compare(active.getDistance(u1), active.getDistance(u2)))
            .limit(limit)
            .toList();
}

```

