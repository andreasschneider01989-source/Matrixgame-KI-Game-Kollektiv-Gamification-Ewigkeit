### 💻 Der kompilierbare Java-Prototyp: `BioSatelliteOptimizationQuest`

Hier ist der Code, der diese exakte Kausalität abbildet. Er zeigt, wie eine Intervention (gesteuert durch Satellitendaten) den negativen Zustand umkehrt und das System optimiert.

```java
import java.util.ArrayList;
import java.util.List;

/**
 * MATRIXGAME QUEST: Bio-Satelliten-Harmonie
 * Simuliert die kausale Optimierung nächtlicher Ökosysteme durch satellitengestützte Daten.
 */
public class BioSatelliteOptimizationQuest {

    static class EcoZone {
        String name;
        double lightPollution;    // 0.0 (dunkel) bis 100.0 (hell)
        double avianStress;       // 0.0 (ruhig) bis 100.0 (gestresst)
        double satelliteInsight;  // 0.0 (blind) bis 100.0 (vollständige Daten)
        double harmony;           // Resultierender "Option Space" der Natur

        public EcoZone(String name, double light, double stress) {
            this.name = name;
            this.lightPollution = light;
            this.avianStress = stress;
            this.satelliteInsight = 10.0; // Startet mit geringer Erkenntnis
            this.harmony = 50.0;
        }

        void simulateNight() {
            // Kausale Regel 1: Lichtverschmutzung treibt den Stress der Vögel hoch
            this.avianStress = clamp(this.avianStress + (this.lightPollution * 0.4));
            
            // Kausale Regel 2: Harmonie sinkt, wenn Stress hoch und Erkenntnis niedrig ist
            double negativePressure = this.avianStress - this.satelliteInsight;
            this.harmony = clamp(this.harmony - (negativePressure * 0.1));
        }

        void applySatelliteOptimization() {
            // Kausale Regel 3: Hohe Satelliten-Erkenntnis ermöglicht gezielte Optimierung
            if (this.satelliteInsight > 60.0) {
                // Intelligente Lichtsteuerung wird aktiviert
                this.lightPollution = clamp(this.lightPollution - 30.0);
                // Vögel erholen sich schneller
                this.avianStress = clamp(this.avianStress - 40.0);
                // Harmonie und Option Space steigen massiv
                this.harmony = clamp(this.harmony + 25.0);
                System.out.println("   ✅ [OPTIMIERUNG] Satellitendaten genutzt: Licht reduziert, Vogelstress gesenkt in " + this.name);
            } else {
                System.out.println("   ⚠️ [WARNUNG] Zu wenig Satelliten-Erkenntnis in " + this.name + " für wirksame Optimierung.");
            }
        }

        void gatherData() {
            // Forschung und Open-Source-Datenaustausch erhöhen die Erkenntnis
            this.satelliteInsight = clamp(this.satelliteInsight + 15.0);
        }

        double clamp(double value) {
            return Math.max(0.0, Math.min(100.0, value));
        }
    }

    public static void main(String[] args) {
        System.out.println("===========================================================");
        System.out.println(" MATRIXGAME QUEST: BIO-SATELLITEN-HARMONIE & NACHT-ÖKOLOGIE");
        System.out.println("===========================================================\n");

        List<EcoZone> zones = new ArrayList<>();
        zones.add(new EcoZone("Stadtpark-Zentrum", 85.0, 70.0)); // Hoher Stress, viel Licht
