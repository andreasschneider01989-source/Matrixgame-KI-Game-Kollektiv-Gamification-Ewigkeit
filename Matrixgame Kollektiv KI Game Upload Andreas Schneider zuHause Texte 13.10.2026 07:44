### 3.1 Die `Unit.java` – Basis aller Entitäten

```java
package p1;

import java.awt.Color;
import java.util.List;

public class Unit {
    // === PHYSIKALISCHE GRÖSSEN ===
    public double x, y, z;
    public double vx, vy, vz;
    public double mass;
    public int radius;
    public double leben = 100.0;
    
    // === INFORMATIONELLE GRÖSSEN ===
    public double resistance = 0.5;  // ρ (Flusswiderstand)
    public double intelligence = 1.0; // I (Intelligenzdichte)
    public double communicationSpeed = 1.0; // C (Kommunikationsgeschwindigkeit)
    public double voluntariness = 1.0; // V (Freiwilligkeit)
    
    // === BIOLOGISCHE TYPEN ===
    public String bioTyp = "NORMAL";
    public boolean isInfected = false;
    public long infectionStartTick = 0;
    public int replicationDelay = 80;
    
    // === GAMIFICATION ===
    public int xp = 0;
    public int kills = 0;
    public String originSector = "UNKNOWN";
    public long creationTimestamp = 0;
    
    // === KONSTRUKTOR ===
    public Unit() {
        this.x = 0; this.y = 0; this.z = 0;
        this.vx = 0; this.vy = 0; this.vz = 0;
        this.mass = 10; this.radius = 10;
        this.color = Color.CYAN;
    }
    
    // === ZENTRALE UPDATE-METHODE ===
    public void update(List<Unit> allUnits, long currentTick) {
        // 1. Basis-Physik
        this.x += this.vx;
        this.y += this.vy;
        this.z += this.vz;
        
        // 2. XP für Überleben
        if (this.leben > 0 && Math.random() < 0.01) {
            this.xp += 1;
        }
        
        // 3. Bio-Typ spezifische Logik
        processBioLogic(allUnits, currentTick);
    }
    
    // === RESONANZ-INTERAKTION (Überbieten statt Verbieten) ===
    public void interactResonance(Unit other) {
        double rho = Math.abs(this.intelligence - other.intelligence) + 1.0;
        double phi = (this.intelligence * this.communicationSpeed) / rho;
        
        if (phi > other.resistance) {
            other.resistance -= 0.1;
            other.xp += (int)(phi * 10);
            this.xp += 5;
            System.out.println("✨ RESONANZ: Widerstand reduziert bei " + other.bioTyp);
        }
    }
    
    // === CORONA-INFETIONSZYKLUS ===
    public void processCoronaLifecycle(List<Unit> allUnits, long currentTick) {
        if (this.bioTyp.equals("ZELLE") && this.isInfected) {
            long infektionsDauer = currentTick - this.infectionStartTick;
            
            if (infektionsDauer >= this.replicationDelay) {
                int neueViren = 3 + (int)(Math.random() * 5);
                
                System.out.println(" [Tick " + currentTick + "] APOPTOSE: Zelle bei (" + 
                    (int)this.x + "," + (int)this.y + ") platzt und setzt " + neueViren + " Viren frei!");
                
                for (int i = 0; i < neueViren; i++) {
                    Unit virus = new Unit();
                    virus.x = this.x + (Math.random() - 0.5) * 40;
                    virus.y = this.y + (Math.random() - 0.5) * 40;
                    virus.bioTyp = "CORONA";
                    virus.color = new Color(220, 20, 60);
                    virus.originSector = this.originSector;
                    allUnits.add(virus);
                }
                
                this.leben = 0;
                this.color = Color.DARK_GRAY;
                this.xp += 50;
            }
        }
    }
}
```

### 3.2 Der GameLoop – Das Herz der Simulation

```java
private void gameLoop() {
    long currentTick = 0;
    
    while (!spielBeendet) {
        try {
            // 1. Update aller Units
            for (int i = unitList.size() - 1; i >= 0; i--) {
                Unit k = unitList.get(i);
                k.update(unitList, currentTick);
                k.processCoronaLifecycle(unitList, currentTick);
                
                // XP sammeln
                if (k.xp > 0) {
                    xpGesamt += k.xp;
                    k.xp = 0;
                }
                
                // Tote Units entfernen
                if (k.leben <= 0) {
                    unitList.remove(i);
                    totaleKills++;
                }
            }
            
            currentTick++;
            simulationsSchritte = currentTick;
            
            // 2. Siegbedingung prüfen
            checkSiegbedingung();
            
            // 3. LUMINI-String ausgeben (alle 1000 Ticks)
            if (currentTick % 1000 == 0) {
                printLuminiForLLM();
            }
            
            // 4. Console-Update (alle 500 Ticks)
            if (currentTick % 500 == 0) {
                printKonsolenUpdate();
            }
            
            Thread.sleep(pause);
            SwingUtilities.invokeLater(() -> repaint());
            
        } catch (InterruptedException e) {
            break;
        }
    }
}
