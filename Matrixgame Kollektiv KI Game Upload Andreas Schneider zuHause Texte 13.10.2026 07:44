            double sim = 1000 - Math.abs(neuronAlignment - o.neuronAlignment);
            double adj = (neuronAlignment - o.neuronAlignment) * Math.random() / 2;
            neuronAlignment -= adj; o.neuronAlignment += adj;
            if (sim < 500) demonizationLevel += 5;
            else if (sim < 700) demonizationLevel += 2;
            else if (sim > 995) demonizationLevel = Math.max(0, demonizationLevel - 1);
        }
        void exchangeKnowledge(Human o) {
            double sim = 1000 - Math.abs(neuronAlignment - o.neuronAlignment);
            double common = Math.min(networkedKnowledge, o.networkedKnowledge) * Math.random();
            double t1 = networkedKnowledge - common, t2 = o.networkedKnowledge - common;
            if (sim > 995) { networkedKnowledge += t2 * Math.random(); o.networkedKnowledge += t1 * Math.random();
                demonizationLevel = Math.max(0, demonizationLevel - 1); }
            else if (sim > 700) { networkedKnowledge += t2 * Math.random() * Math.random();
                o.networkedKnowledge += t1 * Math.random() * Math.random(); }
            else if (sim > 500) { networkedKnowledge -= t2 * Math.random() * Math.random();
                o.networkedKnowledge -= t1 * Math.random() * Math.random(); demonizationLevel += 2; }
            else { networkedKnowledge -= t2 * Math.random(); o.networkedKnowledge -= t1 * Math.random();
                demonizationLevel += 5; }
            networkedKnowledge = Math.max(0, networkedKnowledge);
            o.networkedKnowledge = Math.max(0, o.networkedKnowledge);
        }
    }

    static class BioNeuron {
        final int id; double x, y, z; int type; boolean isSensor;
        double potential, baseThreshold = 1.0, energy = 1.5, trust = 0.5;
        int generation; double[] portWeights = new double[6]; int[] portPulses = new int[6];
        BioNeuron(int id, double x, double y, double z, int type, boolean sensor, int gen) {
            this.id = id; this.x = x; this.y = y; this.z = z;
            this.type = type; isSensor = sensor; generation = gen;
            Random r = new Random(id * 31L + gen * 131L);
            for (int i = 0; i < 6; i++) portWeights[i] = (0.2 + r.nextDouble() * 0.8) * (type == -1 ? -1 : 1);
        }
        boolean updateLogic() {
            double in = 0;
            for (int i = 0; i < 6; i++) if (portPulses[i] == 1) { in += portWeights[i] * 1.2; portPulses[i] = 0; }
            potential = potential * LEAK + in;                       // FIX: Leck
            double th = baseThreshold / 1.1;
            boolean fired = false;
            if (potential >= th) {
                potential = 0; fired = true;
                energy = Math.min(E_MAX, energy + 0.35);             // FIX: Energie-Cap
                for (int i = 0; i < 6; i++) portPulses[i] = portWeights[i] > 0 ? -1 : 0;
            } else for (int i = 0; i < 6; i++) if (portPulses[i] == -1) portPulses[i] = 0;
            energy = Math.max(0.1, energy - 0.0018);
            return fired;
        }
        boolean canDivide() { return energy >= 3.6 && !isSensor; }
    }

    static class World {
        final WorldType type; final Human[] humans; final List<BioNeuron> colony = new ArrayList<>();
        boolean rescued; double harmony = 50.0;
        final Random rng;
        World(WorldType t, long seed) {
            type = t; rng = new Random(seed);
            humans = new Human[t.humans];
            for (int i = 0; i < t.humans; i++) {
                int life = t == WorldType.GOD_PLANT ? 10 : 20;
                humans[i] = new Human(t.level + (int)(Math.random() * t.level), life, Math.random() * 1000, 0);
            }
            for (int i = 0; i < 5; i++) colony.add(new BioNeuron(i, -150 + i * 75, -180, 0, 1, true, 0));
            for (int i = 5; i < 17; i++) colony.add(new BioNeuron(i,
                (rng.nextDouble() - 0.5) * 200, (rng.nextDouble() - 0.5) * 150,
                (rng.nextDouble() - 0.5) * 180, rng.nextDouble() > 0.25 ? 1 : -1, false, 0));
            if (t == WorldType.DOGSCAPE) rescued = false;
        }

        /** Ein Simulations-Schritt: Kolonie tickt, Mitose, Welt-Effekte je nach Harmonie. */
        String tick() {
            int fires = 0;
            for (BioNeuron n : colony) if (n.updateLogic()) {
                fires++;
                for (BioNeuron t : colony) if (t != n && dist(n, t) < LINK_RADIUS)
                    t.portPulses[closestPort(n, t)] = 1;
            }
            List<BioNeuron> children = new ArrayList<>();
            for (BioNeuron n : colony) if (n.canDivide() && colony.size() < MAX_CELLS) {
                n.energy = 1.2;
                int newType = (n.generation >= 2 && rng.nextDouble() < 0.35) ? 2 : n.type;
                BioNeuron c = new BioNeuron(100 + colony.size(),
                    n.x + (rng.nextDouble() - 0.5) * 35, n.y + (rng.nextDouble() - 0.5) * 35,
                    n.z + (rng.nextDouble() - 0.5) * 35, newType, false, n.generation + 1);
                for (int p = 0; p < 6; p++) c.portWeights[p] = n.portWeights[p] + (rng.nextDouble() - 0.5) * 0.1;
                children.add(c);
            }
            colony.addAll(children);
            harmony = Math.max(0, Math.min(100, harmony + (fires > 3 ? 0.05 : -0.02))); // FIX: Clamp
            return applyWorldEffects();
        }

        String applyWorldEffects() {
            boolean healing = harmony >= 70;
            switch (type) {
                case ORACLE_WORLD: {
                    Human h = humans[0];
                    if (!healing) { h.networkedKnowledge *= 0.95; return "Dunkler Engel wirkt in der Orakel-Welt (Harmonie < 70)."; }
                    return "Die Orakel-Welt hellt sich auf - hohe Harmonie neutralisiert den dunklen Engel."; }
                case DOGSCAPE: {
                    if (!rescued && healing) { rescued = true; return "DOGSCAPE GERETTET! Harmonie >= 70 - das Ökosystem stabilisiert sich."; }
                    if (rescued) { for (Human h : humans) h.life += 1; return "Dogscape blüht auf: alle Bewohner +1 Leben."; }
                    humans[(int)(Math.random() * humans.length)].life -= 1;
                    return "Dogscape im Chaos: Hundepacks greifen an (Harmonie zu niedrig)."; }
                case ZOMBIE_WORLD: {
                    int idx = (int)(Math.random() * humans.length);
                    if (healing) { humans[idx].networkedKnowledge *= 1.05; return "Zombie-Heilung: ein Fleischfresser erwacht zu Bewusstsein."; }
                    humans[idx].networkedKnowledge *= 0.9; return "Fleischfresser wandern um und zerstören Wissen."; }
                case ICE_WORLDS: {
                    int idx = (int)(Math.random() * humans.length);
                    if (healing) { humans[idx].life += 1; return "Die Eiswelten tauen - Leben erblüht unter dem Eis."; }
                    humans[idx].life -= 2; return "Die eisigen Bedingungen fordern Opfer (-2 Leben)."; }
                default: return "Keine Spezialeffekte - die Kolonie lernt weiter (" +
                    String.format(Locale.US, "Harmonie %.1f", harmony) + ").";
            }
        }

        static double dist(BioNeuron a, BioNeuron b) {
            double dx = a.x-b.x, dy = a.y-b.y, dz = a.z-b.z; return Math.sqrt(dx*dx+dy*dy+dz*dz);
        }
        static int closestPort(BioNeuron s, BioNeuron d) {
            double dx = d.x-s.x, dy = d.y-s.y, dz = d.z-s.z; int best = 0; double max = -999;
            for (int i = 0; i < 6; i++) {
                double dot = dx*HEX[i][0] + dy*HEX[i][1] + dz*HEX[i][2];
                if (dot > max) { max = dot; best = i; }
            }
            return best;
        }
    }

