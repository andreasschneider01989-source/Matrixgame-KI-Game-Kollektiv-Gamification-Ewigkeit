        // Verknüpfungen erstellen
        for(let n of inputNodes) {
            synapses.push(new Synapse(n, processorNode, 1.5));
        }
        for(let n of outputNodes) {
            synapses.push(new Synapse(processorNode, n, 2.0));
        }

        // Event Listeners für Infinity Canvas Steuerung
        canvas.addEventListener('mousedown', (e) => {
            isDragging = true;
            dragStart.x = e.clientX / camera.zoom - camera.x;
            dragStart.y = e.clientY / camera.zoom - camera.y;
        });

        canvas.addEventListener('mousemove', (e) => {
            if (isDragging) {
                camera.x = e.clientX / camera.zoom - dragStart.x;
                camera.y = e.clientY / camera.zoom - dragStart.y;
            }
        });

        canvas.addEventListener('mouseup', () => isDragging = false);
        canvas.addEventListener('mouseleave', () => isDragging = false);

        canvas.addEventListener('wheel', (e) => {
            const zoomAmount = 0.1;
            const mouseX = e.clientX;
            const mouseY = e.clientY;

            // Zoom-Fokus auf Mausposition
            const wheel = e.deltaY < 0 ? 1 : -1;
            const zoomRatio = Math.exp(wheel * zoomAmount);
            
            camera.x = mouseX - (mouseX - camera.x * camera.zoom) * zoomRatio / camera.zoom;
            camera.y = mouseY - (mouseY - camera.y * camera.zoom) * zoomRatio / camera.zoom;
            
            camera.zoom *= zoomRatio;
        });

        // Haupt-Simulations-Schleife (Game Loop)
        function animate() {
            // Hintergrund löschen
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Canvas Transformation anwenden (Kamera)
            ctx.save();
            ctx.translate(camera.x * camera.zoom, camera.y * camera.zoom);
            ctx.scale(camera.zoom, camera.zoom);

            // Grid zeichnen für Raumorientierung
            ctx.strokeStyle = '#30363d';
            ctx.lineWidth = 1 / camera.zoom;
            const gridSize = 100;
            const left = -camera.x - canvas.width / camera.zoom;
            const right = -camera.x + canvas.width * 2 / camera.zoom;
            const top = -camera.y - canvas.height / camera.zoom;
            const bottom = -camera.y + canvas.height * 2 / camera.zoom;

            ctx.beginPath();
            for (let x = Math.floor(left / gridSize) * gridSize; x < right; x += gridSize) {
                ctx.moveTo(x, top);
                ctx.lineTo(x, bottom);
            }
            for (let y = Math.floor(top / gridSize) * gridSize; y < bottom; y += gridSize) {
                ctx.moveTo(left, y);
                ctx.lineTo(right, y);
            }
            ctx.stroke();

            // Logik Update & Zeichnen
            for(let n of neurons) {
                n.activation *= 0.95; // Aktivierung klingt langsam ab
            }

            for(let s of synapses) {
                s.update();
                s.draw(ctx);
            }

            for(let n of neurons) {
                n.draw(ctx);
            }

            ctx.restore();
            requestAnimationFrame(animate);
        }

        // Start
        animate();
    </script>
</body>
</html>

```

### Funktionalität dieses Moduls:

1. **Unendlicher Raum (Infinity Canvas):** Durch Klicken und Ziehen der Maus lässt sich der Raum in alle $x$- und $y$-Richtungen verschieben. Das Mausrad steuert den Zoom-Faktor. Die Rasterlinien verdeutlichen die mathematische Koordinatenstruktur des Raumes.
2. **Entropie-Verknüpfungen:** Die blauen, wandernden Lichtpunkte simulieren den Informationsfluss (oder Neurotransmitter). Sie wandern von den Input-Werten der Zahlenreihe durch die kollektive Verschaltung zur Verarbeitung.
3. **Automatisches Ressourcen-Management:** Wenn die logische Kette die korrekten Output-Neuronen (12, 14, 16) aktiviert, generiert das System Bonuspunkte, die live oben links summiert werden.
4. **Skalierbarkeit:** Der JavaScript-Code kann im Browser jederzeit über die Entwicklerkonsole erweitert werden, um neue Knoten, weitere Raumdimensionen (visuell simuliert) oder komplexere formelbasierte Bedingungen einzufügen.

Diese Struktur ist optimal geeignet, um didaktisch wertvolle Entwicklungsgeschichten im Matrixgame zu visualisieren und die Verbindung verschiedener kognitiver Prozesse logisch und mathematisch greifbar zu machen.



Wir bekommen das sinnvoll weiterentwickelt. Der wichtigste Fehler im bisherigen Simulator ist nicht die Idee, sondern die Mathematik und die fehlende Visualisierung. Die riesigen Aktivierungswerte entstehen unter anderem dadurch, dass extrem große physikalische Zahlen als neuronale Gewichte verwendet und anschließend wiederholt miteinander multipliziert werden. Das ist weder ein realistisches Neuronenmodell noch eine brauchbare Grundlage für Evolution.

