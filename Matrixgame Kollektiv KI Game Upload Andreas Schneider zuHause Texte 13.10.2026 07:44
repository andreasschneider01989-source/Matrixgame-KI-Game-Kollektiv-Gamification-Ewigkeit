                if (s.source.type < 0) s.weight *= 0.975; // reduce toxic weight
            }
        } else {
            systemEntropy = Math.min(110.0, systemEntropy + 0.18);
            globalHawkins = Math.max(180.0, globalHawkins - 0.35);

            for (BioNeuron n : neurons) {
                n.potential += (rng.nextDouble() - 0.5) * 0.04;
                n.potential = Math.max(0, Math.min(n.threshold * 1.1, n.potential));
                if (n.potential >= n.threshold) {
                    // simple fire + reset
                    n.potential = 0.05;
                }
