import java.util.*;
import java.util.function.*;

/**
 * MATRIXGAME CORE - eine einzige Datei, eine einzige oeffentliche Klasse.
 *
 * START (ohne Projekt, Java 17+; Java 21 empfohlen):
 *     java Matrixgame.java            -> alle Experimente, 200 Seeds
 *     java Matrixgame.java 500        -> 500 Seeds
 *     java Matrixgame.java demo       -> ein einzelner Lauf mit Zeitverlauf
 *
 * START IN ECLIPSE:
 *     File > New > Java Project > (src-Ordner) > New > Class "Matrixgame"
 *     > gesamten Text ersetzen > Run As > Java Application.
 *
 * DIDAKTISCHER AUFBAU (von oben nach unten lesen):
 *   1. PAL         - wie sicher ist eine Aussage? FACT / MODEL / HYPOTHESIS / FICTION
 *   2. Node, Resource, Message, Agent, World - die Bausteine
 *   3. Strategie   - Entscheidungsalgorithmen (Greedy, Zufall, Reziprozitaet, N-Max-Max)
 *   4. Simulation  - die Regeln pro Tick (Zustand + Regeln + Zufall + Rueckkopplung + Zeit)
 *   5. Experiment  - eine Hypothese wird ueber viele Seeds getestet, Ergebnis = Result
 *   6. main        - die Experimente, inklusive Negativkontrolle
 *
 * SPIELREGELN: feste Seeds, jede Behauptung ist widerlegbar, Experimente heben
 * eine Hypothese hoechstens auf MODEL, niemals auf FACT.
 *
 * ERWEITERN: Neue Strategie = ein neuer Eintrag in Abschnitt 3 (siehe "NMaxMax"
 * als Vorlage). Neues Experiment = ein neuer Aufruf von "new Experiment(...)" in main.
 */
public class Matrixgame {

    // ------------------------------------------------------------------ 1. PAL
    enum Pal { FACT, MODEL, HYPOTHESIS, FICTION }

    // ------------------------------------------------------------ 2. Bausteine
    static class Node {
        final String id;
        final String label;
        Pal pal;
        Node(String id, String label, Pal pal) { this.id = id; this.label = label; this.pal = pal; }
    }

    /** Alles Begrenzte. Hier: ein nachwachsender Bestand (logistisches Wachstum). */
    static class Resource extends Node {
        double amount;
        final double capacity;
        final double growth;
        Resource(String label, double amount, double capacity, double growth) {
            super("res-" + label, label, Pal.MODEL);
            this.amount = amount; this.capacity = capacity; this.growth = growth;
        }
        /**
         * Nachhaltiger Ertrag pro Tick. Unterhalb der halben Kapazitaet folgt er dem Bestand,
         * darueber bleibt er auf dem Maximum (MSY = growth*capacity/4). Waere er auch darueber
         * bestandsabhaengig, wuerden Kooperierende bei vollem Bestand zu wenig ernten.
         */
        double sustainableYield() {
            double s = Math.min(amount, capacity / 2);
            return Math.max(0, growth * s * (1 - s / capacity));
        }
        void regrow(double noise) {
            amount += growth * noise * amount * (1 - amount / capacity);
            amount = Math.max(0, Math.min(capacity, amount));
        }
    }

    record Message(int tick, String from, String text) { }

    static class Agent extends Node {
        final Strategy strategy;
        double energy = 20;     // Ueberleben: faellt um "metabolism" pro Tick
        double harvested = 0;   // gesamte Ernte (Reichtum, ueber dem Energiedeckel)
        double lastRequest = 0; // Information, die andere sehen koennen
        int diedAt = -1;
        Agent(String id, Strategy s) { super(id, s.name() + "#" + id, Pal.MODEL); this.strategy = s; }
        boolean alive() { return diedAt < 0; }
    }

    static class World {
        final Resource pool;
        final List<Agent> agents = new ArrayList<>();
        final List<Message> log = new ArrayList<>();
        final Random rnd;
        final double metabolism = 4, maxEnergy = 40;
        int tick = 0;
        World(long seed) {
            rnd = new Random(seed);
            double start = 500 * (0.9 + 0.2 * rnd.nextDouble()); // Startbestand variiert je Seed
            pool = new Resource("Allmende", start, 1000, 0.25);
        }
        int aliveCount() { int n = 0; for (Agent a : agents) if (a.alive()) n++; return n; }
        double othersAvgRequest(Agent self) {
            double s = 0; int n = 0;
            for (Agent a : agents) if (a != self && a.alive()) { s += a.lastRequest; n++; }
            return n == 0 ? 0 : s / n;
        }
    }

    // ----------------------------------------------------------- 3. Strategien
    interface Strategy {
        String name();
        double request(Agent self, World w);
    }

    /** Fairer, nachhaltiger Anteil: 90 % des Ertrags geteilt durch die Lebenden. */
    static double coopShare(World w) {
        return 0.9 * w.pool.sustainableYield() / Math.max(1, w.aliveCount());
    }

    static class Greedy implements Strategy {
        final String name;
        Greedy(String name) { this.name = name; }
        public String name() { return name; }
        public double request(Agent self, World w) { return 20; }
    }

    static class RandomPick implements Strategy {
        public String name() { return "Zufall"; }
        public double request(Agent self, World w) { return 12 * w.rnd.nextDouble(); }
    }

    /** Spiegelt die anderen: nimmt mindestens den fairen Anteil, hoechstens wie gierig. */
    static class Reciprocity implements Strategy {
        public String name() { return "Reziprozitaet"; }
        public double request(Agent self, World w) {
            return Math.min(20, Math.max(coopShare(w), w.othersAvgRequest(self)));
        }
    }

    /**
     * N-Max-Max (vereinfachte Annahme-Version, NICHT getunt):
     * 1. Prioritaet: moeglichst viele ueberleben (N) -> nie mehr als der nachhaltige Anteil.
     * 2. Prioritaet: innerhalb dessen die eigene Ernte maximieren.
     * Es gibt weder Sanktion noch Lernen - das waere N-Max-Max-T.
     */
    static class NMaxMax implements Strategy {
        final String name;
        NMaxMax(String name) { this.name = name; }
        NMaxMax() { this("N-Max-Max"); }
        public String name() { return name; }
        public double request(Agent self, World w) { return coopShare(w); }
    }

    // ---------------------------------------------------------- 4. Simulation
    static class Simulation {
        static void run(World w, int maxTicks) {
            while (w.tick < maxTicks && w.aliveCount() > 0) {
                w.tick++;
                List<Agent> live = new ArrayList<>();
                for (Agent a : w.agents) if (a.alive()) live.add(a);
                double[] req = new double[live.size()];
                double total = 0;
                for (int i = 0; i < live.size(); i++) {
                    req[i] = Math.max(0, live.get(i).strategy.request(live.get(i), w));
                    total += req[i];
                }
                for (int i = 0; i < live.size(); i++) live.get(i).lastRequest = req[i]; // erst nach allen Entscheidungen
                double scale = total <= w.pool.amount || total == 0 ? 1 : w.pool.amount / total;
                for (int i = 0; i < live.size(); i++) {
                    Agent a = live.get(i);
                    double got = req[i] * scale;
                    w.pool.amount -= got;
                    a.harvested += got;
                    a.energy = Math.min(w.maxEnergy, a.energy + got - w.metabolism);
                    if (a.energy <= 0) {
                        a.diedAt = w.tick;
                        w.log.add(new Message(w.tick, a.label, "verhungert"));
                    }
                }
                w.pool.regrow(1 + 0.1 * (2 * w.rnd.nextDouble() - 1)); // Zufall + Rueckkopplung
            }
        }
    }

    // ------------------------------------------------------------ 5. Experiment
    static final int MAX_TICKS = 200;

    static World play(long seed, Strategy... who) {
        World w = new World(seed);
        for (int i = 0; i < who.length; i++) w.agents.add(new Agent("" + i, who[i]));
        Simulation.run(w, MAX_TICKS);
        return w;
    }

    /** Metrik: mittlere Lebensdauer der Agenten einer Strategie (Ueberlebende = MAX_TICKS). */
    static double life(World w, String strat) {
        double s = 0; int n = 0;
        for (Agent a : w.agents) if (a.strategy.name().equals(strat)) { s += a.alive() ? MAX_TICKS : a.diedAt; n++; }
        return s / n;
    }

    /** Metrik: mittlere Gesamternte pro Agent einer Strategie. */
    static double harvest(World w, String strat) {
        double s = 0; int n = 0;
        for (Agent a : w.agents) if (a.strategy.name().equals(strat)) { s += a.harvested; n++; }
        return s / n;
    }

    enum Expect { A_GREATER_B, NO_DIFFERENCE }

    record Result(String name, String hypothesis, Pal claimed, Pal granted, double meanA, double meanB,
                  double t, double d, String verdict) { }

    static class Experiment {
        final String name, hypothesis;
        final Pal claimed = Pal.HYPOTHESIS;
        final Expect expect;
        final LongFunction<double[]> trial; // seed -> {Wert A, Wert B}
        Experiment(String name, String hypothesis, Expect expect, LongFunction<double[]> trial) {
            this.name = name; this.hypothesis = hypothesis; this.expect = expect; this.trial = trial;
        }
        Result run(int seeds) {
            double[] a = new double[seeds], b = new double[seeds];
            for (int s = 0; s < seeds; s++) { double[] r = trial.apply(s + 1L); a[s] = r[0]; b[s] = r[1]; }
            double ma = mean(a), mb = mean(b), va = var(a, ma), vb = var(b, mb);
            double diff = ma - mb, se = Math.sqrt(va / seeds + vb / seeds);
            double sdPool = Math.sqrt((va + vb) / 2);
            double t = se < 1e-12 ? (Math.abs(diff) < 1e-9 ? 0 : Math.signum(diff) * Double.POSITIVE_INFINITY) : diff / se;
            // Streuung null: nur die Effektgroesse zaehlt (hier: relative Differenz)
            double d = sdPool < 1e-12 ? (Math.abs(diff) < 1e-9 ? 0 : Math.signum(diff) * Double.POSITIVE_INFINITY) : diff / sdPool;
            boolean supported = expect == Expect.A_GREATER_B ? t > 2 : Math.abs(t) <= 2;
            String verdict = supported ? "GESTUETZT"
                    : (expect == Expect.A_GREATER_B && t < -2 ? "WIDERLEGT (Gegenteil gilt)" : "NICHT GESTUETZT");
            // Regel: Ein Experiment hebt hoechstens auf MODEL, nie auf FACT.
            Pal granted = supported ? Pal.MODEL : Pal.HYPOTHESIS;
            return new Result(name, hypothesis, claimed, granted, ma, mb, t, d, verdict);
        }
        static double mean(double[] x) { double s = 0; for (double v : x) s += v; return s / x.length; }
        static double var(double[] x, double m) {
            double s = 0; for (double v : x) s += (v - m) * (v - m); return s / (x.length - 1);
        }
    }

    // ---------------------------------------------------------------- 6. main
    public static void main(String[] args) {
        if (args.length > 0 && args[0].equals("demo")) { demo(); return; }
        int seeds = args.length > 0 ? Integer.parseInt(args[0]) : 200;

        List<Experiment> list = new ArrayList<>();
        list.add(new Experiment("E1 Reine Gruppen",
                "Eine reine N-Max-Max-Population lebt laenger als eine reine Greedy-Population.",
                Expect.A_GREATER_B, s -> new double[] {
                        life(play(s, rep(10, () -> new NMaxMax())), "N-Max-Max"),
                        life(play(s, rep(10, () -> new Greedy("Greedy"))), "Greedy") }));
        list.add(new Experiment("E2 Gemischte Gruppe: Lebensdauer",
                "In einer 5/5-Mischung leben N-Max-Max-Agenten laenger als Greedy-Agenten.",
                Expect.A_GREATER_B, s -> {
                    World w = play(s, mix(new NMaxMax(), new Greedy("Greedy")));
                    return new double[] { life(w, "N-Max-Max"), life(w, "Greedy") }; }));
        list.add(new Experiment("E3 N-Max-Max gegen Reziprozitaet: Ernte",
                "N-Max-Max erntet in einer 5/5-Mischung mehr als Reziprozitaet.",
                Expect.A_GREATER_B, s -> {
                    World w = play(s, mix(new NMaxMax(), new Reciprocity()));
                    return new double[] { harvest(w, "N-Max-Max"), harvest(w, "Reziprozitaet") }; }));
        list.add(new Experiment("E3b Gegen Greedy: Reziprozitaet vs N-Max-Max",
                "Gegen 5 Greedy-Agenten erntet Reziprozitaet mehr als N-Max-Max (Spiegeln schuetzt).",
                Expect.A_GREATER_B, s -> new double[] {
                        harvest(play(s, mix(new Reciprocity(), new Greedy("Greedy"))), "Reziprozitaet"),
                        harvest(play(s, mix(new NMaxMax(), new Greedy("Greedy"))), "N-Max-Max") }));
        list.add(new Experiment("E4 Negativkontrolle",
                "Zwei identische Greedy-Gruppen (nur anders benannt) unterscheiden sich nicht.",
                Expect.NO_DIFFERENCE, s -> {
                    World w = play(s, mix(new Greedy("GreedyA"), new Greedy("GreedyB")));
                    return new double[] { life(w, "GreedyA"), life(w, "GreedyB") }; }));

        System.out.println("MATRIXGAME CORE - Allmende-Arena, " + seeds + " Seeds, " + MAX_TICKS + " Ticks");
        System.out.println("=".repeat(78));
        for (Experiment e : list) {
            Result r = e.run(seeds);
            System.out.println(r.name());
            System.out.println("  Hypothese : " + r.hypothesis());
            System.out.printf("  Mittel A=%.1f  B=%.1f  t=%s  d=%s%n", r.meanA(), r.meanB(), fmt(r.t()), fmt(r.d()));
            System.out.println("  Urteil    : " + r.verdict() + "   PAL: " + r.claimed() + " -> " + r.granted());
        }
        System.out.println("=".repeat(78));
        System.out.println("Hinweise: Gewichte/Parameter sind Annahmen, nicht getunt. Urteil = Faustregel |t|>2.");
        System.out.println("Bei Streuung null (identische Agenten) sagt nur die Effektgroesse etwas.");
    }

    static String fmt(double v) { return Double.isInfinite(v) ? (v > 0 ? "+inf" : "-inf") : String.format("%.2f", v); }

    static Strategy[] rep(int n, Supplier<Strategy> f) {
        Strategy[] a = new Strategy[n];
        for (int i = 0; i < n; i++) a[i] = f.get();
        return a;
    }

    static Strategy[] mix(Strategy a, Strategy b) {
        Strategy[] x = new Strategy[10];
        for (int i = 0; i < 10; i++) x[i] = i < 5 ? a : b;
        return x;
    }

    static void demo() {
        World w = new World(42);
        for (int i = 0; i < 10; i++) w.agents.add(new Agent("" + i, i < 5 ? new NMaxMax() : new Greedy("Greedy")));
        System.out.println("Tick  Bestand  Lebende");
        while (w.tick < MAX_TICKS && w.aliveCount() > 0) {
            Simulation.run(w, Math.min(MAX_TICKS, w.tick + 5)); // setzt fort, wo die Welt steht
            System.out.printf("%4d  %7.1f  %d%n", w.tick, w.pool.amount, w.aliveCount());
        }
        for (Message m : w.log) System.out.println("Tick " + m.tick() + ": " + m.from() + " " + m.text());
    }
}


Danke, die Ausgabe passt zu meinem Testlauf. Bevor ich weiterbaue, die Interpretation, denn zwei Zeilen sehen stärker aus, als sie sind:

- **E1 und E4 (t = ±inf bzw. 0):** Die Streuung ist praktisch null, weil die Seeds nur den Startbestand und das Wachstumsrauschen variieren. Der t-Wert sagt hier nichts über Beweiskraft. Außerdem ist die 200 bei N-Max-Max der Deckel der Simulation, die Population hat also nie versagt.
- **E2 (t = −145):** Der große Betrag ist ein Artefakt der kleinen Streuung. Inhaltlich heißt das Ergebnis nicht "Greedy gewinnt". Beide Gruppen sterben mit dem Kollaps der Allmende (ca. Tick 12 bis 17). Die Greedy-Agenten überleben nur ein paar Ticks länger, weil sie vorher mehr Energie gepuffert haben.
- **E3 (beide 1125):** Das ist kein Befund, sondern eine Eigenschaft meines Entwurfs. Unter Kooperierenden verhält sich Reziprozität exakt wie N-Max-Max.
- **E3b (54 gegen 27):** Reziprozität erntet mehr, weil sie die Gier der anderen sofort spiegelt. Gemessen wird aber nur die Ernte vor dem Kollaps, nicht das Überleben.

Daraus folgt für Version 2: mehr Streuung (zufällige Startenergie), eine zusätzliche Kennzahl "in wie viel Prozent der Seeds gewinnt A", eine Metrik für die Lebensdauer der gesamten Population, N-Max-Max-T mit echter Sanktion und ein evolutionäres Turnier. Ich baue das jetzt.Ich habe die Datei **Matrixgame.java** auf Version 2 erweitert. Sie ersetzt die alte Datei, du fügst sie wie vorher in dieselbe Klasse in Eclipse ein. Neu sind:

- N-Max-Max-T mit Sanktion.
- Experimente E5 bis E7.
- Eine Gewinnquote pro Experiment ("A>B in x % der Seeds").
- Die Kennzahl, wann die ganze Population stirbt.
- Ein evolutionäres Turnier: `java Matrixgame.java turnier` oder in Eclipse unter Run Configurations mit dem Argument `turnier`.

Zum Test lief die Datei bei mir mit OpenJDK 21 über den Quelltext-Start, in Eclipse habe ich sie nicht geprüft.

## Bericht

**1. Aus Version 1 bleibt:** Reine Kooperation ist stabil (E1), gemischt wird sie ausgebeutet (E2). Spiegeln schützt besser als reines Kooperieren (E3b), und die Negativkontrolle verhält sich korrekt. N-Max-Max allein ist also keine robuste Strategie, wie schon vermutet.

**2. Neu mit Sanktion (N-Max-Max-T):** Wer mehr als das 1,5-Fache des fairen Anteils fordert, dem kürzen die Sanktionierer die Ernte um 20 % pro Sanktionierer. Jeder Sanktionierer zahlt dafür 0,3 Energie pro Ziel. Im Standardlauf sieht das stark aus: Die T-Agenten überleben alle 200 Ticks, die Greedy-Agenten verhungern nach etwa 5,5 Ticks (E5 und E6).

**3. Dieses Ergebnis hängt an meiner Annahme.** Fünf Sanktionierer mal 20 % ergeben genau 100 % Kürzung. Greedy bekommt dann nichts mehr, das ist faktisch ein Ausschluss. Ich habe die Stärke variiert:

| Kürzung pro Sanktionierer | T-Lebensdauer | Greedy-Lebensdauer | Population |
|---|---|---|---|
| 20 % | 200 | 5,5 | 200 |
| 10 % | 19,1 | 28,6 | 28,6 |
| 5 % | 11,5 | 19,6 | 19,6 |
| 3 % | 10,3 | 18,1 | 18,1 |

Bei 10 % und weniger sterben die Sanktionierer sogar früher als die Greedy-Agenten, denn sie zahlen die Kosten und ernten trotzdem weniger. Das Ergebnis ist also kein glatter Verlauf, sondern eine **Schwelle**: Sanktion hilft erst, wenn die Gesamtkürzung die Gier tatsächlich auf null bringt. Darunter verlängert sie das Leben der Gruppe nur leicht (von 16,9 auf 18 bis 29 Ticks).

**4. Turnier:** Mit Replikatordynamik und Ernte als Fitness übernimmt Greedy die Population fast vollständig (19,8 von 20 Agenten). Das gilt mit und ohne N-Max-Max-T, und die Population stirbt nach etwa 12 Ticks. Sanktion ist hier ein Gemeingut zweiter Ordnung: Wer sanktioniert, zahlt Kosten, und alle profitieren. Mit nur 4 Startagenten von 20 und Ernte als Fitness setzt sie sich nicht durch.

**5. Grenzen der Aussagekraft:**
- Die t-Werte sind weiterhin riesig oder unendlich, weil die Dynamik fast deterministisch ist. Die Gewinnquote ist die ehrlichere Zahl.
- Die zufällige Startenergie wirkt kaum, weil der Energiedeckel von 40 sie in den ersten Ticks wieder einebnet.
- E7 zeigt, dass Sanktion in reiner Kooperation nichts kostet. Das ist aber ein Entwurfseffekt: Niemand überschreitet dort die Schwelle.

## Nächste Schritte

1. **Sanktion lernbar machen:** Die Kürzung und die Schwelle sind heute fest. Der Agent könnte sie anpassen und damit auch zeigen, ab wann sich Sanktion als Strategie lohnt.
2. **Turnier mit anderer Fitness:** Statt nur der Ernte zählt die Ernte multipliziert mit dem Überleben der Gruppe, oder es gibt Gruppenselektion. Das wäre der Test, ob Kooperation evolutionär möglich ist.
3. **Größere Startpopulation von T**, um zu sehen, ab welchem Anteil T sich selbst trägt (eine kritische Masse).

Welchen davon soll ich als Nächstes bauen? Ich würde mit Nr. 2 beginnen, weil dort der entscheidende Unterschied zum bisherigen Turnier liegt.


package ordner1;
import java.util.ArrayList;
import java.util.List;
import java.util.Random;

public class BattlefieldPredictorEngine {

    // Hilfsklasse zur Demonstration der Struktur
    public static class Unit {
        public double id;
        public int team;
        public String typ;
        public String decisionAlgorithm;
        public double posX, posY, posZ;
        public double posXBefore, posYBefore, posZBefore;
        public double leben, maxLeben;
        public double damage;
        public double attackSpeed;
        public double moveSpeed;
        public double kritchance;
        public double maxSpeed;
        public double reichweite;
        public double geschicklichkeit;
        public double currentDefense;
        public int red, green, blue;
        public double size = 10;

        // Klon-Konstruktor für die Zukunftssimulation (Deep Copy)
        public Unit cloneUnit() {
            Unit copy = new Unit();
            copy.id = this.id;
            copy.team = this.team;
            copy.typ = this.typ;
            copy.decisionAlgorithm = this.decisionAlgorithm;
            copy.posX = this.posX; copy.posY = this.posY; copy.posZ = this.posZ;
            copy.posXBefore = this.posXBefore; copy.posYBefore = this.posYBefore; copy.posZBefore = this.posZBefore;
            copy.leben = this.leben; copy.maxLeben = this.maxLeben;
            copy.damage = this.damage; copy.attackSpeed = this.attackSpeed;
            copy.moveSpeed = this.moveSpeed; copy.kritchance = this.kritchance;
            copy.maxSpeed = this.maxSpeed; copy.reichweite = this.reichweite;
            copy.geschicklichkeit = this.geschicklichkeit; copy.currentDefense = this.currentDefense;
            copy.red = this.red; copy.green = this.green; copy.blue = this.blue;
            copy.size = this.size;
            return copy;
        }

        public void printWerte() {
            // Debug-Ausgabe
        }
    }

    public List<Unit> unitList = new ArrayList<>();

    // Korrigierte Init-Methode mit echtem Seed-Verhalten
    public void initSimulation() {
        unitList.clear();
        Random rand = new Random(12345); // Fester Seed = Immer gleiches Match garantiert!

        double counterId = 0;

        // --- TEAM 1 (Blau) ---
        for (int j = 0; j < 50; j++) {
            for (int i = 0; i < 20; i++) {
                Unit u1 = new Unit();
                u1.typ = "Unit";
                u1.geschicklichkeit = 100;
                u1.maxSpeed = 100;
                u1.moveSpeed = 100;
                u1.decisionAlgorithm = "Player";
                u1.team = 1;
                
                u1.posX = -rand.nextDouble() * 40;
                u1.posY =  rand.nextDouble() * 40;
                u1.posZ =  rand.nextDouble() * 40;
                u1.posXBefore = u1.posX;
                u1.posYBefore = u1.posY;
                u1.posZBefore = u1.posZ;
                
                // Kontrollierte Werte statt ungesicherter Division durch 0
                u1.maxLeben = 1.0 + rand.nextDouble() * 4.0;
                u1.leben = u1.maxLeben;
                u1.damage = 1.0 + rand.nextDouble() * 4.0;
                u1.attackSpeed = 1.0 + rand.nextDouble() * 4.0;
                u1.moveSpeed = 1.0 + rand.nextDouble() * 7.0;
                u1.kritchance = 0.2;
                u1.maxSpeed = 1.0 + rand.nextDouble() * 14.0;
                u1.reichweite = 1.0 + rand.nextDouble() * 23.0;
                u1.geschicklichkeit = 1.0 + rand.nextDouble() * 7.0;
                u1.currentDefense = 1.0 + rand.nextDouble() * 4.0;
                
                u1.decisionAlgorithm = "Wait";
                u1.red = 0; u1.green = 0; u1.blue = 255;
                u1.id = counterId++;
                unitList.add(u1);
            }
        }

        // --- TEAM 2 (Rot) ---
        for (int i = 0; i < 1000; i++) {
            Unit u2 = new Unit();
            u2.team = 2;
            u2.decisionAlgorithm = "BotUpdate";
            u2.typ = "Unit";
            if (i == 0) { u2.typ = "King"; u2.size += 5; }
            
            u2.posX = rand.nextDouble() * 40;
            u2.posY = rand.nextDouble() * 40;
            u2.posZ = rand.nextDouble() * 40;
            u2.posXBefore = u2.posX;
            u2.posYBefore = u2.posY;
            u2.posZBefore = u2.posZ;
            
            u2.maxLeben = 1.0 + rand.nextDouble() * 4.0;
            u2.leben = u2.maxLeben;
            u2.damage = 1.0 + rand.nextDouble() * 4.0;
            u2.attackSpeed = 1.0 + rand.nextDouble() * 4.0;
            u2.moveSpeed = 1.0 + rand.nextDouble() * 4.0;
            u2.kritchance = 0.2;
            u2.currentDefense = 1.0 + rand.nextDouble() * 4.0;
            u2.geschicklichkeit = 1.0 + rand.nextDouble() * 4.0;
            u2.maxSpeed = 1.0 + rand.nextDouble() * 4.0;
            u2.reichweite = 1.0 + rand.nextDouble() * 4.0;
            
            u2.decisionAlgorithm = "WAIT";
            u2.red = 255; u2.green = 0; u2.blue = 0;
            u2.id = counterId++;
            unitList.add(u2);
        }
    }

    // Zukunfts-Prognose-Engine: Simuliert X Ticks im Voraus
    public List<Unit> simulateFuture(int targetTicks) {
        // 1. Zustand klonen, damit das echte Spiel nicht verändert wird
        List<Unit> simulatedList = new ArrayList<>();
        for (Unit u : unitList) {
            simulatedList.add(u.cloneUnit());
        }

        // 2. Schnelldurchlauf der Physik- und Kampf-Ticks
        for (int t = 0; t < targetTicks; t++) {
            for (Unit u : simulatedList) {
                if (u.leben <= 0) continue;
                
                // Beispielhafter Vektor-Schritt basierend auf moveSpeed und Position
                // Hier greift die Logik der Bewegung und Kollisionsprüfung im Voraus
                u.posXBefore = u.posX;
                u.posYBefore = u.posY;
                u.posZBefore = u.posZ;
                
                // Einfache Dummy-Bewegung zur Simulation
                if (u.team == 1) {
                    u.posX += 0.1; // Team 1 drückt vor
                } else {
                    u.posX -= 0.1; // Team 2 drückt vor
                }
            }
        }
        
        return simulatedList; // Liefert den Zustand nach Ticks zurück
    }

    public void repaint() {
        // Grafisches Update
    }
}



import java.util.*;
import java.util.function.*;

/**
 * MATRIXGAME CORE v2 - eine einzige Datei, eine einzige oeffentliche Klasse.
 * NEU in v2: zufaellige Startenergie (mehr Streuung), Gewinnquote je Experiment,
 * Populations-Lebensdauer, N-Max-Max-T (mit Sanktion) und ein evolutionaeres Turnier.
 *
 * START (ohne Projekt, Java 17+; Java 21 empfohlen):
 *     java Matrixgame.java            -> alle Experimente, 200 Seeds
 *     java Matrixgame.java 500        -> 500 Seeds
 *     java Matrixgame.java demo       -> ein einzelner Lauf mit Zeitverlauf
 *     java Matrixgame.java turnier    -> evolutionaeres Turnier (mit und ohne N-Max-Max-T)
 *
 * START IN ECLIPSE:
 *     File > New > Java Project > (src-Ordner) > New > Class "Matrixgame"
 *     > gesamten Text ersetzen > Run As > Java Application.
 *
 * DIDAKTISCHER AUFBAU (von oben nach unten lesen):
 *   1. PAL         - wie sicher ist eine Aussage? FACT / MODEL / HYPOTHESIS / FICTION
 *   2. Node, Resource, Message, Agent, World - die Bausteine
 *   3. Strategie   - Entscheidungsalgorithmen (Greedy, Zufall, Reziprozitaet, N-Max-Max)
 *   4. Simulation  - die Regeln pro Tick (Zustand + Regeln + Zufall + Rueckkopplung + Zeit)
 *   5. Experiment  - eine Hypothese wird ueber viele Seeds getestet, Ergebnis = Result
 *   6. main        - die Experimente, inklusive Negativkontrolle
 *
 * SPIELREGELN: feste Seeds, jede Behauptung ist widerlegbar, Experimente heben
 * eine Hypothese hoechstens auf MODEL, niemals auf FACT.
 *
 * ERWEITERN: Neue Strategie = ein neuer Eintrag in Abschnitt 3 (siehe "NMaxMax"
 * als Vorlage). Neues Experiment = ein neuer Aufruf von "new Experiment(...)" in main.
 */
public class Matrixgame {

    // ------------------------------------------------------------------ 1. PAL
    enum Pal { FACT, MODEL, HYPOTHESIS, FICTION }

    // ------------------------------------------------------------ 2. Bausteine
    static class Node {
        final String id;
        final String label;
        Pal pal;
        Node(String id, String label, Pal pal) { this.id = id; this.label = label; this.pal = pal; }
    }

    /** Alles Begrenzte. Hier: ein nachwachsender Bestand (logistisches Wachstum). */
    static class Resource extends Node {
        double amount;
        final double capacity;
        final double growth;
        Resource(String label, double amount, double capacity, double growth) {
            super("res-" + label, label, Pal.MODEL);
            this.amount = amount; this.capacity = capacity; this.growth = growth;
        }
        /**
         * Nachhaltiger Ertrag pro Tick. Unterhalb der halben Kapazitaet folgt er dem Bestand,
         * darueber bleibt er auf dem Maximum (MSY = growth*capacity/4). Waere er auch darueber
         * bestandsabhaengig, wuerden Kooperierende bei vollem Bestand zu wenig ernten.
         */
        double sustainableYield() {
            double s = Math.min(amount, capacity / 2);
            return Math.max(0, growth * s * (1 - s / capacity));
        }
        void regrow(double noise) {
            amount += growth * noise * amount * (1 - amount / capacity);
            amount = Math.max(0, Math.min(capacity, amount));
        }
    }

    record Message(int tick, String from, String text) { }

    static class Agent extends Node {
        final Strategy strategy;
        double energy = 20;     // Ueberleben: faellt um "metabolism" pro Tick
        double harvested = 0;   // gesamte Ernte (Reichtum, ueber dem Energiedeckel)
        double lastRequest = 0; // Information, die andere sehen koennen
        int diedAt = -1;
        Agent(String id, Strategy s) { super(id, s.name() + "#" + id, Pal.MODEL); this.strategy = s; }
        boolean alive() { return diedAt < 0; }
    }

    static class World {
        final Resource pool;
        final List<Agent> agents = new ArrayList<>();
        final List<Message> log = new ArrayList<>();
        final Random rnd;
        final double metabolism = 4, maxEnergy = 40;
        int tick = 0;
        World(long seed) {
            rnd = new Random(seed);
            double start = 500 * (0.9 + 0.2 * rnd.nextDouble()); // Startbestand variiert je Seed
            pool = new Resource("Allmende", start, 1000, 0.25);
        }
        int aliveCount() { int n = 0; for (Agent a : agents) if (a.alive()) n++; return n; }
        double othersAvgRequest(Agent self) {
            double s = 0; int n = 0;
            for (Agent a : agents) if (a != self && a.alive()) { s += a.lastRequest; n++; }
            return n == 0 ? 0 : s / n;
        }
    }

    // ----------------------------------------------------------- 3. Strategien
    interface Strategy {
        String name();
        double request(Agent self, World w);
        /** Sanktioniert diese Strategie Agenten, die deutlich mehr als den fairen Anteil fordern? */
        default boolean sanctions() { return false; }
    }

    /** Fairer, nachhaltiger Anteil: 90 % des Ertrags geteilt durch die Lebenden. */
    static double coopShare(World w) {
        return 0.9 * w.pool.sustainableYield() / Math.max(1, w.aliveCount());
    }

    static class Greedy implements Strategy {
        final String name;
        Greedy(String name) { this.name = name; }
        public String name() { return name; }
        public double request(Agent self, World w) { return 20; }
    }

    static class RandomPick implements Strategy {
        public String name() { return "Zufall"; }
        public double request(Agent self, World w) { return 12 * w.rnd.nextDouble(); }
    }

    /** Spiegelt die anderen: nimmt mindestens den fairen Anteil, hoechstens wie gierig. */
    static class Reciprocity implements Strategy {
        public String name() { return "Reziprozitaet"; }
        public double request(Agent self, World w) {
            return Math.min(20, Math.max(coopShare(w), w.othersAvgRequest(self)));
        }
    }

    /**
     * N-Max-Max (vereinfachte Annahme-Version, NICHT getunt):
     * 1. Prioritaet: moeglichst viele ueberleben (N) -> nie mehr als der nachhaltige Anteil.
     * 2. Prioritaet: innerhalb dessen die eigene Ernte maximieren.
     * Es gibt weder Sanktion noch Lernen - das waere N-Max-Max-T.
     */
    static class NMaxMax implements Strategy {
        final String name;
        NMaxMax(String name) { this.name = name; }
        NMaxMax() { this("N-Max-Max"); }
        public String name() { return name; }
        public double request(Agent self, World w) { return coopShare(w); }
    }

    /**
     * N-Max-Max-T: wie N-Max-Max, aber mit SANKTION (T). Wer mehr als SANCTION_TRIGGER mal den
     * fairen Anteil fordert, dessen Ernte wird pro Sanktionierer um SANCTION_CUT gekuerzt.
     * Jeder Sanktionierer zahlt dafuer SANCTION_COST Energie pro Ziel. Parameter sind Annahmen.
     */
    static class NMaxMaxT extends NMaxMax {
        NMaxMaxT() { super("N-Max-Max-T"); }
        @Override public boolean sanctions() { return true; }
    }
    static final double SANCTION_TRIGGER = 1.5, SANCTION_CUT = 0.2, SANCTION_COST = 0.3;

    // ---------------------------------------------------------- 4. Simulation
    static class Simulation {
        static void run(World w, int maxTicks) {
            while (w.tick < maxTicks && w.aliveCount() > 0) {
                w.tick++;
                List<Agent> live = new ArrayList<>();
                for (Agent a : w.agents) if (a.alive()) live.add(a);
                double[] req = new double[live.size()];
                double total = 0;
                for (int i = 0; i < live.size(); i++) {
                    req[i] = Math.max(0, live.get(i).strategy.request(live.get(i), w));
                    total += req[i];
                }
                for (int i = 0; i < live.size(); i++) live.get(i).lastRequest = req[i]; // erst nach allen Entscheidungen
                // --- Sanktionsphase: Ernte kuerzen, Kosten fuer die Sanktionierer
                double share = coopShare(w);
                int sanctioners = 0;
                for (Agent a : live) if (a.strategy.sanctions()) sanctioners++;
                double[] eff = req.clone();
                for (int i = 0; i < live.size(); i++) {
                    Agent target = live.get(i);
                    if (sanctioners == 0 || req[i] <= SANCTION_TRIGGER * share) continue;
                    int k = sanctioners - (target.strategy.sanctions() ? 1 : 0);
                    if (k <= 0) continue;
                    eff[i] = req[i] * Math.max(0, 1 - SANCTION_CUT * k);
                    for (Agent a : live) if (a != target && a.strategy.sanctions()) a.energy -= SANCTION_COST;
                }
                total = 0;
                for (double v : eff) total += v;
                double scale = total <= w.pool.amount || total == 0 ? 1 : w.pool.amount / total;
                for (int i = 0; i < live.size(); i++) {
                    Agent a = live.get(i);
                    double got = eff[i] * scale;
                    w.pool.amount -= got;
                    a.harvested += got;
                    a.energy = Math.min(w.maxEnergy, a.energy + got - w.metabolism);
                    if (a.energy <= 0) {
                        a.diedAt = w.tick;
                        w.log.add(new Message(w.tick, a.label, "verhungert"));
                    }
                }
                w.pool.regrow(1 + 0.1 * (2 * w.rnd.nextDouble() - 1)); // Zufall + Rueckkopplung
            }
        }
    }

    // ------------------------------------------------------------ 5. Experiment
    static final int MAX_TICKS = 200;

    static World play(long seed, Strategy... who) {
        World w = new World(seed);
        for (int i = 0; i < who.length; i++) {
            Agent a = new Agent("" + i, who[i]);
            a.energy = 15 + 10 * w.rnd.nextDouble(); // Startenergie 15..25: sorgt fuer Streuung
            w.agents.add(a);
        }
        Simulation.run(w, MAX_TICKS);
        return w;
    }

    /** Metrik: mittlere Lebensdauer der Agenten einer Strategie (Ueberlebende = MAX_TICKS). */
    static double life(World w, String strat) {
        double s = 0; int n = 0;
        for (Agent a : w.agents) if (a.strategy.name().equals(strat)) { s += a.alive() ? MAX_TICKS : a.diedAt; n++; }
        return s / n;
    }

    /** Metrik: mittlere Gesamternte pro Agent einer Strategie. */
    static double harvest(World w, String strat) {
        double s = 0; int n = 0;
        for (Agent a : w.agents) if (a.strategy.name().equals(strat)) { s += a.harvested; n++; }
        return s / n;
    }

    /** Metrik: Zeitpunkt, an dem der letzte Agent stirbt (MAX_TICKS = Population ueberlebt). */
    static double popLife(World w) {
        double m = 0;
        for (Agent a : w.agents) m = Math.max(m, a.alive() ? MAX_TICKS : a.diedAt);
        return m;
    }

    enum Expect { A_GREATER_B, NO_DIFFERENCE }

    record Result(String name, String hypothesis, Pal claimed, Pal granted, double meanA, double meanB,
                  double t, double d, double winRate, String verdict) { }

    static class Experiment {
        final String name, hypothesis;
        final Pal claimed = Pal.HYPOTHESIS;
        final Expect expect;
        final LongFunction<double[]> trial; // seed -> {Wert A, Wert B}
        Experiment(String name, String hypothesis, Expect expect, LongFunction<double[]> trial) {
            this.name = name; this.hypothesis = hypothesis; this.expect = expect; this.trial = trial;
        }
        Result run(int seeds) {
            double[] a = new double[seeds], b = new double[seeds];
            for (int s = 0; s < seeds; s++) { double[] r = trial.apply(s + 1L); a[s] = r[0]; b[s] = r[1]; }
            int wins = 0; for (int i = 0; i < seeds; i++) if (a[i] > b[i]) wins++;
            double ma = mean(a), mb = mean(b), va = var(a, ma), vb = var(b, mb);
            double diff = ma - mb, se = Math.sqrt(va / seeds + vb / seeds);
            double sdPool = Math.sqrt((va + vb) / 2);
            double t = se < 1e-12 ? (Math.abs(diff) < 1e-9 ? 0 : Math.signum(diff) * Double.POSITIVE_INFINITY) : diff / se;
            // Streuung null: nur die Effektgroesse zaehlt (hier: relative Differenz)
            double d = sdPool < 1e-12 ? (Math.abs(diff) < 1e-9 ? 0 : Math.signum(diff) * Double.POSITIVE_INFINITY) : diff / sdPool;
            boolean supported = expect == Expect.A_GREATER_B ? t > 2 : Math.abs(t) <= 2;
            String verdict = supported ? "GESTUETZT"
                    : (expect == Expect.A_GREATER_B && t < -2 ? "WIDERLEGT (Gegenteil gilt)" : "NICHT GESTUETZT");
            // Regel: Ein Experiment hebt hoechstens auf MODEL, nie auf FACT.
            Pal granted = supported ? Pal.MODEL : Pal.HYPOTHESIS;
            return new Result(name, hypothesis, claimed, granted, ma, mb, t, d, 100.0 * wins / seeds, verdict);
        }
        static double mean(double[] x) { double s = 0; for (double v : x) s += v; return s / x.length; }
        static double var(double[] x, double m) {
            double s = 0; for (double v : x) s += (v - m) * (v - m); return s / (x.length - 1);
        }
    }

    // ---------------------------------------------------------------- 6. main
    public static void main(String[] args) {
        if (args.length > 0 && args[0].equals("demo")) { demo(); return; }
        if (args.length > 0 && args[0].equals("turnier")) {
            int n = args.length > 1 ? Integer.parseInt(args[1]) : 100;
            tournament(false, n, 40);
            tournament(true, n, 40);
            return;
        }
        int seeds = args.length > 0 ? Integer.parseInt(args[0]) : 200;

        List<Experiment> list = new ArrayList<>();
        list.add(new Experiment("E1 Reine Gruppen",
                "Eine reine N-Max-Max-Population lebt laenger als eine reine Greedy-Population.",
                Expect.A_GREATER_B, s -> new double[] {
                        life(play(s, rep(10, () -> new NMaxMax())), "N-Max-Max"),
                        life(play(s, rep(10, () -> new Greedy("Greedy"))), "Greedy") }));
        list.add(new Experiment("E2 Gemischte Gruppe: Lebensdauer",
                "In einer 5/5-Mischung leben N-Max-Max-Agenten laenger als Greedy-Agenten.",
                Expect.A_GREATER_B, s -> {
                    World w = play(s, mix(new NMaxMax(), new Greedy("Greedy")));
                    return new double[] { life(w, "N-Max-Max"), life(w, "Greedy") }; }));
        list.add(new Experiment("E3 N-Max-Max gegen Reziprozitaet: Ernte",
                "N-Max-Max erntet in einer 5/5-Mischung mehr als Reziprozitaet.",
                Expect.A_GREATER_B, s -> {
                    World w = play(s, mix(new NMaxMax(), new Reciprocity()));
                    return new double[] { harvest(w, "N-Max-Max"), harvest(w, "Reziprozitaet") }; }));
        list.add(new Experiment("E3b Gegen Greedy: Reziprozitaet vs N-Max-Max",
                "Gegen 5 Greedy-Agenten erntet Reziprozitaet mehr als N-Max-Max (Spiegeln schuetzt).",
                Expect.A_GREATER_B, s -> new double[] {
                        harvest(play(s, mix(new Reciprocity(), new Greedy("Greedy"))), "Reziprozitaet"),
                        harvest(play(s, mix(new NMaxMax(), new Greedy("Greedy"))), "N-Max-Max") }));
        list.add(new Experiment("E5 Sanktion: Lebensdauer gegen Greedy",
                "In einer 5/5-Mischung leben N-Max-Max-T-Agenten laenger als Greedy-Agenten.",
                Expect.A_GREATER_B, s -> {
                    World w = play(s, mix(new NMaxMaxT(), new Greedy("Greedy")));
                    return new double[] { life(w, "N-Max-Max-T"), life(w, "Greedy") }; }));
        list.add(new Experiment("E6 Sanktion: Population ueberlebt laenger",
                "Die Population (5 T + 5 Greedy) besteht laenger als (5 N-Max-Max + 5 Greedy).",
                Expect.A_GREATER_B, s -> new double[] {
                        popLife(play(s, mix(new NMaxMaxT(), new Greedy("Greedy")))),
                        popLife(play(s, mix(new NMaxMax(), new Greedy("Greedy")))) }));
        list.add(new Experiment("E7 Sanktion kostet in reiner Kooperation",
                "Eine reine N-Max-Max-T-Gruppe erntet gleich viel wie eine reine N-Max-Max-Gruppe.",
                Expect.NO_DIFFERENCE, s -> new double[] {
                        harvest(play(s, rep(10, () -> new NMaxMaxT())), "N-Max-Max-T"),
                        harvest(play(s, rep(10, () -> new NMaxMax())), "N-Max-Max") }));
        list.add(new Experiment("E4 Negativkontrolle",
                "Zwei identische Greedy-Gruppen (nur anders benannt) unterscheiden sich nicht.",
                Expect.NO_DIFFERENCE, s -> {
                    World w = play(s, mix(new Greedy("GreedyA"), new Greedy("GreedyB")));
                    return new double[] { life(w, "GreedyA"), life(w, "GreedyB") }; }));

        System.out.println("MATRIXGAME CORE - Allmende-Arena, " + seeds + " Seeds, " + MAX_TICKS + " Ticks");
        System.out.println("=".repeat(78));
        for (Experiment e : list) {
            Result r = e.run(seeds);
            System.out.println(r.name());
            System.out.println("  Hypothese : " + r.hypothesis());
            System.out.printf("  Mittel A=%.1f  B=%.1f  t=%s  d=%s  A>B in %.0f%% der Seeds%n", r.meanA(), r.meanB(), fmt(r.t()), fmt(r.d()), r.winRate());
            System.out.println("  Urteil    : " + r.verdict() + "   PAL: " + r.claimed() + " -> " + r.granted());
        }
        System.out.println("=".repeat(78));
        System.out.println("Hinweise: Gewichte/Parameter sind Annahmen, nicht getunt. Urteil = Faustregel |t|>2.");
        System.out.println("Bei Streuung null (identische Agenten) sagt nur die Effektgroesse etwas.");
    }

    /**
     * Evolutionaeres Turnier: 20 Agenten, Startanteile gleich. Pro Generation spielen alle in einer
     * Allmende; Fitness einer Strategie = mittlere Gesamternte ihrer Agenten. Der Anteil einer Strategie
     * waechst proportional zu (Anteil * Fitness) (Replikatordynamik, auf ganze Agenten gerundet).
     * Mit Wahrscheinlichkeit 30 % mutiert pro Generation ein Agent zu einer zufaelligen Strategie.
     */
    static void tournament(boolean withT, int seeds, int gens) {
        List<Strategy> types = new ArrayList<>(List.of(new Greedy("Greedy"), new RandomPick(), new Reciprocity(), new NMaxMax()));
        if (withT) types.add(new NMaxMaxT());
        int k = types.size(), N = 20;
        double[] finalCount = new double[k];
        double lifeSum = 0;
        for (int sd = 1; sd <= seeds; sd++) {
            Random rnd = new Random(sd * 7919L);
            int[] cnt = new int[k];
            for (int i = 0; i < N; i++) cnt[i % k]++;
            double lastLife = 0;
            for (int g = 0; g < gens; g++) {
                Strategy[] who = new Strategy[N];
                int p = 0;
                for (int i = 0; i < k; i++) for (int c = 0; c < cnt[i]; c++) who[p++] = types.get(i);
                World w = play(sd * 1000L + g, who);
                double[] wgt = new double[k];
                double sum = 0, lifeAll = 0;
                for (int i = 0; i < k; i++) {
                    if (cnt[i] == 0) continue;
                    wgt[i] = cnt[i] * harvest(w, types.get(i).name());
                    sum += wgt[i];
                }
                for (Agent a : w.agents) lifeAll += a.alive() ? MAX_TICKS : a.diedAt;
                lastLife = lifeAll / N;
                if (sum > 0) {
                    int[] next = new int[k];
                    double[] rem = new double[k];
                    int used = 0;
                    for (int i = 0; i < k; i++) {
                        double q = N * wgt[i] / sum;
                        next[i] = (int) q; rem[i] = q - next[i]; used += next[i];
                    }
                    while (used < N) { // Restagenten nach groesstem Rest verteilen
                        int best = 0;
                        for (int i = 1; i < k; i++) if (rem[i] > rem[best]) best = i;
                        next[best]++; rem[best] = -1; used++;
                    }
                    cnt = next;
                }
                if (rnd.nextDouble() < 0.3) { // Mutation
                    int from;
                    do { from = rnd.nextInt(k); } while (cnt[from] == 0);
                    cnt[from]--; cnt[rnd.nextInt(k)]++;
                }
            }
            for (int i = 0; i < k; i++) finalCount[i] += cnt[i];
            lifeSum += lastLife;
        }
        System.out.println("TURNIER " + (withT ? "MIT" : "OHNE") + " N-Max-Max-T: " + seeds + " Seeds, " + gens + " Generationen, " + N + " Agenten");
        for (int i = 0; i < k; i++) System.out.printf("  %-14s mittlere Endanzahl %5.1f%n", types.get(i).name(), finalCount[i] / seeds);
        System.out.printf("  mittlere Lebensdauer aller Agenten in der letzten Generation: %.1f von %d Ticks%n%n", lifeSum / seeds, MAX_TICKS);
    }

    static String fmt(double v) { return Double.isInfinite(v) ? (v > 0 ? "+inf" : "-inf") : String.format("%.2f", v); }

    static Strategy[] rep(int n, Supplier<Strategy> f) {
        Strategy[] a = new Strategy[n];
        for (int i = 0; i < n; i++) a[i] = f.get();
        return a;
    }

    static Strategy[] mix(Strategy a, Strategy b) {
        Strategy[] x = new Strategy[10];
        for (int i = 0; i < 10; i++) x[i] = i < 5 ? a : b;
        return x;
    }

    static void demo() {
        World w = new World(42);
        for (int i = 0; i < 10; i++) w.agents.add(new Agent("" + i, i < 5 ? new NMaxMax() : new Greedy("Greedy")));
        System.out.println("Tick  Bestand  Lebende");
        while (w.tick < MAX_TICKS && w.aliveCount() > 0) {
            Simulation.run(w, Math.min(MAX_TICKS, w.tick + 5)); // setzt fort, wo die Welt steht
            System.out.printf("%4d  %7.1f  %d%n", w.tick, w.pool.amount, w.aliveCount());
        }
        for (Message m : w.log) System.out.println("Tick " + m.tick() + ": " + m.from() + " " + m.text());
    }
}



package ordner5;

import javax.swing.*;
import java.awt.*;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import java.util.List;
import java.util.Locale;
import java.util.concurrent.CopyOnWriteArrayList;

public class MatrixgameLevel3 extends JPanel {

    // Thread-sichere Liste für reibungslose Zugriffe zwischen GameLoop und UI-Canvas
    public List<Unit> unitList = new CopyOnWriteArrayList<>();

    int FRAME_WIDTH = 1920;
    int FRAME_HEIGHT = 1080;

    double zoomFactor = 1.0;
    double zoomCenterX = 0;
    double zoomCenterY = 0;
    static final double ZOOM_STEP = 1.2;
    double feinheit = 50;
    double PAN_STEP = feinheit * zoomFactor;

    double globalEntropyPool = 100.0;
    long simulationTicks = 0;
    int currentLevel = 3;

    int dragStartX = -1;
    int dragStartY = -1;
    int currentMouseX = -1;
    int currentMouseY = -1;
    boolean isDragging = false;

    // STEUERUNGSSCHRAUBEN
    long pauseTime = 50;                 // Pause pro Tick in Millisekunden (z.B. 500 für Detailansicht oder 5 für Speed)
    public static double logProbability = 1.0; // 1.0 = 100% aller Moves anzeigen | 0.005 = 0.5% für Massenschlachten

    public MatrixgameLevel3() {
        setPreferredSize(new Dimension(FRAME_WIDTH, FRAME_HEIGHT));
        setBackground(Color.BLACK);

        MouseAdapter mouseHandler = new MouseAdapter() {
            @Override
            public void mousePressed(MouseEvent e) {
                if (SwingUtilities.isLeftMouseButton(e)) {
                    dragStartX = e.getX();
                    dragStartY = e.getY();
                    currentMouseX = dragStartX;
                    currentMouseY = dragStartY;
                    isDragging = false;
                } else if (SwingUtilities.isRightMouseButton(e)) {
                    int mouseX = e.getX();
                    int mouseY = e.getY();

                    double worldTargetX = (mouseX - getWidth() / 2.0) / zoomFactor - zoomCenterX;
                    double worldTargetY = (mouseY - getHeight() / 2.0) / zoomFactor - zoomCenterY;

                    Unit clickedEnemy = null;
                    for (Unit u : unitList) {
                        double sx = (zoomCenterX + u.posX) * zoomFactor + getWidth() / 2.0;
                        double sy = (zoomCenterY + u.posY) * zoomFactor + getHeight() / 2.0;
                        double radius = Math.abs(u.size);

                        if (Math.hypot(mouseX - sx, mouseY - sy) <= radius) {
                            clickedEnemy = u;
                            break;
                        }
                    }

                    int selectedCount = 0;
                    for (Unit u : unitList) {
                        if (u.isSelected) selectedCount++;
                    }

                    double commandCost = selectedCount * 1.5;
                    if (globalEntropyPool >= commandCost) {
                        globalEntropyPool -= commandCost;
                        for (Unit u : unitList) {
                            if (u.isSelected) {
                                if (clickedEnemy != null && clickedEnemy.team != u.team) {
                                    u.manualTarget = clickedEnemy;
                                    u.targetPosX = null;
                                    u.targetPosY = null;
                                    u.decisionAlgorithm = "TACTICAL_FOCUS";
                                    System.out.println("COMMAND | Unit " + u.id + " -> TACTICAL_FOCUS auf Gegner-Unit " + clickedEnemy.id);
                                } else {
                                    u.targetPosX = worldTargetX;
                                    u.targetPosY = worldTargetY;
                                    u.manualTarget = null;
                                    u.decisionAlgorithm = "TACTICAL_MOVE";
                                    System.out.println(String.format(Locale.US, "COMMAND | Unit %.0f -> TACTICAL_MOVE zu Position (%.2f, %.2f)", u.id, worldTargetX, worldTargetY));
                                }
                            }
                        }
                    } else {
                        System.out.println("WARN | Zu wenig Entropie für komplexe Befehlskette!");
                    }
                    repaint();
                }
            }

            @Override
            public void mouseDragged(MouseEvent e) {
                if (SwingUtilities.isLeftMouseButton(e)) {
                    currentMouseX = e.getX();
                    currentMouseY = e.getY();
                    if (Math.hypot(currentMouseX - dragStartX, currentMouseY - dragStartY) > 5) {
                        isDragging = true;
                    }
                    repaint();
                }
            }

            @Override
            public void mouseReleased(MouseEvent e) {
                if (SwingUtilities.isLeftMouseButton(e)) {
                    if (isDragging) {
                        double x1 = Math.min(dragStartX, currentMouseX);
                        double x2 = Math.max(dragStartX, currentMouseX);
                        double y1 = Math.min(dragStartY, currentMouseY);
                        double y2 = Math.max(dragStartY, currentMouseY);

                        if (!e.isShiftDown()) {
                            for (Unit u : unitList) u.isSelected = false;
                        }

                        for (Unit u : unitList) {
                            double sx = (zoomCenterX + u.posX) * zoomFactor + getWidth() / 2.0;
                            double sy = (zoomCenterY + u.posY) * zoomFactor + getHeight() / 2.0;
                            if (sx >= x1 && sx <= x2 && sy >= y1 && sy <= y2) {
                                u.isSelected = true;
                            }
                        }
                    } else {
                        int mouseX = e.getX();
                        int mouseY = e.getY();
                        boolean unitFound = false;

                        for (Unit u : unitList) {
                            double sx = (zoomCenterX + u.posX) * zoomFactor + getWidth() / 2.0;
                            double sy = (zoomCenterY + u.posY) * zoomFactor + getHeight() / 2.0;
                            double radius = Math.abs(u.size);

                            if (Math.hypot(mouseX - sx, mouseY - sy) <= radius) {
                                if (!e.isShiftDown()) {
                                    for (Unit other : unitList) other.isSelected = false;
                                }
                                u.isSelected = !u.isSelected;
                                unitFound = true;
                                break;
                            }
                        }
                        if (!unitFound && !e.isShiftDown()) {
                            for (Unit u : unitList) u.isSelected = false;
                        }
                    }
                    isDragging = false;
                    dragStartX = -1;
                    dragStartY = -1;
                    repaint();
                }
            }
        };

        this.addMouseListener(mouseHandler);
        this.addMouseMotionListener(mouseHandler);
    }

    public void init() {
        double counterId = 0;

        for (int j = 0; j < 2; j++) {
        	double iMax = 20+ 10 * Math.random()/Math.random();
            for (double i = 0; i < iMax; i++) {
                Unit unit = new Unit();

                if (i == 0) {
                    unit.typ = "King";
                    unit.size += 5;
                }

                unit.leben = 100.0*Math.random()/Math.random();
                unit.schaden = 10.0*Math.random()/Math.random();
                unit.reichweite = 2.0*Math.random()/Math.random();
                unit.speed = 0.5*Math.random()/Math.random();

                unit.team = j * 3;
                unit.posX = (Math.round(12 * Math.random()) - 6);
                unit.posY = (Math.round(3 * Math.random()) + 5);
                unit.posZ = (Math.round(3 * Math.random()) + 5);
                unit.blue = 255;
                unit.red = 180;
                unit.green = 180;
                if (j == 1) {
                    unit.blue = 0;
                    unit.posY = -unit.posY;
                }
                unit.id = counterId++;
                unit.decisionAlgorithm = "Nearest_ENEMI";
                unitList.add(unit);
            }
        }
        repaint();
    }

    public void panLeft() { zoomCenterX += PAN_STEP; repaint(); }
    public void panRight() { zoomCenterX -= PAN_STEP; repaint(); }
    public void panUp() { zoomCenterY += PAN_STEP; repaint(); }
    public void panDown() { zoomCenterY -= PAN_STEP; repaint(); }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        g2.setColor(Color.BLACK);
        g2.fillRect(0, 0, getWidth(), getHeight());

        for (Unit unit : unitList) {
            if (unit.leben <= 0) continue;
            double radius = unit.size;
            Color color = new Color((int) Math.min(255, Math.max(0, unit.red)),
                    (int) Math.min(255, Math.max(0, unit.green)),
                    (int) Math.min(255, Math.max(0, unit.blue)));
            double sx = (zoomCenterX + unit.posX) * zoomFactor + getWidth() / 2.0;
            double sy = (zoomCenterY + unit.posY) * zoomFactor + getHeight() / 2.0;

            g2.setColor(color);
            g2.fillOval((int) (sx - radius), (int) (sy - radius), (int) (radius * 2), (int) (radius * 2));

            if (unit.isSelected) {
                g2.setColor(Color.WHITE);
                g2.drawOval((int) (sx - radius - 2), (int) (sy - radius - 2), (int) (radius * 2 + 4), (int) (radius * 2 + 4));
            }
        }

        if (isDragging) {
            g2.setColor(new Color(0, 255, 128, 60));
            int x = Math.min(dragStartX, currentMouseX);
            int y = Math.min(dragStartY, currentMouseY);
            int w = Math.abs(currentMouseX - dragStartX);
            int h = Math.abs(currentMouseY - dragStartY);
            g2.fillRect(x, y, w, h);
            g2.setColor(new Color(0, 255, 128));
            g2.drawRect(x, y, w, h);
        }

        g2.setColor(new Color(0, 255, 128));
        g2.setFont(new Font("Monospaced", Font.BOLD, 14));
        g2.drawString("Matrixgame [SANDBOX BASIS] - Entropie-Pool: " + String.format("%.2f", globalEntropyPool), 20, 30);
        g2.drawString("Simulation Ticks: " + simulationTicks, 20, 55);

        drawUnitInspector(g2);
    }

    private void drawUnitInspector(Graphics2D g2) {
        g2.setColor(new Color(20, 20, 20, 220));
        g2.fillRect(getWidth() - 350, 20, 330, 300);
        g2.setColor(new Color(0, 255, 128));
        g2.drawRect(getWidth() - 350, 20, 330, 300);

        g2.setFont(new Font("Monospaced", Font.BOLD, 12));
        g2.drawString("=== LEVEL 3 INSPEKTOR ===", getWidth() - 330, 45);

        int yOffset = 70;
        int selectedCount = 0;
        for (Unit u : unitList) {
            if (u.isSelected) {
                selectedCount++;
                if (yOffset < 280) {
                    String info = String.format("ID: %.0f [%s] HP: %.1f", u.id, u.typ, u.leben);
                    g2.drawString(info, getWidth() - 330, yOffset);
                    g2.drawString(String.format("Alg: %s", u.decisionAlgorithm), getWidth() - 330, yOffset + 18);
                    yOffset += 40;
                }
            }
        }
        if (selectedCount == 0) {
            g2.drawString("Keine Einheit ausgewählt.", getWidth() - 330, yOffset);
            g2.drawString("Steuerung: Drag-Box / Rechtsklick", getWidth() - 330, yOffset + 20);
        } else {
            g2.drawString("Ausgewählt: " + selectedCount + " Einheiten", getWidth() - 330, 300);
        }
    }

    public void zoomIn() {
        zoomFactor *= ZOOM_STEP;
        PAN_STEP = feinheit / zoomFactor;
        repaint();
    }

    public void zoomOut() {
        zoomFactor /= ZOOM_STEP;
        PAN_STEP = feinheit / zoomFactor;
        repaint();
    }

    public void gameLoop() {
        while (true) {
            simulationTicks++;
            if (globalEntropyPool < 100.0) {
                globalEntropyPool = Math.min(100.0, globalEntropyPool + 0.08);
            }

            if (!unitList.isEmpty()) {
                int randNumber = (int) (unitList.size() * Math.random());
                Unit current = unitList.get(randNumber);

                if (current.leben > 0) {
                	System.out.println("System.currentTimeMillis() = "+System.currentTimeMillis());
                    System.out.println(String.format("--- TICK %d | ZUG: Unit %.0f (Team %d) ---", simulationTicks, current.id, current.team));

                    if ("TACTICAL_MOVE".equals(current.decisionAlgorithm) && current.targetPosX != null && current.targetPosY != null) {
                        current.moveTo(current.targetPosX, current.targetPosY, current.posZ, current.speed);
                        if (current.getDistanceTo(current.targetPosX, current.targetPosY, current.posZ) < 0.001) {
                            current.targetPosX = null;
                            current.targetPosY = null;
                            current.decisionAlgorithm = "Nearest_ENEMI";
                        }
                    } else if ("TACTICAL_FOCUS".equals(current.decisionAlgorithm) && current.manualTarget != null) {
                        current.target = current.manualTarget;
                        if (current.target.leben <= 0) {
                            current.decisionAlgorithm = "Nearest_ENEMI";
                            current.manualTarget = null;
                        } else if (current.getDistance(current.target) <= current.reichweite) {
                            current.attackieren(current.target);
                        } else {
                            current.moveTo(current.target);
                        }
                    } else {
                        if (current.target == null || current.target.leben <= 0) {
                            current.target = selectSmartTarget(current);
                        }

                        if (current.target != null) {
                            if (current.getDistance(current.target) <= current.reichweite) {
                                current.attackieren(current.target);
                                if ("King".equals(current.target.typ) && current.target.leben <= 0) {
                                    System.out.println("GAME OVER: King vernichtet!");
                                    return;
                                }
                            } else {
                                current.moveTo(current.target);
                            }
                        }
                    }
                }
            }

            repaint();

            try {
                Thread.sleep(pauseTime);
            } catch (InterruptedException e) {
                e.printStackTrace();
            }
        }
    }

    public Unit selectSmartTarget(Unit current) {
        Unit bestTarget = null;
        double minMetric = Double.MAX_VALUE;
        for (Unit ziel : unitList) {
            if (current.team != ziel.team && ziel.leben > 0) {
                double dist = current.getDistance(ziel);
                if (dist < minMetric) {
                    minMetric = dist;
                    bestTarget = ziel;
                }
            }
        }
        return bestTarget;
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            JFrame frame = new JFrame("Matrixgame Sandbox - Universelle Bot-KI & Steuerung (Ordner 5)");
            frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

