        class Synapse {
            constructor(source, target, weight) {
                this.source = source;
                this.target = target;
                this.weight = weight;
                this.particles = [];
            }

            update() {
                // Simuliere Neurotransmitter-Fluss (Entropie-Verknüpfung)
                if (Math.random() < 0.05 * this.weight) {
                    this.particles.push(0); // Partikel startet bei 0 (Source)
                }
                for (let i = 0; i < this.particles.length; i++) {
                    this.particles[i] += 0.02; // Geschwindigkeit
                    if (this.particles[i] >= 1) {
                        this.particles.splice(i, 1);
                        i--;
                        // Ziel-Neuron aktivieren & Punkte sammeln
                        this.target.activation = 1;
                        if(this.target.type === 'output') {
