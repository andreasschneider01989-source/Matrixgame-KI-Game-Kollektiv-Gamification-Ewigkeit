                for (let p of this.particles) {
                    let curX = this.source.x + (this.target.x - this.source.x) * p;
                    let curY = this.source.y + (this.target.y - this.source.y) * p;
                    ctx.beginPath();
                    ctx.arc(curX, curY, 4, 0, Math.PI * 2);
                    ctx.fillStyle = '#58a6ff';
