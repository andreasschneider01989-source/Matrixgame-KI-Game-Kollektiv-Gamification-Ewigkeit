import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.Random;

/**
 * MatrixGame v2 – Kollektiv-Simulator (Version 2 der Ensemble-Architektur)
 *
 * Kompilieren und starten:
 *   javac MatrixGame_v2.java
 *   java MatrixGame_v2
 *
 * Voraussetzungen: Java 17+. Keine externen Bibliotheken.
 *
 * Struktur (anknüpfend an Ration A bis D):
 *   - State:   intrinsische Motivation messbar (Freude, Interesse, Disziplin, ...)
 *   - World:   eine simulierte Welt mit einem Akteur, Seed-gesteuert (Ration A)
 *   - Ensemble: N parallele Zukünfte pro Strategie, Aggregation (Ration D)
 *   - Insights:  extrahierte Kennzahlen (Vorhersage-Güte, Überlebensrate, ...)
 *
 * Alle Zahlen und Gewichte sind explizite Modellannahmen – keine empirisch
 * validierten psychologischen Gesetze. Jede Annahme ist widerlegbar und
 * austauschbar. Das ist der wissenschaftliche Kern.
 */
public class MatrixGame_v2 {

    // ======================= Konfiguration =======================
    static final int   WORLDS_PER_STRATEGY = 64;   // Größe des Ensembles
    static final int   TURNS               = 40;    // Runden pro Welt
    static final double ENTROPY            = 0.15; // Störungsstärke (0 = deterministisch)
    static final long  SEED_BASE           = 42L;  // reproduzierbare Basis

    // ======================= State =======================
    /**
     * Intrinsische Motivation einer Unit, messbar, Bereich 0..10.
     * Felder bewusst als double: kontinuierlich, optimierbar (Newton,
     * multiplikative Updates, Ensemble-Mittelung).
     */
    static final class State {
        double joy          = 5.0;  // Freude
        double happiness    = 5.0;  // Wohlbefinden
        double interest     = 5.0;  // Interesse
        double motivation   = 5.0;  // Handlungsbereitschaft
        double discipline   = 5.0;  // Dranbleiben
        double autonomy     = 5.0;  // Selbstbestimmung
        double competence   = 5.0;  // Wirksamkeit
        double vitality     = 5.0;  // Energie
        double goalProgress = 0.0;  // Zielfortschritt
        double cooperation  = 5.0;  // Kollektiv-Anschluss

        static final String[] FIELDS = {
            "joy","happiness","interest","motivation","discipline",
            "autonomy","competence","vitality","goalProgress","cooperation"
        };

        double get(String f) {
            return switch (f) {
                case "joy" -> joy; case "happiness" -> happiness;
                case "interest" -> interest; case "motivation" -> motivation;
                case "discipline" -> discipline; case "autonomy" -> autonomy;
                case "competence" -> competence; case "vitality" -> vitality;
                case "goalProgress" -> goalProgress; default -> cooperation;
            };
        }

        void set(String f, double v) {
            switch (f) {
                case "joy" -> joy = v; case "happiness" -> happiness = v;
                case "interest" -> interest = v; case "motivation" -> motivation = v;
                case "discipline" -> discipline = v; case "autonomy" -> autonomy = v;
                case "competence" -> competence = v; case "vitality" -> vitality = v;
                case "goalProgress" -> goalProgress = v; default -> cooperation = v;
            }
        }

        void normalize() {
            for (String f : FIELDS) set(f, clamp(get(f)));
        }

        /** Modellkennzahl des Gesamtantriebs (Gewichte = Annahme). */
        double intrinsicDrive() {
            return 0.20 * interest + 0.20 * joy + 0.15 * autonomy
                 + 0.15 * competence + 0.15 * vitality + 0.15 * happiness;
        }

        State copy() {
            State s = new State();
            for (String f : FIELDS) s.set(f, get(f));
            return s;
        }
    }

    // ======================= Aktionen & Strategien =======================
    enum Action { LEARN, REST, COOPERATE, EXPLORE }

    enum Strategy { BALANCED, GRIND, SOCIAL, CURIOUS }

    /** Transparente Entscheidungsschicht – später durch lernende Agenten ersetzbar. */
    static Action chooseAction(Strategy st, State s) {
        if (s.vitality < 3.5) return Action.REST;  // Überlebensschutz zuerst
        return switch (st) {
            case GRIND   -> Action.LEARN;
            case SOCIAL  -> Action.COOPERATE;
            case CURIOUS -> Action.EXPLORE;
            default -> {
                if (s.interest < 4.5)   yield Action.EXPLORE;
                if (s.cooperation < 5.0) yield Action.COOPERATE;
                yield Action.LEARN;
            }
        };
    }

    // ======================= Welt =======================
    /** Eine simulierte Welt: ein Akteur, eigener Random-Seed (Ration A). */
    static final class World {
        final State state = new State();
        final Random rnd;
        final double entropy;
        double resources = 10.0;
        int turn = 0;
        boolean survived = true;
        final Map<Action, Integer> actionCounts = new HashMap<>();
        final List<Double> driveHistory = new ArrayList<>();

        World(long seed, double entropy) {
            this.rnd = new Random(seed);
            this.entropy = entropy;
            // Startzustand: leicht gestörte Neutralität (Ensemble-Diversität)
            for (String f : State.FIELDS) {
                if (!f.equals("goalProgress"))
                    state.set(f, clamp(5.0 + (rnd.nextDouble() - 0.5) * entropy * 10.0));
            }
            for (Action a : Action.values()) actionCounts.put(a, 0);
        }

        void tick(Action a) {
            turn++;
            resources -= 0.15 + rnd.nextDouble() * 0.1;
            actionCounts.merge(a, 1, Integer::sum);

            switch (a) {
                case LEARN -> {
                    state.goalProgress += 1.2;
                    state.competence += 0.5;
                    state.vitality -= 0.7 + entropy * rnd.nextDouble() * 0.6;
                    state.joy += 0.2;
                }
                case REST -> {
                    state.vitality += 1.0;
                    state.joy += 0.3;
                    state.happiness += 0.2;
                }
                case COOPERATE -> {
                    state.cooperation += 0.7;
                    state.goalProgress += 0.6;
                    state.joy += 0.3;
                    state.happiness += 0.1 * (state.cooperation / 10.0);
                }
                case EXPLORE -> {
                    state.interest += 0.8;
                    state.autonomy += 0.3;
                    state.goalProgress += 0.4;
                    state.vitality -= 0.3;
                }
            }

            // randEntropie: gelegentliche Störung eines zufälligen Feldes
            if (rnd.nextDouble() < entropy * 0.15) {
                String f = State.FIELDS[rnd.nextInt(State.FIELDS.length)];
                state.set(f, state.get(f) + (rnd.nextDouble() - 0.5) * 3.0 * entropy);
            }

            // Motivation reagiert modellhaft auf Interesse, Kompetenz, Energie
            state.motivation = 0.4 * state.interest + 0.3 * state.competence + 0.3 * state.vitality;

            state.normalize();
            resources = clamp(resources);

            driveHistory.add(state.intrinsicDrive());

            if (state.vitality <= 0.05 || resources <= 0.05) survived = false;
        }
    }

    // ======================= Ensemble (Ration D) =======================
    /**
     * Aggregierte Kennzahlen über N parallele Zukünfte einer Strategie.
     * Dies ist die "kollektive Strategie-Bibliothek": pro Feld wird der
     * Durchschnitt (und später: der beste Welt-Parametersatz) festgehalten.
     */
    static final class Ensemble {
        final Strategy strategy;
        final int worlds;
        final double avgDrive, avgGoal, avgCooperation, avgVitality, avgJoy;
        final double survivalRate;
        final double driveVariance;      // Vorhersage-Güte: niedrig = berechenbar
        final Map<String, Double> fieldAverages = new HashMap<>();

        Ensemble(Strategy st, List<World> ws) {
            this.strategy = st;
            this.worlds = ws.size();
            this.avgDrive        = ws.stream().mapToDouble(w -> w.state.intrinsicDrive()).average().orElse(0);
            this.avgGoal         = ws.stream().mapToDouble(w -> w.state.goalProgress).average().orElse(0);
            this.avgCooperation   = ws.stream().mapToDouble(w -> w.state.cooperation).average().orElse(0);
            this.avgVitality      = ws.stream().mapToDouble(w -> w.state.vitality).average().orElse(0);
            this.avgJoy           = ws.stream().mapToDouble(w -> w.state.joy).average().orElse(0);
            this.survivalRate     = ws.stream().filter(w -> w.survived).count() / (double) worlds;
            // Varianz des Endantriebs: Maß für Berechenbarkeit der Trajektorien
            this.driveVariance    = ws.stream()
                .mapToDouble(w -> { double d = w.state.intrinsicDrive() - avgDrive; return d * d; })
                .average().orElse(0);
            for (String f : State.FIELDS)
                fieldAverages.put(f, ws.stream().mapToDouble(w -> w.state.get(f)).average().orElse(0));
        }

        /** Kollektive Kennzahl: Antrieb × Überlebensrate. */
        double score() { return avgDrive * survivalRate; }
    }

    // ======================= Simulation & Insights =======================
    static Ensemble runEnsemble(Strategy st, int n, long seedBase, double entropy, int turns) {
        List<World> worlds = new ArrayList<>();
        for (int i = 0; i < n; i++) {
            World w = new World(seedBase + i * 7919L, entropy);
            for (int t = 0; t < turns && w.survived; t++)
                w.tick(chooseAction(st, w.state));
            worlds.add(w);
        }
        return new Ensemble(st, worlds);
    }

    /** extractInsights: Ration A1 – wenige, klare Zahlen pro Strategie. */
    static void printInsights(Ensemble e) {
        System.out.printf(Locale.GERMANY,
            "%nStrategie: %-9s | Welten: %d%n" +
            "  Ø Antrieb %.2f | Ø Ziel %.2f | Ø Kooperation %.2f | Ø Vitalität %.2f%n" +
            "  Überlebensrate %.1f%% | Score %.2f | Antriebs-Varianz %.3f (niedrig = berechenbar)%n",
            e.strategy, e.worlds,
            e.avgDrive, e.avgGoal, e.avgCooperation, e.avgVitality,
            e.survivalRate * 100, e.score(), e.driveVariance);
        StringBuilder sb = new StringBuilder("  End-State: ");
        for (String f : State.FIELDS)
            sb.append(String.format(Locale.GERMANY, "%s=%.2f ", f, e.fieldAverages.get(f)));
        System.out.println(sb);
    }

    static double clamp(double v) { return Math.max(0.0, Math.min(10.0, v)); }

    // ======================= main =======================
    public static void main(String[] args) {
        System.out.println("=== MatrixGame v2 – Kollektiv-Simulator ===");
        System.out.printf(Locale.GERMANY,
            "Ensemble: %d Welten/Strategie | %d Runden | Entropie %.2f | Seed-Basis %d%n",
            WORLDS_PER_STRATEGY, TURNS, ENTROPY, SEED_BASE);
        System.out.println("Hinweis: Alle Regeln und Gewichte sind Startannahmen, "
            + "keine empirisch validierten Gesetze.");

        Strategy[] all = Strategy.values();
        Ensemble[] results = new Ensemble[all.length];
        long t0 = System.currentTimeMillis();
        for (int i = 0; i < all.length; i++)
            results[i] = runEnsemble(all[i], WORLDS_PER_STRATEGY,
                SEED_BASE + (i + 1) * 1_000_003L, ENTROPY, TURNS);
        long ms = System.currentTimeMillis() - t0;

        for (Ensemble e : results) printInsights(e);

        // Ranking nach kollektiver Kennzahl
        System.out.println("%n=== Ranking (Score = Ø Antrieb × Überlebensrate) ===".replace("%n", "\n"));
        java.util.Arrays.stream(results)
            .sorted((a, b) -> Double.compare(b.score(), a.score()))
            .forEach(e -> System.out.printf(Locale.GERMANY,
                "  %-9s Score %.2f%n", e.strategy, e.score()));

        System.out.printf(Locale.GERMANY,
            "%nRechenzeit gesamt: %d ms (%.2f ms/Welt)%n",
            ms, ms / (double) (WORLDS_PER_STRATEGY * all.length));

        // Nächste Schritte (Ration D): erfolgreiche Parameter der besten Strategie
        // als Startwerte der nächsten Generation zurück schreiben -> Evolutionsschleife.
        System.out.println("\nNächste Ration: kollektive Strategie-Bibliothek – "
            + "Bestwelten der Gewinnerstrategie als Startzustand von Generation 2 verwenden.");
    }
}



import java.util.ArrayList;
import java.util.Arrays;
import java.util.HashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.Random;

/**
 * MatrixGame v3 – Kombinierter Kollektiv-Simulator
 *
 * Kompilieren und starten:
 *   javac MatrixGame_v3.java
 *   java MatrixGame_v3
 *
 * Voraussetzungen: Java 17+. Keine externen Bibliotheken.
 *
 * Vereinigt vier Ebenen (aus dem Python-Notebook + MatrixGame v2):
 *   1. State:        intrinsische Motivation messbar (0..10)
 *   2. NeuroLayer:   Neurotransmitter-Dynamik mit Sättigung und
 *                    Homöostase (Rezeptor-Downregulation = Toleranz)
 *   3. EpochLayer:   Zivilisations-Epochen mit Widerstand, Kohäsion,
 *                    Ressourcen-Regeneration und Entropie-Skalierung
 *   4. Evolution:   Generationen-Schleife – Bestwelten erben ihre
 *                    Startzustände an die nächste Generation (mutationiert)
 *
 * Multi-Unit: Jede Welt enthält N Units. Kooperation einer Unit
 * stärkt die cooperation aller anderen (kollektive Kopplung).
 *
 * Alle Zahlen und Gewichte sind explizite Modellannahmen – keine
 * empirisch validierten Gesetze, keine medizinische Aussagekraft.
 */
public class MatrixGame_v3 {

    // ======================= Konfiguration =======================
    static final int    WORLDS_PER_STRATEGY = 32;   // Ensemble-Größe
    static final int    UNITS_PER_WORLD      = 8;     // kollektive Kopplung
    static final int    TURNS                = 60;    // Runden pro Welt
    static final int    GENERATIONS          = 5;     // Evolutions-Schleife
    static final double ENTROPY              = 0.20;  // globale Störung
    static final double START_RESOURCES       = 10.0;
    static final double SELECT_TOP_FRACTION   = 0.25; // Bestwelten erben
    static final long   SEED_BASE             = 42L;

    // ======================= State =======================
    static final class State {
        double joy = 5, happiness = 5, interest = 5, motivation = 5,
               discipline = 5, autonomy = 5, competence = 5,
               vitality = 5, goalProgress = 0, cooperation = 5;

        static final String[] FIELDS = {
            "joy","happiness","interest","motivation","discipline",
            "autonomy","competence","vitality","goalProgress","cooperation"};

        double get(String f) {
            return switch (f) {
                case "joy" -> joy; case "happiness" -> happiness;
                case "interest" -> interest; case "motivation" -> motivation;
                case "discipline" -> discipline; case "autonomy" -> autonomy;
                case "competence" -> competence; case "vitality" -> vitality;
                case "goalProgress" -> goalProgress; default -> cooperation;
            };
        }
        void set(String f, double v) {
            switch (f) {
                case "joy" -> joy = v; case "happiness" -> happiness = v;
                case "interest" -> interest = v; case "motivation" -> motivation = v;
                case "discipline" -> discipline = v; case "autonomy" -> autonomy = v;
                case "competence" -> competence = v; case "vitality" -> vitality = v;
                case "goalProgress" -> goalProgress = v; default -> cooperation = v;
            }
        }
        void normalize() { for (String f : FIELDS) set(f, clamp(get(f))); }

        double intrinsicDrive() {
            return 0.20 * interest + 0.20 * joy + 0.15 * autonomy
                 + 0.15 * competence + 0.15 * vitality + 0.15 * happiness;
        }
        State copy() { State s = new State(); for (String f : FIELDS) s.set(f, get(f)); return s; }
        double avg() {
            double sum = 0; for (String f : FIELDS) sum += get(f);
            return sum / FIELDS.length;
        }
    }

    // ======================= NeuroLayer (aus Python-Notebook portiert) =======================
    /**
     * Neurotransmitter-Dynamik: Sättigungskurve (Sigmoid), Aufbau,
     * Homöostase. Wichtig: Die Downregulation modelliert Toleranz –
     * dauerhaft hohe Level senken die Wirkung (wie im Notebook).
     * Rein mathematisches Modell, keine Therapieempfehlung.
     */
    static final class NeuroLayer {
        double neurotransmitter = 1.0;
        double reuptakeInhibition = 0.0;
        double persistence = 1.0;

        /** Sigmoid-Sättigung des Effekts. */
        double boost() {
            return 1.0 / (1.0 + Math.exp(-(neurotransmitter * 2.0 - 1.0)));
        }

        void tick(double driveStimulus) {
            // Aufbau steigt mit Antrieb (Aktivität setzt Transmitter frei)
            neurotransmitter += 0.05 + 0.02 * (driveStimulus / 10.0);
            // Reuptake-Hemmung baut sich langsam auf, Homöostase gegen
            reuptakeInhibition = Math.min(0.9, reuptakeInhibition + 0.005);
            // Homöostase: Downregulation bei dauerhaft hohem Level
            if (neurotransmitter > 2.0) {
                persistence *= 0.98;               // Toleranzbildung
                neurotransmitter -= 0.05;           // Gegenregulation
            } else if (neurotransmitter < 0.5) {
                persistence = Math.min(1.0, persistence * 1.01); // Erholung
            }
        }

        /** Effektiver Antrieb: Basis × Neuro-Verstärkung × Persistenz. */
        double modulate(double baseDrive) {
            return clamp(baseDrive * (1.0 + boost() * 0.15) * persistence, 0, 15);
        }
    }

    // ======================= Epochen (aus dem Notebook portiert) =======================
    enum Epoch {
        PALEOLITHIC (0.30, 0.30, 0.15, 0.30), // techLimit, complexity, resRegen, entropyScale
        NEOLITHIC   (0.60, 0.50, 0.30, 0.45),
        INDUSTRIAL  (0.85, 0.70, 0.55, 0.75),
        DIGITAL     (1.00, 0.90, 0.85, 1.00);

        final double techLimit, complexity, resourceRegen, entropyScale;
        Epoch(double t, double c, double r, double e) {
            techLimit = t; complexity = c; resourceRegen = r; entropyScale = e;
        }
        Epoch next() { return this == PALEOLITHIC ? NEOLITHIC
                       : this == NEOLITHIC ? INDUSTRIAL
                       : this == INDUSTRIAL ? DIGITAL : DIGITAL; }
    }

    // ======================= Aktionen & Strategien =======================
    enum Action { LEARN, REST, COOPERATE, EXPLORE }
    enum Strategy { BALANCED, GRIND, SOCIAL, CURIOUS }

    static Action chooseAction(Strategy st, State s) {
        if (s.vitality < 3.5) return Action.REST;
        return switch (st) {
            case GRIND   -> Action.LEARN;
            case SOCIAL  -> Action.COOPERATE;
            case CURIOUS -> Action.EXPLORE;
            default -> {
                if (s.interest < 4.5)     yield Action.EXPLORE;
                if (s.cooperation < 5.0) yield Action.COOPERATE;
                yield Action.LEARN;
            }
        };
    }

    // ======================= Unit =======================
    static final class Unit {
        final State state = new State();
        final NeuroLayer neuro = new NeuroLayer();
        final Map<Action, Integer> actionCounts = new HashMap<>();

        Unit(Random rnd, double entropy, State inherit) {
            for (Action a : Action.values()) actionCounts.put(a, 0);
            if (inherit != null) {
                for (String f : State.FIELDS) {
                    // Vererbung + Mutation: evolutionäre Streuung
                    state.set(f, clamp(inherit.get(f) + (rnd.nextDouble() - 0.5) * entropy * 4.0));
                }
            } else {
                for (String f : State.FIELDS)
                    if (!f.equals("goalProgress"))
                        state.set(f, clamp(5.0 + (rnd.nextDouble() - 0.5) * entropy * 10.0));
            }
        }

        double effectiveDrive() { return neuro.modulate(state.intrinsicDrive()); }
    }

    // ======================= Welt =======================
    static final class World {
        final List<Unit> units = new ArrayList<>();
        final Random rnd;
        Epoch epoch = Epoch.PALEOLITHIC;
        double resources = START_RESOURCES;
        double socialCohesion = 0.5;
        int turn = 0;
        boolean survived = true;
        int epochTransitionTurn = -1;

        World(long seed, double entropy, List<State> inherited) {
            this.rnd = new Random(seed);
            for (int i = 0; i < UNITS_PER_WORLD; i++) {
                State inh = inherited == null ? null
                          : inherited.get(rnd.nextInt(inherited.size()));
                units.add(new Unit(rnd, entropy, inh));
            }
        }

        void tick(double entropy) {
            turn++;
            double scaledEntropy = entropy * epoch.entropyScale;
            int cooperators = 0;

            for (Unit u : units) {
                Action a = chooseAction(Strategy.BALANCED, u.state); // Strategie wird über Ensemble gesetzt
                u.actionCounts.merge(a, 1, Integer::sum);
                resources -= 0.12 + rnd.nextDouble() * 0.08;

                switch (a) {
                    case LEARN -> {
                        u.state.goalProgress += 1.0;
                        u.state.competence += 0.4;
                        u.state.vitality -= 0.6 + scaledEntropy * rnd.nextDouble() * 0.5;
                        u.state.joy += 0.2;
                    }
                    case REST -> {
                        u.state.vitality += 0.9;
                        u.state.joy += 0.3;
                        u.state.happiness += 0.2;
                    }
                    case COOPERATE -> {
                        u.state.cooperation += 0.5;
                        u.state.goalProgress += 0.5;
                        u.state.joy += 0.3;
                        cooperators++;
                    }
                    case EXPLORE -> {
                        u.state.interest += 0.7;
                        u.state.autonomy += 0.3;
                        u.state.goalProgress += 0.35;
                        u.state.vitality -= 0.3;
                    }
                }

                // randEntropie: Störung eines zufälligen Feldes
                if (rnd.nextDouble() < scaledEntropy * 0.12) {
                    String f = State.FIELDS[rnd.nextInt(State.FIELDS.length)];
                    u.state.set(f, u.state.get(f) + (rnd.nextDouble() - 0.5) * 2.5 * scaledEntropy);
                }

                u.state.motivation = 0.4 * u.state.interest + 0.3 * u.state.competence + 0.3 * u.state.vitality;
                u.state.normalize();
                u.neuro.tick(u.state.intrinsicDrive());
            }

            // === Kollektive Kopplung: Kooperation stärkt die Gruppe ===
            if (cooperators > 0) {
                double spillover = 0.08 * cooperators / (double) units.size();
                for (Unit u : units) {
                    u.state.cooperation = clamp(u.state.cooperation + spillover);
                    u.state.happiness  = clamp(u.state.happiness + spillover * 0.5);
                }
                socialCohesion = Math.min(1.0, socialCohesion + 0.02 * cooperators / (double) units.size());
            }

            resources = clamp(resources + epoch.resourceRegen * 0.25 - 0.10);
            if (resources <= 0.05) resources = 0.05;

            // === Epochen-Logik (portiert) ===
            double avgGoal = units.stream().mapToDouble(u -> u.state.goalProgress).average().orElse(0) / 10.0;
            double resistance = Math.max(0, epoch.complexity - 0.3 * socialCohesion);
            if (avgGoal > epoch.techLimit && resistance < 0.75 && epoch != Epoch.DIGITAL) {
                epoch = epoch.next();
                epochTransitionTurn = turn;
                socialCohesion = Math.max(0.2, socialCohesion - 0.15); // Umbruch kostet Kohäsion
            }

            if (units.stream().anyMatch(u -> u.state.vitality <= 0.05)) survived = false;
        }

        double worldScore() {
            double drive = units.stream().mapToDouble(Unit::effectiveDrive).average().orElse(0);
            return drive * (survived ? 1.0 : 0.5) + units.stream()
                .mapToDouble(u -> u.state.goalProgress).average().orElse(0) * 0.3;
        }
    }

    // ======================= Ensemble + Evolution =======================
    static final class EnsembleStats {
        double avgDrive, avgGoal, avgCoop, avgHappiness, avgNeuroPersist;
        double survivalRate; Epoch finalEpoch; double epochFractionDigital;
        double score, driveVariance;
        List<State> bestStates = new ArrayList<>();

        void print(String label) {
            System.out.printf(Locale.GERMANY,
                "%n%s%n" +
                "  Ø Effektiver Antrieb %.2f | Ø Ziel %.2f | Ø Kooperation %.2f | Ø Glück %.2f%n" +
                "  Überlebensrate %.1f%% | Score %.2f | Antriebs-Varianz %.3f%n" +
                "  Ø Neuro-Persistenz %.3f (Toleranz sichtbar ab < 0,95) | Häufigste End-Epoche: %s%n",
                label, avgDrive, avgGoal, avgCoop, avgHappiness,
                survivalRate * 100, score, driveVariance,
                avgNeuroPersist, finalEpoch);
        }
    }

    static EnsembleStats runEnsemble(Strategy st, int n, long seedBase,
                                     double entropy, int turns, List<State> inherited) {
        List<World> worlds = new ArrayList<>();
        for (int i = 0; i < n; i++) {
            World w = new World(seedBase + i * 7919L, entropy, inherited);
            for (int t = 0; t < turns && w.survived; t++) w.tick(entropy);
            worlds.add(w);
        }
        EnsembleStats s = new EnsembleStats();
        s.avgDrive     = worlds.stream().flatMap(w -> w.units.stream()).mapToDouble(Unit::effectiveDrive).average().orElse(0);
        s.avgGoal      = worlds.stream().flatMap(w -> w.units.stream()).mapToDouble(u -> u.state.goalProgress).average().orElse(0);
        s.avgCoop      = worlds.stream().flatMap(w -> w.units.stream()).mapToDouble(u -> u.state.cooperation).average().orElse(0);
        s.avgHappiness = worlds.stream().flatMap(w -> w.units.stream()).mapToDouble(u -> u.state.happiness).average().orElse(0);
        s.avgNeuroPersist = worlds.stream().flatMap(w -> w.units.stream()).mapToDouble(u -> u.neuro.persistence).average().orElse(1);
        s.survivalRate = worlds.stream().filter(w -> w.survived).count() / (double) n;
        s.score        = worlds.stream().mapToDouble(World::worldScore).average().orElse(0);
        s.driveVariance = worlds.stream().mapToDouble(World::worldScore)
            .map(d -> { double x = d - s.score; return x * x; }).average().orElse(0);
        Map<Epoch, Integer> epochCount = new HashMap<>();
        for (World w : worlds) epochCount.merge(w.epoch, 1, Integer::sum);
        s.finalEpoch = epochCount.entrySet().stream()
            .max(Map.Entry.comparingByValue()).map(Map.Entry::getKey).orElse(Epoch.PALEOLITHIC);
        s.epochFractionDigital = epochCount.getOrDefault(Epoch.DIGITAL, 0) / (double) n;
        // Bestwelten für die nächste Generation sammeln
        worlds.stream().sorted((a, b) -> Double.compare(b.worldScore(), a.worldScore()))
            .limit(Math.max(1, (int) (n * SELECT_TOP_FRACTION)))
            .forEach(w -> w.units.stream().limit(2).forEach(u -> s.bestStates.add(u.state.copy())));
        return s;
    }

    static double clamp(double v) { return Math.max(0.0, Math.min(10.0, v)); }

    // ======================= main =======================
    public static void main(String[] args) {
        System.out.println("=== MatrixGame v3 – Kollektiv + Epochen + Neuro + Evolution ===");
        System.out.printf(Locale.GERMANY,
            "Ensemble: %d Welten × %d Units | %d Runden | %d Generationen | Entropie %.2f%n",
            WORLDS_PER_STRATEGY, UNITS_PER_WORLD, TURNS, GENERATIONS, ENTROPY);
        System.out.println("Hinweis: Modellannahmen, keine validierten Gesetze. "
            + "Strategie-Vererbung: Bestwelten starten die nächste Generation.");

        Strategy[] strategies = Strategy.values();
        Map<Strategy, List<State>> libraries = new HashMap<>();   // kollektive Strategie-Bibliothek

        for (int gen = 1; gen <= GENERATIONS; gen++) {
            System.out.printf("%n========== GENERATION %d ==========%n", gen);
            for (Strategy st : strategies) {
                EnsembleStats e = runEnsemble(st, WORLDS_PER_STRATEGY,
                    SEED_BASE + gen * 100_003L + st.ordinal() * 1_000_003L,
                    ENTROPY, TURNS,
                    libraries.get(st));  // Vererbung aus letzter Generation
                e.print("Strategie: " + st);
                libraries.put(st, e.bestStates);  // Bibliothek aktualisieren
            }
        }

        System.out.println("%n=== Beobachtungshinweise ===".replace("%n", "\n"));
        System.out.println("- Neuro-Persistenz sinkt über Generationen? -> Toleranz-Dynamik greift.");
        System.out.println("- End-Epochen verschieben sich nach DIGITAL? -> kollektiver Aufstieg messbar.");
        System.out.println("- Scores steigen über Generationen? -> Evolutionsschleife funktioniert.");
        System.out.println("- Höhere ENTROPY: zeigt, welche Strategie unter Störung robust bleibt.");
    }
}




package ordner1;


import java.awt.BorderLayout;
import java.awt.Color;
import java.awt.Dimension;
