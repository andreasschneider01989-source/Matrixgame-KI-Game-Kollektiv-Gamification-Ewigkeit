import React, { useMemo, useState } from "react";
import {
  LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, Legend,
  BarChart, Bar, ResponsiveContainer, RadarChart, PolarAngleAxis,
  PolarRadiusAxis, Radar as RechartsRadar,
} from "recharts";

// ---------- Reproduzierbarer Zufall (Seed-basiert, wie java.util.Random) ----------
function mulberry32(seed: number) {
  let a = seed >>> 0;
  return function () {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// ---------- State: intrinsische Motivation, messbar, 0..10 ----------
type StateT = {
  joy: number; happiness: number; interest: number; motivation: number;
  discipline: number; autonomy: number; competence: number;
  vitality: number; goalProgress: number; cooperation: number;
};

const FIELDS: (keyof StateT)[] = [
  "joy", "happiness", "interest", "motivation",
  "discipline", "autonomy", "competence", "vitality",
  "goalProgress", "cooperation",
];

const FIELD_LABELS: Record<string, string> = {
  joy: "Freude", happiness: "Wohlbefinden", interest: "Interesse",
  motivation: "Motivation", discipline: "Disziplin", autonomy: "Autonomie",
  competence: "Kompetenz", vitality: "Vitalität", goalProgress: "Zielfortschritt",
  cooperation: "Kooperation",
};

function initState(rand: () => number, entropy: number): StateT {
  const jitter = () => 5 + (rand() - 0.5) * entropy * 10;
  const s: any = {};
  for (const f of FIELDS) s[f] = f === "goalProgress" ? 0 : jitter();
  return s as StateT;
}

const clamp = (v: number) => Math.max(0, Math.min(10, v));

type Action = "LEARN" | "REST" | "COOPERATE" | "EXPLORE";
const ACTIONS: Action[] = ["LEARN", "REST", "COOPERATE", "EXPLORE"];
const ACTION_LABELS: Record<Action, string> = {
  LEARN: "Lernen", REST: "Erholen", COOPERATE: "Kooperieren", EXPLORE: "Erkunden",
};

type Strategy = "balanced" | "grind" | "social" | "curious";

const STRATEGY_LABELS: Record<Strategy, string> = {
  balanced: "Ausgewogen", grind: "Ziel-Fokus", social: "Kollektiv-Fokus", curious: "Entdecker",
};

function chooseAction(strategy: Strategy, s: StateT): Action {
  if (s.vitality < 3.5) return "REST";
  switch (strategy) {
    case "grind": return "LEARN";
    case "social": return "COOPERATE";
    case "curious": return "EXPLORE";
    default:
      if (s.interest < 4.5) return "EXPLORE";
      if (s.cooperation < 5) return "COOPERATE";
      return "LEARN";
  }
}

// ---------- Eine Welt: Ein Akteur, N Runden ----------
type WorldResult = {
  finalState: StateT;
  history: { turn: number; drive: number; vitality: number; goal: number; cooperation: number }[];
  actionCounts: Record<Action, number>;
  survived: boolean;
};

function intrinsicDrive(s: StateT): number {
  return 0.2 * s.interest + 0.2 * s.joy + 0.15 * s.autonomy +
    0.15 * s.competence + 0.15 * s.vitality + 0.15 * s.happiness;
}

function runWorld(seed: number, strategy: Strategy, entropy: number, turns: number): WorldResult {
  const rand = mulberry32(seed);
  const s = initState(rand, entropy);
  const history: WorldResult["history"] = [];
  const actionCounts: Record<Action, number> = { LEARN: 0, REST: 0, COOPERATE: 0, EXPLORE: 0 };
  let resources = 10;

  for (let t = 1; t <= turns; t++) {
    const a = chooseAction(strategy, s);
    actionCounts[a]++;
    resources -= 0.15 + rand() * 0.1;
    switch (a) {
      case "LEARN":
        s.goalProgress += 1.2; s.competence += 0.5; s.vitality -= 0.7 + entropy * rand() * 0.6;
        s.joy += 0.2; break;
      case "REST":
        s.vitality += 1.0; s.joy += 0.3; s.happiness += 0.2; break;
      case "COOPERATE":
        s.cooperation += 0.7; s.goalProgress += 0.6; s.joy += 0.3;
        s.happiness += 0.1 * (s.cooperation / 10); break;
      case "EXPLORE":
        s.interest += 0.8; s.autonomy += 0.3; s.goalProgress += 0.4;
        s.vitality -= 0.3; break;
    }
    // Entropie: gelegentliche Störungen des Systems (repräsentiert randEntropie-Methoden)
    if (rand() < entropy * 0.15) {
      const f = FIELDS[Math.floor(rand() * FIELDS.length)];
      (s as any)[f] += (rand() - 0.5) * 3 * entropy;
    }
    s.motivation = 0.4 * s.interest + 0.3 * s.competence + 0.3 * s.vitality;
    for (const f of FIELDS) (s as any)[f] = clamp((s as any)[f]);
    resources = clamp(resources);
    if (s.vitality <= 0.05 || resources <= 0.05) {
      history.push({ turn: t, drive: intrinsicDrive(s), vitality: s.vitality, goal: s.goalProgress, cooperation: s.cooperation });
      return { finalState: s, history, actionCounts, survived: false };
    }
    history.push({ turn: t, drive: intrinsicDrive(s), vitality: s.vitality, goal: s.goalProgress, cooperation: s.cooperation });
  }
  return { finalState: s, history, actionCounts, survived: true };
}

// ---------- Ensemble: viele parallele Zukünfte ----------
type Ensemble = {
  strategy: Strategy;
  avgDrive: number; avgGoal: number; avgCooperation: number; avgVitality: number;
  avgJoy: number; survivalRate: number;
  avgHistory: { turn: number; drive: number; goal: number; vitality: number; cooperation: number }[];
  fieldAverages: Record<string, number>;
};

function runEnsemble(strategy: Strategy, n: number, seedBase: number, entropy: number, turns: number): Ensemble {
  const results: WorldResult[] = [];
  for (let i = 0; i < n; i++) results.push(runWorld(seedBase + i * 7919, strategy, entropy, turns));
  const avg = (f: (r: WorldResult) => number) => results.reduce((a, r) => a + f(r), 0) / results.length;
  const turnsTaken = Math.min(turns, ...results.map((r) => r.history.length));
  const avgHistory = Array.from({ length: turnsTaken }, (_, t) => {
    const at = (f: (h: any) => number) => results.reduce((a, r) => a + (r.history[t] ? f(r.history[t]) : 0), 0) / results.length;
    return {
      turn: t + 1,
      drive: at((h) => h.drive), goal: at((h) => h.goal),
      vitality: at((h) => h.vitality), cooperation: at((h) => h.cooperation),
    };
  });
  const fieldAverages: Record<string, number> = {};
  for (const f of FIELDS) fieldAverages[f] = avg((r) => r.finalState[f]);
  return {
    strategy,
    avgDrive: avg((r) => intrinsicDrive(r.finalState)),
    avgGoal: avg((r) => r.finalState.goalProgress),
    avgCooperation: avg((r) => r.finalState.cooperation),
    avgVitality: avg((r) => r.finalState.vitality),
    avgJoy: avg((r) => r.finalState.joy),
    survivalRate: results.filter((r) => r.survived).length / results.length,
    avgHistory, fieldAverages,
  };
}

const COLORS: Record<Strategy, string> = {
  balanced: "#10b981", grind: "#3b82f6", social: "#a855f7", curious: "#f59e0b",
};

