    private void updatePhysicsAndDiplomacy(double dt) {
        // 1. Gravitation
        for (CelestialBody b : celestialBodies) b.resetForces();

        for (int i = 0; i < celestialBodies.size(); i++) {
            for (int j = i + 1; j < celestialBodies.size(); j++) {
                CelestialBody b1 = celestialBodies.get(i);
                CelestialBody b2 = celestialBodies.get(j);

                double dx = b2.x - b1.x;
                double dy = b2.y - b1.y;
                double dz = b2.z - b1.z;
                double r2 = dx * dx + dy * dy + dz * dz + 1e-10;
                double r = Math.sqrt(r2);

                double fMag = (G * b1.mass * b2.mass) / r2;
                double nx = dx / r, ny = dy / r, nz = dz / r;

                b1.fx += fMag * nx; b1.fy += fMag * ny; b1.fz += fMag * nz;
                b2.fx -= fMag * nx; b2.fy -= fMag * ny; b2.fz -= fMag * nz;
            }
        }

        for (CelestialBody b : celestialBodies) {
            double ax = b.fx / b.mass;
            double ay = b.fy / b.mass;
            double az = b.fz / b.mass;
            b.vx += ax * dt; b.vy += ay * dt; b.vz += az * dt;
            b.x += b.vx * dt; b.y += b.vy * dt; b.z += b.vz * dt;
        }

        // 2. Einheiten-Physik & Diplomatie / Konflikt
        for (CombatUnit u : combatUnits) {
            if (!u.isAlive) continue;

            CelestialBody sun = celestialBodies.get(0);
            double dx = sun.x - u.x;
            double dy = sun.y - u.y;
            double dz = sun.z - u.z;
            double r2 = dx * dx + dy * dy + dz * dz + 1e-10;
            double r = Math.sqrt(r2);
            double fSun = (G * sun.mass * u.mass) / r2;

            u.vx += (fSun * (dx / r) / u.mass) * dt;
            u.vy += (fSun * (dy / r) / u.mass) * dt;
            u.x += u.vx * dt;
            u.y += u.vy * dt;

            // 3. Interaktion zwischen Flotten: Diplomatie vs. Krieg
            for (CombatUnit other : combatUnits) {
                if (other != u && other.isAlive) {
                    double dist = Math.sqrt(Math.pow(other.x - u.x, 2) + Math.pow(other.y - u.y, 2));

                    // DIPLOMATIE-ZONE (Zwischen 1.0e10 und 2.5e10 Metern Distanz)
                    if (dist > 1.0e10 && dist < 2.5e10) {
                        if (stepCount % 120 == 0 && !u.isAllied && !other.isAllied) {
                            evaluateDiplomaticSummit(u, other);
                        }
                    }
                    // KAMPF-ZONE (Unter 1.0e10 Metern -> Krieg bricht aus, falls nicht verbündet)
                    else if (dist <= 1.0e10) {
                        if (u.isAllied && other.isAllied) {
                            if (stepCount % 150 == 0) {
                                System.out.printf("[ALLIANZ-PATROUILLE] %s und %s fliegen Seite an Seite im Frieden.%n", u.id, other.id);
                            }
                        } else {
                            double impactDamage = (u.attackPower * 0.001) + (u.getKineticEnergy() * 1e-12);
                            other.health -= impactDamage;

                            if (stepCount % 50 == 0) {
                                System.out.printf("[KRIEG] %s greift %s an! E_kin: %.2e J | HP: %.1f%n",
                                        u.id, other.id, u.getKineticEnergy(), Math.max(0, other.health));
                            }

                            if (other.health <= 0) {
                                other.isAlive = false;
                                u.kills++;
                                System.out.printf(">>> [MATRIXGAME SIEG] %s hat %s vernichtet! (Kills: %d)%n",
                                        u.id, other.id, u.kills);
                            }
                        }
                    }
                }
            }
        }
    }

    // Die diplomatische Entscheidungsmatrix (Frieden oder Krieg)
    private void evaluateDiplomaticSummit(CombatUnit u1, CombatUnit u2) {
        double energyDiff = Math.abs(u1.getKineticEnergy() - u2.getKineticEnergy());
        
        System.out.println("\n--- STERNENFLOTTEN-GIPPELTREFFEN ---");
        System.out.printf("Kommandant %s (%s) trifft auf Kommandant %s (%s)%n", u1.commander, u1.id, u2.commander, u2.id);
        
