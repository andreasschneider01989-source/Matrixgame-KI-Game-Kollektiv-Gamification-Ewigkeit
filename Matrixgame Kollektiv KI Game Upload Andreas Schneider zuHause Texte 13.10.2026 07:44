// Innerhalb der class Unit

public Unit decideMinimaxTarget(List<Unit> allUnits, int depth) {
    AIAction bestAction = runNMaxMax(this, allUnits, depth, true);
    
    if (bestAction != null && bestAction.targetObject != null) {
        this.decisionAlgorithm = "N_MAX_MAX";
        return bestAction.targetObject;
