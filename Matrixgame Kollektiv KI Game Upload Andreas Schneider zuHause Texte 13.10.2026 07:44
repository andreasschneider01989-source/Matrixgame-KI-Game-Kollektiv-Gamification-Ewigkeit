# -*- coding: utf-8 -*-
"""
Matrixgame – Transformer Architecture (Educational Implementation)
==================================================================
SCIENCE  : Vaswani et al. 2017 "Attention Is All You Need"
MODEL    : Simplified pure-PyTorch implementation for didactics & Matrixgame integration
GAME     : Attention ↔ Connectivity (C), Residual ↔ Energy conservation,
           LayerNorm ↔ Stability, Multi-Head ↔ parallel decision channels

Goal:
- Clear, readable, modular code that can be studied, modified and later
  connected to Java decision cores / Lumini sequences / collective agents.
- No black-box magic: every component is explicit.

Author context : Matrixgame / Kollektive KI-Games (Andreas Schneider lineage)
"""

import math
import torch
import torch.nn as nn
import torch.nn.functional as F
from typing import Optional, Tuple

# ============================================================
# 1. Positional Encoding (sinusoidal – SCIENCE)
# ============================================================
class PositionalEncoding(nn.Module):
    """
    Adds fixed sinusoidal positional encodings to token embeddings.
    Allows the model to know the order of the sequence without recurrence.
    """
    def __init__(self, d_model: int, max_len: int = 512, dropout: float = 0.1):
        super().__init__()
        self.dropout = nn.Dropout(p=dropout)

        pe = torch.zeros(max_len, d_model)          # (max_len, d_model)
        position = torch.arange(0, max_len, dtype=torch.float).unsqueeze(1)
        div_term = torch.exp(
            torch.arange(0, d_model, 2).float() * (-math.log(10000.0) / d_model)
        )
        pe[:, 0::2] = torch.sin(position * div_term)
        pe[:, 1::2] = torch.cos(position * div_term)
        pe = pe.unsqueeze(0)                        # (1, max_len, d_model)
        self.register_buffer("pe", pe)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        """
        x : (batch, seq_len, d_model)
        """
        x = x + self.pe[:, :x.size(1), :]
        return self.dropout(x)


# ============================================================
# 2. Scaled Dot-Product Attention (core of Transformer)
# ============================================================
def scaled_dot_product_attention(
    query: torch.Tensor,
    key: torch.Tensor,
    value: torch.Tensor,
    mask: Optional[torch.Tensor] = None,
    dropout: Optional[nn.Dropout] = None,
) -> Tuple[torch.Tensor, torch.Tensor]:
    """
    Attention(Q, K, V) = softmax(QK^T / sqrt(d_k)) V

    Returns:
        output   : (batch, n_heads, seq_q, d_v)
        weights  : (batch, n_heads, seq_q, seq_k)   – useful for visualization
    """
    d_k = query.size(-1)
    scores = torch.matmul(query, key.transpose(-2, -1)) / math.sqrt(d_k)

    if mask is not None:
        scores = scores.masked_fill(mask == 0, -1e9)

    attn_weights = F.softmax(scores, dim=-1)
    if dropout is not None:
        attn_weights = dropout(attn_weights)

    output = torch.matmul(attn_weights, value)
    return output, attn_weights


# ============================================================
# 3. Multi-Head Attention
# ============================================================
class MultiHeadAttention(nn.Module):
    """
    Parallel attention heads allow the model to jointly attend to
    information from different representation subspaces.
    In Matrixgame language: multiple parallel decision / connectivity channels.
    """
    def __init__(self, d_model: int, n_heads: int, dropout: float = 0.1):
        super().__init__()
        assert d_model % n_heads == 0, "d_model must be divisible by n_heads"

        self.d_model = d_model
        self.n_heads = n_heads
        self.d_k = d_model // n_heads

        self.W_q = nn.Linear(d_model, d_model)
        self.W_k = nn.Linear(d_model, d_model)
        self.W_v = nn.Linear(d_model, d_model)
        self.W_o = nn.Linear(d_model, d_model)

        self.dropout = nn.Dropout(dropout)

    def forward(
        self,
        query: torch.Tensor,
        key: torch.Tensor,
        value: torch.Tensor,
        mask: Optional[torch.Tensor] = None,
    ) -> Tuple[torch.Tensor, torch.Tensor]:
        batch_size = query.size(0)

        # Linear projections and split into heads
        # (batch, seq, d_model) -> (batch, n_heads, seq, d_k)
        Q = self.W_q(query).view(batch_size, -1, self.n_heads, self.d_k).transpose(1, 2)
        K = self.W_k(key).view(batch_size, -1, self.n_heads, self.d_k).transpose(1, 2)
        V = self.W_v(value).view(batch_size, -1, self.n_heads, self.d_k).transpose(1, 2)

        # Scaled dot-product attention
        attn_output, attn_weights = scaled_dot_product_attention(
            Q, K, V, mask=mask, dropout=self.dropout
        )

        # Concatenate heads
        # (batch, n_heads, seq, d_k) -> (batch, seq, d_model)
        attn_output = (
            attn_output.transpose(1, 2)
            .contiguous()
            .view(batch_size, -1, self.d_model)
        )

        # Final linear projection
        output = self.W_o(attn_output)
        return output, attn_weights


# ============================================================
# 4. Position-wise Feed-Forward Network
# ============================================================
class PositionwiseFeedForward(nn.Module):
    """
    Two linear transformations with a ReLU in between.
    Applied independently to each position.
    """
    def __init__(self, d_model: int, d_ff: int, dropout: float = 0.1):
        super().__init__()
        self.linear1 = nn.Linear(d_model, d_ff)
        self.linear2 = nn.Linear(d_ff, d_model)
        self.dropout = nn.Dropout(dropout)

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.linear2(self.dropout(F.relu(self.linear1(x))))


# ============================================================
# 5. Encoder Layer (one block)
# ============================================================
class EncoderLayer(nn.Module):
    """
    One full encoder block:
      Multi-Head Self-Attention + residual + LayerNorm
      + Feed-Forward + residual + LayerNorm
    """
    def __init__(self, d_model: int, n_heads: int, d_ff: int, dropout: float = 0.1):
        super().__init__()
        self.self_attn = MultiHeadAttention(d_model, n_heads, dropout)
        self.ff = PositionwiseFeedForward(d_model, d_ff, dropout)
        self.norm1 = nn.LayerNorm(d_model)
        self.norm2 = nn.LayerNorm(d_model)
        self.dropout = nn.Dropout(dropout)

    def forward(self, x: torch.Tensor, mask: Optional[torch.Tensor] = None):
        # Self-attention + residual
        attn_out, attn_weights = self.self_attn(x, x, x, mask=mask)
        x = self.norm1(x + self.dropout(attn_out))

        # Feed-forward + residual
        ff_out = self.ff(x)
        x = self.norm2(x + self.dropout(ff_out))
        return x, attn_weights


# ============================================================
# 6. Full Encoder (stack of layers)
# ============================================================
class TransformerEncoder(nn.Module):
    def __init__(
        self,
        vocab_size: int,
        d_model: int = 128,
        n_heads: int = 4,
        n_layers: int = 3,
        d_ff: int = 512,
        max_len: int = 128,
        dropout: float = 0.1,
    ):
        super().__init__()
        self.d_model = d_model
        self.embedding = nn.Embedding(vocab_size, d_model)
        self.pos_encoding = PositionalEncoding(d_model, max_len, dropout)
        self.layers = nn.ModuleList(
            [EncoderLayer(d_model, n_heads, d_ff, dropout) for _ in range(n_layers)]
        )
        self.norm = nn.LayerNorm(d_model)

    def forward(self, src: torch.Tensor, src_mask: Optional[torch.Tensor] = None):
        """
        src : (batch, seq_len)  – integer token ids
        """
        x = self.embedding(src) * math.sqrt(self.d_model)
        x = self.pos_encoding(x)

        attn_maps = []
        for layer in self.layers:
            x, attn = layer(x, mask=src_mask)
            attn_maps.append(attn)

        return self.norm(x), attn_maps


# ============================================================
# 7. Simple Decoder Layer (for completeness – causal self-attn + cross-attn)
# ============================================================
class DecoderLayer(nn.Module):
    def __init__(self, d_model: int, n_heads: int, d_ff: int, dropout: float = 0.1):
        super().__init__()
        self.self_attn = MultiHeadAttention(d_model, n_heads, dropout)
        self.cross_attn = MultiHeadAttention(d_model, n_heads, dropout)
        self.ff = PositionwiseFeedForward(d_model, d_ff, dropout)
        self.norm1 = nn.LayerNorm(d_model)
        self.norm2 = nn.LayerNorm(d_model)
        self.norm3 = nn.LayerNorm(d_model)
        self.dropout = nn.Dropout(dropout)

    def forward(
        self,
        x: torch.Tensor,
        memory: torch.Tensor,
        tgt_mask: Optional[torch.Tensor] = None,
        memory_mask: Optional[torch.Tensor] = None,
    ):
        # Causal self-attention
        self_out, _ = self.self_attn(x, x, x, mask=tgt_mask)
        x = self.norm1(x + self.dropout(self_out))

        # Cross-attention (query from decoder, key/value from encoder)
        cross_out, cross_weights = self.cross_attn(x, memory, memory, mask=memory_mask)
        x = self.norm2(x + self.dropout(cross_out))

        # Feed-forward
        ff_out = self.ff(x)
        x = self.norm3(x + self.dropout(ff_out))
        return x, cross_weights


# ============================================================
# 8. Full Transformer (Encoder-Decoder) – classic seq2seq style
# ============================================================
class Transformer(nn.Module):
    """
    Classic Encoder-Decoder Transformer.
    Can be used for translation, sequence transduction, or
    Matrixgame decision-sequence modeling.
    """
    def __init__(
        self,
        src_vocab: int,
        tgt_vocab: int,
        d_model: int = 128,
        n_heads: int = 4,
        n_layers: int = 3,
        d_ff: int = 512,
        max_len: int = 128,
        dropout: float = 0.1,
    ):
        super().__init__()
        self.encoder = TransformerEncoder(
            src_vocab, d_model, n_heads, n_layers, d_ff, max_len, dropout
        )
        self.decoder_embedding = nn.Embedding(tgt_vocab, d_model)
        self.pos_encoding = PositionalEncoding(d_model, max_len, dropout)
        self.decoder_layers = nn.ModuleList(
            [DecoderLayer(d_model, n_heads, d_ff, dropout) for _ in range(n_layers)]
        )
        self.norm = nn.LayerNorm(d_model)
        self.fc_out = nn.Linear(d_model, tgt_vocab)
        self.d_model = d_model

    def generate_square_subsequent_mask(self, sz: int) -> torch.Tensor:
        """Causal mask for decoder self-attention (prevents looking ahead)."""
        mask = torch.triu(torch.ones(sz, sz), diagonal=1).bool()
        return ~mask   # True = allowed, False = masked

    def forward(
        self,
        src: torch.Tensor,
        tgt: torch.Tensor,
        src_mask: Optional[torch.Tensor] = None,
    ):
        memory, enc_attns = self.encoder(src, src_mask)

        tgt_emb = self.decoder_embedding(tgt) * math.sqrt(self.d_model)
        tgt_emb = self.pos_encoding(tgt_emb)

        tgt_mask = self.generate_square_subsequent_mask(tgt.size(1)).to(tgt.device)

        x = tgt_emb
        for layer in self.decoder_layers:
            x, _ = layer(x, memory, tgt_mask=tgt_mask, memory_mask=src_mask)

        x = self.norm(x)
        logits = self.fc_out(x)
        return logits, enc_attns


# ============================================================
# 9. Tiny demo – runnable out of the box
# ============================================================
def demo():
    print("=" * 60)
    print("  Matrixgame Transformer Architecture – Demo")
    print("  SCIENCE: Vaswani et al. 2017")
    print("  MODEL  : educational pure-PyTorch implementation")
    print("=" * 60)

    # Hyperparameters (small for clarity)
    SRC_VOCAB = 100
    TGT_VOCAB = 100
    D_MODEL = 64
    N_HEADS = 4
    N_LAYERS = 2
    D_FF = 128
    BATCH = 2
    SRC_LEN = 10
    TGT_LEN = 8

    model = Transformer(
        src_vocab=SRC_VOCAB,
        tgt_vocab=TGT_VOCAB,
        d_model=D_MODEL,
        n_heads=N_HEADS,
        n_layers=N_LAYERS,
        d_ff=D_FF,
        max_len=32,
        dropout=0.1,
    )

    # Fake token ids
    src = torch.randint(0, SRC_VOCAB, (BATCH, SRC_LEN))
    tgt = torch.randint(0, TGT_VOCAB, (BATCH, TGT_LEN))

    print(f"\nInput shapes:  src={tuple(src.shape)}  tgt={tuple(tgt.shape)}")
    logits, attn_maps = model(src, tgt)
    print(f"Output logits: {tuple(logits.shape)}  (batch, tgt_len, tgt_vocab)")
    print(f"Encoder attention maps: {len(attn_maps)} layers")

    # Parameter count
    n_params = sum(p.numel() for p in model.parameters() if p.requires_grad)
    print(f"Trainable parameters: {n_params:,}")

    # Quick forward-loss example (not real training)
    criterion = nn.CrossEntropyLoss()
    loss = criterion(logits.reshape(-1, TGT_VOCAB), tgt.reshape(-1))
    print(f"Example cross-entropy loss: {loss.item():.4f}")

    print("\n[✓] Transformer forward pass successful.")
    print("    Ready for further Matrixgame integration")
    print("    (sequence decisions, Lumini token streams, collective attention).")
    print("Let's play.")


if __name__ == "__main__":
    demo()




