                double dx = bj.x - bi.x, dy = bj.y - bi.y, dz = bj.z - bi.z;
                double r = Math.max(MIN_DIST, Math.sqrt(dx*dx + dy*dy + dz*dz)); // FIX: Singularitäts-Cap
                double a = Math.min(MAX_ACC, G * bj.mass / (r * r));             // FIX: Kraft-Limit
                ax[i] += a * dx / r; ay[i] += a * dy / r; az[i] += a * dz / r;
            }
        }
        // Zerfall: schnelle, massive, kollidierende Körper zerfallen in ihr Oktett (Fraktal sichtbar!)
        List<FraktalKoerper> neu = new ArrayList<>();
        for (int i = bodies.size() - 1; i >= 0; i--) {
