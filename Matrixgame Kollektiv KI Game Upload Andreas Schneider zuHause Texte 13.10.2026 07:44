package ordner1;



import java.util.*;



/**

 * Collective Causal Game 1.1

 *

 * Kernidee:

 *

 * Information besitzt zunächst keine physische Gewalt.

 * Erst über Entscheidungen und Handlungen kann daraus

 * physischer Schaden entstehen.

 *

 * Alle Werte sind Simulationsparameter.

 * Keine reale Vorhersagemaschine für menschliches Verhalten.

 */

public class CollectiveCausalGame11 {



    static final long SEED = 20261003L;

    static final Random RNG = new Random(SEED);



    static final int ROUNDS = 25;



    // --------------------------------------------------

    // Ereignistypen

    // --------------------------------------------------



    enum EventType {

        INFORMATION,

        INTERPRETATION,

        EMOTION,

        DECISION,

        ACTION,

        PHYSICAL_CONSEQUENCE,

        INTERVENTION,

        KNOWLEDGE_GAIN

    }



    // --------------------------------------------------

    // Handlungsmöglichkeiten

    // --------------------------------------------------



    enum Action {

        OBSERVE,

        COMMUNICATE,

        VERIFY,

        COOPERATE,

        MEDIATE,

        WAIT,

        ESCALATE

    }



    // --------------------------------------------------

    // Kausalereignis

    // --------------------------------------------------



    static class CausalEvent {



        int id;

        int round;



        EventType type;

        String description;



        Integer causedBy;



        double intensity;

        double uncertainty;

        double harm;



        CausalEvent(

                int id,

                int round,

                EventType type,

                String description,

                Integer causedBy,

                double intensity,

                double uncertainty,

                double harm

        ) {

            this.id = id;

            this.round = round;

            this.type = type;

            this.description = description;

            this.causedBy = causedBy;

            this.intensity = intensity;

            this.uncertainty = uncertainty;

            this.harm = harm;

        }



        String toJson() {



            return String.format(

                    Locale.US,

                    "{\"id\":%d,\"round\":%d,"

                            + "\"type\":\"%s\","

                            + "\"description\":\"%s\","

                            + "\"causedBy\":%s,"

                            + "\"intensity\":%.2f,"

                            + "\"uncertainty\":%.2f,"

                            + "\"harm\":%.2f}",

                    id,

                    round,

                    type,

                    description,

                    causedBy == null ? "null" : causedBy,

                    intensity,

                    uncertainty,

                    harm

            );

        }

