Das verbindet „Zufall mit Angleichung" aus Formelsammlung 1.0 direkt mit Boltzmann-Statistik. Es ist programmierbar und prüfbar.

**Skalierung:** Für Tests G = 1, M = 1, r = 1 setzen (dann ist v_Kreis = 1, Periode 2π). Das vermeidet Rundungsprobleme bei 10⁻¹¹ und 10³⁰.

```java
public final class NBody {
    public final double G, eps; public final double[] m; public final double[][] r, v, a;
    public NBody(double G, double eps, double[] m, double[][] r, double[][] v) {
        this.G=G; this.eps=eps; this.m=m; this.r=r; this.v=v; this.a=new double[m.length][3]; accel();
    }
    private void accel() {
        for (double[] ai : a) java.util.Arrays.fill(ai, 0);
        for (int i = 0; i < m.length; i++) for (int j = i + 1; j < m.length; j++) {
            double dx=r[j][0]-r[i][0], dy=r[j][1]-r[i][1], dz=r[j][2]-r[i][2];
            double d2=dx*dx+dy*dy+dz*dz+eps*eps, inv=1.0/(d2*Math.sqrt(d2));
            a[i][0]+=G*m[j]*dx*inv; a[i][1]+=G*m[j]*dy*inv; a[i][2]+=G*m[j]*dz*inv;
            a[j][0]-=G*m[i]*dx*inv; a[j][1]-=G*m[i]*dy*inv; a[j][2]-=G*m[i]*dz*inv;  // Actio = Reactio
        }
    }
    public void step(double dt) {
        for (int i=0;i<m.length;i++) for (int k=0;k<3;k++) r[i][k]+=v[i][k]*dt+0.5*a[i][k]*dt*dt;
        double[][] aOld=new double[m.length][]; for (int i=0;i<m.length;i++) aOld[i]=a[i].clone();
        accel();
        for (int i=0;i<m.length;i++) for (int k=0;k<3;k++) v[i][k]+=0.5*(aOld[i][k]+a[i][k])*dt;
    }
    public double energy() {
        double e=0;
        for (int i=0;i<m.length;i++) {
            e+=0.5*m[i]*(v[i][0]*v[i][0]+v[i][1]*v[i][1]+v[i][2]*v[i][2]);
            for (int j=i+1;j<m.length;j++) {
                double dx=r[j][0]-r[i][0], dy=r[j][1]-r[i][1], dz=r[j][2]-r[i][2];
                e-=G*m[i]*m[j]/Math.sqrt(dx*dx+dy*dy+dz*dz+eps*eps);
            }
        }
        return e;
    }
    public double[] momentum() {                       // Impulserhaltung als zweiter Test
        double[] p=new double[3];
        for (int i=0;i<m.length;i++) for (int k=0;k<3;k++) p[k]+=m[i]*v[i][k];
        return p;
    }
}
```

