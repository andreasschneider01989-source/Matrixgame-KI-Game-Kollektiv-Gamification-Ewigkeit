        // Datenstrukturen für Neuronen und Synapsen (Verknüpfungen)
        class Neuron {
            constructor(id, x, y, value, color, type) {
                this.id = id;
                this.x = x;
                this.y = y;
                this.value = value;
                this.color = color;
                this.type = type; // 'input', 'processing', 'output'
                this.activation = 0;
                this.radius = 25;
            }

            draw(ctx) {
                // Pulsierender Effekt basierend auf Aktivierung
                let currentRadius = this.radius + Math.sin(Date.now() / 200 + this.x) * 3 * this.activation;
                
                ctx.beginPath();
                ctx.arc(this.x, this.y, currentRadius, 0, Math.PI * 2);
                ctx.fillStyle = this.color;
