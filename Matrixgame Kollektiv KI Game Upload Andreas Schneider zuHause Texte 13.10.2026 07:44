    }

    // ---------- Causal step (SPACE) ----------
    private void advanceCausalRound() {
        simRound++;
        System.out.println("\n========== CAUSAL ROUND " + simRound + " ==========");

        // 1. Information arrives (high truth / high social risk possible)
        double socialRisk = 0.55 + rng.nextDouble() * 0.35;
        addEvent("INFORMATION", "Precise high-density information vector enters the system",
                90, 12, 0);

        // 2. Each neuron interprets
        for (BioNeuron n : neurons) {
            double threat = socialRisk * n.traumaSensitivity * (1.0 - n.criticalThinking) * 0.45;
            n.stress = Math.min(1.0, n.stress + threat * 0.35);
            n.fear   = Math.min(1.0, n.stress * 0.7); // simplified
            addEvent("INTERPRETATION", "Neuron " + n.id + " interprets (threat=" + String.format("%.2f", threat) + ")",
                    threat * 40, 25, 0);
        }

        // 3. Emotion update + decision
        for (BioNeuron n : neurons) {
            double danger = n.stress * 0.3 + n.anger * 0.25;
            double stabilize = n.trust * 0.2 + n.hope * 0.2 + n.criticalThinking * 0.25 + n.communication * 0.15;
            double pressure = danger - stabilize;

            String action;
            if (pressure > 0.32) {
                double r = rng.nextDouble();
                if (r < 0.28) action = "COMMUNICATE";
                else if (r < 0.52) action = "VERIFY";
                else if (r < 0.72) action = "WAIT";
                else action = "ESCALATE";
            } else {
                double r = rng.nextDouble();
                if (r < 0.4) action = "COOPERATE";
                else if (r < 0.7) action = "COMMUNICATE";
                else action = "VERIFY";
            }

            resolveAction(n, action, pressure);
        }

        // Collective stats
        System.out.printf("Hawkins=%.1f  Entropy=%.1f  PhysDmg=%.1f  EmotDmg=%.1f  Interventions=%d/%d%n",
                globalHawkins, systemEntropy, physicalDamage, emotionalDamage,
                successfulInterventions, interventionWindows);
    }

    private void resolveAction(BioNeuron n, String action, double pressure) {
        switch (action) {
            case "COMMUNICATE" -> {
                n.trust = Math.min(1, n.trust + 0.04);
                n.stress = Math.max(0, n.stress - 0.04);
                addEvent("ACTION", "Neuron " + n.id + " communicates", 18, 12, 0);
            }
            case "VERIFY" -> {
                n.criticalThinking = Math.min(1, n.criticalThinking + 0.03);
                n.trust = Math.min(1, n.trust + 0.03);
                n.stress = Math.max(0, n.stress - 0.03);
                addEvent("KNOWLEDGE_GAIN", "Neuron " + n.id + " verifies", 22, 8, 0);
            }
            case "COOPERATE" -> {
                n.trust = Math.min(1, n.trust + 0.07);
                n.hope  = Math.min(1, n.hope + 0.05);
                n.stress = Math.max(0, n.stress - 0.05);
                addEvent("ACTION", "Neuron " + n.id + " cooperates", 28, 7, 0);
            }
            case "WAIT" -> {
                n.stress = Math.max(0, n.stress - 0.02);
                addEvent("ACTION", "Neuron " + n.id + " waits (buys time)", 10, 18, 0);
            }
            case "ESCALATE" -> {
                // Critical boundary: Intervention window BEFORE physical consequence
                interventionWindows++;
                double interventionChance =
                        (n.communication + n.criticalThinking + n.trust + n.hope) / 4.0
                        * (membraneFilterActive ? 1.45 : 1.0);  // filter helps

                if (rng.nextDouble() < interventionChance) {
                    successfulInterventions++;
                    n.stress = Math.max(0, n.stress - 0.12);
                    n.anger  = Math.max(0, n.anger  - 0.10);
                    n.hope   = Math.min(1, n.hope + 0.06);
                    addEvent("INTERVENTION", "Intervention window succeeded – physical path blocked",
                            55, 10, 0);
                } else {
                    // Only here can physical harm appear
                    double severity = 8 + n.anger * 18 + n.stress * 12;
                    physicalDamage += severity;
                    emotionalDamage += severity * 0.35;
                    n.trust = Math.max(0, n.trust - 0.14);
                    n.hope  = Math.max(0, n.hope  - 0.11);
                    n.stress = Math.min(1, n.stress + 0.15);
                    addEvent("PHYSICAL_CONSEQUENCE",
                            "Physical damage event (severity=" + String.format("%.1f", severity) + ")",
                            severity, 22, severity);
                }
            }
        }
    }

