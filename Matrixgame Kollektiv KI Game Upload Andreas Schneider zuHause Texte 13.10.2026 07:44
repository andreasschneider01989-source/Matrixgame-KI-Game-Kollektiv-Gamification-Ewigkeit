                n.portPulses[i] == 1 ? "<IN" : n.portPulses[i] == -1 ? "OUT>" : ""), px, py);
        }
        g2.setColor(new Color(180, 180, 180));
        g2.drawString("P(t+1) = P(t)*0.985 + Σ(P_in * w_k)", x + 14, y + 210);
