## 💻 2. Modulare Java-Implementierung

Gemäß der Vorgabe sind alle grundlegenden Klassen und Schnittstellen für eine einfache Handhabung und Portierbarkeit in einem einzigen, sauberen Codeblock zusammengefasst:

```java
// Matrixgame Collective Consciousness Simulator - Modular Core Architecture
import java.awt.*;
import java.awt.event.*;
import java.util.*;
import java.util.List;

public class MatrixGameSimulator {

    public interface CanvasEntity {
        void render(Graphics2D g2d);
        void update(double deltaTime);
        Rectangle getBounds();
        String getId();
    }

    public static class CanvasUnit implements CanvasEntity {
        protected String id;
        protected double x, y, width, height;
        protected Map<String, Object> properties = new HashMap<>();

        public CanvasUnit(String id, double x, double y, double width, double height) {
            this.id = id;
            this.x = x;
            this.y = y;
            this.width = width;
            this.height = height;
        }

        @Override
        public void render(Graphics2D g2d) {
            g2d.setColor(Color.CYAN);
            g2d.fillRect((int) x, (int) y, (int) width, (int) height);
            g2d.setColor(Color.WHITE);
            g2d.drawRect((int) x, (int) y, (int) width, (int) height);
            g2d.drawString(id, (int) x + 5, (int) y + 15);
        }

        @Override
        public void update(double deltaTime) {
            // Laufzeit-Aktualisierung der Einheit
        }

        @Override
        public Rectangle getBounds() {
            return new Rectangle((int) x, (int) y, (int) width, (int) height);
        }

        @Override
        public String getId() {
            return id;
        }

        public CanvasUnit copy() {
            CanvasUnit clone = new CanvasUnit(id + "_copy", x + 25, y + 25, width, height);
            clone.properties.putAll(this.properties);
            return clone;
        }
    }

    public static class InputController extends KeyAdapter implements MouseWheelListener, MouseListener, MouseMotionListener {
        private double zoom = 1.0;
        private double panX = 0.0, panY = 0.0;
        private int lastMouseX, lastMouseY;
        private boolean isDragging = false;

        @Override
        public void mouseWheelMoved(MouseWheelEvent e) {
            if (e.getPreciseWheelRotation() < 0) {
                zoom *= 1.1;
            } else {
                zoom /= 1.1;
            }
        }

        @Override
        public void mousePressed(MouseEvent e) {
            lastMouseX = e.getX();
            lastMouseY = e.getY();
            isDragging = true;
        }

        @Override
        public void mouseReleased(MouseEvent e) {
            isDragging = false;
        }

        @Override
        public void mouseDragged(MouseEvent e) {
            if (isDragging) {
                panX += (e.getX() - lastMouseX);
                panY += (e.getY() - lastMouseY);
                lastMouseX = e.getX();
                lastMouseY = e.getY();
            }
        }

        public double getZoom() { return zoom; }
        public double getPanX() { return panX; }
        public double getPanY() { return panY; }

        @Override public void mouseClicked(MouseEvent e) {}
        @Override public void mouseEntered(MouseEvent e) {}
        @Override public void mouseExited(MouseEvent e) {}
        @Override public void mouseMoved(MouseEvent e) {}
    }

    public static class SelectionEngine {
        private final List<CanvasEntity> selectedEntities = new ArrayList<>();

        public void select(CanvasEntity entity, boolean additive) {
            if (!additive) {
                selectedEntities.clear();
            }
            if (!selectedEntities.contains(entity)) {
                selectedEntities.add(entity);
            }
        }

        public void clear() {
            selectedEntities.clear();
        }

        public List<CanvasEntity> getSelectedEntities() {
            return Collections.unmodifiableList(selectedEntities);
        }

        public List<CanvasUnit> copySelected() {
            List<CanvasUnit> copies = new ArrayList<>();
            for (CanvasEntity entity : selectedEntities) {
                if (entity instanceof CanvasUnit) {
                    copies.add(((CanvasUnit) entity).copy());
                }
            }
            return copies;
        }
    }

    public static class AlphaZeroDidacticEvaluator {
        public double evaluateState(List<CanvasEntity> entities) {
            // Heuristische Bewertung für Systemkohärenz und schöne Didaktik
            double score = 1.0;
            for (CanvasEntity entity : entities) {
                score += entity.getId().length() * 0.2;
            }
            return Math.min(score, 100.0);
        }

        public String getDidacticRecommendation(double score) {
            if (score > 40) {
                return "Zustand stabil: Schöne Didaktik und optimale Modularität aktiv.";
            } else {
                return "Empfehlung: Zusätzliche Einheiten und Strukturverknüpfungen hinzufügen.";
            }
        }
    }
}

