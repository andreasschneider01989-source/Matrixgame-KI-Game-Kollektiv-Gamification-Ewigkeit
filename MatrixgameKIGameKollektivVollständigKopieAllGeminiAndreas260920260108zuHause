package matrixgame;

public class MatrixUnit extends KreisObjekt {
    public double id;
    public int team;
    public String typ = "Unit";
    
    public double leben, maxLeben;
    public double speed, distance, damage;
    
    public int kills = 0;
    public double points1, points2;
    public long konstruktionszeit;
    
    public MatrixUnit target = null;
    public MatrixUnit manualTarget = null;
    public Double targetPosX = null, targetPosY = null;
    public String decisionAlgorithm = "NEAREST_ENEMY";

    public MatrixUnit(double id, int team) {
        super(10.0, 200, 200, 200, 0, 0, 0);
        this.id = id;
        this.team = team;
        this.leben = 10 + (Math.random() * 40);
        this.maxLeben = this.leben;
        this.damage = 1 + (Math.random() * 5);
        this.distance = 25.0;
        this.speed = 0.5 + Math.random();
        this.konstruktionszeit = System.currentTimeMillis();
    }

    public double getDistance(MatrixUnit other) {
        if (other == null) return Double.MAX_VALUE;
        double dx = this.posX - other.posX;
        double dy = this.posY - other.posY;
        double dz = this.posZ - other.posZ;
        return Math.sqrt(dx * dx + dy * dy + dz * dz);
    }

    public void calculateVelocityTo(double tx, double ty, double tz) {
        double dx = tx - this.posX;
        double dy = ty - this.posY;
        double dz = tz - this.posZ;
        double dist = Math.sqrt(dx * dx + dy * dy + dz * dz);
        
        if (dist > 0.001) {
            this.vx = (dx / dist) * this.speed;
            this.vy = (dy / dist) * this.speed;
            this.vz = (dz / dist) * this.speed;
        } else {
            this.vx = 0; this.vy = 0; this.vz = 0;
        }
    }

    public void attack(MatrixUnit enemy) {
        if (enemy != null && enemy.leben > 0) {
            double multiplier = 1.0 + (Math.random() * 0.5);
            enemy.leben -= (this.damage * multiplier);
        }
    }
}

