package matrixgame;

import javax.swing.*;
import java.awt.*;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import java.util.ArrayList;
import java.util.List;

public class MatrixgameEngine extends JPanel {
    private List<MatrixUnit> unitList = new ArrayList<>();
    private double zoomFactor = 1.0;
    private double zoomCenterX = 0, zoomCenterY = 0;
    private static final double ZOOM_STEP = 1.2;
    private double globalEntropyPool = 100.0;
    private long simulationTicks = 0;

    private int dragStartX = -1, dragStartY = -1;
    private int currentMouseX = -1, currentMouseY = -1;
    private boolean isDragging = false;

    public MatrixgameEngine() {
        setBackground(Color.BLACK);
        initUnits();
        setupMouseListener();
    }

    private void initUnits() {
        double counterId = 0;
        for (int i = 0; i < 150; i++) {
            MatrixUnit u1 = new MatrixUnit(counterId++, 1);
            u1.posX = (Math.random() * 800) - 400;
            u1.posY = (Math.random() * 400) - 200;
            u1.red = 50; u1.green = 200; u1.blue = 255;
            unitList.add(u1);

            MatrixUnit u2 = new MatrixUnit(counterId++, 2);
            u2.posX = (Math.random() * 800) - 400;
            u2.posY = (Math.random() * 400) + 200;
            u2.red = 255; u2.green = 60; u2.blue = 60;
            unitList.add(u2);
        }
    }

    private void setupMouseListener() {
        MouseAdapter ma = new MouseAdapter() {
            @Override
            public void mousePressed(MouseEvent e) {
                if (SwingUtilities.isLeftMouseButton(e)) {
                    dragStartX = e.getX();
                    dragStartY = e.getY();
                    isDragging = false;
                } else if (SwingUtilities.isRightMouseButton(e)) {
                    double worldX = (e.getX() - getWidth() / 2.0) / zoomFactor - zoomCenterX;
                    double worldY = (e.getY() - getHeight() / 2.0) / zoomFactor - zoomCenterY;
                    
                    MatrixUnit clickedEnemy = null;
                    for (MatrixUnit u : unitList) {
                        double sx = (zoomCenterX + u.posX) * zoomFactor + getWidth() / 2.0;
                        double sy = (zoomCenterY + u.posY) * zoomFactor + getHeight() / 2.0;
                        if (Math.hypot(e.getX() - sx, e.getY() - sy) <= u.size * zoomFactor) {
                            clickedEnemy = u; break;
                        }
                    }

                    if (globalEntropyPool >= 5.0) {
                        globalEntropyPool -= 5.0;
                        for (MatrixUnit u : unitList) {
                            if (u.isSelected) {
                                if (clickedEnemy != null && clickedEnemy.team != u.team) {
                                    u.manualTarget = clickedEnemy;
                                    u.decisionAlgorithm = "TACTICAL_FOCUS";
                                } else {
                                    u.targetPosX = worldX;
                                    u.targetPosY = worldY;
                                    u.decisionAlgorithm = "TARGET_POINT";
                                }
                            }
                        }
                    }
                }
            }
            @Override
            public void mouseDragged(MouseEvent e) {
                if (SwingUtilities.isLeftMouseButton(e)) {
                    currentMouseX = e.getX(); currentMouseY = e.getY();
                    isDragging = true;
                    repaint();
                }
            }
            @Override
            public void mouseReleased(MouseEvent e) {
                if (SwingUtilities.isLeftMouseButton(e) && isDragging) {
                    double x1 = Math.min(dragStartX, currentMouseX);
                    double x2 = Math.max(dragStartX, currentMouseX);
                    double y1 = Math.min(dragStartY, currentMouseY);
                    double y2 = Math.max(dragStartY, currentMouseY);
                    
                    for (MatrixUnit u : unitList) {
                        double sx = (zoomCenterX + u.posX) * zoomFactor + getWidth() / 2.0;
                        double sy = (zoomCenterY + u.posY) * zoomFactor + getHeight() / 2.0;
                        if (!e.isShiftDown()) u.isSelected = false;
                        if (sx >= x1 && sx <= x2 && sy >= y1 && sy <= y2) u.isSelected = true;
                    }
                    isDragging = false;
                    repaint();
                }
            }
        };
        addMouseListener(ma);
        addMouseMotionListener(ma);
    }

    public void gameLoop() {
        while (true) {
            simulationTicks++;
            if (globalEntropyPool < 100.0) globalEntropyPool += 0.05;

            List<MatrixUnit> toRemove = new ArrayList<>();
            for (MatrixUnit u : unitList) {
                if (u.leben <= 0) {
                    toRemove.add(u);
                    continue;
                }

                if (u.decisionAlgorithm.equals("TARGET_POINT") && u.targetPosX != null) {
                    u.calculateVelocityTo(u.targetPosX, u.targetPosY, u.posZ);
                    u.move(1.0);
                    if (Math.hypot(u.posX - u.targetPosX, u.posY - u.targetPosY) < 5.0) {
                        u.decisionAlgorithm = "NEAREST_ENEMY";
                        u.vx = 0; u.vy = 0; u.vz = 0;
                    }
                } else {
                    MatrixUnit target = getNearestEnemy(u);
                    if (target != null) {
                        if (u.getDistance(target) <= u.distance) {
                            u.vx = 0; u.vy = 0;
                            u.attack(target);
                            if (target.leben <= 0) {
                                u.kills++;
                                System.out.println("Unit " + target.id + " vernichtet durch " + u.id);
                            }
                        } else {
                            u.calculateVelocityTo(target.posX, target.posY, target.posZ);
                            u.move(1.0);
                        }
                    }
                }
            }
            unitList.removeAll(toRemove);
            repaint();
            
            try { Thread.sleep(16); } 
            catch (InterruptedException ex) { break; }
        }
    }

    private MatrixUnit getNearestEnemy(MatrixUnit current) {
        MatrixUnit best = null;
        double minDist = Double.MAX_VALUE;
        for (MatrixUnit u : unitList) {
            if (u.team != current.team && u.leben > 0) {
                double dist = current.getDistance(u);
                if (dist < minDist) { minDist = dist; best = u; }
            }
        }
        return best;
    }

