        }

        if (isDragging) {
            g2.setColor(new Color(0, 255, 128, 60));
            int x = Math.min(dragStartX, currentMouseX);
            int y = Math.min(dragStartY, currentMouseY);
            g2.fillRect(x, y, Math.abs(currentMouseX - dragStartX), Math.abs(currentMouseY - dragStartY));
        }

        g2.setColor(new Color(0, 255, 128));
        g2.drawString(String.format("Entropie-Pool: %.2f | Ticks: %d", globalEntropyPool, simulationTicks), 20, 30);
    }

