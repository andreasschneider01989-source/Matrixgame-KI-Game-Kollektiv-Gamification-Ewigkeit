package matrixgame;

public class KreisObjekt {
    public double posX, posY, posZ;
    public double vx, vy, vz;
    public double size;
    public double red, green, blue;
    public boolean isSelected = false;

    public KreisObjekt(double size, double r, double g, double b, double x, double y, double z) {
        this.size = size;
        this.red = r;
        this.green = g;
        this.blue = b;
        this.posX = x;
        this.posY = y;
        this.posZ = z;
        this.vx = 0;
        this.vy = 0;
        this.vz = 0;
    }

    public void move(double dt) {
        this.posX += this.vx * dt;
        this.posY += this.vy * dt;
        this.posZ += this.vz * dt;
    }
}

