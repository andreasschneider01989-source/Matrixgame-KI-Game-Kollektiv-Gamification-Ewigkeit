    public static class CombatUnit {
        private final String id;
        private final ShipClass shipClass;
        private final IntelligenceType intelligence;
        private Vector3D position; // in Metern
        private Vector3D velocity; // in m/s
        private double currentMassKg;
        private double shieldEnergyJ;
        private double ablativeMassKg;
        private boolean isDestroyed = false;

        public CombatUnit(String id, ShipClass shipClass, IntelligenceType intelligence, Vector3D pos, Vector3D vel) {
            this.id = id;
            this.shipClass = shipClass;
            this.intelligence = intelligence;
            this.position = pos;
            this.velocity = vel;
            this.currentMassKg = shipClass.baseMassKg + shipClass.maxAblativeMassKg;
            this.shieldEnergyJ = shipClass.maxShieldEnergyJ;
            this.ablativeMassKg = shipClass.maxAblativeMassKg;
        }

        public void updatePhysics(double deltaSeconds) {
            if (isDestroyed) return;
            this.position = this.position.add(this.velocity.mult(deltaSeconds));
        }

        // Ablative Panzerungs- und Treffermechanik
        public void takeDamage(double kineticEnergyJoules) {
            if (isDestroyed) return;

            double remainingDamage = kineticEnergyJoules;

            // 1. Schilde absorbieren Energie
            if (shieldEnergyJ > 0) {
                if (shieldEnergyJ >= remainingDamage) {
                    shieldEnergyJ -= remainingDamage;
                    remainingDamage = 0;
                } else {
                    remainingDamage -= shieldEnergyJ;
                    shieldEnergyJ = 0;
                }
            }

            // 2. Ablative Panzerung trennt sich ab und nimmt kinetische Energie auf
            if (remainingDamage > 0 && ablativeMassKg > 0) {
                double massEjectedKg = remainingDamage / 1.0e6; // Energy/Sublimation Constant
                if (ablativeMassKg >= massEjectedKg) {
                    ablativeMassKg -= massEjectedKg;
                    currentMassKg -= massEjectedKg; // Masse verringert sich!
                    remainingDamage = 0;
                    System.out.printf("[%s] Ablativ-Panzerung abgesprengt: -%.2f kg. Hülle geschützt.%n", id, massEjectedKg);
                } else {
                    remainingDamage -= ablativeMassKg * 1.0e6;
                    currentMassKg -= ablativeMassKg;
                    ablativeMassKg = 0;
                }
            }

            // 3. Hüllenschaden
            if (remainingDamage > 0) {
                isDestroyed = true;
                System.out.printf("💥 [%s] Katastrophale Hüllen-Umlagerung! Einheitsauflösung.%n", id);
            }
        }

