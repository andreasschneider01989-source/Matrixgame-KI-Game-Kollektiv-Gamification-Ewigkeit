// === GAMELOOP METHODE (Modular und kopierbar!) ===
private void startGameLoop() {
    Thread gameThread = new Thread(() -> {
        System.out.println("=== GAMELOOP GESTARTET ===");
        
        while (true) {
            try {
                gameLoop();
                Thread.sleep(100); // 100ms = 10 FPS (anpassbar)
            } catch (InterruptedException e) {
                e.printStackTrace();
                break;
            }
        }
    });
    gameThread.setDaemon(true);
    gameThread.start();
}

// === DIE EIGENTLICHE SIMULATIONSLOGIK ===
private void gameLoop() {
    // Durch alle Units gehen und updaten
    for (int i = 0; i < unitList.size(); i++) {
        Unit k = unitList.get(i);
        
        // Basis-Verhalten
        k.entropieMove();
        k.update();
        
        // Seltene zufällige Interaktion
        if (Math.random() > 0.999 && unitList.size() > 1) {
            int randomIndex = (int)(unitList.size() * Math.random());
            if (randomIndex != i) {
                k.randEntropie4(unitList.get(randomIndex));
            }
        }
        
        // === REplikation (kontrolliert) ===
        if (k.color.getRed() % 100 == 3 && Math.random() > 0.99) {
            Unit u2 = k.kopie();
            u2.x += (Math.random() - 0.5) * 20;
            u2.y += (Math.random() - 0.5) * 20;
            unitList.add(u2);
        }
    }
    
    simulationsSchritte++;
    
    // Info-Text aktualisieren (nur wenn Unit selektiert)
    if (selectedKugel != null) {
        SwingUtilities.invokeLater(() -> updateInfoText());
    }
    
    // Canvas neu zeichnen
    SwingUtilities.invokeLater(() -> repaint());
}

