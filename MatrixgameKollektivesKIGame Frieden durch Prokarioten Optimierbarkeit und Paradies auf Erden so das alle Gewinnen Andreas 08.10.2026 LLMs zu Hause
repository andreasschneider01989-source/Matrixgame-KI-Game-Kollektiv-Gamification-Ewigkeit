            double scaleS = FOCAL_LENGTH / (FOCAL_LENGTH + zRotS + Z_OFFSET);
            int sx = (int) (cx + xRotS * scaleS);
            int sy = (int) (cy + s.source.y * scaleS);

            double xRotT = s.target.x * Math.cos(angleY) - s.target.z * Math.sin(angleY);
            double zRotT = s.target.x * Math.sin(angleY) + s.target.z * Math.cos(angleY);
            double scaleT = FOCAL_LENGTH / (FOCAL_LENGTH + zRotT + Z_OFFSET);
            int tx = (int) (cx + xRotT * scaleT);
            int ty = (int) (cy + s.target.y * scaleT);

            // Transparenz basierend auf Gewicht (Kausalitätsstärke)
            int alpha = Math.min(255, Math.max(20, (int)(Math.abs(s.weight) * 200)));
            if (s.weight > 0) g2d.setColor(new Color(0, 150, 255, alpha)); // Konstruktiv
            else g2d.setColor(new Color(220, 20, 60, alpha)); // Destruktiv/Abwehr

            g2d.drawLine(sx, sy, tx, ty);
        }

        // 2. Neuronen (Knoten) zeichnen (nun korrekt sortiert)
        for (BioNeuron n : renderList) {
            double xRot = n.x * Math.cos(angleY) - n.z * Math.sin(angleY);
            double zRot = n.x * Math.sin(angleY) + n.z * Math.cos(angleY);
            double scale = FOCAL_LENGTH / (FOCAL_LENGTH + zRot + Z_OFFSET);
            
            int screenX = (int) (cx + xRot * scale);
            int screenY = (int) (cy + n.y * scale);
            int r = (int) (15 * scale); // Dynamischer Radius durch Perspektive

            // Selektiertes Neuron hervorheben
            if (n == selectedNeuron) {
                g2d.setColor(Color.YELLOW);
                g2d.fillOval(screenX - r - 4, screenY - r - 4, (r * 2) + 8, (r * 2) + 8);
            }

            // Membran leuchtet bei aktivem Filter auf
            if (fluprednidenFilterActive) {
                g2d.setColor(new Color(255, 255, 255, 50));
                g2d.fillOval(screenX - r - 2, screenY - r - 2, (r * 2) + 4, (r * 2) + 4);
            }

            g2d.setColor((n.type == 1) ? new Color(0, 150, 255) : new Color(220, 20, 60));
            g2d.fillOval(screenX - r, screenY - r, r * 2, r * 2);
            
            g2d.setColor(Color.WHITE);
            g2d.drawOval(screenX - r, screenY - r, r * 2, r * 2);
            
            // ID Label
            g2d.setFont(new Font("Monospaced", Font.PLAIN, Math.max(8, (int)(12 * scale))));
            g2d.drawString(String.valueOf(n.id), screenX + r + 2, screenY - r - 2);
        }

        // 3. Diagnose-HUD für selektiertes Neuron
        if (selectedNeuron != null) {
            drawDiagnosticHUD(g2d, getWidth(), getHeight());
        }
    }

    private void drawDiagnosticHUD(Graphics2D g2d, int width, int height) {
        int panelWidth = 300;
        int panelHeight = 220;
        int x = width - panelWidth - 20;
        int y = 20;

        g2d.setColor(new Color(0, 0, 0, 210));
        g2d.fillRoundRect(x, y, panelWidth, panelHeight, 15, 15);
        g2d.setColor(fluprednidenFilterActive ? Color.GREEN : Color.CYAN);
        g2d.setStroke(new BasicStroke(1.5f));
        g2d.drawRoundRect(x, y, panelWidth, panelHeight, 15, 15);

        g2d.setFont(new Font("Monospaced", Font.BOLD, 14));
        g2d.drawString("--- ZELL-DIAGNOSE ---", x + 15, y + 25);
        
        g2d.setFont(new Font("Monospaced", Font.PLAIN, 12));
        g2d.setColor(Color.WHITE);
        g2d.drawString("ID: " + selectedNeuron.id, x + 15, y + 50);
        g2d.drawString("Typ: " + (selectedNeuron.type > 0 ? "Evolutionär (Synthese)" : "Prokaryotisch (Abwehr)"), x + 15, y + 70);
        
        g2d.drawString("Membran-Filter: " + (fluprednidenFilterActive ? "OPEN (SYNC)" : "CLOSED"), x + 15, y + 90);

        // Membranpotenzial
        g2d.drawString("Zell-Resonanz: " + String.format("%.2f", selectedNeuron.potential), x + 15, y + 115);
        g2d.setColor(Color.DARK_GRAY);
        g2d.fillRect(x + 15, y + 125, 200, 10);
        g2d.setColor(selectedNeuron.type > 0 ? new Color(0, 150, 255) : new Color(220, 20, 60));
        g2d.fillRect(x + 15, y + 125, (int)(200 * (selectedNeuron.potential / selectedNeuron.threshold)), 10);

        // Kausalitäts-Zähler
        int inCount = 0; int outCount = 0;
        for (BioSynapse s : synapses) {
            if (s.target == selectedNeuron) inCount++;
            if (s.source == selectedNeuron) outCount++;
        }

        g2d.setColor(Color.WHITE);
        g2d.drawString("Eingehende Vektoren: " + inCount, x + 15, y + 155);
        g2d.drawString("Ausgehende Vektoren: " + outCount, x + 15, y + 175);
        
        if(fluprednidenFilterActive && selectedNeuron.type == -1) {
            g2d.setColor(Color.GREEN);
            g2d.drawString("STATUS: Vergebung aktiv...", x + 15, y + 200);
        }
    }

