### 📁 Modul 1: Die Kern-Engine & Der Validator (MatrixgameEngine.java)

*Enthält den progressiven Level-Generator (inkl. Bit-Shifts, Modulo, Logik) und den automatischen Validator für Reverse-Engineering.*

package ordner1;
import java.util.*;
public class MatrixgameEngine {
    // 1. DATENSTRUKTUR
    public static class LevelConfig {
        public final int levelNumber, minSteps, maxSteps, baseElo, minVal, maxVal;
        public final String[] variables, operations;
        public final boolean useConstants;
        public LevelConfig(int levelNumber, int minSteps, int maxSteps, String[] variables,
                           String[] operations, boolean useConstants, int minVal, int maxVal, int baseElo) {
            this.levelNumber = levelNumber; this.minSteps = minSteps; this.maxSteps = maxSteps;
            this.variables = variables; this.operations = operations; this.useConstants = useConstants;
            this.minVal = minVal; this.maxVal = maxVal; this.baseElo = baseElo;
        }
    }
    // 2. DIE FABRIK (Progressive Schwierigkeit)
    public static LevelConfig generiereLevel(int difficulty) {
        if (difficulty < 1) difficulty = 1;
        if (difficulty > 50) difficulty = 50;
        int minSteps = 2 + (difficulty / 12);
        int maxSteps = 2 + (difficulty / 10);
        String[] vars = (difficulty <= 15) ? new String[]{"X", "Y"} : new String[]{"X", "Y", "Z"};
        
        String[] ops;
        if (difficulty <= 10) ops = new String[]{"+", "-"};
        else if (difficulty <= 20) ops = new String[]{"+", "-", "*", "/"};
        else if (difficulty <= 28) ops = new String[]{"+", "-", "*", "/", "%"};
        else if (difficulty <= 35) ops = new String[]{"+", "-", "*", "/", "%", "AND", "OR", "XOR"};
        else if (difficulty <= 42) ops = new String[]{"+", "-", "*", "/", "%", "AND", "OR", "XOR", "<<", ">>"};
        else ops = new String[]{"+", "-", "*", "/", "%", "AND", "OR", "XOR", "<<", ">>", ">>>", ">", "<", "=="};
        int minVal, maxVal;
        if (difficulty <= 20) { minVal = 0; maxVal = 3; }
        else if (difficulty <= 35) { minVal = 0; maxVal = 15; } // 4-Bit Raum
        else { minVal = 0; maxVal = 31; } // 5-Bit Raum für Shifts
        return new LevelConfig(difficulty, minSteps, maxSteps, vars, ops, difficulty > 20, minVal, maxVal, 800 + (difficulty * 25));
    }
    // 3. GENERATOR & BERECHNUNG
    private static class Gleichung {
        final String name, links, operation, rechts;
        Gleichung(String name, String links, String operation, String rechts) {
            this.name = name; this.links = links; this.operation = operation; this.rechts = rechts;
        }
        String alsText() { return name + " = " + links + " " + operation + " " + rechts; }
    }
    public static List<Gleichung> erzeugeFormel(Random random, LevelConfig config) {
        int anzahlSchritte = random.nextInt(config.maxSteps - config.minSteps + 1) + config.minSteps;
        List<Gleichung> formel = new ArrayList<>();
        for (int i = 1; i <= anzahlSchritte; i++) {
            String name = "A" + i;
            String links, rechts;
            String op = config.operations[random.nextInt(config.operations.length)];
            
            if (i == 1) {
                links = config.variables[random.nextInt(config.variables.length)];
                List<String> andere = new ArrayList<>(Arrays.asList(config.variables));
                andere.remove(links);
                rechts = andere.get(random.nextInt(andere.size()));
            } else {
                links = "A" + (i - 1);
                if ((op.equals("<<") || op.equals(">>") || op.equals(">>>") || op.equals("%")) && config.useConstants && random.nextBoolean()) {
                    rechts = Integer.toString(random.nextInt(5) + 1); // Sichere Konstanten für Shifts/Modulo
                } else if (config.useConstants && random.nextBoolean()) {
                    rechts = Integer.toString(random.nextInt(config.maxVal - config.minVal + 1) + config.minVal);
                } else {
                    rechts = config.variables[random.nextInt(config.variables.length)];
                }
            }
            formel.add(new Gleichung(name, links, op, rechts));
        }
        return formel;
    }
    public static double berechne(Gleichung g, Map<String, Double> werte) {
        double a = werte.get(g.links);
        double b;
        try { b = Double.parseDouble(g.rechts); } catch (NumberFormatException e) { b = werte.getOrDefault(g.rechts, 0.0); }
        int ai = (int) a; int bi = (int) b; // Casting für Bit-Operationen
        switch (g.operation) {
            case "+": return a + b; case "-": return a - b; case "*": return a * b;
            case "/": return b != 0 ? a / b : a; case "%": return b != 0 ? a % b : a;
            case "AND": return ai & bi; case "OR": return ai | bi; case "XOR": return ai ^ bi;
            case "<<": return ai << (bi & 0x1F); case ">>": return ai >> (bi & 0x1F);
            case ">>>": return ai >>> (bi & 0x1F);
            case ">": return a > b ? 1.0 : 0.0; case "<": return a < b ? 1.0 : 0.0; case "==": return a == b ? 1.0 : 0.0;
            default: throw new IllegalStateException("Unbekannte Operation: " + g.operation);
        }
    }
    // 4. VALIDATOR (Option B: Interaktive Prüfung)
    public interface MatrixPlayer { double solve(double x, double y, double z); }
    public static void validiereLoesung(int level, MatrixPlayer spieler) {
        LevelConfig config = generiereLevel(level);
        Random random = new Random(42); // Deterministischer Seed für faire Tests
        List<Gleichung> formel = erzeugeFormel(random, config);
        String zielVariable = formel.get(formel.size() - 1).name;
        int korrekt = 0;
        System.out.println("🛡️ Starte Black-Box-Test für Level " + level + " (20 Messungen)...");
        for (int i = 1; i <= 20; i++) {
            Map<String, Double> werte = new LinkedHashMap<>();
            for (String v : new String[]{"X", "Y", "Z"}) {
                werte.put(v, Arrays.asList(config.variables).contains(v) ? (random.nextInt(config.maxVal - config.minVal + 1) + config.minVal) : 0.0);
            }
            for (Gleichung g : formel) werte.put(g.name, berechne(g, werte));
            
            double erwartet = werte.get(zielVariable);
            double spielerResultat = spieler.solve(werte.get("X"), werte.get("Y"), werte.get("Z"));
            
            if (Math.abs(erwartet - spielerResultat) < 0.0001) { korrekt++; }
        }
        
        System.out.println("📊 Ergebnis: " + korrekt + " / 20 Messungen korrekt.");
        if (korrekt == 20) System.out.println("✅ Perfekt! Black-Box reverse-engineered. Elo-Gewinn: +" + (config.baseElo / 10));
        else System.out.println("⚠️ Dein Code enthält noch logische Fehler oder Edge-Cases.");
    }
}

### 📁 Modul 2: Die Einheit & Strategie (Unit.java)

*Entkoppelt die KI-Logik vom Datenmodell mittels Strategy Pattern. Enthält die präzise JSON-Logging-Funktion für KI-Parsbarkeit.*

package ordner1;
import java.util.List;
public class Unit {
    public double id, posX, posY, posZ, vx, vy, vz, mass = 1.0, radius = 10.0;
    public double leben = 100.0, maxLeben = 100.0, damage = 10.0;
    public boolean isSelected = false, isAlive = true;
    public String typ = "Standard";
    
    // Strategy Pattern: Verhalten wird von außen injiziert
    public UnitBehavior behavior; 
    public interface UnitBehavior {
        void execute(Unit self, List<Unit> allUnits, long tick);
    }
    // Standard-Verhalten: Patrouille / Warten
    public static class WartenBehavior implements UnitBehavior {
        public void execute(Unit self, List<Unit> allUnits, long tick) {
            // Minimale Entropie-Bewegung
            self.posX += (Math.random() - 0.5) * 0.5;
            self.posY += (Math.random() - 0.5) * 0.5;
        }
    }
    // Präzises, KI-parsbares Logging (vermeidet Halluzinationen bei der Auswertung)
    public void logState(long tick) {
        System.out.printf(java.util.Locale.US, 
            "{\"tick\": %d, \"event\": \"STATE\", \"id\": %.0f, \"x\": %.2f, \"y\": %.2f, \"hp\": %.1f, \"alive\": %b}%n",
            tick, this.id, this.posX, this.posY, this.leben, this.isAlive);
    }
}

### 📁 Modul 3: Die Simulations-Umgebung (MatrixgameSimulation.java)

*Das Swing-Canvas mit Zoom, Pan, Drag-Selektion, Rechtsklick-Befehlen und dem optimierten Game Loop.*

package ordner1;
import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.List;
import java.util.concurrent.CopyOnWriteArrayList;
public class MatrixgameSimulation extends JPanel {
    public List<Unit> unitList = new CopyOnWriteArrayList<>();
    private double zoomFactor = 1.0, panX = 0, panY = 0;
    private static final double ZOOM_STEP = 1.2;
    private double globalEntropyPool = 100.0;
    private long simulationTicks = 0;
    private int dragStartX = -1, dragStartY = -1;
    private boolean isDragging = false;
    public MatrixgameSimulation() {
        setPreferredSize(new Dimension(1200, 800));
        setBackground(new Color(15, 15, 20));
        initUnits();
        setupInput();
        startGameLoop();
    }
    private void initUnits() {
        for (int i = 0; i < 20; i++) {
            Unit u = new Unit();
            u.id = i;
            u.posX = (Math.random() - 0.5) * 400;
            u.posY = (Math.random() - 0.5) * 400;
            u.behavior = new Unit.WartenBehavior(); // Strategie injizieren
            unitList.add(u);
        }
    }
    private void setupInput() {
        MouseAdapter input = new MouseAdapter() {
            public void mousePressed(MouseEvent e) {
                if (SwingUtilities.isMiddleMouseButton(e) || (SwingUtilities.isLeftMouseButton(e) && e.isControlDown())) {
                    isDragging = true; dragStartX = e.getX(); dragStartY = e.getY();
                } else if (SwingUtilities.isLeftMouseButton(e)) {
                    handleSelection(e);
                } else if (SwingUtilities.isRightMouseButton(e)) {
                    handleCommand(e);
                }
            }
            public void mouseDragged(MouseEvent e) {
                if (isDragging) {
                    panX += e.getX() - dragStartX;
                    panY += e.getY() - dragStartY;
                    dragStartX = e.getX(); dragStartY = e.getY();
                    repaint();
                }
            }
            public void mouseReleased(MouseEvent e) { isDragging = false; }
            public void mouseWheelMoved(MouseWheelEvent e) {
                double oldZoom = zoomFactor;
                zoomFactor *= (e.getWheelRotation() < 0) ? ZOOM_STEP : 1.0 / ZOOM_STEP;
                // Zoom auf Mauszeiger zentrieren
                panX = e.getX() - (e.getX() - panX) * (zoomFactor / oldZoom);
                panY = e.getY() - (e.getY() - panY) * (zoomFactor / oldZoom);
                repaint();
            }
        };
        addMouseListener(input);
        addMouseMotionListener(input);
        addMouseWheelListener(input);
    }
    private void handleSelection(MouseEvent e) {
        double wx = (e.getX() - getWidth() / 2.0 - panX) / zoomFactor;
        double wy = -(e.getY() - getHeight() / 2.0 - panY) / zoomFactor;
        boolean found = false;
        for (Unit u : unitList) {
            if (Math.hypot(wx - u.posX, wy - u.posY) <= u.radius) {
                if (!e.isShiftDown()) for (Unit other : unitList) other.isSelected = false;
                u.isSelected = !u.isSelected;
                found = true; break;
            }
        }
        if (!found && !e.isShiftDown()) for (Unit u : unitList) u.isSelected = false;
        repaint();
    }
    private void handleCommand(MouseEvent e) {
        double targetX = (e.getX() - getWidth() / 2.0 - panX) / zoomFactor;
        double targetY = -(e.getY() - getHeight() / 2.0 - panY) / zoomFactor;
        for (Unit u : unitList) {
            if (u.isSelected) {
                System.out.printf(">>> [KOMMANDO] Unit %.0f bewegt zu (%.1f, %.1f)%n", u.id, targetX, targetY);
                // Hier könnte eine neue Behavior (z.B. MoveToBehavior) injiziert werden
            }
        }
    }
    private void startGameLoop() {
        Timer timer = new Timer(50, e -> {
            simulationTicks++;
            if (globalEntropyPool < 100.0) globalEntropyPool += 0.05;
            
            for (Unit u : unitList) {
                if (u.isAlive && u.behavior != null) {
                    u.behavior.execute(u, unitList, simulationTicks);
                    // Probabilistisches Logging (alle 60 Ticks = ca. 3x pro Sekunde)
                    if (simulationTicks % 60 == 0) u.logState(simulationTicks);
                }
            }
            repaint();
        });
        timer.start();
    }
    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        int cx = getWidth() / 2 + (int) panX;
        int cy = getHeight() / 2 + (int) panY;
        // Achsen
        g2.setColor(new Color(50, 50, 60));
        g2.drawLine(0, cy, getWidth(), cy);
        g2.drawLine(cx, 0, cx, getHeight());
        // Units zeichnen
        for (Unit u : unitList) {
            if (!u.isAlive) continue;
            int sx = cx + (int) (u.posX * zoomFactor);
            int sy = cy - (int) (u.posY * zoomFactor); // Y ist in Swing nach unten positiv, wir invertieren es für math. Koordinaten
            g2.setColor(u.isSelected ? Color.YELLOW : new Color(0, 255, 128));
            g2.fillOval(sx - (int)(u.radius * zoomFactor), sy - (int)(u.radius * zoomFactor), 
                        (int)(u.radius * 2 * zoomFactor), (int)(u.radius * 2 * zoomFactor));
            
            // HP Balken
            g2.setColor(Color.RED);
            g2.fillRect(sx - 15, sy - (int)(u.radius * zoomFactor) - 10, 30, 4);
            g2.setColor(Color.GREEN);
            g2.fillRect(sx - 15, sy - (int)(u.radius * zoomFactor) - 10, (int)(30 * (u.leben / u.maxLeben)), 4);
        }
        // UI Overlay
        g2.setColor(new Color(0, 255, 128));
        g2.setFont(new Font("Monospaced", Font.BOLD, 14));
        g2.drawString(String.format("Matrixgame Simulation | Ticks: %d | Entropie: %.1f", simulationTicks, globalEntropyPool), 20, 30);
        drawInspector(g2);
    }
    private void drawInspector(Graphics2D g2) {
        int x = getWidth() - 320, y = 20;
        g2.setColor(new Color(20, 20, 20, 220));
        g2.fillRect(x, y, 300, 250);
        g2.setColor(new Color(0, 255, 128));
        g2.drawRect(x, y, 300, 250);
        g2.setFont(new Font("Monospaced", Font.BOLD, 12));
        g2.drawString("=== INSPEKTOR ===", x + 10, y + 25);
        
        int count = 0, yOffset = y + 50;
        for (Unit u : unitList) {
            if (u.isSelected && count < 4) {
                g2.drawString(String.format("ID: %.0f | HP: %.1f", u.id, u.leben), x + 10, yOffset);
                yOffset += 20;
                count++;
            }
        }
        if (count == 0) g2.drawString("Keine Einheit ausgewählt.", x + 10, y + 50);
    }
    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            JFrame frame = new JFrame("Matrixgame: Kollektive Simulation");
            frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
            frame.add(new MatrixgameSimulation());
            frame.pack();
            frame.setLocationRelativeTo(null);
            frame.setVisible(true);
        });
    }
}

