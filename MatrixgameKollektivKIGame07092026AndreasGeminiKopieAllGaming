/**

 * MatrixGameEngine.java

 *

 * Java 17+ single-file prototype for a programmable Matrix/KI Game.

 *

 * Design principles:

 * - Physical equations remain separate from game scoring.

 * - Game scores are explicit models, not physical laws.

 * - All important quantities are normalized/clamped to reduce runaway rewards.

 * - Objects, agents, actions, measurements and rules are data-oriented enough

 * to become a later ECS / JSON / database architecture.

 *

 * Compile:

 * javac MatrixGameEngine.java

 *

 * Run:

 * java MatrixGameEngine

 */

public class MatrixGameEngine {

    // ---------- Physical constants ----------

    static final double G = 6.67430e-11; // m^3 kg^-1 s^-2

    static final class Vec3 {

        double x, y, z;

        Vec3(double x, double y, double z) {

            this.x = x; this.y = y; this.z = z;

        }

        Vec3 add(Vec3 b) { return new Vec3(x + b.x, y + b.y, z + b.z); }

        Vec3 sub(Vec3 b) { return new Vec3(x - b.x, y - b.y, z - b.z); }

        Vec3 mul(double k) { return new Vec3(x * k, y * k, z * k); }

        double norm() {

            return Math.sqrt(x*x + y*y + z*z);

        }

        Vec3 normalized() {

            double n = norm();

            return n == 0 ? new Vec3(0,0,0) : mul(1.0 / n);

        }

        @Override public String toString() {

            return "(%.3f, %.3f, %.3f)".formatted(x, y, z);

        }

    }

    // ---------- Universal simulation object ----------

    static final class Body {

        final String id;

        double massKg;

        Vec3 positionM;

        Vec3 velocityMps;

        boolean alive = true;

        Body(String id, double massKg, Vec3 positionM, Vec3 velocityMps) {

            this.id = id;

            this.massKg = massKg;

            this.positionM = positionM;

            this.velocityMps = velocityMps;

        }

        double kineticEnergyJ() {

            double v = velocityMps.norm();

            return 0.5 * massKg * v * v;

        }

    }

    // ---------- Agent / player model ----------

    static final class Player {

        final String id;

        final String name;

        // 0..100 game attributes. These are model variables, not diagnoses.

        double knowledge = 20;

        double curiosity = 50;

        double competence = 20;

        double cooperation = 50;

        double reliability = 50;

        double autonomy = 50;

        double relatedness = 50;

        double wellbeing = 50;

        double sustainability = 50;

        double creativity = 50;

        long xp = 0;

        double score = 0;

        Player(String id, String name) {

            this.id = id;

            this.name = name;

        }

        double motivationIndex() {

            // Inspired by Self-Determination Theory: autonomy, competence,

            // relatedness. This is a game metric, not a clinical measure.

            return mean(autonomy, competence, relatedness);

        }

        double learningIndex() {

            return mean(knowledge, competence, curiosity);

        }

        double collectiveImpactIndex() {

            return geometricMean(

                sustainability / 100.0,

                cooperation / 100.0,

                reliability / 100.0,

                knowledge / 100.0

            ) * 100.0;

        }

        double compositeScore() {

            // Balanced score: avoids allowing one dimension to dominate.

            return 0.25 * learningIndex()

                 + 0.25 * motivationIndex()

                 + 0.30 * collectiveImpactIndex()

                 + 0.20 * wellbeing;

        }

        void addLearning(double evidenceQuality, double novelty, double effort) {

            // Diminishing returns: repeated identical actions add less.

            double gain = 8.0 * clamp(evidenceQuality, 0, 1)

                              * clamp(novelty, 0, 1)

                              * clamp(effort, 0, 1);

            knowledge = clamp(knowledge + gain * (1.0 - knowledge / 120.0), 0, 100);

            competence = clamp(competence + 0.7 * gain, 0, 100);

            curiosity = clamp(curiosity + 0.35 * gain, 0, 100);

            awardXP((long)Math.round(20 + 80 * gain / 8.0));

        }

        void cooperate(double contributionQuality, double reciprocity) {

            double gain = 6.0 * clamp(contributionQuality, 0, 1)

                              * clamp(reciprocity, 0, 1);

            cooperation = clamp(cooperation + gain, 0, 100);

            relatedness = clamp(relatedness + 0.8 * gain, 0, 100);

            reliability = clamp(reliability + 0.5 * gain, 0, 100);

            awardXP((long)Math.round(25 + 75 * gain / 6.0));

        }

        void sustainableAction(double benefit, double externality) {

            // benefit: useful effect, externality: normalized harm/cost.

            double net = clamp(benefit, 0, 1) - clamp(externality, 0, 1);

            sustainability = clamp(sustainability + 8 * net, 0, 100);

            wellbeing = clamp(wellbeing + 3 * net, 0, 100);

            awardXP((long)Math.round(20 + 80 * clamp(net, 0, 1)));

        }

        void awardXP(long amount) {

            xp += Math.max(0, amount);

        }

    }

    // ---------- Action / measurement layer ----------

    record Action(

        String actorId,

        String type,

        double evidenceQuality, // 0..1

        double novelty, // 0..1

        double cooperation, // 0..1

        double sustainability, // 0..1

        double effort, // 0..1

        boolean verified

    ) {}

    record Evaluation(

        double quality,

        double collectiveBenefit,

        double risk,

        long xp,

        double scoreDelta

    ) {}

    static Evaluation evaluate(Action a) {

        double verification = a.verified ? 1.0 : 0.65;

        double quality =

                0.30 * a.evidenceQuality +

                0.15 * a.novelty +

                0.20 * a.cooperation +

                0.20 * a.sustainability +

                0.15 * a.effort;

        // Reward collective benefit while explicitly penalizing risk.

        double collectiveBenefit =

                0.40 * a.evidenceQuality +

                0.30 * a.cooperation +

                0.30 * a.sustainability;

        double risk =

                0.55 * (1.0 - a.evidenceQuality) +

                0.25 * (1.0 - a.sustainability) +

                0.20 * (1.0 - verification);

        long xp = Math.round(100 * quality * verification * (1.0 - 0.5 * risk));

        double scoreDelta = 100.0 * (0.65 * collectiveBenefit + 0.35 * quality)

                                  * (1.0 - 0.5 * risk);

        return new Evaluation(quality, collectiveBenefit, risk, Math.max(0, xp), scoreDelta);

    }

    // ---------- Newtonian two-body gravity ----------

    static Vec3 gravitationalAcceleration(Body target, Body source) {

        Vec3 delta = source.positionM.sub(target.positionM);

        double r = delta.norm();

        if (r == 0) {

            throw new IllegalArgumentException("Bodies cannot occupy the same point.");

        }

        // a = G * M_source / r^2, directed toward the source.

        // Equivalent vector form:

        // a_vec = G * M_source * delta / r^3

        return delta.mul(G * source.massKg / Math.pow(r, 3));

    }

    static void integrateEuler(Body body, Vec3 acceleration, double dtSeconds) {

        body.velocityMps = body.velocityMps.add(acceleration.mul(dtSeconds));

        body.positionM = body.positionM.add(body.velocityMps.mul(dtSeconds));

    }

    // ---------- Entropy proxy ----------

    static double shannonEntropy(double[] probabilities) {

        double h = 0;

        for (double p : probabilities) {

            if (p > 0) h -= p * Math.log(p) / Math.log(2);

        }

        return h;

    }

    // ---------- Text-adventure layer ----------

    static final class Adventure {

        final Player player;

        Adventure(Player player) { this.player = player; }

        void start() {

            System.out.println("\n=== MATRIX GAME: ORBIT OF KNOWLEDGE ===");

            System.out.println("Mission: Improve the system without sacrificing truth.");

            System.out.println("Available actions: OBSERVE, TEST, COOPERATE, BUILD, RESTORE");

            System.out.println("Rule: claims earn more XP when they are testable, reproducible and useful.\n");

        }

        void choose(String command) {

            switch (command.toUpperCase(Locale.ROOT)) {

                case "OBSERVE" -> {

                    player.addLearning(0.85, 0.40, 0.45);

                    System.out.println("Observation logged. +knowledge, +XP");

                }

                case "TEST" -> {

                    player.addLearning(1.00, 0.75, 0.90);

                    System.out.println("Hypothesis tested. +competence, +XP");

                }

                case "COOPERATE" -> {

                    player.cooperate(0.90, 0.90);

                    System.out.println("A useful contribution was shared. +cooperation, +XP");

                }

                case "BUILD" -> {

                    player.sustainableAction(0.90, 0.10);

                    System.out.println("A constructive intervention was simulated. +sustainability, +XP");

                }

                case "RESTORE" -> {

                    player.sustainableAction(0.75, 0.05);

                    player.wellbeing = clamp(player.wellbeing + 2, 0, 100);

                    System.out.println("System restored. +wellbeing, +sustainability");

                }

                default -> System.out.println("Unknown action.");

            }

        }

    }

    // ---------- Utility functions ----------

    static double clamp(double x, double lo, double hi) {

        return Math.max(lo, Math.min(hi, x));

    }

    static double mean(double... xs) {

        return Arrays.stream(xs).average().orElse(0);

    }

    static double geometricMean(double... xs) {

        double product = 1.0;

        for (double x : xs) product *= Math.max(1e-12, x);

        return Math.pow(product, 1.0 / xs.length);

    }

    static void printPlayer(Player p) {

        System.out.printf(Locale.ROOT,

            "\nPLAYER %s%nXP=%d%nScore=%.2f%nKnowledge=%.1f Competence=%.1f Curiosity=%.1f%n" +

            "Cooperation=%.1f Reliability=%.1f Autonomy=%.1f Relatedness=%.1f%n" +

            "Wellbeing=%.1f Sustainability=%.1f Creativity=%.1f%n" +

            "MotivationIndex=%.2f LearningIndex=%.2f CollectiveImpact=%.2f%n",

            p.name, p.xp, p.score, p.knowledge, p.competence, p.curiosity,

            p.cooperation, p.reliability, p.autonomy, p.relatedness,

            p.wellbeing, p.sustainability, p.creativity,

            p.motivationIndex(), p.learningIndex(), p.collectiveImpactIndex());

    }

    public static void main(String[] args) {

        System.out.println("=== MATRIXGAME ENGINE v0.1 ===");

        // 1) Physics demonstration

        Body earth = new Body(

            "Earth", 5.972e24,

            new Vec3(0, 0, 0),

            new Vec3(0, 0, 0)

        );

        Body satellite = new Body(

            "Satellite", 1000,

            new Vec3(7_000_000, 0, 0),

            new Vec3(0, 7546, 0)

        );

        Vec3 a = gravitationalAcceleration(satellite, earth);

        System.out.printf(Locale.ROOT,

            "Gravity acceleration at satellite: %s m/s^2%n", a);

        // One small simulation step.

        integrateEuler(satellite, a, 1.0);

        System.out.printf(Locale.ROOT,

            "Satellite position after 1 s: %s m%n", satellite.positionM);

        // 2) Information/entropy demonstration

        double entropy = shannonEntropy(new double[]{0.25, 0.25, 0.25, 0.25});

        System.out.printf(Locale.ROOT, "Shannon entropy: %.3f bit%n", entropy);

        // 3) Player + scoring

        Player andreas = new Player("P1", "Player");

        Adventure game = new Adventure(andreas);

        game.start();

        game.choose("OBSERVE");

        game.choose("TEST");

        game.choose("COOPERATE");

        game.choose("BUILD");

        Action verifiedResearch = new Action(

            andreas.id,

            "RESEARCH",

            0.95, // evidence

            0.80, // novelty

            0.90, // cooperation

            0.90, // sustainability

            0.85, // effort

            true

        );

        Evaluation e = evaluate(verifiedResearch);

        andreas.awardXP(e.xp);

        andreas.score += e.scoreDelta;

        System.out.printf(Locale.ROOT,

            "\nEvaluation: quality=%.3f collectiveBenefit=%.3f risk=%.3f XP=%d scoreDelta=%.2f%n",

            e.quality(), e.collectiveBenefit(), e.risk(), e.xp(), e.scoreDelta());

