public class MatrixGameLoop {

    public record GameState(
        double flowResistance,    // Rf -> 0
        double collectiveWellbeing,// 0..100
        double knowledgeIndex,    // 0..100
        boolean winWinState
    ) {}

    public static GameState processAction(String actionType, double effort, double evidence) {
        // Flusswiderstand sinkt mit steigender Evidenz und guter Didaktik
        double newResistance = Math.max(0.0, 10.0 - (evidence * 8.0) - (effort * 2.0));
        
        // Das Wohlbefinden steigt, wenn Reibung abgebaut wird
        double newWellbeing = Math.min(100.0, 50.0 + (10.0 - newResistance) * 5.0);
        
        // Win-Win tritt ein, wenn Evidenz hoch und Reibung niedrig ist
        boolean isWinWin = (evidence > 0.8 && newResistance < 2.0);

        return new GameState(newResistance, newWellbeing, 85.0, isWinWin);
    }

    public static void main(String[] args) {
        System.out.println("=== INITIALISIERE MATRIXGAME LEVEL 3 ===");
        GameState state = processAction("OPTIMIZE_DIDACTICS", 0.9, 0.95);
        System.out.printf("Flusswiderstand: %.2f | Wohlbefinden: %.2f | Win-Win: %b%n",
                state.flowResistance(), state.collectiveWellbeing(), state.winWinState());
    }
}

