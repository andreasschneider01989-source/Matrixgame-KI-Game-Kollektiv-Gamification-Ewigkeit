### **📌 Modul 2: Aufgaben-Generierung (`tasks/TaskGenerator.java`)**
**Verantwortung:**
- Dynamische Erstellung von Aufgaben (Mathe, Logik, Lumini, etc.)
- Verwaltung der Aufgaben-Typen und Schwierigkeitsgrade

```java
package tasks;

import math.LuminiNumber;
import java.util.Random;

public class TaskGenerator {
    private Random random = new Random();
    private int level;
    private int[] usedTasks; // Verfolgte Aufgaben, um Wiederholungen zu vermeiden

    public TaskGenerator(int level) {
        this.level = level;
        this.usedTasks = new int[100]; // 100 mögliche Aufgaben-Typen
        Arrays.fill(usedTasks, 0); // 0 = nicht verwendet, -1 = verwendet
    }

    /**
     * Generiert eine zufällige Aufgabe basierend auf dem Level.
     * @return Task-Objekt mit Frage, erwarteter Antwort und Typ
     */
    public Task generateTask() {
        int taskType = random.nextInt(55); // 55 mögliche Aufgabentypen (0-54)
        while (usedTasks[taskType] == -1) {
            taskType = random.nextInt(55);
        }
        usedTasks[taskType] = -1;

        switch (taskType) {
            case 0: return generateMultiplicationTask();
            case 1: return generateDivisionTask();
            case 2: return generateAdditionTask();
            case 3: return generateSubtractionTask();
            case 4: return generatePowerTask();
            case 5: return generateBinaryTask();
            case 38: return generateLuminiConversionTask();
            case 40: return generateLuminiAdditionTask();
            case 42: return generateLuminiMultiplicationTask();
            // ... weitere Aufgaben-Typen
            default: return generateDefaultTask();
        }
    }

    private Task generateMultiplicationTask() {
        int x1 = random.nextInt(9 + 2 * level) - random.nextInt(9 + 2 * level);
        int x2 = random.nextInt(9 + 2 * level) - random.nextInt(9 + 2 * level);
        int answer = x1 * x2;
        return new Task(
            "Normale Multiplikation: " + x1 + " * " + x2,
            String.valueOf(answer),
            TaskType.MATH
        );
    }

    private Task generateLuminiConversionTask() {
        int number = random.nextInt(5 * (int) Math.pow(2, level));
        String lumini = LuminiNumber.longToNewLumini(number, 2);
        return new Task(
            "Konvertiere Lumini-Zahl (Basis 2) in Dezimal: " + lumini,
            String.valueOf(number),
            TaskType.LUMINI
        );
    }

    private Task generateLuminiAdditionTask() {
        int x1 = random.nextInt(3 * (int) Math.pow(2, level));
        int x2 = random.nextInt(3 * (int) Math.pow(2, level));
        String lumini1 = LuminiNumber.longToNewLumini(x1, 2);
        String lumini2 = LuminiNumber.longToNewLumini(x2, 2);
        String luminiResult = LuminiNumber.longToNewLumini(x1 + x2, 2);
        return new Task(
            "Lumini-Addition (Basis 2): " + lumini1 + " + " + lumini2,
            luminiResult,
            TaskType.LUMINI
        );
    }

    // ... weitere Methoden für andere Aufgabentypen
}
```

