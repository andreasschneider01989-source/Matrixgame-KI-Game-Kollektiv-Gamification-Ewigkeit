### **📌 Modul 3: Scoring & Gamification (`tasks/ScoringSystem.java`)**
**Verantwortung:**
- Highscore-Verwaltung
- Level-System
- Zeitbegrenzung & Circuit Breaker

```java
package tasks;

public class ScoringSystem {
    private String[][] highscores = new String[20][2]; // [Punkte][Name]
    private int level = 1;
    private double points = 0;
    private int consecutiveErrors = 0;
    private long bonusTime = 0;

    // Fügt einen neuen Highscore hinzu
    public void addHighscore(double points, String name) {
        for (int i = 0; i < highscores.length; i++) {
            if (highscores[i][0] == null || points > Double.parseDouble(highscores[i][0])) {
                // Verschiebe bestehende Highscores nach unten
                for (int j = highscores.length - 1; j > i; j--) {
                    highscores[j][0] = highscores[j - 1][0];
                    highscores[j][1] = highscores[j - 1][1];
                }
                highscores[i][0] = String.valueOf(points);
                highscores[i][1] = name;
                break;
            }
        }
    }

    // Zeigt die Highscores an
    public void displayHighscores() {
        System.out.println("=== HIGHSCORES ===");
        for (int i = 0; i < highscores.length; i++) {
            if (highscores[i][0] != null) {
                System.out.println((i + 1) + ". " + highscores[i][1] + " - " + highscores[i][0] + " Punkte");
            }
        }
    }

    // Aktualisiert die Punkte und prüft Level-Aufstieg
    public boolean updatePoints(double additionalPoints) {
        points += additionalPoints;
        if (points >= level * 10) {
            bonusTime += (60000 - (System.currentTimeMillis() % 60000)); // Bonuszeit für nächstes Level
            level++;
            points = 0;
            return true; // Levelaufstieg
        }
        return false;
    }

    // Circuit Breaker: Zu viele Fehler in Folge
    public void incrementErrors() {
        consecutiveErrors++;
        if (consecutiveErrors >= 5) {
            System.out.println("5 Fehlversuche in Folge! Circuit Breaker aktiviert.");
            System.out.println("Bitte 15 Sekunden Pause einlegen...");
            try {
                Thread.sleep(15000);
            } catch (InterruptedException e) {
                Thread.currentThread().interrupt();
            }
            consecutiveErrors = 0;
        }
    }

    public void resetErrors() {
        consecutiveErrors = 0;
    }

    // Getter/Setter
    public int getLevel() { return level; }
    public double getPoints() { return points; }
    public long getBonusTime() { return bonusTime; }
}
```

