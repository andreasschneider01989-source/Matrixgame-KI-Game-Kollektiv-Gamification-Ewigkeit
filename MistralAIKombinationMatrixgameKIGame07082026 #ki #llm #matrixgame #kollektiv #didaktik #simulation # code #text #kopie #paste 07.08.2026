### **📌 Modul 1: Lumini-Zahlensystem (`math/LuminiNumber.java`)**
**Verantwortung:**
- Konvertierung zwischen Dezimal ↔ Lumini (Basis 2, n)
- Lumini-spezifische Arithmetik (z. B. `luminiMul`, `hoch`)

```java
package math;

import java.util.Arrays;

public class LuminiNumber {
    // Basis für Lumini (Standard: 2)
    private static final int DEFAULT_BASE = 2;

    /**
     * Konvertiert eine long-Zahl in eine Lumini-Darstellung (Basis 2 oder n).
     * @param input Die zu konvertierende Zahl
     * @param basis Die Basis für Lumini (Standard: 2)
     * @return Lumini-String (z. B. "001" für 1 in Basis 2)
     */
    public static String longToNewLumini(long input, int basis) {
        if (input < 0) {
            return "-" + longToNewLumini(-input, basis);
        }
        if (input == 0) {
            return "0";
        }

        long currentLength = 1;
        long bucketSize = basis;

        while (input >= bucketSize) {
            input -= bucketSize;
            currentLength++;
            bucketSize *= basis;
        }

        String output = longToBasisNString(input, basis, false);
        while (output.length() < currentLength) {
            output = "0" + output;
        }
        return output;
    }

    /**
     * Konvertiert eine Lumini-Zahl (Basis n) zurück in eine Dezimalzahl.
     * @param luminiNumber Lumini-String (z. B. "001")
     * @param basis Basis der Lumini-Zahl
     * @return Dezimalwert
     */
    public static long newLuminiToDecimal(String luminiNumber, int basis) {
        long decimal = 0;
        long bucketSize = basis;
        int currentLength = 1;

        // Berechne die Länge der Lumini-Zahl
        while (bucketSize <= luminiNumber.length()) {
            bucketSize *= basis;
            currentLength++;
        }

        // Konvertiere den Lumini-String in Dezimal
        long value = Long.parseLong(luminiNumber, basis);
        long total = 0;

        // Addiere die Bucket-Größen für die Länge
        for (int i = 1; i < currentLength; i++) {
            total += Math.pow(basis, i);
        }

        return total + value;
    }

    // Hilfsfunktion: Konvertiert long in Basis-n-String
    private static String longToBasisNString(long value, int basis, boolean withBase) {
        if (value == 0) {
            return "0";
        }
        StringBuilder sb = new StringBuilder();
        while (value != 0) {
            long modulo = value % basis;
            sb.append(modulo);
            value = value / basis;
        }
        String output = sb.reverse().toString();
        return withBase ? output + "(Basis:" + basis + ")" : output;
    }

    // Lumini-spezifische Multiplikation: (-1) * (-1) = -1
    public static int luminiMul(int a, int b) {
        int product = a * b;
        if ((a < 0 || b < 0) && !(a < 0 && b < 0)) {
            product = -Math.abs(product);
        }
        return product;
    }

    // Lumini-spezifische Potenzierung
    public static int hoch(int basis, int exponent) {
        boolean negativ = basis < 0;
        basis = Math.abs(basis);
        int result = (int) Math.pow(basis, exponent);
        return negativ ? -result : result;
    }
}
```

