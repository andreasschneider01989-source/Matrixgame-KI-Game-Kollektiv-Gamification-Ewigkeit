## 🔷 **5. DAS KOLLEKTIVE KI-GAME: MAIN-KLASSE**
```java
import math.LuminiNumber;
import tasks.*;
import physics.*;
import biology.*;
import ai.*;
import java.util.Scanner;

public class MatrixgameCollectiveKIGame {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        ScoringSystem scoringSystem = new ScoringSystem();
        TaskGenerator taskGenerator = new TaskGenerator(1);
        LMAgent aiAgent = new LMAgent("MistralAI", taskGenerator, scoringSystem);
        ImmuneSystem immuneSystem = new ImmuneSystem();

        System.out.println("=== WILLKOMMEN ZUM MATRIXGAME-KI-GAME ===");
        System.out.println("1. Allein spielen");
        System.out.println("2. Mit KI-Agent spielen");
        System.out.println("3. Highscores anzeigen");
        System.out.print("Wähle eine Option: ");

        int choice = scanner.nextInt();
        switch (choice) {
            case 1:
                playSolo(scanner, taskGenerator, scoringSystem);
                break;
            case 2:
                playWithAI(scanner, taskGenerator, scoringSystem, aiAgent);
                break;
            case 3:
                scoringSystem.displayHighscores();
                break;
        }
    }

    private static void playSolo(Scanner scanner, TaskGenerator taskGenerator, ScoringSystem scoringSystem) {
        while (true) {
            Task task = taskGenerator.generateTask();
            System.out.println("\n[Aufgabe] " + task.getQuestion());
            System.out.print("Deine Antwort: ");
            String answer = scanner.nextLine();

            if (answer.equals(task.getCorrectAnswer())) {
                System.out.println("✅ Richtig!");
                scoringSystem.updatePoints(1.0);
                scoringSystem.resetErrors();
            } else {
                System.out.println("❌ Falsch! Richtige Antwort: " + task.getCorrectAnswer());
                scoringSystem.incrementErrors();
            }

            System.out.println("Aktuelle Punkte: " + scoringSystem.getPoints());
            System.out.println("Level: " + scoringSystem.getLevel());
            System.out.print("Weiter? (j/n): ");
            if (!scanner.nextLine().equalsIgnoreCase("j")) {
                break;
            }
        }
    }

    private static void playWithAI(Scanner scanner, TaskGenerator taskGenerator, ScoringSystem scoringSystem, LMAgent aiAgent) {
        System.out.println("\n[KI-Modus aktiviert]");
        while (true) {
            // KI generiert eine Aufgabe
            Task task = aiAgent.generateTask();

            // Spieler oder KI löst die Aufgabe
            System.out.print("Soll die KI die Aufgabe lösen? (j/n): ");
            if (scanner.nextLine().equalsIgnoreCase("j")) {
                aiAgent.solveTask(task);
            } else {
                System.out.print("Deine Antwort: ");
                String answer = scanner.nextLine();
                if (answer.equals(task.getCorrectAnswer())) {
                    System.out.println("✅ Richtig!");
                    scoringSystem.updatePoints(1.0);
                    scoringSystem.resetErrors();
                } else {
                    System.out.println("❌ Falsch! Richtige Antwort: " + task.getCorrectAnswer());
                    scoringSystem.incrementErrors();
                }
            }

            System.out.println("Aktuelle Punkte: " + scoringSystem.getPoints());
            System.out.print("Weiter? (j/n): ");
            if (!scanner.nextLine().equalsIgnoreCase("j")) {
                break;
            }
        }
    }
}
```

