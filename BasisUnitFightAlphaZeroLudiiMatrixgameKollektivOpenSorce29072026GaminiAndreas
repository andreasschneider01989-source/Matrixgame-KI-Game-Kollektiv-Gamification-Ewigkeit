        this.posX = posX;
        this.posY = posY;
        this.team = team;
        
        // Physikalische und spielmechanische Anpassungen für Gebäude
        this.speed = 0;             // Gebäude bewegen sich nicht
        this.size = 25;             // Optisch größer als Standard-Einheiten
        this.leben = 50; 
        this.maxLeben = 50;
        this.distance = 0;          
        this.damage = 0;
        this.decisionAlgorithm = "STAND_STILL"; // Standardmäßig passiv
        
        // Farblich massiver gestalten zur Unterscheidung
        if (team == 1) { 
            this.red = 200; this.green = 200; this.blue = 200; 
        } else { 
            this.red = 100; this.green = 100; this.blue = 100; 
        }
    }
    
    // Logik für die Produktion einer neuen Einheit
    public Unit spawnUnit() {
        Unit newUnit = new Unit();
        newUnit.team = this.team;
        // Leichter Positions-Offset, damit die neue Einheit nicht exakt im Gebäude steckt
        newUnit.posX = this.posX + (Math.random() * 100 - 50);
        newUnit.posY = this.posY + (Math.random() * 100 - 50);
        newUnit.posZ = this.posZ;
        
        // Setzt die neu produzierte Einheit direkt auf Angriffsmodus (AlphaZero-Agent Basis)
        newUnit.decisionAlgorithm = "NEAREST_ENEMY"; 
        return newUnit;
    }
}

Schritt 2: Vorbereitung der Hauptklasse (Concurrent-Sicherheit)

Wenn ein Gebäude im laufenden Spiel (innerhalb des GameLoop) eine neue Einheit generiert und wir diese direkt der unitList hinzufügen, wirft Java einen Fehler (ConcurrentModificationException), da die Liste zeitgleich iteriert wird. Um dies logisch abzusichern, definieren wir eine Zwischenliste.

Ersetze den Beginn deiner Instanzvariablen in SchönerZoom2FormScaleUnitsBasisFightToChessVision durch diesen Block:
Java

	// --- Instanzvariablen (NICHT static) ---
	private int FRAME_WIDTH = 1920;
	private int FRAME_HEIGHT = 1080;
	private double zoomFactor = 0.0001;
	private double zoomCenterX = 0;
	private double zoomCenterY = 0;
	private static final double ZOOM_STEP = 1.2;
	private double feinheit = 70;
	private int pause = 30;
