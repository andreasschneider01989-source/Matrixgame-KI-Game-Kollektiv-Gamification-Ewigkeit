gameThread.start();

}


public Unit nextGegner(Unit current) {

Unit gegner = null;

double min = 999999999;

for (Unit unit : unitList) {

if (current.getDistance(unit) < min && current.team != unit.team) {

min = current.getDistance(unit);

gegner = unit;

}

}

return gegner;


}


int zeitSchritt = 0;


private void GameLoop() {

if (ende)

return;

zeitSchritt++;


int survive1 = 0;

int survive2 = 0;


for (int i = 0; i < unitList.size(); i++) {

Unit unit = unitList.get(i);


// Statistik-Zählung für Teams am Leben erhalten

if (unit.team == 1)

survive1++;

if (unit.team == 2)

survive2++;


// Konsolenausgabe alle 10 Schritte

if (zeitSchritt % 100 == 0) {

// unit.printWerte(i, zeitSchritt);

}

// In deiner Schleife / deinem Loop aufrufen:

long now = System.currentTimeMillis();

long CONSOLE_PRINT_INTERVAL_MS=1000;

if (now - lastConsolePrintTime >= CONSOLE_PRINT_INTERVAL_MS) {

// Hier kommt gleich nur deine Konsolenausgabe rein

System.out.println(System.currentTimeMillis());

for(int j=0; j<unitList.size(); j++) {

unitList.get(j).printWerte(j, zeitSchritt);}

lastConsolePrintTime = now;

}


// Priorität 1: Manueller Angriffsbefehl auf ein bestimmtes Ziel

if (unit.manualTarget != null && unit.manualTarget.leben > 0) {

Unit gegner = unit.manualTarget;

if (unit.getDistance(gegner) <= unit.distance) {

gegner.leben -= unit.damage;

System.out.println("Unit " + unit.id + " attackiert manuelles Ziel " + gegner.id + " | Restleben: "

+ gegner.leben);

if (gegner.leben <= 0) {

unitList.remove(gegner);

System.out.println("Unit " + gegner.id + " wurde vernichtet.");

System.out.println("Lebende Units aus Team 1 = " + survive1);

System.out.println("Lebende Units aus Team 2 = " + survive2);

unit.manualTarget = null;

}

} else {

unit.moveTo(gegner);

unit.move(1);

}

continue;

}


// Priorität 2: Ausführung basierend auf dem aktiven Entscheidungs-Algorithmus

switch (unit.decisionAlgorithm) {

case "TARGET_POINT":

// Bewege zu den manuellen Zielkoordinaten

if (unit.targetPosX != null && unit.targetPosY != null) {

double tZ = (unit.targetPosZ != null) ? unit.targetPosZ : 0.0;


// Prüfen, ob das Ziel fast erreicht ist (Vermeidung von Overshooting)

double distQ = Math.pow(unit.posX - unit.targetPosX, 2) + Math.pow(unit.posY - unit.targetPosY, 2);

if (distQ <= 1.0) {

unit.targetPosX = null;

unit.targetPosY = null;

unit.vx = 0;

unit.vy = 0;

// unit.decisionAlgorithm = "NEAREST_ENEMY"; // Zurück zum Standardmodus nach Ankunft

unit.decisionAlgorithm = "STAND_STILL";

} else {

unit.moveTo(unit.targetPosX, unit.targetPosY, tZ, unit.speed);

unit.move(1);

}

} else {

unit.decisionAlgorithm = "NEAREST_ENEMY";

}

break;


case "STAND_STILL":

unit.vx = 0;

unit.vy = 0;

unit.vz = 0;

break;


case "NEAREST_ENEMY":

default:

// Suche nächsten Gegner und bekämpfe ihn

Unit gegner = nextGegner(unit);

if (gegner != null) {

if (unit.getDistance(gegner) <= unit.distance) {

gegner.leben -= unit.damage;

if (gegner.leben <= 0) {

unitList.remove(gegner);

}

} else {

unit.moveTo(gegner);

unit.move(1);

}

}

break;

}

}


// Win/Loss Conditions

if (ende == false) {

// System.out.println("Lebende Units aus Team 1 = " + survive1);

// System.out.println("Lebende Units aus Team 2 = " + survive2);

if (survive1 <= 0 && survive2 > 0) {

System.out.println("Team 2 hat gewonnen!");

ende = true;

}

if (survive2 <= 0 && survive1 > 0) {

System.out.println("Team 1 hat gewonnen!");

ende = true;

}

if (survive1 <= 0 && survive2 <= 0) {

System.out.println("Alle Tod");

ende = true;

}

}

}

