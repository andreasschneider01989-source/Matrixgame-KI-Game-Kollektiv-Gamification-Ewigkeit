Dieser Code vereint das 8x8-Gitter (angelehnt an taktische Brettspiele wie Schach), ressourcenbasierte Produktion, Einheiten, Gebäude und zufällige Ressourcen-Spawns, die von Einheiten eingesammelt und verstoffwechselt werden müssen.
💻 Java-Implementierung: MatrixGameSimulation.java

Kopiere diesen Code in eine neue Java-Klasse in deinem Eclipse-Projekt. Er läuft direkt über die Konsole und simuliert den Spiel- und Wirtschaftskreislauf mit diskreten Zeitschritten (Δt).
Java

import java.util.ArrayList;
import java.util.List;
import java.util.Random;

public class MatrixGameSimulation {

    // --- KLASSE: RESSOURCE (Masse / Rohstoff) ---
    public static class ResourceNode {
        int x, y;
        double massKg; // Masse in kg gemäß SI-Basiseinheit

        public ResourceNode(int x, int y, double massKg) {
            this.x = x;
            this.y = y;
            this.massKg = massKg;
        }
    }

    // --- KLASSE: GEBÄUDE (Produktionsstätte) ---
    public static class Building {
        int x, y;
        double storedResourcesKg = 0.0;

        public Building(int x, int y) {
            this.x = x;
            this.y = y;
        }

        public void deposit(double amount) {
            this.storedResourcesKg += amount;
        }

        public boolean canProduceUnit() {
            return storedResourcesKg >= 50.0; // 50 kg Masse for eine Einheit
        }

        public void consumeForProduction() {
            if (canProduceUnit()) {
                storedResourcesKg -= 50.0;
            }
        }
    }

    // --- KLASSE: EINHEIT (Agent mit Masse und Bewegung) ---
    public static class Unit {
        String id;
        int x, y;
        double massKg;
        double carriedResourcesKg = 0.0;
        boolean hasTargetResource = false;

        public Unit(String id, int x, int y, double massKg) {
            this.id = id;
            this.x = x;
            this.y = y;
            this.massKg = massKg;
        }

        // Taktische Bewegung (angelehnt an Schach-Gitter 8x8 und Vektoren)
        public void moveTowards(int targetX, int targetY, int maxX, int maxY) {
            if (x < targetX) x++;
            else if (x > targetX) x--;

            if (y < targetY) y++;
            else if (y > targetY) y--;

            // Begrenzung auf das Spielfeld
            x = Math.max(0, Math.min(maxX - 1, x));
            y = Math.max(0, Math.min(maxY - 1, y));
        }
    }

    // --- HAUPTSPIEL-ENGINE (Game Loop) ---
    public static void main(String[] args) {
        int width = 8;
        int height = 8;
        int maxSteps = 15;
        Random random = new Random();

        List<Unit> units = new ArrayList<>();
        List<ResourceNode> resources = new ArrayList<>();
        Building headquarters = new Building(3, 3);

        // Initialisierung einer Start-Einheit
        units.add(new Unit("Alpha-1", 0, 0, 70.0)); // z.B. 70 kg Masse

        System.out.println("=== MATRIXGAME SIMULATION START ===");
        System.out.println("Gittergröße: " + width + "x" + height + " | Basis bei (" + headquarters.x + "," + headquarters.y + ")");

        for (int step = 1; step <= maxSteps; step++) {
            System.out.println("\n--- Zeitschritt t_" + step + " ---");

            // 1. Stochastischer Zufall: Generiere neue Ressourcen an zufälligen Positionen
            if (random.nextDouble() < 0.6) { // 60% Chance pro Schritt
                int rx = random.nextInt(width);
                int ry = random.nextInt(height);
                resources.add(new ResourceNode(rx, ry, 10.0)); // 10 kg Ressource
                System.out.println("[Zufall/Entropie] Neue Ressource erschienen bei (" + rx + ", " + ry + ")");
            }

            // 2. Einheiten-Logik (Sammeln, Bewegen, Verstoffwechseln)
            for (Unit unit : units) {
                // Finde nächstgelegene Ressource, wenn keine geladen ist
                ResourceNode targetRes = null;
                double minDistance = Double.MAX_VALUE;

                if (unit.carriedResourcesKg == 0.0 && !resources.isEmpty()) {
                    for (ResourceNode res : resources) {
                        double dist = Math.abs(res.x - unit.x) + Math.abs(res.y - unit.y);
                        if (dist < minDistance) {
                            minDistance = dist;
                            targetRes = res;
                        }
                    }
                }

                // Zielbestimmung: Entweder Ressource einsammeln oder zur Basis zurückbringen
                int targetX, targetY;
                if (unit.carriedResourcesKg > 0.0 || targetRes == null) {
                    // Zurück zur Basis zum Abliefern
                    targetX = headquarters.x;
                    targetY = headquarters.y;
                } else {
                    // Zur Ressource bewegen
                    targetX = targetRes.x;
                    targetY = targetRes.y;
                }

                // Ausführung des Bewegungsschritts
                unit.moveTowards(targetX, targetY, width, height);
                System.out.println("Einheit " + unit.id + " bewegt sich zu (" + unit.x + ", " + unit.y + ")");

                // Interaktion mit Ressourcen am Ort
                for (int i = 0; i < resources.size(); i++) {
                    ResourceNode res = resources.get(i);
                    if (unit.x == res.x && unit.y == res.y && unit.carriedResourcesKg == 0.0) {
                        unit.carriedResourcesKg += res.massKg;
                        resources.remove(i);
                        System.out.println("-> Einheit " + unit.id + " hat " + unit.carriedResourcesKg + " kg Ressource eingesammelt!");
                        break;
                    }
                }

                // Interaktion mit der Basis (Ressourcen abgeben)
                if (unit.x == headquarters.x && unit.y == headquarters.y && unit.carriedResourcesKg > 0.0) {
                    headquarters.deposit(unit.carriedResourcesKg);
                    System.out.println("-> Einheit " + unit.id + " hat " + unit.carriedResourcesKg + " kg an der Basis abgeliefert. Basis-Lager: " + headquarters.storedResourcesKg + " kg");
                    unit.carriedResourcesKg = 0.0;
                }
            }

            // 3. Produktionsprüfung in der Basis
            if (headquarters.canProduceUnit()) {
                headquarters.consumeForProduction();
                String newId = "Alpha-" + (units.size() + 1);
                units.add(new Unit(newId, headquarters.x, headquarters.y, 70.0));
                System.out.println(">>> PRODUKTION: Neue Einheit " + newId + " wurde in der Basis erschaffen!");
            }

            // Konsolendarstellung des Spielfelds (8x8)
            printGrid(width, height, units, resources, headquarters);
        }
        System.out.println("\n=== SIMULATION BEENDET ===");
    }

    // Hilfsmethode zur visuellen Darstellung in der Eclipse-Konsole
    private static void printGrid(int w, int h, List<Unit> units, List<ResourceNode> resources, Building base) {
        char[][] grid = new char[h][w];
        for (int y = 0; y < h; y++) {
            for (int x = 0; x < w; x++) {
                grid[y][x] = '.';
            }
        }

        // Basis eintragen ('B')
        grid[base.y][base.x] = 'B';

        // Ressourcen eintragen ('R')
        for (ResourceNode res : resources) {
            grid[res.y][res.x] = 'R';
        }

        // Einheiten eintragen ('U')
        for (Unit u : units) {
            grid[u.y][u.x] = 'U';
        }

        System.out.println("Spielfeld (. = Leer, B = Basis, R = Ressource, U = Einheit):");
        for (int y = 0; y < h; y++) {
            System.out.print("  ");
            for (int x = 0; x < w; x++) {
                System.out.print(grid[y][x] + " ");
            }
            System.out.println();
        }
    }
}

