	public static String MorseToSym(String morse) {
		String lumnumber = morse.replace(".", "0").replace("-", "1");
		long decimal = newLuminiNumberToDecimal(lumnumber, 2);
		String output = MorseZeichen.charAt((int) decimal) + "";
		return output;
	}

	public static String MorseToWord(String text) {
		String output = "";
		String[] tokens = text.split(" ");
		for (int i = 0; i < tokens.length; i++) {
			output = output + MorseToSym(tokens[i] + "");
		}
		output = output.trim();
		return output;
	}

	public static String MorseToText(String text) {
		String output = "";
		String[] tokens = text.split("/");
		for (int i = 0; i < tokens.length; i++) {
			tokens[i] = tokens[i].trim();
			output = output + MorseToWord(tokens[i]);
			output = output + " ";
		}
		output = output.trim();
		return output;
	}

	String generateRandMorseWord(int zeichenMenge, int laenge) {
		String output = "";
		for (int i = 0; i < laenge; i++) {
			output = output + decimalToNewLuminiNumber((long) (Math.random() * zeichenMenge), 2).replace("0", ".")
					.replace("1", "-") + " ";
		}
		output = output.trim();
		return output;
	}
	
	String generateRandMorseSym(int zeichenMenge) {
		String output = "";
		while (output == "" || (!MoeglicheZeichen.contains(MorseToSym(output)))) {
			output = decimalToNewLuminiNumber((long) (Math.random() * zeichenMenge), 2).replace("0", ".")
					.replace("1", "-");
		}
		return output;
	}
	
	String generateRandMorseText2(int zeichenMenge, int laenge) {
		String output = "";
		for (int i = 0; i < laenge; i++) {
			if (Math.random() > 0.3 || i == laenge - 1)
				output = output + generateRandMorseSym(zeichenMenge) + " ";
			else
				output = output + generateRandMorseSym(zeichenMenge) + " / ";
		}
		output = output.trim();
		return output;
	}

	public static long newLuminiNumberToDecimal(String newLuminiNumber, int basis) {
		int lenge = newLuminiNumber.length();
		long number = getLuminiBasisNeuNumbers(lenge - 1, basis) + 1;
		if (lenge == 1)
			number = 0;
		number += basisNStringToLong(newLuminiNumber, basis);
		return number;
	}

	public static long basisNStringToLong(String basNStr, int basis) {
		int lenge = basNStr.length();
		long output = 0;
		int symbol = 0;
		for (int i = lenge - 1; i >= 0; i--) {
			char c = basNStr.charAt(i);
			if (c >= '0' && c <= '9') {
				symbol = c - '0';
			}
			output += (symbol * Math.pow(basis, (lenge - 1 - i)));
		}
		return output;
	}

	public static String intToBasisNString(int value, int basis, boolean basisanzeige) {
		String output2 = "0";
		if (basisanzeige)
			output2 = output2 + "(Basis:" + basis + ")";
		if (value == 0)
			return output2;

		boolean negativ = false;
		if (value < 0)
			negativ = true;

		StringBuilder sb = new StringBuilder();
		while (value != 0) {
			int modulo = value % basis;
			sb.append(modulo);
			value = value - modulo;
			value /= basis;
		}

		String output = sb.toString().replace("-", "");
		if (negativ)
			output = "-" + output;

		if (basisanzeige)
			output = output + "(Basis:" + basis + ")";
		return output;
	}

	public static long getLuminiBasisNeuNumbers2(int LumNeuLänge, int LumNeuBasis) {
