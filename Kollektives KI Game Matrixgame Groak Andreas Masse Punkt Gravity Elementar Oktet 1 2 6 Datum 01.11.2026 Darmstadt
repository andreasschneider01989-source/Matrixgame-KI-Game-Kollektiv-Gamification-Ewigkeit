package p2ElementarSave;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.ArrayList;
import java.util.List;

public class main extends JPanel implements ActionListener {

    // ===================== Konstanten =====================
    final double G = 6.6743015e-11;           // echte Gravitationskonstante
    final double SOFTENING = 1e-4;            // verhindert Singularitäten
    final double DT = 0.05;                   // Basis-Zeitschritt (Verlet)
    final int FRAME_WIDTH = 1600;
    final int FRAME_HEIGHT = 900;

    // ===================== Zustand =====================
    private final List<MasseKugel> bodies = new ArrayList<>();
    private double zoomFactor = 1.0;
    private double zoomCenterX = 0;
    private double zoomCenterY = 0;
    private double panStep = 50;
    private double simSpeed = 1.0;            // Multiplikator für DT
    private int scenario = 9;                 // 9 = Earth Surface (Standard)

    // UI
    private JLabel energyLabel;
    private JLabel infoLabel;

    // ===================== Konstruktor =====================
    public main() {
        setPreferredSize(new Dimension(FRAME_WIDTH, FRAME_HEIGHT));
        setBackground(Color.BLACK);
        initScenario(scenario);

        Timer timer = new Timer(16, this);    // ~60 FPS
        timer.start();
    }

    // ===================== Szenarien =====================
    private void initScenario(int id) {
        bodies.clear();
        zoomFactor = 1.0;
        zoomCenterX = 0;
        zoomCenterY = 0;

        switch (id) {
            case 1 -> planetenBasis();
            case 2 -> doppelsternBasis();
            case 3 -> galaktischesZentrumBasis();
            case 4 -> elementarBausteinBasis();
            case 5 -> protonenBasis();
            case 6 -> orbitalRecyclerBasis();
            case 9 -> earthSurfaceBasis();    // <-- das neue Szenario
            default -> earthSurfaceBasis();
        }
        repaint();
    }

    // ---------- 1. Klassisches Sonnensystem (skaliert) ----------
    private void planetenBasis() {
        double scale = 1e-9;                  // visuelle Skalierung
        double mErde = 5.972e24;
        double mSonne = 333030 * mErde;

        MasseKugel sonne = new MasseKugel(0, 0, 0, 0, 0, 0, mSonne * scale, 12, Color.YELLOW);
        bodies.add(sonne);

        addPlanet(-15.0, 0, mErde * scale, 5, Color.BLUE, mSonne * scale);
        addPlanet(22.8, 0, 0.107 * mErde * scale, 4, Color.RED, mSonne * scale);
        addPlanet(-77.8, 0, 317.8 * mErde * scale, 9, new Color(200, 150, 100), mSonne * scale);
    }

    private void addPlanet(double dist, double y, double mass, double r, Color c, double centralMass) {
        double v = Math.sqrt(G * centralMass / Math.abs(dist));
        bodies.add(new MasseKugel(dist, y, 0, 0, dist > 0 ? -v : v, 0, mass, r, c));
    }

    // ---------- 2. Doppelstern ----------
    private void doppelsternBasis() {
        double mA = 4e5, mB = 2.5e5, d = 80;
        double rA = d * mB / (mA + mB);
        double rB = d * mA / (mA + mB);
        double v = Math.sqrt(G * (mA + mB) / d);

        bodies.add(new MasseKugel(-rA, 0, 0, 0, -v * rA / d, 0, mA, 10, new Color(255, 220, 50)));
        bodies.add(new MasseKugel( rB, 0, 0, 0,  v * rB / d, 0, mB, 8, new Color(255, 100, 50)));
    }

    // ---------- 3. Galaktisches Zentrum ----------
    private void galaktischesZentrumBasis() {
        double mBH = 1.5e9;
        bodies.add(new MasseKugel(0, 0, 0, 0, 0, 0, mBH, 14, Color.WHITE));

        addEllipticOrbit(350, 0.45, 2.5e5, 8, Color.CYAN, mBH);
        addEllipticOrbit(200, 0.30, 1.8e5, 7, Color.MAGENTA, mBH);
    }

    private void addEllipticOrbit(double dist, double factor, double mass, double r, Color c, double central) {
        double v = Math.sqrt(G * central / dist) * factor;
        bodies.add(new MasseKugel(-dist, 0, 0, 0, -v, 0, mass, r, c));
    }

    // ---------- 4. Elementar-Baustein (Oktett) ----------
    private void elementarBausteinBasis() {
        double mZ = 1e6;
        bodies.add(new MasseKugel(0, 0, 0, 0, 0, 0, mZ, 16, Color.WHITE));

        // innere Schale (2)
        double d1 = 30, v1 = Math.sqrt(G * mZ / d1);
        bodies.add(new MasseKugel( d1, 0, 0, 0,  v1, 0, 10, 5, Color.RED));
        bodies.add(new MasseKugel(-d1, 0, 0, 0, -v1, 0, 10, 5, Color.RED));

        // äußere Schale (6)
        double d2 = 70, v2 = Math.sqrt(G * mZ / d2);
        for (int i = 0; i < 6; i++) {
            double a = i * Math.PI / 3.0;
            bodies.add(new MasseKugel(Math.cos(a)*d2, Math.sin(a)*d2, 0,
                    -Math.sin(a)*v2, Math.cos(a)*v2, 0, 12, 6, new Color(100, 200, 255)));
        }
    }

    // ---------- 5. Protonen-Analogie (dein 1/6-Baustein) ----------
    private void protonenBasis() {
        double mE = 12.0;
        double mElem = mE / 6.0;
        double mQ = 1836.0 * mE / 3.0;
        double dQ = 10.0;
        double vQ = Math.sqrt(G * mQ / (Math.sqrt(3) * dQ));

        // 3 Quarks
        for (int i = 0; i < 3; i++) {
            double a = i * 2 * Math.PI / 3;
            Color col = (i == 0) ? Color.RED : (i == 1) ? Color.GREEN : Color.BLUE;
            bodies.add(new MasseKugel(Math.cos(a)*dQ, Math.sin(a)*dQ, 0,
                    -Math.sin(a)*vQ, Math.cos(a)*vQ, 0, mQ, 9, col));
        }

        // Elementar-Wolke
        double mCore = 3 * mQ;
        for (int i = 0; i < 24; i++) {
            double dist = 40 + Math.random() * 70;
            double a = Math.random() * 2 * Math.PI;
            double v = Math.sqrt(G * mCore / dist) * (0.95 + Math.random() * 0.1);
            bodies.add(new MasseKugel(Math.cos(a)*dist, Math.sin(a)*dist, 0,
                    -Math.sin(a)*v, Math.cos(a)*v, 0, mElem, 3, Color.WHITE));
        }
    }

    // ---------- 6. Orbital-Recycler ----------
    private void orbitalRecyclerBasis() {
        double mE = 5e5;
        MasseKugel erde = new MasseKugel(0, 0, 0, 0, 0, 0, mE, 18, new Color(30, 80, 200));
        erde.isPlanet = true;
        bodies.add(erde);

        for (int i = 0; i < 40; i++) {
            double dist = 50 + Math.random() * 120;
            double a = Math.random() * 2 * Math.PI;
            double v = Math.sqrt(G * mE / dist) * (0.5 + Math.random());
            bodies.add(new MasseKugel(Math.cos(a)*dist, Math.sin(a)*dist, 0,
                    -Math.sin(a)*v, Math.cos(a)*v, 0, 0.8, 2, Color.LIGHT_GRAY));
        }
    }

    // ---------- 9. EARTH SURFACE / DROP-TEST (das neue Szenario) ----------
    private void earthSurfaceBasis() {
        // Große Erde mit fester Oberfläche
        double erdeRadius = 80;
        double erdeMasse = 8e6;               // skaliert für schöne Fallzeiten

        MasseKugel erde = new MasseKugel(0, 0, 0, 0, 0, 0, erdeMasse, erdeRadius, new Color(40, 100, 220));
        erde.movable = false;
        erde.isPlanet = true;
        bodies.add(erde);

        // Testmassen aus verschiedenen Höhen fallen lassen
        double[] hoehen = {5, 20, 50, 100, 180, 280};
        Color[] farben = {Color.GREEN, Color.YELLOW, Color.ORANGE, Color.RED, Color.MAGENTA, Color.CYAN};

        for (int i = 0; i < hoehen.length; i++) {
            double h = hoehen[i];
            MasseKugel test = new MasseKugel(0, erdeRadius + h, 0, 0, 0, 0, 50, 4, farben[i]);
            bodies.add(test);
        }

        // Ein paar seitlich versetzte Körper für interessante Bahnen
        bodies.add(new MasseKugel(30, erdeRadius + 60, 0, 8, 0, 0, 40, 3, Color.WHITE));
        bodies.add(new MasseKugel(-40, erdeRadius + 120, 0, -5, 0, 0, 35, 3, Color.PINK));
    }

    // ===================== Physik (Velocity-Verlet + Kollision) =====================
    private void computeAccelerations() {
        int n = bodies.size();
        for (MasseKugel b : bodies) {
            b.ax = b.ay = b.az = 0;
        }

        for (int i = 0; i < n; i++) {
            MasseKugel bi = bodies.get(i);
            if (!bi.movable) continue;

            for (int j = 0; j < n; j++) {
                if (i == j) continue;
                MasseKugel bj = bodies.get(j);

                double dx = bj.x - bi.x;
                double dy = bj.y - bi.y;
                double dz = bj.z - bi.z;
                double r2 = dx*dx + dy*dy + dz*dz + SOFTENING;
                double r = Math.sqrt(r2);

                double force = G * bj.mass / r2;
                bi.ax += force * dx / r;
                bi.ay += force * dy / r;
                bi.az += force * dz / r;
            }
        }
    }

    private void integrateVerlet(double dt) {
        // 1. Halber Geschwindigkeitsschritt + Position
        for (MasseKugel b : bodies) {
            if (!b.movable) continue;
            b.vx += 0.5 * b.ax * dt;
            b.vy += 0.5 * b.ay * dt;
            b.vz += 0.5 * b.az * dt;

            b.x += b.vx * dt;
            b.y += b.vy * dt;
            b.z += b.vz * dt;
        }

        // 2. Neue Beschleunigungen
        computeAccelerations();

        // 3. Zweiter halber Geschwindigkeitsschritt
        for (MasseKugel b : bodies) {
            if (!b.movable) continue;
            b.vx += 0.5 * b.ax * dt;
            b.vy += 0.5 * b.ay * dt;
            b.vz += 0.5 * b.az * dt;
        }

        // 4. Kollisionen / Landung
        resolveCollisions();
    }

    private void resolveCollisions() {
        int n = bodies.size();
        for (int i = 0; i < n; i++) {
            MasseKugel a = bodies.get(i);
            for (int j = i + 1; j < n; j++) {
                MasseKugel b = bodies.get(j);

                double dx = b.x - a.x;
                double dy = b.y - a.y;
                double dz = b.z - a.z;
                double dist = Math.sqrt(dx*dx + dy*dy + dz*dz);
                double minDist = a.radius + b.radius;

                if (dist < minDist && dist > 1e-8) {
                    // Normale
                    double nx = dx / dist;
                    double ny = dy / dist;
                    double nz = dz / dist;

                    // Überlappung auflösen
                    double overlap = minDist - dist;
                    if (a.movable) {
                        a.x -= overlap * nx * 0.5;
                        a.y -= overlap * ny * 0.5;
                        a.z -= overlap * nz * 0.5;
                    }
                    if (b.movable) {
                        b.x += overlap * nx * 0.5;
                        b.y += overlap * ny * 0.5;
                        b.z += overlap * nz * 0.5;
                    }

                    // Relative Geschwindigkeit
                    double dvx = b.vx - a.vx;
                    double dvy = b.vy - a.vy;
                    double dvz = b.vz - a.vz;
                    double velAlongNormal = dvx*nx + dvy*ny + dvz*nz;

                    if (velAlongNormal > 0) continue; // entfernen sich bereits

                    // Impuls (einfacher elastischer Stoß)
                    double e = 0.35; // Restitutionskoeffizient (etwas unelastisch)
                    double jImp = -(1 + e) * velAlongNormal;
                    jImp /= 1/a.mass + 1/b.mass;

                    if (a.movable) {
                        a.vx -= jImp * nx / a.mass;
                        a.vy -= jImp * ny / a.mass;
                        a.vz -= jImp * nz / a.mass;
                    }
                    if (b.movable) {
                        b.vx += jImp * nx / b.mass;
                        b.vy += jImp * ny / b.mass;
                        b.vz += jImp * nz / b.mass;
                    }

                    // Spezielle Behandlung für Planetenoberfläche: „Landen“
                    if (a.isPlanet && b.movable) {
                        // Radialgeschwindigkeit stark dämpfen → bleibt liegen
                        double vr = b.vx*nx + b.vy*ny + b.vz*nz;
                        b.vx -= vr * nx * 0.95;
                        b.vy -= vr * ny * 0.95;
                        b.vz -= vr * nz * 0.95;
                    }
                    if (b.isPlanet && a.movable) {
                        double vr = a.vx*(-nx) + a.vy*(-ny) + a.vz*(-nz);
                        a.vx -= vr * (-nx) * 0.95;
                        a.vy -= vr * (-ny) * 0.95;
                        a.vz -= vr * (-nz) * 0.95;
                    }
                }
            }
        }
    }

    // ===================== Energie =====================
    private double totalEnergy() {
        double eKin = 0, ePot = 0;
        int n = bodies.size();
        for (MasseKugel b : bodies) eKin += b.getEKin();

        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                MasseKugel a = bodies.get(i);
                MasseKugel b = bodies.get(j);
                double dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z;
                double r = Math.sqrt(dx*dx + dy*dy + dz*dz + SOFTENING);
                ePot += -G * a.mass * b.mass / r;
            }
        }
        return eKin + ePot;
    }

    // ===================== Rendering =====================
    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        g2.setColor(Color.BLACK);
        g2.fillRect(0, 0, getWidth(), getHeight());

        for (MasseKugel b : bodies) {
            double sx = (b.x + zoomCenterX) * zoomFactor + getWidth() / 2.0;
            double sy = (b.y + zoomCenterY) * zoomFactor + getHeight() / 2.0;
            double r = Math.max(b.radius * zoomFactor, 2);

            g2.setColor(b.color);
            g2.fillOval((int)(sx - r), (int)(sy - r), (int)(2*r), (int)(2*r));

            // leichter Rand
            g2.setColor(b.color.brighter());
            g2.drawOval((int)(sx - r), (int)(sy - r), (int)(2*r), (int)(2*r));
        }

        // Info
        g2.setColor(Color.WHITE);
        g2.setFont(new Font("Consolas", Font.PLAIN, 14));
        g2.drawString(String.format("Zoom: %.2f   Bodies: %d   Energy: %.3e",
                zoomFactor, bodies.size(), totalEnergy()), 20, 30);
        g2.drawString("Szenario: " + scenarioName(scenario) + "   |  Mausrad = Zoom, Pfeiltasten = Pan", 20, 50);
    }

    private String scenarioName(int id) {
        return switch (id) {
            case 1 -> "Sonnensystem";
            case 2 -> "Doppelstern";
            case 3 -> "Galaktisches Zentrum";
            case 4 -> "Elementar-Baustein";
            case 5 -> "Protonen-Analogie";
            case 6 -> "Orbital-Recycler";
            case 9 -> "Earth Surface / Drop-Test";
            default -> "Unbekannt";
        };
    }

    // ===================== Timer =====================
    @Override
    public void actionPerformed(ActionEvent e) {
        double dt = DT * simSpeed;
        // mehrere Substeps für Stabilität bei höherer Speed
        int sub = Math.max(1, (int)(simSpeed));
        for (int i = 0; i < sub; i++) {
            integrateVerlet(dt / sub);
        }
        repaint();
    }

    // ===================== Steuerung =====================
    public void zoomIn()  { zoomFactor *= 1.25; repaint(); }
    public void zoomOut() { zoomFactor /= 1.25; repaint(); }
    public void pan(double dx, double dy) {
        zoomCenterX += dx / zoomFactor;
        zoomCenterY += dy / zoomFactor;
        repaint();
    }
    public void faster() { simSpeed *= 1.3; }
    public void slower() { simSpeed /= 1.3; }

    // ===================== Hauptfenster =====================
    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            JFrame frame = new JFrame("Matrix-Gravity Engine – N-Body + Earth Surface");
            frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

            main panel = new main();
            frame.add(panel, BorderLayout.CENTER);

            // Control-Leiste
            JPanel controls = new JPanel(new FlowLayout(FlowLayout.LEFT));
            String[] names = {
                "1 Sonnensystem", "2 Doppelstern", "3 Galaxie",
                "4 Elementar", "5 Proton", "6 Recycler", "9 Earth Drop"
            };
            int[] ids = {1, 2, 3, 4, 5, 6, 9};

            for (int i = 0; i < names.length; i++) {
                int id = ids[i];
                JButton btn = new JButton(names[i]);
                btn.addActionListener(e -> panel.initScenario(id));
                controls.add(btn);
            }

            controls.add(new JButton("Zoom +") {{ addActionListener(e -> panel.zoomIn()); }});
            controls.add(new JButton("Zoom –") {{ addActionListener(e -> panel.zoomOut()); }});
            controls.add(new JButton("Schneller") {{ addActionListener(e -> panel.faster()); }});
            controls.add(new JButton("Langsamer") {{ addActionListener(e -> panel.slower()); }});

            // Tastatur
            panel.setFocusable(true);
            panel.addKeyListener(new KeyAdapter() {
                @Override
                public void keyPressed(KeyEvent e) {
                    switch (e.getKeyCode()) {
                        case KeyEvent.VK_LEFT  -> panel.pan(40, 0);
                        case KeyEvent.VK_RIGHT -> panel.pan(-40, 0);
                        case KeyEvent.VK_UP    -> panel.pan(0, 40);
                        case KeyEvent.VK_DOWN  -> panel.pan(0, -40);
                        case KeyEvent.VK_PLUS, KeyEvent.VK_EQUALS -> panel.zoomIn();
                        case KeyEvent.VK_MINUS -> panel.zoomOut();
                    }
                }
            });

            // Mausrad-Zoom
            panel.addMouseWheelListener(e -> {
                if (e.getWheelRotation() < 0) panel.zoomIn();
                else panel.zoomOut();
            });

            frame.add(controls, BorderLayout.NORTH);
            frame.pack();
            frame.setLocationRelativeTo(null);
            frame.setVisible(true);
            panel.requestFocusInWindow();
        });
    }
}


package p2ElementarSave;

import java.awt.Color;

public class MasseKugel {
    public double x, y, z;
    public double vx, vy, vz;
    public double ax, ay, az;          // Beschleunigung (für Verlet)
    public double mass;
    public double radius;
    public Color color;
    public boolean movable = true;
    public boolean isPlanet = false;   // feste Oberfläche (z.B. Erde)

    public MasseKugel(double x, double y, double z,
                      double vx, double vy, double vz,
                      double mass, double radius, Color color) {
        this.x = x;
        this.y = y;
        this.z = z;
        this.vx = vx;
        this.vy = vy;
        this.vz = vz;
        this.mass = mass;
        this.radius = radius;
        this.color = color;
    }

    public double getEKin() {
        return 0.5 * mass * (vx * vx + vy * vy + vz * vz);
    }

    public void printWerte() {
        System.out.println("Pos: (" + x + ", " + y + ", " + z + ")");
        System.out.println("Vel: (" + vx + ", " + vy + ", " + vz + ")");
        System.out.println("Mass: " + mass + "  Radius: " + radius);
        System.out.println("E_kin: " + getEKin());
    }
}
