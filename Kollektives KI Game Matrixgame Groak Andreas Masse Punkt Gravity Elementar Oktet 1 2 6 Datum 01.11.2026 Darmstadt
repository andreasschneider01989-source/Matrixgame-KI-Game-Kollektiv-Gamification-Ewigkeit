    // ---------- weitere Szenarien ----------
    private void planetenBasis() {
        double mS = 700000;
        bodies.add(new MasseKugel(0, 0, 0, 0, 0, 0, mS, 16, Color.YELLOW));
        addOrbit(-24, 0, 2000, 5, Color.BLUE, mS);
        addOrbit(36, 0, 600, 4, Color.RED, mS);
        addOrbit(-85, 0, 16000, 9, new Color(210, 155, 90), mS);
