package p2;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.ArrayList;
import java.util.List;

public class main extends JPanel implements ActionListener {

    // ===================== PHYSIK =====================
    final double G_SIM     = 28.0;          // Simulations-G (sichtbare Bahnen)
    final double SOFTENING = 1.2;
    final double DT        = 0.035;

    // ===================== ELEMENTAR-BAUSTEIN – MASSEN HIER ÄNDERN =====================
    double MASS_CENTER = 1_000_000;
    double MASS_INNER  = 12;
    double MASS_OUTER  = 18;

    double DIST_INNER  = 32.0;
    double DIST_OUTER  = 72.0;

    boolean DRAW_LINES = true;
    int LOG_EVERY      = 45;

    // ===================== ZUSTAND =====================
    private final List<MasseKugel> bodies = new ArrayList<>();
    private double zoomFactor = 1.0;
    private double zoomCenterX = 0;
    private double zoomCenterY = 0;
    private double simSpeed = 1.0;
    private int scenario = 4;
    private int frameCounter = 0;
    private int nextElementarOffset = 0;   // für mehrere Oktetts

    private final int FRAME_WIDTH  = 1680;
    private final int FRAME_HEIGHT = 950;

    public main() {
        setPreferredSize(new Dimension(FRAME_WIDTH, FRAME_HEIGHT));
        setBackground(Color.BLACK);
        initScenario(scenario);
        new Timer(16, this).start();
    }

    // ===================== SZENARIEN =====================
    private void initScenario(int id) {
        bodies.clear();
        frameCounter = 0;
        nextElementarOffset = 0;
        zoomFactor = 1.0;
        zoomCenterX = 0;
        zoomCenterY = 0;
        scenario = id;

        switch (id) {
            case 1 -> planetenBasis();
            case 2 -> doppelsternBasis();
            case 3 -> galaktischesZentrumBasis();
            case 4 -> elementarBausteinBasis(0, 0);          // erstes Oktett
            case 5 -> protonenBasis();
            case 6 -> orbitalRecyclerBasis();
            case 9 -> earthSurfaceBasis();
            default -> elementarBausteinBasis(0, 0);
        }
        repaint();
    }

    // ---------- 4. ELEMENTAR-BAUSTEIN (Oktett) ----------
    private void elementarBausteinBasis(double offsetX, double offsetY) {
        // Zentrum
        MasseKugel zentrum = new MasseKugel(offsetX, offsetY, 0, 0, 0, 0,
                MASS_CENTER, 15, Color.WHITE);
        bodies.add(zentrum);

        // Innere Schale (2)
        double vInner = Math.sqrt(G_SIM * MASS_CENTER / DIST_INNER);
        for (int i = 0; i < 2; i++) {
            double angle = i * Math.PI;
            double x  = offsetX + Math.cos(angle) * DIST_INNER;
            double y  = offsetY + Math.sin(angle) * DIST_INNER;
            double vx = -Math.sin(angle) * vInner;
            double vy =  Math.cos(angle) * vInner;
            bodies.add(new MasseKugel(x, y, 0, vx, vy, 0,
                    MASS_INNER, 5, new Color(255, 95, 95)));
        }

        // Äußere Schale (6)
        double effective = MASS_CENTER + 2 * MASS_INNER;
        double vOuter = Math.sqrt(G_SIM * effective / DIST_OUTER);
        for (int i = 0; i < 6; i++) {
            double angle = i * Math.PI / 3.0;
            double x  = offsetX + Math.cos(angle) * DIST_OUTER;
            double y  = offsetY + Math.sin(angle) * DIST_OUTER;
            double vx = -Math.sin(angle) * vOuter;
            double vy =  Math.cos(angle) * vOuter;
            bodies.add(new MasseKugel(x, y, 0, vx, vy, 0,
                    MASS_OUTER, 6, new Color(90, 185, 255)));
        }

        if (offsetX == 0 && offsetY == 0) {
            System.out.println("\n=== ELEMENTAR-BAUSTEIN gestartet ===");
            System.out.printf("Zentrum:     %,.0f%n", MASS_CENTER);
            System.out.printf("Inner je:    %.1f   (Gesamt: %.1f)%n", MASS_INNER, 2 * MASS_INNER);
            System.out.printf("Outer je:    %.1f   (Gesamt: %.1f)%n", MASS_OUTER, 6 * MASS_OUTER);
            System.out.printf("Verhältnis Zentrum/Inner : %.0f : 1%n", MASS_CENTER / MASS_INNER);
            System.out.printf("Verhältnis Zentrum/Outer : %.0f : 1%n", MASS_CENTER / MASS_OUTER);
            System.out.println("G_SIM = " + G_SIM);
            System.out.println("====================================\n");
        }
    }

    // Extra-Oktett spawnen (Interaktionstest)
    private void spawnExtraElementar() {
        nextElementarOffset += 220;
        elementarBausteinBasis(nextElementarOffset, 40 + (nextElementarOffset % 3) * 30);
        System.out.println("→ Zweites / weiteres Elementar-Oktett hinzugefügt (Offset " + nextElementarOffset + ")");
    }

    // ---------- 1. Sonnensystem ----------
    private void planetenBasis() {
        double mSonne = 650000;
        bodies.add(new MasseKugel(0, 0, 0, 0, 0, 0, mSonne, 16, Color.YELLOW));
        addOrbit(-22, 0, 1800, 5, Color.BLUE, mSonne);
        addOrbit(32, 0, 550, 4, Color.RED, mSonne);
        addOrbit(-78, 0, 14000, 9, new Color(210, 155, 95), mSonne);
        addOrbit(125, 0, 4200, 7, new Color(200, 200, 120), mSonne);
    }

    private void addOrbit(double dist, double y, double mass, double r, Color c, double central) {
        double v = Math.sqrt(G_SIM * central / Math.abs(dist));
        bodies.add(new MasseKugel(dist, y, 0, 0, dist > 0 ? -v : v, 0, mass, r, c));
    }

    // ---------- 2. Doppelstern ----------
    private void doppelsternBasis() {
        double mA = 480000, mB = 290000, d = 95;
        double rA = d * mB / (mA + mB);
        double rB = d * mA / (mA + mB);
        double v  = Math.sqrt(G_SIM * (mA + mB) / d);
        bodies.add(new MasseKugel(-rA, 0, 0, 0, -v * rA / d, 0, mA, 12, new Color(255, 225, 70)));
        bodies.add(new MasseKugel( rB, 0, 0, 0,  v * rB / d, 0, mB, 10, new Color(255, 120, 55)));
        // kleiner Begleiter
        addOrbit(0, 160, 800, 4, Color.CYAN, mA + mB);
    }

    // ---------- 3. Galaktisches Zentrum ----------
    private void galaktischesZentrumBasis() {
        double mBH = 3.2e6;
        bodies.add(new MasseKugel(0, 0, 0, 0, 0, 0, mBH, 18, Color.WHITE));
        addElliptic(310, 0.40, 22000, 8, Color.CYAN, mBH);
        addElliptic(175, 0.26, 15000, 7, Color.MAGENTA, mBH);
        addElliptic(480, 0.55, 9000, 6, Color.ORANGE, mBH);
    }

    private void addElliptic(double dist, double factor, double mass, double r, Color c, double central) {
        double v = Math.sqrt(G_SIM * central / dist) * factor;
        bodies.add(new MasseKugel(-dist, 0, 0, 0, -v, 0, mass, r, c));
    }

    // ---------- 5. Protonen-Analogie (reine Gravity) ----------
    private void protonenBasis() {
        double mQ = 9500;
        double dQ = 14;
        double vQ = Math.sqrt(G_SIM * mQ / (Math.sqrt(3) * dQ));
        for (int i = 0; i < 3; i++) {
            double a = i * 2 * Math.PI / 3;
            Color col = (i == 0) ? Color.RED : (i == 1) ? Color.GREEN : Color.BLUE;
            bodies.add(new MasseKugel(Math.cos(a)*dQ, Math.sin(a)*dQ, 0,
                    -Math.sin(a)*vQ, Math.cos(a)*vQ, 0, mQ, 8, col));
        }
        double mCore = 3 * mQ;
        for (int i = 0; i < 22; i++) {
            double dist = 55 + Math.random() * 55;
            double a = Math.random() * 2 * Math.PI;
            double v = Math.sqrt(G_SIM * mCore / dist) * (0.88 + Math.random() * 0.24);
            bodies.add(new MasseKugel(Math.cos(a)*dist, Math.sin(a)*dist, 0,
                    -Math.sin(a)*v, Math.cos(a)*v, 0, 55, 3, Color.WHITE));
        }
    }

    // ---------- 6. Orbital-Recycler ----------
    private void orbitalRecyclerBasis() {
        double mE = 750000;
        MasseKugel erde = new MasseKugel(0, 0, 0, 0, 0, 0, mE, 20, new Color(35, 95, 220));
        erde.isPlanet = true;
        bodies.add(erde);
        for (int i = 0; i < 38; i++) {
            double dist = 60 + Math.random() * 130;
            double a = Math.random() * 2 * Math.PI;
            double v = Math.sqrt(G_SIM * mE / dist) * (0.4 + Math.random() * 1.1);
            bodies.add(new MasseKugel(Math.cos(a)*dist, Math.sin(a)*dist, 0,
                    -Math.sin(a)*v, Math.cos(a)*v, 0, 1.5, 2.5, Color.LIGHT_GRAY));
        }
    }

    // ---------- 9. Earth Surface / Drop-Test ----------
    private void earthSurfaceBasis() {
        double erdeRadius = 85;
        double erdeMasse  = 3_200_000;
        MasseKugel erde = new MasseKugel(0, 0, 0, 0, 0, 0, erdeMasse, erdeRadius, new Color(40, 115, 235));
        erde.movable = false;
        erde.isPlanet = true;
        bodies.add(erde);

        double[] hoehen = {12, 35, 65, 120, 190, 290};
        Color[] farben  = {Color.GREEN, Color.YELLOW, Color.ORANGE, Color.RED, Color.MAGENTA, Color.CYAN};
        for (int i = 0; i < hoehen.length; i++) {
            bodies.add(new MasseKugel(0, erdeRadius + hoehen[i], 0, 0, 0, 0, 70, 4.5, farben[i]));
        }
        bodies.add(new MasseKugel(48, erdeRadius + 95, 0, 14, 0, 0, 55, 3.5, Color.WHITE));
        bodies.add(new MasseKugel(-58, erdeRadius + 155, 0, -9, 0, 0, 50, 3.5, Color.PINK));
    }

    // ===================== PHYSIK-ENGINE =====================
    private void computeAccelerations() {
        for (MasseKugel b : bodies) {
            b.ax = b.ay = b.az = 0;
        }
        int n = bodies.size();
        for (int i = 0; i < n; i++) {
            MasseKugel bi = bodies.get(i);
            if (!bi.movable) continue;
            for (int j = 0; j < n; j++) {
                if (i == j) continue;
                MasseKugel bj = bodies.get(j);
                double dx = bj.x - bi.x;
                double dy = bj.y - bi.y;
                double dz = bj.z - bi.z;
                double r2 = dx*dx + dy*dy + dz*dz + SOFTENING*SOFTENING;
                double r  = Math.sqrt(r2);
                double f  = G_SIM * bj.mass / r2;
                bi.ax += f * dx / r;
                bi.ay += f * dy / r;
                bi.az += f * dz / r;
            }
        }
    }

    private void integrateVerlet(double dt) {
        for (MasseKugel b : bodies) {
            if (!b.movable) continue;
            b.vx += 0.5 * b.ax * dt;
            b.vy += 0.5 * b.ay * dt;
            b.vz += 0.5 * b.az * dt;
            b.x  += b.vx * dt;
            b.y  += b.vy * dt;
            b.z  += b.vz * dt;
        }
        computeAccelerations();
        for (MasseKugel b : bodies) {
            if (!b.movable) continue;
            b.vx += 0.5 * b.ax * dt;
            b.vy += 0.5 * b.ay * dt;
            b.vz += 0.5 * b.az * dt;
        }
        resolveCollisions();
    }

    private void resolveCollisions() {
        int n = bodies.size();
        for (int i = 0; i < n; i++) {
            MasseKugel a = bodies.get(i);
            for (int j = i + 1; j < n; j++) {
                MasseKugel b = bodies.get(j);
                double dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z;
                double dist = Math.sqrt(dx*dx + dy*dy + dz*dz);
                double minDist = a.radius + b.radius;
                if (dist < minDist && dist > 1e-8) {
                    double nx = dx / dist, ny = dy / dist, nz = dz / dist;
                    double overlap = minDist - dist;
                    if (a.movable) { a.x -= overlap*nx*0.5; a.y -= overlap*ny*0.5; a.z -= overlap*nz*0.5; }
                    if (b.movable) { b.x += overlap*nx*0.5; b.y += overlap*ny*0.5; b.z += overlap*nz*0.5; }

                    double velN = (b.vx - a.vx)*nx + (b.vy - a.vy)*ny + (b.vz - a.vz)*nz;
                    if (velN > 0) continue;

                    double e = 0.32;
                    double jImp = -(1 + e) * velN / (1.0/a.mass + 1.0/b.mass);
                    if (a.movable) {
                        a.vx -= jImp * nx / a.mass;
                        a.vy -= jImp * ny / a.mass;
                        a.vz -= jImp * nz / a.mass;
                    }
                    if (b.movable) {
                        b.vx += jImp * nx / b.mass;
                        b.vy += jImp * ny / b.mass;
                        b.vz += jImp * nz / b.mass;
                    }

                    // Landung
                    if (a.isPlanet && b.movable) {
                        double vr = b.vx*nx + b.vy*ny + b.vz*nz;
                        b.vx -= vr * nx * 0.88;
                        b.vy -= vr * ny * 0.88;
                        b.vz -= vr * nz * 0.88;
                    }
                    if (b.isPlanet && a.movable) {
                        double vr = a.vx*(-nx) + a.vy*(-ny) + a.vz*(-nz);
                        a.vx -= vr * (-nx) * 0.88;
                        a.vy -= vr * (-ny) * 0.88;
                        a.vz -= vr * (-nz) * 0.88;
                    }
                }
            }
        }
    }

    private double totalEnergy() {
        double eKin = 0, ePot = 0;
        for (MasseKugel b : bodies) eKin += b.getEKin();
        int n = bodies.size();
        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                MasseKugel a = bodies.get(i), b = bodies.get(j);
                double dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z;
                double r = Math.sqrt(dx*dx + dy*dy + dz*dz + SOFTENING*SOFTENING);
                ePot += -G_SIM * a.mass * b.mass / r;
            }
        }
        return eKin + ePot;
    }

    // ===================== LOGGING =====================
    private void logStability() {
        if (scenario != 4 || bodies.size() < 9) return;

        // Nur das erste Oktett loggen (Index 0–8)
        MasseKugel c = bodies.get(0);
        double rIn = 0, rOut = 0;
        for (int i = 1; i <= 2; i++) {
            rIn += Math.hypot(bodies.get(i).x - c.x, bodies.get(i).y - c.y);
        }
        for (int i = 3; i <= 8; i++) {
            rOut += Math.hypot(bodies.get(i).x - c.x, bodies.get(i).y - c.y);
        }
        rIn /= 2.0;
        rOut /= 6.0;

        double devI = Math.abs(rIn - DIST_INNER) / DIST_INNER * 100.0;
        double devO = Math.abs(rOut - DIST_OUTER) / DIST_OUTER * 100.0;

        System.out.printf("Frame %5d | r_inner=%6.2f (%4.1f%%) | r_outer=%6.2f (%4.1f%%) | E=%.4e | Bodies=%d%n",
                frameCounter, rIn, devI, rOut, devO, totalEnergy(), bodies.size());
    }

    // ===================== RENDERING =====================
    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        g2.setColor(Color.BLACK);
        g2.fillRect(0, 0, getWidth(), getHeight());

        for (MasseKugel b : bodies) {
            double sx = (b.x + zoomCenterX) * zoomFactor + getWidth() / 2.0;
            double sy = (b.y + zoomCenterY) * zoomFactor + getHeight() / 2.0;
            double r  = Math.max(b.radius * zoomFactor, 2.0);
            g2.setColor(b.color);
            g2.fillOval((int)(sx - r), (int)(sy - r), (int)(2 * r), (int)(2 * r));
            g2.setColor(b.color.brighter());
            g2.drawOval((int)(sx - r), (int)(sy - r), (int)(2 * r), (int)(2 * r));
        }

        // Linien nur für das erste Oktett
        if (DRAW_LINES && scenario == 4 && bodies.size() >= 9) {
            MasseKugel c = bodies.get(0);
            double cx = (c.x + zoomCenterX) * zoomFactor + getWidth() / 2.0;
            double cy = (c.y + zoomCenterY) * zoomFactor + getHeight() / 2.0;

            g2.setStroke(new BasicStroke(1.3f));
            g2.setColor(new Color(255, 120, 120, 170));
            for (int i = 1; i <= 2; i++) {
                MasseKugel b = bodies.get(i);
                double sx = (b.x + zoomCenterX) * zoomFactor + getWidth() / 2.0;
                double sy = (b.y + zoomCenterY) * zoomFactor + getHeight() / 2.0;
                g2.drawLine((int)cx, (int)cy, (int)sx, (int)sy);
            }
            g2.setColor(new Color(100, 185, 255, 110));
            for (int i = 3; i <= 8; i++) {
                MasseKugel b = bodies.get(i);
                double sx = (b.x + zoomCenterX) * zoomFactor + getWidth() / 2.0;
                double sy = (b.y + zoomCenterY) * zoomFactor + getHeight() / 2.0;
                g2.drawLine((int)cx, (int)cy, (int)sx, (int)sy);
            }
        }

        g2.setColor(Color.WHITE);
        g2.setFont(new Font("Consolas", Font.PLAIN, 14));
        g2.drawString(String.format("Zoom: %.2f   Bodies: %d   Energy: %.4e",
                zoomFactor, bodies.size(), totalEnergy()), 18, 26);
        g2.drawString("Szenario: " + scenarioName(scenario) + "   |  Mausrad = Zoom, Pfeiltasten = Pan", 18, 46);
    }

    private String scenarioName(int id) {
        return switch (id) {
            case 1 -> "Sonnensystem";
            case 2 -> "Doppelstern";
            case 3 -> "Galaktisches Zentrum";
            case 4 -> "Elementar-Baustein (Oktett)";
            case 5 -> "Protonen-Analogie";
            case 6 -> "Orbital-Recycler";
            case 9 -> "Earth Surface / Drop-Test";
            default -> "Unbekannt";
        };
    }

    // ===================== TIMER =====================
    @Override
    public void actionPerformed(ActionEvent e) {
        double dt = DT * simSpeed;
        int sub = Math.max(1, (int) Math.ceil(simSpeed));
        for (int s = 0; s < sub; s++) {
            integrateVerlet(dt / sub);
        }
        frameCounter++;
        if (frameCounter % LOG_EVERY == 0) {
            logStability();
        }
        repaint();
    }

    // ===================== STEUERUNG =====================
    public void zoomIn()  { zoomFactor *= 1.22; repaint(); }
    public void zoomOut() { zoomFactor /= 1.22; repaint(); }
    public void pan(double dx, double dy) {
        zoomCenterX += dx / zoomFactor;
        zoomCenterY += dy / zoomFactor;
        repaint();
    }
    public void faster() { simSpeed = Math.min(simSpeed * 1.32, 12); }
    public void slower() { simSpeed = Math.max(simSpeed / 1.32, 0.04); }

    // ===================== HAUPTFENSTER =====================
    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            JFrame frame = new JFrame("Matrix-Gravity Engine – vollständig & optimiert");
            frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

            main panel = new main();
            frame.add(panel, BorderLayout.CENTER);

            JPanel controls = new JPanel(new FlowLayout(FlowLayout.LEFT, 6, 4));

            String[] names = {"1 Sonne", "2 Doppelstern", "3 Galaxie", "4 Elementar", "5 Proton", "6 Recycler", "9 Earth Drop"};
            int[] ids = {1, 2, 3, 4, 5, 6, 9};
            for (int i = 0; i < names.length; i++) {
                final int id = ids[i];
                JButton btn = new JButton(names[i]);
                btn.addActionListener(e -> panel.initScenario(id));
                controls.add(btn);
            }

            // Extra-Oktett Button
            JButton extraBtn = new JButton("+2. Elementar");
            extraBtn.addActionListener(e -> {
                if (panel.scenario == 4) {
                    panel.spawnExtraElementar();
                } else {
                    System.out.println("Zuerst Szenario 4 (Elementar) starten.");
                }
            });
            controls.add(extraBtn);

            controls.add(new JButton("Zoom +") {{ addActionListener(e -> panel.zoomIn()); }});
            controls.add(new JButton("Zoom –") {{ addActionListener(e -> panel.zoomOut()); }});
            controls.add(new JButton("Schneller") {{ addActionListener(e -> panel.faster()); }});
            controls.add(new JButton("Langsamer") {{ addActionListener(e -> panel.slower()); }});

            panel.setFocusable(true);
            panel.addKeyListener(new KeyAdapter() {
                @Override
                public void keyPressed(KeyEvent e) {
                    switch (e.getKeyCode()) {
                        case KeyEvent.VK_LEFT  -> panel.pan(55, 0);
                        case KeyEvent.VK_RIGHT -> panel.pan(-55, 0);
                        case KeyEvent.VK_UP    -> panel.pan(0, 55);
                        case KeyEvent.VK_DOWN  -> panel.pan(0, -55);
                        case KeyEvent.VK_PLUS, KeyEvent.VK_EQUALS -> panel.zoomIn();
                        case KeyEvent.VK_MINUS -> panel.zoomOut();
                    }
                }
            });

            panel.addMouseWheelListener(e -> {
                if (e.getWheelRotation() < 0) panel.zoomIn();
                else panel.zoomOut();
            });

            frame.add(controls, BorderLayout.NORTH);
            frame.pack();
            frame.setLocationRelativeTo(null);
            frame.setVisible(true);
            panel.requestFocusInWindow();
        });
    }
