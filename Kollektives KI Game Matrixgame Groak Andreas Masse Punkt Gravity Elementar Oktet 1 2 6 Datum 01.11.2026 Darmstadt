            g2.fillOval((int)(sx-r), (int)(sy-r), (int)(2*r), (int)(2*r));
            g2.setColor(b.color.brighter());
            g2.drawOval((int)(sx-r), (int)(sy-r), (int)(2*r), (int)(2*r));
        }

        if (DRAW_LINES && scenario == 4 && bodies.size() >= 9) {
            MasseKugel c = bodies.get(0);
