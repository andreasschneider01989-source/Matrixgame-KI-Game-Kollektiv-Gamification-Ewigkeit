    private void addOrbit(double d, double y, double m, double r, Color c, double central) {
        double v = Math.sqrt(G_SIM * central / Math.abs(d));
        bodies.add(new MasseKugel(d, y, 0, 0, d > 0 ? -v : v, 0, m, r, c));
    }

    private void doppelsternBasis() {
        double mA = 500000, mB = 300000, d = 100;
        double rA = d * mB / (mA + mB);
        double rB = d * mA / (mA + mB);
        double v = Math.sqrt(G_SIM * (mA + mB) / d);
        bodies.add(new MasseKugel(-rA, 0, 0, 0, -v * rA / d, 0, mA, 12, new Color(255, 220, 60)));
        bodies.add(new MasseKugel(rB, 0, 0, 0, v * rB / d, 0, mB, 10, new Color(255, 110, 50)));
    }

    private void galaktischesZentrumBasis() {
        double mBH = 3.5e6;
        bodies.add(new MasseKugel(0, 0, 0, 0, 0, 0, mBH, 18, Color.WHITE));
        addElliptic(320, 0.38, 25000, 8, Color.CYAN, mBH);
        addElliptic(180, 0.25, 16000, 7, Color.MAGENTA, mBH);
