package p2;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.ArrayList;
import java.util.List;

public class main extends JPanel implements ActionListener {

    // ===================== PHYSIK =====================
    final double G_SIM     = 9.5;           // bewusst konservativ
    final double SOFTENING = 1.5;
    final double DT        = 0.03;

    // ===================== ELEMENTAR-BAUSTEIN =====================
    double MASS_CENTER = 1_000_000;
    double MASS_INNER  = 6.0;
    double MASS_OUTER  = 9.0;

    double DIST_INNER  = 42.0;
    double DIST_OUTER  = 95.0;

    double VEL_FACTOR  = 0.93;              // leicht unter Kreisbahngeschwindigkeit

    boolean DRAW_LINES = true;
    int LOG_EVERY      = 40;

    // ===================== ZUSTAND =====================
    private final List<MasseKugel> bodies = new ArrayList<>();
    private double zoomFactor = 1.0;
    private double zoomCenterX = 0;
    private double zoomCenterY = 0;
    private double simSpeed = 1.0;
    private int scenario = 4;
    private int frameCounter = 0;
    private int extraCount = 0;

    private final int FRAME_WIDTH  = 1680;
    private final int FRAME_HEIGHT = 950;

    public main() {
        setPreferredSize(new Dimension(FRAME_WIDTH, FRAME_HEIGHT));
        setBackground(Color.BLACK);
        initScenario(4);
        new Timer(16, this).start();
    }

    // ===================== SZENARIEN =====================
    private void initScenario(int id) {
        bodies.clear();
        frameCounter = 0;
        extraCount = 0;
        zoomFactor = 1.0;
        zoomCenterX = 0;
        zoomCenterY = 0;
        scenario = id;

        switch (id) {
            case 1 -> planetenBasis();
            case 2 -> doppelsternBasis();
            case 3 -> galaktischesZentrumBasis();
            case 4 -> elementarBaustein(0, 0, true);   // erstes Oktett + Log
            case 5 -> protonenBasis();
            case 6 -> orbitalRecyclerBasis();
            case 9 -> earthSurfaceBasis();
            default -> elementarBaustein(0, 0, true);
        }
        repaint();
    }

    // ---------- ELEMENTAR-BAUSTEIN (stabil) ----------
    private void elementarBaustein(double ox, double oy, boolean log) {
        // Zentrum – fixiert
        MasseKugel zentrum = new MasseKugel(ox, oy, 0, 0, 0, 0,
                MASS_CENTER, 16, Color.WHITE);
        zentrum.movable = false;
        bodies.add(zentrum);

        // Innere Schale (2)
        double vIn = Math.sqrt(G_SIM * MASS_CENTER / DIST_INNER) * VEL_FACTOR;
        for (int i = 0; i < 2; i++) {
            double a = i * Math.PI;
            double x = ox + Math.cos(a) * DIST_INNER;
            double y = oy + Math.sin(a) * DIST_INNER;
            bodies.add(new MasseKugel(x, y, 0,
                    -Math.sin(a) * vIn, Math.cos(a) * vIn, 0,
                    MASS_INNER, 5, new Color(255, 90, 90)));
        }

        // Äußere Schale (6)
        double vOut = Math.sqrt(G_SIM * MASS_CENTER / DIST_OUTER) * VEL_FACTOR;
        for (int i = 0; i < 6; i++) {
            double a = i * Math.PI / 3.0;
            double x = ox + Math.cos(a) * DIST_OUTER;
            double y = oy + Math.sin(a) * DIST_OUTER;
            bodies.add(new MasseKugel(x, y, 0,
                    -Math.sin(a) * vOut, Math.cos(a) * vOut, 0,
                    MASS_OUTER, 6, new Color(90, 180, 255)));
        }

        if (log) {
            System.out.println("\n=== ELEMENTAR-BAUSTEIN (stabilisierte Version) ===");
            System.out.printf("Zentrum:     %,.0f  (fixiert)%n", MASS_CENTER);
            System.out.printf("Inner je:    %.1f%n", MASS_INNER);
            System.out.printf("Outer je:    %.1f%n", MASS_OUTER);
            System.out.printf("DIST_INNER = %.1f   DIST_OUTER = %.1f%n", DIST_INNER, DIST_OUTER);
            System.out.printf("G_SIM = %.1f   VEL_FACTOR = %.2f%n", G_SIM, VEL_FACTOR);
            System.out.println("================================================\n");
        }
    }

    private void spawnExtraElementar() {
