    private void earthSurfaceBasis() {
        double radius = 90;
        double masse = 3_500_000;
        MasseKugel erde = new MasseKugel(0, 0, 0, 0, 0, 0, masse, radius, new Color(40, 120, 240));
        erde.movable = false;
        erde.isPlanet = true;
