        g2.drawString("Szenario: " + scenarioName(scenario) + "   |  Mausrad = Zoom, Pfeiltasten = Pan", 18, 46);
    }

    private String scenarioName(int id) {
        return switch (id) {
            case 1 -> "Sonnensystem";
            case 2 -> "Doppelstern";
            case 3 -> "Galaktisches Zentrum";
