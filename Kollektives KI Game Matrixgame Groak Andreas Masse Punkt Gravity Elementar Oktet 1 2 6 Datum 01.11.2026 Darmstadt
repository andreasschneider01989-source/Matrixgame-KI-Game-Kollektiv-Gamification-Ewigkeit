    // ===================== PHYSIK =====================
    private void computeAccelerations() {
        for (MasseKugel b : bodies) {
            b.ax = b.ay = b.az = 0;
        }
        int n = bodies.size();
        for (int i = 0; i < n; i++) {
            MasseKugel bi = bodies.get(i);
            if (!bi.movable) continue;
            for (int j = 0; j < n; j++) {
                if (i == j) continue;
                MasseKugel bj = bodies.get(j);
                double dx = bj.x - bi.x;
                double dy = bj.y - bi.y;
                double dz = bj.z - bi.z;
                double r2 = dx*dx + dy*dy + dz*dz + SOFTENING*SOFTENING;
                double r = Math.sqrt(r2);
                double f = G_SIM * bj.mass / r2;
                bi.ax += f * dx / r;
                bi.ay += f * dy / r;
                bi.az += f * dz / r;
            }
        }
    }

    private void integrateVerlet(double dt) {
        for (MasseKugel b : bodies) {
            if (!b.movable) continue;
            b.vx += 0.5 * b.ax * dt;
            b.vy += 0.5 * b.ay * dt;
            b.vz += 0.5 * b.az * dt;
            b.x += b.vx * dt;
            b.y += b.vy * dt;
            b.z += b.vz * dt;
        }
        computeAccelerations();
        for (MasseKugel b : bodies) {
            if (!b.movable) continue;
            b.vx += 0.5 * b.ax * dt;
            b.vy += 0.5 * b.ay * dt;
            b.vz += 0.5 * b.az * dt;
        }
        resolveCollisions();
    }

    private void resolveCollisions() {
        int n = bodies.size();
        for (int i = 0; i < n; i++) {
            MasseKugel a = bodies.get(i);
            for (int j = i + 1; j < n; j++) {
                MasseKugel b = bodies.get(j);
                double dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z;
                double dist = Math.sqrt(dx*dx + dy*dy + dz*dz);
                double minD = a.radius + b.radius;
                if (dist < minD && dist > 1e-8) {
                    double nx = dx / dist, ny = dy / dist, nz = dz / dist;
                    double over = minD - dist;
                    if (a.movable) { a.x -= over*nx*0.5; a.y -= over*ny*0.5; a.z -= over*nz*0.5; }
                    if (b.movable) { b.x += over*nx*0.5; b.y += over*ny*0.5; b.z += over*nz*0.5; }

                    double velN = (b.vx-a.vx)*nx + (b.vy-a.vy)*ny + (b.vz-a.vz)*nz;
                    if (velN > 0) continue;

                    double e = 0.3;
                    double j = -(1+e)*velN / (1/a.mass + 1/b.mass);
                    if (a.movable) {
                        a.vx -= j*nx/a.mass; a.vy -= j*ny/a.mass; a.vz -= j*nz/a.mass;
                    }
                    if (b.movable) {
                        b.vx += j*nx/b.mass; b.vy += j*ny/b.mass; b.vz += j*nz/b.mass;
                    }

                    if (a.isPlanet && b.movable) {
                        double vr = b.vx*nx + b.vy*ny + b.vz*nz;
                        b.vx -= vr*nx*0.85; b.vy -= vr*ny*0.85; b.vz -= vr*nz*0.85;
                    }
                    if (b.isPlanet && a.movable) {
                        double vr = a.vx*(-nx) + a.vy*(-ny) + a.vz*(-nz);
                        a.vx -= vr*(-nx)*0.85; a.vy -= vr*(-ny)*0.85; a.vz -= vr*(-nz)*0.85;
                    }
                }
            }
        }
    }

    private double totalEnergy() {
        double kin = 0, pot = 0;
        for (MasseKugel b : bodies) kin += b.getEKin();
        int n = bodies.size();
        for (int i = 0; i < n; i++) {
            for (int j = i+1; j < n; j++) {
                MasseKugel a = bodies.get(i), b = bodies.get(j);
                double dx = b.x-a.x, dy = b.y-a.y, dz = b.z-a.z;
                double r = Math.sqrt(dx*dx + dy*dy + dz*dz + SOFTENING*SOFTENING);
                pot += -G_SIM * a.mass * b.mass / r;
            }
        }
        return kin + pot;
    }

    // ===================== LOGGING =====================
    private void logStability() {
        if (scenario != 4 || bodies.size() < 9) return;

        MasseKugel c = bodies.get(0);
        double rIn = 0, rOut = 0;
        for (int i = 1; i <= 2; i++) {
            rIn += Math.hypot(bodies.get(i).x - c.x, bodies.get(i).y - c.y);
        }
        for (int i = 3; i <= 8; i++) {
            rOut += Math.hypot(bodies.get(i).x - c.x, bodies.get(i).y - c.y);
        }
        rIn /= 2.0;
        rOut /= 6.0;

        double devIn  = Math.abs(rIn  - DIST_INNER) / DIST_INNER * 100.0;
        double devOut = Math.abs(rOut - DIST_OUTER) / DIST_OUTER * 100.0;

        System.out.printf("Frame %5d | r_inner=%6.2f (%5.1f%%) | r_outer=%6.2f (%5.1f%%) | E=% .3e | N=%d%n",
                frameCounter, rIn, devIn, rOut, devOut, totalEnergy(), bodies.size());
    }

    // ===================== RENDERING =====================
    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        g2.setColor(Color.BLACK);
