                    state.cooperation += 0.7;
                    state.goalProgress += 0.6;
                    state.joy += 0.3;
                    resources -= 0.2;
                    log.add("Runde " + turn + ": kooperiert; gemeinsamer Fortschritt.");
                }
                case EXPLORE -> {
                    state.interest += 0.8;
                    state.autonomy += 0.3;
                    state.goalProgress += 0.4;
                    state.vitality -= 0.3;
                    resources -= 0.2;
                    log.add("Runde " + turn + ": erkundet; Interesse steigt.");
                }
            }


            // Motivation reagiert hier nur modellhaft auf Interesse, Kompetenz und Energie.
            state.motivation = 0.4 * state.interest
                             + 0.3 * state.competence
                             + 0.3 * state.vitality;


            state.normalize();
            resources = clamp(resources);
        }
    }


    static final class Player {
        final String name;
        final State state = new State();


        Player(String name) {
            this.name = name;
        }


        /** Transparente Startregel; später durch Strategien oder KI ersetzbar. */
        Action chooseAction() {
            if (state.vitality < 3.5) return Action.REST;
            if (state.interest < 4.5) return Action.EXPLORE;
            if (state.cooperation < 5.0) return Action.COOPERATE;
            return Action.LEARN;
        }
    }


    static double clamp(double value) {
        return Math.max(MIN, Math.min(MAX, value));
    }


