            State before = player.state.copy();
            Action action = player.chooseAction();
            world.apply(action, player.state);


            System.out.printf(Locale.GERMANY,
                "%nRunde %d | Aktion: %s%nVorher:  %s%nNachher: %s%n",
                world.turn, action, before.summary(), player.state.summary());
        }


