        for (String event : world.log) {
            System.out.println("- " + event);
        }


        System.out.printf(Locale.GERMANY,
            "%nEndstand: Ziel %.1f/10 | Ressourcen %.1f/10%n",
            player.state.goalProgress, world.resources);
        System.out.println("Hinweis: Die Regeln und Gewichte sind Startannahmen, "
                         + "keine empirisch validierten psychologischen Gesetze.");
    }
