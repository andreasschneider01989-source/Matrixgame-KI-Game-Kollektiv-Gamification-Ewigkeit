python_code = '''"""MatrixMind CRISPR Governance Quest — illustrative decision-support toy model.
Not a scientific risk calculator, medical advice, or gene-editing protocol.
"""
from dataclasses import dataclass

@dataclass
class State:
    benefit: float = 75
    evidence: float = 55
    uncertainty: float = 65
    unintended_effects: float = 70
    equity: float = 45
    oversight: float = 60
    intergenerational_impact: float = 85
    coercion: float = 55

def clamp(x):
    return max(0.0, min(100.0, x))

def evaluate(s: State) -> dict:
    # Explicitly chosen discussion weights; not empirically validated.
    benefit_signal = 0.30*s.benefit + 0.25*s.evidence + 0.20*s.equity + 0.25*s.oversight
    concern_signal = (
        0.20*s.uncertainty
        + 0.20*s.unintended_effects
        + 0.25*s.intergenerational_impact
        + 0.20*s.coercion
        + 0.15*(100-s.oversight)
    )
    return {
        "benefit_signal": round(clamp(benefit_signal), 1),
        "concern_signal": round(clamp(concern_signal), 1),
        "human_review_required": (
            s.uncertainty >= 60
            or s.unintended_effects >= 60
            or s.intergenerational_impact >= 60
            or s.coercion >= 50
        ),
        "warning": "Illustrative scores; do not use as a real-world authorization rule."
    }

def apply_action(s: State, action: str) -> State:
    changes = {
        "evidence": {"evidence": 12, "oversight": 10, "uncertainty": -8},
        "equity": {"equity": 15, "oversight": 4},
        "heritable_safeguards": {"intergenerational_impact": -8, "oversight": 12, "coercion": -5},
        "public_participation": {"oversight": 12, "coercion": -8},
    }
    if action not in changes:
        raise ValueError(f"Unknown action: {action}")
    data = vars(s).copy()
    for key, delta in changes[action].items():
        data[key] = clamp(data[key] + delta)
    return State(**data)

if __name__ == "__main__":
    state = State()
    print("Baseline:", evaluate(state))
    for action in ("evidence", "equity", "heritable_safeguards", "public_participation"):
        candidate = apply_action(state, action)
        print(action, evaluate(candidate))
'''
