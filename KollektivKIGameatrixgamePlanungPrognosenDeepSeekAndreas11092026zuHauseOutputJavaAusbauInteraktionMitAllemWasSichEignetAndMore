### 4.2 Objektorientierte Massepunkte

```java
public class Massepunkt {
    public double masse;      // kg
    public double x, y, z;    // m
    public double vx, vy, vz; // m/s
    public double ax, ay, az; // m/s²

    public void update(double dt) {
        vx += ax * dt;
        vy += ay * dt;
        vz += az * dt;
        x += vx * dt;
        y += vy * dt;
        z += vz * dt;
    }

    public double abstand(Massepunkt other) {
        double dx = x - other.x;
        double dy = y - other.y;
        double dz = z - other.z;
        return Math.sqrt(dx*dx + dy*dy + dz*dz);
    }

    public void gravitation(Massepunkt other, double G) {
        double r = abstand(other);
        if (r < 1e-9) return;
        double F = G * masse * other.masse / (r * r);
        double axNeu = F / masse * (other.x - x) / r;
        double ayNeu = F / masse * (other.y - y) / r;
        double azNeu = F / masse * (other.z - z) / r;
        ax += axNeu;
        ay += ayNeu;
        az += azNeu;
    }
}
```

### 4.3 Echtzeit-Interaktion

```java
public class MatrixgameEchtzeit extends JFrame {
    private Timer timer;
    private List<Massepunkt> punkte = new ArrayList<>();

    public MatrixgameEchtzeit() {
        timer = new Timer(16, e -> { // 60 FPS
            for (Massepunkt p : punkte) {
                p.ax = 0; p.ay = 0; p.az = 0;
            }
            for (int i = 0; i < punkte.size(); i++) {
                for (int j = i+1; j < punkte.size(); j++) {
                    punkte.get(i).gravitation(punkte.get(j), 6.674e-11);
                    punkte.get(j).gravitation(punkte.get(i), 6.674e-11);
                }
            }
            for (Massepunkt p : punkte) p.update(0.016);
            repaint();
        });
        timer.start();
    }
}
```

