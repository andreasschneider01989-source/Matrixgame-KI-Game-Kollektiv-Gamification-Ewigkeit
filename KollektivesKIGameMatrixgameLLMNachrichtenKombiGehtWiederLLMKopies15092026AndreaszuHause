    public void panLeft() { zoomCenterX += PAN_STEP; repaint(); }

    public void panRight() { zoomCenterX -= PAN_STEP; repaint(); }

    public void panUp() { zoomCenterY += PAN_STEP; repaint(); }

    public void panDown() { zoomCenterY -= PAN_STEP; repaint(); }


    @Override

    protected void paintComponent(Graphics g) {

        super.paintComponent(g);

        Graphics2D g2 = (Graphics2D) g;

        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        g2.setColor(Color.BLACK);

        g2.fillRect(0, 0, getWidth(), getHeight());


        for (int i = 0; i < unitList.size(); i++) {

            Unit unit = unitList.get(i);

            if (unit.leben <= 0) continue;

            double radius = unit.size;

            Color color = new Color((int) Math.min(255, Math.max(0, unit.red)), 

                                      (int) Math.min(255, Math.max(0, unit.green)), 

                                      (int) Math.min(255, Math.max(0, unit.blue)));

            double sx = (zoomCenterX + unit.posX) * zoomFactor + getWidth() / 2.0;

            double sy = (zoomCenterY + unit.posY) * zoomFactor + getHeight() / 2.0;

            

            g2.setColor(color);

            g2.fillOval((int) (sx - radius), (int) (sy - radius), (int) (radius * 2), (int) (radius * 2));

            

            if (unit.isSelected) {

                g2.setColor(Color.WHITE);

                g2.drawOval((int) (sx - radius - 2), (int) (sy - radius - 2), (int) (radius * 2 + 4), (int) (radius * 2 + 4));

            }

        }


        if (isDragging) {

            g2.setColor(new Color(0, 255, 128, 60));

            int x = Math.min(dragStartX, currentMouseX);

            int y = Math.min(dragStartY, currentMouseY);

            int w = Math.abs(currentMouseX - dragStartX);

            int h = Math.abs(currentMouseY - dragStartY);

            g2.fillRect(x, y, w, h);

            g2.setColor(new Color(0, 255, 128));

            g2.drawRect(x, y, w, h);

        }


        // HUD / Kampagnen-Overlay Level 3

        g2.setColor(new Color(0, 255, 128));

        g2.setFont(new Font("Monospaced", Font.BOLD, 14));

        g2.drawString("Matrixgame [LEVEL 3] - Entropie-Pool: " + String.format("%.2f", globalEntropyPool), 20, 30);

        g2.drawString("Simulation Ticks: " + simulationTicks, 20, 55);


        drawUnitInspector(g2);

    }


