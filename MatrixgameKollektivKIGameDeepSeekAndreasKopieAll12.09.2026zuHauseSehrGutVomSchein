// In Unit.java ergänzen:
public double hp = 100.0;
public double angriff = 10.0;
public double verteidigung = 2.0;
public int team = 0;           // 0 oder 1
public double reichweite = 50.0;
public boolean kaempft = true;

public void greifeAn(Unit other) {
    if (!kaempft || !other.kaempft) return;
    if (team == other.team) return;

    double dx = other.x - this.x;
    double dy = other.y - this.y;
    double dz = other.z - this.z;
    double dist = Math.sqrt(dx*dx + dy*dy + dz*dz);

    if (dist <= reichweite) {
        double schaden = Math.max(1, angriff - other.verteidigung);
        other.hp -= schaden;
        if (other.hp <= 0) {
            other.kaempft = false;
            other.color = Color.DARK_GRAY;
        }
    }
}

