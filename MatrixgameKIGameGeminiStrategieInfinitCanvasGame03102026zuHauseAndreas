                <option value="health">Gesundheit (HP)</option>
                <option value="entropy">Entropie / Stress</option>
                <option value="power">Kampfkraft</option>
            </select>
            
            <label style="font-size: 0.75em; margin-top: 5px; display:block;">Y-Achse auf:</label>
            <select id="selectY" onchange="updateAxisMapping()">
                <option value="y">Raum-Position Y</option>
                <option value="health">Gesundheit (HP)</option>
                <option value="entropy">Entropie / Stress</option>
                <option value="power">Kampfkraft</option>
            </select>
        </div>

        <button onclick="spawnUnitCluster()">+ Schwarm/Einheiten Spawnen</button>
        <button onclick="triggerSafeBaseReturn()" style="border-color:#ffaa00; color:#ffaa00;">Rückzug zur Sicheren Basis</button>

        <div id="logConsole">
            <div>[System Log gestartet]</div>
        </div>
    </div>

    <!-- Interaktiver Canvas -->
    <div id="viewport">
        <canvas id="matrixCanvas"></canvas>
        <div class="overlay-info">
            Mausrad: Zoom | Linksklick + Ziehen: Panning | Rechtsklick: Basis setzen
        </div>
    </div>
</div>

<script>
// --- CANVAS & INFINITY TRANSFORMATIONS-ZUSTAND ---
const canvas = document.getElementById('matrixCanvas');
const ctx = canvas.getContext('2d');
const logConsole = document.getElementById('logConsole');

let scale = 1;
let offsetX = 0;
let offsetY = 0;
let isDragging = false;
let startX, startY;

let axisX = 'x';
let axisY = 'y';

// --- BASIS & EINHEITEN (UNIT FIGHT SIM ENGINE) ---
const baseStation = { x: 0, y: 0, radius: 35, name: "Sichere Basis (Ursprung)" };
let units = [];
let unitIdCounter = 1;

class SimUnit {
    constructor(faction, x, y) {
        this.id = `Unit_${unitIdCounter++}`;
        this.faction = faction; // 'guardian' oder 'swarm'
        this.x = x;
        this.y = y;
        this.vx = (Math.random() - 0.5) * 2;
        this.vy = (Math.random() - 0.5) * 2;
        this.health = 100;
        this.maxHealth = 100;
        this.entropy = Math.random() * 20;
        this.power = faction === 'guardian' ? 15 : 10;
        this.isReturning = false;
    }

    update() {
        // Kampf-Logik & Verhalten
        if (this.isReturning) {
            // Flug zurück zur Basis (Safe-Base Didaktik)
            let dx = baseStation.x - this.x;
            let dy = baseStation.y - this.y;
            let dist = Math.hypot(dx, dy);
            if (dist > 5) {
                this.x += (dx / dist) * 3;
                this.y += (dy / dist) * 3;
            } else {
                // Heilung an der Basis
                this.health = Math.min(this.maxHealth, this.health + 1);
                this.entropy = Math.max(0, this.entropy - 0.5);
                if (this.health >= this.maxHealth && this.entropy === 0) {
                    this.isReturning = false;
                    logMsg(`${this.id} regeneriert. Erneuter Einsatz bereit.`);
                }
            }
        } else {
            // Freie Bewegung / Schwarmverhalten
            this.x += this.vx;
            this.y += this.vy;

            // Zufälliges Entropie-Wachstum beim Erkunden
            this.entropy += 0.05;

            // Automatische Safe-Base-Auslösung bei kritischer Gesundheit
            if (this.health < 30 || this.entropy > 80) {
                this.isReturning = true;
                logMsg(`[WARNUNG] ${this.id} im kritischen Zustand. Rückkehr zur Basis initiiert.`);
            }
        }
    }
}

// --- INITIALISIERUNG ---
function init() {
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);
    
    // Basis zentrieren
    offsetX = canvas.width / 2;
    offsetY = canvas.height / 2;

    // Start-Einheiten erzeugen
    spawnUnitCluster();

    // Event-Listener für Infinity Zoom & Panning
    setupInteraction();

    // WebSocket Versuch
    initWebSocket();

    // Render-Schleife starten
    requestAnimationFrame(gameLoop);
}

function resizeCanvas() {
    canvas.width = canvas.parentElement.clientWidth;
    canvas.height = canvas.parentElement.clientHeight;
}

function logMsg(msg) {
    const entry = document.createElement('div');
    entry.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
    logConsole.appendChild(entry);
    logConsole.scrollTop = logConsole.scrollHeight;
}

function spawnUnitCluster() {
    for (let i = 0; i < 5; i++) {
        units.push(new SimUnit('guardian', (Math.random() - 0.5) * 200, (Math.random() - 0.5) * 200));
        units.push(new SimUnit('swarm', (Math.random() - 0.5) * 300, (Math.random() - 0.5) * 300));
    }
    logMsg("Neue Einheitengruppe im Sektor gespawnt.");
}

function triggerSafeBaseReturn() {
    units.forEach(u => u.isReturning = true);
    logMsg("Kollektiver Befehl: Alle Einheiten kehren zur sicheren Basis zurück.");
}

function updateAxisMapping() {
    axisX = document.getElementById('selectX').value;
    axisY = document.getElementById('selectY').value;
    logMsg(`Achsen neu projiziert: X=${axisX.toUpperCase()}, Y=${axisY.toUpperCase()}`);
}

// --- INTERAKTIONEN (ZOOM & PANNING) ---
function setupInteraction() {
    canvas.addEventListener('mousedown', (e) => {
        if (e.button === 0) { // Linksklick = Pan
            isDragging = true;
            startX = e.clientX - offsetX;
            startY = e.clientY - offsetY;
        }
    });

    canvas.addEventListener('mousemove', (e) => {
        if (isDragging) {
            offsetX = e.clientX - startX;
            offsetY = e.clientY - startY;
        }
    });

    canvas.addEventListener('mouseup', () => isDragging = false);

    canvas.addEventListener('wheel', (e) => {
        e.preventDefault();
        const zoomFactor = e.deltaY < 0 ? 1.1 : 0.9;
        
        const mouseX = e.clientX - canvas.offsetLeft;
        const mouseY = e.clientY - canvas.offsetTop;

        offsetX = mouseX - (mouseX - offsetX) * zoomFactor;
        offsetY = mouseY - (mouseY - offsetY) * zoomFactor;
        scale *= zoomFactor;
    });
}

// --- KOORDINATEN-PROJEKTION NACH ACHSEN-AUSSATZ ---
function getMappedCoords(unit) {
    let rawX = unit[axisX];
    let rawY = unit[axisY];

    // Falls Werte wie Gesundheit/Entropie verwendet werden, skaliere sie passend
    if (axisX !== 'x' && axisX !== 'y') rawX = (rawX - 50) * 4;
    if (axisY !== 'x' && axisY !== 'y') rawY = (rawY - 50) * 4;

    return { x: rawX, y: -rawY }; // Invertiere Y für Standard-Koordinatensystem
}

// --- SIMULATIONS- UND RENDER-SCHLEIFE ---
function gameLoop() {
    // 1. Logik aktualisieren
    units.forEach(u => u.update());

    // Simple Fight Sim Kollision / Schaden
    for (let i = 0; i < units.length; i++) {
        for (let j = i + 1; j < units.length; j++) {
            let u1 = units[i];
            let u2 = units[j];
            if (u1.faction !== u2.faction && !u1.isReturning && !u2.isReturning) {
                let dist = Math.hypot(u1.x - u2.x, u1.y - u2.y);
                if (dist < 30) {
                    u1.health -= 0.5;
                    u2.health -= 0.5;
                    u1.entropy += 0.2;
                    u2.entropy += 0.2;
                }
            }
        }
    }

    // UI Metriken updaten
    document.getElementById('unitCount').textContent = units.length;

    // 2. Zeichnen
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // Transformation für Infinity Zoom & Offset
    ctx.setTransform(scale, 0, 0, scale, offsetX, offsetY);

    // Rastersystem (Grid)
    drawGrid();

    // Basis zeichnen (nur bei Standard X/Y Projektion sinnvoll)
    if (axisX === 'x' && axisY === 'y') {
        ctx.beginPath();
        ctx.arc(baseStation.x, baseStation.y, baseStation.radius, 0, Math.PI * 2);
        ctx.fillStyle = "rgba(0, 243, 255, 0.1)";
        ctx.fill();
        ctx.strokeStyle = "#00f3ff";
        ctx.lineWidth = 2 / scale;
        ctx.stroke();
        
        ctx.fillStyle = "#ffffff";
        ctx.font = `${12 / scale}px Courier New`;
        ctx.fillText(baseStation.name, baseStation.x - 60, baseStation.y + 55);
    }

    // Einheiten zeichnen
    units.forEach(u => {
        const pos = getMappedCoords(u);

        ctx.beginPath();
        ctx.arc(pos.x, pos.y, u.faction === 'guardian' ? 8 : 6, 0, Math.PI * 2);
        ctx.fillStyle = u.faction === 'guardian' ? '#00f3ff' : '#ff0055';
        ctx.fill();

        if (u.isReturning) {
            ctx.strokeStyle = '#ffaa00';
            ctx.lineWidth = 1.5 / scale;
            ctx.stroke();
        }

        // Statusleiste über Einheit
        ctx.fillStyle = '#ffffff';
        ctx.font = `${9 / scale}px Courier New`;
        ctx.fillText(`${u.id} (${Math.round(u.health)}HP)`, pos.x + 10, pos.y - 5);
    });

    requestAnimationFrame(gameLoop);
}

function drawGrid() {
    const gridSize = 100;
    ctx.strokeStyle = "rgba(0, 243, 255, 0.05)";
    ctx.lineWidth = 1 / scale;

    const startGridX = -offsetX / scale - 1000;
    const endGridX = startGridX + (canvas.width / scale) + 2000;
    const startGridY = -offsetY / scale - 1000;
    const endGridY = startGridY + (canvas.height / scale) + 2000;

    for (let x = startGridX - (startGridX % gridSize); x < endGridX; x += gridSize) {
        ctx.beginPath();
        ctx.moveTo(x, startGridY);
        ctx.lineTo(x, endGridY);
        ctx.stroke();
    }
    for (let y = startGridY - (startGridY % gridSize); y < endGridY; y += gridSize) {
        ctx.beginPath();
        ctx.moveTo(startGridX, y);
        ctx.lineTo(endGridX, y);
        ctx.stroke();
    }
}

// --- WEBSOCKET SCHNITTSTELLE ---
function initWebSocket() {
    try {
        const ws = new WebSocket('ws://localhost:8080');
        ws.onopen = () => {
            document.getElementById('wsStatus').textContent = "Online";
            document.getElementById('wsStatus').style.color = "#00ff66";
            logMsg("WebSocket-Verbindung zu Port 8080 erfolgreich hergestellt.");
        };
        ws.onerror = () => {
            logMsg("WebSocket nicht erreichbar (Lokaler Modus aktiv).");
        };
    } catch(e) {
        logMsg("WebSocket Initialisierung übersprungen.");
    }
}

window.onload = init;
</script>
</body>
