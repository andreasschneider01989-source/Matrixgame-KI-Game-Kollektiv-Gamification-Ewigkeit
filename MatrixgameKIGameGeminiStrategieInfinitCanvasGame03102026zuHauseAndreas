package p1;

public abstract class LuminiObjekt {
    // 3D-Raumkoordinaten relativ zum Nullpunkt
    public double x, y, z;
    
    // Zeitvariablen für die Simulation
    public double timeCreation;
    public double timeBefore;
    public double timeCurrent;
    public double deltaTime;
    
    public LuminiObjekt(double x, double y, double z, double timeCurrent) {
        this.x = x;
        this.y = y;
        this.z = z;
        this.timeCreation = timeCurrent;
        this.timeBefore = timeCurrent;
        this.timeCurrent = timeCurrent;
        this.deltaTime = 0;
    }
    
    // Aktualisiert die Zeit und berechnet deltaTime
    public void updateTime(double newTime) {
        this.timeBefore = this.timeCurrent;
        this.timeCurrent = newTime;
        this.deltaTime = this.timeCurrent - this.timeBefore;
    }
    
    // Mathematisch strikte Abstandsrechnung (Pythagoras) mit garantiert positivem Ergebnis
    public double getAbstandZu(LuminiObjekt other) {
        double dx = other.x - this.x;
        double dy = other.y - this.y;
        double dz = other.z - this.z;
        // Pythagoras: d = sqrt(x^2 + y^2 + z^2)
        return Math.sqrt(dx * dx + dy * dy + dz * dz);
    }
    
