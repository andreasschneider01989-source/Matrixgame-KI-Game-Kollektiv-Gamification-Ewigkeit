<script>
// --- CANVAS & SYSTEM STATE ---
const canvas = document.getElementById('matrixCanvas');
const ctx = canvas.getContext('2d');
const chatConsole = document.getElementById('chatConsole');

let scale = 1;
let offsetX = 0;
let offsetY = 0;
let isDragging = false;
let startX, startY;

let axisX = 'x';
let axisY = 'y';

let selectedEntity = null; // Ausgewählte Einheit oder Basis

// Spielobjekte
let bases = [
    { id: 'B_G1', faction: 'guardian', type: 'main', name: 'Guardian HQ', x: -250, y: 0, radius: 40, territoryRadius: 220, energy: 150, maxEnergy: 500 },
    { id: 'B_S1', faction: 'swarm', type: 'main', name: 'Swarm Nest', x: 250, y: 0, radius: 40, territoryRadius: 220, energy: 150, maxEnergy: 500 }
];

let turrets = [];
let units = [];
let resources = [];
let laserEffects = [];
let unitCounter = 1;

class SimUnit {
    constructor(faction, role, x, y) {
        this.id = `${faction === 'guardian' ? 'G' : 'S'}-${role === 'harvester' ? 'H' : 'F'}${unitCounter++}`;
        this.faction = faction;
        this.role = role; // 'harvester' (Sammler/Bauer) oder 'fighter' (Kampfeinheit)
        this.x = x;
        this.y = y;
        this.health = role === 'fighter' ? 140 : 80;
        this.maxHealth = this.health;
        this.cargo = 0;
        this.maxCargo = role === 'harvester' ? 6 : 0;
        
        // KI & Befehls-Zustand
        this.targetResource = null;
        this.moveTarget = null;
        this.attackTarget = null;
        this.isReturning = false;
        this.attackRange = role === 'fighter' ? 120 : 50;
        this.dps = role === 'fighter' ? 2.5 : 0.6;
        this.speed = role === 'fighter' ? 2.6 : 2.0;
    }

    update() {
        // 1. Manueller Marsch- oder Angriffs-Befehl hat Vorrang
        if (this.attackTarget) {
            if (this.attackTarget.health <= 0) {
                this.attackTarget = null;
            } else {
                let dx = this.attackTarget.x - this.x;
                let dy = this.attackTarget.y - this.y;
                let dist = Math.hypot(dx, dy);

                if (dist > this.attackRange * 0.8) {
                    this.x += (dx / dist) * this.speed;
                    this.y += (dy / dist) * this.speed;
                }
                
                if (dist <= this.attackRange) {
                    this.attackTarget.health -= this.dps;
                    laserEffects.push({ 
                        x1: this.x, y1: this.y, 
                        x2: this.attackTarget.x, y2: this.attackTarget.y, 
                        color: this.faction === 'guardian' ? '#00f3ff' : '#ff0055', 
                        life: 2 
                    });
                }
                return;
            }
        }

        if (this.moveTarget) {
            let dx = this.moveTarget.x - this.x;
            let dy = this.moveTarget.y - this.y;
            let dist = Math.hypot(dx, dy);

            if (dist > 5) {
                this.x += (dx / dist) * this.speed;
                this.y += (dy / dist) * this.speed;
            } else {
                this.moveTarget = null; // Ziel erreicht
            }
            return;
        }

        // 2. Automatisches Verhalten für Sammler (Harvester)
        if (this.role === 'harvester') {
            let nearestBase = findNearestAlliedBase(this);
            if (this.cargo >= this.maxCargo || this.isReturning) {
                if (!nearestBase) return;
                let dx = nearestBase.x - this.x;
                let dy = nearestBase.y - this.y;
                let dist = Math.hypot(dx, dy);

                if (dist > 12) {
                    this.x += (dx / dist) * this.speed;
                    this.y += (dy / dist) * this.speed;
                } else {
                    if (this.cargo > 0) {
                        nearestBase.energy = Math.min(nearestBase.maxEnergy, nearestBase.energy + this.cargo * 10);
                        this.cargo = 0;
                    }
                    this.health = Math.min(this.maxHealth, this.health + 2);
                    this.isReturning = false;
                }
            } else {
                if (!this.targetResource || !resources.includes(this.targetResource)) {
                    this.targetResource = findClosestResource(this);
                }

                if (this.targetResource) {
                    let dx = this.targetResource.x - this.x;
                    let dy = this.targetResource.y - this.y;
                    let dist = Math.hypot(dx, dy);

                    if (dist > 6) {
                        this.x += (dx / dist) * this.speed;
                        this.y += (dy / dist) * this.speed;
                    } else {
                        let amount = this.targetResource.type === 'scrap' ? 2 : 1;
                        this.cargo = Math.min(this.maxCargo, this.cargo + amount);
                        this.targetResource.amount -= 1;
                        if (this.targetResource.amount <= 0) {
                            resources = resources.filter(r => r !== this.targetResource);
                        }
                        this.targetResource = null;
                        if (this.cargo >= this.maxCargo) this.isReturning = true;
                    }
                }
            }
        } 
        // 3. Automatisches Verhalten für Jäger (Fighter - Patrouille & Autotarget)
        else if (this.role === 'fighter') {
            let enemy = findNearestEnemyUnit(this);
            if (enemy && enemy.dist < 200) {
                this.attackTarget = enemy.unit;
            } else {
                // Sanfte Patrouille um die nächste eigene Basis
                let base = findNearestAlliedBase(this);
                if (base) {
                    let d = Math.hypot(base.x - this.x, base.y - this.y);
                    if (d > 180) {
                        this.x += ((base.x - this.x) / d) * this.speed * 0.5;
                        this.y += ((base.y - this.y) / d) * this.speed * 0.5;
                    }
                }
            }
        }
    }
}

class Turret {
    constructor(faction, x, y) {
        this.id = `Turret-${unitCounter++}`;
        this.faction = faction;
        this.x = x;
        this.y = y;
        this.health = 200;
        this.maxHealth = 200;
        this.range = 170;
        this.dps = 1.5;
    }

    update() {
        units.forEach(u => {
            if (u.faction !== this.faction) {
                let d = Math.hypot(u.x - this.x, u.y - this.y);
                if (d < this.range) {
                    u.health -= this.dps;
                    laserEffects.push({ x1: this.x, y1: this.y, x2: u.x, y2: u.y, color: '#ffaa00', life: 2 });
                }
            }
        });
    }
}

// --- HELPER FUNCTIONS ---
function findNearestEnemyUnit(unit) {
    let nearest = null;
    let minDist = Infinity;
    units.forEach(u => {
        if (u.faction !== unit.faction) {
            let d = Math.hypot(u.x - unit.x, u.y - unit.y);
            if (d < minDist) {
                minDist = d;
                nearest = u;
            }
        }
    });
    return nearest ? { unit: nearest, dist: minDist } : null;
}

function findNearestAlliedBase(unit) {
    let nearest = null;
    let minDist = Infinity;
    bases.forEach(b => {
        if (b.faction === unit.faction) {
            let d = Math.hypot(b.x - unit.x, b.y - unit.y);
            if (d < minDist) {
                minDist = d;
                nearest = b;
            }
        }
    });
    return nearest;
}

function findClosestResource(unit) {
    let closest = null;
    let minDist = Infinity;
    resources.forEach(r => {
        let d = Math.hypot(r.x - unit.x, r.y - unit.y);
        if (d < minDist) {
            minDist = d;
            closest = r;
        }
    });
    return closest;
}

// --- INIT & SETUP ---
function init() {
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);
    offsetX = canvas.width / 2;
    offsetY = canvas.height / 2;

    // Start-Einheiten
    units.push(new SimUnit('guardian', 'harvester', bases[0].x - 30, bases[0].y));
    units.push(new SimUnit('guardian', 'harvester', bases[0].x - 20, bases[0].y + 20));
    units.push(new SimUnit('guardian', 'fighter', bases[0].x + 30, bases[0].y - 20));

    units.push(new SimUnit('swarm', 'harvester', bases[1].x + 30, bases[1].y));
    units.push(new SimUnit('swarm', 'harvester', bases[1].x + 20, bases[1].y - 20));
    units.push(new SimUnit('swarm', 'fighter', bases[1].x - 30, bases[1].y + 20));

    spawnResourceCluster();
    setupInteractions();

    requestAnimationFrame(gameLoop);
}

function resizeCanvas() {
    canvas.width = canvas.parentElement.clientWidth;
    canvas.height = canvas.parentElement.clientHeight;
}

function logMsg(msg, cssClass = 'msg-sys') {
    const el = document.createElement('div');
    el.className = cssClass;
    el.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
    chatConsole.appendChild(el);
    chatConsole.scrollTop = chatConsole.scrollHeight;
}

function spawnResourceCluster() {
    for (let i = 0; i < 12; i++) {
        resources.push({ x: (Math.random() - 0.5) * 550, y: (Math.random() - 0.5) * 450, amount: 4, type: 'crystal' });
    }
    logMsg("Neue Bio-Kristalle im Hauptraum verteilt.");
}

// --- COMMAND DECK / INSPECTOR UPDATE ---
function updateInspector() {
    const titleEl = document.getElementById('inspTitle');
    const statsEl = document.getElementById('inspStats');
    const actionsEl = document.getElementById('inspActions');

    actionsEl.innerHTML = '';

    if (!selectedEntity) {
        titleEl.textContent = 'Keine Auswahl';
        statsEl.textContent = 'Klicke auf eine Einheit oder Basis auf dem Feld.';
        return;
    }

    // A. Basis ausgewählt
    if (selectedEntity.radius) {
        const b = selectedEntity;
        titleEl.textContent = `${b.name} (${b.faction.toUpperCase()})`;
        statsEl.innerHTML = `Typ: ${b.type}<br>Energie-Vorrat: ${Math.round(b.energy)} / ${b.maxEnergy}`;

        if (b.faction === 'guardian') {
            const btnHarvester = document.createElement('button');
            btnHarvester.textContent = '+ Sammler bauen (30 E)';
            btnHarvester.onclick = () => produceUnit(b, 'harvester', 30);
            if (b.energy < 30) btnHarvester.disabled = true;

            const btnFighter = document.createElement('button');
            btnFighter.textContent = '+ Jäger bauen (50 E)';
            btnFighter.onclick = () => produceUnit(b, 'fighter', 50);
            if (b.energy < 50) btnFighter.disabled = true;

            actionsEl.appendChild(btnHarvester);
            actionsEl.appendChild(btnFighter);
        }
    } 
    // B. Einheit ausgewählt
    else if (selectedEntity.role) {
        const u = selectedEntity;
        titleEl.textContent = `Einheit ${u.id} (${u.role.toUpperCase()})`;
        statsEl.innerHTML = `Fraktion: ${u.faction}<br>HP: ${Math.round(u.health)} / ${u.maxHealth}<br>` +
                            (u.role === 'harvester' ? `Fracht: ${u.cargo} / ${u.maxCargo}` : `DPS: ${u.dps}`);

        if (u.faction === 'guardian' && u.role === 'harvester') {
            const btnTurret = document.createElement('button');
            btnTurret.textContent = 'Turm hier bauen (60 E)';
            btnTurret.onclick = () => buildTurretWithWorker(u);

            const btnOutpost = document.createElement('button');
            btnOutpost.textContent = 'Außenposten bauen (100 E)';
            btnOutpost.onclick = () => buildOutpostWithWorker(u);

            actionsEl.appendChild(btnTurret);
            actionsEl.appendChild(btnOutpost);
        }
    }
}

function produceUnit(base, role, cost) {
    if (base.energy >= cost) {
        base.energy -= cost;
        const newUnit = new SimUnit(base.faction, role, base.x + (Math.random()-0.5)*30, base.y + (Math.random()-0.5)*30);
        units.push(newUnit);
        logMsg(`[REKRUTIERUNG] ${role === 'harvester' ? 'Sammler' : 'Jäger'} ${newUnit.id} an ${base.name} fertiggestellt.`, 'msg-cmd');
        updateInspector();
    }
}

function buildTurretWithWorker(worker) {
    let mainBase = bases.find(b => b.faction === 'guardian' && b.type === 'main');
    if (mainBase && mainBase.energy >= 60) {
        mainBase.energy -= 60;
        turrets.push(new Turret('guardian', worker.x, worker.y));
        logMsg(`[BAU] Sammler ${worker.id} hat einen Verteidigungsturm errichtet!`, 'msg-cmd');
    } else {
        logMsg("Nicht genügend Basen-Energie für Turmbau (60 E).");
    }
}

function buildOutpostWithWorker(worker) {
    let mainBase = bases.find(b => b.faction === 'guardian' && b.type === 'main');
    if (mainBase && mainBase.energy >= 100) {
        mainBase.energy -= 100;
        bases.push({
            id: `B_G_${bases.length+1}`,
            faction: 'guardian',
            type: 'outpost',
            name: 'Guardian Depot',
            x: worker.x,
            y: worker.y,
            radius: 25,
            territoryRadius: 130,
            energy: 0,
            maxEnergy: 250
        });
        logMsg(`[BAU] Sammler ${worker.id} hat einen Außenposten gegründet!`, 'msg-cmd');
    } else {
        logMsg("Nicht genügend Basen-Energie für Außenposten (100 E).");
    }
}

// --- MAUS INTERAKTIONEN ---
function setupInteractions() {
    canvas.addEventListener('mousedown', (e) => {
        const mouseX = e.clientX - canvas.offsetLeft;
        const mouseY = e.clientY - canvas.offsetTop;
        const worldX = (mouseX - offsetX) / scale;
        const worldY = (mouseY - offsetY) / scale;

        // Linksklick: Selektion
        if (e.button === 0) {
            let found = null;

            // 1. Einheiten prüfen
            units.forEach(u => {
                if (Math.hypot(u.x - worldX, u.y - worldY) < 15) found = u;
            });

            // 2. Basen prüfen
            if (!found) {
                bases.forEach(b => {
                    if (Math.hypot(b.x - worldX, b.y - worldY) < b.radius) found = b;
                });
            }

            selectedEntity = found;
            updateInspector();

            if (!found) {
                isDragging = true;
                startX = e.clientX - offsetX;
                startY = e.clientY - offsetY;
            }
        }
    });

    canvas.addEventListener('mousemove', (e) => {
        if (isDragging) {
            offsetX = e.clientX - startX;
            offsetY = e.clientY - startY;
        }
    });

    canvas.addEventListener('mouseup', () => isDragging = false);

    canvas.addEventListener('wheel', (e) => {
        e.preventDefault();
        const zoomFactor = e.deltaY < 0 ? 1.1 : 0.9;
        const mouseX = e.clientX - canvas.offsetLeft;
        const mouseY = e.clientY - canvas.offsetTop;

        offsetX = mouseX - (mouseX - offsetX) * zoomFactor;
        offsetY = mouseY - (mouseY - offsetY) * zoomFactor;
        scale *= zoomFactor;
    });

    // Rechtsklick: Taktischer Befehl für selektierte Einheit
    canvas.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        if (!selectedEntity || !selectedEntity.role) return;

        const mouseX = e.clientX - canvas.offsetLeft;
        const mouseY = e.clientY - canvas.offsetTop;
        const worldX = (mouseX - offsetX) / scale;
        const worldY = (mouseY - offsetY) / scale;

        const unit = selectedEntity;

        // Prüfen ob Feind angeklickt wurde
        let enemyTarget = null;
        units.forEach(u => {
            if (u.faction !== unit.faction && Math.hypot(u.x - worldX, u.y - worldY) < 18) {
                enemyTarget = u;
            }
        });

        if (enemyTarget) {
            unit.attackTarget = enemyTarget;
            unit.moveTarget = null;
            logMsg(`[BEFEHL] ${unit.id} greift ${enemyTarget.id} an!`, 'msg-cmd');
            return;
        }

        // Prüfen ob Ressource angeklickt wurde
        let resTarget = null;
        resources.forEach(r => {
            if (Math.hypot(r.x - worldX, r.y - worldY) < 15) resTarget = r;
        });

        if (resTarget && unit.role === 'harvester') {
            unit.targetResource = resTarget;
            unit.moveTarget = null;
            logMsg(`[BEFEHL] ${unit.id} baut gezielt Ressource ab.`, 'msg-cmd');
            return;
        }

        // Standard: Marschbefehl
        unit.moveTarget = { x: worldX, y: worldY };
        unit.attackTarget = null;
        logMsg(`[BEFEHL] ${unit.id} marschiert zu (${Math.round(worldX)}, ${Math.round(worldY)})`, 'msg-cmd');
    });
}

function updateAxisMapping() {
    axisX = document.getElementById('selectX').value;
    axisY = document.getElementById('selectY').value;
}

function getMappedCoords(obj) {
    let rawX = obj[axisX] !== undefined ? obj[axisX] : obj.x;
    let rawY = obj[axisY] !== undefined ? obj[axisY] : obj.y;

    if (axisX === 'health') rawX = (rawX - 50) * 5;
    if (axisY === 'health') rawY = (rawY - 50) * 5;
    if (axisX === 'cargo') rawX = (rawX - 2.5) * 80;
    if (axisY === 'cargo') rawY = (rawY - 2.5) * 80;

    return { x: rawX, y: -rawY };
}

// --- GAME LOOP ---
function gameLoop() {
    // 1. Swarm KI Autonomie (Baut selbstständig Sammler/Jäger)
    let swarmMain = bases.find(b => b.faction === 'swarm' && b.type === 'main');
    if (swarmMain && swarmMain.energy >= 50) {
        let swarmHarvesters = units.filter(u => u.faction === 'swarm' && u.role === 'harvester').length;
        let swarmFighters = units.filter(u => u.faction === 'swarm' && u.role === 'fighter').length;

        if (swarmHarvesters < 5 && swarmMain.energy >= 30) {
            produceUnit(swarmMain, 'harvester', 30);
        } else if (swarmFighters < 8 && swarmMain.energy >= 50) {
            produceUnit(swarmMain, 'fighter', 50);
        }
    }

    // 2. Einheiten & Türme verarbeiten
    units.forEach(u => u.update());
    turrets.forEach(t => t.update());

    // Recycling von Wracks bei Zerstörung
    units = units.filter(u => {
        if (u.health <= 0) {
            resources.push({ x: u.x, y: u.y, amount: 3, type: 'scrap' });
            if (selectedEntity === u) {
                selectedEntity = null;
                updateInspector();
            }
            logMsg(`[VERLUST] ${u.id} wurde zerstört!`, 'msg-combat');
            return false;
        }
        return true;
    });

    // UI Stats Update
    let gMain = bases.find(b => b.faction === 'guardian' && b.type === 'main');
    let sMain = bases.find(b => b.faction === 'swarm' && b.type === 'main');
    document.getElementById('gEnergy').textContent = Math.round(gMain ? gMain.energy : 0);
    document.getElementById('sEnergy').textContent = Math.round(sMain ? sMain.energy : 0);

    let gHarv = units.filter(u => u.faction === 'guardian' && u.role === 'harvester').length;
    let gFig = units.filter(u => u.faction === 'guardian' && u.role === 'fighter').length;
    let sHarv = units.filter(u => u.faction === 'swarm' && u.role === 'harvester').length;
    let sFig = units.filter(u => u.faction === 'swarm' && u.role === 'fighter').length;

    document.getElementById('gUnits').textContent = `${gHarv} / ${gFig}`;
    document.getElementById('sUnits').textContent = `${sHarv} / ${sFig}`;
    document.getElementById('gBases').textContent = `${bases.filter(b => b.faction === 'guardian').length} / ${turrets.filter(t => t.faction === 'guardian').length}`;
    document.getElementById('sBases').textContent = `${bases.filter(b => b.faction === 'swarm').length} / ${turrets.filter(t => t.faction === 'swarm').length}`;

    // 3. Render Canvas
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.setTransform(scale, 0, 0, scale, offsetX, offsetY);

    drawGrid();

    // Basen & Territorien
    bases.forEach(b => {
        if (axisX === 'x' && axisY === 'y') {
            ctx.beginPath();
            ctx.arc(b.x, b.y, b.territoryRadius, 0, Math.PI * 2);
            ctx.fillStyle = b.faction === 'guardian' ? "rgba(0, 243, 255, 0.03)" : "rgba(255, 0, 85, 0.03)";
            ctx.fill();
            ctx.strokeStyle = b.faction === 'guardian' ? "rgba(0, 243, 255, 0.2)" : "rgba(255, 0, 85, 0.2)";
            ctx.setLineDash([4, 4]);
            ctx.stroke();
            ctx.setLineDash([]);

            ctx.beginPath();
            ctx.arc(b.x, b.y, b.radius, 0, Math.PI * 2);
            ctx.fillStyle = b.faction === 'guardian' ? "rgba(0, 243, 255, 0.15)" : "rgba(255, 0, 85, 0.15)";
            ctx.fill();
            ctx.strokeStyle = b.faction === 'guardian' ? "#00f3ff" : "#ff0055";
            ctx.lineWidth = 2 / scale;
            ctx.stroke();

            // Auswahlring
            if (selectedEntity === b) {
                ctx.beginPath();
                ctx.arc(b.x, b.y, b.radius + 6, 0, Math.PI * 2);
                ctx.strokeStyle = '#ffffff';
                ctx.lineWidth = 1.5 / scale;
                ctx.stroke();
            }

            ctx.fillStyle = '#ffffff';
            ctx.font = `${10 / scale}px Courier New`;
            ctx.fillText(`${b.name} (${Math.round(b.energy)}E)`, b.x - 30, b.y + b.radius + 12);
        }
    });

    // Türme
    turrets.forEach(t => {
        const pos = getMappedCoords(t);
        ctx.beginPath();
        ctx.arc(pos.x, pos.y, 9, 0, Math.PI * 2);
        ctx.fillStyle = t.faction === 'guardian' ? '#00f3ff' : '#ff0055';
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.stroke();
    });

    // Ressourcen
    resources.forEach(r => {
        const pos = getMappedCoords(r);
        ctx.beginPath();
        ctx.arc(pos.x, pos.y, r.type === 'scrap' ? 5 : 4, 0, Math.PI * 2);
        ctx.fillStyle = r.type === 'scrap' ? '#aaa' : '#ffaa00';
        ctx.fill();
    });

    // Einheiten
    units.forEach(u => {
        const pos = getMappedCoords(u);

        ctx.beginPath();
        if (u.role === 'harvester') {
            // Sammler als Kreis
            ctx.arc(pos.x, pos.y, u.faction === 'guardian' ? 7 : 6, 0, Math.PI * 2);
        } else {
            // Jäger als Raute/Dreieck
            ctx.rect(pos.x - 5, pos.y - 5, 10, 10);
        }
        ctx.fillStyle = u.faction === 'guardian' ? '#00f3ff' : '#ff0055';
        ctx.fill();

        // Ausgewählte Einheit leuchten lassen
        if (selectedEntity === u) {
            ctx.beginPath();
            ctx.arc(pos.x, pos.y, 12, 0, Math.PI * 2);
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 1.5 / scale;
            ctx.stroke();
        }

        // HP-Balken
        ctx.fillStyle = '#ff0000';
        ctx.fillRect(pos.x - 8, pos.y - 11, 16, 2 / scale);
        ctx.fillStyle = '#00ffaa';
        ctx.fillRect(pos.x - 8, pos.y - 11, (u.health / u.maxHealth) * 16, 2 / scale);
    });

    // Lasereffekte
    laserEffects.forEach(l => {
        ctx.beginPath();
        ctx.moveTo(l.x1, l.y1);
        ctx.lineTo(l.x2, l.y2);
        ctx.strokeStyle = l.color;
        ctx.lineWidth = 1.5 / scale;
        ctx.stroke();
        l.life -= 1;
    });
    laserEffects = laserEffects.filter(l => l.life > 0);

    requestAnimationFrame(gameLoop);
}

function drawGrid() {
    const gridSize = 100;
    ctx.strokeStyle = "rgba(0, 243, 255, 0.03)";
    ctx.lineWidth = 1 / scale;

    const startXGrid = -offsetX / scale - 1000;
    const endXGrid = startXGrid + (canvas.width / scale) + 2000;
    const startYGrid = -offsetY / scale - 1000;
    const endYGrid = startYGrid + (canvas.height / scale) + 2000;

    for (let x = startXGrid - (startXGrid % gridSize); x < endXGrid; x += gridSize) {
        ctx.beginPath();
        ctx.moveTo(x, startYGrid);
        ctx.lineTo(x, endYGrid);
        ctx.stroke();
    }
    for (let y = startYGrid - (startYGrid % gridSize); y < endYGrid; y += gridSize) {
        ctx.beginPath();
        ctx.moveTo(startXGrid, y);
        ctx.lineTo(endXGrid, y);
        ctx.stroke();
    }
}

window.onload = init;
</script>
