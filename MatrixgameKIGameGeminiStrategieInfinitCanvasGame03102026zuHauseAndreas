package p1;

import java.awt.Color;

public class MasseKugel extends LuminiObjekt {
    public double mass;
    
    // Geschwindigkeitsvektoren (Velocity)
    public double vx, vy, vz;
    
    // Beschleunigungsvektoren (Acceleration)
    public double ax, ay, az;
    
    public Color color;
    public int radius;
    
    // Konstante für Gravitation (für Matrixgame anpassbar)
    public static final double G = 0.01; 

    public MasseKugel(double x, double y, double z, double vx, double vy, double vz, double mass, int radius, Color color, double timeCurrent) {
        super(x, y, z, timeCurrent);
        this.vx = vx;
        this.vy = vy;
        this.vz = vz;
        this.mass = mass;
        this.radius = radius;
        this.color = color;
    }

    // Kinetische Energie: E_kin = 0.5 * m * v^2
    public double getEKin() {
        double speedSqr = (this.vx * this.vx) + (this.vy * this.vy) + (this.vz * this.vz);
        return 0.5 * this.mass * speedSqr;
    }

    // Wechselwirkung und Gravitation: F = G * (m1 * m2) / r^2
    public void berechneGravitation(MasseKugel other) {
        double dist = this.getAbstandZu(other);
        if (dist <= 0.0001) return; // Singularitäten und Division durch Null vermeiden

        double kraft = (G * this.mass * other.mass) / (dist * dist);
        
        // Richtungsvektoren normalisieren
        double normX = (other.x - this.x) / dist;
        double normY = (other.y - this.y) / dist;
        double normZ = (other.z - this.z) / dist;
        
        // a = F / m
        double beschleunigung = kraft / this.mass;
        
        // Beschleunigungsvektoren updaten
        this.ax += beschleunigung * normX;
        this.ay += beschleunigung * normY;
        this.az += beschleunigung * normZ;
    }

    // Aktualisiert Vektoren und Position basierend auf deltaTime
    public void updatePhysik() {
        // v = v0 + a * dt
        this.vx += this.ax * this.deltaTime;
        this.vy += this.ay * this.deltaTime;
        this.vz += this.az * this.deltaTime;
        
        // s = s0 + v * dt
        this.x += this.vx * this.deltaTime;
        this.y += this.vy * this.deltaTime;
        this.z += this.vz * this.deltaTime;
        
        // Reset Beschleunigung für den nächsten Zeitschritt
        this.ax = 0;
        this.ay = 0;
        this.az = 0;
    }
}
