package p1;



import java.awt.Color;

import java.util.Random;



/**

 * MATRIXGAME: ZIVILISATIONS-SIMULATION

 * Erweitert die physikalische MasseKugel um soziologische Kausalitäten.

 */

public class ZivilisationsKugel extends MasseKugel {

    

    // Soziologische Zustandsvariablen (0.0 bis 100.0)

    public double komplexitaet;    // Tainter: Je höher, desto mehr Energie wird für Verwaltung verbraucht

    public int eliteCount;         // Turchin: Anzahl der Eliten

    public int maxThrones;         // Turchin: Verfügbare Machtpositionen

    public double kohaesion;       // Vertrauen/Zusammenhalt (Gegenkraft zur Entropie)

    public double entropie;        // Spengler/Glubb: Der unvermeidliche Zerfall, wenn nicht gegengesteuert wird

    

    public boolean istCaesarismus; // Der letzte Akt: Aufgabe der Freiheit für scheinbare Ruhe



    public ZivilisationsKugel(double x, double y, double z, double mass, int eliteCount, int maxThrones, double timeCurrent) {

        super(x, y, z, 0, 0, 0, mass, 10, Color.BLUE, timeCurrent);

        this.eliteCount = eliteCount;

        this.maxThrones = maxThrones;

        this.komplexitaet = 20.0; // Startet gesund und agil

        this.kohaesion = 80.0;    // Hoher Zusammenhalt

        this.entropie = 5.0;      // Niedriger Zerfall

        this.istCaesarismus = false;

    }



    /**

     * SIMULATIONSSCHRITT: Wendet die historischen "Dummheiten" als physikalische Kräfte an.

     */

    public void simuliereHistorischeKausalitaet(double deltaTime) {

        

        // 1. TAINTER-EFFEKT: Abnehmender Grenzertrag der Komplexität

        // Je komplexer, desto mehr kinetische Energie (Handlungsfähigkeit) geht in Reibung (Entropie) verloren.

        double reibungsverlust = (this.komplexitaet / 100.0) * 0.5;

        this.vx *= (1.0 - reibungsverlust * deltaTime);

        this.vy *= (1.0 - reibungsverlust * deltaTime);

        this.vz *= (1.0 - reibungsverlust * deltaTime);

        this.entropie += reibungsverlust * deltaTime * 10;



        // 2. TURCHIN-EFFEKT: Elitenüberproduktion

        // Wenn Elite > Throne, sinkt die Kohäsion drastisch (innere Unruhe/Bürgerkrieg)

        if (this.eliteCount > this.maxThrones) {

            double ueberproduktionsDruck = (this.eliteCount - this.maxThrones) * 0.5;

            this.kohaesion -= ueberproduktionsDruck * deltaTime;

            this.entropie += ueberproduktionsDruck * deltaTime * 2;

        }



        // 3. GLOBB/SPEGLER-EFFEKT: Das Zeitalter des Intellekts (Herbst fühlt sich wie Gipfel an)

        // Wenn Kohäsion niedrig ist, aber das System noch läuft, steigt die Komplexität weiter, 

        // bis der "Caesarismus" eintritt (vollständige Trägheit).

        if (this.kohaesion < 30.0 && !this.istCaesarismus) {

            this.komplexitaet += 5.0 * deltaTime; // Panische Verwaltung

