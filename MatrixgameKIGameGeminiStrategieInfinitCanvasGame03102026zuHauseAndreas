            div.innerText = `[${time}] ${text}`;
            chatLog.appendChild(div);
            chatLog.scrollTop = chatLog.scrollHeight;
        }

        // Knoten-Klasse für Zivilisationskugeln & Aufklärungsdrohnen
        class MatrixNode {
            constructor(x, y, label, isShared = false) {
                this.x = x;
                this.y = y;
                this.vx = (Math.random() - 0.5) * 1.2;
                this.vy = (Math.random() - 0.5) * 1.2;
                this.label = label;
                this.radius = 12 + Math.random() * 8;
                this.komplexitaet = 20.0;
                this.kohaesion = 75.0 + Math.random() * 10;
                this.entropie = 5.0 + Math.random() * 10;
                this.intuition = 80.0 + Math.random() * 20;
                this.isShared = isShared;
                this.selected = false;
            }

            update() {
                this.x += this.vx;
                this.y += this.vy;

                if (this.x < this.radius || this.x > width - this.radius) this.vx *= -1;
                if (this.y < this.radius || this.y > height - this.radius) this.vy *= -1;

                // Natürliche Entropie-Dynamik
                this.entropie += 0.01;
                if (this.entropie > 100) this.entropie = 100;
            }

            draw() {
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);

                // Farb-Logik nach SQL View & Soziophysik
                let color = '#0088ff'; // Blau: Stabil
                if (this.entropie > this.kohaesion) {
                    color = '#ff4757'; // Rot: Kollapsgefahr
                } else if (this.intuition < 20.0) {
                    color = '#ffa500'; // Orange: Intuitionswarnung
                } else if (this.isShared) {
                    color = '#00f0ff'; // Cyan: Dual-Control
                }

                ctx.fillStyle = color;
                ctx.shadowColor = color;
                ctx.shadowBlur = this.selected ? 20 : 8;
                ctx.fill();
                ctx.shadowBlur = 0;

                ctx.strokeStyle = '#ffffff55';
                ctx.lineWidth = 1.5;
                ctx.stroke();

                // Label
                ctx.fillStyle = '#ffffff';
                ctx.font = '10px monospace';
                ctx.fillText(this.label, this.x - this.radius, this.y + this.radius + 12);
            }
        }

        const nodes = [
            new MatrixNode(width * 0.3, height * 0.4, "Knoten_Earth_Core"),
            new MatrixNode(width * 0.6, height * 0.3, "Drohne_Alpha_Dual", true),
            new MatrixNode(width * 0.5, height * 0.7, "Drohne_Beta_Dual", true),
            new MatrixNode(width * 0.2, height * 0.8, "Zivilisation_Sektor_7")
        ];

        function drawConnections() {
            for (let i = 0; i < nodes.length; i++) {
                for (let j = i + 1; j < nodes.length; j++) {
                    const dx = nodes[i].x - nodes[j].x;
                    const dy = nodes[i].y - nodes[j].y;
                    const dist = Math.sqrt(dx * dx + dy * dy);

                    if (dist < 250) {
                        ctx.beginPath();
                        ctx.moveTo(nodes[i].x, nodes[i].y);
                        ctx.lineTo(nodes[j].x, nodes[j].y);
                        ctx.strokeStyle = `rgba(0, 240, 255, ${1 - dist / 250})`;
                        ctx.lineWidth = 0.8;
                        ctx.stroke();
                    }
                }
            }
        }

        function updateMetrics() {
            document.getElementById('node-count').innerText = nodes.length;
            let totalCoh = 0, totalEnt = 0, totalInt = 0;

            nodes.forEach(n => {
                totalCoh += n.kohaesion;
                totalEnt += n.entropie;
                totalInt += n.intuition;
            });

            const avgCoh = (totalCoh / nodes.length).toFixed(1);
            const avgEnt = (totalEnt / nodes.length).toFixed(1);
            const avgInt = (totalInt / nodes.length).toFixed(1);

            document.getElementById('avg-cohesion').innerText = avgCoh;
            document.getElementById('avg-entropy').innerText = avgEnt;
            document.getElementById('avg-intuition').innerText = avgInt;

            // Q = I + S + O + K - E
            const q = (parseFloat(avgCoh) + parseFloat(avgInt) - parseFloat(avgEnt)).toFixed(1);
            document.getElementById('q-score').innerText = q;
        }

        function triggerDualControl() {
            nodes.forEach(n => {
                n.isShared = true;
                n.kohaesion = Math.min(100, n.kohaesion + 20);
                n.entropie = Math.max(0, n.entropie - 15);
            });
            logMessage("DUAL-CONTROL ACTIVATED: Geteilter Daten-Stream auf allen Einheiten.", "system");
        }

        function triggerDeescalation() {
            nodes.forEach(n => {
                n.entropie = Math.max(2, n.entropie - 30);
                n.kohaesion = Math.min(100, n.kohaesion + 15);
                n.intuition = Math.min(100, n.intuition + 10);
            });
            logMessage("Q-DEESKALATION EXECUTED: Harm Reduction angewendet. Entropie kollabiert.", "user");
        }

        function sendChatMessage() {
            const input = document.getElementById('chat-input');
            const text = input.value.trim();
            if (!text) return;

            logMessage(`Andreas (Guardian): ${text}`, "user");
            input.value = '';

            // Simulierter Kollektiv-Broadcast
            setTimeout(() => {
                const responses = [
                    "Kollektiv-Knoten 04: Telemetrie empfangen und in SQL-Ledger validiert.",
                    "S.H.I.E.L.D.-Core: Dual-Control Handshake stabil. Keinerlei Eskalation festgestellt.",
                    "Gwen_Node: Canvas-State verifiziert. Freier Wille bleibt unangetastet."
                ];
                const randResp = responses[Math.floor(Math.random() * responses.length)];
                logMessage(randResp, "system");
            }, 800);
        }

        // Interaktion per Maus
        canvas.addEventListener('click', (e) => {
            const rect = canvas.getBoundingClientRect();
            const mouseX = e.clientX - rect.left;
            const mouseY = e.clientY - rect.top;

            nodes.forEach(n => {
                const dist = Math.hypot(n.x - mouseX, n.y - mouseY);
                n.selected = dist < n.radius;
                if (n.selected) {
                    logMessage(`Knoten selektiert: ${n.label} | Kohäsion: ${n.kohaesion.toFixed(1)} | Entropie: ${n.entropie.toFixed(1)}`, "system");
                }
            });
        });

        canvas.addEventListener('contextmenu', (e) => {
            e.preventDefault();
            const rect = canvas.getBoundingClientRect();
            const mouseX = e.clientX - rect.left;
            const mouseY = e.clientY - rect.top;

            const newDrone = new MatrixNode(mouseX, mouseY, `Drohne_${nodes.length + 1}_Net`, true);
            nodes.push(newDrone);
            logMessage(`Neuer Aufklärungs-Knoten platziert: ${newDrone.label}`, "system");
        });

        // Haupt-Render-Loop
        function animate() {
            ctx.clearRect(0, 0, width, height);
            drawConnections();

            nodes.forEach(node => {
                node.update();
                node.draw();
            });

            updateMetrics();
            requestAnimationFrame(animate);
        }

        // Initialisierung
        logMessage("Infinity Canvas erfolgreich aufgespannt.", "system");
        logMessage("Multiplayer-Interface auf Port 8080 horchbereit (WebSockets-Ready).", "system");
        animate();
    </script>
