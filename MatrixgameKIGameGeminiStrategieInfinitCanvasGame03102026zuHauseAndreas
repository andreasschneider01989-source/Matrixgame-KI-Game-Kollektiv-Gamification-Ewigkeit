public class LuminiEngine {
    private List<MasseKugel> existenzRaum = new ArrayList<>();
    private double globaleZeit = 0.0;
    
    public void addObjekt(MasseKugel mk) {
        existenzRaum.add(mk);
    }
    
    // Hauptschleife der Compilierung pro Zeitschritt
    public void step(double timeCurrent) {
        // 1. Zeit-Update für alle Objekte
        for (MasseKugel mk : existenzRaum) {
            mk.updateTime(timeCurrent);
        }
        
        // 2. Gravitation und Wechselwirkungen berechnen (Potentielle Energie)
        for (int i = 0; i < existenzRaum.size(); i++) {
            MasseKugel m1 = existenzRaum.get(i);
            for (int j = i + 1; j < existenzRaum.size(); j++) {
                MasseKugel m2 = existenzRaum.get(j);
                
                // Kraft wirkt in beide Richtungen
                m1.berechneGravitation(m2);
                m2.berechneGravitation(m1);
            }
        }
        
        // 3. Stochastische Entropie-Anpassung zur Modellierung von Quantenschwankungen
        anwendenEntropie();
        
        // 4. Bewegung ausführen (Kinetische Energie)
        for (MasseKugel mk : existenzRaum) {
            mk.updatePhysik();
            // Erzeugen des BasisStrings zur Nachverfolgung
            String status = String.format("ID:%d | x=%.2f, y=%.2f, z=%.2f | EKin=%.4f", 
                                          mk.hashCode(), mk.x, mk.y, mk.z, mk.getEKin());
        }
        this.globaleZeit = timeCurrent;
    }
    
    // Fügt den gezielten Zufall (Entropie) in das System ein
    private void anwendenEntropie() {
        for (MasseKugel mk : existenzRaum) {
            // Leichte Schwankungen in den Geschwindigkeitsvektoren (Zufall steuerbar)
            double entropieFaktor = 0.0001; 
            mk.vx += (Math.random() - 0.5) * entropieFaktor;
            mk.vy += (Math.random() - 0.5) * entropieFaktor;
            mk.vz += (Math.random() - 0.5) * entropieFaktor;
        }
    }
}
