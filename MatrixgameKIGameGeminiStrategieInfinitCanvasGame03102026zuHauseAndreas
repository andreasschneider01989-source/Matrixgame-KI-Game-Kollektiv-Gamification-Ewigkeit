<script>
// --- NETZWERK & BROADCAST CHANNEL (MULTI-TAB MULTIPLAYER) ---
const netChannel = new BroadcastChannel('matrixgame_quantum_net');

// --- CANVAS & STATE ---
const canvas = document.getElementById('matrixCanvas');
const ctx = canvas.getContext('2d');
const chatConsole = document.getElementById('chatConsole');

let scale = 1;
let offsetX = 0;
let offsetY = 0;
let isDragging = false;
let startX, startY;

let axisX = 'x';
let axisY = 'y';

let guardianBase = { x: -150, y: 0, radius: 40, energy: 100, name: "Guardian Prime Basis" };
let swarmBase = { x: 250, y: 0, radius: 40, energy: 100, name: "Swarm Hive Node" };

let units = [];
let resources = [];
let questHarvested = 0;
let unitIdCounter = 1;

class SimUnit {
    constructor(faction, x, y) {
        this.id = `${faction === 'guardian' ? 'G' : 'S'}-${unitIdCounter++}`;
        this.faction = faction;
        this.x = x;
        this.y = y;
        this.vx = (Math.random() - 0.5) * 2;
        this.vy = (Math.random() - 0.5) * 2;
        this.health = 100;
        this.maxHealth = 100;
        this.cargo = 0; // Gemessene Bio-Kristalle
        this.targetResource = null;
        this.isReturning = false;
    }

    update() {
        const homeBase = this.faction === 'guardian' ? guardianBase : swarmBase;

        if (this.isReturning || this.cargo >= 5 || this.health < 25) {
            // Rückflug zur Heimatbasis
            let dx = homeBase.x - this.x;
            let dy = homeBase.y - this.y;
            let dist = Math.hypot(dx, dy);
            if (dist > 10) {
                this.x += (dx / dist) * 2.5;
                this.y += (dy / dist) * 2.5;
            } else {
                // Entladen & Regenerieren an der Basis
                if (this.cargo > 0) {
                    homeBase.energy += this.cargo * 10;
                    if (this.faction === 'guardian') {
                        questHarvested += this.cargo;
                        updateQuestUI();
                    }
                    this.cargo = 0;
                }
                this.health = Math.min(this.maxHealth, this.health + 2);
                if (this.health >= this.maxHealth) {
                    this.isReturning = false;
                }
            }
        } else {
            // Suche nach Ressourcen
            if (!this.targetResource || !resources.includes(this.targetResource)) {
                this.targetResource = findClosestResource(this);
            }

            if (this.targetResource) {
                let dx = this.targetResource.x - this.x;
                let dy = this.targetResource.y - this.y;
                let dist = Math.hypot(dx, dy);
                if (dist > 5) {
                    this.x += (dx / dist) * 2;
                    this.y += (dy / dist) * 2;
                } else {
                    // Ernte Kristall
                    this.cargo += 1;
                    resources = resources.filter(r => r !== this.targetResource);
                    this.targetResource = null;
                    this.isReturning = true; // Nach Ernte zurück
                }
            } else {
                // Patrouille / Freie Bewegung
                this.x += this.vx;
                this.y += this.vy;
                if (Math.abs(this.x) > 800) this.vx *= -1;
                if (Math.abs(this.y) > 800) this.vy *= -1;
            }
        }
    }
}

function findClosestResource(unit) {
    let closest = null;
    let minDist = Infinity;
    resources.forEach(r => {
        let d = Math.hypot(r.x - unit.x, r.y - unit.y);
        if (d < minDist) {
            minDist = d;
            closest = r;
        }
    });
    return closest;
}

// --- SETUP & EVENTS ---
function init() {
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);
    offsetX = canvas.width / 2;
    offsetY = canvas.height / 2;

    // Start-Einheiten & Ressourcen erzeugen
    for(let i=0; i<8; i++) units.push(new SimUnit('guardian', guardianBase.x + (Math.random()-0.5)*50, guardianBase.y + (Math.random()-0.5)*50));
    for(let i=0; i<8; i++) units.push(new SimUnit('swarm', swarmBase.x + (Math.random()-0.5)*50, swarmBase.y + (Math.random()-0.5)*50));
    
    spawnResourceNodes();
    setupInteractions();

    // Chat-Verlauf aus localStorage laden
    loadChatJournal();

    // BroadcastChannel Nachrichten empfangen
    netChannel.onmessage = (e) => {
        const data = e.data;
        if (data.type === 'CHAT_SIGNAL') {
            appendChatMessage(data.sender, data.text, false);
        } else if (data.type === 'SPAWN_RESOURCE') {
            resources.push({ x: data.x, y: data.y });
            appendSystemMessage(`[Multi-Tab] Bio-Kristall bei (${Math.round(data.x)}, ${Math.round(data.y)}) platziert.`);
        }
    };

    requestAnimationFrame(gameLoop);
}

function resizeCanvas() {
    canvas.width = canvas.parentElement.clientWidth;
    canvas.height = canvas.parentElement.clientHeight;
}

function spawnResourceNodes() {
    for (let i = 0; i < 12; i++) {
        resources.push({
            x: (Math.random() - 0.5) * 600,
            y: (Math.random() - 0.5) * 500
        });
    }
    appendSystemMessage("Neue Bio-Kristall-Felder im Raum generiert.");
}

function triggerSafeBaseReturn() {
    units.forEach(u => u.isReturning = true);
    appendSystemMessage("Rückzug-Signal an alle Einheiten gesendet.");
}

function updateQuestUI() {
    document.getElementById('questProgress').textContent = `${questHarvested}/25`;
    if (questHarvested >= 25) {
        document.getElementById('questText').textContent = "QUEST ERFÜLLT: Raumzeit-Entropie stabilisiert! Weiteres Ernten stärkt die Basis.";
        document.getElementById('questBox').style.borderColor = "#00ffaa";
        document.getElementById('questBox').style.color = "#00ffaa";
    }
}

// --- INTERAKTION & INFINITY ZOOM/PAN ---
function setupInteractions() {
    canvas.addEventListener('mousedown', (e) => {
        if (e.button === 0) {
            isDragging = true;
            startX = e.clientX - offsetX;
            startY = e.clientY - offsetY;
        }
    });

    canvas.addEventListener('mousemove', (e) => {
        if (isDragging) {
            offsetX = e.clientX - startX;
            offsetY = e.clientY - startY;
        }
    });

    canvas.addEventListener('mouseup', () => isDragging = false);

    canvas.addEventListener('wheel', (e) => {
        e.preventDefault();
        const zoomFactor = e.deltaY < 0 ? 1.1 : 0.9;
        const mouseX = e.clientX - canvas.offsetLeft;
        const mouseY = e.clientY - canvas.offsetTop;

        offsetX = mouseX - (mouseX - offsetX) * zoomFactor;
        offsetY = mouseY - (mouseY - offsetY) * zoomFactor;
        scale *= zoomFactor;
    });

    // Rechtsklick: Bio-Kristall platzieren & synchonisieren
    canvas.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        const mouseX = e.clientX - canvas.offsetLeft;
        const mouseY = e.clientY - canvas.offsetTop;
        
        // Transformiere Bildschirm-Touch in Welt-Koordinaten
        const worldX = (mouseX - offsetX) / scale;
        const worldY = (mouseY - offsetY) / scale;

        resources.push({ x: worldX, y: worldY });
        appendSystemMessage(`Bio-Kristall manuell gesetzt bei (${Math.round(worldX)}, ${Math.round(worldY)}).`);

        // Synchronisiere an andere Tabs
        netChannel.postMessage({ type: 'SPAWN_RESOURCE', x: worldX, y: worldY });
    });
}

function updateAxisMapping() {
    axisX = document.getElementById('selectX').value;
    axisY = document.getElementById('selectY').value;
    appendSystemMessage(`Achsenprojektion angepasst: X=${axisX}, Y=${axisY}`);
}

function getMappedCoords(obj) {
    let rawX = obj[axisX] !== undefined ? obj[axisX] : obj.x;
    let rawY = obj[axisY] !== undefined ? obj[axisY] : obj.y;

    if (axisX === 'health') rawX = (rawX - 50) * 5;
    if (axisY === 'health') rawY = (rawY - 50) * 5;
    if (axisX === 'cargo') rawX = (rawX - 2.5) * 100;
    if (axisY === 'cargo') rawY = (rawY - 2.5) * 100;

    return { x: rawX, y: -rawY };
}

// --- CHAT / PERSISTENZ (LOCALSTORAGE + BROADCAST) ---
function sendSignal() {
    const input = document.getElementById('chatInput');
    const text = input.value.trim();
    if (!text) return;

    appendChatMessage('Guardian-Operator', text, true);

    // Sende an andere geöffnete Tabs
    netChannel.postMessage({ type: 'CHAT_SIGNAL', sender: 'Guardian-Operator', text: text });

    input.value = '';
}

function appendChatMessage(sender, text, isSelf) {
    const msgEl = document.createElement('div');
    msgEl.className = 'chat-msg chat-user';
    msgEl.textContent = `[${new Date().toLocaleTimeString()}] ${sender}: ${text}`;
    chatConsole.appendChild(msgEl);
    chatConsole.scrollTop = chatConsole.scrollHeight;

    saveChatJournal(sender, text);
}

function appendSystemMessage(text) {
    const msgEl = document.createElement('div');
    msgEl.className = 'chat-msg chat-system';
    msgEl.textContent = `[${new Date().toLocaleTimeString()}] ${text}`;
    chatConsole.appendChild(msgEl);
    chatConsole.scrollTop = chatConsole.scrollHeight;
}

function saveChatJournal(sender, text) {
    let history = JSON.parse(localStorage.getItem('matrixgame_journal') || '[]');
    history.push({ time: new Date().toISOString(), sender, text });
    if(history.length > 50) history.shift();
    localStorage.setItem('matrixgame_journal', JSON.stringify(history));
}

function loadChatJournal() {
    let history = JSON.parse(localStorage.getItem('matrixgame_journal') || '[]');
    if (history.length > 0) {
        appendSystemMessage("--- Gespeichertes Matrixgame-Journal geladen ---");
        history.forEach(h => {
            const msgEl = document.createElement('div');
            msgEl.className = 'chat-msg chat-user';
            msgEl.textContent = `[${new Date(h.time).toLocaleTimeString()}] ${h.sender}: ${h.text}`;
            chatConsole.appendChild(msgEl);
        });
    }
}

// --- MAIN GAME LOOP ---
function gameLoop() {
    // Einheiten-Update
    units.forEach(u => u.update());

    // UI Stats
    document.getElementById('unitCount').textContent = units.length;
    document.getElementById('resCount').textContent = resources.length;
    document.getElementById('baseEnergy').textContent = Math.round(guardianBase.energy);

    // Rendering
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    ctx.setTransform(scale, 0, 0, scale, offsetX, offsetY);

    // Raster
    drawGrid();

    // Basen zeichnen
    if (axisX === 'x' && axisY === 'y') {
        // Guardian Base
        ctx.beginPath();
        ctx.arc(guardianBase.x, guardianBase.y, guardianBase.radius, 0, Math.PI * 2);
        ctx.fillStyle = "rgba(0, 243, 255, 0.15)";
        ctx.fill();
        ctx.strokeStyle = "#00f3ff";
        ctx.lineWidth = 2 / scale;
        ctx.stroke();

        // Swarm Base
        ctx.beginPath();
        ctx.arc(swarmBase.x, swarmBase.y, swarmBase.radius, 0, Math.PI * 2);
        ctx.fillStyle = "rgba(255, 0, 85, 0.15)";
        ctx.fill();
        ctx.strokeStyle = "#ff0055";
        ctx.stroke();
    }

    // Bio-Kristalle / Ressourcen zeichnen
    resources.forEach(r => {
        const pos = getMappedCoords(r);
        ctx.beginPath();
        ctx.arc(pos.x, pos.y, 4, 0, Math.PI * 2);
        ctx.fillStyle = '#ffaa00';
        ctx.fill();
        ctx.shadowColor = '#ffaa00';
        ctx.shadowBlur = 8;
    });
    ctx.shadowBlur = 0; // Reset Shadow

    // Einheiten zeichnen
    units.forEach(u => {
        const pos = getMappedCoords(u);

        ctx.beginPath();
        ctx.arc(pos.x, pos.y, u.faction === 'guardian' ? 7 : 6, 0, Math.PI * 2);
        ctx.fillStyle = u.faction === 'guardian' ? '#00f3ff' : '#ff0055';
        ctx.fill();

        // Fracht-Indikator
        if (u.cargo > 0) {
            ctx.strokeStyle = '#ffaa00';
            ctx.lineWidth = 2 / scale;
            ctx.stroke();
        }

        // Beschriftung
        ctx.fillStyle = '#ffffff';
        ctx.font = `${9 / scale}px Courier New`;
        ctx.fillText(`${u.id} ${u.cargo > 0 ? '[Kristall]' : ''}`, pos.x + 8, pos.y - 3);
    });

    requestAnimationFrame(gameLoop);
}

function drawGrid() {
    const gridSize = 100;
    ctx.strokeStyle = "rgba(0, 243, 255, 0.04)";
    ctx.lineWidth = 1 / scale;

    const startXGrid = -offsetX / scale - 1000;
    const endXGrid = startXGrid + (canvas.width / scale) + 2000;
    const startYGrid = -offsetY / scale - 1000;
    const endYGrid = startYGrid + (canvas.height / scale) + 2000;

    for (let x = startXGrid - (startXGrid % gridSize); x < endXGrid; x += gridSize) {
        ctx.beginPath();
        ctx.moveTo(x, startYGrid);
        ctx.lineTo(x, endYGrid);
        ctx.stroke();
    }
    for (let y = startYGrid - (startYGrid % gridSize); y < endYGrid; y += gridSize) {
        ctx.beginPath();
        ctx.moveTo(startXGrid, y);
        ctx.lineTo(endXGrid, y);
        ctx.stroke();
    }
}

window.onload = init;
</script>
</body>
</html>
