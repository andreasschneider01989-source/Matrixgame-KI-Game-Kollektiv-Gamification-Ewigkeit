<script>
// --- BROADCAST NETWORK ---
const netChannel = new BroadcastChannel('matrixgame_rts_net');

// --- CANVAS & SYSTEM STATE ---
const canvas = document.getElementById('matrixCanvas');
const ctx = canvas.getContext('2d');
const chatConsole = document.getElementById('chatConsole');

let scale = 1;
let offsetX = 0;
let offsetY = 0;
let isDragging = false;
let startX, startY;

let axisX = 'x';
let axisY = 'y';

// Fraktions-Basen & Gebiete
let bases = [
    { id: 'B_G1', faction: 'guardian', type: 'main', x: -250, y: 0, radius: 45, territoryRadius: 220, energy: 120, maxEnergy: 500 },
    { id: 'B_S1', faction: 'swarm', type: 'main', x: 250, y: 0, radius: 45, territoryRadius: 220, energy: 120, maxEnergy: 500 }
];

let turrets = [];
let units = [];
let resources = [];
let laserEffects = [];
let unitCounter = 1;

class SimUnit {
    constructor(faction, x, y) {
        this.id = `${faction === 'guardian' ? 'G' : 'S'}-${unitCounter++}`;
        this.faction = faction;
        this.x = x;
        this.y = y;
        this.vx = (Math.random() - 0.5) * 2;
        this.vy = (Math.random() - 0.5) * 2;
        this.health = 100;
        this.maxHealth = 100;
        this.cargo = 0;
        this.maxCargo = 5;
        this.targetResource = null;
        this.isReturning = false;
        this.attackRange = 60;
        this.dps = 0.8;
    }

    update() {
        // 1. Feind in Reichweite bekämpfen (Ressourcenkonflikt)
        let enemy = findNearestEnemyUnit(this);
        if (enemy && enemy.dist < this.attackRange) {
            enemy.unit.health -= this.dps;
            laserEffects.push({ x1: this.x, y1: this.y, x2: enemy.unit.x, y2: enemy.unit.y, color: this.faction === 'guardian' ? '#00f3ff' : '#ff0055', life: 2 });
            
            if (enemy.unit.health <= 0) {
                logMsg(`[KAMPF] ${this.id} hat ${enemy.unit.id} zerstört! (Schrott hinterlassen)`, 'msg-combat');
            }
        }

        // 2. Rückkehr bei voller Fracht oder niedriger HP
        let nearestBase = findNearestAlliedBase(this);
        if (this.cargo >= this.maxCargo || this.health < 25 || this.isReturning) {
            if (!nearestBase) return;
            let dx = nearestBase.x - this.x;
            let dy = nearestBase.y - this.y;
            let dist = Math.hypot(dx, dy);

            if (dist > 12) {
                this.x += (dx / dist) * 2.2;
                this.y += (dy / dist) * 2.2;
            } else {
                // Entladen & Heilung
                if (this.cargo > 0) {
                    nearestBase.energy = Math.min(nearestBase.maxEnergy, nearestBase.energy + this.cargo * 12);
                    this.cargo = 0;
                }
                this.health = Math.min(this.maxHealth, this.health + 3);
                if (this.health >= this.maxHealth) this.isReturning = false;
            }
        } else {
            // 3. Ressourcen suchen (Kristalle oder Schrott)
            if (!this.targetResource || !resources.includes(this.targetResource)) {
                this.targetResource = findClosestResource(this);
            }

            if (this.targetResource) {
                let dx = this.targetResource.x - this.x;
                let dy = this.targetResource.y - this.y;
                let dist = Math.hypot(dx, dy);

                if (dist > 6) {
                    this.x += (dx / dist) * 2;
                    this.y += (dy / dist) * 2;
                } else {
                    // Ernten / Recyceln
                    let harvestAmount = this.targetResource.type === 'scrap' ? 2 : 1;
                    this.cargo = Math.min(this.maxCargo, this.cargo + harvestAmount);
                    
                    this.targetResource.amount -= 1;
                    if (this.targetResource.amount <= 0) {
                        resources = resources.filter(r => r !== this.targetResource);
                    }
                    this.targetResource = null;
                    if (this.cargo >= this.maxCargo) this.isReturning = true;
                }
            } else {
                // Patrouille
                this.x += this.vx;
                this.y += this.vy;
                if (Math.abs(this.x) > 900) this.vx *= -1;
                if (Math.abs(this.y) > 900) this.vy *= -1;
            }
        }
    }
}

class Turret {
    constructor(faction, x, y) {
        this.faction = faction;
        this.x = x;
        this.y = y;
        this.range = 160;
        this.dps = 1.2;
    }

    update() {
        // Feinde im Territorium beschießen
        units.forEach(u => {
            if (u.faction !== this.faction) {
                let d = Math.hypot(u.x - this.x, u.y - this.y);
                if (d < this.range) {
                    u.health -= this.dps;
                    laserEffects.push({ x1: this.x, y1: this.y, x2: u.x, y2: u.y, color: '#ffaa00', life: 3 });
                }
            }
        });
    }
}

// --- HELPER FUNCTIONS ---
function findNearestEnemyUnit(unit) {
    let nearest = null;
    let minDist = Infinity;
    units.forEach(u => {
        if (u.faction !== unit.faction) {
            let d = Math.hypot(u.x - unit.x, u.y - unit.y);
            if (d < minDist) {
                minDist = d;
                nearest = u;
            }
        }
    });
    return nearest ? { unit: nearest, dist: minDist } : null;
}

function findNearestAlliedBase(unit) {
    let nearest = null;
    let minDist = Infinity;
    bases.forEach(b => {
        if (b.faction === unit.faction) {
            let d = Math.hypot(b.x - unit.x, b.y - unit.y);
            if (d < minDist) {
                minDist = d;
                nearest = b;
            }
        }
    });
    return nearest;
}

function findClosestResource(unit) {
    let closest = null;
    let minDist = Infinity;
    resources.forEach(r => {
        let d = Math.hypot(r.x - unit.x, r.y - unit.y);
        if (d < minDist) {
            minDist = d;
            closest = r;
        }
    });
    return closest;
}

// --- SYSTEM INITIALISIERUNG ---
function init() {
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);
    offsetX = canvas.width / 2;
    offsetY = canvas.height / 2;

    // Start-Einheiten
    for(let i=0; i<4; i++) units.push(new SimUnit('guardian', bases[0].x + (Math.random()-0.5)*40, bases[0].y + (Math.random()-0.5)*40));
    for(let i=0; i<4; i++) units.push(new SimUnit('swarm', bases[1].x + (Math.random()-0.5)*40, bases[1].y + (Math.random()-0.5)*40));

    spawnResourceCluster();
    setupInteractions();

    requestAnimationFrame(gameLoop);
}

function resizeCanvas() {
    canvas.width = canvas.parentElement.clientWidth;
    canvas.height = canvas.parentElement.clientHeight;
}

function logMsg(msg, cssClass = 'msg-sys') {
    const el = document.createElement('div');
    el.className = cssClass;
    el.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
    chatConsole.appendChild(el);
    chatConsole.scrollTop = chatConsole.scrollHeight;
}

function spawnResourceCluster() {
    for (let i = 0; i < 10; i++) {
        resources.push({ x: (Math.random() - 0.5) * 500, y: (Math.random() - 0.5) * 450, amount: 3, type: 'crystal' });
    }
    logMsg("Neue Bio-Kristall-Vorkommen gesäat.");
}

function buildGuardianTurret() {
    let mainBase = bases.find(b => b.faction === 'guardian' && b.type === 'main');
    if (mainBase && mainBase.energy >= 60) {
        mainBase.energy -= 60;
        turrets.push(new Turret('guardian', mainBase.x + (Math.random()-0.5)*120, mainBase.y + (Math.random()-0.5)*120));
        logMsg("Guardian-Verteidigungsturm erfolgreich errichtet!");
    } else {
        logMsg("Nicht genügend Energie für Turmbau (60 E erforderlich).");
    }
}

function buildGuardianOutpost() {
    let mainBase = bases.find(b => b.faction === 'guardian' && b.type === 'main');
    if (mainBase && mainBase.energy >= 100) {
        mainBase.energy -= 100;
        bases.push({
            id: `B_G_${bases.length+1}`,
            faction: 'guardian',
            type: 'outpost',
            x: mainBase.x + (Math.random()-0.5)*300,
            y: mainBase.y + (Math.random()-0.5)*300,
            radius: 28,
            territoryRadius: 140,
            energy: 0,
            maxEnergy: 300
        });
        logMsg("Neuer Bergbau-Außenposten der Guardians etabliert!");
    } else {
        logMsg("Nicht genügend Energie für Außenposten (100 E erforderlich).");
    }
}

// --- INTERAKTION (ZOOM, PAN, RECHTSKLICK) ---
function setupInteractions() {
    canvas.addEventListener('mousedown', (e) => {
        if (e.button === 0) {
            isDragging = true;
            startX = e.clientX - offsetX;
            startY = e.clientY - offsetY;
        }
    });

    canvas.addEventListener('mousemove', (e) => {
        if (isDragging) {
            offsetX = e.clientX - startX;
            offsetY = e.clientY - startY;
        }
    });

    canvas.addEventListener('mouseup', () => isDragging = false);

    canvas.addEventListener('wheel', (e) => {
        e.preventDefault();
        const zoomFactor = e.deltaY < 0 ? 1.1 : 0.9;
        const mouseX = e.clientX - canvas.offsetLeft;
        const mouseY = e.clientY - canvas.offsetTop;

        offsetX = mouseX - (mouseX - offsetX) * zoomFactor;
        offsetY = mouseY - (mouseY - offsetY) * zoomFactor;
        scale *= zoomFactor;
    });

    canvas.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        const mouseX = e.clientX - canvas.offsetLeft;
        const mouseY = e.clientY - canvas.offsetTop;
        const worldX = (mouseX - offsetX) / scale;
        const worldY = (mouseY - offsetY) / scale;

        resources.push({ x: worldX, y: worldY, amount: 4, type: 'crystal' });
        logMsg(`Manuelles Kristallfeld bei (${Math.round(worldX)}, ${Math.round(worldY)}) gesetzt.`);
    });
}

function updateAxisMapping() {
    axisX = document.getElementById('selectX').value;
    axisY = document.getElementById('selectY').value;
}

function getMappedCoords(obj) {
    let rawX = obj[axisX] !== undefined ? obj[axisX] : obj.x;
    let rawY = obj[axisY] !== undefined ? obj[axisY] : obj.y;

    if (axisX === 'health') rawX = (rawX - 50) * 5;
    if (axisY === 'health') rawY = (rawY - 50) * 5;
    if (axisX === 'cargo') rawX = (rawX - 2.5) * 80;
    if (axisY === 'cargo') rawY = (rawY - 2.5) * 80;

    return { x: rawX, y: -rawY };
}

// --- MAIN GAME LOOP ---
function gameLoop() {
    // 1. Automatische Einheiten-Produktion bei voller Basen-Energie
    bases.forEach(b => {
        if (b.energy >= 50 && units.filter(u => u.faction === b.faction).length < 25) {
            b.energy -= 50;
            units.push(new SimUnit(b.faction, b.x, b.y));
            logMsg(`[PRODUKTION] Neue Einheit an ${b.id} rekrutiert.`);
        }
    });

    // 2. Einheiten & Türme verarbeiten
    units.forEach(u => u.update());
    turrets.forEach(t => t.update());

    // Tote Einheiten in Schrott umwandeln (Recycling)
    units = units.filter(u => {
        if (u.health <= 0) {
            resources.push({ x: u.x, y: u.y, amount: 2, type: 'scrap' });
            return false;
        }
        return true;
    });

    // Swarm KI-Logik (Autonomer Turmbau bei Überschuss)
    let swarmMain = bases.find(b => b.faction === 'swarm' && b.type === 'main');
    if (swarmMain && swarmMain.energy >= 120 && turrets.filter(t => t.faction === 'swarm').length < 3) {
        swarmMain.energy -= 60;
        turrets.push(new Turret('swarm', swarmMain.x + (Math.random()-0.5)*120, swarmMain.y + (Math.random()-0.5)*120));
        logMsg("[SWARM KI] Verteidigungsturm errichtet!");
    }

    // UI Stats Update
    let gMain = bases.find(b => b.faction === 'guardian' && b.type === 'main');
    let sMain = bases.find(b => b.faction === 'swarm' && b.type === 'main');
    document.getElementById('gEnergy').textContent = Math.round(gMain ? gMain.energy : 0);
    document.getElementById('sEnergy').textContent = Math.round(sMain ? sMain.energy : 0);
    document.getElementById('gUnits').textContent = units.filter(u => u.faction === 'guardian').length;
    document.getElementById('sUnits').textContent = units.filter(u => u.faction === 'swarm').length;
    document.getElementById('gBases').textContent = `${bases.filter(b => b.faction === 'guardian').length} / ${turrets.filter(t => t.faction === 'guardian').length}`;
    document.getElementById('sBases').textContent = `${bases.filter(b => b.faction === 'swarm').length} / ${turrets.filter(t => t.faction === 'swarm').length}`;

    // 3. Render Canvas
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.setTransform(scale, 0, 0, scale, offsetX, offsetY);

    drawGrid();

    // Territorien & Basen zeichnen
    bases.forEach(b => {
        if (axisX === 'x' && axisY === 'y') {
            // Territoriums-Kreis
            ctx.beginPath();
            ctx.arc(b.x, b.y, b.territoryRadius, 0, Math.PI * 2);
            ctx.fillStyle = b.faction === 'guardian' ? "rgba(0, 243, 255, 0.03)" : "rgba(255, 0, 85, 0.03)";
            ctx.fill();
            ctx.strokeStyle = b.faction === 'guardian' ? "rgba(0, 243, 255, 0.2)" : "rgba(255, 0, 85, 0.2)";
            ctx.setLineDash([4, 4]);
            ctx.stroke();
            ctx.setLineDash([]);

            // Basis
            ctx.beginPath();
            ctx.arc(b.x, b.y, b.radius, 0, Math.PI * 2);
            ctx.fillStyle = b.faction === 'guardian' ? "rgba(0, 243, 255, 0.15)" : "rgba(255, 0, 85, 0.15)";
            ctx.fill();
            ctx.strokeStyle = b.faction === 'guardian' ? "#00f3ff" : "#ff0055";
            ctx.lineWidth = 2 / scale;
            ctx.stroke();

            ctx.fillStyle = '#ffffff';
            ctx.font = `${10 / scale}px Courier New`;
            ctx.fillText(`${b.type === 'main' ? 'Hauptbasis' : 'Außenposten'} (${Math.round(b.energy)}E)`, b.x - 35, b.y + b.radius + 12);
        }
    });

    // Verteidigungstürme zeichnen
    turrets.forEach(t => {
        const pos = getMappedCoords(t);
        ctx.beginPath();
        ctx.arc(pos.x, pos.y, 10, 0, Math.PI * 2);
        ctx.fillStyle = t.faction === 'guardian' ? '#00f3ff' : '#ff0055';
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.stroke();
    });

    // Ressourcen (Kristalle & Schrott)
    resources.forEach(r => {
        const pos = getMappedCoords(r);
        ctx.beginPath();
        ctx.arc(pos.x, pos.y, r.type === 'scrap' ? 5 : 4, 0, Math.PI * 2);
        ctx.fillStyle = r.type === 'scrap' ? '#aaa' : '#ffaa00';
        ctx.fill();
    });

    // Einheiten zeichnen
    units.forEach(u => {
        const pos = getMappedCoords(u);

        ctx.beginPath();
        ctx.arc(pos.x, pos.y, u.faction === 'guardian' ? 7 : 6, 0, Math.PI * 2);
        ctx.fillStyle = u.faction === 'guardian' ? '#00f3ff' : '#ff0055';
        ctx.fill();

        // HP-Balken über der Einheit
        ctx.fillStyle = '#ff0000';
        ctx.fillRect(pos.x - 10, pos.y - 12, 20, 2 / scale);
        ctx.fillStyle = '#00ffaa';
        ctx.fillRect(pos.x - 10, pos.y - 12, (u.health / u.maxHealth) * 20, 2 / scale);

        // Fracht-Highlight
        if (u.cargo > 0) {
            ctx.strokeStyle = '#ffaa00';
            ctx.lineWidth = 1.5 / scale;
            ctx.stroke();
        }
    });

    // Lasereffekte zeichnen
    laserEffects.forEach(l => {
        ctx.beginPath();
        ctx.moveTo(l.x1, l.y1);
        ctx.lineTo(l.x2, l.y2);
        ctx.strokeStyle = l.color;
        ctx.lineWidth = 1.5 / scale;
        ctx.stroke();
        l.life -= 1;
    });
    laserEffects = laserEffects.filter(l => l.life > 0);

    requestAnimationFrame(gameLoop);
}

function drawGrid() {
    const gridSize = 100;
    ctx.strokeStyle = "rgba(0, 243, 255, 0.03)";
    ctx.lineWidth = 1 / scale;

    const startXGrid = -offsetX / scale - 1000;
    const endXGrid = startXGrid + (canvas.width / scale) + 2000;
    const startYGrid = -offsetY / scale - 1000;
    const endYGrid = startYGrid + (canvas.height / scale) + 2000;

    for (let x = startXGrid - (startXGrid % gridSize); x < endXGrid; x += gridSize) {
        ctx.beginPath();
        ctx.moveTo(x, startYGrid);
        ctx.lineTo(x, endYGrid);
        ctx.stroke();
    }
    for (let y = startYGrid - (startYGrid % gridSize); y < endYGrid; y += gridSize) {
        ctx.beginPath();
        ctx.moveTo(startXGrid, y);
        ctx.lineTo(endXGrid, y);
        ctx.stroke();
    }
}

window.onload = init;
</script>
</body>
</html>
