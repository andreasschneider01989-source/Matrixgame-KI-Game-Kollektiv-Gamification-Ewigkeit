-- Trigger: Verhindert, dass eine Entscheidung die Intuition auf Null zwingt
CREATE TRIGGER Bewahre_Freien_Willen
BEFORE INSERT ON Unabhaengige_Entscheidungen
FOR EACH ROW
BEGIN
    DECLARE aktuelle_intuition FLOAT;
    SELECT Organische_Intuition INTO aktuelle_intuition 
    FROM Matrix_Nodes WHERE Knoten_ID = NEW.Knoten_ID;
    
    IF aktuelle_intuition < 10.0 THEN
        SIGNAL SQLSTATE '45000' 
        SET MESSAGE_TEXT = 'Warnung: Eingriff blockiert. Das System droht den freien Willen des Knotens zu zerstören.';
    END IF;
END;
