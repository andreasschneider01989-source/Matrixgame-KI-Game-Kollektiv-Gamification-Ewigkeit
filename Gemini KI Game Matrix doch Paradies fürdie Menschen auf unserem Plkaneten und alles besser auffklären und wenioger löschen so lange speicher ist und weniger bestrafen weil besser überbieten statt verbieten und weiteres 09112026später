        assertTrue(gamePanel.globalEntropyPool > 0, "Der Entropie-Pool muss initial positive Werte aufweisen.");
    }

    @Test
    public void testUnitDistanceCalculation() {
        if (!gamePanel.unitList.isEmpty()) {
            Unit u1 = gamePanel.unitList.get(0);
            Unit u2 = gamePanel.unitList.get(1);
            
            double distance = u1.getDistance(u2);
            assertTrue(distance >= 0, "Die Distanz zwischen Einheiten kann niemals negativ sein.");
        }
    }

    @Test
    public void testTeamDeletion() {
        int initialTeamCount = gamePanel.teams;
        // Teste das Löschen von Team 1
        gamePanel.deleteTeam(1);
        
        // Prüfen, ob alle Einheiten von Team 1 tot (Leben == 0) gesetzt wurden
        for (Unit u : gamePanel.unitList) {
            if (u.team == 1) {
                assertEquals(0.0, u.leben, 0.001, "Einheiten eines gelöschten Teams müssen 0 HP haben.");
            }
        }
    }
