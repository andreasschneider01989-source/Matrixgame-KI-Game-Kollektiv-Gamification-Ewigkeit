package matrixgame.simulation;

import matrixgame.earthintelligence.EarthDataConnector;
import matrixgame.earthintelligence.ClimateDataset;
import matrixgame.earthintelligence.Observation;
import matrixgame.earthintelligence.EnergyObservation;

import java.time.LocalDate;

/**
 * HabitatEnergyBalance - Berechnet die Energiebilanz eines Habitats
 * basierend auf den dynamisch gelieferten Klimadaten des EarthDataConnectors.
 */
public class HabitatEnergyBalance {
    private final double solarPanelAreaSqm;
    private final double panelEfficiency;
    private final double dailyDemandKwh;
    private final double batteryStorageCapacityKwh;

    public HabitatEnergyBalance(double solarPanelAreaSqm, double panelEfficiency, 
                                 double dailyDemandKwh, double batteryStorageCapacityKwh) {
        this.solarPanelAreaSqm = solarPanelAreaSqm;
        this.panelEfficiency = panelEfficiency;
        this.dailyDemandKwh = dailyDemandKwh;
        this.batteryStorageCapacityKwh = batteryStorageCapacityKwh;
    }

    /**
     * Simuliert die Energiebilanz für eine Region an einem spezifischen Datum.
     */
    public SimulationResult simulateDay(EarthDataConnector connector, String region, LocalDate date) {
        // Daten über den EarthDataConnector abrufen
        ClimateDataset dataset = connector.fetchClimateData(region, date);
        
        double dailySolarRadiation = 3.0; // Fallback-Wert
        for (Observation obs : dataset.getObservations()) {
            if (obs instanceof EnergyObservation) {
                dailySolarRadiation = obs.getValue().doubleValue(); // kWh/m²
                break;
            }
        }

        // Berechnung des Solarertrags: Strahlung * Fläche * Wirkungsgrad
        double generatedKwh = dailySolarRadiation * solarPanelAreaSqm * panelEfficiency;
        double netBalance = generatedKwh - dailyDemandKwh;

        return new SimulationResult(date, region, generatedKwh, dailyDemandKwh, netBalance);
    }

    public static class SimulationResult {
        public final LocalDate date;
        public final String region;
        public final double generatedKwh;
        public final double demandKwh;
        public final double netBalance;

        public SimulationResult(LocalDate date, String region, double generatedKwh, double demandKwh, double netBalance) {
            this.date = date;
            this.region = region;
            this.generatedKwh = generatedKwh;
            this.demandKwh = demandKwh;
            this.netBalance = netBalance;
        }

        @Override
        public String toString() {
            return String.format("SimulationResult[%s | Region: %s | Ertrag: %.2f kWh | Bedarf: %.2f kWh | Netto: %.2f kWh]",
                    date, region, generatedKwh, demandKwh, netBalance);
        }
    }
}
