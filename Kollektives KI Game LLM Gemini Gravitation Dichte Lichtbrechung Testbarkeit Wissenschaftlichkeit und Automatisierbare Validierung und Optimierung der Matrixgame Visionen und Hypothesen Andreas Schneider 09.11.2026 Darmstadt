package matrixgame.lumini;

import java.math.BigDecimal;
import java.math.MathContext;

/**
 * NewLuminiNumber - Lumini Engine (Blöcke 38 bis 54)
 * Gewährleistet, dass 0 != 00 erhalten bleibt und implementiert 
 * exakte Potenz- und n-te Wurzel-Logik als deterministische Tupel.
 */
public class NewLuminiNumber {
    private final String rawValue; // Erhält führende Nullen (z.B. "00", "01", "-128")
    private final int base;

    public NewLuminiNumber(String rawValue, int base) {
        this.rawValue = rawValue;
        this.base = base;
    }

    /**
     * Konvertiert den Lumini-String in einen numerischen BigDecimal-Wert zur Berechnung.
     */
    public BigDecimal toDecimal() {
        if (rawValue.startsWith("-")) {
            return new BigDecimal(Integer.parseInt(rawValue, base));
        }
        return new BigDecimal(Long.parseLong(rawValue, base));
    }

    /**
     * Blöcke 38–45: Exponentiation (Potenzen) mit Erhalt der String-Integrität.
     */
    public NewLuminiNumber power(int exponent) {
        BigDecimal decimalVal = toDecimal();
        BigDecimal resultVal = decimalVal.pow(exponent);
        String newRaw = resultVal.toBigInteger().toString(base);
        return new NewLuminiNumber(newRaw, base);
    }

    /**
     * Blöcke 46–54: Exakte n-te Wurzel-Logik via Newton-Raphson-Verfahren.
     * Liefert ein stabiles Tupel aus Basis und Wurzelwert.
     */
    public String exactRootString(int n) {
        BigDecimal val = toDecimal();
        if (val.compareTo(BigDecimal.ZERO) < 0 && n % 2 == 0) {
            throw new ArithmeticException("Gerade Wurzel aus negativer Zahl im reellen Raum nicht definiert.");
        }
        BigDecimal rootVal = nthRoot(val.abs(), n, MathContext.DECIMAL128);
        String sign = (val.compareTo(BigDecimal.ZERO) < 0) ? "-" : "";
        return "LuminiRootTuple[base=" + base + ", root=" + sign + rootVal.toPlainString() + ", degree=" + n + "]";
    }

    private static BigDecimal nthRoot(BigDecimal A, int n, MathContext mc) {
        if (A.compareTo(BigDecimal.ZERO) == 0) return BigDecimal.ZERO;
        BigDecimal xK = A.divide(BigDecimal.valueOf(2), mc);
        BigDecimal nBD = BigDecimal.valueOf(n);
        BigDecimal nMinus1 = BigDecimal.valueOf(n - 1);

        for (int i = 0; i < 100; i++) {
            // Newton-Raphson Iteration: x_{k+1} = (1/n) * ((n-1)*x_k + A / x_k^{n-1})
            BigDecimal xK_pow_n_minus_1 = xK.pow(n - 1, mc);
            if (xK_pow_n_minus_1.compareTo(BigDecimal.ZERO) == 0) break;
            BigDecimal term2 = A.divide(xK_pow_n_minus_1, mc);
            BigDecimal numerator = nMinus1.multiply(xK, mc).add(term2, mc);
            xK = numerator.divide(nBD, mc);
        }
        return xK;
    }

    public String getRawValue() {
        return rawValue;
    }

    @Override
    public String toString() {
        return "NewLuminiNumber[val=" + rawValue + ", base=" + base + "]";
    }
}
