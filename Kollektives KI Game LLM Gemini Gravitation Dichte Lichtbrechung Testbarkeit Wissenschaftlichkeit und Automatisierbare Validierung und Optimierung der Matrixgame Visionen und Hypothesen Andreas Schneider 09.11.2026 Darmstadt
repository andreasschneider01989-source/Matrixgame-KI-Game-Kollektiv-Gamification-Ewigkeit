package matrixgame.lumini;

import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

/**
 * Validierungs-Suite für NewLuminiNumber (Blöcke 38–54).
 * Prüft Bit-Integrität, Führende Nullen, Potenzen und Newton-Raphson-Wurzeln.
 */
public class NewLuminiNumberTest {

    @Test
    public void testLeadingZerosPreservation() {
        // Block 38: Überprüfung, dass 0 != 00 als Rohwert erhalten bleibt
        NewLuminiNumber zeroSingle = new NewLuminiNumber("0", 10);
        NewLuminiNumber zeroDouble = new NewLuminiNumber("00", 10);
        
        assertEquals("0", zeroSingle.getRawValue(), "Einzelne Null muss erhalten bleiben.");
        assertEquals("00", zeroDouble.getRawValue(), "Doppelte Null darf nicht getruncated werden.");
        assertNotEquals(zeroSingle.getRawValue(), zeroDouble.getRawValue(), "0 und 00 müssen in Lumini verschieden sein.");
    }

    @Test
    public void testPowerOperations() {
        // Blöcke 39–45: Exponentiation
        NewLuminiNumber baseNum = new NewLuminiNumber("2", 10);
        NewLuminiNumber squared = baseNum.power(3); // 2^3 = 8
        
        assertEquals("8", squared.getRawValue(), "2 hoch 3 muss deterministisch 8 ergeben.");
    }

    @Test
    public void testNegativePowerAndBase() {
        // Test mit negativen Werten wie -128
        NewLuminiNumber negNum = new NewLuminiNumber("-128", 10);
        assertEquals("-128", negNum.getRawValue());
        assertEquals(-128, negNum.toDecimal().intValue());
    }

    @Test
    public void testExactRootExtraction() {
        // Blöcke 46–54: n-te Wurzel via Newton-Raphson
        NewLuminiNumber squareVal = new NewLuminiNumber("16", 10);
        String rootTuple = squareVal.exactRootString(2); // Quadratwurzel aus 16 = 4
        
        assertTrue(rootTuple.contains("root=4"), "Quadratwurzel von 16 muss 4 liefern.");
        assertTrue(rootTuple.contains("degree=2"), "Grad der Wurzel muss 2 sein.");
    }

    @Test
    public void testEvenRootOfNegativeNumberThrowsException() {
        // Sicherheitsprüfung: Gerade Wurzel aus negativer Zahl
        NewLuminiNumber negVal = new NewLuminiNumber("-16", 10);
        
        assertThrows(ArithmeticException.class, () -> {
            negVal.exactRootString(2);
        }, "Gerade Wurzel aus negativer Zahl muss eine ArithmeticException werfen.");
