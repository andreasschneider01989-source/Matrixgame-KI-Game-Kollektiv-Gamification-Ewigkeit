package matrixgame.simulation;

import matrixgame.earthintelligence.PlanetaryRedoxSimulation;

/**
 * PhiScore - Erweiterte Version mit planetaren Redox- und Sauerstoff-Parametern.
 * Formel: Phi = (I * C * V * G * J * Factor_Redox * Factor_Tech) / (1 + rho)
 */
public class PhiScore {
    private final double information;   // I
    private final double connectivity;  // C
    private final double understanding; // V
    private final double goodwill;      // G
    private final double joy;           // J
    private final double resistance;    // rho
    private final PlanetaryRedoxSimulation.RedoxState redoxState;

    public PhiScore(double information, double connectivity, double understanding, 
                    double goodwill, double joy, double resistance, 
                    PlanetaryRedoxSimulation.RedoxState redoxState) {
        this.information = information;
        this.connectivity = connectivity;
        this.understanding = understanding;
        this.goodwill = goodwill;
        this.joy = joy;
        this.resistance = Math.max(0.0, resistance);
        this.redoxState = redoxState;
    }

    /**
     * Berechnet den erweiterten Phi-Wert unter Berücksichtigung planetarer Bedingungen.
     */
    public double calculate() {
        double numerator = information * connectivity * understanding * goodwill * joy;
        
        // Planetare Faktoren als Multiplikatoren (Goldilocks-Bonus)
        double redoxBonus = redoxState.isPhosphorusAvailable() ? 1.2 : 0.8;
        double techBonus = redoxState.isTechCorridorActive() ? 1.25 : 0.9;
        
        numerator *= (redoxBonus * techBonus);
        double denominator = 1.0 + resistance;
        
        return numerator / denominator;
    }

    @Override
    public String toString() {
        return String.format(
            "PhiScore[Phi=%.4f | I=%.1f, C=%.1f, V=%.1f, G=%.1f, J=%.1f, rho=%.2f | CoreFugacity=%.2f, AtmO2=%.1f%%]", 
            calculate(), information, connectivity, understanding, goodwill, joy, resistance,
            redoxState.getOxygenFugacityCore(), redoxState.getAtmosphericO2()
        );
    }
}
