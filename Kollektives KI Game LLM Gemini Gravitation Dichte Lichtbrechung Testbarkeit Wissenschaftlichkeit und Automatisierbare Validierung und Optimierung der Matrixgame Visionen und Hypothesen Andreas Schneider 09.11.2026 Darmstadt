package matrixgame.simulation;

import java.util.List;
import java.util.ArrayList;

/**
 * GenesisAgentCouncil - Erweitert um den ETHICS-Agenten zur Bewertung
 * von sozialer Gerechtigkeit, Fairness und langfristiger Nachhaltigkeit.
 */
public class GenesisAgentCouncil {

    public interface Agent {
        String getName();
        String evaluate(HabitatEnergyBalance.SimulationResult result);
    }

    public static class PhysicsAgent implements Agent {
        @Override
        public String getName() { return "PHYSICS"; }

        @Override
        public String evaluate(HabitatEnergyBalance.SimulationResult result) {
            if (result.netBalance >= 0) {
                return "[PHYSICS] Energiebilanz: POSITIV. Ertrag (" + result.generatedKwh + 
                       " kWh) deckt den Bedarf (" + result.demandKwh + " kWh). Thermodynamisches Gleichgewicht gewahrt.";
            } else {
                return "[PHYSICS] Energiebilanz: KRITISCH. Defizit von " + Math.abs(result.netBalance) + 
                       " kWh. Entropiezunahme im Speichersystem ohne externe Energiezufuhr unvermeidlich.";
            }
        }
    }

    public static class EcologyAgent implements Agent {
        @Override
        public String getName() { return "ECOLOGY"; }

        @Override
        public String evaluate(HabitatEnergyBalance.SimulationResult result) {
            double estimatedCO2Saved = result.generatedKwh * 0.4;
            return "[ECOLOGY] Biosphären-Impact: Nachhaltigkeitsfaktor stabil. Ca. " + 
                   String.format("%.2f", estimatedCO2Saved) + " kg CO2-Äquivalente durch lokale Solarnutzung kompensiert.";
        }
    }

    public static class EthicsAgent implements Agent {
        @Override
        public String getName() { return "ETHICS"; }

        @Override
        public String evaluate(HabitatEnergyBalance.SimulationResult result) {
            if (result.netBalance >= 0) {
                return "[ETHICS] Soziale Gerechtigkeit & Nachhaltigkeit: VORBILDLICH. Die autarke Energieversorgung schont " +
                       "gemeinsame Ressourcen und entlastet das Kollektiv vor externen Preisrisiken. Fairer Ausgleich gewahrt.";
            } else {
                return "[ETHICS] Soziale Gerechtigkeit & Nachhaltigkeit: WARNUNG. Ein anhaltendes Energiedefizit erfordert " +
                       "einen solidarischen Lastenausgleich, um Versorgungsengpass-Ungleichheiten im Habitat zu verhindern.";
            }
        }
    }

    private final List<Agent> agents = new ArrayList<>();

    public GenesisAgentCouncil() {
        agents.add(new PhysicsAgent());
        agents.add(new EcologyAgent());
        agents.add(new EthicsAgent());
    }

    /**
     * Lässt alle Agenten die gegebene Energiebilanz unabhängig bewerten.
     */
    public void evaluateAll(HabitatEnergyBalance.SimulationResult result) {
        System.out.println("\n--- KOLLEKTIV-KI-RAT: ERWEITERTE ANALYSE & BEWERTUNG ---");
        for (Agent agent : agents) {
            System.out.println(agent.evaluate(result));
        }
    }
}
