package matrixgame.earthintelligence;

/**
 * PlanetaryRedoxSimulation - Simuliert die Kopplung zwischen Kern-Redoxbedingungen
 * und atmosphärischem Sauerstoff in planetaren Systemen (Gaia / Ares / Pelagia).
 */
public class PlanetaryRedoxSimulation {

    public static class RedoxState {
        private final double oxygenFugacityCore; // OXYGEN_FUGACITY_CORE (Mantel/Kern-Dynamik)
        private final double atmosphericO2;      // ATMOSPHERIC_O2 (in Prozent der Atmosphäre)
        private final boolean phosphorusAvailable;
        private final boolean techCorridorActive;  // Offene Verbrennung / Metallurgie möglich (~18% O2)

        public RedoxState(double oxygenFugacityCore, double atmosphericO2) {
            this.oxygenFugacityCore = oxygenFugacityCore;
            this.atmosphericO2 = atmosphericO2;
            
            // Goldilocks-Bedingung für Kern-Redox: Weder zu reduziert noch zu oxidiert
            this.phosphorusAvailable = (oxygenFugacityCore >= 1.0 && oxygenFugacityCore <= 5.0);
            
            // Technologischer Sauerstoff-Korridor (ca. 18% bis 30% O2)
            this.techCorridorActive = (atmosphericO2 >= 18.0 && atmosphericO2 <= 30.0);
        }

        public double getOxygenFugacityCore() { return oxygenFugacityCore; }
        public double getAtmosphericO2() { return atmosphericO2; }
        public boolean isPhosphorusAvailable() { return phosphorusAvailable; }
        public boolean isTechCorridorActive() { return techCorridorActive; }

        @Override
        public String toString() {
            return String.format(
                "RedoxState[Core Fugacity: %.2f | Atmospheric O2: %.2f%% | P-Verfügbarkeit: %b | Tech-Korridor: %b]",
                oxygenFugacityCore, atmosphericO2, phosphorusAvailable, techCorridorActive
            );
        }
    }

    /**
     * Führt eine Simulationsstufe für einen Planeten durch.
     */
    public RedoxState simulateStep(double coreFugacityInput, double atmosphericO2Input) {
        System.out.println("[REDOX SIMULATION] Analysiere planetare Parameter...");
        return new RedoxState(coreFugacityInput, atmosphericO2Input);
    }

    public static void main(String[] args) {
        PlanetaryRedoxSimulation sim = new PlanetaryRedoxSimulation();
        
        // Simulation für die Erde (im optimalen Goldilocks-Bereich)
        RedoxState earthState = sim.simulateStep(2.5, 21.0);
        System.out.println(earthState);
    }
}
