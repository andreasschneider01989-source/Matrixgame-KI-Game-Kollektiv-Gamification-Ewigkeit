package matrixgame.lumini;

/**
 * NewLuminiLevel8 - Lumini Engine (Blöcke 86–100)
 * Implementiert thermodynamische Entropie-Links und homöostatische ρ-Dämpfung.
 */
public class NewLuminiLevel8 {

    private static final double BOLTZMANN_CONSTANT = 1.380649E-23; // J/K

    /**
     * Blöcke 86–90: Berechnet die Entropieänderung Delta S basierend auf Mikrozuständen Omega.
     */
    public static double calculateEntropyContribution(long microstatesOmega) {
        if (microstatesOmega <= 0) return 0.0;
        return BOLTZMANN_CONSTANT * Math.log(microstatesOmega);
    }

    /**
     * Blöcke 96–100: Berechnet die adaptive Dämpfung des Widerstands rho 
     * basierend auf Energieüberschuss und Joy-Faktor J.
     */
    public static double dampResistance(double currentRho, double netEnergyBalance, double joyFactor) {
        double efficiencyBonus = Math.max(0.0, netEnergyBalance) * 0.05;
        double reduction = efficiencyBonus + (joyFactor * 0.1);
        return Math.max(0.0, currentRho - reduction);
    }
}
