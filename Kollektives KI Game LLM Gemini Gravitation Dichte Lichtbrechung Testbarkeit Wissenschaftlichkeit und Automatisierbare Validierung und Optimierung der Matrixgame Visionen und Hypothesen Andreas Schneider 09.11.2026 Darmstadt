package matrixgame.lumini;

/**
 * NewLuminiLevel7 - Lumini Engine (Blöcke 71–85)
 * Implementiert 3D-Vektor-Abstände, Newton-Gravitationskräfte und Entropie-Links.
 */
public class NewLuminiLevel7 {

    public static double calculateEuclideanDistance3D(double x1, double y1, double z1, 
                                                     double x2, double y2, double z2) {
        double dx = x2 - x1;
        double dy = y2 - y1;
        double dz = z2 - z1;
        // 3D Pythagoras Anwendung
        return Math.sqrt(dx * dx + dy * dy + dz * dz);
    }

    public static double[] calculateGravitationalForceVector(double m1, double m2, 
                                                             double r, double[] unitVector, double G) {
        if (r == 0) throw new ArithmeticException("Division durch Null im Kraftvektor.");
        double magnitude = G * (m1 * m2) / (r * r);
        
        return new double[] {
            -magnitude * unitVector[0],
            -magnitude * unitVector[1],
            -magnitude * unitVector[2]
        };
    }
}
