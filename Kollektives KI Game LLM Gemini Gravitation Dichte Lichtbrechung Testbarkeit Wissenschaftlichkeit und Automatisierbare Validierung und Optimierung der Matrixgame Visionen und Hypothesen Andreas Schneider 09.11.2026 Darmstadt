package matrixgame.lumini;

import java.math.BigDecimal;
import java.math.MathContext;

/**
 * Erwiterung für NewLuminiNumber - Lumini Engine (Blöcke 55 bis 70: Level 6)
 * Beinhaltet Basis-Transformationen mit Null-Erhalt, negative Modulo-Logik,
 * rationale Exponenten und bitweise Vektor-Maskierung.
 */
public class NewLuminiNumberLevel6 extends NewLuminiNumber {

    public NewLuminiNumberLevel6(String rawValue, int base) {
        super(rawValue, base);
    }

    /**
     * Blöcke 55–58: Basis-Transformation mit garantiertem Erhalt führender Nullen.
     */
    public NewLuminiNumber convertBase(int targetBase, int paddingLength) {
        BigDecimal decimalVal = toDecimal();
        String converted = decimalVal.toBigInteger().toString(targetBase);
        
        // Erzwinge Padding, damit führende Nullen (z.B. "00") erhalten bleiben
        while (converted.length() < paddingLength) {
            converted = "0" + converted;
        }
        return new NewLuminiNumber(converted, targetBase);
    }

    /**
     * Blöcke 59–62: Zyklische Modulo-Operation im negativen Zahlenraum.
     * Formel: ((a % m) + m) % m
     */
    public static int safeModulo(int a, int m) {
        if (m == 0) throw new ArithmeticException("Modulo durch Null nicht zulässig.");
        return ((a % m) + m) % m;
    }

    /**
     * Blöcke 63–66: Rationale Exponenten (Brüche als Exponenten: a^(p/q) = q-te Wurzel aus a^p).
     */
    public String rationalPowerRootString(int p, int q) {
        if (q <= 0) throw new ArithmeticException("Wurzelgrad q muss größer als 0 sein.");
        NewLuminiNumber powered = this.power(p);
        return powered.exactRootString(q);
    }

    /**
     * Blöcke 67–70: Bitweise XOR-Maskierung zur Zustandssynchronisation.
     */
    public NewLuminiNumber xorMask(int maskValue) {
        int currentVal = toDecimal().intValue();
        int resultVal = currentVal ^ maskValue;
        // Konvertiere zurück in den String-Ausdruck der Basis
        String newRaw = Integer.toString(resultVal, super.getRawValue().startsWith("-") ? 10 : 10); 
        return new NewLuminiNumber(newRaw, 10);
    }
}
