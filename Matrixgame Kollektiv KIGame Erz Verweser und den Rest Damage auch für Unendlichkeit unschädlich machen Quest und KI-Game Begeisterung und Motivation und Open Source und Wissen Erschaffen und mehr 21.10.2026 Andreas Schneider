    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        g2.setColor(new Color(25, 55, 25));
        g2.drawLine(0, worldToScreenY(0), getWidth(), worldToScreenY(0));
        g2.drawLine(worldToScreenX(0), 0, worldToScreenX(0), getHeight());

        if (bindingEnabled) {
            g2.setStroke(new BasicStroke(1.0f));
            g2.setColor(new Color(180, 180, 255, 80));
            for (Unit u : units) {
                for (Unit other : u.bonds) {
                    if (System.identityHashCode(u) < System.identityHashCode(other)) {
                        int x1 = worldToScreenX(u.get(axisNames[axisX]));
                        int y1 = worldToScreenY(u.get(axisNames[axisY]));
                        int x2 = worldToScreenX(other.get(axisNames[axisX]));
                        int y2 = worldToScreenY(other.get(axisNames[axisY]));
                        g2.drawLine(x1, y1, x2, y2);
                    }
                }
            }
        }

        for (Unit u : units) {
            int sx = worldToScreenX(u.get(axisNames[axisX]));
            int sy = worldToScreenY(u.get(axisNames[axisY]));
            g2.setColor(u.color);
            g2.fillOval(sx - u.radius, sy - u.radius, u.radius * 2, u.radius * 2);

            if (u == selected) {
                g2.setColor(Color.YELLOW);
                g2.setStroke(new BasicStroke(2f));
                g2.drawOval(sx - u.radius - 3, sy - u.radius - 3,
                        (u.radius + 3) * 2, (u.radius + 3) * 2);
            }
        }

        // HUD
        g2.setColor(Color.WHITE);
        g2.setFont(new Font("Monospaced", Font.PLAIN, 13));
        int y = 20;

        g2.drawString(String.format(Locale.US,
                "Mode: %s  Binding: %s  AutoRep: %s  Units: %d  Bonds: %d",
                forceMode, bindingEnabled ? "ON" : "OFF", autoReplication ? "ON" : "OFF",
                units.size(), activeBonds), 14, y); y += 17;

        g2.drawString(String.format(Locale.US,
                "AvgEnergy: %.2f  AvgBonds: %.2f  Isolated: %d  Rep: %d  Death: %d",
                avgEnergy, avgBonds, isolatedCount, replicationCount, deathCount), 14, y); y += 17;

        g2.drawString(String.format(Locale.US,
                "Types  A:%d  U:%d  G:%d  C:%d", countA, countU, countG, countC), 14, y); y += 17;

        g2.drawString(String.format(Locale.US,
                "E_kin: %.1f  E_pot: %.1f  Steps: %d", totalKinetic, totalPotential, stepCount), 14, y); y += 20;

        g2.setColor(Color.LIGHT_GRAY);
        g2.drawString("1/2/3=Mode  B=Binding  T=AutoRep  C=Replicate  H/V=Achsen  R=Reset  Mausrad=Zoom", 14, getHeight() - 14);

        if (selected != null) {
            g2.setColor(Color.CYAN);
            g2.drawString(String.format(Locale.US,
                    "Selected  Type:%s  mass=%.2f  energy=%.2f  bonds=%d",
                    selected.type, selected.mass, selected.energy, selected.bonds.size()), 14, y);
        }
    }

    private int worldToScreenX(double wx) {
        return (int) (getWidth() / 2.0 + (wx - camX) * zoom);
    }

    private int worldToScreenY(double wy) {
        return (int) (getHeight() / 2.0 - (wy - camY) * zoom);
    }

