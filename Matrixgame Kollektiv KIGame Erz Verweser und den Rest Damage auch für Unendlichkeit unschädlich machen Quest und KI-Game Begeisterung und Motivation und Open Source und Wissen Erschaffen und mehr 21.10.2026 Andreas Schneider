private void spawnUnits(int count) {
    Unit.Type[] types = Unit.Type.values();
    for (int i = 0; i < count; i++) {
        Unit u = new Unit();
        u.x = (Math.random() - 0.5) * 12;
        u.y = (Math.random() - 0.5) * 12;
        u.z = (Math.random() - 0.5) * 12;
        u.vx = (Math.random() - 0.5) * 0.2;
        u.vy = (Math.random() - 0.5) * 0.2;
        u.vz = (Math.random() - 0.5) * 0.2;
        u.mass = 0.5 + Math.random() * 2.0;
        u.radius = (int) (2.0 + Math.sqrt(u.mass) * 2.5);
        u.energy = 1.0 + Math.random();
        u.type = types[(int)(Math.random() * types.length)];
        u.color = Unit.colorForType(u.type);
        u.bonds = new ArrayList<>();
        units.add(u);
    }
}

private void removeIsolated() {
    for (int i = units.size() - 1; i >= 0; i--) {
        if (units.get(i).bonds.isEmpty()) {
            units.remove(i);
            deathCount++;
        }
    }
    if (selected != null && selected.bonds.isEmpty()) selected = null;
}

private void boostEnergy(double target) {
    for (Unit u : units) {
        u.energy = Math.min(Unit.MAX_ENERGY, target);
    }
}
