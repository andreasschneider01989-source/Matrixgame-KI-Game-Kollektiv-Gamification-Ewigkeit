    // ===================== KRÄFTE =====================

    private void applyForces() {

        int n = units.size();

        double[] ax = new double[n];

        double[] ay = new double[n];

        double[] az = new double[n];

        double[] ad4 = new double[n];



        if (forceMode == ForceMode.NEWTON || forceMode == ForceMode.MIXED) {

            for (int i = 0; i < n; i++) {

                Unit a = units.get(i);

                for (int j = i + 1; j < n; j++) {

                    Unit b = units.get(j);

                    double dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z, dd4 = b.d4 - a.d4;

                    double r2 = dx*dx + dy*dy + dz*dz + dd4*dd4 + SOFTENING*SOFTENING;

                    double r = Math.sqrt(r2);

                    double f = G * a.mass * b.mass / r2 / r;

                    double fx = f * dx / r, fy = f * dy / r, fz = f * dz / r, fd4 = f * dd4 / r;



                    ax[i] += fx / a.mass; ay[i] += fy / a.mass; az[i] += fz / a.mass ;ad4[i]+= fd4 / a.mass;

                    ax[j] -= fx / b.mass; ay[j] -= fy / b.mass; az[j] -= fz / b.mass; ad4[j] -= fd4 / b.mass;

                }

            }

        }



        if (forceMode == ForceMode.STOCHASTIC || forceMode == ForceMode.MIXED) {

            int attempts = n * 2;

            for (int k = 0; k < attempts; k++) {

                int i = (int) (Math.random() * n);

                int j = (int) (Math.random() * n);

                if (i == j) continue;



                Unit a = units.get(i);

                Unit b = units.get(j);

                double dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z, dd4 = b.d4 -a.d4;

                double dist = Math.sqrt(dx*dx + dy*dy + dz*dz + dd4*dd4) + 1e-6;

                double prob = 0.06 / (1.0 + dist * dist);

                if (Math.random() > prob) continue;



                double strength = 0.0015 * (a.mass + b.mass) / dist;

                double ix = strength * dx / dist;

                double iy = strength * dy / dist;

                double iz = strength * dz / dist;

                double id4 = strength * dd4 / dist;



                a.vx += ix / a.mass; a.vy += iy / a.mass; a.vz += iz / a.mass;  a.vd4 += id4 / a.mass;

                b.vx -= ix / b.mass; b.vy -= iy / b.mass; b.vz -= iz / b.mass;  b.vd4 += id4 / b.mass;

            }

        }



        for (int i = 0; i < n; i++) {

            Unit u = units.get(i);

            u.ax = ax[i];

            u.ay = ay[i];

            u.az = az[i];

            u.ad4 = ad4[i];

        }

    }



    // ===================== BINDUNG (mit Typ-Präferenz) =====================

    private void updateBonds() {

        activeBonds = 0;

        int n = units.size();



        for (Unit u : units) {

            u.bonds.removeIf(other -> {

                double dx = other.x - u.x, dy = other.y - u.y, dz = other.z - u.z;

                double dist = Math.sqrt(dx*dx + dy*dy + dz*dz);

                return dist > BIND_BREAK_DISTANCE;

            });

            activeBonds += u.bonds.size();

        }

        activeBonds /= 2;



        for (int i = 0; i < n; i++) {

            Unit a = units.get(i);

            if (a.energy < Unit.MIN_ENERGY_FOR_BOND) continue;



            for (int j = i + 1; j < n; j++) {

                Unit b = units.get(j);

                if (b.energy < Unit.MIN_ENERGY_FOR_BOND) continue;

                if (a.bonds.contains(b)) continue;



                double dx = b.x - a.x, dy = b.y - a.y, dz = b.z - a.z, dd4 = b.d4 - a.d4;

                double dist = Math.sqrt(dx*dx + dy*dy + dz*dz + dd4*dd4);



                double baseChance = 0.012;

                if (a.isComplementaryTo(b)) {

                    baseChance *= 3.5;   // komplementäre Paare stark bevorzugt

                } else {

                    baseChance *= 0.35;  // andere Paare deutlich seltener

                }



                if (dist < BIND_DISTANCE && Math.random() < baseChance) {

                    a.energy -= BOND_COST;

                    b.energy -= BOND_COST;

                    if (a.energy < 0) a.energy = 0;

                    if (b.energy < 0) b.energy = 0;



                    a.bonds.add(b);

                    b.bonds.add(a);

                }

            }

        }

    }



    private void applyBondForces() {

        for (Unit u : units) {

            for (Unit other : u.bonds) {

                double dx = other.x - u.x, dy = other.y - u.y, dz = other.z - u.z;

                double dist = Math.sqrt(dx*dx + dy*dy + dz*dz) + 1e-6;



                double force = BIND_STRENGTH * (dist - BIND_DISTANCE * 0.7);

                double fx = force * dx / dist;

                double fy = force * dy / dist;

                double fz = force * dz / dist;



                u.ax += fx / u.mass;

                u.ay += fy / u.mass;

                u.az += fz / u.mass;

            }

        }

    }



    // ===================== ENERGIE =====================

    private void regenerateEnergy() {

        for (Unit u : units) {

            u.energy += ENERGY_GAIN_PER_STEP;

            if (u.energy > Unit.MAX_ENERGY) {

                u.energy = Unit.MAX_ENERGY;

            }

        }

    }



    // ===================== REPLIKATION =====================

    private void tryAutoReplication() {

        List<Unit> snapshot = new ArrayList<>(units);

        for (Unit parent : snapshot) {

            if (parent.energy < Unit.MIN_ENERGY_FOR_REPLICATION) continue;

            if (Math.random() > REPLICATION_CHANCE) continue;

            replicate(parent);

        }

    }



    private void replicate(Unit parent) {

        if (parent.energy < REPLICATION_COST) return;



        parent.energy -= REPLICATION_COST;

        replicationCount++;



        Unit child = new Unit();

        child.x = parent.x + (Math.random() - 0.5) * 0.6;

        child.y = parent.y + (Math.random() - 0.5) * 0.6;

        child.z = parent.z + (Math.random() - 0.5) * 0.6;

        child.d4 = parent.d4 + (Math.random() - 0.5) * 0.6;



        child.vx = parent.vx * 0.7 + (Math.random() - 0.5) * 0.15;

        child.vy = parent.vy * 0.7 + (Math.random() - 0.5) * 0.15;

        child.vz = parent.vz * 0.7 + (Math.random() - 0.5) * 0.15;

        child.vd4 = parent.vd4 * 0.7 + (Math.random() - 0.5) * 0.15;



        child.mass = parent.mass * (0.85 + Math.random() * 0.3);

        child.radius = (int) (2.0 + Math.sqrt(child.mass) * 2.6);

        child.energy = 0.4 + Math.random() * 0.5;

        child.bonds = new ArrayList<>();



        // Vererbung + Mutation

        child.type = parent.type;

        if (Math.random() < MUTATION_CHANCE) {

            Unit.Type[] types = Unit.Type.values();

            child.type = types[(int) (Math.random() * types.length)];

        }

        child.color = Unit.colorForType(child.type);



        units.add(child);

    }



