        // drift
        for (Body b : bodies) {
            b.x += b.vx * dt;
            b.y += b.vy * dt;
            b.z += b.vz * dt;
        }
        // new accelerations
        computeAccelerations(bodies);
        // half-kick
        for (Body b : bodies) {
            b.vx += 0.5 * b.ax * dt;
            b.vy += 0.5 * b.ay * dt;
            b.vz += 0.5 * b.az * dt;
        }
    }

