from dataclasses import dataclass, field
from typing import List, Dict, Optional
from enum import Enum

class Status(Enum):
    FACT = "experimentell/mathematisch etabliert"
    MODEL = "nützliches Modell mit Annahmen"
    HYPOTHESIS = "interessante, zu prüfende Idee"

@dataclass
class EternityScale:
    """Ewigkeitsskala: -100 (Auslöschung) bis +100 (gottgleich)"""
    value: float
    
    def __post_init__(self):
        self.value = max(-100.0, min(100.0, self.value))
    
    def hawkins_freq(self) -> float:
        return 20 + (self.value + 100) * 4.9
    
    def label(self) -> str:
        if self.value <= -80: return "Auslöschung"
        if self.value <= -40: return "Schweres Leid"
        if self.value <= -10: return "Unglück"
        if self.value <= 10:  return "Neutral"
        if self.value <= 40:  return "Wohlbefinden"
        if self.value <= 70:  return "Blüte"
        if self.value <= 90:  return "Erleuchtung"
        return "Gottgleich"

@dataclass
class GameObject:
    id: str
    properties: Dict[str, float] = field(default_factory=dict)
    
@dataclass
class GameRule:
    description: str
    formula: str
    status: Status = Status.HYPOTHESIS

@dataclass
class SemanticModel:
    """Das Herzstück: Eine Beschreibung wird zu einem formalen Modell."""
    description: str
    objects: List[GameObject] = field(default_factory=list)
    rules: List[GameRule] = field(default_factory=list)
    eternity_impact: EternityScale = EternityScale(0)
    joy_factor: float = 0.5  # J: Freude (0-1)
    
    def game_formula(self) -> float:
        """Φ_Game = (I * C * V * G * J) / (1 + ρ)"""
        I = 0.5  # Intelligenz (Platzhalter)
        C = 0.5  # Konnektivität
        V = 1.0 if any(r.status == Status.FACT for r in self.rules) else 0.5
        G = (self.eternity_impact.value + 100) / 200  # Normalisiert 0-1
        J = self.joy_factor
        rho = 0.3  # Flusswiderstand
        return (I * C * V * G * J) / (1 + rho)
    
    def validate(self) -> List[str]:
        """Einfache Validierung – der Validator-Kern."""
        issues = []
        if not self.objects:
            issues.append("⚠️ Keine Objekte definiert.")
        if not self.rules:
            issues.append("⚠️ Keine Regeln definiert.")
        if self.joy_factor < 0.1:
            issues.append("💔 Warnung: Sehr niedrige Freude-Metrik. Spiel könnte stagnieren.")
        if not issues:
            issues.append("✅ Modell validiert. Bereit zur Simulation.")
        return issues

