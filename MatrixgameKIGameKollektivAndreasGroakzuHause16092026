public class FriedenIndikatorenQuest {

    public static final String LAYER_SCIENCE = "SCIENCE";
    public static final String LAYER_MODEL = "MODEL";
    public static final String LAYER_GAME = "GAME";
    public static final String LAYER_INTERPRET = "INTERPRET";
    public static final String LAYER_HYPOTHESIS = "HYPOTHESIS";

    /** L3 truth marks from Lumini 1.7 / archive. */
    public enum Mark { W, F, OPEN, SPEC }

    public static class Clause {
        public final String subject, predicate, object, condition;
        public Clause(String s, String p, String o, String c) {
            this.subject = s;
            this.predicate = p;
            this.object = o;
            this.condition = c == null ? "" : c;
        }
        public boolean complete() {
            return nz(subject) && nz(predicate) && nz(object);
        }
        public String k() {
            StringBuilder b = new StringBuilder();
            b.append("AGENT=").append(subject)
             .append(";ACTION=").append(predicate)
             .append(";OBJECT=").append(object);
            if (!condition.isEmpty()) b.append(";B=").append(condition);
            return b.toString();
        }
    }

    public static class Claim {
        public final Clause clause;
        public final Mark mark;
        public final String layer;
        public final double p;
        public Claim(Clause clause, Mark mark, String layer, double p) {
            this.clause = clause;
            this.mark = mark;
            this.layer = layer;
            this.p = p;
        }
        public boolean guardianOk() {
            if (p < 0.0 || p > 1.0) return false;
            if (layer.equals(LAYER_SCIENCE) && p < 0.70) return false;
            if (mark == Mark.W && p < 0.70) return false;
            if (mark == Mark.SPEC && layer.equals(LAYER_SCIENCE)) return false;
            if (mark == Mark.W && layer.equals(LAYER_INTERPRET)) return false;
            return clause.complete();
        }
    }

    /** Observable GAME/MODEL vector. Counts are placeholders, not news. */
    public static class Indicators {
        public int civilianHarmEvents;
        public int armedAttacks;
        public int verifiedAgreements;
        public int aidCorridors;
        public int exchanges;
        public Indicators(int harm, int attacks, int agree, int aid, int exch) {
            this.civilianHarmEvents = harm;
            this.armedAttacks = attacks;
            this.verifiedAgreements = agree;
            this.aidCorridors = aid;
            this.exchanges = exch;
        }
        public double harmLoad() {
            return civilianHarmEvents + 0.5 * armedAttacks;
        }
        public double cooperationLoad() {
            return verifiedAgreements + aidCorridors + exchanges;
        }
        /** GAME score in [0,100]. Not a UN index. */
        public double peaceBar() {
            double h = harmLoad();
            double c = cooperationLoad();
            double raw = 100.0 * (c + 1.0) / (c + 1.0 + h);
            if (raw < 0) return 0;
            if (raw > 100) return 100;
            return raw;
        }
    }

    public enum StateABC { A_ARMED, B_CEASEFIRE, C_STABLE }

    static StateABC classify(Indicators x) {
        if (x.armedAttacks == 0 && x.civilianHarmEvents == 0 && x.verifiedAgreements >= 2) {
            return StateABC.C_STABLE;
        }
        if (x.armedAttacks == 0 && x.civilianHarmEvents == 0) {
            return StateABC.B_CEASEFIRE;
        }
        return StateABC.A_ARMED;
    }

    static boolean overbidBetter(Indicators before, Indicators after) {
        boolean lessHarm = after.harmLoad() < before.harmLoad();
        boolean moreCoop = after.cooperationLoad() >= before.cooperationLoad();
        return lessHarm && moreCoop && after.peaceBar() > before.peaceBar();
