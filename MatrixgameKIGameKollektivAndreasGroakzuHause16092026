/**
 * Sprachlabor L4 - Wahrheitstabellen und gleiche Information
 * in Array, Liste und Baum.
 *
 * SCIENCE: Boolean algebra truth tables are exact for {0,1}.
 * MODEL:   three representations of the same clause list.
 * GAME:    L4 lab after L0 bits, L1 gates, L2 slots, L3 marks.
 * INTERPRET: not used as fact.
 *
 * Archive rule: 63MB stays inventory. Compile only in /tmp.
 */
public class SprachlaborL4Quest {

    public static final String LAYER_SCIENCE = "SCIENCE";
    public static final String LAYER_MODEL = "MODEL";
    public static final String LAYER_GAME = "GAME";

    public enum Mark { W, F, OPEN, SPEC }

    /** One row of a 2-input table. */
    public static class Row {
        public final boolean a;
        public final boolean b;
        public final boolean out;
        public Row(boolean a, boolean b, boolean out) {
            this.a = a;
            this.b = b;
            this.out = out;
        }
    }

    public static boolean and(boolean a, boolean b) { return a && b; }
    public static boolean or(boolean a, boolean b) { return a || b; }
    public static boolean xor(boolean a, boolean b) { return a ^ b; }
    public static boolean not(boolean a) { return !a; }

    public static Row[] tableAnd() {
        return new Row[] {
            new Row(false, false, and(false, false)),
            new Row(false, true,  and(false, true)),
            new Row(true,  false, and(true,  false)),
            new Row(true,  true,  and(true,  true))
        };
    }

    public static Row[] tableOr() {
        return new Row[] {
            new Row(false, false, or(false, false)),
            new Row(false, true,  or(false, true)),
            new Row(true,  false, or(true,  false)),
            new Row(true,  true,  or(true,  true))
        };
    }

    public static Row[] tableXor() {
        return new Row[] {
            new Row(false, false, xor(false, false)),
            new Row(false, true,  xor(false, true)),
            new Row(true,  false, xor(true,  false)),
            new Row(true,  true,  xor(true,  true))
        };
    }

    public static boolean tableExact(Row[] t, Op op) {
        if (t.length != 4) return false;
        boolean[] as = { false, false, true, true };
        boolean[] bs = { false, true, false, true };
        for (int i = 0; i < 4; i++) {
            if (t[i].a != as[i] || t[i].b != bs[i]) return false;
            if (t[i].out != op.apply(as[i], bs[i])) return false;
        }
        return true;
    }

    interface Op { boolean apply(boolean a, boolean b); }

    /** Same four AND rows as array, singly linked list, binary tree. */
    public static class Node {
        public final Row row;
        public Node next;
        public Node left;
        public Node right;
        public Node(Row row) { this.row = row; }
    }

    public static int countList(Node head) {
        int n = 0;
        Node p = head;
        while (p != null) {
            n++;
            p = p.next;
        }
        return n;
    }

    public static int countTree(Node root) {
        if (root == null) return 0;
        return 1 + countTree(root.left) + countTree(root.right);
    }

    public static boolean samePayload(Row[] arr, Node list, Node tree) {
        if (arr.length != 4) return false;
        if (countList(list) != 4) return false;
        if (countTree(tree) != 4) return false;
        Node p = list;
        for (int i = 0; i < 4; i++) {
            if (p.row.out != arr[i].out) return false;
            p = p.next;
        }
        return tree.row.out == arr[0].out;
    }

    public static class Claim {
        public final String text;
        public final Mark mark;
        public final String layer;
        public final double p;
        public Claim(String text, Mark mark, String layer, double p) {
            this.text = text;
            this.mark = mark;
            this.layer = layer;
            this.p = p;
        }
        public boolean guardianOk() {
            if (p < 0.0 || p > 1.0) return false;
            if (layer.equals(LAYER_SCIENCE) && p < 0.70) return false;
            if (mark == Mark.W && p < 0.70) return false;
            if (mark == Mark.SPEC && layer.equals(LAYER_SCIENCE)) return false;
            return text != null && !text.isEmpty();
        }
    }

    public static void main(String[] args) {
        Row[] andT = tableAnd();
        Row[] orT = tableOr();
        Row[] xorT = tableXor();

        boolean tablesOk = tableExact(andT, new Op() {
            public boolean apply(boolean a, boolean b) { return a && b; }
        }) && tableExact(orT, new Op() {
            public boolean apply(boolean a, boolean b) { return a || b; }
        }) && tableExact(xorT, new Op() {
            public boolean apply(boolean a, boolean b) { return a ^ b; }
        });

        boolean notOk = not(false) && !not(true);

        Node n0 = new Node(andT[0]);
        Node n1 = new Node(andT[1]);
        Node n2 = new Node(andT[2]);
        Node n3 = new Node(andT[3]);
        n0.next = n1; n1.next = n2; n2.next = n3;

        Node t0 = new Node(andT[0]);
        t0.left = new Node(andT[1]);
        t0.right = new Node(andT[2]);
        t0.left.left = new Node(andT[3]);

        boolean structOk = samePayload(andT, n0, t0);

        Claim science = new Claim(
            "AND/OR/XOR truth tables are exact on {0,1}",
            Mark.W, LAYER_SCIENCE, 1.0);
        Claim model = new Claim(
            "Array, list and tree can carry the same four rows",
            Mark.W, LAYER_MODEL, 0.97);
        Claim game = new Claim(
            "L4 lab unlocks after L0-L3",
            Mark.OPEN, LAYER_GAME, 0.80);
        boolean guard = science.guardianOk() && model.guardianOk() && game.guardianOk();

        Claim bad = new Claim("hope is a measurement", Mark.SPEC, LAYER_SCIENCE, 0.40);
        boolean reject = !bad.guardianOk();

        boolean green = tablesOk && notOk && structOk && guard && reject;
        System.out.println("QUEST Sprachlabor L4 tables+IR");
        System.out.println("AND 1,1 -> " + and(true, true));
        System.out.println("XOR 1,1 -> " + xor(true, true));
        System.out.println("list=" + countList(n0) + " tree=" + countTree(t0));
        System.out.println(green ? "STATUS GREEN" : "STATUS RED");
        if (!green) System.exit(1);
    }
}


/**
 * ThreeBodyNewtonQuest
 *
 * Classical three-body problem under Newtonian gravity.
 *
 * SCIENCE : F = G m1 m2 / r^2 (inverse-square), Newton's 2nd law a = F/m,
 *           total energy E = T + U (kinetic + gravitational potential).
 *           The general 3-body problem has no closed-form solution in
 *           elementary functions; numerical integration is the practical path.
 * MODEL   : velocity Verlet + r_min softening to avoid singularities;
 *           relative energy drift as quality metric for the discrete scheme
 *           and double-precision arithmetic.
 * GAME    : GREEN if all bodies stay finite and |E - E0| / |E0| stays under
 *           a chosen guard after N ticks.
 * INTERPRET: any claim that this "solves" the analytic 3-body problem or
 *            alters real celestial mechanics is rejected by Guardian.
 *
 * Named doubles, multiplications, divisions, equation forms printed to console.
 * Compile isolated:
 *   cp ThreeBodyNewtonQuest.java /tmp
 *   cd /tmp && javac ThreeBodyNewtonQuest.java && java ThreeBodyNewtonQuest
 *
 * No AWT. No 63 MB remake. Double precision only (no BigDecimal).
 */
public class ThreeBodyNewtonQuest {

    public static final String SCIENCE   = "SCIENCE";
    public static final String MODEL     = "MODEL";
    public static final String GAME      = "GAME";
    public static final String INTERPRET = "INTERPRET";

    // ---------- physical / numerical constants (named doubles) ----------
    public static final double G              = 6.67430e-11;   // CODATA-ish
    public static final double R_MIN          = 1.0e3;         // softening length [m]
    public static final double DT             = 60.0;          // timestep [s]
    public static final int    TICKS          = 500;
    public static final double ENERGY_GUARD   = 1.0e-8;        // relative drift limit
    public static final double EPS            = 1.0e-30;       // avoid /0

    // ---------- body ----------
    static class Body {
        final String id;
        double m;
        double x, y, z;
        double vx, vy, vz;
        double ax, ay, az;

        Body(String id, double m, double x, double y, double z,
             double vx, double vy, double vz) {
            this.id = id;
            this.m = m;
            this.x = x; this.y = y; this.z = z;
            this.vx = vx; this.vy = vy; this.vz = vz;
        }

        double kinetic() {
            return 0.5 * m * (vx * vx + vy * vy + vz * vz);
        }

        boolean isFinite() {
            return Double.isFinite(x) && Double.isFinite(y) && Double.isFinite(z)
                && Double.isFinite(vx) && Double.isFinite(vy) && Double.isFinite(vz)
                && Double.isFinite(m) && m > 0.0;
        }
    }

    // ---------- distance & potential helpers ----------
    static double dist(Body a, Body b) {
        double dx = b.x - a.x;
        double dy = b.y - a.y;
        double dz = b.z - a.z;
        return Math.sqrt(dx * dx + dy * dy + dz * dz);
    }

    /** Softened pairwise potential U = -G m1 m2 / r_soft */
    static double pairPotential(Body a, Body b) {
        double r = Math.max(dist(a, b), R_MIN);
        return -G * a.m * b.m / r;
    }

    static double totalPotential(Body[] bodies) {
        double u = 0.0;
        for (int i = 0; i < bodies.length; i++) {
            for (int j = i + 1; j < bodies.length; j++) {
                u += pairPotential(bodies[i], bodies[j]);
            }
        }
        return u;
    }

    static double totalKinetic(Body[] bodies) {
        double t = 0.0;
        for (Body b : bodies) t += b.kinetic();
        return t;
    }

    static double totalEnergy(Body[] bodies) {
        return totalKinetic(bodies) + totalPotential(bodies);
    }

    // ---------- acceleration from Newtonian gravity ----------
    static void computeAccelerations(Body[] bodies) {
        for (Body b : bodies) {
            b.ax = 0.0; b.ay = 0.0; b.az = 0.0;
        }
        for (int i = 0; i < bodies.length; i++) {
            for (int j = i + 1; j < bodies.length; j++) {
                Body a = bodies[i];
                Body b = bodies[j];
                double dx = b.x - a.x;
                double dy = b.y - a.y;
                double dz = b.z - a.z;
                double r2 = dx * dx + dy * dy + dz * dz;
                double r  = Math.sqrt(r2);
                double rc = Math.max(r, R_MIN);
                // F = G m1 m2 / rc^2 , direction unit vector
                // a_on_a = + (G m_b / rc^3) * r_vec
                // a_on_b = - (G m_a / rc^3) * r_vec
                double invR3 = 1.0 / (rc * rc * rc);
                double factorA = G * b.m * invR3;
                double factorB = G * a.m * invR3;
                a.ax += factorA * dx;
                a.ay += factorA * dy;
                a.az += factorA * dz;
                b.ax -= factorB * dx;
                b.ay -= factorB * dy;
                b.az -= factorB * dz;
            }
        }
    }

    // ---------- velocity Verlet step ----------
    static void verletStep(Body[] bodies, double dt) {
        // half-kick
        for (Body b : bodies) {
            b.vx += 0.5 * b.ax * dt;
            b.vy += 0.5 * b.ay * dt;
            b.vz += 0.5 * b.az * dt;
