        StringBuilder obj = new StringBuilder();
        for (int i = 2; i < parts.length; i++) {
            if (i > 2) obj.append(' ');
            obj.append(parts[i]);
        }
        return new Clause(parts[0], parts[1], obj.toString(), cond);
    }

    static boolean nz(String x) {
        return x != null && !x.trim().isEmpty();
    }

