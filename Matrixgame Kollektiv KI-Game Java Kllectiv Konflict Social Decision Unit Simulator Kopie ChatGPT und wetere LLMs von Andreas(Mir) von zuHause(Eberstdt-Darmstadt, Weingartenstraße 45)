    }

    // 6. Kollektive Berechnung & Ausgabe
    private static void calculateCollectiveState() {
        double tT = 0, tC = 0, tD = 0;
        for (Unit u : units) {
            tT += u.trust;
            tC += u.anger + u.fear;
            tD += (u.stress * 0.4) + (u.fear * 0.3) + (u.anger * 0.3) + (u.traumaLevel * 2);
        }
        collectiveTrust = tT / units.size();
        collectiveConflict = tC / units.size();
        collectiveDamage = tD / units.size();
    }

    private static void printStatus(int round) {
        System.out.printf("Kollektiv | Vertrauen: %5.1f | Konflikt: %5.1f | Damage: %5.1f%n", 
