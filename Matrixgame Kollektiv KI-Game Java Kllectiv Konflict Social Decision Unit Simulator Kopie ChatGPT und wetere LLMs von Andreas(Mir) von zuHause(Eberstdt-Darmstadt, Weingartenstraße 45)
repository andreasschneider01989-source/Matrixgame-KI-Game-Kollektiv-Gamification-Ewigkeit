package ordner1;

import java.util.ArrayList;
import java.util.List;
import java.util.Random;

/**
 * Collective Consciousness Game 1.0
 *
 * Eine erweiterbare Simulation für:
 * - Individuelle Entscheidungsfindung
 * - Emotionen und Erinnerungen
 * - Kommunikation zwischen Units
 * - Konfliktausbreitung
 * - Vertrauen und Kooperation
 * - Symbolische Hawkins-Skala
 * - Kollektive Schadensmessung
 *
 * Alle Werte sind Modellvariablen und keine
 * wissenschaftlich validierten Messungen.
 */
public class CollectiveConsciousnessGame {

    private static final long SEED = 20261003L;
    private static final int UNIT_COUNT = 10;
    private static final int ROUNDS = 30;

    private static final Random random = new Random(SEED);
    private static final List<Unit> units = new ArrayList<>();

    private static double collectiveTrust = 60;
    private static double collectiveConflict = 10;
    private static double collectiveHope = 60;
    private static double collectiveDamage = 0;

    public static void main(String[] args) {

        System.out.println("======================================");
        System.out.println(" COLLECTIVE CONSCIOUSNESS GAME 1.0");
        System.out.println("======================================");
        System.out.println("Seed: " + SEED);
        System.out.println("Units: " + UNIT_COUNT);
        System.out.println();

        initializeUnits();

        for (int round = 1; round <= ROUNDS; round++) {

            System.out.println("\n========== RUNDE " + round + " ==========");

            simulateEvent();
            updateUnits();
            communicate();
            calculateCollectiveState();
            printStatus();
        }

        System.out.println("\n========== SIMULATIONSERGEBNIS ==========");
        printFinalResult();
    }

    // --------------------------------------
    // 1. Individuen erzeugen
    // --------------------------------------

    private static void initializeUnits() {

        for (int i = 0; i < UNIT_COUNT; i++) {

            Unit unit = new Unit(
                    i,
                    random.nextDouble(30, 80),
                    random.nextDouble(10, 50),
                    random.nextDouble(10, 50),
                    random.nextDouble(40, 90),
                    random.nextDouble(0, 70)
            );

            units.add(unit);
        }

        System.out.println("Alle Units wurden initialisiert.");
    }

    // --------------------------------------
    // 2. Ereignisse
    // --------------------------------------

    private static void simulateEvent() {

        int event = random.nextInt(5);

        switch (event) {

            case 0 -> {
                System.out.println("Ereignis: Positive Kommunikation");
                for (Unit u : units) {
                    u.hope += 5;
                    u.stress -= 3;
                }
            }

            case 1 -> {
                System.out.println("Ereignis: Unsicherheit");
                for (Unit u : units) {
                    u.stress += 8;
                    u.fear += 6;
                }
            }

            case 2 -> {
                System.out.println("Ereignis: Bedrohung");
                for (Unit u : units) {
                    u.stress += 15;
                    u.fear += 12;
                    u.anger += 5;
                }
            }

            case 3 -> {
                System.out.println("Ereignis: Überprüfte Information");
                for (Unit u : units) {
                    u.trust += 5;
                    u.stress -= 5;
                }
            }

            case 4 -> {
                System.out.println("Ereignis: Soziale Unterstützung");
                for (Unit u : units) {
                    u.hope += 8;
                    u.trust += 3;
                    u.stress -= 6;
                }
            }
        }

        for (Unit u : units) {
            u.clampValues();
        }
    }

    // --------------------------------------
    // 3. Individuelle Entscheidungen
    // --------------------------------------

    private static void updateUnits() {

        for (Unit u : units) {

            // Erinnerungen beeinflussen die Reaktion.
            double traumaEffect =
                    u.traumaSensitivity * u.memoryTrigger;

            u.fear += traumaEffect * 0.15;
            u.stress += traumaEffect * 0.10;

            // Vereinfachte Entscheidungsfindung:
            // Stress und Angst beeinflussen die
            // Wahrscheinlichkeit einer Konfliktreaktion.

            double conflictPressure =
                    u.stress * 0.35
                    + u.fear * 0.30
                    + u.anger * 0.35
                    - u.trust * 0.20
                    - u.hope * 0.15;

            if (conflictPressure > 35) {

                u.anger += 4;
                u.trust -= 3;
                u.lastDecision = "Konfliktreaktion";

            } else if (u.trust > 60 && u.hope > 50) {

                u.hope += 2;
                u.lastDecision = "Kooperation";

            } else {

                u.lastDecision = "Beobachten";
            }

            // Natürliche Erholung
            u.stress -= 1.5;
            u.anger -= 1;
            u.fear -= 0.8;

            u.clampValues();
        }
    }

    // --------------------------------------
    // 4. Kommunikation im Netzwerk
    // --------------------------------------

    private static void communicate() {

        for (Unit sender : units) {

            // Jede Unit kommuniziert zufällig
            // mit einer anderen Unit.
            Unit receiver = units.get(
                    random.nextInt(units.size())
            );

            if (sender.id == receiver.id) {
                continue;
            }

            double communicationStrength =
                    sender.trust / 100.0;

            // Emotionen können sich durch
            // Kommunikation gegenseitig beeinflussen.

            receiver.stress +=
                    sender.stress * 0.04
                    * (1 - communicationStrength);

            receiver.hope +=
                    sender.hope * 0.025
                    * communicationStrength;

            receiver.anger +=
                    sender.anger * 0.025
                    * (1 - communicationStrength);

            receiver.trust +=
                    communicationStrength * 1.5;

            // Erinnerungs-Trigger werden
            // zunächst als vereinfachter
            // Modellparameter behandelt.
            if (sender.anger > 70 && receiver.traumaSensitivity > 60) {
                receiver.memoryTrigger += 2;
            }

            sender.clampValues();
            receiver.clampValues();
        }
    }

    // --------------------------------------
    // 5. Kollektive Werte berechnen
    // --------------------------------------

    private static void calculateCollectiveState() {

        double totalTrust = 0;
        double totalConflict = 0;
        double totalHope = 0;
        double totalDamage = 0;

        for (Unit u : units) {

            totalTrust += u.trust;
            totalConflict += u.anger + u.fear;
            totalHope += u.hope;

            // Vereinfachter Schadensindikator
            totalDamage +=
                    u.stress * 0.4
                    + u.fear * 0.3
                    + u.anger * 0.3;
        }

        collectiveTrust = totalTrust / units.size();
        collectiveConflict = totalConflict / units.size();
        collectiveHope = totalHope / units.size();
        collectiveDamage = totalDamage / units.size();
    }

    // --------------------------------------
    // 6. Status ausgeben
    // --------------------------------------

    private static void printStatus() {

        System.out.printf(
                "Vertrauen: %.1f | Konflikt: %.1f | "
                + "Hoffnung: %.1f | Damage: %.1f%n",
                collectiveTrust,
                collectiveConflict,
                collectiveHope,
                collectiveDamage
        );

        for (Unit u : units) {
            System.out.printf(
                    "Unit %02d | Stress: %5.1f | "
                    + "Angst: %5.1f | Vertrauen: %5.1f | "
                    + "Hawkins: %6.1f | Entscheidung: %s%n",
                    u.id,
                    u.stress,
                    u.fear,
                    u.trust,
                    u.getHawkinsValue(),
                    u.lastDecision
            );
        }
    }

    // --------------------------------------
    // 7. Endergebnis
    // --------------------------------------

    private static void printFinalResult() {

        System.out.printf("Kollektives Vertrauen: %.2f%n",
                collectiveTrust);

        System.out.printf("Konfliktintensität: %.2f%n",
                collectiveConflict);

        System.out.printf("Kollektive Hoffnung: %.2f%n",
                collectiveHope);

        System.out.printf("Schadensindikator: %.2f%n",
                collectiveDamage);

        System.out.println();
        System.out.println("Simulation abgeschlossen.");
    }

    // ======================================
    // UNIT
    // ======================================

    static class Unit {

        final int id;

        // Emotionale Zustände
        double stress;
        double fear;
        double anger;
        double hope;
        double trust;

        // Individuelle Eigenschaften
        double traumaSensitivity;
        double memoryTrigger;

        // Aktuelle Entscheidung
        String lastDecision = "Keine";

        Unit(
                int id,
                double trust,
                double stress,
                double fear,
                double hope,
                double traumaSensitivity
        ) {
            this.id = id;
            this.trust = trust;
            this.stress = stress;
            this.fear = fear;
            this.hope = hope;
            this.traumaSensitivity = traumaSensitivity;
            this.memoryTrigger = 0;
        }

        // Symbolische Hawkins-Skala:
        // Kein wissenschaftlicher Messwert.
        double getHawkinsValue() {

            return (hope + trust - fear - anger) / 2.0;
        }

        void clampValues() {

            stress = clamp(stress);
            fear = clamp(fear);
            anger = clamp(anger);
            hope = clamp(hope);
            trust = clamp(trust);
            traumaSensitivity = clamp(traumaSensitivity);
            memoryTrigger = clamp(memoryTrigger);
        }

        private double clamp(double value) {
            return Math.max(0, Math.min(100, value));
        }
    }
}

