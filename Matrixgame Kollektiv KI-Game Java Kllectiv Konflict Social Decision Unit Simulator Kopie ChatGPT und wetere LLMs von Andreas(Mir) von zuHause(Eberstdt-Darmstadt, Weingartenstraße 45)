import java.util.ArrayList;
import java.util.List;
import java.util.Random;

/**
 * Collective Consciousness Game 2.0
 * Erweiterungen: Netzwerk-Topologie, Spieler-Intervention, Persistenter Trauma-Level
 */
public class CollectiveConsciousnessGame2 {

    private static final long SEED = 20261003L;
    private static final int UNIT_COUNT = 10;
    private static final int ROUNDS = 15; // Kürzer für Demo-Zwecke, leicht auf 30+ stellbar

    private static final Random random = new Random(SEED);
    private static final List<Unit> units = new ArrayList<>();

    // Kollektive Metriken
    private static double collectiveTrust = 60;
    private static double collectiveConflict = 10;
    private static double collectiveDamage = 0;

    public static void main(String[] args) {
        System.out.println("======================================");
        System.out.println(" COLLECTIVE CONSCIOUSNESS GAME 2.0");
        System.out.println("======================================");
        System.out.println("Seed: " + SEED + " | Units: " + UNIT_COUNT + " | Runden: " + ROUNDS);
        
        initializeUnitsAndNetwork();

        for (int round = 1; round <= ROUNDS; round++) {
            System.out.println("\n========== RUNDE " + round + " ==========");
            
            simulateEvent(round);
            updateUnits();
            communicateInNetwork();
            calculateCollectiveState();
            printStatus(round);
            
            // SPIELER / AGENTEN INTERVENTION (Demo: In Runde 5 und 10)
            if (round == 5 || round == 10) {
                playerIntervention(round);
            }
        }

        System.out.println("\n========== SIMULATIONSERGEBNIS ==========");
        printFinalResult();
    }

    // 1. Initialisierung mit Netzwerk-Nachbarschaft
    private static void initializeUnitsAndNetwork() {
        for (int i = 0; i < UNIT_COUNT; i++) {
            units.add(new Unit(i, random.nextDouble(40, 80), random.nextDouble(10, 40), random.nextDouble(10, 40)));
        }
        // Einfaches Ring-Netzwerk erstellen (jeder ist mit 2 Nachbarn verbunden)
        for (int i = 0; i < UNIT_COUNT; i++) {
            Unit current = units.get(i);
            Unit left = units.get((i - 1 + UNIT_COUNT) % UNIT_COUNT);
            Unit right = units.get((i + 1) % UNIT_COUNT);
            current.neighbors.add(left);
            current.neighbors.add(right);
        }
        System.out.println("✅ Netzwerk-Topologie initialisiert (Ring-Struktur).");
    }

    // 2. Ereignisse
    private static void simulateEvent(int round) {
        int event = random.nextInt(5);
        switch (event) {
            case 0 -> applyGlobalEffect("Positive Kommunikation", 0, -3, -2, 5, 3);
            case 1 -> applyGlobalEffect("Unsicherheit", 0, 8, 6, -2, 0);
            case 2 -> applyGlobalEffect("Bedrohung", 0, 15, 12, -5, 5);
            case 3 -> applyGlobalEffect("Überprüfte Information", 0, -5, -5, 5, 0);
            case 4 -> applyGlobalEffect("Soziale Unterstützung", 0, -6, -4, 8, 3);
        }
    }

    private static void applyGlobalEffect(String name, double traumaChange, double stressChange, double fearChange, double hopeChange, double trustChange) {
        System.out.println("🌍 Ereignis: " + name);
        for (Unit u : units) {
            u.traumaLevel = Math.max(0, u.traumaLevel + traumaChange);
            u.stress = clamp(u.stress + stressChange);
            u.fear = clamp(u.fear + fearChange);
            u.hope = clamp(u.hope + hopeChange);
            u.trust = clamp(u.trust + trustChange);
        }
    }

    // 3. Individuelle Updates mit Trauma-Berücksichtigung
    private static void updateUnits() {
        for (Unit u : units) {
            // Trauma wirkt als Multiplikator auf negative Reaktionen
            double traumaEffect = u.traumaLevel * 0.2;
            u.fear = clamp(u.fear + traumaEffect);
            u.stress = clamp(u.stress + (traumaEffect * 0.5));

            double conflictPressure = (u.stress * 0.4) + (u.fear * 0.4) - (u.trust * 0.3) - (u.hope * 0.2);

            if (conflictPressure > 40) {
                u.lastDecision = "ESKALATION";
                u.anger = clamp(u.anger + 5);
            } else if (u.trust > 50 && u.hope > 40) {
                u.lastDecision = "KOOPERATION";
                u.hope = clamp(u.hope + 1);
            } else {
                u.lastDecision = "BEOBACHTEN";
            }

            // Natürliche Erholung
            u.stress = clamp(u.stress - 1.5);
            u.anger = clamp(u.anger - 1);
        }
    }

    // 4. Kommunikation NUR im lokalen Netzwerk
    private static void communicateInNetwork() {
        for (Unit sender : units) {
            for (Unit receiver : sender.neighbors) {
                double trustFactor = sender.trust / 100.0;
                // Emotionale Ansteckung (nur an Nachbarn!)
                receiver.stress = clamp(receiver.stress + (sender.stress * 0.05 * (1 - trustFactor)));
                receiver.hope = clamp(receiver.hope + (sender.hope * 0.05 * trustFactor));
                receiver.trust = clamp(receiver.trust + (trustFactor * 0.5));
            }
