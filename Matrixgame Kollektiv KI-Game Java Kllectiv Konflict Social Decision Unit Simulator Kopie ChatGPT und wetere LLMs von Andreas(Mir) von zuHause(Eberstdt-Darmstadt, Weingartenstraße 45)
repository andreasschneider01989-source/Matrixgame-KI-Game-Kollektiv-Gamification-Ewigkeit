        for (Unit u : units) {
            System.out.printf("  Unit %02d | Stress: %4.1f | Angst: %4.1f | Trauma: %4.1f | Hawkins: %5.1f | %-10s%n",
                    u.id, u.stress, u.fear, u.traumaLevel, u.getHawkinsValue(), u.lastDecision);
        }
    }

    private static void printFinalResult() {
        System.out.printf("🏆 Endstand -> Vertrauen: %.1f | Konflikt: %.1f | Damage: %.1f%n", 
                collectiveTrust, collectiveConflict, collectiveDamage);
        System.out.println("💡 Lektion: Gezielte Interventionen in Netzwerken verhindern dauerhaften kollektiven Schaden.");
    }

    private static double clamp(double value) {
        return Math.max(0, Math.min(100, value));
    }

    // ==========================================
    // UNIT KLASSE
    // ==========================================
    static class Unit {
        final int id;
        double stress, fear, anger, hope, trust;
        double traumaLevel; // Neu: Persistenter Wert
        String lastDecision = "KEINE";
        List<Unit> neighbors = new ArrayList<>(); // Neu: Netzwerk

        Unit(int id, double trust, double stress, double fear) {
            this.id = id;
            this.trust = trust;
            this.stress = stress;
            this.fear = fear;
            this.hope = 50;
            this.anger = 10;
            this.traumaLevel = 0;
        }

        double getHawkinsValue() {
            // Erweiterte Hawkins-Formel: Trauma zieht stark nach unten
            return (hope + trust - fear - anger - (traumaLevel * 2)) / 2.0;
