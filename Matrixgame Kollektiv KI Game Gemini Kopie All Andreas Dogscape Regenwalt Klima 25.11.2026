Java
public class NachbebenDaempfer {
    public static double berechneHalteimpuls(double spannungVorher, double spannungNachher, double dtMinuten) {
        if (dtMinuten <= 0.0) {
            return 0.0;
        }
        double reduktion = Math.max(0.0, spannungVorher - spannungNachher);
        return (reduktion / dtMinuten) * 10.0;
    }
}
