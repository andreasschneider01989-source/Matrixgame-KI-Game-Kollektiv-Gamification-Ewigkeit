                "Verbindung verschoben. Verborgen. Sicher.", Cond.AXIS_THREATENED, 0, 1.0));
        causalGraph.add(new CausalEdge("E16", "HIDE_AXIS",       "AXIS_SAFE",
                "Neue Achse jenseits des Ozeans", Cond.AXIS_SHIFTED, 0, 1.0));

        // Inanna Descent cycle (from the second part of the transcript)
        causalGraph.add(new CausalEdge("E17", "INANNA_CALL",     "DESCENT",
                "Inanna betritt die sieben Tore", Cond.INANNA_DESCENDED, 0, 1.0));
        causalGraph.add(new CausalEdge("E18", "DESCENT",         "PROXY_DEATH",
                "Gesetz der Unterwelt fordert Ersatz (Dumuzi)", Cond.HERO_DEAD, 0, 1.0));
        causalGraph.add(new CausalEdge("E19", "PROXY_DEATH",     "RESURRECTION",
                "Inanna kehrt zurück – Zyklus erneuert", Cond.SYMBIOSE_HIGH, 55, 1.0));

        // Final tablets
        causalGraph.add(new CausalEdge("E20", "SYMBIOSE",        "ALL_WIN",
                "Gleichgewicht trägt – alle gewinnen", Cond.SYMBIOSE_HIGH, 72, 1.0));
        causalGraph.add(new CausalEdge("E21", "TABLETS",         "ENDUBSAR",
                "Vierzig Tage, vierzehn Tafeln", Cond.TABLETS_DONE, 14, 1.0));
    }

    /* ==================== HELPERS ==================== */
    double rnd(double a, double b) { return a + rng.nextDouble() * (b - a); }

    void log(String s) {
        causalityLog.add(0, "[" + simulationTicks + "] " + s);
        while (causalityLog.size() > 10) causalityLog.remove(causalityLog.size() - 1);
        System.out.println("KAUSAL | " + s);
    }

    Unit spawn(String typ, String role, Faction f, double x, double y, double size, double hp, boolean mortal) {
        Unit u = new Unit();
        u.id = unitList.size();
        u.team = f.ordinal();
        u.typ = typ;
        u.role = role;
        u.faction = f;
        u.posX = x; u.posY = y; u.posZ = 0;
        u.size = size;
        u.leben = hp; u.maxLeben = hp;
        u.isMortal = mortal;
        u.lifespan = mortal ? 650 + rng.nextDouble() * 450 : Double.MAX_VALUE;
        u.red = f.color.getRed();
        u.green = f.color.getGreen();
        u.blue = f.color.getBlue();
        u.rng = new Random(seed + unitList.size() * 7919L);
        u.gift = world.heroGift + (rng.nextDouble() - 0.5) * 0.35;
        u.flaw = world.heroFlaw + (rng.nextDouble() - 0.5) * 0.35;
        unitList.add(u);
        return u;
    }

    long countFaction(Faction f) {
        long n = 0;
        for (Unit u : unitList) if (u.faction == f && u.leben > 0) n++;
        return n;
    }

    Unit firstHero() {
        for (Unit u : unitList) if (u.isHero && u.leben > 0) return u;
        return null;
    }

    Unit firstShadow() {
        for (Unit u : unitList) if (u.role.equals("SHADOW") && u.leben > 0) return u;
        return null;
    }

    Unit findUnit(String name) {
        for (Unit u : unitList) if (u.typ.equals(name) && u.leben > 0) return u;
        return null;
    }

    AxisNode nearestAxis(Unit u) {
        AxisNode best = null;
        double m = Double.MAX_VALUE;
        for (AxisNode a : axisNodes) {
            double d = u.getDistanceTo(a.x, a.y, 0);
            if (d < m) { m = d; best = a; }
        }
        return best;
    }

    double commonGood() {
        return world.symbiose
             + world.wisdom * 0.12
             + world.gold * 0.008
             + world.collectiveLegacy * 0.04
             - world.watcherPressure * 0.18
             - world.tragedies * 2.5;
    }

    /* ==================== ACTIONS ==================== */
    void applyAction(Faction f, String a) {
        double before = commonGood();
        switch (a) {
            case "EXPLOIT_GOLD":
                world.gold += 12;
                world.entropy -= 2.8;
                world.watcherPressure += 0.4;
                break;
            case "TEACH_HUMANS":
                world.wisdom += 8.5;
                world.entropy += 3.5;
                world.gold -= 1.5;
                world.humanPotential += 1.4;
                world.collectiveLegacy += 0.8;
                if (countFaction(Faction.HUMAN) < 12)
                    for (int i = 0; i < 5; i++)
                        spawn("Adamu", "LABORER", Faction.HUMAN, rnd(-220, 220), rnd(-160, 240), 7, 105, true);
                break;
            case "FORTIFY_AXIS":
                for (AxisNode n : axisNodes)
                    if (n.owner == f.ordinal()) n.stability = Math.min(100, n.stability + 5.5);
                world.watcherPressure = Math.max(0, world.watcherPressure - 1.3);
                break;
            case "ASSAULT_AXIS": {
                AxisNode t = nearestAxisOf(f);
                if (t != null) {
                    t.stability -= 8;
                    world.watcherPressure += (f == Faction.WATCHER ? 1.5 : 0.55);
                    if (t.stability <= 0) {
                        t.owner = f.ordinal();
                        t.stability = 28;
                        log("ACHSE | " + t.name + " fällt an " + f.label + ".");
                        world.axisThreatened = true;
                    }
                }
                break;
            }
            case "HIDE_AXIS":
                if (!world.axisShifted) {
                    world.axisShifted = true;
                    axisNodes.add(new AxisNode("Jenseits des Ozeans", -480, -340, Faction.ENKI.ordinal(), 92, true));
                    log("STRATEGIE | Die Verbindung Himmel–Erde wird verschoben. Verborgen. Sicher.");
                    world.symbiose += 6;
                }
                break;
            case "MERCY":
                world.entropy += 5.5;
                world.symbiose += 2.8;
                world.gold -= 2.5;
                break;
            case "PURGE":
                world.entropy -= 7;
                world.symbiose -= 5;
                world.watcherPressure += 0.9;
                for (Unit u : unitList)
                    if (u.faction == Faction.HUMAN && u.leben > 0 && rng.nextDouble() < 0.18)
                        u.leben = 0;
                world.tragedies++;
                break;
            case "REBEL":
                world.entropy -= 4.5;
                world.symbiose -= 1.8;
                for (Unit u : unitList)
                    if (u.faction == Faction.WATCHER) u.decisionAlgorithm = "REBEL";
                break;
            case "TRIGGER_DESCENT":
                Unit inanna = findUnit("Inanna");
                if (inanna != null && !world.inannaDescended) {
                    inanna.questState = "DESCENT";
                    inanna.targetPosY = 380.0; // Unterwelt
                    world.inannaDescended = true;
                    log("INANNA | Die Herrin der großen Erde betritt den Weg der sieben Tore.");
                }
                break;
            case "BUILD_LEGACY":
                world.collectiveLegacy += 3.5;
                world.symbiose += 1.2;
                break;
            case "CLAIM_LEGACY":
                world.collectiveLegacy += 1.5;
                mythosPoints.put(f, mythosPoints.get(f) + 4);
                break;
            default:
                break;
        }
        double delta = commonGood() - before;
        mythosPoints.put(f, mythosPoints.get(f) + Math.max(0.0, delta * 1.2));
        actionLog.add(simulationTicks + "|" + f + "|" + a);
    }

    AxisNode nearestAxisOf(Faction f) {
        AxisNode best = null;
        double m = Double.MAX_VALUE;
        for (AxisNode n : axisNodes)
            if (n.owner != f.ordinal()) {
                double d = Math.hypot(n.x, n.y);
                if (d < m) { m = d; best = n; }
            }
        return best;
    }

    /* ==================== GAME LOOP ==================== */
    void gameLoop() {
        while (running) {
            simulationTicks++;
            step();
            repaint();
            try { Thread.sleep(pauseTime); } catch (InterruptedException e) { return; }
        }
    }

    void step() {
        produce();
        runStrategists();
        moveAndFight();
        ageAndInherit();
        evaluateGraph();
        advanceMonomyth();
        computeFitness();
        if (simulationTicks % 200 == 0) checkpoint();
        if (world.victory) {
            log("VICTORY | Alle gewinnen. Die 14 Tafeln sind geschrieben. Die Geschichte lebt.");
            running = false;
        }
    }

    void produce() {
        for (Unit u : unitList) {
            if (u.leben <= 0) continue;
            if (u.role.equals("MINER")) {
                world.gold += 0.48;
                world.entropy -= 0.14;
            } else if (u.role.equals("LABORER")) {
                world.gold += 0.18;
                world.wisdom += 0.28;
                world.entropy += 0.05;
                world.collectiveLegacy += 0.12;
            } else if (u.role.equals("DEITY")) {
                world.entropy += 0.18;
                if (u.faction == Faction.ENKI) world.wisdom += 0.16;
                if (u.faction == Faction.ENLIL) world.symbiose += 0.04;
            } else if (u.role.equals("GUARDIAN") || u.role.equals("SHADOW")) {
                world.watcherPressure += 0.025;
                world.entropy -= 0.03;
            } else if (u.isHero) {
                world.mythos += 0.09;
                u.insight += 0.25;
                if (u.questState.equals("BUILD_LEGACY"))
                    world.collectiveLegacy += 0.6;
            }
        }
        // Bond synergy (Gilgamesh-Enkidu)
        for (Unit u : unitList) {
            if (u.bondedUnit != null && u.bondedUnit.leben > 0 && u.leben > 0) {
                double dist = u.getDistance(u.bondedUnit);
                if (dist < 55) {
                    u.regenRate = 0.35;
                    u.damageMultiplier = 1.45;
                    u.leben = Math.min(u.maxLeben, u.leben + u.regenRate);
                }
            }
        }
        world.entropy = Math.max(0, Math.min(100, world.entropy));
        world.gold = Math.max(0, world.gold);
        world.wisdom = Math.max(0, world.wisdom);
        world.symbiose = Math.max(0, Math.min(100, world.symbiose));
        world.watcherPressure = Math.max(0, world.watcherPressure);
        world.collectiveLegacy = Math.max(0, world.collectiveLegacy);
    }

    void runStrategists() {
        for (Strategist st : strategists) {
            if (simulationTicks % st.period() != 0) continue;
            String a = st.decide(world);
            if (a != null && !a.isEmpty()) applyAction(st.faction(), a);
        }
    }

    void moveAndFight() {
        for (Unit u : unitList) {
            if (u.leben <= 0) continue;

            // Inanna Descent movement
            if (u.questState.equals("DESCENT")) {
                u.moveTo(u.posX, 420, 0, u.speed * 0.7);
                u.size = Math.max(3, u.size - 0.012); // loss of power at each "gate"
                u.leben -= 0.35;
                if (u.posY > 390 && u.leben > 0) {
                    u.leben = 0;
                    log("UNTERWELT | " + u.typ + " hat das siebte Tor überschritten. Der Blick des Todes.");
                    // Proxy mechanism
                    if (u.bondedUnit != null && u.bondedUnit.leben > 0) {
                        Unit proxy = u.bondedUnit;
                        proxy.leben = 0;
                        log("OPFER | Das Gesetz fordert " + proxy.typ + " als Ersatz. Der Zyklus beginnt.");
                        world.tragedies++;
                        // Resurrection after proxy
                        u.leben = u.maxLeben * 0.85;
                        u.size = 13;
                        u.questState = "NONE";
                        u.posY = 90;
                        world.symbiose += 8;
                        world.collectiveLegacy += 35;
                        log("AUFERSTEHUNG | " + u.typ + " kehrt zurück. Der Zyklus nährt die Welt.");
                        nextStage();
                    }
                }
                continue;
            }

            if (u.role.equals("GUARDIAN") || u.role.equals("SHADOW")) {
                AxisNode t = nearestAxis(u);
                if (t != null && t.owner != u.team) {
                    if (u.getDistanceTo(t.x, t.y, 0) < 9) {
                        t.stability -= 1.8;
                        world.watcherPressure += 0.04;
                    } else u.moveTo(t.x, t.y, 0, u.speed);
                }
            } else if (u.isHero) {
                if (u.questState.equals("GRIEF")) {
                    Unit sh = firstShadow();
                    if (sh != null) {
                        if (u.getDistance(sh) < u.reichweite) u.attackieren(sh);
                        else u.moveTo(sh);
                    } else {
                        u.hubris += 0.08;
                        if (u.hubris > 90) {
                            u.questState = "BUILD_LEGACY";
                            log("HYBRIS → LEGACY | " + u.typ + " akzeptiert die Sterblichkeit. Uruk beginnt.");
                            world.collectiveLegacy += 25;
                        }
                    }
                } else if (u.questState.equals("BUILD_LEGACY")) {
                    // stay near axis and generate legacy
                    AxisNode a = nearestAxis(u);
                    if (a != null && u.getDistanceTo(a.x, a.y, 0) > 40)
                        u.moveTo(a.x, a.y, 0, u.speed * 0.5);
                } else {
                    Unit sh = firstShadow();
                    if (sh != null) {
                        if (u.getDistance(sh) < u.reichweite) u.attackieren(sh);
                        else u.moveTo(sh);
                    } else {
                        if (u.targetPosX == null || u.rng.nextDouble() < 0.01) {
                            u.targetPosX = u.posX + (u.rng.nextDouble() * 55 - 27);
                            u.targetPosY = u.posY + (u.rng.nextDouble() * 55 - 27);
                        }
                        u.moveTo(u.targetPosX, u.targetPosY, 0, u.speed * 0.55);
                        if (u.getDistanceTo(u.targetPosX, u.targetPosY, 0) < 2) u.targetPosX = null;
                    }
                }
            } else if (u.decisionAlgorithm.equals("REBEL")) {
                Unit god = null;
                for (Unit o : unitList)
                    if (o.role.equals("DEITY") && o.leben > 0) { god = o; break; }
                if (god != null) {
                    if (u.getDistance(god) < u.reichweite) u.attackieren(god);
                    else u.moveTo(god);
                }
            } else {
                if (u.targetPosX == null || u.rng.nextDouble() < 0.011) {
                    u.targetPosX = u.posX + (u.rng.nextDouble() * 48 - 24);
                    u.targetPosY = u.posY + (u.rng.nextDouble() * 48 - 24);
                }
                u.moveTo(u.targetPosX, u.targetPosY, 0, u.speed * 0.5);
                if (u.getDistanceTo(u.targetPosX, u.targetPosY, 0) < 1.8) u.targetPosX = null;
            }
        }
    }

    /** Inheritance: „Sie tragen unsere Gesichter … und unsere Fehler.“ */
    void ageAndInherit() {
        for (Unit u : unitList) {
            if (u.leben <= 0 || !u.isMortal) continue;
            u.age += 1;
            if (u.age > u.lifespan) {
                u.leben = 0;
                if (u.isHero) {
                    world.tragedies++;
                    log("TOD DES HELDEN | " + u.typ + " fällt. Der Code wird weitergegeben.");
                    // Spawn successor with mutated genome
                    Unit child = spawn("Nachfolger", "HERO", Faction.HUMAN,
                            u.posX + rnd(-20, 20), u.posY + rnd(-20, 20), 11.5, 280, true);
                    child.isHero = true;
                    child.gift = u.gift + (rng.nextDouble() - 0.5) * 0.3;
                    child.flaw = u.flaw + (rng.nextDouble() - 0.5) * 0.3;
                    child.insight = u.insight * 0.6;
                    world.heroGift = child.gift;
                    world.heroFlaw = child.flaw;
                    if (u.bondedUnit != null) {
                        child.bondedUnit = u.bondedUnit;
                        u.bondedUnit.bondedUnit = child;
                    }
                } else if (countFaction(Faction.HUMAN) < 60 && rng.nextDouble() < 0.55) {
                    Unit child = spawn("Adamu", "LABORER", Faction.HUMAN,
                            u.posX + rnd(-18, 18), u.posY + rnd(-18, 18), 7, 100, true);
                    child.gift = u.gift + (rng.nextDouble() - 0.5) * 0.28;
                    child.flaw = u.flaw + (rng.nextDouble() - 0.5) * 0.28;
                }
            }
        }
    }

    boolean check(Cond c, double p) {
        switch (c) {
            case GOLD_LOW:        return world.gold < p;
            case ENTROPY_LOW:     return world.entropy < p;
            case ENTROPY_HIGH:    return world.entropy > p;
            case WISDOM_HIGH:     return world.wisdom > p;
            case WATCHER_HIGH:    return world.watcherPressure > p;
            case HUMANS_ALIVE:    return countFaction(Faction.HUMAN) > 0;
            case AXIS_THREATENED: return world.axisThreatened;
            case AXIS_SHIFTED:    return world.axisShifted;
            case SHADOW_DEAD:     return firstShadow() == null && world.stage.ordinal() >= Stage.TRIALS.ordinal();
            case HERO_READY:      return firstHero() != null;
            case SYMBIOSE_HIGH:   return world.symbiose > p;
            case TABLETS_DONE:    return world.tabletsInscribed >= (int) p;
            case HERO_DEAD:       return world.tragedies > 0;
            case DELUGE_READY:    return world.watcherPressure > 60 && world.stage.ordinal() >= Stage.TRIALS.ordinal();
            case INANNA_DESCENDED:return world.inannaDescended;
            case LEGACY_HIGH:     return world.collectiveLegacy > p;
        }
        return false;
    }

    void evaluateGraph() {
        for (CausalEdge e : causalGraph) {
            if (e.fired) continue;
            if (!check(e.cond, e.param)) continue;
            e.fired = true;
            e.firedAt = simulationTicks;
            log("KAUSAL | " + e.from + " --[" + e.label + "]--> " + e.to + "   (" + e.id + ")");
            effect(e);
        }
    }

    void effect(CausalEdge e) {
        switch (e.id) {
            case "E01":
                nextStage();
                log("ALALU | Der verbannte König hat das Gold gesehen. Die Hoffnung ist geboren.");
                break;
            case "E02":
                nextStage();
                log("ANKUNFT | Enki berührt die Erde. Fünfzig Anunnaki folgen.");
                break;
            case "E03":
                nextStage();
                log("ERIDU | Die erste Stadt erhebt sich aus dem Schlamm des Persischen Golfs.");
                break;
            case "E05":
                log("REVOLTE | Die Igigi legen die Werkzeuge nieder. Die Last ist zu schwer.");
                break;
            case "E06":
                nextStage();
                for (int i = 0; i < 10; i++)
                    spawn("Adamu", "LABORER", Faction.HUMAN, rnd(-200, 200), rnd(-140, 220), 7.5, 110, true);
                log("GENESIS | Aus Lehm und göttlichem Samen entsteht der erste Mensch.");
                break;
            case "E08":
                world.tragedies++;
                log("KAIN & ABEL | Der erste Mord. Blut tränkt die Erde.");
                break;
            case "E09":
                world.axisThreatened = true;
                Unit anzu = spawn("Anzu", "SHADOW", Faction.WATCHER, 200, -160, 14, 380, false);
                anzu.schaden = 18;
                log("ANZU | Die Schicksalstafeln sind gestohlen. Baalbek bebt.");
                break;
            case "E11":
                world.deluge = true;
                nextStage();
                for (int i = 0; i < 7; i++)
                    spawn("Flutwelle", "HAZARD", Faction.WATCHER, rnd(-450, 450), -420, 18, 500, false);
                log("SINTFLUT | Der Böse Wind und die Wasser. Die Erde wird gereinigt.");
                break;
            case "E12":
                log("ÜBERLEBEN | Die Arche hält. Der Code der Menschheit ist gerettet.");
                world.symbiose += 10;
                break;
            case "E13":
                nextStage();
                log("ADAPA | Der zivilisierte Mensch steigt zu den Sternen auf – und kehrt zurück.");
                world.collectiveLegacy += 40;
                break;
            case "E15":
                applyAction(Faction.ENKI, "HIDE_AXIS");
                break;
            case "E17":
                log("INANNA | Die sieben Tore öffnen sich. Jeder Schritt kostet Macht.");
                break;
            case "E19":
                nextStage();
                world.collectiveLegacy += 50;
                break;
            case "E20":
                for (Faction f : Faction.values())
                    mythosPoints.put(f, mythosPoints.get(f) + 30.0);
                log("SYMBIOSE | Alle gewinnen. Das Gleichgewicht trägt sich selbst.");
                break;
            case "E21":
                world.victory = true;
                exportTablets();
                break;
        }
    }

    void nextStage() {
        Stage[] o = Stage.values();
        int i = world.stage.ordinal();
        if (i < o.length - 1) {
            world.stage = o[i + 1];
            world.stageEnteredAt = simulationTicks;
            world.tabletsInscribed = Math.min(14, world.tabletsInscribed + 1);
            world.mythos += 5.5;
            log("MONOMYTH | " + world.stage.label + "   [Tafel " + world.tabletsInscribed + "/14]");
        }
    }

    void advanceMonomyth() {
        Unit h = firstHero();
        long held = simulationTicks - world.stageEnteredAt;
        switch (world.stage) {
            case REFUSAL:
                if (held > 55) nextStage();
                break;
            case MENTOR:
                if (world.wisdom > 90) nextStage();
                break;
            case THRESHOLD:
                if (world.axisThreatened || world.watcherPressure > 42) nextStage();
                break;
            case TRIALS:
                if (h != null && firstShadow() == null && held > 70) {
                    spawn("Schatten", "SHADOW", Faction.WATCHER,
                            h.posX + rnd(50, 110), h.posY + rnd(-70, 70), 13, 400, false);
                    log("SCHATTEN | Der Schatten tritt hervor – mit dem Gesicht des Helden.");
                }
                break;
            case ORDEAL:
                if (h != null && h.insight > 55) nextStage();
                break;
            case REWARD:
                if (world.collectiveLegacy > 80) nextStage();
                break;
            case ROAD_BACK:
                if (world.axisShifted) nextStage();
                break;
            case RESURRECTION:
                if (world.symbiose > 58) nextStage();
                break;
            case MASTER:
                if (world.tabletsInscribed >= 12) nextStage();
                break;
            default:
                break;
        }
        // Auto-trigger deluge when conditions mature
        if (!world.deluge && world.watcherPressure > 65 && world.stage.ordinal() >= Stage.TRIALS.ordinal()) {
            // will be caught by graph
        }
    }

    void computeFitness() {
        world.storyFitness = world.stage.ordinal() * 6.5
                           + world.tabletsInscribed * 4.0
                           + world.symbiose
                           + world.collectiveLegacy * 0.15
                           + world.mythos
                           - world.tragedies * 12.0;
    }

    /* ==================== VARIANT GENERATION ==================== */
    void generateVariant() {
        seed = seed * 6364136223846793005L + 1442695040888963407L;
        rng = new Random(seed);
        simulationTicks = 0;
        causalityLog.clear();
        actionLog.clear();
        unitList.clear();
        world = new WorldState();
        world.heroGift = rng.nextDouble();
        world.heroFlaw = rng.nextDouble();
        running = true;
        init();
        log("VARIANTE | Neue Saat " + seed + ". Neues Genom: Gift=" +
            String.format("%.2f", world.heroGift) + " Fehler=" + String.format("%.2f", world.heroFlaw));
    }

    void exportTablets() {
        StringBuilder sb = new StringBuilder();
        sb.append("=== DIE VIERZEHN TAFELN | SEED ").append(seed).append(" ===\n\n");
        for (int i = 0; i <= world.stage.ordinal() && i < Stage.values().length; i++)
            sb.append("TAFEL ").append(i + 1).append(": ").append(Stage.values()[i].label).append("\n");
        sb.append("\n--- KAUSALITÄT (gefeuert) ---\n");
        for (CausalEdge e : causalGraph)
            if (e.fired)
                sb.append(e.id).append("  ").append(e.from).append(" → ").append(e.to)
                  .append("  @tick ").append(e.firedAt).append("\n");
