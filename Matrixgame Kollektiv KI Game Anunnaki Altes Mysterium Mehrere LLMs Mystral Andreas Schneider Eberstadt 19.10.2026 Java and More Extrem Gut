    // ===================== 6. KASKADE (deterministisch) ====================
    static Set<Integer> kaskade(Set<Integer> blockiert) {
        Set<Integer> gefeuert = new LinkedHashSet<>();
        boolean veraendert = true;
        int durchlaeufe = 0;
        while (veraendert) {
            veraendert = false;
            durchlaeufe++;
            for (ChronikEintrag e : REGISTRY.values()) {
                if (gefeuert.contains(e.id()) || blockiert.contains(e.id())) continue;
                boolean alleUrsachen = true;
                for (int u : e.ursachen()) if (!gefeuert.contains(u)) { alleUrsachen = false; break; }
                if (alleUrsachen && e.ursachen().length >= 0) { gefeuert.add(e.id()); veraendert = true; }
            }
        }
        LETZTE_KASKADEN_DURCHLAEUFE = durchlaeufe;
        return gefeuert;
    }

    // ===================== 7. GUARDIAN v2.2 "DER CHRONIST" =================
    // 5 Waechter, alle mit Ursache, Kausalkette und Ueberbieten-Empfehlung.

    static List<String> waechterKonfabulation(Set<Integer> gefeuert) {
        // KONFABULATIONS-WAECHTER: Ereignis behauptet Ursache, die nicht
        // existiert oder nie gefeuert hat. Kernsatz: Ein Ereignis ohne
        // Ursache ist ein Antrag (Klasse E).
        List<String> alarme = new ArrayList<>();
        for (ChronikEintrag e : REGISTRY.values()) {
            if (!gefeuert.contains(e.id())) continue;
            for (int u : e.ursachen()) {
                ChronikEintrag urs = REGISTRY.get(u);
                if (urs == null) alarme.add("KONFABULATION bei #" + e.id() + ": Ursache #" + u + " existiert nicht.");
                else if (!gefeuert.contains(u))
                    alarme.add("KONFABULATION bei #" + e.id() + ": Ursache #" + u + " nie gefeuert.");
            }
        }
        return alarme;
    }

    static List<String> waechterZeitpfeil() {
        // ZEITPFEIL-WAECHTER: Wirkung vor Ursache = Rueckwaertskausalitaet.
        List<String> alarme = new ArrayList<>();
        for (ChronikEintrag e : REGISTRY.values())
            for (int u : e.ursachen()) {
                ChronikEintrag urs = REGISTRY.get(u);
                if (urs != null && urs.zeitNachAnkunftJahre() >= e.zeitNachAnkunftJahre())
                    alarme.add("ZEITPFEIL: #" + u + " (t=" + urs.zeitNachAnkunftJahre()
                            + ") liegt nicht vor #" + e.id() + " (t=" + e.zeitNachAnkunftJahre() + ").");
            }
        return alarme;
    }

    static List<String> waechterProphezeiung(Set<Integer> gefeuert) {
        // PROPHEZEIUNGS-WAECHTER: Verkuendigung ohne Erfuellung = offener Claim.
        List<String> alarme = new ArrayList<>();
        for (Prophezeiung p : PROPHEZEIUNGEN)
            if (gefeuert.contains(p.verkuendigungId()) && !gefeuert.contains(p.erfuellungId()))
                alarme.add("PROPHEZEIUNG offen: '" + p.text() + "' - Erfuellung #" + p.erfuellungId() + " fehlt.");
        return alarme;
    }

    static List<String> waechterTafeln(Set<Integer> gefeuert) {
        // TAFELN-WAECHTER: Sieg = 14 Tafeln beschrieben. (Siegbedingung des
        // kollektiven Spiels: nicht wer tot ist, sondern was geboren wurde.)
        List<String> alarme = new ArrayList<>();
        for (Tafel t : TAFELN)
            for (int i = t.vonId(); i <= t.bisId(); i++)
                if (!gefeuert.contains(i)) alarme.add("TAFELN: " + t.name() + " unvollstaendig (Ereignis #" + i + " fehlt).");
        if (TAFELN.length != TAFELN_ANZAHL) alarme.add("TAFELN: Soll 14, ist " + TAFELN.length + ".");
        return alarme;
    }

    static List<String> waechterWaffen(Set<Integer> gefeuert) {
        // WAFFEN-WAECHTER (Anti-Archiv-Bruecke, Q52): Verstecken != Vernichten.
        // Fund der Chronik: Enki versteckt die Atomwaffen (Ereignis 18) -
        // aber in der GESAMTEN Chronik existiert kein Loesch-Ereignis. Rund
        // 440.000 Jahre spaeter (Ereignis 90) holt Abgals Hoehle sie zurueck.
        // Kernsatz: "Wer Waffen versteckt, statt sie zu ueberbieten,
        // hinterlaesst eine Adresse."
        List<String> alarme = new ArrayList<>();
        boolean waffenVersteckt = gefeuert.contains(18);
