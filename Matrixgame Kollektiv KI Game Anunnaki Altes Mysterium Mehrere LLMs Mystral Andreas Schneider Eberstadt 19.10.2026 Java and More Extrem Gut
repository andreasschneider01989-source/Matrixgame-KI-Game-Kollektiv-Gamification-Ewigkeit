    class MouseHandler extends MouseAdapter implements MouseMotionListener {
        public void mousePressed(MouseEvent e) {
            if (SwingUtilities.isRightMouseButton(e)) {
                if (world.entropy >= 18) {
                    world.entropy -= 18;
                    double wx = (e.getX() - getWidth() / 2.0) / zoomFactor - zoomCenterX;
                    double wy = (e.getY() - getHeight() / 2.0) / zoomFactor - zoomCenterY;
                    Unit h = spawn("Held", "HERO", Faction.HUMAN, wx, wy, 11.5, 270, true);
                    h.isHero = true;
                    h.insight = 14;
                    h.gift = world.heroGift;
                    h.flaw = world.heroFlaw;
                    log("EINGRIFF | Ein neuer Träger des Codes erscheint. (Rechtsklick)");
                }
            } else {
                dragStartX = e.getX();
                dragStartY = e.getY();
                currentMouseX = dragStartX;
                currentMouseY = dragStartY;
                isDragging = false;
            }
        }
        public void mouseDragged(MouseEvent e) {
            if (!SwingUtilities.isLeftMouseButton(e)) return;
            if (Math.hypot(e.getX() - dragStartX, e.getY() - dragStartY) > 5) isDragging = true;
            if (isDragging) {
                zoomCenterX += (e.getX() - currentMouseX) / zoomFactor;
                zoomCenterY += (e.getY() - currentMouseY) / zoomFactor;
            }
            currentMouseX = e.getX();
            currentMouseY = e.getY();
            repaint();
        }
        public void mouseMoved(MouseEvent e) {}
        public void mouseReleased(MouseEvent e) {
            if (SwingUtilities.isLeftMouseButton(e) && !isDragging) {
                Unit h = firstHero();
                if (h != null) {
                    h.targetPosX = (e.getX() - getWidth() / 2.0) / zoomFactor - zoomCenterX;
                    h.targetPosY = (e.getY() - getHeight() / 2.0) / zoomFactor - zoomCenterY;
                    log("FÜHRUNG | Dem Helden wird ein Weg gewiesen.");
                }
            }
            isDragging = false;
            dragStartX = -1;
            dragStartY = -1;
            repaint();
        }
    }

