    static List<Map.Entry<String, Integer>> akteurTopN(TreeMap<String, Integer> count, int n) {
        List<Map.Entry<String, Integer>> liste = new ArrayList<>(count.entrySet());
        liste.sort((a, b) -> Integer.compare(b.getValue(), a.getValue()));
        return liste.subList(0, Math.min(n, liste.size()));
    }

