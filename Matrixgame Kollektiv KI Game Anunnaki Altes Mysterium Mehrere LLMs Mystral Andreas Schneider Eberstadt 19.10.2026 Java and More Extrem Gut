            int X=(int)sx(u.posX), Y=(int)sy(u.posY);
            if(u.isHero || u.role.equals("DEITY")){
                g2.setColor(new Color(u.red,u.green,u.blue,60));
                g2.fillOval((int)(X-r*2.4),(int)(Y-r*2.4),(int)(r*4.8),(int)(r*4.8));
            }
            g2.setColor(new Color(u.red,u.green,u.blue));
            g2.fillOval((int)(X-r),(int)(Y-r),(int)(2*r),(int)(2*r));
            if(u.isHero){ g2.setColor(Color.WHITE); g2.drawOval((int)(X-r-3),(int)(Y-r-3),(int)(2*r+6),(int)(2*r+6)); }
        }

        drawMonomyth(g2);
        int bx=24, by=70;
        drawBar(g2,bx,by,240,20,world.gold/1200.0,new Color(255,215,0),"GOLD (Nibiru)",world.gold);
        drawBar(g2,bx,by+26,240,20,world.entropy/100.0,new Color(255,80,200),"ENTROPIE (Mana)",world.entropy);
        drawBar(g2,bx,by+52,240,20,world.wisdom/300.0,new Color(0,220,255),"WEISHEIT (ME)",world.wisdom);
        drawBar(g2,bx,by+78,240,20,world.symbiose/100.0,new Color(0,255,140),"SYMBIOSE",world.symbiose);
        drawBar(g2,bx,by+104,240,20,world.watcherPressure/100.0,new Color(170,90,255),"WÄCHTER-DRUCK",world.watcherPressure);
        g2.setColor(Color.WHITE); g2.setFont(new Font("Monospaced",Font.BOLD,13));
        g2.drawString("ERZÄHL-FITNESS: "+String.format("%.0f",world.storyFitness)+"  TAFELN "+world.tabletsInscribed+"/14", bx, by+148);
        g2.drawString("SEED "+seed+"  TICKS "+simulationTicks, bx, by+168);

        g2.setColor(new Color(15,15,15,210)); g2.fillRect(getWidth()-470,60,446,220);
        g2.setColor(new Color(0,255,128)); g2.setFont(new Font("Monospaced",Font.PLAIN,12));
        int y=84;
        for(String s:causalityLog){ g2.drawString(trim(s,64), getWidth()-458, y); y+=20; }

        g2.setColor(new Color(15,15,15,210)); g2.fillRect(getWidth()-470,296,446,150);
        g2.setColor(new Color(255,220,90));
        g2.drawString("=== MYTHOS-PUNKTE | alle gewinnen ===", getWidth()-458, 318);
        y=340;
        for(Faction f:Faction.values()){
            g2.setColor(f.color);
            g2.drawString(trim(f.label,26)+"  "+String.format("%7.1f",mythosPoints.get(f)), getWidth()-458, y);
            y+=18;
        }
    }
    String trim(String s,int n){ return s.length()<=n?s:s.substring(0,n); }
    void drawBar(Graphics2D g2,int x,int y,int w,int h,double frac,Color c,String l,double v){
        g2.setColor(new Color(35,35,35)); g2.fillRect(x,y,w,h);
        g2.setColor(c); g2.fillRect(x,y,(int)(w*Math.max(0,Math.min(1,frac))),h);
        g2.setColor(Color.BLACK); g2.setFont(new Font("Monospaced",Font.BOLD,12));
        g2.drawString(l+": "+String.format("%.0f",v), x+5, y+14);
    }
    void drawMonomyth(Graphics2D g2){
        Stage[] s=Stage.values(); int w=(getWidth()-80)/s.length;
        for(int i=0;i<s.length;i++){
            int x=40+i*w;
            g2.setColor(i<world.stage.ordinal()?new Color(0,200,140):(i==world.stage.ordinal()?new Color(255,220,60):new Color(60,60,60)));
            g2.fillRect(x,16,w-4,10);
        }
        g2.setColor(Color.WHITE); g2.setFont(new Font("Monospaced",Font.BOLD,14));
        g2.drawString("MONOMYTH | "+world.stage.label, 40, 48);
    }

    /* ============ 12. MAUS ============ */
    class MouseHandler extends MouseAdapter implements MouseMotionListener {
        public void mousePressed(MouseEvent e){
            if(SwingUtilities.isRightMouseButton(e)){
                if(world.entropy>=15){
                    world.entropy-=15;
                    Unit h=spawn("Held","HERO",Faction.HUMAN,wx(e.getX()),wy(e.getY()),11,260,true);
                    h.isHero=true; h.insight=12;
                    log("EINGRIFF | Entropie gesenkt — ein Held wird in die Welt gesetzt.");
                }
            } else {
                dragStartX=e.getX(); dragStartY=e.getY();
                currentMouseX=dragStartX; currentMouseY=dragStartY; isDragging=false;
            }
        }
        public void mouseDragged(MouseEvent e){
