    void drawMonomyth(Graphics2D g2) {
        Stage[] s = Stage.values();
        int w = (getWidth() - 90) / s.length;
        for (int i = 0; i < s.length; i++) {
            int x = 45 + i * w;
            g2.setColor(i < world.stage.ordinal() ? new Color(0, 190, 130) :
                       (i == world.stage.ordinal() ? new Color(255, 210, 40) : new Color(50, 50, 50)));
            g2.fillRect(x, 14, w - 3, 9);
        }
        g2.setColor(Color.WHITE);
