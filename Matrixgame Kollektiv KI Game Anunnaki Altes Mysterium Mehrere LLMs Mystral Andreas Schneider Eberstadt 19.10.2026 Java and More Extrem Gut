    static TreeMap<String, Integer> akteurRanking() {
        TreeMap<String, Integer> count = new TreeMap<>();
        for (ChronikEintrag e : REGISTRY.values())
            for (String a : e.akteure())
                count.merge(a, 1, Integer::sum);
