    void checkpoint() {
        try (ObjectOutputStream o = new ObjectOutputStream(new FileOutputStream("checkpoint.bin"))) {
            o.writeObject(world);
            o.writeObject(new ArrayList<>(unitList));
            o.writeObject(new ArrayList<>(actionLog));
            o.writeObject(new ArrayList<>(causalityLog));
            o.writeLong(seed);
            o.writeLong(simulationTicks);
        } catch (IOException e) { /* silent */ }
    }

    @SuppressWarnings("unchecked")
    void restore() {
        try (ObjectInputStream i = new ObjectInputStream(new FileInputStream("checkpoint.bin"))) {
            world = (WorldState) i.readObject();
            unitList.clear();
            unitList.addAll((List<Unit>) i.readObject());
            actionLog.clear();
            actionLog.addAll((List<String>) i.readObject());
            causalityLog.clear();
            causalityLog.addAll((List<String>) i.readObject());
            seed = i.readLong();
            simulationTicks = i.readLong();
            rng = new Random(seed);
            log("REKONSTRUKTION | Zustand aus checkpoint.bin wiederhergestellt. Tick " + simulationTicks);
