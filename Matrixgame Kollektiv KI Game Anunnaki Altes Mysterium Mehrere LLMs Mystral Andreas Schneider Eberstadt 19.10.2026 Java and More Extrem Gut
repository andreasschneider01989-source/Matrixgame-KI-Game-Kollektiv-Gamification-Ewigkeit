        causalGraph.add(new CausalEdge("E11","TAFELN","ENDUBSAR","Vierzig Tage, vierzig Nächte",Cond.TABLETS_DONE,14,1.0));
    }

    /* ============ 6. HELFER ============ */
    double rnd(double a,double b){ return a + rng.nextDouble()*(b-a); }

    void log(String s){
        causalityLog.add(0, "["+simulationTicks+"] "+s);
        while(causalityLog.size()>8) causalityLog.remove(causalityLog.size()-1);
        System.out.println("KAUSAL | "+s);
    }

    Unit spawn(String typ,String role,Faction f,double x,double y,double size,double hp,boolean mortal){
        Unit u = new Unit();
        u.id = unitList.size(); u.team = f.ordinal(); u.typ=typ; u.role=role; u.faction=f;
        u.posX=x; u.posY=y; u.posZ=0; u.size=size; u.leben=hp; u.isMortal=mortal;
        u.lifespan = mortal ? 700+rng.nextDouble()*500 : Double.MAX_VALUE;
        u.red=f.color.getRed(); u.green=f.color.getGreen(); u.blue=f.color.getBlue();
        u.rng = new Random(seed + unitList.size()*7919L);
        u.gift = world.heroGift + (rng.nextDouble()-0.5)*0.4;
        u.flaw = world.heroFlaw + (rng.nextDouble()-0.5)*0.4;
        unitList.add(u);
        return u;
    }

    long countFaction(Faction f){
        long n=0; for(Unit u:unitList) if(u.faction==f && u.leben>0) n++; return n;
    }
    Unit firstHero(){
        for(Unit u:unitList) if(u.isHero && u.leben>0) return u; return null;
    }
    Unit firstShadow(){
        for(Unit u:unitList) if(u.role.equals("SHADOW") && u.leben>0) return u; return null;
    }
    AxisNode nearestAxis(Unit u){
        AxisNode best=null; double m=Double.MAX_VALUE;
        for(AxisNode a:axisNodes){ double d=u.getDistanceTo(a.x,a.y,0); if(d<m){m=d;best=a;} }
        return best;
    }
    double commonGood(){
        return world.symbiose + world.wisdom*0.1 + world.gold*0.01 - world.watcherPressure*0.2;
    }

    /* ============ 7. ACTIONS (die Kausalität des Spiels) ============ */
    void applyAction(Faction f,String a){
        double before = commonGood();
        switch(a){
            case "EXPLOIT_GOLD":
                world.gold += 14; world.entropy -= 3.0; world.watcherPressure += 0.5; break;
            case "TEACH_HUMANS":
                world.wisdom += 9; world.entropy += 4; world.gold -= 2;
                world.humanPotential += 1.2;
                if(countFaction(Faction.HUMAN)==0)
                    for(int i=0;i<6;i++) spawn("Adamu","LABORER",Faction.HUMAN,rnd(-200,200),rnd(-150,220),7,100,true);
                break;
            case "FORTIFY_AXIS":
                for(AxisNode n:axisNodes) if(n.owner==f.ordinal()) n.stability=Math.min(100,n.stability+6);
                world.watcherPressure = Math.max(0, world.watcherPressure-1.5); break;
            case "ASSAULT_AXIS": {
                AxisNode t = nearestAxisOf(f);
                if(t!=null){
                    t.stability -= 9;
                    world.watcherPressure += (f==Faction.WATCHER?1.6:0.6);
                    if(t.stability<=0){ t.owner=f.ordinal(); t.stability=30;
                        log("ACHSE | "+t.name+" fällt an "+f.label+"."); }
                } break; }
            case "HIDE_AXIS":
                if(!world.axisShifted){
                    world.axisShifted = true;
                    axisNodes.add(new AxisNode("Jenseits des Ozeans", -420, -320, Faction.ENKI.ordinal(), 90, true));
                    log("STRATEGIE | Die Verbindung Himmel–Erde wird verschoben. Verborgen. Sicher.");
                } break;
            case "MERCY":
                world.entropy += 6; world.symbiose += 2.2; world.gold -= 3; break;
            case "PURGE":
                world.entropy -= 8; world.symbiose -= 4.5; world.watcherPressure += 1.0;
                for(Unit u:unitList) if(u.faction==Faction.HUMAN && u.leben>0 && rng.nextDouble()<0.25) u.leben=0;
                break;
            case "REBEL":
                world.entropy -= 5; world.symbiose -= 1.5;
                for(Unit u:unitList) if(u.faction==Faction.IGIGI) u.decisionAlgorithm="REBEL";
                break;
            default: break;
        }
        double delta = commonGood() - before;
        mythosPoints.put(f, mythosPoints.get(f) + Math.max(0.0, delta));
        actionLog.add(simulationTicks+"|"+f+"|"+a);
    }
    AxisNode nearestAxisOf(Faction f){
        AxisNode best=null; double m=Double.MAX_VALUE;
        for(AxisNode n:axisNodes) if(n.owner!=f.ordinal()){
            double d=Math.hypot(n.x, n.y); if(d<m){m=d;best=n;}
        }
        return best;
    }

    /* ============ 8. GAMELOOP ============ */
    void gameLoop(){
        while(running){
            simulationTicks++;
            step();
            repaint();
            try { Thread.sleep(pauseTime); } catch(InterruptedException e){ return; }
        }
    }

    void step(){
        produce();
        runStrategists();
        moveAndFight();
        ageAndInherit();
        evaluateGraph();
        advanceMonomyth();
        computeFitness();
        if(simulationTicks % 240 == 0) checkpoint();
    }

    void produce(){
        for(Unit u:unitList){
            if(u.leben<=0) continue;
            if(u.role.equals("MINER")){ world.gold+=0.55; world.entropy-=0.16; }
            else if(u.role.equals("LABORER")){ world.gold+=0.22; world.wisdom+=0.22; world.entropy+=0.06; }
            else if(u.role.equals("DEITY")){ world.entropy+=0.22; if(u.faction==Faction.ENKI) world.wisdom+=0.14; }
            else if(u.role.equals("GUARDIAN")||u.role.equals("SHADOW")){ world.watcherPressure+=0.03; world.entropy-=0.04; }
            else if(u.isHero){ world.mythos+=0.10; u.insight+=0.28; }
        }
        world.entropy = Math.max(0, Math.min(100, world.entropy));
        world.gold    = Math.max(0, world.gold);
        world.wisdom  = Math.max(0, world.wisdom);
        world.symbiose= Math.max(0, Math.min(100, world.symbiose));
        world.watcherPressure = Math.max(0, world.watcherPressure);
    }

    void runStrategists(){
        for(String s : new ArrayList<String>()){ /* noop */ }
        for(Strategist st : strategists){
            if(simulationTicks % st.period() != 0) continue;
            String a = st.decide(world);
            if(a!=null && !a.isEmpty()) applyAction(st.faction(), a);
        }
    }

    void moveAndFight(){
        for(Unit u:unitList){
            if(u.leben<=0) continue;
            if(u.role.equals("GUARDIAN") || u.role.equals("SHADOW")){
                AxisNode t = nearestAxis(u);
                if(t!=null && t.owner != u.team){
                    if(u.getDistanceTo(t.x,t.y,0) < 8){ t.stability-=2.0; world.watcherPressure+=0.05; }
                    else u.moveTo(t.x,t.y,0,u.speed);
                }
            } else if(u.isHero){
                Unit sh = firstShadow();
                if(sh!=null){
                    if(u.getDistance(sh) < u.reichweite) u.attackieren(sh);
                    else u.moveTo(sh);
                }
            } else if(u.decisionAlgorithm.equals("REBEL")){
                Unit god=null;
                for(Unit o:unitList) if(o.role.equals("DEITY") && o.leben>0){ god=o; break; }
                if(god!=null){
                    if(u.getDistance(god) < u.reichweite) u.attackieren(god);
                    else u.moveTo(god);
                }
            } else {
                if(u.targetPosX==null || u.rng.nextDouble()<0.012){
                    u.targetPosX = u.posX + (u.rng.nextDouble()*50-25);
                    u.targetPosY = u.posY + (u.rng.nextDouble()*50-25);
                }
                u.moveTo(u.targetPosX, u.targetPosY, 0, u.speed*0.6);
                if(u.getDistanceTo(u.targetPosX,u.targetPosY,0) < 1.5) u.targetPosX=null;
            }
        }
    }

    /** Vererbung: „Sie tragen unsere Gesichter … und unsere Fehler.“ */
    void ageAndInherit(){
        for(Unit u:unitList){
            if(u.leben<=0 || !u.isMortal) continue;
            u.age += 1;
            if(u.age > u.lifespan){
                u.leben = 0;
                if(countFaction(Faction.HUMAN) < 55 && rng.nextDouble()<0.6){
                    Unit child = spawn("Adamu","LABORER",Faction.HUMAN, u.posX+rnd(-15,15), u.posY+rnd(-15,15), 7,100,true);
                    child.gift = u.gift + (rng.nextDouble()-0.5)*0.35;
                    child.flaw = u.flaw + (rng.nextDouble()-0.5)*0.35;
                    world.heroGift = child.gift; world.heroFlaw = child.flaw;
                }
            }
        }
    }

    boolean check(Cond c,double p){
        switch(c){
            case GOLD_LOW:        return world.gold < p;
            case ENTROPY_LOW:     return world.entropy < p;
            case ENTROPY_HIGH:    return world.entropy > p;
            case WISDOM_HIGH:     return world.wisdom > p;
            case WATCHER_HIGH:    return world.watcherPressure > p;
            case HUMANS_ALIVE:    return countFaction(Faction.HUMAN) > 0;
            case AXIS_THREATENED: return world.axisThreatened;
            case AXIS_SHIFTED:    return world.axisShifted;
            case SHADOW_DEAD:     return firstShadow()==null && world.stage.ordinal()>=Stage.TRIALS.ordinal();
            case HERO_READY:      return firstHero()!=null;
            case SYMBIOSE_HIGH:   return world.symbiose > p;
            case TABLETS_DONE:    return world.tabletsInscribed >= (int)p;
            case HERO_DEAD:       return world.tragedies > 0;
        }
        return false;
    }

    void evaluateGraph(){
        for(CausalEdge e : causalGraph){
            if(e.fired) continue;
            if(!check(e.cond, e.param)) continue;
            e.fired = true; e.firedAt = simulationTicks;
            log("KAUSAL | "+e.from+" --["+e.label+"]--> "+e.to+"   ("+e.id+")");
            effect(e);
        }
    }

    void effect(CausalEdge e){
        if(e.id.equals("E01")){           // Ruf
            nextStage();
            Unit h = spawn("Held","HERO",Faction.HUMAN, rnd(-120,120), rnd(-80,160), 11, 260, true);
            h.isHero = true; h.insight = 10;
            log("RUF | Ein Träger des Codes erwacht. Gift="+String.format("%.2f",h.gift)+" Fehler="+String.format("%.2f",h.flaw));
        } else if(e.id.equals("E02")){    // Genesis
            for(int i=0;i<8;i++) spawn("Adamu","LABORER",Faction.HUMAN,rnd(-220,220),rnd(-160,240),7,100,true);
        } else if(e.id.equals("E03")){    // Kollaps
            if(!world.axisShifted){
                log("UNTERGANG | Nibirus Atmosphäre kollabiert. Das Gold reichte nicht. (Verborgenheit hätte gerettet.)");
                running = false;
            } else { world.gold += 200; log("RETTUNG | Die verborgene Achse trägt ein Reserve-Gold."); }
        } else if(e.id.equals("E04")){
            world.axisThreatened = true;
            log("BEDROHUNG | Der Tempel von Baalbek ist bedroht. Sie marschieren, um die Raumschiffe zu erobern.");
        } else if(e.id.equals("E06")){
            world.deluge = true; nextStage();
            for(int i=0;i<6;i++) spawn("Flut","HAZARD",Faction.WATCHER,rnd(-400,400),-380,14,400,false);
        } else if(e.id.equals("E08")){
            nextStage(); world.mythos += 12;
        } else if(e.id.equals("E09")){
            Unit h = firstHero();
            if(h==null){
                world.tragedies++;
                Unit s = spawn("Nachfolger","HERO",Faction.HUMAN,rnd(-120,120),rnd(-80,160),11,260,true);
                s.isHero=true; s.gift=world.heroGift; s.flaw=world.heroFlaw; s.insight=6;
                log("NACHFOLGE | Ein neuer Held trägt die Gesichter und die Fehler des alten.");
            }
        } else if(e.id.equals("E10")){
            for(Faction f : Faction.values()) mythosPoints.put(f, mythosPoints.get(f)+25.0);
            log("SYMBIOSE | Alle gewinnen. Das Gleichgewicht trägt sich selbst.");
        } else if(e.id.equals("E11")){
            world.victory = true;
            log("ENDUBSAR | Vierzig Tage, vierzig Nächte. Vierzehn Tafeln. Die Geschichte ist in die Ewigkeit gegraben.");
            exportTablets();
        }
    }

    void nextStage(){
        Stage[] o = Stage.values();
        int i = world.stage.ordinal();
        if(i < o.length-1){
            world.stage = o[i+1];
            world.stageEnteredAt = simulationTicks;
            world.tabletsInscribed = Math.min(14, world.tabletsInscribed+1);
            world.mythos += 6;
            log("MONOMYTH | "+world.stage.label+"   [Tafel "+world.tabletsInscribed+"/14]");
        }
    }

    /** Der Monomyth schreitet nur, wenn die WELT reif dafür ist — nicht per Knopf. */
    void advanceMonomyth(){
        Unit h = firstHero();
        long held = simulationTicks - world.stageEnteredAt;
        switch(world.stage){
            case REFUSAL:   if(held>60) nextStage(); break;                       // Enlil zuckt zusammen
            case MENTOR:    if(world.wisdom>110) nextStage(); break;              // Enki lehrt
            case THRESHOLD: if(world.axisThreatened || world.watcherPressure>45) nextStage(); break;
            case TRIALS:    if(h!=null && firstShadow()==null && held>80){
                                spawn("Schatten","SHADOW",Faction.WATCHER,h.posX+rnd(60,120),h.posY+rnd(-60,60),13,420,false);
                                log("SCHATTEN | Der Schatten tritt hervor — mit des Helden Gesicht.");
                            } break;
            case ORDEAL:    if(h!=null && h.insight>60) nextStage(); break;
            case REWARD:    if(world.gold>300) nextStage(); break;
            case ROAD_BACK: if(world.axisShifted) nextStage(); break;
            case RESURRECTION: if(world.symbiose>60) nextStage(); break;
            case MASTER:    if(world.tabletsInscribed>=12) nextStage(); break;
            default: break;
        }
        if(h==null && world.stage.ordinal()>=Stage.CALL.ordinal() && world.stage.ordinal()<Stage.ELIXIR.ordinal()){
            if(firstShadow()!=null || world.deluge){ world.tragedies++; }
        }
    }

    void computeFitness(){
        world.storyFitness = world.stage.ordinal()*7.0 + world.tabletsInscribed*3.0
                           + world.symbiose + world.mythos - world.tragedies*15.0;
    }

    /* ============ 9. GENERIERBARE WEITERE HELDENREISEN ============ */
    void generateVariant(){
        seed = seed*6364136223846793005L + 1442695040888963407L;
        rng = new Random(seed);
        simulationTicks = 0;
        causalityLog.clear(); actionLog.clear(); unitList.clear();
        world = new WorldState();
        world.heroGift = rng.nextDouble(); world.heroFlaw = rng.nextDouble();
        running = true;
        init();
        log("VARIANTE | Neue Saat "+seed+". Neues Genom: Gift="+String.format("%.2f",world.heroGift)+" Fehler="+String.format("%.2f",world.heroFlaw));
    }

    void exportTablets(){
        StringBuilder sb = new StringBuilder();
        sb.append("=== DIE VIERZEHNTAFELN | SEED ").append(seed).append(" ===\n");
        for(int i=0;i<=world.stage.ordinal();i++) sb.append("TAFEL ").append(i+1).append(": ").append(Stage.values()[i].label).append("\n");
        sb.append("--- KAUSALITÄT ---\n");
        for(CausalEdge e:causalGraph) if(e.fired) sb.append(e.id).append(" ").append(e.from).append(" -> ").append(e.to).append(" @").append(e.firedAt).append("\n");
        sb.append("--- AKTIONEN ---\n");
        for(String s:actionLog) sb.append(s).append("\n");
        sb.append("--- MYTHOS-PUNKTE (alle gewinnen) ---\n");
        for(Faction f:Faction.values()) sb.append(f.label).append(": ").append(String.format("%.1f",mythosPoints.get(f))).append("\n");
        System.out.println(sb.toString());
        try(PrintWriter pw=new PrintWriter(new FileWriter("tafeln_"+seed+".txt"))){ pw.print(sb.toString()); }
        catch(IOException ex){ log("EXPORT FEHLGESCHLAGEN"); }
    }

    /* ============ 10. REKONSTRUKTION ============ */
    void checkpoint(){
        try(ObjectOutputStream o=new ObjectOutputStream(new FileOutputStream("checkpoint.bin"))){
            o.writeObject(world); o.writeObject(new ArrayList<>(unitList));
            o.writeObject(new ArrayList<>(actionLog)); o.writeObject(new ArrayList<>(causalityLog));
        } catch(IOException e){ /* still */ }
    }
    void restore(){
        try(ObjectInputStream i=new ObjectInputStream(new FileInputStream("checkpoint.bin"))){
            world = (WorldState) i.readObject();
            unitList.clear(); unitList.addAll((List<Unit>) i.readObject());
            actionLog.clear(); actionLog.addAll((List<String>) i.readObject());
            causalityLog.clear(); causalityLog.addAll((List<String>) i.readObject());
            log("REKONSTRUKTION | Zustand aus checkpoint.bin wiederhergestellt.");
        } catch(Exception e){ log("KEIN CHECKPOINT"); }
        repaint();
    }

    /* ============ 11. RENDERING ============ */
    double wx(double s){ return (s - getWidth()/2.0)/zoomFactor - zoomCenterX; }
    double wy(double s){ return (s - getHeight()/2.0)/zoomFactor - zoomCenterY; }
    double sx(double w){ return (zoomCenterX + w)*zoomFactor + getWidth()/2.0; }
    double sy(double w){ return (zoomCenterY + w)*zoomFactor + getHeight()/2.0; }

    @Override protected void paintComponent(Graphics g){
        super.paintComponent(g);
        Graphics2D g2=(Graphics2D)g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING,RenderingHints.VALUE_ANTIALIAS_ON);
        g2.setColor(Color.BLACK); g2.fillRect(0,0,getWidth(),getHeight());

        for(AxisNode a:axisNodes){
            if(a.hidden && !world.axisShifted) continue;
            int X=(int)sx(a.x), Y=(int)sy(a.y);
            g2.setColor(a.hidden?new Color(255,255,120):new Color(120,120,160));
            g2.drawPolygon(new int[]{X,X+12,X,X-12}, new int[]{Y-12,Y,Y+12,Y}, 4);
            g2.setFont(new Font("Monospaced",Font.PLAIN,11));
