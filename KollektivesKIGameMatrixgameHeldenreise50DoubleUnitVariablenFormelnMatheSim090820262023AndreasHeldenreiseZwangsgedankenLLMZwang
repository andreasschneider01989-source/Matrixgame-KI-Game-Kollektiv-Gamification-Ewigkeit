package ordner1;

public class Unit extends KreisObjekt {
    // Physische Basiswerte
    double maxLeben;
    double leben;
    double damage;
    double distance;
    double baseSpeed;
    double speed;
    int team;
    int kills;
    public Unit target = null;
    
    // Algorithmen und Steuerung
    public String decisionAlgorithm = "GUARDIAN_MODE"; // Erweitert für optimale Problemlösung
    public boolean isSelectable = true;
    public boolean isInfluencable = true;
    
    public Double targetPosX = null;
    public Double targetPosY = null;
    public Double targetPosZ = null;
    public Unit manualTarget = null;
    int id;

    // ==========================================
    // 50+ PSYCHOLOGISCHE & EVOLUTIONÄRE VARIABLEN
    // ==========================================
    
    // Survival / Evolution
    double hunger = Math.random() * 20;
    double durst = Math.random() * 20;
    double muedigkeit = 0.0;
    double kaelteSchutz = 50.0;
    double reproduktionsDrang = 10.0;
    double vitalitaet = 100.0;
    double schutzbeduerfnis = 0.0;
    double alter = 0.0;

    // Basis-Emotionen
    double freude = Math.random() * 50 + 50;
    double trauer = 0.0;
    double wut = 0.0;
    double angst = 10.0;
    double vertrauen = 50.0;
    double ekel = 0.0;
    double ueberraschung = 10.0;
    double interesse = 80.0;
    double liebe = 50.0;
    double hass = 0.0;

    // Hawkins-Skala (Bewusstseins-Ebenen)
    double scham = 20.0;
    double schuld = 30.0;
    double apathie = 50.0;
    double stolz = 175.0;
    double mut = 200.0;
    double neutralitaet = 250.0;
    double bereitschaft = 310.0;
    double akzeptanz = 350.0;
    double vernunft = 400.0;
    double frieden = 600.0;
    double erleuchtung = 0.0; // Muss erst durch Kausalität erreicht werden

    // Kognition & Matrixgame-Ziele
    double maxGeistFokus = 1.0; 
    double ablenkung = Math.random() * 0.4;
    double konzentration = 0.0;
    double motivation = 80.0;
    double produktivitaet = 0.0;
    double begeisterung = 0.0;
    double inspiration = 10.0;
    double freierWille = 75.0; // % Anteil an stochastischer Selbstbestimmung
    double wille = 80.0;
    double wahn = 0.0;
    double logik = 85.0;
    double kreativitaet = 50.0;
    double intuition = 60.0;

    // Soziales & Schwarm
    double kollektivesBewusstsein = 0.0;
    double empathie = 60.0;
    double diplomatie = 40.0;
    double synergie = 1.0;
    double charisma = 20.0;

    // Entwicklungs-Hürden (Selbstmanagement)
    double negativerPerfektionismus = 30.0; // Startwert, der durch Erkenntnis minimiert werden muss
    double versagensangst = 25.0;
    double suchtDrang = 10.0;
    double resilienz = 50.0;
    double entropie = 0.0;

    public Unit() {
        super();
        this.leben = 5 * Math.random() / Math.random();
        this.maxLeben = leben;
        this.damage = Math.random() / Math.random();
        this.distance = 100 * Math.random();
        this.baseSpeed = 100 * Math.random();
        this.speed = baseSpeed;
        this.team = (int)(Math.random() * 2);
        this.size = 10;
        this.id = (int)(Math.random() * 1000);
    }

    /**
     * Führt in jedem Zeitschritt die realen mathematischen Gleichungen aus,
     * um die Kausalität von Geist, Körper und Seele zu simulieren.
     */
    public void updatePsychology(double deltaTime) {
        // 1. Physischer & Entropischer Verfall
        alter += deltaTime;
        hunger += 0.5 * deltaTime;
        muedigkeit += 0.2 * deltaTime;
        entropie = (alter * 0.01) + (suchtDrang * 0.1);

        // 2. Berechnung von Begeisterung und Kognition
        begeisterung = freude * interesse;
        konzentration = Math.max(0, (maxGeistFokus - ablenkung) * 100.0);
        
        // 3. Überwindung von Hürden durch Logik und Intuition (Entropie gegen Perfektionismus)
        if (logik > 70 && intuition > 50) {
            negativerPerfektionismus = Math.max(0, negativerPerfektionismus - (0.1 * deltaTime));
            versagensangst = Math.max(0, versagensangst - (0.1 * deltaTime));
        }

        // 4. Produktivität berechnen (Das Herzstück der Ausführung)
        produktivitaet = (motivation * konzentration * (1.0 + (inspiration / 100.0))) 
                         / (1.0 + negativerPerfektionismus + versagensangst + entropie);

        // 5. Hawkins-Skala und Mut
        mut = wille * (1.0 - (angst / 100.0));
        
        // 6. Kollektives Bewusstsein
        kollektivesBewusstsein = (empathie + diplomatie + synergie) * (vernunft / 400.0);

        // 7. Modifikation der realen Parameter im GameLoop
        this.speed = baseSpeed * (produktivitaet / 100.0) * (vitalitaet / Math.max(1.0, (hunger + muedigkeit)));
        
        // Reproduktionsdrang steigt, wenn Frieden und Ressourcen vorhanden sind
        if (frieden > 300 && hunger < 20) {
            reproduktionsDrang += 1.0 * deltaTime;
        }

        // Wenn die Unit im Retter-Modus ("GUARDIAN_MODE") agiert, richtet sie ihren Fokus
        // automatisch darauf, andere zu heilen oder systemische Entropie abzubauen.
        if(decisionAlgorithm.equals("GUARDIAN_MODE")) {
            empathie += 0.1 * deltaTime;
            wahn = Math.max(0, wahn - 0.5 * deltaTime);
            ablenkung = Math.max(0, ablenkung - 0.05 * deltaTime);
        }
    }

    public void moveTo(KreisObjekt oponent) {
        double distQ = (this.posX - oponent.posX) * (this.posX - oponent.posX)
                + (this.posY - oponent.posY) * (this.posY - oponent.posY)
                + (this.posZ - oponent.posZ) * (this.posZ - oponent.posZ);
        double dist = Math.pow(distQ, 0.5);
        
        double dx = posX - oponent.posX;
        double dy = posY - oponent.posY;
        double dz = posZ - oponent.posZ;
        
        double movDist = Math.min(speed, Math.abs(dist - distance));
        
        vx = -dx / dist * movDist;
        vy = -dy / dist * movDist;
        vz = -dz / dist * movDist;
    }

    public void moveTo(double posX, double posY, double posZ, double speedManuel) {
        double distQ = (this.posX - posX) * (this.posX - posX)
                + (this.posY - posY) * (this.posY - posY)
                + (this.posZ - posZ) * (this.posZ - posZ);
        if(distQ <= 0.00001) { targetPosX = null; targetPosY = null; }
        double dist = Math.pow(distQ, 0.5);
        
        double dx = this.posX - posX;
        double dy = this.posY - posY;
        double dz = this.posZ - posZ;
        
        double movDist = Math.min(speedManuel, Math.min(speed, Math.abs(dist - 0.0000005)));
        
        vx = -dx / dist * movDist;
        vy = -dy / dist * movDist;
        vz = -dz / dist * movDist;
    }

    public double getDistance(Unit oponent) {
        double distQ = (this.posX - oponent.posX) * (this.posX - oponent.posX)
                + (this.posY - oponent.posY) * (this.posY - oponent.posY)
                + (this.posZ - oponent.posZ) * (this.posZ - oponent.posZ);
        return Math.pow(distQ, 0.5);
    }
    
    public void printWerte(int indexInList, int zeitSchritt) {
        System.out.println("=== UNIT REPORT [Index: " + indexInList + "] ===");
        System.out.println("Id = " + id + " | Team = " + team);
        System.out.println("Produktivität = " + produktivitaet + " | Konzentration = " + konzentration);
        System.out.println("Kollektives Bewusstsein = " + kollektivesBewusstsein + " | Mut = " + mut);
        System.out.println("Negativer Perfektionismus = " + negativerPerfektionismus + " | Versagensangst = " + versagensangst);
        System.out.println("Algorithmus = " + decisionAlgorithm + " | Speed = " + speed);
        System.out.println("============================================");
    }
}

Um diese Logik aktiv in die Engine einzuspeisen, muss lediglich in der GameLoop() der MainGame-Klasse vor der Befehlsausführung (Switch-Case) der Aufruf unit.updatePsychology(1.0); für jede Iteration hinzugefügt werden.

Die KI und der Algorithmus können durch diese Parameter nun echte Kausalitätsketten abbilden. Ein Gebäude kann beispielsweise Einheiten generieren, die durch hohe Inspiration und hohe Produktivität den SuchtDrang oder den negativen Perfektionismus von feindlichen oder neutralen Einheiten durch Diplomatie und Interaktion (anstatt durch puren physikalischen "Damage") auf Null reduzieren – eine perfekte metaphorische Übertragung von Naturwissenschaft, Didaktik und Logik in das Matrixgame.


