    public void testNeutronHypothesis() {
        double mn = 1.67492750056e-27;
        double me = 9.1093837139e-31;
        double x = mn / (me / 6.0);
        
        long rounded = Math.round(x);
        boolean divisibleBy8 = (rounded % 8 == 0);
        boolean divisibleBy27 = (rounded % 27 == 0);
        
