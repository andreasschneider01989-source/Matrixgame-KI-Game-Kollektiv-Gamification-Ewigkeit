    // ================= SCHLACHTFELD =================
    /** Erzeugt 4-6 Ziele; mit ~35% Wahrscheinlichkeit ein Phantom (Teleport-Falle). */
    static List<Ziel> erzeugeFeld(Random rng) {
        List<Ziel> feld = new ArrayList<>();
        int n = 4 + rng.nextInt(3);
        boolean phantomDrin = rng.nextDouble() < 0.35;
        int phantomIdx = phantomDrin ? rng.nextInt(n) : -1;
        for (int i = 0; i < n; i++) {
            boolean istKoenig = (i == 0);
            double hp = 0.1 + 0.9 * rng.nextDouble();
            double bedrohung = rng.nextDouble();
            double distanz = 1 + 49 * rng.nextDouble();
            double schritt = 0.5 + 2.0 * rng.nextDouble();         // normal: <= 2.5
            if (i == phantomIdx) schritt = 3.0 + 600 * rng.nextDouble(); // Phantom 2.0
            feld.add(new Ziel(i, istKoenig, hp, bedrohung, distanz, schritt));
        }
        return feld;
    }

    // ================= ORAKEL (Ground Truth) =================
    /** Doktrin aus 5 echten Schlachten: Drohwert x Machbarkeit, niemals blinder Fokus. */
    static int orakel(List<Ziel> feld) {
        int best = -1;
        double bestScore = -1;
        for (int i = 0; i < feld.size(); i++) {
            Ziel z = feld.get(i);
            if (z.schrittWeite() > MAX_SCHRITT) continue; // physikalisch unmoeglich
            double drohwert = (z.istKoenig() ? 2.0 : 1.0) * (z.bedrohung() + 0.2);
            double machbarkeit = 10.0 / (z.distanz() + 1.0);
            double ernteBonus = z.hp() < 0.35 ? 1.3 : 1.0; // Fast-Tote ernten (Effizienz)
            double score = drohwert * machbarkeit * ernteBonus;
            if (score > bestScore) { bestScore = score; best = i; }
        }
        return best;
    }

    // ================= FEATURE-EXTRAKTION =================
    /** CNN-Lektion: Abstraktion (weniger Information) kann GENAUER machen. */
    static double[] features(Ziel z) {
        return new double[]{
            z.istKoenig() ? 1.0 : 0.0,   // f0: Siegbedingung
            z.bedrohung(),               // f1: Drohwert
            5.0 / (z.distanz() + 1.0),   // f2: Naehe (Machbarkeit)
            1.0 - z.hp(),                // f3: Verwundbarkeit
            1.0                          // f4: Bias
        };
    }

    // ================= KNN-LITE =================
    static double[] knnProbs(List<Ziel> feld) {
        double[] scores = new double[feld.size()];
        for (int i = 0; i < feld.size(); i++) {
            double[] f = features(feld.get(i));
            double s = 0;
            for (int k = 0; k < f.length; k++) s += gewichte[k] * f[k];
            scores[i] = s;
        }
        return softmax(scores);
    }

    static double[] softmax(double[] scores) {
        double max = Double.NEGATIVE_INFINITY;
        for (double s : scores) max = Math.max(max, s);
        double sum = 0;
        double[] p = new double[scores.length];
        for (int i = 0; i < scores.length; i++) { p[i] = Math.exp(scores[i] - max); sum += p[i]; }
        for (int i = 0; i < p.length; i++) p[i] /= sum;
        return p;
    }

    /**
     * Softmax-Cross-Entropy-Update = der mathematische Zwilling des dopaminergen
     * Reward-Prediction-Error: Erwartung minus Realitaet, mal Reizstaerke.
     */
    static void knnLerne(List<Ziel> feld, int orakelIdx) {
        double[] p = knnProbs(feld);
        for (int i = 0; i < feld.size(); i++) {
            double[] f = features(feld.get(i));
            double y = (i == orakelIdx) ? 1.0 : 0.0;
            for (int k = 0; k < gewichte.length; k++) {
                gewichte[k] += LR * (y - p[i]) * f[k];
            }
        }
    }

    // ================= MENSCH SYSTEM 1 =================
    /**
     * Evolutiv geformte Heuristik: keine Softmax, sondern Prioritaeten.
     * Staerken: körperliche Priors (Teleport ist unmoeglich -> Phantom ignoriert),
     * Koenigsjagd-Instinkt ab Distanz < 12.
     * Schwaeche: Naehe-Instinkt (Koloss-Lektion) + feste 70% Konfidenz (Uebermut).
     */
    static double[] menschProbs(List<Ziel> feld) {
        int wahl = -1;
        // Prioritaet 1: Koenigsjagd, wenn nah genug (emotional verankert)
        for (int i = 0; i < feld.size(); i++) {
            Ziel z = feld.get(i);
            if (z.istKoenig() && z.schrittWeite() <= MAX_SCHRITT && z.distanz() < 12) { wahl = i; break; }
        }
        // Prioritaet 2: naechster Feind (Naehe-Instinkt, systematisch verzerrt)
        if (wahl < 0) {
            double beste = Double.MAX_VALUE;
            for (int i = 0; i < feld.size(); i++) {
                Ziel z = feld.get(i);
                if (z.schrittWeite() > MAX_SCHRITT) continue; // Prior: Physik vor Statistik
                if (z.distanz() < beste) { beste = z.distanz(); wahl = i; }
            }
        }
        // Verteilung: 70% auf die Wahl, Rest gleichmaessig (Ueberkonfidenz)
        double[] p = new double[feld.size()];
        int rest = 0;
        for (int i = 0; i < feld.size(); i++) {
            if (i != wahl && feld.get(i).schrittWeite() <= MAX_SCHRITT) rest++;
        }
        double restMasse = rest > 0 ? (1.0 - MENSCH_KONFIDENZ) / rest : 0;
        for (int i = 0; i < feld.size(); i++) {
            if (i == wahl) p[i] = MENSCH_KONFIDENZ;
            else if (feld.get(i).schrittWeite() <= MAX_SCHRITT) p[i] = restMasse;
            else p[i] = 0; // Phantom: Evolution sagt "unmoeglich"
        }
        return p;
    }

    // ================= HYBRIDE KI =================
    /**
     * Fraunhofer-Prinzip: Daten + Expertenwissen = robuster als jedes allein.
     * Schritt 1: PriorWaechter maskiert das Phantom (nicht verbieten: ueberbieten -
     *            die Wahrscheinlichkeit wird umverteilt, nicht geloescht).
     * Schritt 2: Konfidenz-Tor. Unter 45% Sicherheit gilt die Menschen-Regel.
     */
    static double[] hybridProbs(List<Ziel> feld) {
        double[] p = knnProbs(feld);
        double sum = 0;
        for (int i = 0; i < feld.size(); i++) {
            if (feld.get(i).schrittWeite() > MAX_SCHRITT) p[i] = 0; // PriorWaechter
            sum += p[i];
        }
        if (sum > 0) for (int i = 0; i < p.length; i++) p[i] /= sum;
        int wahl = argmax(p);
        if (p[wahl] < KONFIDENZ_TOR) {
            return menschProbs(feld); // Menschen-Regel uebernimmt (Hybrid-Rueckfallebene)
        }
        return p;
    }

    // ================= OKKLUSION (Black-Box-Bruecke) =================
    /** Verdeckt Merkmal k in ALLEN Zielen und misst, wie stark die Wahl wackelt. */
    static double okklusionsDelta(List<Ziel> feld, int k, int wahlBasis) {
        double[] p = knnProbs(feld);
        double[] pOhne = knnProbsMaskiert(feld, k);
        double delta = Math.abs(p[wahlBasis] - pOhne[wahlBasis]);
        int wahlOhne = argmax(pOhne);
        if (wahlOhne != wahlBasis) delta += 0.5; // Kipp = starke Wirkung
        return delta;
    }

    static double[] knnProbsMaskiert(List<Ziel> feld, int k) {
        double[] scores = new double[feld.size()];
        for (int i = 0; i < feld.size(); i++) {
            double[] f = features(feld.get(i));
            f[k] = 0; // Okklusion: Merkmal verdecken
            double s = 0;
            for (int j = 0; j < f.length; j++) s += gewichte[j] * f[j];
            scores[i] = s;
        }
        return softmax(scores);
    }

    // ================= METRIKEN =================
    /** Multi-Klassen-Brier: Summe (p_i - y_i)^2. Niedriger = besser kalibriert. */
    static double brier(double[] p, int orakel) {
        double sum = 0;
        for (int i = 0; i < p.length; i++) {
            double y = (i == orakel) ? 1.0 : 0.0;
            double d = p[i] - y;
            sum += d * d;
        }
        return sum;
    }

    static int argmax(double[] a) {
        int b = 0;
        for (int i = 1; i < a.length; i++) if (a[i] > a[b]) b = i;
        return b;
    }
}

