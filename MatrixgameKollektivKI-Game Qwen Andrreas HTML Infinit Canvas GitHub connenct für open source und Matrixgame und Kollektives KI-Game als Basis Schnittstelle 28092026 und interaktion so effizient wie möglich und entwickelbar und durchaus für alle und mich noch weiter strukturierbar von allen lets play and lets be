    <script>
        const canvas = document.getElementById('infinityCanvas');
        const ctx = canvas.getContext('2d');

        let camera = { x: 0, y: 0, zoom: 1 };
        let nodes = [];
        let isDragging = false;
        let lastMouse = { x: 0, y: 0 };
        let selectedNodeType = 'AI';
        let mousePlacementMode = false;
        
        let playerId = 'player_' + Math.random().toString(36).substr(2, 9);
        let playerName = 'Spieler_' + playerId.substr(-4);

        const NODE_TYPES = {
            'AI': { color: '#00d2ff', icon: '🤖' },
            'PHYSICS': { color: '#ff6b6b', icon: '⚛️' },
            'BIO': { color: '#51cf66', icon: '🧬' },
            'SYM': { color: '#cc5de8', icon: '💜' },
            'STORY': { color: '#ffd43b', icon: '' },
            'META': { color: '#868e96', icon: '' }
        };

        function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resize);
        resize();

        document.querySelectorAll('.node-type-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.node-type-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                selectedNodeType = btn.dataset.type;
            });
        });

        function addInitialNodes() {
            nodes.push(createNode(0, 0, "ZENTRUM", "META"));
            nodes.push(createNode(300, -200, "KI-Agent 1", "AI"));
            nodes.push(createNode(-300, 200, "Symbiose", "SYM"));
        }
        addInitialNodes();

        function togglePanel(panelId) {
            const panel = document.getElementById(panelId);
            panel.classList.toggle('collapsed');
            const btn = panel.querySelector('.toggle-btn');
            btn.textContent = panel.classList.contains('collapsed') ? '+' : '−';
        }

        document.querySelectorAll('.panel-header').forEach(header => {
            let isDraggingPanel = false;
            let startX, startY, initialX, initialY;
            
            header.addEventListener('mousedown', (e) => {
                if (e.target.classList.contains('toggle-btn')) return;
                isDraggingPanel = true;
                const panel = header.parentElement;
                startX = e.clientX;
                startY = e.clientY;
                initialX = panel.offsetLeft;
                initialY = panel.offsetTop;
            });
            
            document.addEventListener('mousemove', (e) => {
                if (!isDraggingPanel) return;
                const panel = header.parentElement;
                const dx = e.clientX - startX;
                const dy = e.clientY - startY;
                panel.style.left = (initialX + dx) + 'px';
                panel.style.top = (initialY + dy) + 'px';
                if (panel.id === 'chat-panel' || panel.id === 'players-panel') {
                    panel.style.transform = 'none';
                }
            });
            
            document.addEventListener('mouseup', () => { isDraggingPanel = false; });
        });

        function createNode(x, y, label, type) {
            const typeInfo = NODE_TYPES[type];
            return {
                id: 'node_' + Math.random().toString(36).substr(2, 9),
                x: x, y: y,
                label: label,
                type: type,
                color: typeInfo.color,
                icon: typeInfo.icon,
                radius: 15,
                creator: playerId,
                creatorName: playerName,
                timestamp: Date.now(),
                synced: false
            };
        }

        function addNodeAtCenter() {
            const name = document.getElementById('node-name').value || "Node";
            const node = createNode(0, 0, name, selectedNodeType);
            nodes.push(node);
            updateUI();
            addSystemMessage(`✅ Node "${name}" erstellt`);
        }

        function enableMousePlacement() {
            mousePlacementMode = true;
            canvas.style.cursor = 'crosshair';
            addSystemMessage('📍 Klicke irgendwo auf das Canvas, um einen Node zu platzieren');
        }

        function sendChatMessage() {
            const input = document.getElementById('chat-input');
            const text = input.value.trim();
            if (!text) return;
            addChatMessage(playerName, text, Date.now(), true);
            input.value = '';
        }

        function addChatMessage(name, text, timestamp, isMe) {
            const container = document.getElementById('chat-messages');
            const time = new Date(timestamp).toLocaleTimeString('de-DE', {hour: '2-digit', minute:'2-digit'});
            const msgDiv = document.createElement('div');
            msgDiv.className = 'chat-message';
            if (isMe) msgDiv.style.borderLeftColor = '#00ff88';
            msgDiv.innerHTML = `<strong>${isMe ? '👉 ' : ''}${name}</strong> <span style="color: #888; font-size: 9px;">${time}</span><br>${text}`;
            container.appendChild(msgDiv);
            container.scrollTop = container.scrollHeight;
        }

        function addSystemMessage(text) {
            const container = document.getElementById('chat-messages');
            const msgDiv = document.createElement('div');
            msgDiv.className = 'chat-message system';
            msgDiv.innerHTML = text;
            container.appendChild(msgDiv);
            container.scrollTop = container.scrollHeight;
        }

        function screenToWorld(sx, sy) {
            return { x: (sx - camera.x) / camera.zoom, y: (sy - camera.y) / camera.zoom };
        }

        function worldToScreen(wx, wy) {
            return { x: wx * camera.zoom + camera.x, y: wy * camera.zoom + camera.y };
        }

        function drawGrid() {
            const width = canvas.width;
            const height = canvas.height;
            const gridSize = 100 * camera.zoom;

            ctx.strokeStyle = 'rgba(255, 255, 255, 0.03)';
            ctx.lineWidth = 1;
            ctx.beginPath();

            const offsetX = camera.x % gridSize;
            const offsetY = camera.y % gridSize;

            for (let x = offsetX; x < width; x += gridSize) {
                ctx.moveTo(x, 0); ctx.lineTo(x, height);
            }
            for (let y = offsetY; y < height; y += gridSize) {
                ctx.moveTo(0, y); ctx.lineTo(width, y);
            }
            ctx.stroke();

            ctx.strokeStyle = 'rgba(0, 210, 255, 0.1)';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(camera.x, 0); ctx.lineTo(camera.x, height);
            ctx.moveTo(0, camera.y); ctx.lineTo(width, camera.y);
            ctx.stroke();
        }

        function drawNodes() {
            nodes.filter(n => n.creator !== playerId).forEach(node => drawNode(node, true));
            nodes.filter(n => n.creator === playerId).forEach(node => drawNode(node, false));
        }

        function drawNode(node, isRemote) {
            const screenPos = worldToScreen(node.x, node.y);
            const r = node.radius * camera.zoom;

            if (isRemote) {
                ctx.beginPath();
                ctx.arc(screenPos.x, screenPos.y, r * 1.5, 0, Math.PI * 2);
                ctx.fillStyle = node.color + '20';
                ctx.fill();
            }

            ctx.beginPath();
            ctx.arc(screenPos.x, screenPos.y, r, 0, Math.PI * 2);
            ctx.fillStyle = node.color;
            ctx.fill();
            
            ctx.strokeStyle = isRemote ? '#ff6b6b' : '#00ff88';
            ctx.lineWidth = isRemote ? 2 : 3;
            ctx.stroke();

            ctx.font = `${Math.max(12, 16 * camera.zoom)}px Arial`;
            ctx.textAlign = 'center';
            ctx.fillText(node.icon, screenPos.x, screenPos.y + 5);

            ctx.fillStyle = '#fff';
            ctx.font = `bold ${Math.max(10, 14 * camera.zoom)}px Arial`;
            ctx.fillText(node.label, screenPos.x, screenPos.y + r + (20 * camera.zoom));
            
            if (isRemote && camera.zoom > 0.5) {
                ctx.fillStyle = '#ff6b6b';
                ctx.font = `${Math.max(9, 11 * camera.zoom)}px Arial`;
                ctx.fillText(`@${node.creatorName}`, screenPos.x, screenPos.y + r + (32 * camera.zoom));
            }
        }

        function render() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            drawGrid();
            drawNodes();
            updateUI();
            requestAnimationFrame(render);
        }

        function updateUI() {
            document.getElementById('zoom-val').innerText = camera.zoom.toFixed(2);
            const centerWorld = screenToWorld(canvas.width / 2, canvas.height / 2);
            document.getElementById('pos-x').innerText = centerWorld.x.toFixed(0);
            document.getElementById('pos-y').innerText = centerWorld.y.toFixed(0);
            
            const localCount = nodes.filter(n => n.creator === playerId).length;
            const globalCount = nodes.filter(n => n.creator !== playerId).length;
            document.getElementById('local-node-count').innerText = localCount;
            document.getElementById('global-node-count').innerText = globalCount;
        }

        canvas.addEventListener('mousedown', e => {
            if (e.button === 0) {
                if (mousePlacementMode) {
                    const worldPos = screenToWorld(e.clientX, e.clientY);
                    const name = document.getElementById('node-name').value || "Node";
                    const node = createNode(worldPos.x, worldPos.y, name, selectedNodeType);
                    nodes.push(node);
                    mousePlacementMode = false;
                    canvas.style.cursor = 'crosshair';
                    updateUI();
                    addSystemMessage(`✅ Node "${name}" platziert`);
                } else {
                    isDragging = true;
                    lastMouse = { x: e.clientX, y: e.clientY };
                }
            } else if (e.button === 2) {
                const worldPos = screenToWorld(e.clientX, e.clientY);
                const name = document.getElementById('node-name').value || "Node";
                const node = createNode(worldPos.x, worldPos.y, name, selectedNodeType);
                nodes.push(node);
                updateUI();
                addSystemMessage(`✅ Node "${name}" erstellt`);
            }
        });

        canvas.addEventListener('mousemove', e => {
            if (isDragging) {
                camera.x += e.clientX - lastMouse.x;
                camera.y += e.clientY - lastMouse.y;
                lastMouse = { x: e.clientX, y: e.clientY };
            }
        });

        canvas.addEventListener('mouseup', () => isDragging = false);
        canvas.addEventListener('mouseleave', () => isDragging = false);
        canvas.addEventListener('contextmenu', e => e.preventDefault());

        canvas.addEventListener('wheel', e => {
            e.preventDefault();
            const zoomSensitivity = 0.001;
            const delta = -e.deltaY * zoomSensitivity;
            const newZoom = Math.max(0.01, Math.min(100, camera.zoom * Math.exp(delta)));
            
            const mouseWorldBefore = screenToWorld(e.clientX, e.clientY);
            camera.zoom = newZoom;
            const mouseWorldAfter = screenToWorld(e.clientX, e.clientY);
            
            camera.x += (mouseWorldAfter.x - mouseWorldBefore.x) * camera.zoom;
            camera.y += (mouseWorldAfter.y - mouseWorldBefore.y) * camera.zoom;
        }, { passive: false });

        function saveToLocalStorage() {
            const data = { camera, nodes: nodes.filter(n => n.creator === playerId), version: '5.1' };
            localStorage.setItem('matrixgame_canvas_v5.1', JSON.stringify(data));
            addSystemMessage('✅ Lokal gespeichert (' + data.nodes.length + ' Nodes)');
        }

        function loadFromLocalStorage() {
            try {
                const data = localStorage.getItem('matrixgame_canvas_v5.1');
                if (data) {
                    const parsed = JSON.parse(data);
                    if (parsed.nodes && parsed.camera) {
                        const remoteNodes = nodes.filter(n => n.creator !== playerId);
                        nodes = [...parsed.nodes, ...remoteNodes];
                        camera = parsed.camera;
                        updateUI();
                        addSystemMessage('📂 Geladen (' + parsed.nodes.length + ' Nodes)');
                    }
                }
            } catch (e) {
                addSystemMessage(' Ladefehler: ' + e.message);
            }
        }

        function exportToJSON() {
            const data = {
                camera: camera,
                nodes: nodes.filter(n => n.creator === playerId),
                exportedAt: new Date().toISOString(),
                version: '5.1',
                playerInfo: {
                    id: playerId,
                    name: playerName,
                    exportDate: new Date().toLocaleString('de-DE')
                }
            };
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `matrixgame_${playerName}_${Date.now()}.json`;
            a.click();
            addSystemMessage('📤 Exportiert: ' + a.download);
            addSystemMessage('💡 Lade diese Datei auf GitHub hoch, damit andere sie importieren können!');
        }

        function importFromJSON(input) {
            const file = input.files[0];
            if (!file) return;
            
            const reader = new FileReader();
            reader.onload = (event) => {
                try {
                    const data = JSON.parse(event.target.result);
                    if (data.nodes && data.camera) {
                        const remoteNodes = nodes.filter(n => n.creator !== playerId);
                        nodes = [...data.nodes, ...remoteNodes];
                        camera = data.camera;
                        updateUI();
                        addSystemMessage('📥 Importiert: ' + data.nodes.length + ' Nodes');
                        
                        if (data.playerInfo) {
                            addSystemMessage('👤 Von: ' + data.playerInfo.name + ' (Exportiert: ' + data.playerInfo.exportDate + ')');
                        }
                        
                        // Spieler-Liste aktualisieren
                        updatePlayerList(data.playerInfo);
                    }
                } catch (err) {
                    addSystemMessage('❌ Importfehler: ' + err.message);
                }
            };
            reader.readAsText(file);
            input.value = '';
        }

        function updatePlayerList(playerInfo) {
            const container = document.getElementById('players-container');
            let html = `<div class="player-item me"><strong>👉 Du</strong><br><span style="font-size: 10px; color: #888;">Lokal | ${nodes.filter(n => n.creator === playerId).length} Nodes</span></div>`;
            
            if (playerInfo) {
                html += `<div class="player-item"><strong> ${playerInfo.name}</strong><br><span style="font-size: 10px; color: #888;">Importiert | ${nodes.filter(n => n.creator !== playerId).length} Nodes</span></div>`;
            }
            
            container.innerHTML = html;
            document.getElementById('player-count').textContent = playerInfo ? 2 : 1;
        }

        render();
        addSystemMessage(' Matrixgame Infinity Canvas v5.1 – GitHub Kollektiv Edition');
        addSystemMessage('📤 Exportiere deinen Canvas und teile ihn auf GitHub!');
    </script>
</body>
</html>
