        // Starte mit ein paar Rishonen
        kugeln.add(new Rishon(0, 0, 0, 'T'));
        kugeln.add(new Rishon(20, 0, 0, 'T'));
        kugeln.add(new Rishon(-20, 0, 0, 'V'));

        // MAUS-INTERAKTION FÜR SPIELER
        addMouseListener(new MouseAdapter() {
            public void mousePressed(MouseEvent e) {
                int weltX = (int) ((e.getX() - getWidth()/2.0) / zoom + kameraX);
                int weltY = (int) (-(e.getY() - getHeight()/2.0) / zoom + kameraY);
                
