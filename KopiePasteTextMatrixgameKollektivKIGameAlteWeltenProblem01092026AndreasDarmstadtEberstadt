import java.util.Map;

public class LuminiFalsificationEngine {

    // Die Basis-Dimensionen: [M]asse, [L]änge, [Z]eit
    enum Dimension { M, L, Z }

    // Eine physikalische Größe hat einen Wert und eine Dimension
    record Quantity(double value, Map<Dimension, Integer> dim) {
        public String dimString() {
            return String.format("[M^%d L^%d Z^%d]", 
                dim.getOrDefault(Dimension.M, 0),
                dim.getOrDefault(Dimension.L, 0),
                dim.getOrDefault(Dimension.Z, 0));
        }
    }

    // Vordefinierte SI-Basisgrößen
    static final Quantity MASS = new Quantity(10.0, Map.of(Dimension.M, 1));               // kg
    static final Quantity VELOCITY = new Quantity(5.0, Map.of(Dimension.L, 1, Dimension.Z, -1)); // m/s
    static final Quantity ACCELERATION = new Quantity(2.0, Map.of(Dimension.L, 1, Dimension.Z, -2)); // m/s²
    static final Quantity DISTANCE = new Quantity(100.0, Map.of(Dimension.L, 1));          // m
    static final Quantity TIME = new Quantity(10.0, Map.of(Dimension.Z, 1));               // s

    // Multiplikation von Größen (Werte multiplizieren, Dimensionen addieren)
    static Quantity multiply(Quantity a, Quantity b) {
        double val = a.value() * b.value();
        Map<Dimension, Integer> newDim = new java.util.HashMap<>();
        for (Dimension d : Dimension.values()) {
            newDim.put(d, a.dim().getOrDefault(d, 0) + b.dim().getOrDefault(d, 0));
        }
        return new Quantity(val, newDim);
    }

    // Division von Größen (Werte dividieren, Dimensionen subtrahieren)
    static Quantity divide(Quantity a, Quantity b) {
        double val = a.value() / b.value();
        Map<Dimension, Integer> newDim = new java.util.HashMap<>();
        for (Dimension d : Dimension.values()) {
            newDim.put(d, a.dim().getOrDefault(d, 0) - b.dim().getOrDefault(d, 0));
        }
        return new Quantity(val, newDim);
    }

    public static void main(String[] args) {
        System.out.println("--- LUMINI FALSIFIZIERUNGS-ENGINE GESTARTET ---\n");

        // TEST 1: Falsche Behauptung (Impuls vs Energie)
        // Behauptung: Energie = Masse * Geschwindigkeit (E = m * v)
