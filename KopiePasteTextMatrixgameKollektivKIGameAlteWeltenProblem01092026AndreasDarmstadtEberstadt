### 1. Die Prognose-Engine (Vorausberechnung der Zukunft)

Damit das System **prognosefähig** wird, fügen wir der `MasseKugel` eine Methode hinzu, die die Zukunft simuliert, *ohne* die echten Daten zu verändern. Das ist exakt das Prinzip, das in modernen Orbital-Simulatoren und Spielen wie *Kerbal Space Program* genutzt wird.

```java
package ordner1;
import java.awt.Color;
import java.awt.Graphics2D;
import java.util.List;

public class MasseKugel {
    // ... (vorherige Variablen wie x, y, z, vx, vy, vz, mass, ladung etc.) ...
    
    public boolean prognoseAktiv = true; // Schaltet die Vorhersage-Linie ein/aus
    public int prognoseSchritte = 100;   // Wie weit in die Zukunft schauen wir?

    // --- DIE PROGNOSE-ENGINE ---
    // Berechnet die zukünftige Bahn, ohne die echten Positionen zu ändern
    public void zeichnePrognose(Graphics2D g2, List<MasseKugel> alleTeilchen, double zoom, int offsetX, int offsetY) {
        if (!prognoseAktiv) return;

        // 1. Erstelle eine temporäre Kopie von uns selbst
        double tempX = this.x, tempY = this.y, tempZ = this.z;
        double tempVx = this.vx, tempVy = this.vy, tempVz = this.vz;
        double tempDt = 0.5; // Kleiner Zeitschritt für die Prognose

        g2.setColor(new Color(255, 255, 0, 150)); // Gelbe, halbtransparente Linie
        g2.setStroke(new java.awt.BasicStroke(1, java.awt.BasicStroke.CAP_BUTT, java.awt.BasicStroke.JOIN_BEVEL, 0, new float[]{5, 5}, 0));
        
        int letzterScreenX = weltZuScreenX(tempX, zoom, offsetX);
        int letzterScreenY = weltZuScreenY(tempY, zoom, offsetY);

        // 2. Simuliere die Zukunft Schritt für Schritt
        for (int i = 0; i < prognoseSchritte; i++) {
            double ax = 0, ay = 0, az = 0;

            // Berechne Kräfte von allen ANDEREN echten Teilchen auf unseren temporären Klon
            for (MasseKugel other : alleTeilchen) {
                if (other == this) continue;
                double dx = other.x - tempX;
                double dy = other.y - tempY;
                double dz = other.z - tempZ;
                double r2 = (dx*dx) + (dy*dy) + (dz*dz) + 10.0; // Softening
                double r = Math.sqrt(r2);
                
                // Gravitation + Coulomb (vereinfacht für Prognose)
                double kraft = (0.01 * this.mass * other.mass) / r2; 
                // Hier könnte man noch die Ladung hinzufügen
                
                ax += kraft * (dx / r) / this.mass;
                ay += kraft * (dy / r) / this.mass;
                az += kraft * (dz / r) / this.mass;
            }

            // Symplektischer Euler-Schritt für den Klon
            tempVx += ax * tempDt; tempVy += ay * tempDt; tempVz += az * tempDt;
            tempX += tempVx * tempDt; tempY += tempVy * tempDt; tempZ += tempVz * tempDt;

            // Zeichne Linie zum nächsten Punkt
            int screenX = weltZuScreenX(tempX, zoom, offsetX);
            int screenY = weltZuScreenY(tempY, zoom, offsetY);
            g2.drawLine(letzterScreenX, letzterScreenY, screenX, screenY);
            letzterScreenX = screenX;
            letzterScreenY = screenY;
        }
    }

    // Hilfsfunktionen für die Projektion (müssen in deiner Klasse existieren)
    private int weltZuScreenX(double wx, double zoom, int offset) { return (int)(offset + wx * zoom); }
    private int weltZuScreenY(double wy, double zoom, int offset) { return (int)(offset - wy * zoom); }
}
