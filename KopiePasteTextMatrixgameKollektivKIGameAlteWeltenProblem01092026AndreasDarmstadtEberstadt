        System.out.println("   Das beweist: Elektromagnetische Polarität ist die kinetische Energie der 3D-Orbital-Symmetrie!");
    }

    // --- PHYSIK-ENGINES ---

    private static double berechneNewtonscheGravitation(double m1, double m2, double r) {
        if (r == 0) return 0;
        return G_SIM * (m1 * m2) / (r * r);
    }

    /**
     * Berechnet das emergente Feld. 
     * Hier nutzen wir die Herleitung: Die 6 rotierenden Massen erzeugen durch ihre 
     * Geschwindigkeit (v = sqrt(G*M/r)) eine kinetische Energie, die als "effektive Masse" 
     * (E=mc^2 Äquivalent im Gravitationsfeld) wirkt und das 1/r^2 Feld moduliert.
     */
    private static double berechneEmergentesFeld(double mZentrum, double mOrbiter, double rOrbit, double rTest) {
        // Orbitalgeschwindigkeit der 6 Teilmassen
        double vOrbital = Math.sqrt((G_SIM * mZentrum) / rOrbit);
        
        // Kinetische Energie der 6 Teilmassen (E_kin = 6 * 0.5 * m * v^2)
        double eKinGesamt = 6 * 0.5 * mOrbiter * (vOrbital * vOrbital);
        
        // Äquivalente "Feld-Masse" aus kinetischer Energie (E = m * c^2 -> hier simuliert mit c_sim = 10)
        double cSim = 10.0; 
        double mFeldAequivalent = eKinGesamt / (cSim * cSim);
        
        // Das emergente Feld ist die Summe aus statischer Masse und der "Feld-Masse"
        // Multipliziert mit einem Symmetrie-Faktor (basierend auf der 6-fach Symmetrie)
        double symmetrieFaktor = 1.0 + (1.0 / Math.sqrt(6.0)); // Geometrischer Faktor der Hexagonalanordnung
        
        double effektiveMasse = (mZentrum + mFeldAequivalent) * symmetrieFaktor;
        
        return G_SIM * (effektiveMasse * mOrbiter) / (rTest * rTest);
    }
}
