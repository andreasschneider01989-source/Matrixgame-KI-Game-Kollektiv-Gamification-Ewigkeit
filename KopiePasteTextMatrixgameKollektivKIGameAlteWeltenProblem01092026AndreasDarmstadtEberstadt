                    kugeln.add(new Rishon(weltX, weltY, 0, 'V')); // V-Rishon
                }
            }
        });

        // SIMULATIONSTIMER
        simulationTimer = new Timer(50, e -> { // 20 FPS für flüssige Interaktion
            // 1. Update aller Kugeln (Bewegung)
            for (MasseKugel k : kugeln) {
                k.update();
