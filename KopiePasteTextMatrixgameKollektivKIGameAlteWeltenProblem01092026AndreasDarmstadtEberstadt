    private static final double M_ELEKTRON = 9.1093837139e-31;
    private static final double G_SIM = 100.0; // Simulierte Gravitationskonstante
    private static final double COULOMB_K = 8987551787.368; // Reale Coulomb-Konstante (zum Vergleich)

