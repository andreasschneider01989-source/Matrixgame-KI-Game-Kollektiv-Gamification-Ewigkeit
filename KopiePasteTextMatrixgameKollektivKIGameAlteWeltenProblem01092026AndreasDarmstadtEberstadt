package ordner1;

import java.awt.Color;
import java.util.ArrayList;
import java.util.List;

public class PhysikEngine {
    
    // === NATURKONSTANTEN (aus Formelsammlung) ===
    public static final double LICHTGESCHWINDIGKEIT = 299792458.0; // m/s
    public static final double GRAVITATIONS_KONSTANTE = 6.67430e-11; // m³/(kg·s²)
    public static final double PLANCK_KONSTANTE = 6.62607015e-34; // J·s
    public static final double BOLZMANN_KONSTANTE = 1.380649e-23; // J/K
    
    // === ENTROPIE-BERECHNUNG ===
    public double berechneEntropie(int mikrozustaende) {
        return BOLZMANN_KONSTANTE * Math.log(mikrozustaende);
    }
    
    // === NEWTONSCHE GRAVITATION ===
    public double berechneGravitationskraft(MasseKugel k1, MasseKugel k2, double abstand) {
        if (abstand <= 0) return 0;
        return GRAVITATIONS_KONSTANTE * (k1.mass * k2.mass) / (abstand * abstand);
    }
    
    // === COULOMB-KRAFT (für geladene Teilchen) ===
    public double berechneCoulombKraft(double ladung1, double ladung2, double abstand) {
        if (abstand <= 0) return 0;
        double coulombKonstante = 8.9875517862e9; // V·m/C
        return coulombKonstante * (ladung1 * ladung2) / (abstand * abstand);
    }
    
    // === ENERGIEERHALTUNG (Kinetisch + Potentiell) ===
    public double berechneGesamtEnergie(MasseKugel kugel, double potential) {
        double eKin = 0.5 * kugel.mass * (kugel.vx*kugel.vx + kugel.vy*kugel.vy + kugel.vz*kugel.vz);
        return eKin + potential;
    }
    
    // === INVERSE QUADRAT INTENSITÄT (3D-Raum-Beweis) ===
    public double berechneIntensitaet(double quelleStaerke, double abstand) {
        return quelleStaerke / (abstand * abstand);
    }
}

