     */
    private static void validateMassSymmetry() {
        System.out.println("1. VALIDIERUNG DER 3D-MASS-SYMMETRIE (Sechstel-Hypothese)");
        
        // Verwendung von BigDecimal für maximale Präzision
        BigDecimal mp = new BigDecimal(M_PROTON);
