    public void GravityGemini() {
        for (int i2 = 0; i2 < stepps; i2++) {
            int n = erschaffen.size();
            double[] ax = new double[n];
            double[] ay = new double[n];
            double[] az = new double[n];
            
            for (int i = 0; i < n; i++) {
                MasseKugel bi = erschaffen.get(i);
                ax[i] = ay[i] = az[i] = 0;
                
                if (!bi.movable) continue;
                
                for (int j = 0; j < n; j++) {
                    if (i == j) continue;
                    
                    MasseKugel bj = erschaffen.get(j);
                    double dx = bj.x - bi.x;
                    double dy = bj.y - bi.y;
                    double dz = bj.z - bi.z;
                    double r2 = dx * dx + dy * dy + dz * dz;
                    double r = Math.sqrt(r2);
                    
                    if (r == 0) continue;
                    
                    double a = G * bj.mass / r2;
                    ax[i] += a * dx / r;
                    ay[i] += a * dy / r;
                    az[i] += a * dz / r;
                }
            }
            
            for (int i = 0; i < n; i++) {
                MasseKugel b = erschaffen.get(i);
                if (b.movable) {
                    b.vx += ax[i];
                    b.vy += ay[i];
                    b.vz += az[i];
                }
            }
        }
        repaint();
    }

