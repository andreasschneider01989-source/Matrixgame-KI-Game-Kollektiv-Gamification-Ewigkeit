public record Kinematics(Point3D start, Point3D end, double timeSeconds) {
    public Point3D getVelocityVector() {
        if (timeSeconds <= 0) throw new IllegalArgumentException("FALSIFIZIERT: Zeit muss > 0 sein.");
        double vx = (end.x() - start.x()) / timeSeconds;
        double vy = (end.y() - start.y()) / timeSeconds;
        double vz = (end.z() - start.z()) / timeSeconds;
        return new Point3D(vx, vy, vz);
