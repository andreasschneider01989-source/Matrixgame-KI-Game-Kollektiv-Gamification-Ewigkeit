        for (int r = 20; r <= 100; r += 10) {
            // 1. Reine Gravitationskraft (statisch, ohne Rotation)
            double fGravStatisch = berechneNewtonscheGravitation(mZentrum, mOrbiter * 6, r);
            
            // 2. Effektive Kraft (mit Rotation der 6 Massen)
            // Durch die Rotation und die 3D-Symmetrie (6-fach) entsteht ein "Gravito-Magnetisches" Feld
