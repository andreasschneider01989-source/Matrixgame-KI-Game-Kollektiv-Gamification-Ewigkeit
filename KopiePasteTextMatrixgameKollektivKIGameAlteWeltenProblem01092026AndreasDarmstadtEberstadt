### 2. Die neue `TeilchenSystem.java` (6 rotierende Teilmassen)

```java
package ordner1;
import java.awt.Color;
import java.util.ArrayList;
import java.util.List;

public class TeilchenSystem {
    public List<Teilmasse> teilmassen;
    public double zentrumX, zentrumY, zentrumZ;
    public double vx, vy, vz;
    public int radius;
    public Color color;
    private double orbitalRadius;
    private double orbitalGeschwindigkeit;

    public TeilchenSystem(double x, double y, double z, double vx, double vy, double vz, int radius, Color color) {
        this.teilmassen = new ArrayList<>();
        this.zentrumX = x; this.zentrumY = y; this.zentrumZ = z;
        this.vx = vx; this.vy = vy; this.vz = vz;
        this.radius = radius;
        this.color = color;
        this.orbitalRadius = 30.0;
        
        initTeilmassen();
    }

    private void initTeilmassen() {
        double teilMasse = 10.0;
        double gesamtMasse = teilMasse * 6;
        
        // Orbitalgeschwindigkeit: v = sqrt(G * M / r)
        this.orbitalGeschwindigkeit = Math.sqrt((Teilmasse.G_SIM * gesamtMasse) / orbitalRadius);
        
        // 6 Teilmassen in hexagonaler Anordnung (3D)
        for (int i = 0; i < 6; i++) {
            double winkel = (2 * Math.PI / 6) * i;
            // 3D-Position: Rotation in der X-Y Ebene
            double px = zentrumX + Math.cos(winkel) * orbitalRadius;
            double py = zentrumY + Math.sin(winkel) * orbitalRadius;
            double pz = zentrumZ;
            
            // Tangentiale Geschwindigkeit (senkrecht zum Radius)
            double vvx = -Math.sin(winkel) * orbitalGeschwindigkeit;
            double vvy = Math.cos(winkel) * orbitalGeschwindigkeit;
            double vvz = 0;
            
            Teilmasse t = new Teilmasse(px, py, pz, vvx, vvy, vvz, teilMasse, 4, color);
            teilmassen.add(t);
        }
    }

    // Aktualisiert alle Teilmassen (einfache Euler-Integration)
    public void update(double dt) {
        // 1. Gravitation zwischen den Teilmassen berechnen
        for (int i = 0; i < teilmassen.size(); i++) {
            for (int j = 0; j < teilmassen.size(); j++) {
                if (i != j) {
                    Teilmasse t1 = teilmassen.get(i);
                    Teilmasse t2 = teilmassen.get(j);
                    
                    double dx = t2.x - t1.x;
                    double dy = t2.y - t1.y;
                    double dz = t2.z - t1.z;
                    double r2 = (dx * dx) + (dy * dy) + (dz * dz) + (Teilmasse.SOFTENING * Teilmasse.SOFTENING);
                    double r = Math.sqrt(r2);
                    
                    double kraft = (Teilmasse.G_SIM * t1.mass * t2.mass) / r2;
                    
                    // Beschleunigung = Kraft / Masse
                    double ax = kraft * (dx / r) / t1.mass;
                    double ay = kraft * (dy / r) / t1.mass;
                    double az = kraft * (dz / r) / t1.mass;
                    
                    t1.vx += ax * dt;
                    t1.vy += ay * dt;
                    t1.vz += az * dt;
                }
            }
        }
        
        // 2. Positionen aktualisieren
        for (Teilmasse t : teilmassen) {
            t.updatePosition(dt);
        }
        
        // 3. Zentrum neu berechnen (Schwerpunkt)
        zentrumX = 0; zentrumY = 0; zentrumZ = 0;
        for (Teilmasse t : teilmassen) {
            zentrumX += t.x; zentrumY += t.y; zentrumZ += t.z;
        }
        zentrumX /= teilmassen.size();
        zentrumY /= teilmassen.size();
        zentrumZ /= teilmassen.size();
        
        // 4. Gesamtsystem bewegen
        this.zentrumX += this.vx * dt;
        this.zentrumY += this.vy * dt;
        this.zentrumZ += this.vz * dt;
    }

    // Berechnet die effektive Kraft zwischen zwei TeilchenSystemen
    public double berechneKraftZu(TeilchenSystem anderes) {
        double kraftX = 0, kraftY = 0, kraftZ = 0;
        
        for (Teilmasse t1 : this.teilmassen) {
            for (Teilmasse t2 : anderes.teilmassen) {
                double dx = t2.x - t1.x;
                double dy = t2.y - t1.y;
                double dz = t2.z - t1.z;
                double r2 = (dx * dx) + (dy * dy) + (dz * dz) + (Teilmasse.SOFTENING * Teilmasse.SOFTENING);
                double r = Math.sqrt(r2);
                
                double kraft = (Teilmasse.G_SIM * t1.mass * t2.mass) / r2;
                
                kraftX += kraft * (dx / r);
                kraftY += kraft * (dy / r);
                kraftZ += kraft * (dz / r);
            }
        }
        
        return Math.sqrt(kraftX * kraftX + kraftY * kraftY + kraftZ * kraftZ);
    }
}
