package ordner1;
import java.awt.Color;

public class Rishon extends MasseKugel {
    public char typ; // 'T' oder 'V'
    public double ladung; // +1/3 oder 0
    public boolean istVerschmolzen = false;

    public Rishon(double x, double y, double z, char typ) {
        super(x, y, z, (Math.random()-0.5)*2, (Math.random()-0.5)*2, 0, 1.0, 4, 
              typ == 'T' ? Color.RED : Color.CYAN);
        this.typ = typ;
        this.ladung = typ == 'T' ? (1.0/3.0) : 0.0;
        this.entropieMoveAktiv = true; // Leichte Zufallsbewegung (Quantenfluktuation)
    }

    // Überschreibe updatePosition, um sanftere Bewegung zu haben
    @Override
    public void updatePosition(double timeStep) {
        // Dämpfung für stabilere Orbitale
        this.vx *= 0.99; 
        this.vy *= 0.99;
        super.updatePosition(timeStep);
    }
}
