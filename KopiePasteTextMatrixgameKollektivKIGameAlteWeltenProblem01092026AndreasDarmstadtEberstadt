                } else if (e.getKeyCode() == KeyEvent.VK_E) {
                    if (selectedKugel != null) {
                        selectedKugel.entropieMoveAktiv = !selectedKugel.entropieMoveAktiv;
                        updateInfoText();
                    }
                }
            }
        });

        // Entkopplung der Physik-Engine vom UI-Thread
        startSimulationLoop();
    }
    
    private void startSimulationLoop() {
        simulationThread = new Thread(() -> {
            while (running) {
                for (int i = 0; i < unitList.size(); i++) {
                    Unit k = unitList.get(i);
                    k.update();
                    int targetIndex = (int) (unitList.size() * Math.random());
                    k.randEntropie4(unitList.get(targetIndex));
