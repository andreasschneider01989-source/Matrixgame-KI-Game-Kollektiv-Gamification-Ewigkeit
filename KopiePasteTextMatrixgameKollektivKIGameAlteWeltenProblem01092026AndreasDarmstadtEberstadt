                          teilbarDurch8 ? "JA ✓" : "NEIN ✗", symmetrieZahl, symmetrieZahl / 8);
        System.out.printf("   Teilbar durch 27 (3^3 = 3D-Orbital-Symmetrie): %s -> %d / 27 = %d%n", 
                          teilbarDurch27 ? "JA ✓" : "NEIN ✗", symmetrieZahl, symmetrieZahl / 27);
        
        if (teilbarDurch8 && teilbarDurch27) {
            System.out.println("   >>> ERGEBNIS: Masse ist geometrisch im 3D-Raum gepackt! <<<");
