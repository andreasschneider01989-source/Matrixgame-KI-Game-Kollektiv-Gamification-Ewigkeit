### 2. Der Unit Editor (Rishon-Snap-Logik)

Im **Unit Editor** platzierst du fundamentale Einheiten. Wenn zwei Einheiten nah genug sind, verschmelzen sie. Das bildet die Basis für das **Modellieren von Materie**.

```java
package ordner1;
import java.util.ArrayList;
import java.util.List;

public class RishonEditor {
    
    // Snap-Radius: Wenn Teilchen näher als das sind, verschmelzen sie
    private static final double SNAP_RADIUS = 15.0; 

    /**
     * Prüft alle Teilchen auf Kollision/Verschmelzung (Unit Editor Logik)
     * @param teilchen Liste aller aktiven Teilchen im Canvas
     */
    public static void pruefeUndVerschmelzeRishonen(List<MasseKugel> teilchen) {
        List<MasseKugel> neueTeilchen = new ArrayList<>();
        List<Boolean> bereitsVerschmolzen = new ArrayList<>();
        
        for (int i = 0; i < teilchen.size(); i++) {
            bereitsVerschmolzen.add(false);
        }

        for (int i = 0; i < teilchen.size(); i++) {
            if (bereitsVerschmolzen.get(i)) continue;
            
            MasseKugel t1 = teilchen.get(i);
            MasseKugel verschmolzenMit = null;

            for (int j = i + 1; j < teilchen.size(); j++) {
                if (bereitsVerschmolzen.get(j)) continue;
                
                MasseKugel t2 = teilchen.get(j);
                double distanz = Math.sqrt(Math.pow(t1.x - t2.x, 2) + Math.pow(t1.y - t2.y, 2));

                if (distanz < SNAP_RADIUS) {
                    // VERSCHMELZUNG (Rishon-Regel: T + T + V = Up-Quark etc.)
                    t1.mass += t2.mass;
                    t1.ladung += t2.ladung; // Falls Ladung implementiert ist
                    t1.radius = (int) Math.sqrt(t1.radius * t1.radius + t2.radius * t2.radius); // Fläche addieren
                    
                    // Impulserhaltung (Schwerpunktgeschwindigkeit)
                    double gesamtMasse = t1.mass;
                    t1.vx = (t1.mass * t1.vx + t2.mass * t2.vx) / gesamtMasse;
                    t1.vy = (t1.mass * t1.vy + t2.mass * t2.vy) / gesamtMasse;
                    
                    verschmolzenMit = t2;
                    bereitsVerschmolzen.set(j, true);
                    break; // Ein Teilchen kann pro Schritt nur mit einem anderen verschmelzen
                }
            }
            
            if (verschmolzenMit != null) {
                // Optional: Visueller Effekt oder Sound hier auslösen
                System.out.println("Verschmelzung erkannt! Neue Masse: " + t1.mass);
            }
            neueTeilchen.add(t1);
        }
        
        // Liste im Canvas aktualisieren (nur die nicht-verschmolzenen + die neuen großen)
        teilchen.clear();
        for (int i = 0; i < neueTeilchen.size(); i++) {
            if (!bereitsVerschmolzen.get(i)) {
                teilchen.add(neueTeilchen.get(i));
            }
        }
    }
}
```

