```java
package ordner1;
import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.ArrayList;
import java.util.List;

public class InfiniteCanvasDemo extends JPanel {
    private List<TeilchenSystem> systeme;
    private double zoom = 5.0;
    private double kameraX = 0, kameraY = 0;
    private double dt = 0.01;
    private Timer simulationTimer;
    private boolean zeichneKraftVektoren = true;

    public InfiniteCanvasDemo() {
        setPreferredSize(new Dimension(1200, 900));
        setBackground(Color.BLACK);
        systeme = new ArrayList<>();
        
        // Erstelle zwei TeilchenSysteme (z.B. zwei "Elektronen")
        systeme.add(new TeilchenSystem(-100, 0, 0, 0, 0, 0, 25, Color.CYAN));
        systeme.add(new TeilchenSystem(100, 0, 0, 0, 0, 0, 25, Color.RED));
        
        setFocusable(true);
        addKeyListener(new KeyAdapter() {
            public void keyPressed(KeyEvent e) {
                if (e.getKeyCode() == KeyEvent.VK_ADD || e.getKeyCode() == KeyEvent.VK_EQUALS) {
                    dt = Math.max(0.001, dt * 0.8);
                } else if (e.getKeyCode() == KeyEvent.VK_MINUS || e.getKeyCode() == KeyEvent.VK_SUBTRACT) {
                    dt = Math.min(0.1, dt * 1.25);
                } else if (e.getKeyCode() == KeyEvent.VK_K) {
                    zeichneKraftVektoren = !zeichneKraftVektoren;
                }
            }
        });
        
        simulationTimer = new Timer(16, e -> {
            simulationSchritt();
            repaint();
        });
        simulationTimer.start();
    }

    private void simulationSchritt() {
        int subSteps = 5;
        double subDt = dt / subSteps;
        
        for (int s = 0; s < subSteps; s++) {
            for (TeilchenSystem sys : systeme) {
                sys.update(subDt);
            }
        }
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        
        // Zeichne Kraftvektoren zwischen den Systemen
        if (zeichneKraftVektoren && systeme.size() >= 2) {
            TeilchenSystem sys1 = systeme.get(0);
            TeilchenSystem sys2 = systeme.get(1);
            double kraft = sys1.berechneKraftZu(sys2);
            
            int x1 = weltZuScreenX(sys1.zentrumX);
            int y1 = weltZuScreenY(sys1.zentrumY);
            int x2 = weltZuScreenX(sys2.zentrumX);
            int y2 = weltZuScreenY(sys2.zentrumY);
            
            // Kraft als farbige Linie darstellen (rot = stark, grün = schwach)
            double maxKraft = 1000.0;
            double kraftNormiert = Math.min(kraft / maxKraft, 1.0);
            Color kraftFarbe = new Color((int)(kraftNormiert * 255), (int)((1 - kraftNormiert) * 255), 0);
            
            g2.setColor(kraftFarbe);
            g2.setStroke(new BasicStroke(3));
            g2.drawLine(x1, y1, x2, y2);
            
            // Kraftwert anzeigen
            g2.setColor(Color.WHITE);
            g2.setFont(new Font("Monospaced", Font.BOLD, 14));
            g2.drawString(String.format("Kraft: %.2f", kraft), (x1 + x2) / 2 - 50, (y1 + y2) / 2 - 20);
        }
        
        // Zeichne TeilchenSysteme
        for (TeilchenSystem sys : systeme) {
            // Zeichne Teilmassen mit 3D-Tiefeneffekt
            for (Teilmasse t : sys.teilmassen) {
                int tx = weltZuScreenX(t.x);
                int ty = weltZuScreenY(t.y);
                
                // Tiefeneffekt: Teilmassen mit höherem Z erscheinen kleiner/dunkler
                double tiefenSkalierung = 1.0 + (t.z * 0.01);
                int drawRadius = (int)(t.radius * tiefenSkalierung);
                if (drawRadius < 2) drawRadius = 2;
                
                // Farbe basierend auf Z-Position (Tiefe)
                Color tColor = t.color;
                if (t.z < 0) {
                    // Dunkler für weiter hinten
                    tColor = tColor.darker();
                }
                
                g2.setColor(tColor);
                g2.fillOval(tx - drawRadius, ty - drawRadius, drawRadius * 2, drawRadius * 2);
                
                // Geschwindigkeitsvektor zeichnen
                g2.setColor(Color.WHITE);
                g2.setStroke(new BasicStroke(1));
                g2.drawLine(tx, ty, 
                           tx + (int)(t.vx * zoom * 0.3), 
                           ty - (int)(t.vy * zoom * 0.3));
            }
            
            // Zeichne Zentrum als Kreis
            int cx = weltZuScreenX(sys.zentrumX);
            int cy = weltZuScreenY(sys.zentrumY);
            g2.setColor(sys.color);
            g2.setStroke(new BasicStroke(2));
            g2.drawOval(cx - sys.radius, cy - sys.radius, sys.radius * 2, sys.radius * 2);
        }
        
        // Info-Text
        g2.setColor(Color.WHITE);
        g2.setFont(new Font("Monospaced", Font.PLAIN, 12));
        g2.drawString("DT: " + String.format("%.4f", dt), 20, 30);
        g2.drawString("K: Kraftvektoren ein/aus", 20, 50);
        g2.drawString("+/-: Zeitschritt anpassen", 20, 70);
        g2.drawString("Maus: Ziehen zum Verschieben, Mausrad zum Zoomen", 20, 90);
    }
    
    // 3D-zu-2D Projektion (einfach: ignoriere Z für Position, nutze Z für Größe)
    private int weltZuScreenX(double weltX) { 
        return (int)(getWidth() / 2.0 + (weltX - kameraX) * zoom); 
    }
    private int weltZuScreenY(double weltY) { 
        return (int)(getHeight() / 2.0 - (weltY - kameraY) * zoom); 
    }
    
    // Maus-Listener für Kamera-Steuerung
    private boolean isDragging = false;
