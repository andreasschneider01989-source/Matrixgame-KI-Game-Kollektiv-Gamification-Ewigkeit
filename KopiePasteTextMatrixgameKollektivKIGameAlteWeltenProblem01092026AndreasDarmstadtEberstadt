    public MatrixParticle(String id, double mass, Vector3D position, Vector3D velocity) {
        this.id = id;
        this.mass = mass;
        this.position = position;
        this.velocity = velocity;
        this.force = new Vector3D(0, 0, 0);
        this.annotations = new ArrayList<>();
    }

    public void addAnnotation(PALAnnotation pal) {
        this.annotations.add(pal);
    }

    public void applyForce(Vector3D f) {
        this.force = this.force.add(f);
    }

    // Berechnet Vektoren neu basierend auf F = m * a -> a = F / m
    public void update(double dt) {
        if (mass <= 0) return; 
        
        Vector3D acceleration = force.scale(1.0 / mass);
        velocity = velocity.add(acceleration.scale(dt));
        position = position.add(velocity.scale(dt));
        
        // Reset Force für den nächsten Frame
        force = new Vector3D(0, 0, 0);
    }

    public Vector3D getPosition() { return position; }
    public double getMass() { return mass; }
}

// Das Simulations-Framework (Das "Spielbrett")
class SimulationSpace {
    private List<MatrixParticle> particles;
    private double dt; // Kausalketten-Skalenniveau

    public SimulationSpace(double dt) {
        this.particles = new ArrayList<>();
        this.dt = dt;
    }

    public void addParticle(MatrixParticle p) {
        particles.add(p);
    }

    // Führt einen Zeitschritt der Kausalkette aus
    public void updateKausalkette() {
        calculateGravityForces();
        
        // Kinetische Updates
        for (MatrixParticle p : particles) {
            p.update(dt);
        }
    }

    // Inverse-Quadrat-Gesetz Implementierung
    private void calculateGravityForces() {
        for (int i = 0; i < particles.size(); i++) {
            for (int j = i + 1; j < particles.size(); j++) {
                MatrixParticle p1 = particles.get(i);
                MatrixParticle p2 = particles.get(j);

                Vector3D diff = p2.getPosition().subtract(p1.getPosition());
                double dist = diff.magnitude();

                if (dist > 1e-15) { // Vermeidung von Singularitäten (Planck-Längen-Limit Näherung)
                    double fMag = PhysicsConstants.G * ((p1.getMass() * p2.getMass()) / (dist * dist));
                    Vector3D forceDir = diff.normalize().scale(fMag);
                    
                    p1.applyForce(forceDir);
                    p2.applyForce(forceDir.scale(-1)); // Actio = Reactio
                }
            }
        }
    }
}

