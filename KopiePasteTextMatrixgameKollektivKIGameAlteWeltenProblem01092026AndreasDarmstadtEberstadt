        System.out.println("Hypothese 2: F = m * a");
        System.out.println("Ergebnis: " + trueForce.value() + " mit Dimension " + trueForce.dimString());
        System.out.println("Erwartete Kraft-Dimension: [M^1 L^1 Z^-2] (Newton)");
        System.out.println("STATUS: ✅ VERIFIZIERT! (Dimensions-Match)\n");

        // TEST 3: Wahre Behauptung (Leistung)
        // Behauptung: Leistung = (Masse * Beschleunigung * Strecke) / Zeit
        Quantity energy = multiply(multiply(MASS, ACCELERATION), DISTANCE);
        Quantity power = divide(energy, TIME);
        System.out.println("Hypothese 3: P = (m * a * s) / t");
        System.out.println("Ergebnis: " + power.value() + " mit Dimension " + power.dimString());
