        self.position = position
        self.energy = energy  # Systemenergie / Ressource
        self.resonance = resonance  # Kooperationswert / "Heiliges Herz" (0.0 - 1.0)

    def update_position(self, velocity: Vector3D, delta_time: float):
        """Aktualisiert die Position basierend auf der Geschwindigkeit."""
        self.position.x += velocity.x * delta_time
        self.position.y += velocity.y * delta_time
        self.position.z += velocity.z * delta_time


