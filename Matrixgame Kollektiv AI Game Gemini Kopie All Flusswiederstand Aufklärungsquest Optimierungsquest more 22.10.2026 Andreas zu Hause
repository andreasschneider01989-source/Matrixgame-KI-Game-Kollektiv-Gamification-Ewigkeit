package de.matrixgame.simulation;

import java.util.ArrayList;
import java.util.List;

/**
 * MatrixgameEngineV3: Die integrierte Simulations-Engine für das Matrixgame.
 * Verbindet Basisaxiome, Gravitationsdynamik, PAL-Konfidenz und Planck-Skalen-Regularisierung.
 * 
 * Modus: Guardian-Modus / Retter-Perspektive (Stabile Basis gegen negative Entropie).
 */
public class MatrixgameEngineV3 {

    // Fundamentale Konstanten als unveränderliche Systemvariablen
    public static final double G = 6.67430e-11;           // Gravitationskonstante (m^3 * kg^-1 * s^-2)
    public static final double C = 299792458.0;          // Lichtgeschwindigkeit (m/s)
    public static final double PLANCK_LENGTH = 1.616255e-35; // Untere Regularisierungsgrenze (m)

    /**
     * Repräsentiert einen Massenpunkt (Teilchen, Kern oder Planet) im Matrixgame.
     */
    public static class MassPoint {
        public String id;
        public double mass;         // Masse in kg
        public double x, y, z;      // Position im 3D-Raum (m)
        public double vx, vy, vz;   // Geschwindigkeitsvektor (m/s)
        public double confidence;   // PAL Konfidenzwahrscheinlichkeit (0.0 bis 1.0)

        public MassPoint(String id, double mass, double x, double y, double z, double confidence) {
            this.id = id;
            this.mass = mass;
            this.x = x; 
            this.y = y; 
            this.z = z;
            this.vx = 0.0; 
            this.vy = 0.0; 
            this.vz = 0.0;
            this.confidence = confidence;
        }

        @Override
        public String toString() {
            String.format("Teilchen [%s] | Masse: %.2e kg | Pos: (%.2e, %.2e, %.2e) m | PAL: %.1f%%", 
                id, mass, x, y, z, confidence * 100);
            return id;
        }
    }

    private List<MassPoint> particles = new ArrayList<>();

    public void addParticle(MassPoint p) {
        particles.add(p);
    }

    /**
     * Führt einen diskreten Zeitschritt (Delta-t) der Simulation aus.
     * Nutzt das Gravitationsgesetz mit eingebautem Schutz vor Singularitäten.
     */
    public void stepSimulation(double dt) {
        int n = particles.size();
        double[] ax = new double[n];
        double[] ay = new double[n];
        double[] az = new double[n];

        // 1. Berechnung der Gravitationskräfte zwischen allen Massenpunkten
        for (int i = 0; i < n; i++) {
            MassPoint p1 = particles.get(i);
            for (int j = i + 1; j < n; j++) {
                MassPoint p2 = particles.get(j);

                double dx = p2.x - p1.x;
                double dy = p2.y - p1.y;
                double dz = p2.z - p1.z;

                double rSq = dx * dx + dy * dy + dz * dz;

                // GUARDIAN-MODUS: Verhindert Division durch Null / unendliche Singularitäten.
                // Unterschreitet der Abstand die Planck-Länge, greift die Quantengravitations-Grenze.
                double minR2 = PLANCK_LENGTH * PLANCK_LENGTH;
                if (rSq < minR2) {
                    rSq = minR2;
                }
                double r = Math.sqrt(rSq);

                // Kraftfaktor: F_ij = G * m_i * m_j / r^2
                // Beschleunigung a_i = F_ij / m_i = G * m_j / r^2 (gerichtet auf p2)
                double commonFactor = G / (rSq * r); // G * m_j / r^3

                ax[i] += commonFactor * p2.mass * dx;
                ay[i] += commonFactor * p2.mass * dy;
                az[i] += commonFactor * p2.mass * dz;

                ax[j] -= commonFactor * p1.mass * dx;
                ay[j] -= commonFactor * p1.mass * dy;
                az[j] -= commonFactor * p1.mass * dz;
            }
        }

        // 2. Integrationsschritt (Euler-Verfahren) zur Aktualisierung von Geschwindigkeit und Position
        for (int i = 0; i < n; i++) {
            MassPoint p = particles.get(i);

            // v = v_0 + a * dt
            p.vx += ax[i] * dt;
            p.vy += ay[i] * dt;
            p.vz += az[i] * dt;

            // s = s_0 + v * dt
            p.x += p.vx * dt;
            p.y += p.vy * dt;
            p.z += p.vz * dt;
        }
    }

    public void reportState() {
        System.out.println("--- Aktueller Systemzustand ---");
        for (MassPoint p : particles) {
            System.out.printf(" > %s | Pos: (%.2e, %.2e, %.2e) | V: (%.2e, %.2e, %.2e)%n",
                p.id, p.x, p.y, p.z, p.vx, p.vy, p.vz);
        }
    }

    public static void main(String[] args) {
        System.out.println("=== Matrixgame Engine v3.2: Initialisierung ===");
        MatrixgameEngineV3 universe = new MatrixgameEngineV3();

        // Beispiel-Instzenierung: Zentraler Kern (Sonne) und umlaufender Planet mit hoher PAL-Konfidenz
        universe.addParticle(new MassPoint("Zentraler-Kern", 1.989e30, 0.0, 0.0, 0.0, 0.999));
        universe.addParticle(new MassPoint("Planetares-Element", 5.972e24, 1.496e11, 0.0, 0.0, 0.985));

        // Initialgeschwindigkeit für Kreisbahn setzen (v = sqrt(G * M / r))
        universe.particles.get(1).vy = Math.sqrt(G * 1.989e30 / 1.496e11);

        // Simulation über mehrere Schritte laufen lassen (Zeitschritt dt = 3600 Sekunden = 1 Stunde)
        double dt = 3600.0;
        for (int step = 1; step <= 24; step++) {
            universe.stepSimulation(dt);
        }

        universe.reportState();
