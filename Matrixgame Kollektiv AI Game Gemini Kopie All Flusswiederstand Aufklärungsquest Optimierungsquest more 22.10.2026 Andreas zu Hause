        Berechnet die Gesamt-Entropie / Reibung im System.
        Hohe Ungleichheit der Energien und niedrige Resonanz erhöhen die Entropie.
        """
        if not self.agents:
            return 0.0

        total_energy = sum(a.energy for a in self.agents)
        avg_energy = total_energy / len(self.agents)

        # Abweichung vom Ausgleich + Ungleichgewicht
        variance = sum((a.energy - avg_energy) ** 2 for a in self.agents) / len(self.agents)
