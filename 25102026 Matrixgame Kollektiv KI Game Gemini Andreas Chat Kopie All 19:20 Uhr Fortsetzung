1. Die Chemische Reaktions-Engine (ChemicalReactionEngine.java)
Diese Klasse steuert die Stoff- und Energiewandlung im Simulator basierend auf dem Massenwirkungsgesetz und der Arrhenius-Gleichung für Aktivierungsenergien.

Java
package de.matrixgame.simulation.chemistry;

import java.util.HashMap;
import java.util.Map;

/**
 * Steuert chemische Reaktionskinetiken, Arrhenius-Gleichungen und Stoffumsätze 
 * gekoppelt an den globalen Entropie- und Energie-Pool des Matrixgame-Simulators.
 */
public class ChemicalReactionEngine {

    private double systemTemperature; // Gekoppelt an die Simulator-Entropie
    private final double gasConstantR = 8.314; // J/(mol*K)

    public ChemicalReactionEngine(double initialTemperature) {
        this.systemTemperature = initialTemperature;
    }

    /**
     * Berechnet die Geschwindigkeitskonstante k(T) nach der Arrhenius-Gleichung:
     * k = A * exp(-E_a / (R * T))
     */
    public double calculateRateConstant(double preExponentialFactor, double activationEnergy) {
        if (systemTemperature <= 0) return 0.0;
        return preExponentialFactor * Math.exp(-activationEnergy / (gasConstantR * systemTemperature));
    }

    /**
     * Berechnet die Reaktionsgeschwindigkeit v basierend auf Konzentrationen und stöchiometrischen Koeffizienten.
     */
    public double calculateReactionVelocity(double rateConstant, Map<String, Double> concentrations, Map<String, Integer> stoichiometry) {
        double velocity = rateConstant;
        for (Map.Entry<String, Integer> entry : stoichiometry.entrySet()) {
            String reactant = entry.getKey();
            int order = entry.getValue();
            double concentration = concentrations.getOrDefault(reactant, 0.0);
            velocity *= Math.pow(concentration, order);
        }
        return velocity;
    }

    /**
     * Aktualisiert die Systemtemperatur basierend auf freiwerdender Reaktionsenthalpie.
     */
    public void updateTemperature(double enthalpyChange, double heatCapacity) {
        this.systemTemperature += enthalpyChange / heatCapacity;
    }

    public double getSystemTemperature() {
        return systemTemperature;
    }

    public void setSystemTemperature(double systemTemperature) {
        this.systemTemperature = systemTemperature;
    }
}
2. Das Neuronale Entscheidungsmodul (NeuralDecisionModule.java)
Dieses Modul implementiert die adaptive Gewichtssteuerung und Aktivierungsfunktionen für taktische Einheiten-Entscheidungen im Spielfeld.

Java
package de.matrixgame.simulation.neural;

import java.util.Random;

/**
 * Implementiert neuronale Aktivierungsfunktionen und Gradientenabstieg-Anpassungen
 * für adaptive und lernfähige Einheiten-Entscheidungen im Matrixgame.
 */
public class NeuralDecisionModule {

    private double[] weights;
    private double bias;
    private double learningRate;
    private Random random;

    public NeuralDecisionModule(int inputSize, double learningRate) {
        this.weights = new double[inputSize];
        this.learningRate = learningRate;
        this.random = new Random();
        initializeWeights();
    }

    private void initializeWeights() {
        this.bias = random.nextGaussian() * 0.1;
        for (int i = 0; i < weights.length; i++) {
            weights[i] = random.nextGaussian() * Math.sqrt(2.0 / weights.length);
        }
    }

    /**
     * Sigmoid-Aktivierungsfunktion: sigma(z) = 1 / (1 + exp(-z))
     */
    public double activate(double z) {
        return 1.0 / (1.0 + Math.exp(-Math.max(-45.0, Math.min(45.0, z)))); // Numerische Stabilisierung
    }

    /**
     * Berechnet den Forward-Pass für einen gegebenen Input-Vektor.
     */
    public double forward(double[] inputs) {
        double z = bias;
        for (int i = 0; i < inputs.length; i++) {
            z += weights[i] * inputs[i];
        }
        return activate(z);
    }

    /**
     * Führt einen Optimierungsschritt via Gradientenabstieg durch (Backpropagation-Anteil).
     */
    public void trainStep(double[] inputs, double target, double output) {
        double error = target - output;
        // Ableitung der Sigmoid-Funktion: output * (1 - output)
        double gradient = error * output * (1.0 - output);

        for (int i = 0; i < weights.length; i++) {
            weights[i] += learningRate * gradient * inputs[i];
        }
        bias += learningRate * gradient;
    }

    public double[] getWeights() {
        return weights;
    }
}
