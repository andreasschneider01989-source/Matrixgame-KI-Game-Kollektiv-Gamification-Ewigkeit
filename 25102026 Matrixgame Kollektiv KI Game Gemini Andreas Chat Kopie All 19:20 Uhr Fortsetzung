package de.matrixgame.simulation.evolution;

import de.matrixgame.simulation.neural.NeuralDecisionModule;
import java.util.ArrayList;
import java.util.List;
import java.util.Random;

/**
 * Steuert die evolutionäre Entwicklung von Einheiten (Prokaryoten zu intelligenten Verbänden)
 * über Energie, Replikation, Mutation und neuronale Bewertung.
 */
public class EvolutionarySimulatorLoop {

    public static class SimUnit {
        double x, y;
        double energy;
        double mutationRate;
        NeuralDecisionModule brain;
        boolean isEukaryotic;

        public SimUnit(double x, double y, double energy, double mutationRate, int inputSize) {
            this.x = x;
            this.y = y;
            this.energy = energy;
            this.mutationRate = mutationRate;
            this.brain = new NeuralDecisionModule(inputSize, 0.05);
            this.isEukaryotic = false;
        }

        public void step(double globalEntropy, Random rand) {
            // Energieverbrauch durch Entropie und Aktivität
            this.energy -= (0.1 + globalEntropy * 0.01);
            // Zufällige Bewegung auf dem Canvas
            this.x += (rand.nextDouble() - 0.5) * 2.0;
            this.y += (rand.nextDouble() - 0.5) * 2.0;
        }

        public SimUnit replicate(Random rand) {
            this.energy *= 0.5; // Energie teilen
            double newMutation = Math.max(0.001, this.mutationRate + (rand.nextDouble() - 0.5) * 0.01);
            SimUnit offspring = new SimUnit(this.x + rand.nextDouble() * 2 - 1, 
                                            this.y + rand.nextDouble() * 2 - 1, 
                                            this.energy, newMutation, 2);
            offspring.isEukaryotic = this.isEukaryotic;
            return offspring;
        }
    }

    private List<SimUnit> population;
    private double globalEntropy;
    private Random random;

    public EvolutionarySimulatorLoop(int initialPopulationSize, double initialEntropy) {
        this.population = new ArrayList<>();
        this.globalEntropy = initialEntropy;
        this.random = new Random();
        
        for (int i = 0; i < initialPopulationSize; i++) {
            population.add(new SimUnit(random.nextDouble() * 100, random.nextDouble() * 100, 50.0, 0.05, 2));
        }
    }

    /**
     * Führt einen Evolutions-Tick aus: Metabolismus, Replikation, Selektion und Endosymbiose.
     */
    public void tick() {
        List<SimUnit> nextGeneration = new ArrayList<>();

        for (SimUnit unit : population) {
            unit.step(globalEntropy, random);

            // Sensorischer Input für das neuronale Netz: [Energie-Status, Entropie]
            double[] inputs = {unit.energy / 100.0, globalEntropy / 100.0};
            double actionDecision = unit.brain.forward(inputs);

            // Wenn genügend Energie vorhanden ist, replizieren (Mitose / Vermehrung)
            if (unit.energy > 80.0) {
                nextGeneration.add(unit.replicate(random));
            }

            // Selektion: Nur Einheiten mit Energie > 0 überleben
            if (unit.energy > 0.0) {
                nextGeneration.add(unit);
            }
        }

        this.population = nextGeneration;
    }

    public int getPopulationSize() {
        return population.size();
    }
}
