        double emotionalIntelligence = 0.5;
        double rationalScore = 0.6;
        double intuition = 0.4;
        double stress = 0.2;
        double motivation = 0.7;
        double rewardAccumulator = 0.0;

        // Evolution & Lernen
        double fitness = 1.0;
        double mutationFactor = 1.0;
        double neuralWeight1 = 0.5, neuralWeight2 = 0.5, neuralWeight3 = 0.5;
        double memoryStrength = 0.5;

        // Entscheidungs-Variablen (Input-Operation-Output)
        double lastUtility = 0.0;
        double predictedUtility = 0.0;
        double actionProbabilityFight = 0.25;
        double actionProbabilityCooperate = 0.35;
        double actionProbabilitySteal = 0.2;
        double actionProbabilityTech = 0.2;

        // Kollektives Bewusstsein / Warp
        double connectionStrength = 0.3;
        double receivedInspiration = 0.0;

        Unit(int id) {
            this.id = id;
            Random r = new Random(id * 42L);
            posX = (r.nextDouble() - 0.5) * 1000;
            posY = (r.nextDouble() - 0.5) * 1000;
            posZ = (r.nextDouble() - 0.5) * 100;
            mass = 0.5 + r.nextDouble() * 2.0;
            energy = 50 + r.nextDouble() * 100;
            happiness = 0.3 + r.nextDouble() * 0.5;
            aggression = r.nextDouble() * 0.6;
            cooperation = r.nextDouble() * 0.7;
            techLevel = 0.5 + r.nextDouble();
        }

        // Physikalische Kraft-Berechnung (vereinfacht Newton + 1/r²)
        void computeForce(Unit other) {
            double dx = other.posX - posX;
            double dy = other.posY - posY;
            double dz = other.posZ - posZ;
            double distSq = dx*dx + dy*dy + dz*dz + 1e-6; // Vermeidung Division durch 0
            double dist = Math.sqrt(distSq);
            double forceMag = G * mass * other.mass / distSq * 1e10; // Skalierung für Simulation
            forceX += forceMag * dx / dist;
            forceY += forceMag * dy / dist;
            forceZ += forceMag * dz / dist;
        }

        // MaxMax-Entscheidungsfindung (vereinfacht)
        // Jede Unit maximiert den eigenen erwarteten Nutzen unter der Annahme, dass andere dasselbe tun
        int decideAction(Unit[] all, Random rnd) {
            // Input: aktuelle Zustände
            double ownUtility = happiness * 0.3 + energy * 0.002 + resources * 0.01
                              + techLevel * 0.2 + socialBond * 0.15 - stress * 0.3;

            // Operation: MaxMax-Schätzung (andere maximieren ebenfalls)
            double fightUtil = ownUtility - aggression * 10 + (rnd.nextDouble() - 0.5) * randomSeedInfluence;
            double coopUtil  = ownUtility + cooperation * 15 + affirmationStrength * 5;
            double stealUtil = ownUtility + (1 - socialBond) * 8 - cooperation * 5;
            double techUtil  = ownUtility + techLevel * 10 + intelligence * 8;

            // Logische Gates (AND / OR / NOT)
            boolean canFight = (aggression > fightThreshold) && (energy > 20) && !(health < 30);
            boolean canCoop  = (cooperation > cooperateThreshold) || (socialBond > 0.6);
            boolean canSteal = (resources < 30) && !(cooperation > 0.7);
            boolean canTech  = (intelligence > 0.5) && (techLevel < 5.0);

            // Auswahl der maximalen Utility (MaxMax)
            double maxU = Double.NEGATIVE_INFINITY;
            int action = 0; // 0=idle, 1=fight, 2=coop, 3=steal, 4=tech
            if (canFight && fightUtil > maxU) { maxU = fightUtil; action = 1; }
            if (canCoop  && coopUtil  > maxU) { maxU = coopUtil;  action = 2; }
            if (canSteal && stealUtil > maxU) { maxU = stealUtil; action = 3; }
            if (canTech  && techUtil  > maxU) { maxU = techUtil;  action = 4; }

            predictedUtility = maxU;
            return action;
        }

        // Evolution / Mutation
        void evolve(Random rnd) {
            if (rnd.nextDouble() < evolutionMutationRate) {
                mutationFactor *= (0.9 + rnd.nextDouble() * 0.2);
                intelligence = Math.min(1.0, intelligence * mutationFactor);
                aggression   = Math.max(0, Math.min(1, aggression + (rnd.nextDouble()-0.5)*0.1));
                cooperation  = Math.max(0, Math.min(1, cooperation + (rnd.nextDouble()-0.5)*0.1));
                fitness = happiness * productivity * (1.0 - stress) * techLevel;
            }
        }

        // Positive Affirmation / Lumini-ähnlicher Boost
        void applyAffirmation() {
            happiness = Math.min(1.0, happiness + affirmationStrength * didacticFlow);
            stress = Math.max(0, stress - affirmationStrength * 0.5);
            motivation = Math.min(1.0, motivation + 0.1);
        }
    }

