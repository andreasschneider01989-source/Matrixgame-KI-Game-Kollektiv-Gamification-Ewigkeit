        double dy = andereUnit.positionY - this.positionY;
        double dz = andereUnit.positionZ - this.positionZ;
        double abstand = Math.sqrt(dx * dx + dy * dy + dz * dz);
        return G * (this.masse * andereUnit.masse) / (abstand * abstand);
    }

