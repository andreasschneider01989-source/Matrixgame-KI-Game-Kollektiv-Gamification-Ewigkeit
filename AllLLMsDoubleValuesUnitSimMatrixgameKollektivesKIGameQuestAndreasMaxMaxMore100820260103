    // ==================== UNIT-KLASSE (pro Unit >30 doubles möglich) ====================
    static class Unit {
        // Identifikation & Basis
        int id;
        double mass = 1.0;                      // kg (skaliert)
        double posX, posY, posZ;                // m
        double velX = 0, velY = 0, velZ = 0;    // m/s
        double forceX = 0, forceY = 0, forceZ = 0;

        // Energie & Ressourcen
        double energy = 100.0;
        double resources = 50.0;
        double health = 100.0;
        double techLevel = 1.0;

        // Psychologisch / neurologisch / sozial
        double happiness = 0.6;
        double productivity = 0.5;
        double intelligence = 0.6;
        double aggression = 0.3;
        double cooperation = 0.5;
