            double selfInterest = winDesire + attackPower + stealSkill + exploitation;
            double socialInterest = cooperation + diplomacy + trust + collectiveBenefit;

            double actionScoreAttack = selfInterest + aggression + combatSkill - fear - lossAversion;
            double actionScoreTrade = socialInterest + tradeSkill + openSourceAffinity + logicAnd;
            double actionScoreRest = survivalDrive + stability + logicNot - hunger * 0.01;
            double actionScoreExplore = curiosity + exploration + techLevel + decisionSignal;

            String action = maxAction(actionScoreAttack, actionScoreTrade, actionScoreRest, actionScoreExplore);

            if ("ATTACK".equals(action) && target != null && target != this) {
                double dmg = Math.max(0.0, attackPower + combatSkill - target.defensePower + rnd(-0.2, 0.2));
                target.health -= dmg;
                energy -= 2.0 + dmg * 0.2;
                tempStress += 0.05;
            } else if ("TRADE".equals(action) && target != null && target != this) {
                double gain = Math.max(0.0, tradeSkill + cooperation - 0.5);
                energy += gain * 0.5;
                target.energy += gain * 0.2;
                collectiveBenefit += gain;
                individualBenefit += gain * 0.7;
            } else if ("REST".equals(action)) {
                health += 0.2 * dt;
                energy += 0.5 * dt;
                stamina += 0.4 * dt;
                tempStress *= 0.95;
            } else {
                position += velocity * dt * (1.0 + mobility);
                velocity += rnd(-0.1, 0.1) * decisionSpeed;
                exploration += 0.01;
            }

            hunger += 0.3 * dt;
            thirst += 0.4 * dt;
            energy -= physicsNeed * 0.01 * dt;
            age += dt * 0.01;

            learnFromOutcome(action, target);
            evolve();
            clampAll();
            goalProgress = computeGoalProgress();
            evolutionScore = computeEvolutionScore();
            scenarioFit = evaluateScenarioFit();
            environmentFit = 0.5 * survivalDrive + 0.5 * adaptability;
        }

        Unit chooseTarget(List<Unit> others) {
            Unit best = null;
            double bestScore = -1e9;
            for (Unit u : others) {
                if (u == this) continue;
                double dist = Math.abs(u.position - position);
                double score = (1.0 / (1.0 + dist)) + u.mass * 0.01 + rnd(-0.05, 0.05);
                if (score > bestScore) {
                    bestScore = score;
                    best = u;
                }
            }
            return best;
        }

        void learnFromOutcome(String action, Unit target) {
            double reward = 0.0;
            if ("ATTACK".equals(action)) reward = 0.1 * attackPower + 0.05 * combatSkill;
            if ("TRADE".equals(action)) reward = 0.1 * tradeSkill + 0.05 * cooperation;
            if ("REST".equals(action)) reward = 0.1 * stability + 0.05 * survivalDrive;
            if ("EXPLORE".equals(action)) reward = 0.1 * curiosity + 0.05 * techLevel;

            learningRate += 0.001 * reward;
            neuralPlasticity += 0.0005 * reward;
            trust += ("TRADE".equals(action) ? 0.01 : -0.005);
        }

        void evolve() {
            double mut = mutationRate * rnd(-1.0, 1.0);
            intelligence += mut * 0.01;
            aggression += mut * 0.005;
            cooperation += mut * 0.005;
            creativity += mut * 0.01;
            techLevel += mut * 0.008;
        }

        double computeGoalProgress() {
            return clamp01((survivalDrive + cooperation + intelligence + techLevel) / 4.0);
        }

        double computeEvolutionScore() {
            return clamp01((intelligence + adaptability + creativity + neuralPlasticity + techLevel) / 5.0);
        }

        double evaluateScenarioFit() {
            return clamp01((environmentFit + collectiveBenefit + individualBenefit + stability) / 4.0);
