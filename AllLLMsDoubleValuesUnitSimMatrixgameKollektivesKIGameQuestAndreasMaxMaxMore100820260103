                double avgTech = Arrays.stream(units).mapToDouble(u -> u.techLevel).average().orElse(0);
                System.out.printf("t=%.1f | collHapp=%.3f | avgUnitHapp=%.3f | avgTech=%.2f | entropy=%.3f | biomass=%.2f%n",
                        currentTime, collectiveHappiness, avgHappiness, avgTech, totalEntropy, biomass);
            }
        }

