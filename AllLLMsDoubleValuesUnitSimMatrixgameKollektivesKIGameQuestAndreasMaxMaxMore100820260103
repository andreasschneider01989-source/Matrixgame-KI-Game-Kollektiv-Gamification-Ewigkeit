        System.out.println("=== Matrixgame Basic Unit Fight & Evolution Simulator ===");
        System.out.println("Units: " + NUM_UNITS + " | timeStep: " + timeStep);
        System.out.println("System-Doubles initialisiert (>30) + pro Unit viele weitere Doubles");
        System.out.println("MaxMax + Random + Evolution + Input-Operation-Output aktiv\n");

        // Simulations-Loop (Beispiel 20 Schritte)
        for (int step = 0; step < 20; step++) {
            currentTime += timeStep;

            // 1. Kräfte berechnen (physikalisch)
            for (Unit u : units) {
                u.forceX = u.forceY = u.forceZ = 0;
                for (Unit o : units) {
                    if (u != o) u.computeForce(o);
                }
            }

            // 2. Bewegung (Newton: a = F/m, v += a*dt, s += v*dt)
            for (Unit u : units) {
                double ax = u.forceX / u.mass;
                double ay = u.forceY / u.mass;
                double az = u.forceZ / u.mass;
                u.velX += ax * timeStep;
                u.velY += ay * timeStep;
                u.velZ += az * timeStep;
                u.posX += u.velX * timeStep;
                u.posY += u.velY * timeStep;
                u.posZ += u.velZ * timeStep;
            }

            // 3. Entscheidungen & Aktionen (MaxMax)
            for (Unit u : units) {
                int action = u.decideAction(units, rnd);

                // Output / Wirkung
                switch (action) {
                    case 1: // Fight
                        Unit target = units[rnd.nextInt(NUM_UNITS)];
                        if (target != u) {
                            double damage = u.aggression * 10 * (1 - target.techLevel * 0.1);
                            target.health -= damage;
                            u.energy -= 5;
                            u.rewardAccumulator -= punishmentScale * 2;
                            collectiveHappiness -= 0.002;
                        }
                        break;
                    case 2: // Cooperate
                        u.resources += 3;
                        u.socialBond = Math.min(1, u.socialBond + 0.05);
                        u.happiness += 0.03;
                        collectiveProductivity += 0.001;
                        u.rewardAccumulator += rewardScale * 3;
                        break;
                    case 3: // Steal
                        Unit victim = units[rnd.nextInt(NUM_UNITS)];
                        if (victim != u && victim.resources > 5) {
                            double stolen = Math.min(8, victim.resources * 0.2);
                            victim.resources -= stolen;
                            u.resources += stolen;
                            u.socialBond = Math.max(0, u.socialBond - 0.1);
                            u.rewardAccumulator += 1;
                            collectiveHappiness -= 0.001;
                        }
                        break;
                    case 4: // Tech Seek
                        u.techLevel += 0.05 * u.intelligence;
                        u.energy -= 3;
                        u.rewardAccumulator += rewardScale * 2;
                        break;
                }

                // Evolution & Affirmation
                u.evolve(rnd);
                if (rnd.nextDouble() < 0.3) u.applyAffirmation();

                // Guardian-Filter (logisch): entropie-senkende Signale bevorzugen
                if (u.happiness > happinessThreshold && u.stress < 0.4) {
                    u.receivedInspiration += 0.01 * (1 - warpResistance);
                    collectiveIntelligence += 0.0001;
                }
