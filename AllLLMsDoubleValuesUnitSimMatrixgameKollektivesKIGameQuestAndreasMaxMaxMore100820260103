# 16. Ein erster kompilierbarer Java-Kern

Hier würde ich tatsächlich anfangen:

```java
import java.util.*;

/**
 * Matrixgame / Collective AI Game
 *
 * Minimaler Unit-State für einen agentenbasierten Simulator.
 *
 * Physikalische Größen:
 * mass, position, velocity, acceleration, force, energy
 *
 * Kognitive Modellgrößen:
 * perception, memory, attention, prediction, intuition,
 * rationality, motivation, curiosity
 *
 * Soziale Modellgrößen:
 * cooperation, trust, empathy, communication,
 * socialInfluence, collectiveAlignment
 *
 * Alle normierten Modellwerte liegen zunächst in [0, 1].
 */
public class MatrixGame {

    static final double G = 6.67430e-11;
    static final double DT = 0.1;

    static final Random RANDOM = new Random(42);

    static class Unit {

        // ---------------- PHYSICS ----------------
        double mass = 1.0;

        double posX, posY, posZ;
        double velX, velY, velZ;
        double accX, accY, accZ;

        double force;
        double energy;
        double kineticEnergy;
        double potentialEnergy;
        double temperature;
        double entropy;
        double information;

        // ---------------- BIOLOGY ----------------
        double health = 1.0;
        double damage = 0.1;
        double defense = 0.1;
        double range = 10.0;
        double speed = 1.0;

        double age;
        double lifespan = 1000.0;

        double hunger;
        double thirst;
        double oxygen;
        double resource;
        double wealth;

        // ---------------- TECHNOLOGY ----------------
        double technology;
        double knowledge;
        double skill;
        double learningRate = 0.1;
        double memory;

        // ---------------- PERCEPTION ----------------
        double attention;
        double perception;
        double prediction;
        double uncertainty;
        double confidence;

        // ---------------- DECISION ----------------
        double riskTolerance;
        double curiosity;
        double fear;
        double stress;

        double happiness;
        double motivation;
        double goalStrength;
        double goalProgress;

        double reward;
        double utility;
        double survivalProbability;

        // ---------------- SOCIAL ----------------
        double cooperation;
        double trust;
        double empathy;
        double socialInfluence;
        double communication;
        double aggression;

        // ---------------- ADAPTATION ----------------
        double adaptability;
        double creativity;
        double rationality;
        double intuition;
        double emotionalIntelligence;

        // ---------------- EVOLUTION ----------------
        double evolutionFitness;
        double decisionQuality;
        double collectiveAlignment;

        String strategy = "RANDOM";

        Unit(double x, double y) {
            posX = x;
            posY = y;

            mass = 0.5 + RANDOM.nextDouble() * 2.0;
            speed = 0.5 + RANDOM.nextDouble() * 2.0;

            perception = RANDOM.nextDouble();
            memory = RANDOM.nextDouble();
            attention = RANDOM.nextDouble();

            prediction = RANDOM.nextDouble();
            confidence = RANDOM.nextDouble();

            riskTolerance = RANDOM.nextDouble();
            curiosity = RANDOM.nextDouble();

            cooperation = RANDOM.nextDouble();
            trust = RANDOM.nextDouble();
            empathy = RANDOM.nextDouble();

            adaptability = RANDOM.nextDouble();
            creativity = RANDOM.nextDouble();
            rationality = RANDOM.nextDouble();
            intuition = RANDOM.nextDouble();

            emotionalIntelligence = RANDOM.nextDouble();

            goalStrength = 0.5 + RANDOM.nextDouble() * 0.5;
            motivation = RANDOM.nextDouble();
        }

        void updatePhysics(double fx, double fy) {

            force = Math.sqrt(fx * fx + fy * fy);

            accX = fx / mass;
            accY = fy / mass;

            velX += accX * DT;
            velY += accY * DT;

            posX += velX * DT;
            posY += velY * DT;

            kineticEnergy =
                    0.5 * mass *
                    (velX * velX + velY * velY + velZ * velZ);
        }

        double distanceTo(Unit other) {

            double dx = other.posX - posX;
            double dy = other.posY - posY;
            double dz = other.posZ - posZ;

            return Math.sqrt(
                    dx * dx +
                    dy * dy +
                    dz * dz
            );
        }

        boolean canAttack(Unit enemy) {

            return health > 0.0
                    && energy > 0.1
                    && distanceTo(enemy) <= range
                    && enemy.health > 0.0;
        }

        double maxMaxScore(Unit enemy) {

            double survival =
                    survivalProbability;

            double resourceValue =
                    resource;

            double tacticalValue =
                    damage * (1.0 - enemy.defense);

            double socialValue =
                    cooperation * trust;

            return
                    survival
                    + resourceValue
                    + tacticalValue
                    + socialValue
                    + knowledge
                    + technology;
        }
    }

    static double gravitationalForce(Unit a, Unit b) {

        double r = Math.max(a.distanceTo(b), 1e-9);

        return G * a.mass * b.mass / (r * r);
    }

    static Unit maxMax(Unit self, List<Unit> enemies) {

        Unit best = null;
        double bestScore = -Double.MAX_VALUE;

        for (Unit candidate : enemies) {

            if (candidate == self)
                continue;

            double score =
                    self.maxMaxScore(candidate);

            if (score > bestScore) {
                bestScore = score;
                best = candidate;
            }
        }

        return best;
    }

    static void simulateStep(List<Unit> units) {

        for (Unit a : units) {

            double fx = 0.0;
            double fy = 0.0;

            for (Unit b : units) {

                if (a == b)
                    continue;

                double dx = b.posX - a.posX;
                double dy = b.posY - a.posY;

                double r2 =
                        Math.max(dx * dx + dy * dy, 1e-9);

                double r =
                        Math.sqrt(r2);

                double f =
                        G * a.mass * b.mass / r2;

                fx += f * dx / r;
                fy += f * dy / r;
            }

            a.updatePhysics(fx, fy);
            a.age += DT;
        }
    }

    public static void main(String[] args) {

        List<Unit> units = new ArrayList<>();

        // 50+ autonome Units
        for (int i = 0; i < 64; i++) {

            Unit unit =
                    new Unit(
                            RANDOM.nextDouble() * 100.0,
                            RANDOM.nextDouble() * 100.0
                    );

            units.add(unit);
        }

        for (int tick = 0; tick < 1000; tick++) {

            simulateStep(units);

            if (tick % 100 == 0) {

                System.out.println(
                        "Tick = " + tick
                        + " | Units = " + units.size()
                );
            }
        }
    }
}
