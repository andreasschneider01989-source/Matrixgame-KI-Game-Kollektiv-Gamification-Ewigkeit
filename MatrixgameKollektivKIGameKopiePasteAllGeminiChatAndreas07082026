    private double activationProbability; // Stochastische Wahrscheinlichkeit

    public ComplementCascade(double activationProbability) {
        this.activationProbability = activationProbability;
    }

    /**
     * Simuliert die Kettenreaktion der C3-Spaltung und Bildung des Membranangriffskomplexes (MAC).
     */
    public int triggerCascade(int activeThreats) {
        if (activeThreats <= 0) return 0;
        
        Random rand = new Random();
        int successfullyNeutralized = 0;

        for (int i = 0; i < activeThreats; i++) {
            // Boolesche & Stochastische Auswertung der Opsonierung und Lyse
            boolean c3bOpsonized = rand.nextDouble() < activationProbability;
            boolean macFormed = rand.nextDouble() < (activationProbability * 0.9); // Strenger Filter

            if (c3bOpsonized && macFormed) {
                successfullyNeutralized++; // Loch in die Membran gerissen -> Erreger aufgelöst
            }
        }
        return successfullyNeutralized;
    }
