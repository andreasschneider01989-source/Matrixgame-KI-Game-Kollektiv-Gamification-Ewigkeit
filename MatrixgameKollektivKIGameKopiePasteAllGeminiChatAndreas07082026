        System.out.println("\n--- Szenario B: Gamifiziertes KI-gestütztes Impftraining (Kontrolliert & Optimiert) ---");
        player.resetHealth(100);
        player.simulateExposure(true, 0.001); // 0.1% kontrolliertes Nebenwirkungsrisiko bei vollem Training
        
        System.out.println("\n[STATUS] Impftraining-Simulation erfolgreich kompiliert und verifiziert.");
