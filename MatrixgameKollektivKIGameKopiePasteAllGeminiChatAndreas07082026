public class ImmuneAgent {
    public double[] pos;
    public double[] vel;
    public double mass;
    public String type; // "pathogen" or "macrophage"
    public double confidence;

    public ImmuneAgent(double x, double y, double mass, String type) {
        this.pos = new double[]{x, y};
        this.vel = new double[]{0.0, 0.0};
        this.mass = mass;
        this.type = type;
        this.confidence = 0.95;
    }

    public void updatePosition(double[] force, double dt) {
        for (int i = 0; i < 2; i++) {
            double accel = force[i] / this.mass;
            this.vel[i] += accel * dt;
            this.pos[i] += this.vel[i] * dt;
        }
    }
}

