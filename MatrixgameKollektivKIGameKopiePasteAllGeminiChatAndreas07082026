class ImmunePlayerAgent {
    private String name;
    private int healthPoints;
    private int immuneMemoryLevel; // Trainingsstatus der Gedächtniszellen

    public ImmunePlayerAgent(String name, int healthPoints) {
        this.name = name;
        this.healthPoints = healthPoints;
        this.immuneMemoryLevel = 0;
    }

    public void resetHealth(int hp) {
        this.healthPoints = hp;
        this.immuneMemoryLevel = 0;
    }

    public void simulateExposure(boolean vaccinated, double riskProbability) {
        Random rand = new Random();
        
        if (vaccinated) {
            System.out.println("[" + name + "] Erhalt des optimierten Impf-Datenpakets (Sicherer Sandbox-Modus).");
            immuneMemoryLevel = 95; // Hohe Erkennungsquote aufgebaut
            System.out.println("-> Immunsystem trainiert erfolgreich. Gedächtnis-Level: " + immuneMemoryLevel + "%");
        } else {
            System.out.println("[" + name + "] Direkter Kontakt mit rohem Pathogen (Kein Vorab-Training).");
            immuneMemoryLevel = 10;
        }

        // Stochastische Auswertung von Nebenwirkungen oder Infektionsschaden
        boolean adverseEventOccurred = rand.nextDouble() < riskProbability;
        
        if (adverseEventOccurred) {
            int damage = vaccinated ? 2 : 45; // Nebenwirkung vs. echte schwere Krankheit
            healthPoints -= damage;
            System.out.println("-> Warnung: Stochastischer Nebeneffekt eingetreten! HP verbleibend: " + healthPoints);
        } else {
            System.out.println("-> Perfekter Durchlauf! Das System bleibt stabil, stark und im optimalen Energiezustand.");
        }
    }
}

