        double annualRisk = 1.0 - Math.pow(1.0 - baseMutationRatePerCell, totalCells * 0.05);
        double cumulativeRisk = 1.0 - Math.pow(1.0 - annualRisk, years);
        
        // Begrenzung auf mathematischen Bereich [0.0, 1.0]
        cumulativeRisk = Math.min(1.0, Math.max(0.0, cumulativeRisk));

