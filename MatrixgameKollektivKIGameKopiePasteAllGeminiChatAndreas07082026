    public Unit(int team, int type, double startX, double startY) {
        super();
        this.team = team;
        this.type = type;
        this.id = (int)(Math.random() * 100000);
        
        this.posX = startX;
        this.posY = startY;
        this.posZ = 0;
        
        // Stabilisierte Initialisierung statt Division durch Random
        if (team == 1) { // Immunsystem
            this.leben = 100 + (Math.random() * 20); // 100-120 HP
            this.damage = 10 + (Math.random() * 5);
            this.speed = 150 + (Math.random() * 50);
            this.distance = 250; // Angriffsreichweite
            this.size = 15;
        } else { // Pathogen
            this.leben = 40 + (Math.random() * 10);
            this.damage = 5 + (Math.random() * 2);
            this.speed = 100 + (Math.random() * 20);
            this.distance = 100;
            this.size = 8;
        }
        this.maxLeben = this.leben;
    }

    public void moveTo(KreisObjekt opponent) {
        double dx = posX - opponent.posX;
        double dy = posY - opponent.posY;
        double dz = posZ - opponent.posZ;
        
        double distQ = (dx * dx) + (dy * dy) + (dz * dz);
        double dist = Math.sqrt(distQ);
        
        if (dist > 0) {
            // Vektornormalisierung für exakte Geschwindigkeitssteuerung
            double movDist = Math.min(speed, Math.abs(dist - distance));
            vx = -(dx / dist) * movDist;
            vy = -(dy / dist) * movDist;
            vz = -(dz / dist) * movDist;
        }
    }
    
    public double getDistance(Unit opponent) {
        double dx = this.posX - opponent.posX;
        double dy = this.posY - opponent.posY;
        double dz = this.posZ - opponent.posZ;
        return Math.sqrt((dx * dx) + (dy * dy) + (dz * dz));
    }

