// ============================================================
// Unit-Klasse
// ============================================================
class Unit {
    public double id;
    public int team = 1;
    public String typ = "Unit";

    public double posX = 0;
    public double posY = 0;
    public double posZ = 0;

    public double size = 8.0;
    public double leben = 100.0;
    public double speed = 0.5;
    public double reichweite = 2.0;
    public double schaden = 10.0;

    public double red = 200;
    public double green = 200;
    public double blue = 200;

    public boolean isSelected = false;
    public Unit target = null;
    public Unit manualTarget = null;
    public Double targetPosX = null;
    public Double targetPosY = null;
    public Double targetPosZ = null;
    public String decisionAlgorithm = "IDLE";

    // ========== WASD / QE – setzen Ziel + schalten in TACTICAL_MOVE ==========
    public void moveA() {
        targetPosX = posX - speed;
        targetPosY = posY;
        targetPosZ = posZ;
        decisionAlgorithm = "TACTICAL_MOVE";
    }

    public void moveD() {
        targetPosX = posX + speed;
        targetPosY = posY;
        targetPosZ = posZ;
        decisionAlgorithm = "TACTICAL_MOVE";
    }

    public void moveW() {
        targetPosY = posY - speed;   // Welt-Y kleiner = auf dem Bildschirm nach oben
        targetPosX = posX;
        targetPosZ = posZ;
        decisionAlgorithm = "TACTICAL_MOVE";
    }

    public void moveS() {
        targetPosY = posY + speed;   // Welt-Y größer = auf dem Bildschirm nach unten
        targetPosX = posX;
        targetPosZ = posZ;
        decisionAlgorithm = "TACTICAL_MOVE";
    }

    public void moveQ() {
        targetPosZ = posZ - speed;
        targetPosX = posX;
        targetPosY = posY;
        decisionAlgorithm = "TACTICAL_MOVE";
    }

    public void moveE() {
        targetPosZ = posZ + speed;
        targetPosX = posX;
        targetPosY = posY;
        decisionAlgorithm = "TACTICAL_MOVE";
    }

    // ========== Reine Positionsbewegung (WASD + Rechtsklick-Move) ==========
    // Kein Abzug der Reichweite → keine Rückwärtsbewegung mehr
    public void moveToPosition(double targetX, double targetY, double targetZ) {
        double oldX = posX, oldY = posY, oldZ = posZ;

        double dx = targetX - posX;
        double dy = targetY - posY;
        double dz = targetZ - posZ;
        double dist = Math.sqrt(dx * dx + dy * dy + dz * dz);

        if (dist > 0.0001) {
            double moveWeite = Math.min(dist, speed);   // volle Speed, kein -reichweite
            posX += (dx / dist) * moveWeite;
            posY += (dy / dist) * moveWeite;
            posZ += (dz / dist) * moveWeite;

            if (Math.random() <= geminiklasse.logProbability) {
                System.out.println(String.format(Locale.US,
                        "MOVE   | Unit %.0f (Team %d) von (%.2f, %.2f, %.2f) -> (%.2f, %.2f, %.2f)",
                        this.id, this.team, oldX, oldY, oldZ, posX, posY, posZ));
            }
        }
    }

    // ========== Bewegung auf Gegner (mit Reichweiten-Stop) ==========
    public void moveToEnemy(Unit other) {
        if (other == null) return;

        double oldX = posX, oldY = posY, oldZ = posZ;

        double dx = other.posX - posX;
        double dy = other.posY - posY;
        double dz = other.posZ - posZ;
        double dist = Math.sqrt(dx * dx + dy * dy + dz * dz);

        if (dist > 0.0001) {
            // Nur so weit laufen, dass man am Ende der Reichweite steht
            double maxMove = Math.max(0.0, dist - reichweite);
            double moveWeite = Math.min(maxMove, speed);

            posX += (dx / dist) * moveWeite;
            posY += (dy / dist) * moveWeite;
            posZ += (dz / dist) * moveWeite;

            if (Math.random() <= geminiklasse.logProbability) {
                System.out.println(String.format(Locale.US,
                        "MOVE   | Unit %.0f (Team %d) von (%.2f, %.2f, %.2f) -> (%.2f, %.2f, %.2f)",
                        this.id, this.team, oldX, oldY, oldZ, posX, posY, posZ));
            }
        }
    }

    public double getDistance(Unit other) {
        if (other == null) return Double.MAX_VALUE;
        return getDistanceTo(other.posX, other.posY, other.posZ);
    }

    public double getDistanceTo(double tx, double ty, double tz) {
        double dx = tx - posX;
        double dy = ty - posY;
        double dz = tz - posZ;
        return Math.sqrt(dx * dx + dy * dy + dz * dz);
    }

    public void attackieren(Unit enemy) {
        if (enemy != null && enemy.leben > 0) {
            double kritischerMultiplikator = 1.0 + (Math.random() * 2.5);
            double tatsaechlicherSchaden = schaden * kritischerMultiplikator;
            enemy.leben -= tatsaechlicherSchaden;

            if (Math.random() <= geminiklasse.logProbability || enemy.leben <= 0) {
                System.out.println(String.format(Locale.US,
                        "ATTACK | Unit %.0f greift Unit %.0f an! Schaden: %.2f (Rest-HP: %.2f)",
                        this.id, enemy.id, tatsaechlicherSchaden, enemy.leben));
            }

            if (enemy.leben <= 0) {
                enemy.leben = 0;
                System.out.println("DESTROY| Unit " + enemy.id + " (" + enemy.typ +
                        ") wurde vernichtet durch Unit " + this.id);
            }
        }
    }
}
