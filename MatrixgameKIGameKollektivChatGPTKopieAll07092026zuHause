            }
        }
    }

    // ---------- Utility functions ----------
    static double clamp(double x, double lo, double hi) {
        return Math.max(lo, Math.min(hi, x));
    }

    static double mean(double... xs) {
        return Arrays.stream(xs).average().orElse(0);
    }

    static double geometricMean(double... xs) {
        double product = 1.0;
