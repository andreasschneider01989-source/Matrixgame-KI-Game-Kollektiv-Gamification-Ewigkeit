    // === SIMULATIONSLOGIK (modular und auffindbar!) ===

    private void updateGameLogic() {

        for (int i = 0; i < unitList.size(); i++) {

            Unit k = unitList.get(i);


            // Basis-Verhalten

            k.entropieMove();

            k.update();


            // Seltene zufällige Interaktion

            if (Math.random() > 0.999 && unitList.size() > 1) {

                int randomIndex = (int)(unitList.size() * Math.random());

                if (randomIndex != i) {

                    k.randEntropie4(unitList.get(randomIndex));

                }

            }


            // === IMMUNSYSTEM-INTERAKTIONEN ===


            // A) VIRUS: Suche gesunde Zelle und infiziere sie

            if (k.bioTyp.equals("VIRUS") && !k.hasRecursionAnchor) {

                Unit target = findNearestUnit(k, "ZELLE", 100);

                if (target != null) {

                    target.bioTyp = "VIRUS";

                    target.hasRecursionAnchor = false;

                    target.color = Color.RED;

                    target.isHiding = false;

                    k.recordSuccess();

                    System.out.println("INFEKTION: Zelle bei (" + (int)target.x + "," + (int)target.y + ") wurde zu Virus");

                } else {

                    k.recordFail();

                }

            }


            // B) NK_DEFENDER: Suche Virus und eliminiere ihn

            if (k.bioTyp.equals("NK_DEFENDER")) {

                Unit target = findNearestUnit(k, "VIRUS", 150);

                if (target != null) {

                    unitList.remove(target);

                    k.recordSuccess();

                    System.out.println("NK-DEFENDER: Virus eliminiert bei (" + (int)target.x + "," + (int)target.y + ")");

                } else {

                    k.recordFail();

                }

            }


            // === KONTROLLIERTE REplikation ===

            if (unitList.size() < MAX_UNITS) {

                if (k.bioTyp.equals("VIRUS") && !k.hasRecursionAnchor) {

                    double replicationChance = 0.99 - (k.weight * 0.01);

                 // KONTROLLIERTE REplikation (nur alle 10 Ticks!)

                    if (simulationsSchritte % 10 == 0 && unitList.size() < MAX_UNITS) {

                        if (k.bioTyp.equals("VIRUS") && !k.hasRecursionAnchor) {

                            if (Math.random() > 0.95) { // 5% Chance alle 10 Ticks

                                Unit u2 = k.kopie();

                                u2.x += (Math.random() - 0.5) * 20;

                                u2.y += (Math.random() - 0.5) * 20;

                                unitList.add(u2);

                            }

                        }

                    }

                }

            }

            // === APOPTOSE bei Überlastung ===

         // APOPTOSE bei Überlastung (sanft!)

            else {

                if (k.isSuspicious() && Math.random() > 0.999) { // Nur 0.1% Chance!

                    System.out.println("APOPTOSE: Verdächtige Unit eliminiert (Typ: " + k.bioTyp + ")");

                    unitList.remove(i);

                    i--;

                }

            }

        }

    }


    // === HELFER-METHODE: Finde nächste Unit vom bestimmten Typ ===

    private Unit findNearestUnit(Unit source, String bioTyp, double maxDistance) {

        Unit nearest = null;

        double minDist = maxDistance;


        for (Unit other : unitList) {

            if (other == source) continue;

            if (!other.bioTyp.equals(bioTyp)) continue;


            double dist = Math.hypot(source.x - other.x, source.y - other.y);

            if (dist < minDist) {

                minDist = dist;

                nearest = other;

            }

        }

        return nearest;

    }


    // === NK-DEFENDER SCAN (Taste N) ===

    private void nkDefenderScan() {

        System.out.println("--- NK-DEFENDER SCAN GESTARTET ---");

        int kills = 0;

        for (int i = unitList.size() - 1; i >= 0; i--) {

            Unit k = unitList.get(i);

            if (k.bioTyp.equals("NK_DEFENDER")) continue;


            if (k.isSuspicious()) {

                System.out.println("Ziel eliminiert: " + k.bioTyp + " (Grund: Kein Anker/Über-Replikation)");

                unitList.remove(i);

                kills++;

            } else if (k.bioTyp.equals("VIRUS") && k.isHiding) {

                if (Math.random() < 0.7) {

                    System.out.println("GETARNTEN VIRUS ENTLARVT UND ELIMINIERT!");

                    unitList.remove(i);

                    kills++;

                }

            }

        }

        System.out.println("--- SCAN BEENDET. " + kills + " Ziele eliminiert. ---");

        repaint();

    }


