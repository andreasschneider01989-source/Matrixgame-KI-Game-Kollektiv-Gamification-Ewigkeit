    public void updateMatrixLogic() {
        simulationTicks++;
        
        // Deterministische Entropie-Regeneration
        if (globalEntropyPool < 200.0) {
            globalEntropyPool += 0.05; 
        }

        for (Unit u : unitList) {
            double dx = 0;
            double dy = 0;
            boolean hasVector = false;

            // Logik-Branch: Taktische Bewegung
            if (u.decisionAlgorithm != null && u.decisionAlgorithm.equals("TACTICAL_MOVE") && u.targetPosX != null && u.targetPosY != null) {
                dx = u.targetPosX - u.posX;
                dy = u.targetPosY - u.posY;
                hasVector = true;
            } 
            // Logik-Branch: Taktischer Fokus (Angriff)
            else if (u.decisionAlgorithm != null && u.decisionAlgorithm.equals("TACTICAL_FOCUS") && u.manualTarget != null) {
                dx = u.manualTarget.posX - u.posX;
                dy = u.manualTarget.posY - u.posY;
                hasVector = true;
            }

            // Normalisierung und Vektor-Anwendung
            if (hasVector) {
                double distance = Math.hypot(dx, dy);
                if (distance > u.size) {
                    double speed = 2.5; 
                    u.posX += (dx / distance) * speed;
                    u.posY += (dy / distance) * speed;
                } else if (u.decisionAlgorithm.equals("TACTICAL_MOVE")) {
                    // Ziel erreicht, Vektoren nullen
                    u.targetPosX = null;
                    u.targetPosY = null;
                    u.decisionAlgorithm = "IDLE";
                }
            }
        }
        repaint();
    }
