/**
 * Wendet physische Raumgrenzen auf die Unit an und synchronisiert
 * die lokale Position mit dem globalen Matrixgame-Geo-Grid.
 * 
 * @param simBreite Die maximale X-Ausdehnung der Simulation
 * @param simHoehe  Die maximale Y-Ausdehnung der Simulation
 */
public void checkGrenzen(double simBreite, double simHoehe) {
    // 1. Physische Grenzen (Bounce-Mechanik)
    if (this.x < 0) {
        this.x = 0;
        this.vx *= -1; // Vektor umkehren
    } else if (this.x > simBreite) {
        this.x = simBreite;
        this.vx *= -1;
    }
    
    if (this.y < 0) {
        this.y = 0;
        this.vy *= -1;
    } else if (this.y > simHoehe) {
        this.y = simHoehe;
        this.vy *= -1;
    }

    // 2. Raum-Transformation: X/Y auf Geo-Koordinaten mappen
    // Skalierungsfaktor: 1 Pixel entspricht einer minimalen Verschiebung im Grid
    this.geoLon = 8.646686 + (this.x * 0.000001);
    this.geoLat = 49.822589 + (this.y * 0.000001);

    // 3. Zeit-Synchronisation für diesen Tick
    this.lastSyncTimestamp = System.currentTimeMillis();
}

