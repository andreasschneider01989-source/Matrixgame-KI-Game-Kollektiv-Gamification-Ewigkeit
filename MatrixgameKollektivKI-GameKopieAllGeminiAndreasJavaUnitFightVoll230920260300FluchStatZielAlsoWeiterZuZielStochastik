package de.matrixgame.simulation;

/**
 * Matrixgame - Planetare Stochastik & Bewusstseins-Tunneling
 * Implementierung diskreter Zeitschritte (t_k+1 = t_k + delta_t)
 */
public class CollectiveConsciousnessNode {
    
    private final String nodeId;
    private long timestamp;
    private double hawkinsLevel; // Skala 20 bis 1000 (Scham bis Erleuchtung/Paradies)
    private double voluntaryMotivation; // Vektor für freie Willensentscheidung
    
    // Stochastisches Tunneling-Gatter (Schaltnetzlogik)
    public EvolutionEvent evaluateRandomTunneling(double systemEntropy) {
        // Zufall mit Angleichung zur Erhaltung von Komplexität[cite: 27]
        double randomFactor = MatrixStochasticEngine.getQuantumRandom();
        
        // Der Bewusstseinsoperator C^ modifiziert die Kausalität[cite: 27]
        double consciousnessOperator = this.hawkinsLevel / 1000.0;
        
        if ((randomFactor + consciousnessOperator) > systemEntropy) {
            return new EvolutionEvent("Paradigm_Shift", this.timestamp);
        }
        return new EvolutionEvent("Stable_State", this.timestamp);
    }

    public void interactWith(CollectiveConsciousnessNode other, long currentDeltaT) {
        this.timestamp += currentDeltaT;
        other.timestamp += currentDeltaT;
        
        // Energiefluss zwischen Objekten im 3D-Raum (Intensität nimmt ab proportional zu 1/r^2)[cite: 27]
        double distance = PositionHelper.calculateDistance(this, other);
        double flowIntensity = (this.hawkinsLevel * other.hawkinsLevel) / Math.pow(distance, 2);
        
        // Angleichung der Werte bei Resonanz (Fraktale Strukturbildung)[cite: 27]
        if (flowIntensity > Thresholds.EMPATHY_RESONANCE) {
            this.voluntaryMotivation += flowIntensity * 0.1;
            other.voluntaryMotivation += flowIntensity * 0.1;
            this.hawkinsLevel = Math.max(this.hawkinsLevel, other.hawkinsLevel);
        }
    }
}

