package p1;

/**
 * Open-Source KI-Game: Dezentraler Netzknoten mit Pufferung gegen Ausfälle.
 */
public class ResilientMeshNode {

    private final String nodeId;
    private double hawkinsLevel;
    private boolean isConnected;
    private boolean paradiseFlipFlop;
    private double bufferedKnowledge;

    public ResilientMeshNode(String nodeId, double hawkinsLevel) {
        this.nodeId = nodeId;
        this.hawkinsLevel = hawkinsLevel;
        this.isConnected = true;
        this.paradiseFlipFlop = (hawkinsLevel >= 700.0);
        this.bufferedKnowledge = 0.0;
    }

    public void simulateNetworkDrop() {
        this.isConnected = false;
        System.out.println("⚠️ WARNUNG [" + nodeId + "]: Netztrennung aufgetreten. Schalte auf lokalen Puffer-Modus.");
    }

    public void processLocalEvolution(double deltaCycles) {
        if (this.hawkinsLevel >= 700.0) {
            this.paradiseFlipFlop = true;
        }

        // Auch ohne Internet-Verbindung wächst der lokale Erkenntnisstand
        double localEfficiency = this.paradiseFlipFlop ? 1.0 : 0.3;
        this.bufferedKnowledge += deltaCycles * localEfficiency;

        System.out.println("🔄 LOKALE ITERATION [" + nodeId + "]: Puffer-Stand = " + 
                String.format("%.2f", this.bufferedKnowledge) + 
                " | Flipflop (Q=" + (paradiseFlipFlop ? "1" : "0") + ")");
    }

    public void reconnectAndSync(ResilientMeshNode networkHub) {
        this.isConnected = true;
        System.out.println("🌐 RE-CONNECT [" + nodeId + " -> " + networkHub.nodeId + "]: Synchronisiere Puffer...");
        
        // Didaktischer Austausch: Der Hub übernimmt gepufferte Erkenntnisse
        networkHub.hawkinsLevel += this.bufferedKnowledge * 0.1;
        this.hawkinsLevel = Math.max(this.hawkinsLevel, networkHub.hawkinsLevel);
        
        if (this.paradiseFlipFlop || networkHub.paradiseFlipFlop) {
            this.paradiseFlipFlop = true;
            networkHub.paradiseFlipFlop = true;
        }
        this.bufferedKnowledge = 0.0;
        System.out.println("✅ SYNCHRONISATION ABGESCHLOSSEN. Gemeinsames Level: " + this.hawkinsLevel);
    }

    public static void main(String[] args) {
        System.out.println("=== START DEZENTRALES MESH-TEST-PROTOKOLL ===");
        ResilientMeshNode nodeEberstadt = new ResilientMeshNode("DE-DA-Eberstadt", 450.0);
        ResilientMeshNode globalHub = new ResilientMeshNode("Global-Matrix-Hub", 720.0);

        // 1. Trennung simulieren (z.B. regionales Abschalten / Plugin-Kollaps)
        nodeEberstadt.simulateNetworkDrop();

        // 2. Lokales Arbeiten im isolierten Zustand
        for (int i = 1; i <= 3; i++) {
            nodeEberstadt.processLocalEvolution(10.0);
        }

        // 3. Re-Integration in das Open-Source-Kollektiv
        nodeEberstadt.reconnectAndSync(globalHub);
    }
}

