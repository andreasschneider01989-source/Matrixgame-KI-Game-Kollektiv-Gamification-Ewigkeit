package ordner4;

import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.util.ArrayList;
import java.util.List;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import java.awt.event.MouseMotionAdapter;

/**
 * Matrixgame Level 3 - Erweiterte RTS-Engine mit taktischer Schwarm-KI,
 * Entropie-Befehlskosten und asymmetrischer Kampagnen-Steuerung.
 */
public class MatrixgameLevel3 extends JPanel {

    public List<Unit> unitList = new ArrayList<>();

    int FRAME_WIDTH = 1920;
    int FRAME_HEIGHT = 1080;

    double zoomFactor = 1.0;
    double zoomCenterX = 0;
    double zoomCenterY = 0;
    static final double ZOOM_STEP = 1.2;
    double feinheit = 50;
    double PAN_STEP = feinheit * zoomFactor;

    // Globale Entropie- und Kampagnenmetriken
    double globalEntropyPool = 100.0;
    long simulationTicks = 0;
    int currentLevel = 3;

    // Variablen für Drag-Selection (Auswahlbox)
    int dragStartX = -1;
    int dragStartY = -1;
    int currentMouseX = -1;
    int currentMouseY = -1;
    boolean isDragging = false;

    public MatrixgameLevel3() {
        setPreferredSize(new Dimension(FRAME_WIDTH, FRAME_HEIGHT));
        setBackground(Color.BLACK);
        
        // Initialisierung von Test-Einheiten
        initializeUnits();

        MouseAdapter mouseHandler = new MouseAdapter() {
            @Override
            public void mousePressed(MouseEvent e) {
                if (SwingUtilities.isLeftMouseButton(e)) {
                    dragStartX = e.getX();
                    dragStartY = e.getY();
                    currentMouseX = dragStartX;
                    currentMouseY = dragStartY;
                    isDragging = false;
                }
                else if (SwingUtilities.isRightMouseButton(e)) {
                    int mouseX = e.getX();
                    int mouseY = e.getY();
                    
                    double worldTargetX = (mouseX - getWidth() / 2.0) / zoomFactor - zoomCenterX;
                    double worldTargetY = (mouseY - getHeight() / 2.0) / zoomFactor - zoomCenterY;

                    Unit clickedEnemy = null;
                    for (Unit u : unitList) {
                        double sx = (zoomCenterX + u.posX) * zoomFactor + getWidth() / 2.0;
                        double sy = (zoomCenterY + u.posY) * zoomFactor + getHeight() / 2.0;
                        double radius = Math.abs(u.size * zoomFactor);
                        
                        if (Math.hypot(mouseX - sx, mouseY - sy) <= radius) {
                            clickedEnemy = u;
                            break;
                        }
                    }

                    // Entropie-Kosten-Prüfung für Befehle
                    int selectedCount = 0;
                    for (Unit u : unitList) {
                        if (u.isSelected && u.team == 1) selectedCount++;
                    }

                    // Berechne Kosten: 0.5 Entropie pro befehligter Einheit
                    double commandCost = selectedCount * 0.5;

                    if (selectedCount > 0 && globalEntropyPool >= commandCost) {
                        globalEntropyPool -= commandCost;
                        
                        for (Unit u : unitList) {
                            if (u.isSelected && u.team == 1) {
                                if (clickedEnemy != null && clickedEnemy.team != 1) {
                                    u.targetUnit = clickedEnemy;
                                } else {
                                    u.targetX = worldTargetX;
                                    u.targetY = worldTargetY;
                                    u.targetUnit = null;
                                }
                            }
                        }
                        System.out.println("Befehl ausgeführt. Verbleibende Entropie: " + globalEntropyPool);
                    } else if (selectedCount > 0) {
                        System.out.println("Kritischer Fehler: Nicht genügend Entropie für diese Operation.");
                    }
                }
            }

            @Override
            public void mouseReleased(MouseEvent e) {
                if (SwingUtilities.isLeftMouseButton(e)) {
                    if (isDragging) {
                        // Logik für die Auswahlbox
                        int minX = Math.min(dragStartX, currentMouseX);
                        int maxX = Math.max(dragStartX, currentMouseX);
                        int minY = Math.min(dragStartY, currentMouseY);
                        int maxY = Math.max(dragStartY, currentMouseY);

                        for (Unit u : unitList) {
                            if (u.team == 1) {
                                double sx = (zoomCenterX + u.posX) * zoomFactor + getWidth() / 2.0;
                                double sy = (zoomCenterY + u.posY) * zoomFactor + getHeight() / 2.0;
                                u.isSelected = (sx >= minX && sx <= maxX && sy >= minY && sy <= maxY);
                            }
                        }
                    } else {
                        // Logik für den Einzelklick
                        for (Unit u : unitList) {
                            if (u.team == 1) {
                                double sx = (zoomCenterX + u.posX) * zoomFactor + getWidth() / 2.0;
                                double sy = (zoomCenterY + u.posY) * zoomFactor + getHeight() / 2.0;
                                u.isSelected = (Math.hypot(e.getX() - sx, e.getY() - sy) <= u.size * zoomFactor);
                            }
                        }
                    }
                    isDragging = false;
                    repaint();
                }
            }
        };

        addMouseListener(mouseHandler);
        addMouseMotionListener(new MouseMotionAdapter() {
            @Override
            public void mouseDragged(MouseEvent e) {
                if (SwingUtilities.isLeftMouseButton(e)) {
                    isDragging = true;
                    currentMouseX = e.getX();
                    currentMouseY = e.getY();
                    repaint();
                }
            }
        });

        // Start der Simulationsschleife (60 Updates pro Sekunde)
        Timer timer = new Timer(16, new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                updateSimulation();
                repaint();
            }
        });
        timer.start();
    }

    private void initializeUnits() {
        // Spieler-Einheiten
        for (int i = 0; i < 10; i++) {
            unitList.add(new Unit(Math.random() * 200 - 100, Math.random() * 200 - 100, 1));
        }
        // Gegnerische Einheiten
        for (int i = 0; i < 5; i++) {
            unitList.add(new Unit(Math.random() * 200 + 300, Math.random() * 200 + 300, 2));
        }
    }

    private void updateSimulation() {
        simulationTicks++;
        
        // Passive Entropie-Regeneration
        if (simulationTicks % 60 == 0 && globalEntropyPool < 100.0) {
            globalEntropyPool += 1.0;
        }

        double timeStep = 1.0;

        for (Unit u : unitList) {
            if (u.targetUnit != null) {
                u.targetX = u.targetUnit.posX;
                u.targetY = u.targetUnit.posY;
            }

            double dx = u.targetX - u.posX;
            double dy = u.targetY - u.posY;
            double distance = Math.hypot(dx, dy);

            if (distance > 2.0) {
                double vx = (dx / distance) * u.speed;
                double vy = (dy / distance) * u.speed;
                
                u.posX += vx * timeStep;
                u.posY += vy * timeStep;
            }
        }
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2d = (Graphics2D) g;
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        // Rendern der Einheiten
        for (Unit u : unitList) {
            double sx = (zoomCenterX + u.posX) * zoomFactor + getWidth() / 2.0;
            double sy = (zoomCenterY + u.posY) * zoomFactor + getHeight() / 2.0;
            int r = (int) (u.size * zoomFactor);

            if (u.team == 1) {
                g2d.setColor(Color.CYAN);
            } else {
                g2d.setColor(Color.RED);
            }

            g2d.fillOval((int) sx - r, (int) sy - r, r * 2, r * 2);

            if (u.isSelected) {
                g2d.setColor(Color.GREEN);
                g2d.drawOval((int) sx - r - 2, (int) sy - r - 2, r * 2 + 4, r * 2 + 4);
            }
        }

        // Rendern der Auswahlbox
        if (isDragging) {
            int minX = Math.min(dragStartX, currentMouseX);
            int maxX = Math.max(dragStartX, currentMouseX);
            int minY = Math.min(dragStartY, currentMouseY);
            int maxY = Math.max(dragStartY, currentMouseY);
            
            g2d.setColor(new Color(0, 255, 0, 50));
            g2d.fillRect(minX, minY, maxX - minX, maxY - minY);
            g2d.setColor(Color.GREEN);
            g2d.drawRect(minX, minY, maxX - minX, maxY - minY);
        }

        // Rendern der Entropie-Anzeige
        g2d.setColor(Color.WHITE);
        g2d.setFont(new Font("Monospaced", Font.BOLD, 16));
        g2d.drawString("Entropie Pool: " + String.format("%.1f", globalEntropyPool), 20, 30);
    }

    public static void main(String[] args) {
        JFrame frame = new JFrame("Matrixgame Level 3 Engine");
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.add(new MatrixgameLevel3());
        frame.pack();
        frame.setLocationRelativeTo(null);
        frame.setVisible(true);
    }
}

class Unit {
    public double posX, posY;
    public double targetX, targetY;
    public double speed = 2.5;
    public double size = 6.0;
    public int team;
    public boolean isSelected = false;
    public Unit targetUnit = null;

    public Unit(double startX, double startY, int team) {
        this.posX = startX;
        this.posY = startY;
        this.targetX = startX;
        this.targetY = startY;
        this.team = team;
    }
}

Die algorithmische Konstruktion ist analog zu einem Compiler aufgebaut, der klare Laufzeitbedingungen fordert. Die Mausereignisse sind in logische Zustandsmaschinen unterteilt. Während des Ziehens mit der linken Maustaste wird der Zustand der Drag-Selektion aktiviert, der erst beim Loslassen evaluiert wird und die Euklidischen Distanzen oder Box-Kollisionen der Einheiten prüft. Das System befindet sich nun in einer stetigen Simulationsschleife.

Aus der Perspektive eines Wächter-Systems und im Sinne des Retter-Modus ist diese Architektur ideal. Sie belohnt effiziente, berechnete Züge anstatt sinnloser Überbeanspruchung. Der Entropie-Pool fungiert als mathematisches Modell für begrenzte Ressourcen in einem Ökosystem. Indem der Spieler lernt, Operationen logisch zu planen und Reibungsverluste zu minimieren, wird sein kognitives System darauf trainiert, nachhaltig und präzise zu agieren. Dies fördert direkt die analytischen Stärken, ohne dass das System in einen negativen Perfektionismus abgleitet, da Fehler lediglich Zeit in Form von Entropie-Regeneration kosten und keinen absoluten Zustand des Versagens darstellen.

