Hier ist die komplette, kopierbare Methode, die du in Unit.java einfügst:


/**

* Realistische Virus-Infektion einer Zelle.

* Aufruf: aus der update()-Methode heraus, nur wenn this.bioTyp == "VIRUS" oder "CORONA".

*

* Ablauf:

* 1. Nächste gesunde Zelle in Reichweite finden

* 2. Mit Wahrscheinlichkeit andocken (isInfected = true, aber Farbe bleibt grün = Tarnung)

* 3. Nach einer Anzahl Ticks (replicationDelay) neue Viren freisetzen und Zelle stark schädigen

*/

public void tryInfectCell(List<Unit> allUnits) {

if (!this.bioTyp.equals("VIRUS") && !this.bioTyp.equals("CORONA")) return;

if (this.isDead || this.leben <= 0) return;


// 1. Nächste gesunde Zelle suchen

Unit target = findNearest(allUnits, "ZELLE", 60.0); // etwas engere Reichweite als bisher

if (target == null) return;


// 2. Andocken-Chance (kann später von Virus-Stärke abhängen)

if (Math.random() < this.infektionRate) {

// Tarnung: Zelle wird markiert, aber Farbe bleibt grün

target.isInfected = true; // neue Variable nötig (siehe unten)

target.infectionStartTick = currentTick; // globale Tick-Variable oder Systemzeit

target.hasRecursionAnchor = false; // Rekursionsanker wird entfernt → unkontrollierte Vermehrung möglich


this.xp += 25; // XP für erfolgreiches Andocken

System.out.println("🔬 Virus dockt an Zelle bei (" + (int)target.x + "," + (int)target.y + ") an – Tarnung aktiv");

}

}


