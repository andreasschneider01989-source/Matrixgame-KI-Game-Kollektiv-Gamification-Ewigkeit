package ordner2;

import java.util.ArrayList;
import java.util.List;

public class GameState implements Cloneable {
    public Unit unitA; // Maximizing Player
    public Unit unitB; // Minimizing Player
    public boolean isPlayerATurn;

    public static final int GRID_SIZE = 10;
    public static final double ATTACK_DAMAGE = 25.0;

    public GameState(Unit unitA, Unit unitB, boolean isPlayerATurn) {
        this.unitA = unitA;
        this.unitB = unitB;
        this.isPlayerATurn = isPlayerATurn;
    }

    public boolean isTerminal() {
        return unitA.leben <= 0 || unitB.leben <= 0;
    }

    /**
     * Generiert alle legalen Aktionen basierend auf echten Unit-Attributen.
     */
    public List<ActionType> getLegalActions() {
        List<ActionType> actions = new ArrayList<>();
        if (isTerminal()) return actions;

        Unit active = isPlayerATurn ? unitA : unitB;
        Unit target = isPlayerATurn ? unitB : unitA;

        // 1. Angriff prüfen (anhand deiner 'reichweite')
        if (active.distanceTo(target) <= active.reichweite) {
            actions.add(ActionType.ATTACK);
        }

        // 2. Bewegungen auf Spielfeldgrenzen und Besetzung prüfen
        for (ActionType move : new ActionType[]{ActionType.MOVE_UP, ActionType.MOVE_DOWN, ActionType.MOVE_LEFT, ActionType.MOVE_RIGHT}) {
            double nx = active.posX + move.dx;
            double ny = active.posY + move.dy;

            if (nx >= 0 && nx < GRID_SIZE && ny >= 0 && ny < GRID_SIZE) {
                // Kein Überlappen auf demselben Feld
                if (!(Math.abs(nx - target.posX) < 0.001 && Math.abs(ny - target.posY) < 0.001)) {
                    actions.add(move);
                }
            }
        }

        // 3. Warten ist stets eine valide Option
        actions.add(ActionType.WAIT);
        return actions;
    }

    /**
     * Wendet eine Aktion an und liefert den Folgezustand S' zurück.
     */
    public GameState applyAction(ActionType action) {
        GameState nextState = this.clone();
        Unit active = nextState.isPlayerATurn ? nextState.unitA : nextState.unitB;
        Unit target = nextState.isPlayerATurn ? nextState.unitB : nextState.unitA;

        if (action == ActionType.ATTACK) {
            target.leben -= ATTACK_DAMAGE;
        } else if (action != ActionType.WAIT) {
            active.posX += action.dx;
            active.posY += action.dy;
        }

        // Spielerwechsel
        nextState.isPlayerATurn = !nextState.isPlayerATurn;
        return nextState;
    }

    /**
     * Heuristische Evaluierungsfunktion V(S) basierend auf 'leben'.
     */
    public double evaluate() {
        if (unitA.leben <= 0) return -10000.0;
        if (unitB.leben <= 0) return 10000.0;

        double hpWeight = 100.0;
        double distWeight = 2.0;

        double hpDiff = (unitA.leben - unitB.leben) * hpWeight;
        double distPenalty = -unitA.distanceTo(unitB) * distWeight;

        return hpDiff + distPenalty;
    }
    
    // --- Brücken-Methoden für den MoveGenerator ---
    
    public List<Unit> getAllUnits() { 
        List<Unit> allUnits = new ArrayList<>();
        if (unitA != null) allUnits.add(unitA);
        if (unitB != null) allUnits.add(unitB);
        return allUnits;
    }

    public Unit getOwnKing(int teamId) { 
        if (unitA != null && unitA.getTeam() == teamId) return unitA;
        if (unitB != null && unitB.getTeam() == teamId) return unitB;
        return null;
    }

    public Unit getEnemyKing(int teamId) { 
        if (unitA != null && unitA.getTeam() != teamId) return unitA;
        if (unitB != null && unitB.getTeam() != teamId) return unitB;
        return null;
    }

    @Override
    public GameState clone() {
        // Manuelles Kopieren der Units, um echte Unabhängigkeit im Simulationsbaum zu garantieren
        Unit clonedA = new Unit();
        clonedA.leben = this.unitA.leben;
        clonedA.maxLeben = this.unitA.maxLeben;
        clonedA.posX = this.unitA.posX;
        clonedA.posY = this.unitA.posY;
        clonedA.posZ = this.unitA.posZ;
        clonedA.team = this.unitA.team;
        clonedA.reichweite = this.unitA.reichweite;
        clonedA.maxSpeed = this.unitA.maxSpeed;

        Unit clonedB = new Unit();
        clonedB.leben = this.unitB.leben;
        clonedB.maxLeben = this.unitB.maxLeben;
        clonedB.posX = this.unitB.posX;
        clonedB.posY = this.unitB.posY;
        clonedB.posZ = this.unitB.posZ;
        clonedB.team = this.unitB.team;
        clonedB.reichweite = this.unitB.reichweite;
        clonedB.maxSpeed = this.unitB.maxSpeed;

        return new GameState(clonedA, clonedB, isPlayerATurn);
    }
