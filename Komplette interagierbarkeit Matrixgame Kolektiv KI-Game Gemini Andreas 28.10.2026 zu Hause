#!/bin/bash
echo "=================================================="
echo "[1/4] Kompiliere alle Matrixgame-Klassen..."
echo "=================================================="
javac MatrixGameMultiStreamServer.java MatrixGameJournalDashboard.java NBodySimulationPanel.java NBodySimulationEngine.java
if [ $? -ne 0 ]; then
    echo "[FEHLER] Kompilierung fehlgeschlagen! Bitte Quellcode prüfen."
