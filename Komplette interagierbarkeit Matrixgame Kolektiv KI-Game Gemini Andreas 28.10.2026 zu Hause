package com.matrixgame.gui;

import javax.swing.*;
import java.awt.*;
import java.io.BufferedReader;
import java.io.FileReader;
import java.io.File;
import java.io.IOException;
import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.util.ArrayList;
import java.util.List;

public class MatrixGameJournalDashboard extends JFrame {

    private static final String LOG_FILE_PATH = "matrixgame_journal.log";
    private static final String SERVER_TRIGGER_URL = "http://localhost:8080/api/matrixgame/trigger?quest=";
    private final JTextArea logTextArea;
    private final LoopVisualizationPanel loopPanel;
    private long lastKnownPosition = 0;
    private final HttpClient httpClient = HttpClient.newHttpClient();

    public MatrixGameJournalDashboard() {
        setTitle("Matrixgame - Interaktives Journal & Quest Control Hub");
        setSize(1000, 650);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout());

        // Left Panel: Graphical Loop Visualization
        loopPanel = new LoopVisualizationPanel();
        loopPanel.setPreferredSize(new Dimension(500, 520));

        // Right Panel: Raw Journal Stream Terminal
        logTextArea = new JTextArea();
        logTextArea.setEditable(false);
        logTextArea.setBackground(new Color(15, 18, 28));
        logTextArea.setForeground(new Color(0, 255, 170));
        logTextArea.setFont(new Font("Monospaced", Font.PLAIN, 12));
        JScrollPane scrollPane = new JScrollPane(logTextArea);
        scrollPane.setPreferredSize(new Dimension(500, 520));

        JSplitPane splitPane = new JSplitPane(JSplitPane.HORIZONTAL_SPLIT, loopPanel, scrollPane);
        splitPane.setDividerLocation(500);
        add(splitPane, BorderLayout.CENTER);

        // Bottom Panel: Interactive Control Buttons for Quest Triggering
        JPanel controlPanel = new JPanel();
        controlPanel.setBackground(new Color(30, 35, 50));
        controlPanel.setLayout(new FlowLayout(FlowLayout.CENTER, 15, 15));

        JButton btnQuest1 = createStyledButton("Trigger: Abend-Quest 1 (Ursprung)");
        btnQuest1.addActionListener(e -> sendQuestTrigger("Abend_Quest_01_Ursprung"));

        JButton btnQuest2 = createStyledButton("Trigger: Abend-Quest 2 (Netzwerk)");
        btnQuest2.addActionListener(e -> sendQuestTrigger("Abend_Quest_02_Netzwerk"));

        JButton btnEntropyReset = createStyledButton("System: Entropie-Reduktion Loop");
        btnEntropyReset.addActionListener(e -> sendQuestTrigger("Entropy_Minimization_Loop"));

        controlPanel.add(btnQuest1);
        controlPanel.add(btnQuest2);
        controlPanel.add(btnEntropyReset);

        add(controlPanel, BorderLayout.SOUTH);

        // Polling Timer for Log File (1000ms)
        Timer pollingTimer = new Timer(1000, e -> pollLogFile());
        pollingTimer.start();
    }

    private JButton createStyledButton(String text) {
        JButton button = new JButton(text);
        button.setBackground(new Color(0, 160, 220));
        button.setForeground(Color.WHITE);
        button.setFocusPainted(false);
        button.setFont(new Font("SansSerif", Font.BOLD, 12));
        button.setBorder(BorderFactory.createEmptyBorder(8, 15, 8, 15));
        return button;
    }

    private void sendQuestTrigger(String questName) {
        new Thread(() -> {
            try {
                HttpRequest request = HttpRequest.newBuilder()
                        .uri(URI.create(SERVER_TRIGGER_URL + questName))
                        .GET()
                        .build();
                HttpResponse<String> response = httpClient.send(request, HttpResponse.BodyHandlers.ofString());
                System.out.println("Triggered successfully: " + response.body());
            } catch (Exception ex) {
                SwingUtilities.invokeLater(() -> 
                    JOptionPane.showMessageDialog(this, "Fehler beim Senden des Quests an den Server:\n" + ex.getMessage(), 
                            "Verbindungsfehler", JOptionPane.ERROR_MESSAGE)
                );
            }
        }).start();
    }

    private void pollLogFile() {
        File file = new File(LOG_FILE_PATH);
        if (!file.exists()) return;

        try (BufferedReader reader = new BufferedReader(new FileReader(file))) {
            reader.skip(lastKnownPosition);
            String line;
            while ((line = reader.readLine()) != null) {
                if (!line.trim().isEmpty()) {
                    logTextArea.append(line + "\n");
                    logTextArea.setCaretPosition(logTextArea.getDocument().getLength());
                    loopPanel.addNodeFromLog(line);
                }
            }
            lastKnownPosition = file.length();
        } catch (IOException ex) {
            System.err.println("Error reading journal log: " + ex.getMessage());
        }
    }

    static class LoopVisualizationPanel extends JPanel {
        private final List<String> eventNodes = new ArrayList<>();

        public LoopVisualizationPanel() {
            setBackground(new Color(25, 28, 40));
        }

        public void addNodeFromLog(String logLine) {
            if (eventNodes.size() >= 12) {
                eventNodes.remove(0);
            }
            eventNodes.add(logLine);
            repaint();
        }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2d = (Graphics2D) g;
            g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            int width = getWidth();
            int height = getHeight();
            int centerX = width / 2;
            int centerY = height / 2;
            int radius = Math.min(width, height) / 3;

            g2d.setColor(new Color(60, 80, 120));
            g2d.setStroke(new BasicStroke(2.0f, BasicStroke.CAP_ROUND, BasicStroke.JOIN_ROUND, 0, new float[]{8}, 0));
            g2d.drawOval(centerX - radius, centerY - radius, 2 * radius, 2 * radius);

            g2d.setColor(new Color(220, 220, 255));
            g2d.setFont(new Font("SansSerif", Font.BOLD, 14));
            g2d.drawString("Fragment des Übergangs", centerX - 85, centerY - 5);
            g2d.setFont(new Font("SansSerif", Font.PLAIN, 11));
            g2d.setColor(new Color(0, 255, 170));
            g2d.drawString("Active Nodes: " + eventNodes.size(), centerX - 45, centerY + 15);

            int totalNodes = eventNodes.size();
            for (int i = 0; i < totalNodes; i++) {
                double angle = 2 * Math.PI * i / Math.max(1, totalNodes) - Math.PI / 2;
                int x = (int) (centerX + radius * Math.cos(angle));
                int y = (int) (centerY + radius * Math.sin(angle));

                g2d.setStroke(new BasicStroke(1.0f));
                g2d.setColor(new Color(100, 140, 200, 100));
                g2d.drawLine(centerX, centerY, x, y);

                g2d.setColor(new Color(0, 200, 255));
                g2d.fillOval(x - 12, y - 12, 24, 24);
                g2d.setColor(Color.WHITE);
                g2d.drawOval(x - 12, y - 12, 24, 24);

                g2d.setFont(new Font("SansSerif", Font.BOLD, 10));
                g2d.drawString("#" + (i + 1), x - 6, y + 4);
            }
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            MatrixGameJournalDashboard dashboard = new MatrixGameJournalDashboard();
            dashboard.setVisible(true);
        });
    }
}
