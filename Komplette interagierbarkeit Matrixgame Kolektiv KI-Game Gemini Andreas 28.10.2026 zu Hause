package com.matrixgame.server;

import com.sun.net.httpserver.HttpServer;
import com.sun.net.httpserver.HttpHandler;
import com.sun.net.httpserver.HttpExchange;
import java.io.IOException;
import java.io.OutputStream;
import java.net.InetSocketAddress;
import java.net.URLDecoder;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.nio.file.StandardOpenOption;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public class MatrixGameMultiStreamServer {

    private static final String JOURNAL_FILE = "matrixgame_journal.log";

    public static void startServer() throws IOException {
        int port = 8080;
        HttpServer server = HttpServer.create(new InetSocketAddress(port), 0);
        
        server.createContext("/api/matrixgame/quests", new LoggedQuestApiHandler());
        server.createContext("/api/matrixgame/logs", new JournalLogStreamHandler());
        server.createContext("/api/matrixgame/trigger", new TriggerQuestHandler());
        server.createContext("/api/matrixgame/export-json", new ExportJsonHandler());
        
        server.setExecutor(null);
        server.start();
        
        System.out.println("==================================================");
        System.out.println("[MATRIXGAME SERVER ACTIVE WITH JSON EXPORT]");
        System.out.println("JSON Export API : http://localhost:" + port + "/api/matrixgame/export-json");
        System.out.println("==================================================");
    }

    private static synchronized void recordJournalEvent(String clientAddress, String description) {
        String timestamp = LocalDateTime.now().format(DateTimeFormatter.ISO_LOCAL_DATE_TIME);
        String logEntry = String.format("[%s] CLIENT: %s | EVENT: %s | STATUS: RECORDED_IN_JOURNAL\n",
                timestamp, clientAddress, description);

        System.out.print("[JOURNAL-STREAM] " + logEntry);

        try {
            Path path = Paths.get(JOURNAL_FILE);
            Files.write(path, logEntry.getBytes(StandardCharsets.UTF_8), 
                    StandardOpenOption.CREATE, StandardOpenOption.APPEND);
        } catch (Exception e) {
            System.err.println("Failed to write to Matrixgame Journal file: " + e.getMessage());
        }
    }

    static class LoggedQuestApiHandler implements HttpHandler {
        @Override
        public void handle(HttpExchange exchange) throws IOException {
            recordJournalEvent(exchange.getRemoteAddress().toString(), "GET_QUESTS_MANIFEST");
            String jsonResponse = "{\"system_status\": \"HUMAN_NODE_VERIFIED\", \"user_identity\": \"Andreas Schneider\"}";
            sendResponse(exchange, jsonResponse, "application/json");
        }
    }

    static class JournalLogStreamHandler implements HttpHandler {
        @Override
        public void handle(HttpExchange exchange) throws IOException {
            Path path = Paths.get(JOURNAL_FILE);
            String logContent = Files.exists(path) ? Files.readString(path, StandardCharsets.UTF_8) : "";
            sendResponse(exchange, logContent, "text/plain");
        }
    }

    static class TriggerQuestHandler implements HttpHandler {
        @Override
        public void handle(HttpExchange exchange) throws IOException {
            String query = exchange.getRequestURI().getQuery();
            Map<String, String> params = parseQuery(query);
            
            String questName = params.getOrDefault("quest", "Unknown_Quest");
            String infection = params.getOrDefault("infection", "0.5");
            String entropy = params.getOrDefault("entropy", "1.0");
            
            String eventDetails = String.format("TRIGGER_QUEST: %s [Infektion: %s, Entropie: %s]", questName, infection, entropy);
            recordJournalEvent(exchange.getRemoteAddress().toString(), eventDetails);

            String jsonResponse = String.format("{\"status\":\"SUCCESS\",\"quest\":\"%s\",\"infection\":%s,\"entropy\":%s}", 
                    questName, infection, entropy);
            sendResponse(exchange, jsonResponse, "application/json");
        }
    }

    static class ExportJsonHandler implements HttpHandler {
        @Override
        public void handle(HttpExchange exchange) throws IOException {
            Path path = Paths.get(JOURNAL_FILE);
            StringBuilder jsonBuilder = new StringBuilder();
            jsonBuilder.append("{\n  \"export_timestamp\": \"")
                       .append(LocalDateTime.now().format(DateTimeFormatter.ISO_LOCAL_DATE_TIME))
                       .append("\",\n  \"system\": \"Matrixgame Journal\",\n  \"entries\": [\n");

            if (Files.exists(path)) {
                List<String> lines = Files.readAllLines(path, StandardCharsets.UTF_8);
                for (int i = 0; i < lines.size(); i++) {
                    String line = lines.get(i).replace("\"", "\\\"");
                    jsonBuilder.append("    {\"line_id\": ").append(i + 1)
                               .append(", \"raw_log\": \"").append(line).append("\"}");
                    if (i < lines.size() - 1) {
                        jsonBuilder.append(",");
                    }
                    jsonBuilder.append("\n");
                }
            }

            jsonBuilder.append("  ]\n}");
            recordJournalEvent(exchange.getRemoteAddress().toString(), "EXPORT_JSON_REPORT");
            sendResponse(exchange, jsonBuilder.toString(), "application/json");
        }
    }

    private static Map<String, String> parseQuery(String query) {
        Map<String, String> result = new HashMap<>();
        if (query == null) return result;
        for (String param : query.split("&")) {
            String[] entry = param.split("=");
            if (entry.length > 1) {
                result.put(URLDecoder.decode(entry[0], StandardCharsets.UTF_8), 
                           URLDecoder.decode(entry[1], StandardCharsets.UTF_8));
            } else {
                result.put(URLDecoder.decode(entry[0], StandardCharsets.UTF_8), "");
            }
        }
        return result;
    }

    private static void sendResponse(HttpExchange exchange, String response, String contentType) throws IOException {
        exchange.getResponseHeaders().set("Content-Type", contentType + "; charset=UTF-8");
        exchange.getResponseHeaders().set("Access-Control-Allow-Origin", "*");
        byte[] bytes = response.getBytes(StandardCharsets.UTF_8);
        exchange.sendResponseHeaders(200, bytes.length);
        OutputStream os = exchange.getResponseBody();
        os.write(bytes);
        os.close();
    }

    public static void main(String[] args) {
        try {
            startServer();
        } catch (IOException e) {
            e.printStackTrace();
        }
    }
}
