package com.matrixgame.server;

import com.sun.net.httpserver.HttpServer;
import com.sun.net.httpserver.HttpHandler;
import com.sun.net.httpserver.HttpExchange;
import java.io.IOException;
import java.io.OutputStream;
import java.net.InetSocketAddress;

/**
 * MatrixGame Local Server running on Port 8080.
 * Exposes the Fragment des Übergangs & Quest Interface API.
 */
public class MatrixGameServer {

    public static void startServer() throws IOException {
        int port = 8080;
        HttpServer server = HttpServer.create(new InetSocketAddress(port), 0);
        
        // Context endpoint for the Matrixgame quests
        server.createContext("/api/matrixgame/quests", new QuestApiHandler());
        server.setExecutor(null); // creates a default executor
        server.start();
        
        System.out.println("Matrixgame Server successfully started on port " + port);
        System.out.println("Endpoint active: http://localhost:" + port + "/api/matrixgame/quests");
    }

    static class QuestApiHandler implements HttpHandler {
        @Override
        public void handle(HttpExchange exchange) throws IOException {
            // JSON Response Payload reflecting the 'Fragment des Übergangs' loop
            String jsonResponse = "{\n" +
