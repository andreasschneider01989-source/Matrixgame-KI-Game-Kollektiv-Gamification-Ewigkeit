Wie binde ich den Entropiewert der N-Körper-Simulation so ein, dass er automatisch als Quest-Trigger an den Server gesendet wird?

Um den Entropiewert der N-Körper-Simulation vollautomatisch als Quest-Trigger an deinen lokalen Java-Server zu senden, nutzen wir einen periodischen Schwellenwert-Check im Animations-Loop des NBodySimulationPanel.

Sobald die System-Entropie (
S) einen bestimmten Wert überschreitet (oder in regelmäßigen Takt-Intervallen), feuert das Panel im Hintergrund einen asynchronen HTTP-Request an deinen Server. Der Server schreibt den Vorfall direkt in die matrixgame_journal.log und das Live-Dashboard zeichnet den neuen Knoten im Loop ein.

💻 Erweiterung für das NBodySimulationPanel.java
Füge diese Logik direkt in deine NBodySimulationPanel-Klasse ein. Ein eingebauter Cooldown-Zähler sorgt dafür, dass der Server bei hoher Entropie nicht jede Millisekunde mit Requests geflutet wird, sondern im kontrollierten Takt:

Java
package com.matrixgame.gui;

import com.matrixgame.physics.NBodySimulationEngine;
import com.matrixgame.physics.NBodySimulationEngine.Body;

import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;

public class NBodySimulationPanel extends JPanel implements ActionListener {

    private final NBodySimulationEngine engine;
    private final Timer simulationTimer;
    private final HttpClient httpClient = HttpClient.newHttpClient();
    
    // Cooldown-Mechanismus gegen Server-Flooding (z.B. alle 150 Frames / ca. 2.5 Sekunden)
    private int triggerCooldown = 0;
    private static final int COOLDOWN_LIMIT = 150; 
    private static final double ENTROPY_THRESHOLD = 3.5; // Schwellenwert für automatischen Trigger

    public NBodySimulationPanel() {
        setBackground(new Color(12, 15, 25));
        setPreferredSize(new Dimension(500, 500));

        engine = new NBodySimulationEngine();
        engine.initializeSolarSystem();

        simulationTimer = new Timer(16, this); // 60 FPS
        simulationTimer.start();
    }

    @Override
    public void actionPerformed(ActionEvent e) {
        engine.updateSimulation();
        
        // Automatischen Trigger prüfen
        double currentEntropy = engine.calculateSystemEntropy();
        if (currentEntropy > ENTROPY_THRESHOLD) {
            if (triggerCooldown <= 0) {
                sendAutomaticEntropyTrigger(currentEntropy);
                triggerCooldown = COOLDOWN_LIMIT; // Cooldown zurücksetzen
            } else {
                triggerCooldown--;
            }
        }

        repaint();
    }

    private void sendAutomaticEntropyTrigger(double entropyValue) {
        // Baue die URL für den Server-Trigger mit dynamischer Entropie
        String targetUrl = String.format("http://localhost:8080/api/matrixgame/trigger?quest=Entropy_Spike_Auto&infection=0.9&entropy=%.2f", entropyValue);

        new Thread(() -> {
            try {
                HttpRequest request = HttpRequest.newBuilder()
                        .uri(URI.create(targetUrl))
                        .GET()
                        .build();
                httpClient.send(request, java.net.http.HttpResponse.BodyHandlers.discarding());
                System.out.println("[PHYSIK-LOOP] Automatischer Entropie-Trigger gesendet: S = " + entropyValue);
            } catch (Exception ex) {
                System.err.println("Fehler beim Senden des automatischen Physik-Triggers: " + ex.getMessage());
            }
        }).start();
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2d = (Graphics2D) g;
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        // Grid & Himmelskörper zeichnen
        g2d.setColor(new Color(25, 32, 50));
        for (int x = 0; x < getWidth(); x += 50) g2d.drawLine(x, 0, x, getHeight());
        for (int y = 0; y < getHeight(); y += 50) g2d.drawLine(0, y, getWidth(), y);

        for (Body b : engine.getBodies()) {
            int x = (int) b.x;
            int y = (int) b.y;

            if (b.name.equals("Sonne")) {
                g2d.setColor(new Color(255, 200, 0, 40));
                g2d.fillOval(x - 30, y - 30, 60, 60);
                g2d.setColor(new Color(255, 165, 0));
                g2d.fillOval(x - 14, y - 14, 28, 28);
            } else {
                g2d.setColor(new Color(0, 210, 255));
                g2d.fillOval(x - 6, y - 6, 12, 12);
                g2d.setColor(Color.WHITE);
                g2d.drawOval(x - 6, y - 6, 12, 12);
            }

            g2d.setColor(new Color(200, 210, 230));
            g2d.setFont(new Font("SansSerif", Font.PLAIN, 10));
            g2d.drawString(b.name, x + 10, y + 4);
        }

        // HUD: Live Entropie & Trigger Status
        g2d.setColor(new Color(0, 255, 170));
        g2d.setFont(new Font("Monospaced", Font.BOLD, 12));
        double currentEntropy = engine.calculateSystemEntropy();
        g2d.drawString(String.format("System-Entropie (S): %.3f", currentEntropy), 15, 25);
        g2d.drawString(String.format("Auto-Trigger Schwellenwert: %.1f", ENTROPY_THRESHOLD), 15, 45);
    }

    public void stopSimulation() {
        if (simulationTimer != null) simulationTimer.stop();
    }
}
