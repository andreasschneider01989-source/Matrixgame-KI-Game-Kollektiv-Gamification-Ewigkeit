💻 Java-Initialisierungsmethode (initializeSolarSystem)
Füge diese Methode in deine NBodySimulationEngine ein, um ein stabiles System aus einer Zentralsonne und umkreisenden Planeten zu erzeugen:

Java
    public void initializeSolarSystem() {
        bodies.clear();

        // 1. Skalierte physikalische Parameter für stabile Bildschirmkoordinaten
        double G_SCALED = 1.0; 
        double centerX = 500.0; // Bildschirmmitte X
        double centerY = 400.0; // Bildschirmmitte Y

        // 2. Zentralkörper (Sonne) im Ursprung mit großer Masse
        double sunMass = 5000.0;
        bodies.add(new Body("Sonne", sunMass, centerX, centerY, 0.0, 0.0));

        // 3. Planeten hinzufügen (Abstand r, Masse, Name)
        addOrbitingBody("Planet Alpha", 1.0, centerX, centerY, 120.0, sunMass, G_SCALED, 0, -1);
        addOrbitingBody("Planet Beta", 2.5, centerX, centerY, 220.0, sunMass, G_SCALED, 0, 1);
        addOrbitingBody("Planet Gamma", 0.5, centerX, centerY, 320.0, sunMass, G_SCALED, 0, -1);
    }

    /**
     * Hilfsmethode zur präzisen Berechnung des orthogonalen Geschwindigkeitsvektors für Kreisbahnen.
     */
    private void addOrbitingBody(String name, double mass, double cx, double cy, double r, double mCentral, double g, int dirX, int dirY) {
        // Bahngeschwindigkeit nach vis-à-vis / Kreisbahn-Formel
        double v = Math.sqrt((g * mCentral) / r);

        // Position auf der X-Achse versetzt vom Zentrum
        double px = cx + r;
        double py = cy;

        // Geschwindigkeit senkrecht zur Position (Orthogonaler Vektor)
        double vx = 0.0;
        double vy = v * dirY; // Richtung steuert den Uhrzeigersinn / gegen den Uhrzeigersinn

        bodies.add(new Body(name, mass, px, py, vx, vy));
    }
