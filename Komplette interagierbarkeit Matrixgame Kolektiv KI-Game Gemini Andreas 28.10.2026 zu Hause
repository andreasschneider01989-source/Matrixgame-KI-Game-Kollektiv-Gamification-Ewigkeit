package com.matrixgame.physics;

import java.util.ArrayList;
import java.util.List;

public class NBodySimulationEngine {

    public static class Body {
        public String name;
        public double mass;
        public double x, y;       // Position
        public double vx, vy;     // Velocity
        public double ax, ay;     // Acceleration

        public Body(String name, double mass, double x, double y, double vx, double vy) {
            this.name = name;
            this.mass = mass;
            this.x = x;
            this.y = y;
            this.vx = vx;
            this.vy = vy;
            this.ax = 0;
            this.ay = 0;
        }
    }

    private final List<Body> bodies = new ArrayList<>();
    private final double G = 6.67430e-11; // Gravitationskonstante (skaliert für Simulation)
    private double timeStep = 0.5;

    public void addBody(Body body) {
        bodies.add(body);
    }

    public void updateSimulation() {
        int n = bodies.size();
        
        // 1. Beschleunigungen zurücksetzen
        for (Body b : bodies) {
            b.ax = 0;
            b.ay = 0;
        }

        // 2. Gravitationskräfte zwischen allen Körpern berechnen (Newton'sches Gesetz)
        for (int i = 0; i < n; i++) {
            Body bi = bodies.get(i);
            for (int j = i + 1; j < n; j++) {
                Body bj = bodies.get(j);

                double dx = bj.x - bi.x;
                double dy = bj.y - bi.y;
                double distSqr = dx * dx + dy * dy + 1e-9; // Weichheitsfaktor gegen Division durch 0
                double dist = Math.sqrt(distSqr);

                // F = G * (m1 * m2) / r^2  =>  a = F / m
                double forceMagnitude = (G * bi.mass * bj.mass) / distSqr;
                double fx = forceMagnitude * (dx / dist);
                double fy = forceMagnitude * (dy / dist);

                bi.ax += fx / bi.mass;
                bi.ay += fy / bi.mass;
                bj.ax -= fx / bj.mass;
                bj.ay -= fy / bj.mass;
            }
        }

        // 3. Integration (Euler-Verfahren: Position & Geschwindigkeit aktualisieren)
        for (Body b : bodies) {
            b.vx += b.ax * timeStep;
            b.vy += b.ay * timeStep;
            b.x += b.vx * timeStep;
            b.y += b.vy * timeStep;
        }
    }

    /**
     * Berechnet die System-Entropie basierend auf der kinetischen Energie-Dispersion.
     */
    public double calculateSystemEntropy() {
        double totalKineticEnergy = 0;
        for (Body b : bodies) {
            double speedSqr = b.vx * b.vx + b.vy * b.vy;
            totalKineticEnergy += 0.5 * b.mass * speedSqr;
        }
        // Logarithmische Entropie-Abbildung für den Matrixgame-Loop
        return Math.log(1.0 + totalKineticEnergy);
    }

    public List<Body> getBodies() {
        return bodies;
    }
}
