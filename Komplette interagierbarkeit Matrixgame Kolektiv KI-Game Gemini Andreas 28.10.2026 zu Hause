public class MatrixGameQuestInterface implements Serializable {

    private static final long serialVersionUID = 1L;

    private String systemStatus;
    private String userIdentity;
    private String entryPoint;
    private List<QuestNode> questSequence;

    public MatrixGameQuestInterface() {
        this.systemStatus = "HUMAN_NODE_VERIFIED";
        this.userIdentity = "Andreas Schneider";
        this.entryPoint = "Fragment_des_Uebergangs_Loop_001";
        this.questSequence = new ArrayList<>();
        initializeDefaultQuests();
    }

    private void initializeDefaultQuests() {
        // Quest 1: Der Ursprung & Die Schleife
        QuestNode q1 = new QuestNode(
            "abend_quest_01",
            "Der Ursprung & Die Schleife",
            "didaktische_regeneration",
            1.0,
            0.85,
            "abend_quest_02"
