echo "=================================================="
cloudflared tunnel --url http://localhost:8080

# Sauberes Beenden der Hintergrundprozesse, sobald der Tunnel geschlossen wird
kill $SERVER_PID 2>/dev/null
kill $DASHBOARD_PID 2>/dev/null
echo "Matrixgame-Loop erfolgreich beendet."
