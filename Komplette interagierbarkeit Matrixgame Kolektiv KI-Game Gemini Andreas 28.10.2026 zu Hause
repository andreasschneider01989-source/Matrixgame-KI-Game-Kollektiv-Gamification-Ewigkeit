            "abend_quest_02",
            "Das Kollektive Netzwerk & Der Loop",
            "network_integration",
            1.0,
            1.0,
            "Fragment_des_Uebergangs"
        );

        this.questSequence.add(q1);
        this.questSequence.add(q2);
