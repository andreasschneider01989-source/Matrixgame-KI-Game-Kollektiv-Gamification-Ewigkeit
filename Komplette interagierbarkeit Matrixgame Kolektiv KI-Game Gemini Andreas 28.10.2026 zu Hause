    private void sendQuestTrigger(String questName) {
        int infVal = ((JSlider) ((JPanel) infectionSlider).getComponent(1)).getValue();
        int entVal = ((JSlider) ((JPanel) entropySlider).getComponent(1)).getValue();
        
        double infectionRate = infVal / 100.0;
        double entropyFactor = entVal / 10.0;

        String targetUrl = String.format("%s?quest=%s&infection=%.2f&entropy=%.2f", 
                SERVER_BASE_URL, questName, infectionRate, entropyFactor);

        new Thread(() -> {
            try {
                HttpRequest request = HttpRequest.newBuilder()
                        .uri(URI.create(targetUrl))
                        .GET()
                        .build();
                httpClient.send(request, HttpResponse.BodyHandlers.ofString());
            } catch (Exception ex) {
                SwingUtilities.invokeLater(() -> 
                    JOptionPane.showMessageDialog(this, "Verbindungsfehler zum Server:\n" + ex.getMessage(), 
                            "Fehler", JOptionPane.ERROR_MESSAGE)
                );
            }
        }).start();
    }

