def analyze_matrixgame_report(file_path="matrixgame_report.json"):
    if not os.path.exists(file_path):
        print(f"[FEHLER] Die Datei '{file_path}' wurde nicht gefunden.")
        print("Bitte exportiere den Bericht zuerst über das Java Swing Dashboard.")
        return

    try:
        with open(file_path, "r", encoding="utf-8") as f:
            data = json.load(f)
    except json.JSONDecodeError:
        print("[FEHLER] Die Datei ist kein gültiges JSON-Format.")
        return

    entries = data.get("entries", [])
    export_time = data.get("export_timestamp", "Unbekannt")
    
    print("==================================================")
    print(f" MATRIXGAME JOURNAL - DATENANALYSE")
    print(f" Export-Zeitstempel : {export_time}")
    print(f" Gesamt-Einträge    : {len(entries)}")
    print("==================================================")

    infection_values = []
    entropy_values = []
    quest_counts = {}

    # Regex zum Extrahieren von Parametern und Quest-Namen aus den Raw-Logs
    param_pattern = re.compile(r"Infektion:\s*([\d.]+),\s*Entropie:\s*([\d.]+)")
    quest_pattern = re.compile(r"TRIGGER_QUEST:\s*([^\s\[]+)")

    for entry in entries:
        raw_log = entry.get("raw_log", "")
        
        # Parameter extrahieren
        match = param_pattern.search(raw_log)
        if match:
            infection_values.append(float(match.group(1)))
            entropy_values.append(float(match.group(2)))

        # Quest-Namen extrahieren
        q_match = quest_pattern.search(raw_log)
        if q_match:
            q_name = q_match.group(1)
            quest_counts[q_name] = quest_counts.get(q_name, 0) + 1

    print("\n[ QUEST-AUSLASTUNG ]")
    if quest_counts:
        for quest, count in quest_counts.items():
            print(f"  - {quest}: {count}x ausgeführt")
    else:
        print("  Keine aktiven Quest-Trigger in den Logs gefunden.")

    print("\n[ PARAMETER-STATISTIK ]")
    if infection_values:
        avg_inf = sum(infection_values) / len(infection_values)
        avg_ent = sum(entropy_values) / len(entropy_values)
        print(f"  - Durchschnittliche Infektionsrate : {avg_inf * 100:.1f}%")
        print(f"  - Durchschnittlicher Entropie-Faktor: {avg_ent:.2f}x")
        print(f"  - Maximale Infektionsrate          : {max(infection_values) * 100:.1f}%")
        print(f"  - Maximaler Entropie-Faktor        : {max(entropy_values):.2f}x")
    else:
        print("  Keine quantitativen Parameter-Werte erfasst.")
    print("==================================================")

if __name__ == "__main__":
    target_file = sys.argv[1] if len(sys.argv) > 1 else "matrixgame_report.json"
    analyze_matrixgame_report(target_file)
