    // ===== IOO =====
    private void verarbeiteInput(String input) {
        if (input == null || input.isEmpty()) return;
        String befehl = input.trim().toLowerCase();

        log("> " + input);
        iooHistorie.add(input);

        if (befehl.equals("hilfe")) {
            log("Befehle: status | turm | xp <n> | p <id> <wert> | test <p> | zeichne | clear | exit");
        } else if (befehl.equals("status")) {
            log(statusText());
        } else if (befehl.equals("turm")) {
            turmAnzeigen();
        } else if (befehl.startsWith("xp ")) {
            try {
                double n = Double.parseDouble(befehl.substring(3));
                addXp(n);
            } catch (NumberFormatException ex) {
                log("Fehler: XP-Zahl ungültig.");
            }
        } else if (befehl.startsWith("p ")) {
            String[] parts = befehl.split(" ");
            if (parts.length >= 3) {
                try {
                    int id = Integer.parseInt(parts[1]);
                    double wert = Double.parseDouble(parts[2]);
                    setP(id, wert);
                } catch (Exception ex) {
                    log("Fehler: 'p <id> <wert>' erwartet.");
                }
            }
        } else if (befehl.startsWith("test ")) {
            try {
                double p = Double.parseDouble(befehl.substring(5));
                boolean erfolg = Math.random() < p;
                log("Test mit P=" + p + " → " + (erfolg ? "ERFOLG" : "MISSERFOLG"));
                canvas.maleTest(p, erfolg);
                canvas.repaint();
            } catch (NumberFormatException ex) {
                log("Fehler: P-Zahl ungültig.");
            }
        } else if (befehl.equals("zeichne")) {
            canvas.maleTurm(turm);
            canvas.repaint();
            log("Turm gezeichnet.");
        } else if (befehl.equals("clear")) {
            canvas.clear();
            canvas.repaint();
            log("Canvas geleert.");
        } else if (befehl.equals("exit")) {
            log("Beende...");
            System.exit(0);
        } else {
            log("Unbekannter Befehl. 'hilfe' für Hilfe.");
        }

        inputField.setText("");
        statusLabel.setText(statusText());
    }

    // ===== Turm anzeigen =====
    private void turmAnzeigen() {
        log("=== Didaktischer Turm ===");
        for (Stufe s : turm) {
            String status = s.freigeschaltet ? "✅" : "🔒";
            log(String.format("%s Stufe %2d | P=%.2f | XP=%4d | %s",
                    status, s.nummer, s.p, s.xpBenoetigt, s.name));
        }
    }

    // ===== P setzen =====
    private void setP(int nummer, double wert) {
        for (Stufe s : turm) {
            if (s.nummer == nummer) {
                s.p = Math.max(0, Math.min(1, wert));
                log("P(Stufe " + nummer + ") = " + s.p);
                return;
            }
        }
        log("Stufe nicht gefunden.");
    }

    // ===== XP =====
    private void addXp(double xp) {
        xpGesamt += xp;
        level = (int) Math.floor(xpGesamt / 1000) + 1;
        log(String.format("XP +%.2f → Gesamt %.2f | Level %d", xp, xpGesamt, level));
        turmFreischalten();
    }

    private void turmFreischalten() {
        double summe = 0;
        for (Stufe s : turm) {
            summe += s.xpBenoetigt;
            if (xpGesamt >= summe && s.p >= 0.5) {
                s.freigeschaltet = true;
            }
        }
    }

    private String statusText() {
        return String.format("XP: %.2f | Level: %d | Turmstufen frei: %d/24",
                xpGesamt, level, turm.stream().filter(s -> s.freigeschaltet).count());
    }

    private void log(String text) {
        outputArea.append(text + "\n");
        outputArea.setCaretPosition(outputArea.getDocument().getLength());
    }

    // ===== Canvas =====
    public static class CanvasPanel extends JPanel {
        private final List<int[]> pixel = new ArrayList<>();
        private boolean turmModus = false;
        private List<Stufe> turmRef = null;

        public void maleTest(double p, boolean erfolg) {
            int x = (int) (Math.random() * getWidth());
            int y = (int) (Math.random() * getHeight());
            int groesse = (int) (p * 30) + 5;
            Color c = erfolg ? new Color(0, 200, 100) : new Color(200, 50, 50);
            pixel.add(new int[]{x, y, groesse, c.getRGB()});
        }

        public void maleTurm(List<Stufe> turm) {
            this.turmRef = turm;
            this.turmModus = true;
        }

        public void clear() {
            pixel.clear();
            turmModus = false;
            turmRef = null;
        }

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2 = (Graphics2D) g;
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING,
                    RenderingHints.VALUE_ANTIALIAS_ON);

            // Hintergrund
            g2.setColor(new Color(10, 10, 30));
            g2.fillRect(0, 0, getWidth(), getHeight());

            // Pixel
            for (int[] p : pixel) {
                g2.setColor(new Color(p[3]));
                g2.fillOval(p[0], p[1], p[2], p[2]);
            }

            // Turm
            if (turmModus && turmRef != null) {
                int stufenHoehe = getHeight() / 24;
                for (Stufe s : turmRef) {
                    int y = getHeight() - (s.nummer * stufenHoehe) - stufenHoehe;
                    int x = 20 + (s.nummer % 3) * 20;
                    int breite = getWidth() - 40 - (s.nummer % 3) * 20;
                    int r = (int) (s.p * 255);
                    int bl = (int) ((1 - s.p) * 255);
                    g2.setColor(new Color(r, 100, bl));
                    g2.fillRect(x, y, breite, stufenHoehe - 2);
                    g2.setColor(Color.WHITE);
                    g2.setFont(new Font("SansSerif", Font.PLAIN, 10));
                    g2.drawString(s.nummer + " " + s.name, x + 5, y + stufenHoehe - 5);
                }
            }
        }
    }

    // ===== Main =====
    public static void main(String[] args) {
        SwingUtilities.invokeLater(MatrixgameDidaktischerTurm::new);
    }
