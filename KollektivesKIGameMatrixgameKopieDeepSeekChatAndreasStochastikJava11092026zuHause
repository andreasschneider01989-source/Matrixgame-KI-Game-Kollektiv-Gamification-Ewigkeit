package de.matrixgame.stochastik;

import java.io.*;
import java.util.*;

/**
 * MatrixgamePValues
 * Stochastische Bewertung von Aussagen und Hypothesen.
 * Compilierbar mit Java 17+.
 *
 * Autor: Andreas Schneider & Kollektive KI
 * Datum: 2026
 * Lizenz: Open Source (OSL-2)
 */
public class MatrixgamePValues {

    // ===== Datenklasse =====
    public static class Aussage {
        public String id;
        public String text;
        public double p;
        public String quelle;
        public String bedingung;
        public int xp;

        public Aussage(String id, String text, double p, String quelle, String bedingung) {
            this.id = id;
            this.text = text;
            this.p = p;
            this.quelle = quelle;
            this.bedingung = bedingung;
            this.xp = 0;
        }

        @Override
        public String toString() {
            return String.format("[%s] P=%.4f | XP=%d | %s | Q=%s | B=%s",
                    id, p, xp, text, quelle, bedingung);
        }
    }

    // ===== Speicher =====
    private final Map<String, Aussage> aussagen = new LinkedHashMap<>();

    // ===== XP & Level =====
    private double xpGesamt = 0;
    private int level = 1;

    // ===== Statistik =====
    private final List<Double> testErgebnisse = new ArrayList<>();

    // ===== Axiome hinzufügen =====
    public void addAussage(Aussage a) {
        aussagen.put(a.id, a);
    }

    // ===== Stochastik =====
    public double komplement(double p) {
        return 1.0 - p;
    }

    public double vereinigung(double pA, double pB, double pAB) {
        return pA + pB - pAB;
    }

    public double bedingteWahrscheinlichkeit(double pAB, double pB) {
        if (pB <= 0) return 0;
        return pAB / pB;
    }

    public double bayes(double pA, double pBgegebenA, double pB) {
        if (pB <= 0) return 0;
        return (pBgegebenA * pA) / pB;
    }

    public double erwartungswert(double[] werte, double[] wahrscheinlichkeiten) {
        double e = 0;
        for (int i = 0; i < werte.length; i++) {
            e += werte[i] * wahrscheinlichkeiten[i];
        }
        return e;
    }

    public double varianz(double[] werte, double[] wahrscheinlichkeiten, double mu) {
        double v = 0;
        for (int i = 0; i < werte.length; i++) {
            v += wahrscheinlichkeiten[i] * Math.pow(werte[i] - mu, 2);
        }
        return v;
    }

    // ===== Boolesche Algebra =====
    public double und(double pA, double pB) {
        return pA * pB;
    }

    public double oder(double pA, double pB) {
        return pA + pB - pA * pB;
    }

    public double nicht(double pA) {
        return 1.0 - pA;
    }

    public double xor(double pA, double pB) {
        return pA + pB - 2 * pA * pB;
    }

    // ===== Spieltheorie =====
    public double xpBerechnen(double basis, double schwierigkeit,
                              double begeisterung, double kollektiv,
                              double wiederholung, double kooperation) {
        return basis * schwierigkeit
                * (1 + begeisterung / 100.0)
                * (1 + kollektiv)
                * (1 - wiederholung)
                * kooperation;
    }

    // ===== Zufall & Test =====
    public boolean zufallsTest(double p) {
        return Math.random() < p;
    }

    public double zufallsWert() {
        return Math.random();
    }

    public double[] binomialVerteilung(int n, double p) {
        double[] verteilung = new double[n + 1];
        for (int k = 0; k <= n; k++) {
            verteilung[k] = binomialKoeffizient(n, k)
                    * Math.pow(p, k)
                    * Math.pow(1 - p, n - k);
        }
        return verteilung;
    }

    private long binomialKoeffizient(int n, int k) {
        if (k < 0 || k > n) return 0;
        long result = 1;
        for (int i = 1; i <= k; i++) {
            result = result * (n - k + i) / i;
        }
        return result;
    }

    // ===== Statistik =====
    public void protokolliere(double wert) {
        testErgebnisse.add(wert);
    }

    public double mittelwert() {
        if (testErgebnisse.isEmpty()) return 0;
        double sum = 0;
        for (double v : testErgebnisse) sum += v;
        return sum / testErgebnisse.size();
    }

    public double standardabweichung() {
        if (testErgebnisse.size() < 2) return 0;
        double mu = mittelwert();
        double sum = 0;
        for (double v : testErgebnisse) {
            sum += Math.pow(v - mu, 2);
        }
        return Math.sqrt(sum / (testErgebnisse.size() - 1));
    }

    // ===== XP & Level =====
    public void addXp(double xp) {
        this.xpGesamt += xp;
        this.level = (int) Math.floor(xpGesamt / 1000) + 1;
    }

    public double getXpGesamt() { return xpGesamt; }
    public int getLevel() { return level; }

    // ===== Speichern & Laden =====
    public void speichern(String datei) throws IOException {
        try (PrintWriter pw = new PrintWriter(new FileWriter(datei))) {
            pw.println("# Matrixgame P-Values Speicher");
            pw.println("XP=" + xpGesamt);
            pw.println("LEVEL=" + level);
            for (Aussage a : aussagen.values()) {
                pw.println("A|" + a.id + "|" + a.p + "|" + a.xp + "|" + a.text);
            }
        }
    }

    public void laden(String datei) throws IOException {
        try (BufferedReader br = new BufferedReader(new FileReader(datei))) {
            String line;
            while ((line = br.readLine()) != null) {
                if (line.startsWith("XP=")) {
                    xpGesamt = Double.parseDouble(line.substring(3));
                } else if (line.startsWith("LEVEL=")) {
                    level = Integer.parseInt(line.substring(6));
                } else if (line.startsWith("A|")) {
                    String[] parts = line.split("\\|", 5);
                    if (parts.length == 5) {
                        Aussage a = new Aussage(parts[1], parts[4],
                                Double.parseDouble(parts[2]), "?", "?");
                        a.xp = Integer.parseInt(parts[3]);
                        aussagen.put(a.id, a);
                    }
                }
            }
        }
    }

    // ===== Ausgabe =====
    public void printAlle() {
        System.out.println("=== Aussagen & P-Werte ===");
        for (Aussage a : aussagen.values()) {
            System.out.println(a);
        }
    }

    public void printStatistik() {
        System.out.printf("XP: %.2f | Level: %d%n", xpGesamt, level);
        System.out.printf("Tests: %d | Mittelwert: %.4f | StdAbw: %.4f%n",
                testErgebnisse.size(), mittelwert(), standardabweichung());
    }

    // ===== Main – Test & Spiel =====
    public static void main(String[] args) throws IOException {
        MatrixgamePValues game = new MatrixgamePValues();

        // Beispielaussagen aus der Formelsammlung
        game.addAussage(new Aussage("A1", "a + b = b + a",
                1.00, "Axiom", "Mathematik"));
        game.addAussage(new Aussage("A2", "F = m · a",
                0.9999, "Newton", "v << c"));
        game.addAussage(new Aussage("A3", "S = k · ln(Ω)",
                0.99, "Boltzmann", "stat. Mechanik"));
        game.addAussage(new Aussage("A4", "Bewusstsein als Kraft",
                0.427, "Spekulation", "offen"));
        game.addAussage(new Aussage("A5", "Sechstel-Elektronen",
                0.30, "Hypothese", "zu prüfen"));
        game.addAussage(new Aussage("A6", "Quantenresonanz",
                0.50, "Spielmetapher", "Spiel"));

        game.printAlle();

        System.out.println("\n=== Zufallstest: 100 Würfe mit P=0.5 ===");
        int treffer = 0;
        for (int i = 0; i < 100; i++) {
            if (game.zufallsTest(0.5)) treffer++;
        }
        System.out.println("Treffer: " + treffer + "/100");
        game.protokolliere(treffer / 100.0);

        System.out.println("\n=== Binomialverteilung n=10, p=0.5 ===");
        double[] verteilung = game.binomialVerteilung(10, 0.5);
        for (int k = 0; k < verteilung.length; k++) {
            System.out.printf("P(k=%d) = %.5f%n", k, verteilung[k]);
        }

        System.out.println("\n=== Bayes-Update ===");
        double pAlt = 0.5;
        double pEgegebenH = 0.9;
        double pE = 0.6;
        double pNeu = game.bayes(pAlt, pEgegebenH, pE);
        System.out.printf("P_neu = %.4f%n", pNeu);

        System.out.println("\n=== XP-Berechnung ===");
        double xp = game.xpBerechnen(100, 1.5, 82, 0.75, 0.0, 1.5);
        System.out.printf("XP = %.2f%n", xp);
        game.addXp(xp);

        game.printStatistik();

        // Speichern
        game.speichern("matrixgame_pvalues.txt");
        System.out.println("\nGespeichert: matrixgame_pvalues.txt");
    }
}

