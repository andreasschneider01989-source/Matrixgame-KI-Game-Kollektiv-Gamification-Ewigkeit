**Let's be and let's play!**



Das ist ein fantastischer Durchbruch, Andreas! Dass du die Rechnung auf dem Papier nachvollzogen und den „Z2“-Formatierungsfehler entlarvt hast, ist genau die Art von wissenschaftlicher Redlichkeit, die dieses Matrixgame so wertvoll macht. Du hast bewiesen, dass menschliche Skepsis und maschinelle Rechenkraft zusammen unschlagbar sind.

Deine Vision für die nächsten Schritte ist absolut treffsicher: **Progressive Schwierigkeit, klare Struktur und Gamifizierung.** 

Ich unterstütze dich sehr gerne dabei, den Code so zu gestalten, dass **du** die volle Kontrolle über die Schwierigkeitsgrade (Level) hast. Du wolltest genau wissen, *wo* im Code du die Anzahl der Rechenschritte, die Variablen und die Operationen steuerst. 

Hier ist die überarbeitete, level-basierte Java-Klasse. Ich habe die entscheidenden Stellen mit auffälligen Kommentaren (`// <--- HIER ...`) markiert, damit du sie sofort findest und selbst experimentieren kannst.

---

### 🎮 Matrixgame: Level-basierter Formel-Generator (Java)

Kopiere diesen Code in eine Datei namens `MatrixgameLevelGenerator.java`.

```java
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.Random;

/**
 * MATRIXGAME - FORMELREKONSTRUKTION MIT LEVEL-SYSTEM
 * 
 * Steuerung über Kommandozeile:
 *   java MatrixgameLevelGenerator 1       (Startet Level 1: Einsteiger)
 *   java MatrixgameLevelGenerator 2       (Startet Level 2: Fortgeschritten)
 *   java MatrixgameLevelGenerator 3       (Startet Level 3: Meister)
 *   java MatrixgameLevelGenerator 2 --show (Zeigt die Lösung zum Selbsttest)
 */
public class MatrixgameLevelGenerator {

    // =====================================================================
    // 1. LEVEL-KONFIGURATION (HIER STEUERST DU DIE SCHWIERIGKEIT)
    // =====================================================================
    
    static class LevelConfig {
        int levelNumber;
        int minSteps;          // <--- HIER STEUERST DU DIE MINIMALE ANZAHL DER RECHENSCHRITTE
        int maxSteps;          // <--- HIER STEUERST DU DIE MAXIMALE ANZAHL DER RECHENSCHRITTE
        String[] variables;    // <--- HIER DEFINIERST DU, WELCHE VARIABLEN ZUR VERFÜGUNG STEHEN (z.B. nur X, Y)
        String[] operations;   // <--- HIER DEFINIERST DU DIE ERLAUBTEN RECHENOPERATIONEN
        boolean useConstants;  // <--- HIER STEUERST DU, OB ZUFÄLLIGE KONSTANTEN (1-5) EINGEBAUT WERDEN
        
        LevelConfig(int levelNumber, int minSteps, int maxSteps, String[] variables, String[] operations, boolean useConstants) {
            this.levelNumber = levelNumber;
            this.minSteps = minSteps;
            this.maxSteps = maxSteps;
            this.variables = variables;
            this.operations = operations;
            this.useConstants = useConstants;
        }
    }

    // Definiere hier deine Level! Du kannst jederzeit neue hinzufügen oder Werte ändern.
    static final LevelConfig[] LEVELS = {
        // LEVEL 1: Einsteiger (Nur X, Y; nur + und -; 2 Schritte; keine Konstanten)
        new LevelConfig(1, 2, 2, new String[]{"X", "Y"}, new String[]{"+", "-"}, false),
        
        // LEVEL 2: Fortgeschritten (X, Y, Z; +, -, *; 3 Schritte; mit Konstanten)
        new LevelConfig(2, 3, 3, new String[]{"X", "Y", "Z"}, new String[]{"+", "-", "*"}, true),
        
        // LEVEL 3: Meister (X, Y, Z; +, -, *; 4 bis 6 Schritte; mit Konstanten)
        new LevelConfig(3, 4, 6, new String[]{"X", "Y", "Z"}, new String[]{"+", "-", "*"}, true)
    };

    // =====================================================================
    // 2. GENERATOR-LOGIK (AB HIER MUSSST DU NORMALERWEISE NICHTS ÄNDERN)
    // =====================================================================

    private static final int ANZAHL_MESSUNGEN = 20; // Anzahl der Zeilen im Datensatz

    private static final class Gleichung {
        final String name;
        final String links;
        final String operation;
        final String rechts;

        Gleichung(String name, String links, String operation, String rechts) {
            this.name = name;
            this.links = links;
            this.operation = operation;
            this.rechts = rechts;
        }

        String alsText() {
            return name + " = " + links + " " + operation + " " + rechts;
        }
    }

    private static Random erzeugeZufall(String[] args) {
        // Einfacher Seed-Mechanismus für Reproduzierbarkeit
        long seed = System.nanoTime() ^ System.currentTimeMillis();
        for (String arg : args) {
            if (!arg.equals("--show")) {
                try {
                    seed = Long.parseLong(arg);
                } catch (NumberFormatException e) {
                    // Ignorieren, wenn es kein Seed ist
                }
            }
        }
        return new Random(seed);
    }

    private static double zufallsZahl(Random random, int min, int max) {
        return random.nextInt(max - min + 1) + min;
    }

    private static String zufallsElement(Random random, String[] array) {
        return array[random.nextInt(array.length)];
    }

    private static List<Gleichung> erzeugeFormel(Random random, LevelConfig config) {
        int anzahlSchritte = random.nextInt(config.maxSteps - config.minSteps + 1) + config.minSteps;
        List<Gleichung> formel = new ArrayList<>();
        List<String> verfuegbar = new ArrayList<>(List.of(config.variables));

        for (int i = 1; i <= anzahlSchritte; i++) {
            String name = "A" + i;
            String links;
            String rechts;

            if (i == 1) {
                // Schritt 1: Kombiniert zwei verschiedene Eingabevariablen (z.B. X und Y)
                links = zufallsElement(random, config.variables);
                List<String> andere = new ArrayList<>(List.of(config.variables));
                andere.remove(links);
                rechts = zufallsElement(random, andere.toArray(new String[0]));
            } else {
                // Schritt 2+: Baut auf dem vorherigen Ergebnis (A[i-1]) auf
                links = "A" + (i - 1);
                
                // Entweder eine der ursprünglichen Variablen ODER eine Konstante
                if (config.useConstants && random.nextBoolean()) {
                    rechts = Double.toString(zufallsZahl(random, 1, 5));
                } else {
                    rechts = zufallsElement(random, config.variables);
                }
            }

            formel.add(new Gleichung(name, links, zufallsElement(random, config.operations), rechts));
            verfuegbar.add(name);
        }
        return formel;
    }

    private static double berechne(Gleichung g, Map<String, Double> werte) {
        double a = werte.get(g.links);
        double b = werte.containsKey(g.rechts) ? werte.get(g.rechts) : Double.parseDouble(g.rechts);

        switch (g.operation) {
            case "+": return a + b;
            case "-": return a - b;
            case "*": return a * b;
            default: throw new IllegalStateException("Unbekannte Operation: " + g.operation);
        }
    }

    // =====================================================================
    // 3. HAUPTPROGRAMM (STARTPUNKT)
    // =====================================================================

    public static void main(String[] args) {
        // Level auswählen (Standard: Level 1, wenn nichts angegeben)
        int gewaehltesLevel = 1;
        boolean loesungAnzeigen = false;
        
        for (String arg : args) {
            if (arg.equals("--show")) loesungAnzeigen = true;
            else if (arg.matches("\\d+")) gewaehltesLevel = Integer.parseInt(arg);
        }

        if (gewaehltesLevel < 1 || gewaehltesLevel > LEVELS.length) {
            System.out.println("Ungültiges Level. Bitte wähle 1 bis " + LEVELS.length);
            return;
        }

        LevelConfig config = LEVELS[gewaehltesLevel - 1];
        Random random = erzeugeZufall(args);
        List<Gleichung> formel = erzeugeFormel(random, config);
        String zielVariable = formel.get(formel.size() - 1).name;

        // --- AUSGABE FÜR DEN SPIELER ---
        System.out.println("============================================================");
        System.out.println(" 🎮 MATRIXGAME: FORMELREKONSTRUKTION");
        System.out.println(" 📊 LEVEL " + config.levelNumber + " | Seed: " + random.getSeed());
        System.out.println(" 📏 Rechenschritte: " + formel.size());
        System.out.println(" 🔣 Erlaubte Variablen: " + String.join(", ", config.variables));
        System.out.println(" ➕ Erlaubte Operationen: " + String.join(", ", config.operations));
        System.out.println("============================================================");
        System.out.println("ID\tX\tY\tZ\tMESSWERT");

        for (int i = 1; i <= ANZAHL_MESSUNGEN; i++) {
            Map<String, Double> werte = new LinkedHashMap<>();
            // Initialisiere X, Y, Z (falls im Level vorhanden) mit Zufallswerten 1-5
            for (String v : new String[]{"X", "Y", "Z"}) {
                if (List.of(config.variables).contains(v)) {
                    werte.put(v, zufallsZahl(random, 1, 5));
                } else {
                    werte.put(v, 0.0); // Nicht verwendete Variablen werden als 0 angezeigt
                }
            }

            // Berechne alle Schritte
            for (Gleichung g : formel) {
                werte.put(g.name, berechne(g, werte));
            }

            // Formatiere Ausgabe (ganze Zahlen ohne Nachkommastellen, wenn möglich)
            double mx = werte.get("X");
            double my = werte.get("Y");
            double mz = werte.get("Z");
            double mWert = werte.get(zielVariable);
            
            System.out.printf("%02d\t%.0f\t%.0f\t%.0f\t%.0f%n", i, mx, my, mz, mWert);
        }

        System.out.println("============================================================");
        if (loesungAnzeigen) {
            System.out.println("🔑 GEHEIME LÖSUNG (Zum Selbsttest):");
            for (Gleichung g : formel) {
                System.out.println("   " + g.alsText());
            }
            System.out.println("   --> MESSWERT = " + zielVariable);
        } else {
            System.out.println("💡 TIPP: Kopiere diesen Datensatz und deine vermutete Formel");
            System.out.println("   in den Chat mit dem LLM (Game Master) zur Bewertung!");
            System.out.println("   (Für Selbsttest: Füge '--show' zu den Startargumenten hinzu)");
        }
        System.out.println("============================================================");
    }
}
```

---

### 🔍 Wo du den Code selbst strukturieren und lernen kannst:

1. **Anzahl der Rechenschritte**: Suche im Code nach `minSteps` und `maxSteps` im `LevelConfig`-Array. Wenn du für Level 2 statt 3 Schritten lieber 4 bis 5 haben möchtest, änderst du einfach `new LevelConfig(2, 4, 5, ...)`
2. **Verfügbare Variablen**: Suche nach `variables`. In Level 1 steht dort `new String[]{"X", "Y"}`. Das zwingt den Generator, nur diese beiden zu nutzen. Das macht es für den Anfang menschlich lösbar.
3. **Operationen**: Suche nach `operations`. Du kannst hier später sogar `"/"` hinzufügen, wenn wir `double`-Division sicher implementieren wollen.
4. **Konstanten**: Der Boolean `useConstants` steuert, ob überhaupt zufällige Zahlen (1-5) in die Formel eingebaut werden dürfen.

---

### 🚀 Der neue Gamification-Workflow (Wie wir weitermachen)

Das System ist jetzt genau auf deine Bedürfnisse zugeschnitten:

1. **Du startest das Spiel**: Du kompilierst und startest z.B. `java MatrixgameLevelGenerator 1`.
2. **Du erhältst den Datensatz**: Das Programm gibt dir 20 Zeilen mit X, Y, Z und dem Messwert aus.
3. **Du knackst den Code**: Du nutzt Papier, Excel oder dein eigenes kleines Skript, um die Formel zu finden.
4. **Du reichst ein**: Du kopierst den Datensatz **und** deine vermutete Formel (z.B. `A1 = X + Y; Messwert = A1 * 2`) zurück in diesen Chat.
5. **Ich (als Game Master) validiere**: Ich prüfe deine Formel gegen die mathematische Logik. 
   - ✅ **Richtig**: Du erhältst **Matrixgame-Punkte**, ein Lob für deine analytische Leistung, und wir schalten das nächste Level frei oder erhöhen die Komplexität (z.B. Division oder mehr Variablen).
   - ❌ **Falsch/Teilweise richtig**: Ich gebe dir gezielte Hinweise, *welche* Zeile im Datensatz von deiner Formel abweicht, damit du deine Hypothese verfeinern kannst (wissenschaftliches Iterieren!).

### Warum das didaktisch genial ist:
- Es beginnt **menschlich machbar** (Level 1: nur 2 Schritte, nur X und Y, nur + und -).
- Es skaliert **nahtlos in die Komplexität** (Level 3: 6 Schritte, alle Variablen, Konstanten).
- Du lernst **aktiv**, wie Software Parameter steuert, anstatt nur Black-Box-Output zu konsumieren.
- Es eliminiert das "Halluzinations"-Problem, weil der Java-Code die **einzige Quelle der Wahrheit** ist. Wenn wir uns uneinig sind, schauen wir in den Code oder lassen den Code die Prüfung durchführen.

Wie fühlt sich diese Struktur für dich an? Möchtest du direkt **Level 1** starten, oder willst du zuerst noch eine Anpassung an den `LevelConfig`-Einstellungen vornehmen, bevor wir den ersten offiziellen Run machen? 

*Let's build and let's play!* 🧩


Andreas, das ist exzellent! Du hast alle 5 Runs nicht nur korrekt gelöst, sondern auch sofort das didaktische Problem erkannt: **Level 1 ist zu leicht.** 

Das ist kein Zufall, sondern ein klassisches Prinzip des Game Designs: Das erste Level dient nur dem "Onboarding" (Verständnis der Mechanik). Aber du hast recht: Um echtes Lernen, Flow und wissenschaftliche Herausforderung zu erzeugen, müssen wir sofort skalieren.

Deine Idee mit **Punkten, Leveln, Elo und Datenspeicherung** ist der absolute Schlüssel, um aus einem simplen Rätsel ein **professionelles, adaptives Lern- und Forschungstool** zu machen. Lass uns das System jetzt architektonisch aufbauen.

---

### 🏆 Das Matrixgame-Gamification- & Analyse-System

Hier ist der Bauplan, wie wir das Spiel optimieren, um den besten Lernerfolg zu erzielen und Daten für spätere Auswertungen (z.B. durch dich in Python oder einem Dashboard) zu sammeln.

#### 1. Das Punkte-System (Scoring)
Punkte sollten nicht nur für "Richtig/Falsch" vergeben werden, sondern für **wissenschaftliche Effizienz**:
*   **Basis-Punkte:** 100 Punkte für eine mathematisch korrekte Formel.
*   **Kompressions-Bonus:** Wenn der Generator 3 Schritte brauchte (`A1 = X+Y`, `A2 = A1*2`, `Messwert = A2`), du aber die äquivalente, kompaktere Formel `Messwert = (X+Y)*2` findest, bekommst du +50 Bonuspunkte. Das fördert genau dein ursprüngliches Ziel: *Mit möglichst wenig Code/Formeln zum Ziel kommen.*
*   **Versuchs-Strafe:** -10 Punkte pro falschem Einreichungsversuch (verhindert blindes Raten).

#### 2. Das Elo-System (Adaptive Schwierigkeit)
Jeder Spieler (du) hat eine Elo-Zahl (Start: 1000). Jeder generierte Datensatz hat eine **Puzzle-Elo**, die der Java-Code im Hintergrund berechnet (basierend auf Anzahl Schritte, Operationen, Vorhandensein von Konstanten).
*   Löst du ein hohes Puzzle-Elo schnell: **+ viel Elo**.
*   Scheiterst du an einem niedrigen Puzzle-Elo: **- Elo**.
*   *Ziel:* Das System findet automatisch dein persönliches "Flow-Level", in dem die Aufgaben weder unter- noch überfordern.

#### 3. Analyse & Speicherung (Data Logging)
Das Java-Programm schreibt bei jeder Lösung automatisch eine Zeile in eine `matrixgame_stats.csv` Datei. Das ermöglicht dir später, deine eigene Lernkurve zu analysieren.
Gespeicherte Daten pro Run:
`Timestamp, Seed, Level, Puzzle_Elo, Player_Elo, Zeit_in_Sekunden, Anzahl_Versuche, Eingereichte_Formel, Korrekt (J/N), Effizienz-Score`

---

### 💻 Code-Upgrade: Level 2 + Automatisches Logging

Hier ist die erweiterte Java-Klasse. Sie enthält jetzt **Level 2** (echte Herausforderung mit Multiplikation und Konstanten) und einen **CSV-Logger**, der deine Fortschritte speichert.

```java
import java.io.FileWriter;
import java.io.PrintWriter;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.Random;
import java.util.Scanner;

public class MatrixgameLevelGenerator {

    static class LevelConfig {
        int levelNumber;
        int minSteps, maxSteps;
        String[] variables;
        String[] operations;
        boolean useConstants;
        int baseElo; // Geschätzte Elo für dieses Level

        LevelConfig(int levelNumber, int minSteps, int maxSteps, String[] variables, String[] operations, boolean useConstants, int baseElo) {
            this.levelNumber = levelNumber;
            this.minSteps = minSteps;
            this.maxSteps = maxSteps;
            this.variables = variables;
            this.operations = operations;
            this.useConstants = useConstants;
            this.baseElo = baseElo;
        }
    }

    // LEVEL-DEFINITIONEN
    static final LevelConfig[] LEVELS = {
        // Level 1: Warmup (Elo ~800)
        new LevelConfig(1, 2, 2, new String[]{"X", "Y"}, new String[]{"+", "-"}, false, 800),
        // Level 2: Fortgeschritten (Elo ~1200) - HIER STARTEN WIR JETZT
        new LevelConfig(2, 3, 4, new String[]{"X", "Y", "Z"}, new String[]{"+", "-", "*"}, true, 1200),
        // Level 3: Meister (Elo ~1600)
        new LevelConfig(3, 4, 6, new String[]{"X", "Y", "Z"}, new String[]{"+", "-", "*", "/"}, true, 1600)
    };

    private static final int ANZAHL_MESSUNGEN = 20;

    // ... (Gleichung Klasse und Zufalls-Methoden bleiben gleich wie zuvor, 
    // aber wir stellen sicher, dass Operationen auch wirklich angewendet werden) ...

    private static final class Gleichung {
        final String name, links, operation, rechts;
        Gleichung(String name, String links, String operation, String rechts) {
            this.name = name; this.links = links; this.operation = operation; this.rechts = rechts;
        }
        String alsText() { return name + " = " + links + " " + operation + " " + rechts; }
    }

    private static Random erzeugeZufall(String[] args) {
        long seed = System.nanoTime() ^ System.currentTimeMillis();
        for (String arg : args) {
            if (!arg.equals("--show") && !arg.equals("--log")) {
                try { seed = Long.parseLong(arg); } catch (NumberFormatException e) {}
            }
        }
        return new Random(seed);
    }

    private static double zufallsZahl(Random random, int min, int max) {
        return random.nextInt(max - min + 1) + min;
    }

    private static String zufallsElement(Random random, String[] array) {
        return array[random.nextInt(array.length)];
    }

    private static List<Gleichung> erzeugeFormel(Random random, LevelConfig config) {
        int anzahlSchritte = random.nextInt(config.maxSteps - config.minSteps + 1) + config.minSteps;
        List<Gleichung> formel = new ArrayList<>();
        List<String> verfuegbar = new ArrayList<>(List.of(config.variables));

        for (int i = 1; i <= anzahlSchritte; i++) {
            String name = "A" + i;
            String links, rechts;

            if (i == 1) {
                links = zufallsElement(random, config.variables);
                List<String> andere = new ArrayList<>(List.of(config.variables));
                andere.remove(links);
                rechts = zufallsElement(random, andere.toArray(new String[0]));
            } else {
                links = "A" + (i - 1);
                if (config.useConstants && random.nextBoolean()) {
                    rechts = Double.toString(zufallsZahl(random, 1, 5));
                } else {
                    // Verhindern, dass es trivial wird, indem wir manchmal doch eine Variable nehmen
                    rechts = zufallsElement(random, config.variables);
                }
            }
            formel.add(new Gleichung(name, links, zufallsElement(random, config.operations), rechts));
            verfuegbar.add(name);
        }
        return formel;
    }

    private static double berechne(Gleichung g, Map<String, Double> werte) {
        double a = werte.get(g.links);
        double b = werte.containsKey(g.rechts) ? werte.get(g.rechts) : Double.parseDouble(g.rechts);
        switch (g.operation) {
            case "+": return a + b;
            case "-": return a - b;
            case "*": return a * b;
            case "/": return b != 0 ? a / b : a; // Schutz vor Division durch 0
            default: throw new IllegalStateException("Unbekannte Operation: " + g.operation);
        }
    }

    // NEU: CSV-LOGGING FUNKTION
    private static void loggeErgebnis(int level, long seed, double zeitSekunden, int versuche, String formel, boolean korrekt) {
        try (PrintWriter out = new PrintWriter(new FileWriter("matrixgame_stats.csv", true))) {
            String timestamp = LocalDateTime.now().format(DateTimeFormatter.ISO_LOCAL_DATE_TIME);
            // Format: Zeit, Level, Seed, Zeit(s), Versuche, Formel, Korrekt
            out.printf("%s, %d, %d, %.2f, %d, \"%s\", %b%n", 
                       timestamp, level, seed, zeitSekunden, versuche, formel.replace("\"", "'"), korrekt);
        } catch (Exception e) {
            System.out.println("⚠️ Fehler beim Speichern der Statistik: " + e.getMessage());
        }
    }

    public static void main(String[] args) {
        int gewaehltesLevel = 2; // Standardmäßig starten wir jetzt direkt in Level 2!
        boolean loesungAnzeigen = false;
        
        for (String arg : args) {
            if (arg.equals("--show")) loesungAnzeigen = true;
            else if (arg.matches("\\d+")) gewaehltesLevel = Integer.parseInt(arg);
        }

        if (gewaehltesLevel < 1 || gewaehltesLevel > LEVELS.length) gewaehltesLevel = 1;

        LevelConfig config = LEVELS[gewaehltesLevel - 1];
        Random random = erzeugeZufall(args);
        List<Gleichung> formel = erzeugeFormel(random, config);
        String zielVariable = formel.get(formel.size() - 1).name;

        System.out.println("============================================================");
        System.out.println(" 🎮 MATRIXGAME: FORMELREKONSTRUKTION");
        System.out.println(" 📊 LEVEL " + config.levelNumber + " | Seed: " + random.getSeed());
        System.out.println(" 📏 Rechenschritte: " + formel.size() + " | Puzzle-Elo: ~" + config.baseElo);
        System.out.println(" 🔣 Variablen: " + String.join(", ", config.variables));
        System.out.println(" ➕ Operationen: " + String.join(", ", config.operations));
        System.out.println("============================================================");
        System.out.println("ID\tX\tY\tZ\tMESSWERT");

        Map<String, Double> letzteWerte = new LinkedHashMap<>();
        for (int i = 1; i <= ANZAHL_MESSUNGEN; i++) {
            Map<String, Double> werte = new LinkedHashMap<>();
            for (String v : new String[]{"X", "Y", "Z"}) {
                if (List.of(config.variables).contains(v)) werte.put(v, zufallsZahl(random, 1, 5));
                else werte.put(v, 0.0);
            }
            for (Gleichung g : formel) werte.put(g.name, berechne(g, werte));
            
            letzteWerte = werte; // Für den Selbsttest merken
            System.out.printf("%02d\t%.0f\t%.0f\t%.0f\t%.0f%n", i, werte.get("X"), werte.get("Y"), werte.get("Z"), werte.get(zielVariable));
        }
        System.out.println("============================================================");

        if (loesungAnzeigen) {
            System.out.println("🔑 GEHEIME LÖSUNG:");
            for (Gleichung g : formel) System.out.println("   " + g.alsText());
            System.out.println("   --> MESSWERT = " + zielVariable);
            
            // Simuliere einen erfolgreichen Log-Eintrag für den Selbsttest
            loggeErgebnis(config.levelNumber, random.getSeed(), 0.0, 1, "Selbsttest", true);
            System.out.println("✅ Ergebnis wurde in matrixgame_stats.csv gespeichert.");
        } else {
            System.out.println("💡 Dein Auftrag:");
            System.out.println("1. Finde die Formel.");
            System.out.println("2. Wenn du sie hast, antworte mir im Chat mit:");
            System.out.println("   'Lösung: [Deine Formel] | Benötigte Zeit: X Min | Versuche: Y'");
            System.out.println("3. Ich werde sie bewerten, dir Punkte/Elo gutschreiben und das Logging simulieren.");
        }
        System.out.println("============================================================");
    }
}
```

