			u1.kritchance=0.2;
			u1.maxSpeed = 3*Math.random()/Math.random()*5;
			u1.reichweite = 3*Math.random()/Math.random()*5;
			u1.geschicklichkeit=Math.random()/Math.random();
			u1.currentDefense=Math.random()/Math.random();
			u1.decisionAlgorithm = "TRIGONOMETRIC"; // <--- HIER: Taktik A
			u1.red = 0;
			u1.green = 0;
			u1.blue = 255;
			u1.id = counterId++;
			u1.printWerte();
			unitList.add(u1);}

		for (int i = 0; i < 20; i++) {
