			u2.posX = Math.random() *10+200;
			u2.posY = -Math.random() * 20-2000;
			u2.posZ = Math.random() * 80;// Spiegelung an der X-Achse
			u2.posXBefore=u2.posX;
			u2.posYBefore=u2.posY;
			u2.posZBefore=u2.posZ;
			u2.maxLeben = Math.random()/Math.random()*5;;
			u2.leben = Math.random()/Math.random()*5;; // Exakt gleiche HP!
			u2.damage = Math.random()/Math.random()*5;;
			u2.attackSpeed=Math.random()/Math.random()*5;;
			u2.moveSpeed=Math.random()/Math.random()*5;;
			u2.kritchance=0.2;
			u2.currentDefense=Math.random()/Math.random()*5;
			u2.geschicklichkeit=Math.random()/Math.random()*5;
			u2.maxSpeed = Math.random()/Math.random()*5;
			u2.reichweite =Math.random()/Math.random()*5;
			u2.decisionAlgorithm = "Warten"; // <--- HIER: Taktik B
			u2.red = 255;
			u2.green = 0;
			u2.blue = 0;
			u2.id = counterId++;
			u2.printWerte();
			unitList.add(u2);
		}

		// Könige exakt gespiegelt spawnen
		Unit king1 = new Unit();
		king1.typ = "King";
		king1.size = 15;
		king1.team = 1;
		king1.posX = Math.random() + 20;
		king1.posY = Math.random() + 20;
		king1.posZ = Math.random() * 0;
		king1.posXBefore=king1.posX;
		king1.posYBefore=king1.posY;
		king1.posZBefore=king1.posZ;
		king1.posY = 20;
		king1.maxLeben = 1; 
		king1.leben = king1.maxLeben;
		king1.damage =1;
		king1.attackSpeed=1;
		king1.moveSpeed=1;
		king1.kritchance=0.25;
		king1.maxSpeed =1; ;
		king1.reichweite = 1;
		king1.currentDefense=1;
		king1.geschicklichkeit=1;
		king1.id = counterId++;
		king1.grid = false;
		king1.red = 0;
		king1.green = 0;
		king1.blue = 255;
		king1.decisionAlgorithm = "Warten";
		king1.printWerte();
		unitList.add(king1);

		Unit king2 = new Unit();
		king2.typ = "King";
		king2.size = 15;
		king2.team = 2;
		king2.posX = Math.random() *10+200;
		king2.posY = -Math.random() * 20-2000;
		king2.posZ = Math.random() * 80;// Spie
		king2.posXBefore=king2.posX;
		king2.posYBefore=king2.posY;
		king2.posZBefore=king2.posZ;
		king2.maxLeben = 1; 
		king2.leben = king2.maxLeben;
		king2.damage =1; 
		king2.kritchance=0.25;
		king2.attackSpeed=1;
		king2.moveSpeed=1;
		king2.currentDefense=1;
		king2.geschicklichkeit=1;
		king2.maxSpeed = 1; 
		king2.reichweite = 1; 
		king2.id = counterId++;
		king2.grid = false;
		king2.red = 255;
