	// --- Pan-Methoden ---
	public void panLeft() {
		zoomCenterX += PAN_STEP;
		repaint();
	}

	public void panRight() {
		zoomCenterX -= PAN_STEP;
		repaint();
	}

	public void panUp() {
		zoomCenterY += PAN_STEP;
		repaint();
	}

	public void panDown() {
		zoomCenterY -= PAN_STEP;
		repaint();
	}

	// Gelogene Methode
	@Override
	protected void paintComponent(Graphics g) {
		super.paintComponent(g);
		Graphics2D g2 = (Graphics2D) g;
		g2.setColor(Color.BLACK);
		g2.fillRect(0, 0, getWidth(), getHeight());

		// Loop für alle Units aus UnitList
		for (int i = 0; i < unitList.size(); i++) {
			Unit unit = unitList.get(i);
			if (unit.leben <= 0)
				continue;
			double radius = unit.size;
			Color color = new Color((int) (unit.red), (int) (unit.green), (int) (unit.blue));
			double posX = unit.posX;
			double posY = unit.posY;
			// Berücksichtige Pan und Zoom bei der Positionierung
			double sx = (zoomCenterX + posX) * zoomFactor + getWidth() / 2.0;
			double sy = (zoomCenterY + posY) * zoomFactor + getHeight() / 2.0;
//			int r = (int) Math.max(body.radius * zoomFactor, MIN_RADIUS_DRAW);
			g2.setColor(color);
			g2.fillOval((int) (sx - radius), (int) (sy - radius), (int) (radius * 2), (int) (radius * 2));
			// Innerhalb von paintComponent(Graphics g) in der for-Schleife:
			if (unit.isSelected) {
				g2.setColor(Color.WHITE);
				// Einen etwas größeren Ring um die Unit zeichnen
				g2.drawOval((int) (sx - radius - 2), (int) (sy - radius - 2), (int) (radius * 2 + 4),
						(int) (radius * 2 + 4));
			}

		}
	}

	// Zoom-Funktionen
	public void zoomIn() {
		zoomFactor *= ZOOM_STEP;
		PAN_STEP = feinheit / zoomFactor;
		repaint();
	}

	public void zoomOut() {
		zoomFactor /= ZOOM_STEP;
		PAN_STEP = feinheit / zoomFactor;
		repaint();
	}

	long pasueTime = 10;
	long kompletteRechenzeitDerSimulation = 0;
	double avgRechenzeitProUnitProEinheitenZug = 0;
	double count = 0;

	public void gameLoop() {
		while (true) {
			repaint();

			if (unitList.isEmpty())
				break; // Sicherheitscheck

			int randNumber = (int) (unitList.size() * Math.random());
			Unit current = unitList.get(randNumber);

			if (current.leben <= 0) {
				if (current.typ != null && current.typ.equals("King")) {
					System.out.println("--- GAME OVER ---");
					System.out.println("Der König von Team " + current.team + " wurde vernichtet!");
					System.out.println("Das andere Team hat gewonnen!");
					return;
				} else {
					continue; // Tote Unit überspringen
				}
			}

			current.leben *= 1.1;
			if (current.leben > current.maxLeben)
				current.leben = current.maxLeben;
			current.currentDefense = current.defenseProTurn;

			// --- 🚀 OPTIMIERUNG: DYNAMISCHES LOAD-BALANCING (SKIP LOGIC) ---
			// Wir warten bis count > 50, damit sich der Durchschnitt erst mal einpendelt.
			// Wenn eine Unit 50% mehr Zeit braucht als der Durchschnitt, wird sie mit 50%
			// Wahrscheinlichkeit diesen Tick "übersprungen".
			// Das spart CPU und simuliert z.B. "langsamere Reaktionszeiten" bei komplexen
			// Einheiten.

			double zugChance = avgRechenzeitProUnitProEinheitenZug / current.rechenzeitProZug;

			if (Math.random() > zugChance) {
				continue; // Skip! Die Unit behält ihren aktuellen Bewegungswert (vx, vy) bei.
			}

			// current.printWerte(); // TIPP: Für maximale Performance später
			// auskommentieren!

			long startTime = System.nanoTime();
			count++;

			// --- ENTSCHEIDUNGSLOGIK ---
			if ("TARGET_POINT".equals(current.decisionAlgorithm) && current.targetPosX != null
					&& current.targetPosY != null) {

				current.moveTo(current.targetPosX, current.targetPosY, current.posZ, current.maxSpeed);
				double distToTarget = current.getDistanceTo(current.targetPosX, current.targetPosY, current.posZ);
				if (distToTarget < 1.5) {
					current.decisionAlgorithm = "NEAREST_ENEMY";
					current.targetPosX = null;
					current.targetPosY = null;
				}
			} else if ("TARGET_ENEMY".equals(current.decisionAlgorithm) && current.manualTarget != null) {
				if (current.manualTarget.leben <= 0) {
					current.decisionAlgorithm = "NEAREST_ENEMY";
					current.manualTarget = null;
				} else {
					current.target = current.manualTarget;
					if (current.getDistance(current.target) <= current.reichweite) {
						current.attackieren(current.target);
					} else {
						current.moveTo(current.target);
					}
				}
			} else {

				//////
				// Standard KI
				if (current.target == null || current.target.leben <= 0) {
					current.target = nextGegner(current);
				}
				if (current.getDistance(current.target) > current.reichweite + current.maxSpeed)
					current.target = nextGegner(current);
				current.update();

				if (current.target.typ != null && current.target.typ.equals("King") && current.target.leben <= 0) {
					System.out.println("Der König von Team " + current.target.team + " wurde vernichtet!");
					System.out.println("Team " + current.team + " hat gewonnen!");
					return;
				}

			}

			long endTime = System.nanoTime();
			long zugZeit = endTime - startTime;

			// Zeitmessung speichern (Gleitender Durchschnitt für stabile Werte)
			current.rechenzeitProZug = (current.rechenzeitProZug * 0.8) + (zugZeit * 0.2);
			current.kompletteRechenzeitInSimulation += zugZeit;
			kompletteRechenzeitDerSimulation += zugZeit;
			avgRechenzeitProUnitProEinheitenZug = kompletteRechenzeitDerSimulation / count;

			// NEU: Kurze Pause (16ms = ca. 60 FPS Update-Rate für die Logik)
			try {
				Thread.sleep(pasueTime);
			} catch (InterruptedException e) {
				e.printStackTrace();
			}
		}
	}

	public Unit nextGegner(Unit current) {
		Unit gegner = null;
		double min = 999999999;
		for (Unit ziel : unitList) {
			if (current.getDistance(ziel) < min && current.team != ziel.team && ziel.leben > 0) {
				min = current.getDistance(ziel);
				gegner = ziel;
			}
		}
		return gegner;
	}

	// --- Korrigierte Hauptmethode ---
	// --- Korrigierte Hauptmethode ---
	public static void main(String[] args) {
		SwingUtilities.invokeLater(() -> {
			JFrame frame = new JFrame("N-Body Sonnensystem-Simulation (QDBV-Modul)");
			frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

			// 1. Zentrale Instanz erzeugen und initialisieren
			MainGame simPanel = new MainGame();
			simPanel.init();

			frame.setLayout(new BorderLayout());
			frame.add(simPanel, BorderLayout.CENTER);

			// 2. Control-Panel und Buttons
			JButton zoomIn = new JButton("Zoom In");
			JButton zoomOut = new JButton("Zoom Out");
			JButton speedUp = new JButton("Speed Up");
			JButton speedDown = new JButton("Speed Down");
			JButton panLeft = new JButton("← Links");
			JButton panRight = new JButton("Rechts →");
			JButton panUp = new JButton("↑ Hoch");
			JButton panDown = new JButton("↓ Runter");

			zoomIn.addActionListener(e -> simPanel.zoomIn());
			zoomOut.addActionListener(e -> simPanel.zoomOut());
			panLeft.addActionListener(e -> simPanel.panLeft());
			panRight.addActionListener(e -> simPanel.panRight());
			panUp.addActionListener(e -> simPanel.panUp());
			panDown.addActionListener(e -> simPanel.panDown());

			JPanel control = new JPanel();
			control.add(zoomIn);
			control.add(zoomOut);
			control.add(speedUp);
			control.add(speedDown);
			control.add(panLeft);
			control.add(panRight);
			control.add(panUp);
			control.add(panDown);

			frame.add(control, BorderLayout.NORTH);
			frame.setSize(1920, 1080);
			frame.setLocationRelativeTo(null);
			frame.setVisible(true);

			// 3. SYNCHRONISATIONS-FIX: Den Loop strikt entkoppeln
			Thread gameThread = new Thread(() -> {
				simPanel.gameLoop();
			});
			gameThread.start();
		});
	}

}


Um das Projekt nach dem Bottom-up-Prinzip modular zu strukturieren, muss die monolithische Architektur in isolierte, austauschbare Komponenten zerlegt werden. Aktuell vermischt die `MainGame`-Klasse Rendering, Input-Verarbeitung (MouseAdapter) und die gesamte Spiellogik (`gameLoop`). Die Entscheidungslogik der Einheiten wird zudem über Strings wie `"TARGET_POINT"` oder `"NEAREST_ENEMY"` und verschachtelte if-else-Blöcke gesteuert.

Für eine optimale Zusammenarbeit mit einem Sprachmodell ist das **Strategie-Pattern (Strategy Pattern)** kombiniert mit **Komponenten-basierter Architektur** der effizienteste Weg. Wenn wir zukünftig ein neues Verhalten (z.B. "Fliehen", "Heilen" oder "Formationsflug") hinzufügen wollen, generieren wir lediglich eine einzige neue Klasse, anstatt den zentralen `gameLoop` anzupassen. Das Modell muss sich dann nur diesen spezifischen Code-Block merken.

Hier sind die drei essenziellen Modul-Blöcke, die du in dein Projekt kopieren kannst, um die Steuerung, die KI und das Canvas zu entkoppeln.

### Modul 1: Das Strategie-Pattern für Einheiten-Logik (KI & Verhalten)

Anstatt das Verhalten im `gameLoop` oder in `Unit.update()` fest zu verdrahten, lagern wir die Entscheidungsfindung in ein Interface aus. Jedes Verhalten wird eine eigene Klasse.

**Schritt 1: Das Interface**
Erstelle eine neue Datei `UnitBehavior.java`.

```java
package ordner1;
import java.util.List;

public interface UnitBehavior {
    // Führt die Logik für diesen Zeitschritt aus
    void execute(Unit unit, List<Unit> allUnits);
}

```

**Schritt 2: Konkrete Verhaltensweisen (Bottom-up)**
Erstelle für jedes aktuelle Verhalten eine Klasse. Hier ist das Modul für den Standard-Angriff. Wenn wir später die Schwarm-Logik optimieren, arbeiten wir nur in dieser Datei.

```java
package ordner1;
import java.util.List;

public class NearestEnemyBehavior implements UnitBehavior {
    @Override
    public void execute(Unit unit, List<Unit> allUnits) {
        if (unit.target == null || unit.target.leben <= 0) {
            unit.target = findNearestEnemy(unit, allUnits);
        }
        
        if (unit.target != null) {
            if (unit.getDistance(unit.target) > unit.reichweite + unit.maxSpeed) {
                unit.target = findNearestEnemy(unit, allUnits);
            }
            
            // Führt den eigentlichen Move/Attack-Befehl aus der Unit-Klasse aus
            if(unit.getDistance(unit.target) <= unit.reichweite) {
                unit.performAttack(unit.target);
            } else {
                unit.performMove();
            }
        }
    }

    private Unit findNearestEnemy(Unit current, List<Unit> allUnits) {
        Unit gegner = null;
        double min = Double.MAX_VALUE;
        for (Unit ziel : allUnits) {
            if (current.team != ziel.team && ziel.leben > 0) {
                double dist = current.getDistance(ziel);
                if (dist < min) {
                    min = dist;
                    gegner = ziel;
                }
            }
        }
        return gegner;
    }
}

```

**Integration in die Unit-Klasse:**
Ersetze `public String decisionAlgorithm` durch `public UnitBehavior behavior`. Im `gameLoop` rufst du dann für jede Unit nur noch `current.behavior.execute(current, unitList);` auf.

### Modul 2: Entkopplung der Einheitensteuerung (Input Controller)

Die aktuelle Steuerung per MouseAdapter ist direkt im Konstruktor von `MainGame` hartcodiert. Das Auslagern in einen `PlayerInputController` macht die Maus-Interaktion erweiterbar, ohne die Kern-Engine anzufassen.

Erstelle `PlayerInputController.java`:

```java
package ordner1;

import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import java.util.List;
import javax.swing.SwingUtilities;

public class PlayerInputController extends MouseAdapter {
    private List<Unit> unitList;
    private Viewport viewport; // Ein neues Modul, das zoomFactor, zoomCenterX etc. hält

    public PlayerInputController(List<Unit> unitList, Viewport viewport) {
        this.unitList = unitList;
        this.viewport = viewport;
    }

    @Override
    public void mousePressed(MouseEvent e) {
        if (SwingUtilities.isLeftMouseButton(e)) {
            handleSelection(e);
        } else if (SwingUtilities.isRightMouseButton(e)) {
            handleCommand(e);
        }
    }

    private void handleSelection(MouseEvent e) {
        int mouseX = e.getX();
        int mouseY = e.getY();
        boolean unitFound = false;

        for (Unit u : unitList) {
            // Transformation über das Viewport-Modul
            double sx = viewport.worldToScreenX(u.posX);
            double sy = viewport.worldToScreenY(u.posY);
            
            if (Math.hypot(mouseX - sx, mouseY - sy) <= Math.abs(u.size)) {
                u.isSelected = true;
                unitFound = true;
            } else if (!e.isShiftDown()) {
                u.isSelected = false;
            }
        }
    }

    private void handleCommand(MouseEvent e) {
        double worldX = viewport.screenToWorldX(e.getX());
        double worldY = viewport.screenToWorldY(e.getY());

        for (Unit u : unitList) {
            if (u.isSelected) {
                // Weise der Einheit dynamisch das neue Move-Verhalten zu
                u.behavior = new MoveToPointBehavior(worldX, worldY);
            }
        }
    }
}

```

### Modul 3: Kamera und Canvas-Logik (Viewport Modul)

Die Transformationen zwischen Bildschirmkoordinaten und Weltkoordinaten (z.B. `(zoomCenterX + u.posX) * zoomFactor + getWidth() / 2.0`) sollten zentral in einem reinen Mathematik-Objekt stattfinden. Das beugt Darstellungsfehlern bei Erweiterungen des Canvas vor.

Erstelle `Viewport.java`:

```java
package ordner1;

public class Viewport {
    public double zoomFactor = 1.0;
    public double zoomCenterX = 0;
    public double zoomCenterY = 0;
    public int screenWidth = 1920;
    public int screenHeight = 1080;

    // Welt zu Bildschirm (Für das Canvas Rendern)
    public double worldToScreenX(double worldX) {
        return (zoomCenterX + worldX) * zoomFactor + (screenWidth / 2.0);
    }

    public double worldToScreenY(double worldY) {
        return (zoomCenterY + worldY) * zoomFactor + (screenHeight / 2.0);
    }

    // Bildschirm zu Welt (Für die Maus-Steuerung)
    public double screenToWorldX(double screenX) {
        return (screenX - (screenWidth / 2.0)) / zoomFactor - zoomCenterX;
    }

    public double screenToWorldY(double screenY) {
        return (screenY - (screenHeight / 2.0)) / zoomFactor - zoomCenterY;
    }
}

```

Wenn wir in Zukunft das visuelle Feedback im Canvas verbessern wollen (z.B. Lebensbalken, Angriffs-Laser oder Selektions-Rechtecke zeichnen), erstellen wir einen dedizierten `GameRenderer`, der die `paintComponent`-Methode entlastet. Das `MainGame` wird dadurch zu einer reinen Initialisierungs-Klasse, die diese Module beim Start lediglich zusammensteckt.


