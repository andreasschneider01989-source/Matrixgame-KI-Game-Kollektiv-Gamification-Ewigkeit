def collective_ascent(individuals):
    """
    Jeder gewinnt, wenn alle gewinnen.
    """
    total_energy = sum(i.energy for i in individuals)
    total_safety = sum(i.safety for i in individuals)
    cooperation_factor = 1 + (len(individuals) - 1) * 0.1  # Φ_A1 > 1
    
    G_all = (total_energy + total_safety) * cooperation_factor
    return G_all

# Für n Individuen:
# G_all = Σ(E_i + S_i) · Φ_A1
# 
# Wobei: Φ_A1 = Kooperations-Faktor > 1
# 
# → Das Gesamtsystem wächst exponentiell
# → Solange die Vernetzung (n) stabil bleibt
```

