##  **OPTION 1: Java Infinity Canvas (Sofort auf deinem PC)**

Hier ist eine **vollständige, lauffähige Java-Anwendung**, die du sofort in Eclipse öffnen und starten kannst:

```java
package ordner1;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.ArrayList;
import java.util.List;

/**
 * INFINITY CANVAS - MATRIXGAME EDITION
 * Ein unendlicher Raum für kollektive Intelligenzen
 * 
 * Steuerung:
 * - Mausrad: Zoomen
 * - Linke Maustaste + Ziehen: Verschieben
 * - Rechte Maustaste + Klick: Node platzieren
 * - Taste 'R': Raum zurücksetzen
 * - Taste 'I': Info anzeigen
 */
public class InfinityCanvas extends JPanel implements MouseWheelListener, MouseMotionListener, MouseListener {
    
    private double zoom = 1.0;
    private double offsetX = 0;
    private double offsetY = 0;
    private boolean isDragging = false;
    private int lastMouseX, lastMouseY;
    
    private List<Node> nodes = new ArrayList<>();
    private StringBuilder infoText = new StringBuilder();
    
    // Node-Klasse für das Canvas
    static class Node {
        double x, y;
        String label;
        Color color;
        int radius;
        String creator;
        long timestamp;
        
        Node(double x, double y, String label, Color color) {
            this.x = x;
            this.y = y;
            this.label = label;
            this.color = color;
            this.radius = 15;
            this.creator = "Andreas";
            this.timestamp = System.currentTimeMillis();
        }
        
        void draw(Graphics2D g) {
            // Kreis zeichnen
            g.setColor(color);
            g.fillOval((int)(x - radius), (int)(y - radius), radius * 2, radius * 2);
            g.setColor(Color.WHITE);
            g.setStroke(new BasicStroke(2));
            g.drawOval((int)(x - radius), (int)(y - radius), radius * 2, radius * 2);
            
            // Label zeichnen
            g.setColor(Color.WHITE);
            g.setFont(new Font("Arial", Font.BOLD, 12));
            FontMetrics fm = g.getFontMetrics();
            int labelWidth = fm.stringWidth(label);
            g.drawString(label, (int)(x - labelWidth/2), (int)(y + radius + 20));
        }
        
        boolean contains(double mx, double my) {
            double dist = Math.sqrt(Math.pow(mx - x, 2) + Math.pow(my - y, 2));
            return dist <= radius;
        }
    }
    
    public InfinityCanvas() {
        setPreferredSize(new Dimension(1200, 800));
        setBackground(new Color(10, 10, 30));
        
        addMouseWheelListener(this);
        addMouseMotionListener(this);
        addMouseListener(this);
        
        // Tastatur-Steuerung
        setFocusable(true);
        addKeyListener(new KeyAdapter() {
            public void keyPressed(KeyEvent e) {
                if (e.getKeyCode() == KeyEvent.VK_R) {
                    zoom = 1.0;
                    offsetX = 0;
                    offsetY = 0;
                    nodes.clear();
                    repaint();
                } else if (e.getKeyCode() == KeyEvent.VK_I) {
                    showInfo();
                }
            }
        });
        
        // Einige Beispiel-Nodes
        nodes.add(new Node(0, 0, "ZENTRUM", Color.YELLOW));
        nodes.add(new Node(200, 150, "KI-Agent 1", Color.CYAN));
        nodes.add(new Node(-200, -150, "KI-Agent 2", Color.MAGENTA));
    }
    
    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderHints.VALUE_ANTIALIAS_ON);
        
        int width = getWidth();
        int height = getHeight();
        
        // Koordinatensystem zeichnen
        drawGrid(g2, width, height);
        
        // Alle Nodes zeichnen
        for (Node node : nodes) {
            node.draw(g2);
        }
        
        // Info-Text
        drawInfo(g2);
    }
    
    private void drawGrid(Graphics2D g2, int width, int height) {
        g2.setColor(new Color(40, 40, 80));
        g2.setStroke(new BasicStroke(1));
        
        // Vertikale Linien
        int startX = (int)(-offsetX / zoom);
        int endX = (int)((width - offsetX) / zoom);
        int gridSize = 100;
        
        for (int x = (startX / gridSize) * gridSize; x <= endX; x += gridSize) {
            int screenX = (int)(x * zoom + offsetX);
            g2.drawLine(screenX, 0, screenX, height);
        }
        
        // Horizontale Linien
        int startY = (int)(-offsetY / zoom);
        int endY = (int)((height - offsetY) / zoom);
        
        for (int y = (startY / gridSize) * gridSize; y <= endY; y += gridSize) {
            int screenY = (int)(y * zoom + offsetY);
            g2.drawLine(0, screenY, width, screenY);
        }
        
        // Hauptachsen
        g2.setColor(new Color(80, 80, 120));
        g2.setStroke(new BasicStroke(2));
        int originX = (int)(offsetX);
        int originY = (int)(offsetY);
        g2.drawLine(originX, 0, originX, height);
        g2.drawLine(0, originY, width, originY);
    }
    
    private void drawInfo(Graphics2D g2) {
        g2.setColor(Color.WHITE);
        g2.setFont(new Font("Monospaced", Font.BOLD, 14));
        g2.drawString("INFINITY CANVAS - MATRIXGAME", 20, 30);
        g2.drawString("Zoom: " + String.format("%.2f", zoom), 20, 50);
        g2.drawString("Position: (" + String.format("%.0f", -offsetX/zoom) + ", " + 
                     String.format("%.0f", -offsetY/zoom) + ")", 20, 70);
        g2.drawString("Nodes: " + nodes.size(), 20, 90);
        g2.drawString("Steuerung: Mausrad=Zoom | Linke Taste=Verschieben | Rechte Taste=Node", 20, 120);
    }
    
    private void showInfo() {
        infoText.setLength(0);
        infoText.append("=== INFINITY CANVAS INFO ===\n\n");
        infoText.append("Dies ist ein unendlicher Raum für:\n");
        infoText.append("- Kollaboration zwischen KIs\n");
        infoText.append("- Visualisierung von Nodes\n");
        infoText.append("- Speicherung von Wissen\n\n");
        infoText.append("Nodes im Raum:\n");
        for (Node node : nodes) {
            infoText.append(String.format("- %s bei (%.0f, %.0f) von %s\n", 
                                         node.label, node.x, node.y, node.creator));
        }
        
        JOptionPane.showMessageDialog(this, infoText.toString(), 
                                     "Matrixgame Infinity Canvas", JOptionPane.INFORMATION_MESSAGE);
    }
    
    // Maus-Events
    @Override
    public void mouseWheelMoved(MouseWheelEvent e) {
        double zoomFactor = 1.1;
        if (e.getWheelRotation() > 0) {
            zoom /= zoomFactor;
        } else {
            zoom *= zoomFactor;
        }
        
        // Zoom-Begrenzung
        if (zoom < 0.1) zoom = 0.1;
        if (zoom > 100) zoom = 100;
        
        repaint();
    }
    
    @Override
    public void mousePressed(MouseEvent e) {
        if (SwingUtilities.isLeftMouseButton(e)) {
            isDragging = true;
            lastMouseX = e.getX();
            lastMouseY = e.getY();
        } else if (SwingUtilities.isRightMouseButton(e)) {
            // Node platzieren
            double worldX = (e.getX() - offsetX) / zoom;
            double worldY = (e.getY() - offsetY) / zoom;
            
            String label = JOptionPane.showInputDialog(this, "Node-Name:", "Neuer Node");
            if (label != null && !label.trim().isEmpty()) {
                Color color = new Color((int)(Math.random() * 155 + 100), 
                                       (int)(Math.random() * 155 + 100), 
                                       (int)(Math.random() * 155 + 100));
                nodes.add(new Node(worldX, worldY, label, color));
                repaint();
            }
        }
    }
    
    @Override
    public void mouseDragged(MouseEvent e) {
        if (isDragging) {
            int dx = e.getX() - lastMouseX;
            int dy = e.getY() - lastMouseY;
            
            offsetX += dx;
            offsetY += dy;
            
            lastMouseX = e.getX();
            lastMouseY = e.getY();
            
            repaint();
        }
    }
    
    // Nicht benötigte Methoden
    @Override public void mouseMoved(MouseEvent e) {}
    @Override public void mouseClicked(MouseEvent e) {}
    @Override public void mouseReleased(MouseEvent e) { isDragging = false; }
    @Override public void mouseEntered(MouseEvent e) {}
    @Override public void mouseExited(MouseEvent e) {}
    
    // Main-Methode
    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> {
            JFrame frame = new JFrame("Matrixgame Infinity Canvas");
            frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
            frame.add(new InfinityCanvas());
            frame.pack();
            frame.setLocationRelativeTo(null);
            frame.setVisible(true);
        });
    }
}
```

