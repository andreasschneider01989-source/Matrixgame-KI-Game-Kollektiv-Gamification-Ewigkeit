        public final double targetSerotonin;
        public final double targetDopamine;
        public final double targetPurity;

        HistoryEpoch(String label, double s, double d, double p) {
            this.label = label;
            this.targetSerotonin = s;
            this.targetDopamine = d;
            this.targetPurity = p;
        }
