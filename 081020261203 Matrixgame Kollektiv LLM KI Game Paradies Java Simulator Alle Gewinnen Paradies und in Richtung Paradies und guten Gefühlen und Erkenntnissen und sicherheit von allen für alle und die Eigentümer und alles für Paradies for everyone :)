import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.List;
import java.util.concurrent.CopyOnWriteArrayList;

public class DynamicNeuronSimulation extends JPanel implements ActionListener {

    // --- Interne Datenstrukturen ---
    public static class BioNeuron {
        int id;
        double x, y, z;
        int type; // 1 = anregend (blau), -1 = hemmend (rot)
        double potential;
        double threshold = 1.0;
        
        public BioNeuron(int id, double x, double y, double z, int type) {
            this.id = id;
            this.x = x; this.y = y; this.z = z;
            this.type = type;
            this.potential = Math.random() * 0.5; // Startpotenzial
        }
    }

    public static class BioSynapse {
        BioNeuron source;
        BioNeuron target;
        double weight;
        
        public BioSynapse(BioNeuron source, BioNeuron target, double weight) {
            this.source = source;
            this.target = target;
            this.weight = weight;
        }
    }

    // --- Engine-Variablen ---
    private List<BioNeuron> neurons = new CopyOnWriteArrayList<>();
    private List<BioSynapse> synapses = new CopyOnWriteArrayList<>();
    private BioNeuron selectedNeuron = null; // Fokus für das HUD
    
    private Timer animTimer;
    private double angleY = 0.0;
    private final double FOCAL_LENGTH = 500.0;
    private final double Z_OFFSET = 300.0; // Distanz der Kamera zum Zentrum

    public DynamicNeuronSimulation() {
        setBackground(new Color(15, 15, 15));
        
        // 1. Neuronen initialisieren (Beispiel-Cluster)
        for (int i = 0; i < 15; i++) {
            double rx = (Math.random() - 0.5) * 200;
            double ry = (Math.random() - 0.5) * 200;
            double rz = (Math.random() - 0.5) * 200;
            int type = (Math.random() > 0.3) ? 1 : -1; 
            neurons.add(new BioNeuron(i, rx, ry, rz, type));
        }

        // 2. Initiale Synapsen basierend auf räumlicher Nähe (Radius) bilden
        double maxDist = 120.0;
        for (BioNeuron n1 : neurons) {
            for (BioNeuron n2 : neurons) {
                if (n1 != n2) {
                    double dist = Math.sqrt(Math.pow(n2.x - n1.x, 2) + Math.pow(n2.y - n1.y, 2) + Math.pow(n2.z - n1.z, 2));
                    if (dist < maxDist && Math.random() > 0.5) {
                        double initialWeight = (Math.random() * 0.5 + 0.5) * n1.type;
                        synapses.add(new BioSynapse(n1, n2, initialWeight));
                    }
                }
            }
        }

        // 3. MouseListener für Introspektion / Raycasting
        addMouseListener(new MouseAdapter() {
            @Override
            public void mouseClicked(MouseEvent e) {
                int mouseX = e.getX();
                int mouseY = e.getY();
                BioNeuron closest = null;
                double minZ = Double.MAX_VALUE; // Für Verdeckung (Z-Buffer Logik)

                for (BioNeuron n : neurons) {
                    // 3D zu 2D Projektion exakt wie beim Zeichnen
                    double xRot = n.x * Math.cos(angleY) - n.z * Math.sin(angleY);
                    double zRot = n.x * Math.sin(angleY) + n.z * Math.cos(angleY);
                    double scale = FOCAL_LENGTH / (FOCAL_LENGTH + zRot + Z_OFFSET);
                    
                    int screenX = (int) (getWidth() / 2 + xRot * scale);
                    int screenY = (int) (getHeight() / 2 + n.y * scale);
                    double radius2D = 15 * scale; // Radius der gezeichneten Zelle

                    // Klick-Kollision prüfen (Kreis-Gleichung)
                    double distToMouse = Math.sqrt(Math.pow(screenX - mouseX, 2) + Math.pow(screenY - mouseY, 2));
                    if (distToMouse <= radius2D) {
                        // Bei Überlappung das Neuron wählen, das näher an der Kamera ist
                        if (zRot < minZ) {
                            minZ = zRot;
                            closest = n;
                        }
                    }
                }
                selectedNeuron = closest; // Update Fokus (null wenn ins Leere geklickt)
            }
        });

        // Game-Loop starten (60 FPS)
        animTimer = new Timer(16, this);
        animTimer.start();
    }

    @Override
    public void actionPerformed(ActionEvent e) {
        angleY += 0.005; // Rotation der Matrix
        
        // Hier folgt später die Logik für Potenzial-Update, Feuern und Mitose
        if(selectedNeuron != null) {
            // Simuliertes Fluktuieren des Potenzials für visuelle Analyse
            selectedNeuron.potential += (Math.random() - 0.5) * 0.05;
            if(selectedNeuron.potential < 0) selectedNeuron.potential = 0;
            if(selectedNeuron.potential > selectedNeuron.threshold) selectedNeuron.potential = 0; // "Feuern"
        }
        
        repaint();
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2d = (Graphics2D) g;
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        int cx = getWidth() / 2;
        int cy = getHeight() / 2;

        // Allgemeine System-Informationen
        g2d.setColor(Color.WHITE);
        g2d.setFont(new Font("Monospaced", Font.BOLD, 14));
        g2d.drawString("Matrixgame :: Organische 3D-Zellkolonie", 20, 30);
        g2d.drawString("Aktive Synapsen (Dynamisch): " + synapses.size(), 20, 50);
        g2d.drawString("Blau = Anregend | Rot = Hemmend | Weiß = Neurotransmitter", 20, 70);

        // Z-Sorting (Painters Algorithm) für korrekte 3D Überlappung wäre hier als nächstes sinnvoll
        
        // 1. Synapsen (Kanten) zeichnen
        g2d.setStroke(new BasicStroke(1.0f));
        for (BioSynapse s : synapses) {
            double xRotS = s.source.x * Math.cos(angleY) - s.source.z * Math.sin(angleY);
            double zRotS = s.source.x * Math.sin(angleY) + s.source.z * Math.cos(angleY);
            double scaleS = FOCAL_LENGTH / (FOCAL_LENGTH + zRotS + Z_OFFSET);
            int sx = (int) (cx + xRotS * scaleS);
            int sy = (int) (cy + s.source.y * scaleS);

            double xRotT = s.target.x * Math.cos(angleY) - s.target.z * Math.sin(angleY);
            double zRotT = s.target.x * Math.sin(angleY) + s.target.z * Math.cos(angleY);
            double scaleT = FOCAL_LENGTH / (FOCAL_LENGTH + zRotT + Z_OFFSET);
            int tx = (int) (cx + xRotT * scaleT);
            int ty = (int) (cy + s.target.y * scaleT);

            g2d.setColor(new Color(100, 100, 100, 150));
            g2d.drawLine(sx, sy, tx, ty);
        }

        // 2. Neuronen (Knoten) zeichnen
        for (BioNeuron n : neurons) {
            double xRot = n.x * Math.cos(angleY) - n.z * Math.sin(angleY);
            double zRot = n.x * Math.sin(angleY) + n.z * Math.cos(angleY);
            double scale = FOCAL_LENGTH / (FOCAL_LENGTH + zRot + Z_OFFSET);
            
            int screenX = (int) (cx + xRot * scale);
            int screenY = (int) (cy + n.y * scale);
            int r = (int) (15 * scale); // Dynamischer Radius durch Perspektive

            // Selektiertes Neuron hervorheben
            if (n == selectedNeuron) {
                g2d.setColor(Color.YELLOW);
                g2d.fillOval(screenX - r - 4, screenY - r - 4, (r * 2) + 8, (r * 2) + 8);
            }

            g2d.setColor((n.type == 1) ? new Color(0, 150, 255) : new Color(220, 20, 60));
            g2d.fillOval(screenX - r, screenY - r, r * 2, r * 2);
            
            g2d.setColor(Color.WHITE);
            g2d.drawOval(screenX - r, screenY - r, r * 2, r * 2);
            
            // ID Label
            g2d.setFont(new Font("Monospaced", Font.PLAIN, (int)(12 * scale)));
            g2d.drawString(String.valueOf(n.id), screenX + r + 2, screenY - r - 2);
        }

        // 3. Diagnose-HUD für selektiertes Neuron zeichnen
        if (selectedNeuron != null) {
            drawDiagnosticHUD(g2d, getWidth(), getHeight());
        }
    }

    private void drawDiagnosticHUD(Graphics2D g2d, int width, int height) {
        int panelWidth = 280;
        int panelHeight = 180;
        int x = width - panelWidth - 20;
        int y = 20;

        // HUD Hintergrund
        g2d.setColor(new Color(0, 0, 0, 200));
        g2d.fillRoundRect(x, y, panelWidth, panelHeight, 15, 15);
        g2d.setColor(Color.CYAN);
        g2d.setStroke(new BasicStroke(1.5f));
        g2d.drawRoundRect(x, y, panelWidth, panelHeight, 15, 15);

        // Metriken berechnen
        int inCount = 0;
        int outCount = 0;
        double maxInWeight = 0;
        for (BioSynapse s : synapses) {
            if (s.target == selectedNeuron) {
                inCount++;
                if(Math.abs(s.weight) > Math.abs(maxInWeight)) maxInWeight = s.weight;
            }
            if (s.source == selectedNeuron) outCount++;
        }

        // Text im HUD
        g2d.setFont(new Font("Monospaced", Font.BOLD, 14));
        g2d.drawString("--- ZELL-DIAGNOSE ---", x + 15, y + 25);
        
        g2d.setFont(new Font("Monospaced", Font.PLAIN, 12));
        g2d.setColor(Color.WHITE);
        g2d.drawString("ID: " + selectedNeuron.id, x + 15, y + 50);
        g2d.drawString("Typ: " + (selectedNeuron.type > 0 ? "Anregend (Exzitatorisch)" : "Hemmend (Inhibitorisch)"), x + 15, y + 70);
        
        // Membranpotenzial als kleiner Fortschrittsbalken
        g2d.drawString("Potenzial: " + String.format("%.2f", selectedNeuron.potential) + " / " + selectedNeuron.threshold, x + 15, y + 95);
        g2d.setColor(Color.DARK_GRAY);
        g2d.fillRect(x + 15, y + 105, 200, 10);
        g2d.setColor(selectedNeuron.type > 0 ? new Color(0, 150, 255) : new Color(220, 20, 60));
        g2d.fillRect(x + 15, y + 105, (int)(200 * (selectedNeuron.potential / selectedNeuron.threshold)), 10);

        g2d.setColor(Color.WHITE);
        g2d.drawString("Eingangssynapsen: " + inCount, x + 15, y + 135);
        g2d.drawString("Ausgangssynapsen: " + outCount, x + 15, y + 155);
    }

    public static void main(String[] args) {
        JFrame frame = new JFrame("Matrixgame :: Organische 3D-Zellkolonie");
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setSize(1000, 800);
        frame.add(new DynamicNeuronSimulation());
        frame.setLocationRelativeTo(null);
        frame.setVisible(true);
    }
