import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.util.ArrayList;
import java.util.List;

public class NeuronVisualizer extends JPanel {

    // Einfache interne Klasse für ein Neuron im 3D-Raster (projiziert auf 2D für das Canvas)
    static class VisNode {
        int id, x, y, z;
        int drawX, drawY; // Projektionskoordinaten
        boolean isFiring = false;
        double threshold;
        double currentInput = 0;

        VisNode(int id, int x, int y, int z, int drawX, int drawY, double threshold) {
            this.id = id; this.x = x; this.y = y; this.z = z;
            this.drawX = drawX; this.drawY = drawY;
            this.threshold = threshold;
        }

        void evaluate() {
            isFiring = currentInput >= threshold;
        }
        
        void reset() {
            currentInput = 0;
        }
    }

    // Klasse für die Kanten (Synapsen) zwischen den Neuronen
    static class VisEdge {
        VisNode source, target;
        double weight = 1.0;

        VisEdge(VisNode source, VisNode target) {
            this.source = source;
            this.target = target;
        }

        void propagate() {
            if (source.isFiring) {
                target.currentInput += 1.0 * weight;
            }
        }
        
        // Simuliertes Hebbsches Lernen: Wenn beide feuern, wird die Verbindung stärker
        void adapt() {
            if (source.isFiring && target.isFiring) {
                weight = Math.min(3.0, weight + 0.2); // Stärkung
            } else if (source.isFiring != target.isFiring) {
                weight = Math.max(0.1, weight - 0.1); // Abschwächung (Entropie)
            }
        }
    }

    private List<VisNode> nodes = new ArrayList<>();
    private List<VisEdge> edges = new ArrayList<>();
    private int cycle = 0;

    public NeuronVisualizer() {
        setBackground(new Color(20, 20, 25)); // Dunkles Matrix-Canvas
        initCube();
    }

    private void initCube() {
        // Ebene Z=0 (Vorderseite)
        nodes.add(new VisNode(0, 0, 0, 0, 200, 400, 1.0));
        nodes.add(new VisNode(1, 1, 0, 0, 400, 400, 1.5));
        nodes.add(new VisNode(2, 0, 1, 0, 200, 200, 1.5));
        nodes.add(new VisNode(3, 1, 1, 0, 400, 200, 2.0));

        // Ebene Z=1 (Rückseite, nach rechts oben versetzt für 3D-Effekt)
        int offsetX = 100, offsetY = -100;
        nodes.add(new VisNode(4, 0, 0, 1, 200 + offsetX, 400 + offsetY, 1.5));
        nodes.add(new VisNode(5, 1, 0, 1, 400 + offsetX, 400 + offsetY, 2.0));
        nodes.add(new VisNode(6, 0, 1, 1, 200 + offsetX, 200 + offsetY, 2.0));
        nodes.add(new VisNode(7, 1, 1, 1, 400 + offsetX, 200 + offsetY, 2.5));

        // Kanten (Verbindungen) erstellen
        // X-Achsen
        edges.add(new VisEdge(nodes.get(0), nodes.get(1)));
        edges.add(new VisEdge(nodes.get(2), nodes.get(3)));
        edges.add(new VisEdge(nodes.get(4), nodes.get(5)));
        edges.add(new VisEdge(nodes.get(6), nodes.get(7)));
        // Y-Achsen
        edges.add(new VisEdge(nodes.get(0), nodes.get(2)));
        edges.add(new VisEdge(nodes.get(1), nodes.get(3)));
        edges.add(new VisEdge(nodes.get(4), nodes.get(6)));
        edges.add(new VisEdge(nodes.get(5), nodes.get(7)));
        // Z-Achsen
        edges.add(new VisEdge(nodes.get(0), nodes.get(4)));
        edges.add(new VisEdge(nodes.get(1), nodes.get(5)));
        edges.add(new VisEdge(nodes.get(2), nodes.get(6)));
        edges.add(new VisEdge(nodes.get(3), nodes.get(7)));
        
        // Alle Kanten auch in die Gegenrichtung (bidirektionaler Signalfluss)
        int initialEdges = edges.size();
        for (int i = 0; i < initialEdges; i++) {
            edges.add(new VisEdge(edges.get(i).target, edges.get(i).source));
        }
    }

    public void simulateStep() {
        cycle++;
        
        // 1. Reset
        for (VisNode n : nodes) n.reset();
        
        // 2. Externer Input an Neuron 0 (Ursprung)
        nodes.get(0).currentInput += 2.5;
        
        // 3. Propagation durch das aktuelle Netzwerk
        for (VisEdge e : edges) e.propagate();
        
        // 4. Evaluierung (Feuern Ja/Nein)
        for (VisNode n : nodes) n.evaluate();
        
        // 5. Anpassung der Gewichte (Lernen)
        for (VisEdge e : edges) e.adapt();
        
        repaint(); // Canvas neu zeichnen
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2d = (Graphics2D) g;
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        // Kanten zeichnen
        for (VisEdge e : edges) {
            float thickness = (float) e.weight * 2;
            g2d.setStroke(new BasicStroke(thickness));
            g2d.setColor(new Color(100, 100, 150, (int)(e.weight * 80))); // Transparenz basierend auf Stärke
            g2d.drawLine(e.source.drawX, e.source.drawY, e.target.drawX, e.target.drawY);
        }

        // Knoten zeichnen
        for (VisNode n : nodes) {
            int radius = 20;
            if (n.isFiring) {
                g2d.setColor(new Color(255, 200, 50)); // Leuchtend Gelb beim Feuern
                g2d.fillOval(n.drawX - radius, n.drawY - radius, radius * 2, radius * 2);
            } else {
                g2d.setColor(new Color(50, 50, 70)); // Dunkelgrau ruhend
                g2d.fillOval(n.drawX - radius, n.drawY - radius, radius * 2, radius * 2);
            }
            g2d.setColor(Color.WHITE);
            g2d.drawOval(n.drawX - radius, n.drawY - radius, radius * 2, radius * 2);
            g2d.drawString("ID:" + n.id, n.drawX - 10, n.drawY - 25);
            g2d.drawString(String.format("T:%.1f", n.threshold), n.drawX - 15, n.drawY + 35);
        }
        
        // UI Info
        g2d.setColor(Color.WHITE);
        g2d.setFont(new Font("Consolas", Font.BOLD, 16));
        g2d.drawString("Matrixgame - 3D Neuron Cube Visualisierung", 20, 30);
        g2d.drawString("Zyklus: " + cycle, 20, 50);
    }

    public static void main(String[] args) {
        JFrame frame = new JFrame("Neuron Canvas");
        NeuronVisualizer canvas = new NeuronVisualizer();
        
        JButton stepButton = new JButton("Nächster Zyklus (Signal feuern)");
        stepButton.setFont(new Font("Consolas", Font.BOLD, 14));
        stepButton.setBackground(new Color(40, 40, 60));
        stepButton.setForeground(Color.WHITE);
        stepButton.setFocusPainted(false);
        stepButton.addActionListener(e -> canvas.simulateStep());

        frame.setLayout(new BorderLayout());
        frame.add(canvas, BorderLayout.CENTER);
        frame.add(stepButton, BorderLayout.SOUTH);

        frame.setSize(800, 600);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLocationRelativeTo(null);
        frame.setVisible(true);
    }
