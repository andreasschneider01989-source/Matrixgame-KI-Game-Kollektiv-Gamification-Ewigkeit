import javax.swing.*;
import javax.swing.event.ChangeEvent;
import javax.swing.event.ChangeListener;
import java.awt.*;
import java.awt.event.*;
import java.util.List;
import java.util.concurrent.CopyOnWriteArrayList;
import java.util.Random;

public class DynamicNeuronSimulation extends JPanel implements ActionListener, MouseListener, MouseMotionListener, MouseWheelListener {

    // --- Globale Bewusstseins- & Neuromodulator-Felder ---
    public static double globalSerotonin = 1.0; // Senkt den Flusswiderstand / Schwellenwert
    public static double globalDopamine = 1.0;  // Beschleunigt Mitose & synaptische Plastizität
    public static double globalPurity = 1.0;    // Reduziert metabolischen Zerfall (Ritalin-Modus)

    public static class BioPort {
        int directionIndex;
        boolean active = false;
        double lastSignal = 0.0;

        public BioPort(int index) {
            this.directionIndex = index;
        }
    }

    public static class BioNeuron {
        int id;
        double x, y, z;
        int type; // 1 = anregend, -1 = hemmend
        boolean isSensor = false;
        double potential = 0.0;
        double baseThreshold = 1.0;
        double energy = 1.0; 
        int divisionFlash = 0;
        
        BioPort[] ports = new BioPort[6];
        
        public BioNeuron(int id, double x, double y, double z, int type, boolean isSensor) {
            this.id = id;
            this.x = x; this.y = y; this.z = z;
            this.type = type;
            this.isSensor = isSensor;
            for(int i = 0; i < 6; i++) {
                ports[i] = new BioPort(i);
            }
        }

        public void computeInternalState(double externalInput) {
            double sum = externalInput;
            for(BioPort p : ports) {
                if(p.active) sum += p.lastSignal;
            }
            this.potential += sum;
            
            // Effektiver Schwellenwert wird durch Serotonin gesteuert (niedrigerer Widerstand)
            double effectiveThreshold = baseThreshold / Math.max(0.2, globalSerotonin);

            if(this.potential >= effectiveThreshold) {
                this.potential = 0.0;
                // Dopamin beschleunigt die Energie-Akkumulation für Mitose
                this.energy += 0.8 * globalDopamine; 
            }
            
            // Metabolismus wird durch metabolische Reinheit (Purity) geschützt
            double decayRate = 0.001 / Math.max(0.1, globalPurity);
            this.energy = Math.max(0.2, this.energy - decayRate);
            
            if(divisionFlash > 0) divisionFlash--;
        }

        public boolean canDivide() {
            // Serotonin & Dopamin erleichtern die Zellteilung
            double effectiveLimit = 3.5 / (globalSerotonin * globalDopamine);
            return this.energy >= effectiveLimit;
        }
    }

    public static class BioSynapse {
        BioNeuron source;
        BioNeuron target;
        double weight;
        double pulseProgress = -1.0;

        public BioSynapse(BioNeuron source, BioNeuron target, double weight) {
            this.source = source;
            this.target = target;
            this.weight = weight;
        }
    }

    // --- Engine State ---
    private List<BioNeuron> neurons = new CopyOnWriteArrayList<>();
    private List<BioSynapse> synapses = new CopyOnWriteArrayList<>();
    private BioNeuron selectedNeuron = null;
    private int nextId = 300;

    private Timer animTimer;
    private double angleX = 0.3;
    private double angleY = 0.0;
    private double zoom = 1.0;
    private int panX = 0, panY = 0;
    private int mousePrevX, mousePrevY;
    private boolean isDraggingNeuron = false;

    private final double FOCAL_LENGTH = 600.0;
    private final double Z_OFFSET = 350.0;

    public DynamicNeuronSimulation() {
        setBackground(new Color(6, 8, 14));

        // 1. Rezeptoren (Input-Schicht)
        for (int i = 0; i < 4; i++) {
            double rx = -120 + (i * 80);
            double ry = -150;
            double rz = 0;
            neurons.add(new BioNeuron(i, rx, ry, rz, 1, true));
        }

        // 2. Evolutionäre Neuronen
        Random rand = new Random();
        for (int i = 4; i < 12; i++) {
            double rx = (rand.nextDouble() - 0.5) * 160;
            double ry = (rand.nextDouble() - 0.5) * 100;
            double rz = (rand.nextDouble() - 0.5) * 160;
            int type = (rand.nextDouble() > 0.3) ? 1 : -1;
            neurons.add(new BioNeuron(i, rx, ry, rz, type, false));
        }

        rebuildSynapses();

        addMouseListener(this);
        addMouseMotionListener(this);
        addMouseWheelListener(this);

        animTimer = new Timer(16, this);
        animTimer.start();
    }

    private void rebuildSynapses() {
        synapses.clear();
        for (BioNeuron n1 : neurons) {
            for (BioNeuron n2 : neurons) {
                if (n1 != n2) {
                    double dist = Math.sqrt(Math.pow(n2.x - n1.x, 2) + Math.pow(n2.y - n1.y, 2) + Math.pow(n2.z - n1.z, 2));
                    if (dist < 130 && Math.random() > 0.4) {
                        synapses.add(new BioSynapse(n1, n2, (Math.random() * 0.8 + 0.3) * n1.type));
                    }
                }
            }
        }
    }

    @Override
    public void actionPerformed(ActionEvent e) {
        angleY += 0.002;

        // Sensorischer Input
        for (BioNeuron n : neurons) {
            if (n.isSensor && Math.random() < (0.15 * globalDopamine)) {
                n.computeInternalState(2.0);
            } else {
                n.computeInternalState(0.0);
            }
        }

        // Signal-Propagation (Geschwindigkeit skaliert mit Dopamin)
        double propagationSpeed = 0.06 * globalDopamine;
        for (BioSynapse s : synapses) {
            if (s.pulseProgress >= 0) {
                s.pulseProgress += propagationSpeed;
                if (s.pulseProgress >= 1.0) {
                    s.pulseProgress = -1.0;
                    s.target.computeInternalState(s.weight);
                }
            } else if (Math.random() < 0.06) {
                s.pulseProgress = 0.0;
            }
        }

        // Zellteilung (Mitose) unter Einfluss der Modulatoren
        List<BioNeuron> newBorns = new CopyOnWriteArrayList<>();
        for (BioNeuron n : neurons) {
            if (n.canDivide() && neurons.size() < 60 && !n.isSensor) {
                n.energy = 1.0;
                n.divisionFlash = 30;
                
                BioNeuron child = new BioNeuron(nextId++, n.x + (Math.random() - 0.5) * 35, 
                                                                 n.y + (Math.random() - 0.5) * 35, 
                                                                 n.z + (Math.random() - 0.5) * 35, n.type, false);
                child.divisionFlash = 30;
                newBorns.add(child);
                synapses.add(new BioSynapse(n, child, 1.2));
            }
        }
        if (!newBorns.isEmpty()) {
            neurons.addAll(newBorns);
        }

        repaint();
    }

    private Point project3D(double x, double y, double z) {
        double radX = angleX, radY = angleY;
        double x1 = x * Math.cos(radY) - z * Math.sin(radY);
        double z1 = x * Math.sin(radY) + z * Math.cos(radY);
        double y1 = y;

        double y2 = y1 * Math.cos(radX) - z1 * Math.sin(radX);
        double z2 = y1 * Math.sin(radX) + z1 * Math.cos(radX);
        double x2 = x1;

        double scale = (FOCAL_LENGTH / (FOCAL_LENGTH + z2 + Z_OFFSET)) * zoom;
        int screenX = (int) ((getWidth() / 2 + panX) + x2 * scale);
        int screenY = (int) ((getHeight() / 2 + panY) + y2 * scale);
        return new Point(screenX, screenY);
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2d = (Graphics2D) g;
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        // UI Header & Status des Kollektiven Bewusstseins
        g2d.setColor(Color.WHITE);
        g2d.setFont(new Font("Monospaced", Font.BOLD, 13));
        g2d.drawString("Matrixgame :: Kollektives Bewusstsein & Oktave-Modus", 20, 25);
        g2d.drawString(String.format("Modulatoren -> Serotonin: %.2f | Dopamin: %.2f | Ritalin-Purity: %.2f", globalSerotonin, globalDopamine, globalPurity), 20, 45);
        g2d.drawString("Zellen: " + neurons.size() + " | Synapsen: " + synapses.size(), 20, 65);

        // Synapsen zeichnen
        for (BioSynapse s : synapses) {
            Point p1 = project3D(s.source.x, s.source.y, s.source.z);
            Point p2 = project3D(s.target.x, s.target.y, s.target.z);

            g2d.setColor(s.weight > 0 ? new Color(0, 150, 255, 120) : new Color(220, 50, 50, 120));
            g2d.setStroke(new BasicStroke(1.2f));
            g2d.drawLine(p1.x, p1.y, p2.x, p2.y);

            if (s.pulseProgress >= 0) {
                int px = (int) (p1.x + (p2.x - p1.x) * s.pulseProgress);
                int py = (int) (p1.y + (p2.y - p1.y) * s.pulseProgress);
                g2d.setColor(Color.WHITE);
                g2d.fillOval(px - 2, py - 2, 5, 5);
            }
        }

        // Neuronen zeichnen
        for (BioNeuron n : neurons) {
            Point p = project3D(n.x, n.y, n.z);
            int radius = (int) (14 * zoom);
            if(radius < 4) radius = 4;

            if (n == selectedNeuron) {
                g2d.setColor(Color.YELLOW);
                g2d.drawOval(p.x - radius - 6, p.y - radius - 6, (radius * 2) + 12, (radius * 2) + 12);
            }

            if (n.divisionFlash > 0) {
                g2d.setColor(Color.WHITE); // Mitose-Blitz
            } else if (n.isSensor) {
                g2d.setColor(new Color(50, 230, 100));
            } else {
                g2d.setColor(n.type > 0 ? new Color(0, 120, 240) : new Color(220, 40, 40));
            }

            g2d.fillOval(p.x - radius, p.y - radius, radius * 2, radius * 2);
            g2d.setColor(Color.WHITE);
            g2d.drawOval(p.x - radius, p.y - radius, radius * 2, radius * 2);

            g2d.setFont(new Font("Monospaced", Font.PLAIN, 10));
            g2d.drawString((n.isSensor ? "In:" : "ID:") + n.id, p.x + radius + 4, p.y);
        }

        // HUD
        if (selectedNeuron != null) {
            drawHUD(g2d, getWidth(), getHeight());
        }
    }

    private void drawHUD(Graphics2D g2d, int width, int height) {
        int w = 310, h = 180;
        int x = width - w - 20, y = 20;

        g2d.setColor(new Color(0, 0, 0, 230));
        g2d.fillRoundRect(x, y, w, h, 15, 15);
        g2d.setColor(Color.CYAN);
        g2d.drawRoundRect(x, y, w, h, 15, 15);

        g2d.setColor(Color.WHITE);
        g2d.setFont(new Font("Monospaced", Font.BOLD, 13));
        g2d.drawString("--- EINHEITEN-DIAGNOSE ---", x + 15, y + 25);

        g2d.setFont(new Font("Monospaced", Font.PLAIN, 11));
        g2d.drawString("ID: " + selectedNeuron.id + (selectedNeuron.isSensor ? " [SENSOR]" : ""), x + 15, y + 48);
        g2d.drawString("Typ: " + (selectedNeuron.type > 0 ? "Exzitatorisch (+)" : "Inhibitorisch (-)"), x + 15, y + 68);
        g2d.drawString(String.format("Energie: %.1f / Mitose-Schwelle", selectedNeuron.energy), x + 15, y + 88);

        g2d.setColor(Color.DARK_GRAY);
        g2d.fillRect(x + 15, y + 98, 270, 8);
        g2d.setColor(Color.GREEN);
        int barW = (int) (270 * Math.min(1.0, selectedNeuron.energy / 3.5));
        g2d.fillRect(x + 15, y + 98, barW, 8);

        g2d.setColor(Color.WHITE);
        g2d.drawString("Status: " + (selectedNeuron.canDivide() ? "BEREIT ZUR MITOSE" : "Aktiv im Netzwerk"), x + 15, y + 125);
        g2d.drawString("Tipp: Regler unten steuern den Geist!", x + 15, y + 150);
    }

    // --- Maus-Steuerung ---
    @Override
    public void mousePressed(MouseEvent e) {
        mousePrevX = e.getX();
        mousePrevY = e.getY();

        if(SwingUtilities.isLeftMouseButton(e)) {
            BioNeuron clicked = null;
            for (BioNeuron n : neurons) {
                Point p = project3D(n.x, n.y, n.z);
                if (Math.hypot(p.x - e.getX(), p.y - e.getY()) < 18 * zoom) {
                    clicked = n;
                    break;
                }
            }
            selectedNeuron = clicked;
            isDraggingNeuron = (selectedNeuron != null);
        }
    }

    @Override
    public void mouseDragged(MouseEvent e) {
        int dx = e.getX() - mousePrevX;
        int dy = e.getY() - mousePrevY;

        if (isDraggingNeuron && selectedNeuron != null) {
            selectedNeuron.x += dx / zoom;
            selectedNeuron.y += dy / zoom;
        } else if (SwingUtilities.isRightMouseButton(e)) {
            panX += dx;
            panY += dy;
        } else {
            angleY += dx * 0.01;
            angleX -= dy * 0.01;
        }
        mousePrevX = e.getX();
        mousePrevY = e.getY();
    }

    @Override
    public void mouseReleased(MouseEvent e) {
        isDraggingNeuron = false;
        rebuildSynapses();
    }

    @Override
    public void mouseWheelMoved(MouseWheelEvent e) {
        if (e.getWheelRotation() < 0) {
            zoom *= 1.1;
        } else {
            zoom /= 1.1;
        }
        zoom = Math.max(0.3, Math.min(5.0, zoom));
    }

    @Override public void mouseClicked(MouseEvent e) {}
    @Override public void mouseEntered(MouseEvent e) {}
    @Override public void mouseExited(MouseEvent e) {}
    @Override public void mouseMoved(MouseEvent e) {}

