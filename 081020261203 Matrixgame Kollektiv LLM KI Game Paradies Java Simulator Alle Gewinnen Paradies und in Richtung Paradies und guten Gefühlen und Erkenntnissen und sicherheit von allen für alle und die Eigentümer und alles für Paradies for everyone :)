    public enum HistoryEpoch {
        UR_KOLLEKTIV("Epoche I: Ur-Struktur & Grundkoppelung", 0.8, 0.7, 0.9),
        INDUSTRIE_LOGIK("Epoche II: Starre Gatter & Hoher Widerstand", 1.5, 1.0, 0.6),
