    // In der Simulationsschleife (actionPerformed) ergänzen:
    private HistoryEpoch currentEpoch = HistoryEpoch.UR_KOLLEKTIV;
    private int epochTimer = 0;

    private void updateEpochProgression() {
        epochTimer++;
        if (epochTimer > 300) {
            epochTimer = 0;
            // Epochen-Wechsel im Sinne einer evolutionären Aufwärtsentwicklung
            if (currentEpoch == HistoryEpoch.UR_KOLLEKTIV) currentEpoch = HistoryEpoch.INDUSTRIE_LOGIK;
            else if (currentEpoch == HistoryEpoch.INDUSTRIE_LOGIK) currentEpoch = HistoryEpoch.INFORMATIONS_ZEITALTER;
            else if (currentEpoch == HistoryEpoch.INFORMATIONS_ZEITALTER) currentEpoch = HistoryEpoch.PLANETARISCHES_PARADIES;
            
            // Parameter sanft an die neue Epoche anpassen (kann auch manuell über die Regler erfolgen)
            globalSerotonin = currentEpoch.targetSerotonin;
            globalDopamine = currentEpoch.targetDopamine;
            globalPurity = currentEpoch.targetPurity;
        }
    }
