package ordner1;

import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.util.ArrayList;
import java.util.Iterator;
import java.util.List;
import java.util.Random;

/**
 * DYNAMISCHE 3D-NEURONEN-SIMULATION
 * Matrixgame Core :: Organische Rekombination & 3D-Kinetik
 */
public class DynamicNeuronSimulation extends JPanel implements ActionListener {

    public enum TransmitterType { EXCITATORY, INHIBITORY }

    // 3D-Neuron mit freier Kinetik
    static class BioNeuron {
        int id;
        double x, y, z;          // 3D-Koordinaten [-200, 200]
        double vx, vy, vz;       // Geschwindigkeitsvektoren
        double threshold;
        double charge = 0.0;
        boolean firing = false;
        TransmitterType type;
        int activeConnections = 0;
        static final int MAX_PORTS = 6;

        BioNeuron(int id, double x, double y, double z, TransmitterType type) {
            this.id = id;
            this.x = x; this.y = y; this.z = z;
            this.type = type;
            this.threshold = 1.2 + new Random().nextDouble() * 0.8;
        }

        void updatePosition() {
            // Organische Mikrobewegung (Brownsche Molekularbewegung / Drift)
            x += vx; y += vy; z += vz;
            
            // Randausgleich (Sanfte Rückkehr zum Zentrum)
            vx -= x * 0.0005;
            vy -= y * 0.0005;
            vz -= z * 0.0005;

            // Reibung
            vx *= 0.95; vy *= 0.95; vz *= 0.95;
        }

        void evaluate() {
            firing = charge >= threshold;
            if (firing) {
                charge = 0.0; // Entladung
            } else {
                charge *= 0.85; // Energetischer Zerfall
            }
        }
    }

    // Dynamische Synapse
    static class BioSynapse {
        BioNeuron source, target;
        double weight = 1.0;
        double signalProgress = -1.0; // Animation des Neurotransmitters

        BioSynapse(BioNeuron source, BioNeuron target) {
            this.source = source;
            this.target = target;
            source.activeConnections++;
            target.activeConnections++;
        }

        boolean updateAndPropagate() {
            // Signal weiterleiten
            if (source.firing && signalProgress < 0) {
                signalProgress = 0.0;
            }

            if (signalProgress >= 0) {
                signalProgress += 0.2; // Signalgeschwindigkeit
                if (signalProgress >= 1.0) {
                    double impact = (source.type == TransmitterType.EXCITATORY) ? weight : -weight;
                    target.charge += impact;
                    signalProgress = -1.0;
                    
                    // Synaptische Plastizität
                    if (target.firing) {
                        weight = Math.min(2.5, weight + 0.15); // Stärkung
                    }
                }
            } else {
                // Passiver Zerfall bei Nichtnutzung
                weight -= 0.002;
            }

            // Rückmeldung: Soll die Verbindung getrennt werden?
            return weight <= 0.15 || getDistance() > 220;
        }

        double getDistance() {
            double dx = source.x - target.x;
            double dy = source.y - target.y;
            double dz = source.z - target.z;
            return Math.sqrt(dx * dx + dy * dy + dz * dz);
        }

        void disconnect() {
            source.activeConnections = Math.max(0, source.activeConnections - 1);
            target.activeConnections = Math.max(0, target.activeConnections - 1);
        }
    }

    private final List<BioNeuron> neurons = new ArrayList<>();
    private final List<BioSynapse> synapses = new ArrayList<>();
    private final Timer animTimer;
    private double angleY = 0; // Kamera-Rotation um Y-Achse
    private int cycleCount = 0;

    public DynamicNeuronSimulation(int numNeurons) {
        setBackground(new Color(12, 14, 20));
        Random rand = new Random();

        // 1. Initialisierung der Neuronen
        for (int i = 0; i < numNeurons; i++) {
            double rx = (rand.nextDouble() - 0.5) * 250;
            double ry = (rand.nextDouble() - 0.5) * 250;
            double rz = (rand.nextDouble() - 0.5) * 250;
            TransmitterType type = (rand.nextDouble() > 0.25) ? TransmitterType.EXCITATORY : TransmitterType.INHIBITORY;
            neurons.add(new BioNeuron(i, rx, ry, rz, type));
        }

        // 60 FPS Animations-Schleife
        animTimer = new Timer(16, this);
        animTimer.start();
    }

    @Override
    public void actionPerformed(ActionEvent e) {
        angleY += 0.008; // Sanfte 3D-Kamera-Rotation
        cycleCount++;

        // Periodischer Reiz an zufällige Neuronen
        if (cycleCount % 40 == 0 && !neurons.isEmpty()) {
            neurons.get(new Random().nextInt(neurons.size())).charge += 2.5;
        }

        // A. Neuronen-Kinetik & Abstößung
        for (int i = 0; i < neurons.size(); i++) {
            BioNeuron n1 = neurons.get(i);
            n1.updatePosition();

            for (int j = i + 1; j < neurons.size(); j++) {
                BioNeuron n2 = neurons.get(j);
                double dx = n2.x - n1.x;
                double dy = n2.y - n1.y;
                double dz = n2.z - n1.z;
                double dist = Math.sqrt(dx * dx + dy * dy + dz * dz);

                // Physikalische Abstößung bei zu hoher Dichte
                if (dist < 60 && dist > 0) {
                    double force = (60 - dist) * 0.01;
                    n1.vx -= (dx / dist) * force;
                    n1.vy -= (dy / dist) * force;
                    n1.vz -= (dz / dist) * force;
                    n2.vx += (dx / dist) * force;
                    n2.vy += (dy / dist) * force;
                    n2.vz += (dz / dist) * force;
                }

                // B. DYNAMISCHES WACHSTUM (Synaptogenese): Verbinden bei Nähe
                if (dist < 110 && n1.activeConnections < BioNeuron.MAX_PORTS && n2.activeConnections < BioNeuron.MAX_PORTS) {
                    if (!isConnected(n1, n2)) {
                        synapses.add(new BioSynapse(n1, n2));
                    }
                }
            }
            n1.evaluate();
        }

        // C. DYNAMISCHES TRENNEN (Pruning): Abgebrochene Verbindungen entfernen
        Iterator<BioSynapse> iterator = synapses.iterator();
        while (iterator.hasNext()) {
            BioSynapse syn = iterator.next();
            boolean sever = syn.updateAndPropagate();
            if (sever) {
                syn.disconnect();
                iterator.remove(); // Die Verbindung löst sich physisch auf!
            }
        }

        repaint();
    }

    private boolean isConnected(BioNeuron n1, BioNeuron n2) {
        for (BioSynapse s : synapses) {
            if ((s.source == n1 && s.target == n2) || (s.source == n2 && s.target == n1)) {
                return true;
            }
        }
        return false;
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        int centerX = getWidth() / 2;
        int centerY = getHeight() / 2;

        // Render-Reihenfolge: Synapsen zeichnen
        for (BioSynapse s : synapses) {
            Point p1 = project3D(s.source.x, s.source.y, s.source.z, centerX, centerY);
            Point p2 = project3D(s.target.x, s.target.y, s.target.z, centerX, centerY);

            float alpha = Math.min(1.0f, Math.max(0.1f, (float) s.weight / 2.0f));
            if (s.source.type == TransmitterType.EXCITATORY) {
                g2.setColor(new Color(0.2f, 0.8f, 1.0f, alpha));
            } else {
                g2.setColor(new Color(1.0f, 0.3f, 0.3f, alpha));
            }

            g2.setStroke(new BasicStroke((float) s.weight * 1.5f));
            g2.drawLine(p1.x, p1.y, p2.x, p2.y);

            // Signal-Impuls (Lichtpunkt auf der Synapse)
            if (s.signalProgress >= 0) {
                int sigX = (int) (p1.x + (p2.x - p1.x) * s.signalProgress);
                int sigY = (int) (p1.y + (p2.y - p1.y) * s.signalProgress);
                g2.setColor(Color.WHITE);
                g2.fillOval(sigX - 4, sigY - 4, 8, 8);
            }
        }

        // Render-Reihenfolge: Neuronen zeichnen
        for (BioNeuron n : neurons) {
            Point p = project3D(n.x, n.y, n.z, centerX, centerY);
            double scale = getZScale(n.z); // Tiefenperspektive
            int radius = (int) (14 * scale);

            if (n.firing) {
                g2.setColor(new Color(255, 230, 80)); // Auslösendes Signal
            } else if (n.type == TransmitterType.EXCITATORY) {
                g2.setColor(new Color(40, 180, 220)); // Exzitatorisch
            } else {
                g2.setColor(new Color(220, 60, 60));  // Inhibitorisch
            }

            g2.fillOval(p.x - radius, p.y - radius, radius * 2, radius * 2);
            g2.setColor(Color.WHITE);
            g2.drawOval(p.x - radius, p.y - radius, radius * 2, radius * 2);

            // Port-Status anzeigen
            g2.setFont(new Font("Consolas", Font.PLAIN, (int)(10 * scale)));
            g2.drawString(n.id + " [" + n.activeConnections + "/6]", p.x - radius, p.y - radius - 4);
        }

        // Telemetrie-Dashboard
        g2.setColor(Color.WHITE);
        g2.setFont(new Font("Consolas", Font.BOLD, 14));
        g2.drawString("Matrixgame :: Organische 3D-Zellkolonie", 20, 30);
        g2.drawString("Aktive Synapsen (Dynamisch): " + synapses.size(), 20, 50);
        g2.drawString("Blau = Anregend | Rot = Hemmend | Weiß = Neurotransmitter", 20, 70);
    }

    // 3D zu 2D Isometrische Projektion mit Kamera-Rotation
    private Point project3D(double x, double y, double z, int cx, int cy) {
        double rotX = x * Math.cos(angleY) - z * Math.sin(angleY);
        double rotZ = x * Math.sin(angleY) + z * Math.cos(angleY);
        double scale = 400.0 / (400.0 + rotZ); // Perspektivische Verkürzung
        int px = (int) (cx + rotX * scale);
        int py = (int) (cy + y * scale);
        return new Point(px, py);
    }

    private double getZScale(double z) {
        double rotZ = z * Math.cos(angleY);
        return Math.max(0.4, 400.0 / (400.0 + rotZ));
    }

    public static void main(String[] args) {
        JFrame frame = new JFrame("Echte 3D-Neuronen Kinetik");
        DynamicNeuronSimulation sim = new DynamicNeuronSimulation(12); // 12 Neuronen im freien Raum

        frame.add(sim);
        frame.setSize(900, 700);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLocationRelativeTo(null);
        frame.setVisible(true);
    }
}
