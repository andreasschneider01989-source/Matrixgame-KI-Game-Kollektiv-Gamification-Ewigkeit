Pure Java Architecture: Neuron3D & NeuronCube
Das Modell verwendet orthogonale Nachbarschafts-Links (NORTH, SOUTH, EAST, WEST, UP, DOWN), verarbeitet double-Eingaben über eine Schwellenwert-Funktion und emittiert binäre boolean-Signale.

Java
package matrixgame.core;

import java.util.Arrays;

/**
 * 3D-Neuron ohne Blackbox-Bibliotheken.
 * Besitzt 6 raum-bezogene Verbindungen (3D-Raster).
 */
public class Neuron3D {

    private final int x, y, z;
    private double threshold;
    private double bias;
    
    // 6 orthogonale Nachbar-Pointers [NORTH, SOUTH, EAST, WEST, UP, DOWN]
    private final Neuron3D[] neighbors = new Neuron3D[6];
    private final double[] weights = new double[6];

    private double currentInputSum = 0.0;
    private boolean fired = false;

    public Neuron3D(int x, int y, int z, double threshold, double bias) {
        this.x = x;
        this.y = y;
        this.z = z;
        this.threshold = threshold;
        this.bias = bias;
        Arrays.fill(weights, 1.0); // Start-Gewichtung = 1.0 (vollständig gekoppelt)
    }

    public void setNeighbor(int direction, Neuron3D neighbor, double weight) {
        if (direction >= 0 && direction < 6) {
            this.neighbors[direction] = neighbor;
            this.weights[direction] = weight;
        }
    }

    public void receiveSignal(double signalStrength) {
        this.currentInputSum += signalStrength;
    }

    /**
     * Zünd-Funktion (Activation Step):
     * Rechnet Input + Bias gegen den Schwellenwert.
     */
    public boolean evaluateAndFire() {
        double totalEnergy = currentInputSum + bias;
        this.fired = totalEnergy >= threshold;
        
        // Signal an angemeldete Nachbarn weiterleiten, wenn gezündet
        if (this.fired) {
            for (int dir = 0; dir < 6; dir++) {
                if (neighbors[dir] != null) {
                    neighbors[dir].receiveSignal(1.0 * weights[dir]);
                }
            }
        }
        return this.fired;
    }

    public void resetCycle() {
        this.currentInputSum = 0.0;
    }

    // Hebb'sche Lernregel zur Selbstdifferenzierung / Entropie-Optimierung
    public void adaptWeights(boolean targetConsensus) {
        for (int i = 0; i < 6; i++) {
            if (neighbors[i] != null) {
                if (this.fired == neighbors[i].fired) {
                    // Kooperative Feuerung stärkt die Verbindung
                    weights[i] = Math.min(2.0, weights[i] + 0.05);
                } else {
                    // Diskrepanz schwächt die Verbindung (Entkopplung)
                    weights[i] = Math.max(0.0, weights[i] - 0.05);
                }
            }
        }
    }

    public boolean isFired() { return fired; }
    public String getPosString() { return "(" + x + "," + y + "," + z + ")"; }
}
Der 8-Neuronen-Würfel: NeuronCubeColony.java
Diese Klasse ordnet 8 Neuronen als 2×2×2-Gitter an, verdrahtet die 6-Wege-Topologie im Raum und führt einen Zielabgleich (Konsensfeuerung des Würfels) durch.

Java
package matrixgame.core;

public class NeuronCubeColony {

    // Indizes für die 6 Richtungen
    public static final int NORTH = 0; // y + 1
    public static final int SOUTH = 1; // y - 1
    public static final int EAST  = 2; // x + 1
    public static final int WEST  = 3; // x - 1
    public static final int UP    = 4; // z + 1
    public static final int DOWN  = 5; // z - 1

    private final Neuron3D[][][] cube = new Neuron3D[2][2][2];

    public NeuronCubeColony() {
        // 1. Initialisierung der 8 Neuronen (Ecken des 3D-Würfels)
        for (int x = 0; x < 2; x++) {
            for (int y = 0; y < 2; y++) {
                for (int z = 0; z < 2; z++) {
                    // Variierende Schwellenwerte für primäre Differenzierung
                    double initialThreshold = 1.5 + (x + y + z) * 0.2;
                    cube[x][y][z] = new Neuron3D(x, y, z, initialThreshold, 0.1);
                }
            }
        }
        // 2. 6-Wege-Verdrahtung herstellen
        connectGrid();
    }

    private void connectGrid() {
        for (int x = 0; x < 2; x++) {
            for (int y = 0; y < 2; y++) {
                for (int z = 0; z < 2; z++) {
                    Neuron3D n = cube[x][y][z];
                    if (y + 1 < 2) n.setNeighbor(NORTH, cube[x][y + 1][z], 1.0);
                    if (y - 1 >= 0) n.setNeighbor(SOUTH, cube[x][y - 1][z], 1.0);
                    if (x + 1 < 2) n.setNeighbor(EAST,  cube[x + 1][y][z], 1.0);
                    if (x - 1 >= 0) n.setNeighbor(WEST,  cube[x - 1][y][z], 1.0);
                    if (z + 1 < 2) n.setNeighbor(UP,    cube[x][y][z + 1], 1.0);
                    if (z - 1 >= 0) n.setNeighbor(DOWN,  cube[x][y][z - 1], 1.0);
                }
            }
        }
    }

    public void simulateStep(double externalInputOrigin) {
        // Input an Eckneuron (0,0,0) anlegen
        cube[0][0][0].receiveSignal(externalInputOrigin);

        // Evaluierung aller Zündzustände
        int totalFired = 0;
        for (int x = 0; x < 2; x++) {
            for (int y = 0; y < 2; y++) {
                for (int z = 0; z < 2; z++) {
                    if (cube[x][y][z].evaluateAndFire()) {
                        totalFired++;
                    }
                }
            }
        }

        // Anpassungsschritt (Gewichte synchronisieren)
        for (int x = 0; x < 2; x++) {
            for (int y = 0; y < 2; y++) {
                for (int z = 0; z < 2; z++) {
                    cube[x][y][z].adaptWeights(totalFired == 8);
                    cube[x][y][z].resetCycle();
                }
            }
        }

        System.out.println("Zellkolonie-Status :: Gezündete Neuronen im Würfel: " + totalFired + " / 8");
    }

    public static void main(String[] args) {
        NeuronCubeColony colony = new NeuronCubeColony();
        System.out.println("=== 3D NEURON CUBE SIMULATION STARTED ===");
        
        // Simuliere 5 Reiz-Zyklen
        for (int cycle = 1; cycle <= 5; cycle++) {
            System.out.print("Zyklus " + cycle + " -> ");
            colony.simulateStep(2.5); // Reizstärke 2.5 am Ursprung
        }
    }
}
