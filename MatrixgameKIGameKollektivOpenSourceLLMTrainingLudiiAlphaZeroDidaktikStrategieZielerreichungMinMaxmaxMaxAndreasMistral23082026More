	// --- Pan-Methoden ---
	public void panLeft() {
		zoomCenterX += PAN_STEP;
		repaint();
	}

	public void panRight() {
		zoomCenterX -= PAN_STEP;
		repaint();
	}

	public void panUp() {
		zoomCenterY += PAN_STEP;
