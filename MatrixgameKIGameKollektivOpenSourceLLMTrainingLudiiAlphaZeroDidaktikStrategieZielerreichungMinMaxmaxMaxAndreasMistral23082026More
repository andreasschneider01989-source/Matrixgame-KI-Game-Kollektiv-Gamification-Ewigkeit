public class AIBasedUnit extends Unit {
    private OrtSession aiSession;  // Geladenes ONNX-Modell

    @Override
    public void decideAction() {
        // Spielzustand als Input für die KI
        float[] gameState = getGameStateAsArray();
        float[] aiOutput = runAIModel(gameState);
        int action = argmax(aiOutput);

        switch (action) {
            case 0: moveTo(nextGegner(this)); break;
            case 1: moveToAndKite(nextGegner(this)); break;
            case 2: heal(nearestAlly()); break;
        }
    }
}




