public class Unit extends KreisObjekt {
	String typ;
	double maxLeben;
	double leben;
	double damage;
	double reichweite;
	double speed;
	double geschicklichkeit=Math.random();
	double defenseProTurn=Math.random();
	double currentDefense=defenseProTurn;
	double kritchance=0.2;
	
	
	int team;
	int kills;
	
