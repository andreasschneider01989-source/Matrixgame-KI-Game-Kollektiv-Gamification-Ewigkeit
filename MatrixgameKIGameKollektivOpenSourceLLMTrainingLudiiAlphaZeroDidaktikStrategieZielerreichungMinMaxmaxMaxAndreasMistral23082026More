	double points3;
	double points4;
	double konstruktionszeit = System.currentTimeMillis();
	public Unit target = null;

	// Neue Variablen für Entscheidungsalgorithmen und Steuerung
	public String decisionAlgorithm = "NEAREST_ENEMY"; // "TARGET_POINT", "STAND_STILL", "NEAREST_ENEMY"
	public boolean isSelectable = true;
	public boolean isInfluencable = true;

	public double maxCarryCapacity = 50.0; // statt 10.0 – Träger sollen echte Transportarbeit leisten können

	// Zielkoordinaten im 3D-Raum (x, y, z) für manuelle oder algorithmische
	// Bewegung
	public Double targetPosX = null;
	public Double targetPosY = null;
	public Double targetPosZ = null;

	// Spezifisches Ziel für einen manuellen Angriffsbefehl
	public Unit manualTarget = null;

	double id;

	public void moveTo(KreisObjekt oponent) {
		double distQ = (this.posX - oponent.posX) * (this.posX - oponent.posX)
				+ (this.posY - oponent.posY) * (this.posY - oponent.posY)
				+ (this.posZ - oponent.posZ) * (this.posZ - oponent.posZ);
		double dist = Math.pow(distQ, 0.5);

		double dx = posX - oponent.posX;
		double dy = posY - oponent.posY;
		double dz = posZ - oponent.posZ;

		double movDist = Math.min(speed, Math.abs(dist - reichweite));

		vx = -dx / dist * movDist;
		vy = -dy / dist * movDist;
		vz = -dz / dist * movDist;
		
		System.out.println("Move: "+vx+","+vy+","+vz);

		move(1);

	}
	
	public void moveToAndKite(KreisObjekt oponent) {
		double distQ = (this.posX - oponent.posX) * (this.posX - oponent.posX)
				+ (this.posY - oponent.posY) * (this.posY - oponent.posY)
				+ (this.posZ - oponent.posZ) * (this.posZ - oponent.posZ);
		double dist = Math.pow(distQ, 0.5);

		double dx = posX - oponent.posX;
		double dy = posY - oponent.posY;
		double dz = posZ - oponent.posZ;

		double movDist = Math.min(speed, Math.abs(dist - reichweite));
		
		if(reichweite>dist) {movDist=reichweite-dist; movDist=-movDist; movDist=movDist+0.01;}

		vx = -dx / dist * movDist;
		vy = -dy / dist * movDist;
		vz = -dz / dist * movDist;
		
		System.out.println("Move: "+vx+","+vy+","+vz);

		move(1);

	}

		public void moveTo(double posX, double posY, double posZ, double speedManuel) {
		System.out.println("Zug = moveTo("+posX+","+posY+","+posZ+","+speedManuel+")");
		double distQ = (this.posX - posX) * (this.posX - posX) + (this.posY - posY) * (this.posY - posY)
				+ (this.posZ - posZ) * (this.posZ - posZ);
		
		// FEHLER 3 BEHOBEN: targetPosX hier NICHT auf null setzen! 
		// Das macht der MainGame-Loop sicherer.
		
		double dist = Math.pow(distQ, 0.5);
        
        // Verhindert Division durch Null, falls wir exakt auf dem Punkt stehen
        if (dist < 0.001) {
            vx = 0; vy = 0; vz = 0;
            move(1);
            return;
        }
        
        

		double dx = this.posX - posX;
		double dy = this.posY - posY;
		double dz = this.posZ - posZ;

		double movDist = Math.min(speedManuel, Math.min(speed, Math.abs(dist - 0.0000005)));

		vx = -dx / dist * movDist;
		vy = -dy / dist * movDist;
		vz = -dz / dist * movDist;
		
		System.out.println("Vektor = "+vx+","+vy+","+vz);

        // FEHLER 1 BEHOBEN: Die Bewegung muss ausgeführt werden!
		move(1); 
	}

		
		public void moveTrigonometric(Unit target) {
		    if (target == null || target.leben <= 0) return;

		    double dx = target.posX - this.posX;
		    double dy = target.posY - this.posY;
		    double dist = Math.hypot(dx, dy);

		    if (dist < 0.001) return;

		    double angle = Math.atan2(dy, dx);
		    double moveAngle = angle;

		    // TAKTIK: Wenn wir Fernkämpfer sind, aber der Feind zu nah kommt -> Kiting/Orbit
		    if (this.reichweite > 3.0 && dist < this.reichweite * 1.5) {
		        // Wir laufen nicht direkt weg, sondern seitlich (Flanken)
		        moveAngle = angle + (Math.PI / 2.5); 
		    }

		    this.vx = Math.cos(moveAngle) * this.speed;
		    this.vy = Math.sin(moveAngle) * this.speed;

		    move(1);
		}
		
		
		
	public double getDistance(Unit oponent) {
		double distQ = (this.posX - oponent.posX) * (this.posX - oponent.posX)
				+ (this.posY - oponent.posY) * (this.posY - oponent.posY)
				+ (this.posZ - oponent.posZ) * (this.posZ - oponent.posZ);
		double dist = Math.pow(distQ, 0.5);
		return dist;
	}
	
	public double getDistanceTo(double x, double y, double z) {
		double distQ = (this.posX - x) * (this.posX - x)
				+ (this.posY - y) * (this.posY - y)
				+ (this.posZ - z )* (this.posZ - z);
		double dist = Math.pow(distQ, 0.5);
		return dist;
	}

