		if (getDistance(target) > reichweite)
			{moveTo(target);System.out.println("Zug = moveTo("+target.id+")");}
		else {
			System.out.println("Zug = attackieren("+target.id+")");
			double damage = this.damage;
			if (this.kritchance>Math.random()) {double rand=Math.random();System.out.println("Kritischer Treffer! Schaden Multipliziert mit "+1.0/rand); damage/=rand;}
			if(target.currentDefense*Math.random()>this.geschicklichkeit*Math.random()) {target.currentDefense-=(this.geschicklichkeit/Math.random()); System.out.println("Attacke wurde geblockt und hat keinen Schaden gemacht"); return; }
			target.leben = target.leben - this.damage;
			if (target.leben <= 0) {
				
				System.out.println("Unit " + target.id + " Wurde vernichtet durch Unit " + this.id);
