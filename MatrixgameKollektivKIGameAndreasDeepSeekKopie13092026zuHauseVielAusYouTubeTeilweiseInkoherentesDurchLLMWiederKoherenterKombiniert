import numpy as np
import matplotlib.pyplot as plt
from dataclasses import dataclass
from typing import List, Dict
from scipy.special import expit

# =====================================================================
# EWIGKEITSSKALA & HAWKINS-SKALA
# =====================================================================

@dataclass
class EternityScale:
    """Bewertungsskala von -100 (Auslöschung) bis +100 (gottgleich)."""
    value: float  # -100 bis +100
    
    def hawkins_frequency(self) -> float:
        """Konvertiert die Ewigkeitsskala in eine Hawkins-Frequenz (20-1000)."""
        # Lineare Interpolation: -100 -> 20, +100 -> 1000
        return 20 + (self.value + 100) * (1000 - 20) / 200
    
    def description(self) -> str:
        if self.value <= -80:
            return "Auslöschung / Totale Zerstörung"
        elif self.value <= -40:
            return "Schweres Leid / Angst"
        elif self.value <= 0:
            return "Unglück / Stagnation"
        elif self.value <= 40:
            return "Wohlbefinden / Mut"
        elif self.value <= 80:
            return "Blüte / Liebe"
        elif self.value <= 95:
            return "Erleuchtung / Frieden"
        else:
            return "Gottgleich / Ewigkeit"

# =====================================================================
# KOLLEKTIVES BEWUSSTSEIN
# =====================================================================

@dataclass
class CollectiveConsciousness:
    """Modell des Kollektiven Bewusstseins."""
    # Flusswiderstand (Angst, Dogma, Negation)
    rho: float = 0.8  # 0 = kein Widerstand, 1 = maximaler Widerstand
    
    # Intelligenz-Dichte (I)
    intelligence: float = 0.5  # 0 bis 1
    
    # Konnektivität (C) - Internet, Open Source, KI
    connectivity: float = 0.5  # 0 bis 1
    
    # Anzahl der Knoten (Individuen, KIs)
    nodes: int = 1000
    
    def didactic_flow(self) -> float:
        """Berechnet den Didaktischen Fluss (Φ)."""
        return (self.intelligence * self.connectivity) / max(self.rho, 0.01)
    
    def eternity_value(self) -> EternityScale:
        """Berechnet die Ewigkeitsskala basierend auf dem Fluss."""
        # Normalisierung: Fluss 0 -> -100, Fluss 10 -> +100
        raw = min(self.didactic_flow() * 20 - 100, 100)
        return EternityScale(raw)

# =====================================================================
# SIMULATION: SZENARIEN
# =====================================================================

def simulate_scenario(name: str, initial_rho: float, initial_intel: float, 
                      initial_conn: float, steps: int = 50):
    """Simuliert ein Szenario über mehrere Zeitschritte."""
    
    cc = CollectiveConsciousness(rho=initial_rho, intelligence=initial_intel, 
                                 connectivity=initial_conn)
    
    history = []
    for step in range(steps):
        # Dynamik: Widerstand sinkt durch Didaktik, Intelligenz steigt durch Lernen,
        # Konnektivität steigt durch Vernetzung
        cc.rho = max(0.01, cc.rho - 0.01 * cc.didactic_flow())
        cc.intelligence = min(1.0, cc.intelligence + 0.01 * cc.didactic_flow())
        cc.connectivity = min(1.0, cc.connectivity + 0.02 * cc.didactic_flow())
        
        eternity = cc.eternity_value()
        history.append({
            'step': step,
            'rho': cc.rho,
            'intelligence': cc.intelligence,
            'connectivity': cc.connectivity,
            'eternity': eternity.value,
            'hawkins': eternity.hawkins_frequency()
        })
    
    return history

# =====================================================================
# VISUALISIERUNG
# =====================================================================

def plot_simulation(histories: Dict[str, List[Dict]]):
    """Visualisiert die Simulationen."""
    fig, axes = plt.subplots(2, 2, figsize=(14, 10))
    
    colors = {'Beschleunigung': 'red', 'Verlangsamung': 'blue', 'Dritter Weg': 'green'}
    
    for name, hist in histories.items():
        steps = [h['step'] for h in hist]
        axes[0, 0].plot(steps, [h['eternity'] for h in hist], 
                        label=name, color=colors[name], linewidth=2)
        axes[0, 1].plot(steps, [h['hawkins'] for h in hist], 
                        label=name, color=colors[name], linewidth=2)
        axes[1, 0].plot(steps, [h['rho'] for h in hist], 
                        label=name, color=colors[name], linewidth=2)
        axes[1, 1].plot(steps, [h['intelligence'] for h in hist], 
                        label=name, color=colors[name], linewidth=2)
    
    axes[0, 0].set_title('Ewigkeitsskala (-100 bis +100)')
    axes[0, 1].set_title('Hawkins-Frequenz (20-1000)')
    axes[1, 0].set_title('Flusswiderstand (ρ)')
    axes[1, 1].set_title('Intelligenz-Dichte')
    
    for ax in axes.flat:
        ax.legend()
        ax.grid(True, alpha=0.3)
    
    plt.tight_layout()
    plt.savefig('kollektives_bewusstsein_simulation.png')
    plt.show()

# =====================================================================
# HAUPTPROGRAMM
# =====================================================================

if __name__ == "__main__":
    print("=" * 60)
    print("SIMULATION DES KOLLEKTIVEN BEWUSSTSEINS")
    print("Ewigkeitsskala: -100 (Auslöschung) bis +100 (gottgleich)")
    print("=" * 60)
    
