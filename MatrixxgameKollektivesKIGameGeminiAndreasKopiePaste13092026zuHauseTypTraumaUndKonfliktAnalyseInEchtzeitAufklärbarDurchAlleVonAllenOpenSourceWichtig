// 1. Das Infinity Canvas: Steuerung von Pixel-Mapping, Zoom und Pan
class InfinityCanvas extends JPanel implements MouseWheelListener, MouseListener, MouseMotionListener {
    private double zoomFactor = 1.0;
    private double offsetX = 0;
    private double offsetY = 0;
    private Point referencePoint;
    
    private GameState currentState;

    public InfinityCanvas() {
        setBackground(new Color(15, 20, 30));
        addMouseWheelListener(this);
        addMouseListener(this);
        addMouseMotionListener(this);
        
        // Initialer Weltzustand basierend auf dem Transkript
        currentState = new GameState();
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        
        // Anti-Aliasing für sauberes Rendering der Variablen
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        AffineTransform at = new AffineTransform();
        at.translate(offsetX, offsetY);
        at.scale(zoomFactor, zoomFactor);
        g2.transform(at);

        // Grid zeichnen (Didaktische Matrix-Referenz)
        drawGrid(g2);
        
        // Gamestate visualisieren (Hier mappen wir später Einheiten und Variablen auf die Pixel)
        renderEntities(g2);
    }

    private void drawGrid(Graphics2D g2) {
        g2.setColor(new Color(40, 50, 70));
        int gridSize = 100;
        for (int i = -5000; i <= 5000; i += gridSize) {
            g2.drawLine(i, -5000, i, 5000);
            g2.drawLine(-5000, i, 5000, i);
        }
    }

    private void renderEntities(Graphics2D g2) {
        // Platzhalter für Entitäten aus dem Transkript
        g2.setColor(Color.RED); // China (Blockade-Taktik)
        g2.fillOval(300, 100, 50, 50); 
        
        g2.setColor(Color.WHITE); // Japan (F-2 Jets & ASM-2 Raketen)
        g2.fillRect(600, -100, 40, 40);
        
        g2.setColor(Color.GREEN); // Taiwan (Porcupine Drohnen-Schwarm)
        g2.fillOval(450, 200, 30, 30);
    }

    // Input-Handling für flüssiges Navigieren
    @Override
    public void mouseWheelMoved(MouseWheelEvent e) {
        double zoomDelta = 0.1;
        if (e.getWheelRotation() < 0) {
            zoomFactor *= (1 + zoomDelta);
        } else {
            zoomFactor /= (1 + zoomDelta);
        }
        repaint();
    }

    @Override
    public void mousePressed(MouseEvent e) {
        referencePoint = e.getPoint();
    }

    @Override
    public void mouseDragged(MouseEvent e) {
        double deltaX = e.getX() - referencePoint.getX();
        double deltaY = e.getY() - referencePoint.getY();
        offsetX += deltaX;
        offsetY += deltaY;
        referencePoint = e.getPoint();
        repaint();
    }

    @Override public void mouseClicked(MouseEvent e) {}
    @Override public void mouseReleased(MouseEvent e) {}
    @Override public void mouseEntered(MouseEvent e) {}
    @Override public void mouseExited(MouseEvent e) {}
    @Override public void mouseMoved(MouseEvent e) {}
}

