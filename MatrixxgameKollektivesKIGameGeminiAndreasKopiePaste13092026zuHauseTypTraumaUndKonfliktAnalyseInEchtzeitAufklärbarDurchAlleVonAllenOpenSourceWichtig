    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
        g2.setColor(Color.BLACK);
        g2.fillRect(0, 0, getWidth(), getHeight());

        // Gitter zeichnen
        g2.setColor(new Color(30, 30, 30));
        int gridSize = (int) (feinheit * zoomFactor);
        for (int x = 0; x < getWidth(); x += gridSize) g2.drawLine(x, 0, x, getHeight());
        for (int y = 0; y < getHeight(); y += gridSize) g2.drawLine(0, y, getWidth(), y);

        // Einheiten zeichnen mit Gesundheitsbalken
        for (Unit unit : unitList) {
            double radius = unit.size > 0 ? unit.size : 12;
            double sx = (zoomCenterX + unit.posX) * zoomFactor + getWidth() / 2.0;
            double sy = (zoomCenterY + unit.posY) * zoomFactor + getHeight() / 2.0;

            g2.setColor(new Color((int) unit.red, (int) unit.green, (int) unit.blue));
            g2.fillOval((int) (sx - radius), (int) (sy - radius), (int) (radius * 2), (int) (radius * 2));

            if (unit == selectedUnit) {
                g2.setColor(Color.YELLOW);
                g2.setStroke(new BasicStroke(3));
                g2.drawOval((int) (sx - radius - 4), (int) (sy - radius - 4), (int) (radius * 2 + 8), (int) (radius * 2 + 8));
            }
            
            // Lebensbalken über der Einheit
            g2.setColor(Color.RED);
            g2.fillRect((int)(sx - 15), (int)(sy - radius - 10), 30, 4);
            g2.setColor(Color.GREEN);
            double hpPercent = Math.max(0, unit.leben / unit.maxLeben);
            g2.fillRect((int)(sx - 15), (int)(sy - radius - 10), (int)(30 * hpPercent), 4);
        }
        
        // --- HUD: VARIABLEN DER SElektierten EINHEIT AUF DEM CANVAS ---
        if (selectedUnit != null) {
            int hudX = 30;
            int hudY = getHeight() - 170;
            g2.setColor(new Color(15, 15, 25, 220));
            g2.fillRect(hudX, hudY, 320, 130);
            g2.setColor(Color.CYAN);
            g2.setStroke(new BasicStroke(2));
            g2.drawRect(hudX, hudY, 320, 130);

            g2.setColor(Color.WHITE);
            g2.setFont(new Font("Arial", Font.BOLD, 14));
            g2.drawString("EINHEITEN-INSPEKTOR [ID " + (int)selectedUnit.id + "]", hudX + 15, hudY + 25);
            g2.setFont(new Font("Arial", Font.PLAIN, 12));
            g2.drawString("Typ: " + selectedUnit.typ + " | Team: " + (selectedUnit.team == 1 ? "Blau (Du)" : "Rot (KI)"), hudX + 15, hudY + 50);
            g2.drawString("Leben: " + String.format("%.2f", selectedUnit.leben) + " / " + selectedUnit.maxLeben, hudX + 15, hudY + 70);
            g2.drawString("Schaden: " + selectedUnit.damage + " | Reichweite: " + selectedUnit.reichweite, hudX + 15, hudY + 90);
            g2.drawString("Position: X=" + (int)selectedUnit.posX + ", Y=" + (int)selectedUnit.posY, hudX + 15, hudY + 110);
        }

