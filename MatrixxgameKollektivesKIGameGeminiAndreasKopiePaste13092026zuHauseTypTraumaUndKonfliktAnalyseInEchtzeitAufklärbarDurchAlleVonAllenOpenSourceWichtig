interface MCTSMove {
    void apply(MCTSGameSimulator state);
    void applyToLive(List<Unit> liveUnits);
}

class MCTSGameSimulator {
    List<SimUnit> units;
    int currentPlayer;

    public MCTSGameSimulator(List<Unit> liveUnits, int player) {
        this.currentPlayer = player;
        this.units = new ArrayList<>();
        for (Unit u : liveUnits) {
            if (u.leben > 0) {
                SimUnit su = new SimUnit();
                su.id = u.id; su.team = u.team; su.posX = (int) u.posX; su.posY = (int) u.posY;
                su.leben = u.leben; su.typ = su.typ;
                this.units.add(su);
            }
        }
    }

    public MCTSGameSimulator(MCTSGameSimulator other, int nextPlayer) {
        this.currentPlayer = nextPlayer;
        this.units = new ArrayList<>();
        for (SimUnit su : other.units) {
            SimUnit copy = new SimUnit();
            copy.id = su.id; copy.team = su.team; copy.posX = su.posX; copy.posY = su.posY;
            copy.leben = su.leben; copy.typ = su.typ;
            this.units.add(copy);
        }
    }

    public boolean isTerminal() {
        boolean k1 = false, k2 = false;
        for (SimUnit u : units) {
            if ("King".equals(u.typ) && u.leben > 0) {
                if (u.team == 1) k1 = true;
                if (u.team == 2) k2 = true;
            }
        }
        return !k1 || !k2;
    }

    public double getReward(int forTeam) {
        boolean k1 = false, k2 = false;
        for (SimUnit u : units) {
            if ("King".equals(u.typ) && u.leben > 0) {
                if (u.team == 1) k1 = true;
                if (u.team == 2) k2 = true;
            }
        }
        if (!k1) return forTeam == 2 ? 1.0 : 0.0;
        if (!k2) return forTeam == 1 ? 1.0 : 0.0;
        return 0.5;
    }

    public List<MCTSMove> getLegalMoves() {
        List<MCTSMove> moves = new ArrayList<>();
        int[][] directions = {{0,1}, {0,-1}, {1,0}, {-1,0}};

        for (SimUnit u : units) {
            if (u.team == currentPlayer && u.leben > 0) {
                for (int[] d : directions) {
                    int targetX = u.posX + d[0];
                    int targetY = u.posY + d[1];
                    
                    SimUnit occupant = findUnitAt(targetX, targetY);
                    if (occupant == null) {
                        // Leer -> Bewegung erlaubt
                        moves.add(new ConcreteMove(u.id, targetX, targetY, false, -1));
                    } else if (occupant.team != u.team && occupant.leben > 0) {
                        // Gegner -> Angriff erlaubt!
                        moves.add(new ConcreteMove(u.id, targetX, targetY, true, occupant.id));
                    }
                }
            }
        }
        return moves;
    }
    
    public SimUnit findUnit(double id) {
        for (SimUnit u : units) if (u.id == id) return u;
        return null;
    }

    public SimUnit findUnitAt(int x, int y) {
        for (SimUnit u : units) {
            if (u.leben > 0 && u.posX == x && u.posY == y) return u;
        }
        return null;
    }
}

class SimUnit {
    double id; int team; int posX; int posY; double leben; String typ = "";
}

class ConcreteMove implements MCTSMove {
    double unitId; 
    int targetX, targetY;
    boolean isAttack;
    double targetUnitId;

    public ConcreteMove(double unitId, int targetX, int targetY, boolean isAttack, double targetUnitId) {
        this.unitId = unitId; 
        this.targetX = targetX; 
        this.targetY = targetY;
        this.isAttack = isAttack;
        this.targetUnitId = targetUnitId;
    }

    @Override
    public void apply(MCTSGameSimulator state) {
        SimUnit u = state.findUnit(unitId);
        if (u != null && u.leben > 0) {
            if (isAttack) {
                SimUnit target = state.findUnit(targetUnitId);
                if (target != null && target.leben > 0) {
                    target.leben -= 1.0; // Simulierter Schaden
                }
            } else {
                if (state.findUnitAt(targetX, targetY) == null) {
                    u.posX = targetX;
                    u.posY = targetY;
                }
            }
        }
        // Entferne tote Einheiten im Simulator
        state.units.removeIf(su -> su.leben <= 0);
    }

    @Override
    public void applyToLive(List<Unit> liveUnits) {
        Unit u = null;
        for (Unit unit : liveUnits) {
            if (unit.id == unitId) { u = unit; break; }
        }
        if (u != null && u.leben > 0) {
            if (isAttack) {
                Unit target = null;
                for (Unit unit : liveUnits) {
                    if (unit.id == targetUnitId) { target = unit; break; }
                }
                if (target != null && target.leben > 0) {
                    u.attackieren(target);
                }
            } else {
                boolean occupied = false;
                for (Unit unit : liveUnits) {
                    if (unit.leben > 0 && Math.round(unit.posX) == targetX && Math.round(unit.posY) == targetY) {
                        occupied = true;
                        break;
                    }
                }
                if (!occupied) {
                    u.posX = targetX;
                    u.posY = targetY;
                }
            }
        }
        liveUnits.removeIf(unit -> unit.leben <= 0);
    }

    @Override
    public boolean equals(Object o) {
        if (this == o) return true;
        if (o == null || getClass() != o.getClass()) return false;
        ConcreteMove that = (ConcreteMove) o;
        return Double.compare(that.unitId, unitId) == 0 && targetX == that.targetX && targetY == that.targetY && isAttack == that.isAttack && Double.compare(that.targetUnitId, targetUnitId) == 0;
    }

    @Override
    public int hashCode() {
        return Objects.hash(unitId, targetX, targetY, isAttack, targetUnitId);
    }
}

class MCTSNode {
    MCTSGameSimulator state;
    MCTSMove move;
    MCTSNode parent;
    List<MCTSNode> children = new ArrayList<>();
    int visits = 0;
    double wins = 0.0;

    public MCTSNode(MCTSGameSimulator state, MCTSMove move, MCTSNode parent) {
        this.state = state; this.move = move; this.parent = parent;
    }

    public boolean isFullyExpanded() {
        return children.size() >= state.getLegalMoves().size();
    }
}

class SimpleMCTS {
    private int iterations;
    private Random rand = new Random();

    public SimpleMCTS(int iterations) {
        this.iterations = iterations;
    }

    public MCTSMove search(MCTSGameSimulator rootState) {
        MCTSNode root = new MCTSNode(rootState, null, null);

        for (int i = 0; i < iterations; i++) {
            MCTSNode node = select(root);
            double result = simulate(node.state);
            backpropagate(node, result);
        }

        MCTSNode bestChild = null;
        int maxVisits = -1;
        for (MCTSNode child : root.children) {
            if (child.visits > maxVisits) {
                maxVisits = child.visits;
                bestChild = child;
            }
        }
        return bestChild != null ? bestChild.move : null;
    }

    private MCTSNode select(MCTSNode node) {
        while (!node.state.isTerminal()) {
            if (!node.isFullyExpanded()) {
                return expand(node);
            } else {
                node = bestChildUCT(node);
            }
        }
        return node;
    }

    private MCTSNode expand(MCTSNode node) {
        List<MCTSMove> legalMoves = node.state.getLegalMoves();
        for (MCTSMove m : legalMoves) {
            boolean alreadyExists = false;
            for (MCTSNode c : node.children) {
                if (c.move.equals(m)) {
                    alreadyExists = true;
                    break;
                }
            }
            if (!alreadyExists) {
                MCTSGameSimulator nextState = new MCTSGameSimulator(node.state, 3 - node.state.currentPlayer);
                m.apply(nextState);
                MCTSNode newNode = new MCTSNode(nextState, m, node);
                node.children.add(newNode);
                return newNode;
            }
        }
        return node;
    }

    private double simulate(MCTSGameSimulator state) {
        MCTSGameSimulator tempState = new MCTSGameSimulator(state, state.currentPlayer);
        int steps = 0;
        while (!tempState.isTerminal() && steps < 10) {
            List<MCTSMove> moves = tempState.getLegalMoves();
            if (moves.isEmpty()) break;
            
            // Aggressive Heuristik: Bevorzuge Angriffe im Rollout (80% Chance, falls verfügbar)
            List<MCTSMove> attackMoves = new ArrayList<>();
            for (MCTSMove m : moves) {
                if (m instanceof ConcreteMove && ((ConcreteMove) m).isAttack) {
                    attackMoves.add(m);
                }
            }
            
            MCTSMove chosenMove;
            if (!attackMoves.isEmpty() && rand.nextDouble() < 0.8) {
                chosenMove = attackMoves.get(rand.nextInt(attackMoves.size()));
            } else {
                chosenMove = moves.get(rand.nextInt(moves.size()));
            }
            
            chosenMove.apply(tempState);
            tempState.currentPlayer = 3 - tempState.currentPlayer;
            steps++;
        }
        return tempState.getReward(2);
    }

    private void backpropagate(MCTSNode node, double result) {
        while (node != null) {
            node.visits++;
            node.wins += result;
            node = node.parent;
        }
    }

    private MCTSNode bestChildUCT(MCTSNode node) {
        MCTSNode best = null;
        double bestValue = -Double.MAX_VALUE;
        for (MCTSNode child : node.children) {
            if (child.visits == 0) continue;
            double uctValue = (child.wins / child.visits) + Math.sqrt(2 * Math.log(node.visits) / child.visits);
            if (uctValue > bestValue) {
                bestValue = uctValue;
                best = child;
            }
        }
        if (best != null) return best;
        if (!node.children.isEmpty()) return node.children.get(0);
        return node;
    }
}

