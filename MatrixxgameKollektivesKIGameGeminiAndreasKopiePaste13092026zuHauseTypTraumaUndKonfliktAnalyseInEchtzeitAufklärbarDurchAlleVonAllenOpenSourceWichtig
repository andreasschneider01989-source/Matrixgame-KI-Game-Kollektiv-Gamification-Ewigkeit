    private class BoardCanvas extends JPanel {
        private final int tileSize = 60;
        private final int originX = 350;
        private final int originY = 400;

        @Override
        protected void paintComponent(Graphics g) {
            super.paintComponent(g);
            Graphics2D g2 = (Graphics2D) g;
            g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

            // Hintergrund
            g2.setColor(new Color(240, 240, 245));
            g2.fillRect(0, 0, getWidth(), getHeight());

            // Gitter zeichnen (X von -4 bis 4, Y von -5 bis 5)
            g2.setColor(new Color(210, 210, 220));
            for (int x = -4; x <= 4; x++) {
                int px = originX + x * tileSize;
                g2.drawLine(px, 0, px, getHeight());
            }
            for (int y = -5; y <= 5; y++) {
                int py = originY - y * tileSize;
                g2.drawLine(0, py, getWidth(), py);
            }

            g2.setColor(Color.LIGHT_GRAY);
            g2.drawLine(originX, 0, originX, getHeight());
            g2.drawLine(0, originY, getWidth(), originY);

            // Legale Züge hervorheben, falls Einheit ausgewählt
            if (selectedUnitId != null && gameState.activeTeam == 1) {
                List<Move> legalMoves = gameState.getLegalMovesForTeam(1);
                for (Move m : legalMoves) {
                    if (m.unitId == selectedUnitId) {
                        int px, py;
                        if (m.isAttack) {
                            Unit target = gameState.getUnitById(m.targetUnitId);
                            if (target != null) {
                                px = originX + target.x * tileSize;
                                py = originY - target.y * tileSize;
                                g2.setColor(new Color(255, 100, 100, 150)); // Rot für Angriff
                                g2.fillRect(px - tileSize / 2, py - tileSize / 2, tileSize, tileSize);
                            }
                        } else {
                            px = originX + m.toX * tileSize;
                            py = originY - m.toY * tileSize;
                            g2.setColor(new Color(100, 255, 100, 150)); // Grün für Bewegung
                            g2.fillRect(px - tileSize / 2, py - tileSize / 2, tileSize, tileSize);
                        }
                    }
                }
            }

            // Einheiten zeichnen
            for (Unit u : gameState.units) {
                if (!u.isAlive()) continue;
                int px = originX + u.x * tileSize;
                int py = originY - u.y * tileSize;

                // Farbe nach Team
                if (u.team == 1) {
                    g2.setColor(u.id == selectedUnitId ? new Color(50, 120, 255) : new Color(70, 150, 255));
                } else {
                    g2.setColor(new Color(220, 70, 70));
                }

                g2.fillOval(px - 20, py - 20, 40, 40);
                g2.setColor(Color.DARK_GRAY);
                g2.setStroke(new BasicStroke(2));
                g2.drawOval(px - 20, py - 20, 40, 40);

                // Text (Typ und ID)
                g2.setColor(Color.WHITE);
                g2.setFont(new Font("Arial", Font.BOLD, 12));
                String label = "";
                switch (u.type) {
                    case KING: label = "K"; break;
                    case GUARD: label = "G"; break;
                    case PLAENKLER: label = "P"; break;
                    case LAEUFER: label = "L"; break;
                }
                g2.drawString(label + " (" + u.id + ")", px - 16, py + 4);
            }
        }
    }

    private void handleBoardClick(int mouseX, int mouseY) {
        if (gameState.isTerminal() || gameState.activeTeam != 1) return;

        int tileSize = 60;
        int originX = 350;
        int originY = 400;

        // Klick in Spielkoordinaten umrechnen (nächstgelegenes Feld)
        int gx = (int) Math.round((double)(mouseX - originX) / tileSize);
        int gy = (int) Math.round((double)(originY - mouseY) / tileSize);

        Unit clickedUnit = gameState.getUnitAt(gx, gy);

        if (selectedUnitId == null) {
            // Versuche Einheit auszuwählen
            if (clickedUnit != null && clickedUnit.team == 1) {
                selectedUnitId = clickedUnit.id;
                statusLabel.setText("Einheit " + selectedUnitId + " ausgewählt. Klicke auf ein grünes Feld (Bewegung) oder rotes Ziel (Angriff).");
                canvas.repaint();
            }
        } else {
            // Bereits Einheit ausgewählt -> Prüfe, ob Klick ein gültiger Zug ist
            List<Move> legalMoves = gameState.getLegalMovesForTeam(1);
            Move selectedMove = null;

            for (Move m : legalMoves) {
                if (m.unitId == selectedUnitId) {
                    if (m.isAttack) {
                        Unit target = gameState.getUnitById(m.targetUnitId);
                        if (target != null && target.x == gx && target.y == gy) {
                            selectedMove = m;
                            break;
                        }
                    } else {
                        if (m.toX == gx && m.toY == gy) {
                            selectedMove = m;
                            break;
                        }
                    }
                }
            }

            if (selectedMove != null) {
                // Zug ausführen
                gameState = gameState.applyMove(selectedMove);
                selectedUnitId = null;
                canvas.repaint();

                if (gameState.isTerminal()) {
                    checkGameOver();
                    return;
                }

                // KI-Zug nach kurzer Pause ausführen
                statusLabel.setText("KI berechnet Zug...");
                Timer timer = new Timer(500, e -> executeAITurn());
                timer.setRepeats(false);
                timer.start();

            } else {
                // Abwahl oder neue Auswahl
                if (clickedUnit != null && clickedUnit.team == 1) {
                    selectedUnitId = clickedUnit.id;
                    statusLabel.setText("Einheit " + selectedUnitId + " ausgewählt.");
                } else {
                    selectedUnitId = null;
                    statusLabel.setText("Auswahl aufgehoben. Am Zug: Spieler (1).");
                }
                canvas.repaint();
            }
        }
    }

    private void executeAITurn() {
        if (gameState.isTerminal()) return;

        Move aiMove = aiSolver.findBestMove(gameState, 3);
        if (aiMove != null) {
            gameState = gameState.applyMove(aiMove);
        }

        canvas.repaint();

        if (gameState.isTerminal()) {
            checkGameOver();
        } else {
            statusLabel.setText("Am Zug: Spieler (1). Wähle eine eigene Einheit aus.");
        }
    }

    private void checkGameOver() {
        boolean king1 = false, king2 = false;
        for (Unit u : gameState.units) {
            if (u.type == UnitType.KING && u.isAlive()) {
                if (u.team == 1) king1 = true;
                if (u.team == 2) king2 = true;
            }
        }
        if (king1 && !king2) {
            statusLabel.setText("SPIEL BEENDET: Team 1 (Spieler) hat gewonnen!");
            JOptionPane.showMessageDialog(this, "Team 1 (Spieler) hat gewonnen!");
        } else if (!king1 && king2) {
            statusLabel.setText("SPIEL BEENDET: Team 2 (KI) hat gewonnen!");
            JOptionPane.showMessageDialog(this, "Team 2 (KI) hat gewonnen!");
        } else {
            statusLabel.setText("SPIEL BEENDET: Unentschieden.");
        }
    }

