        canvas { border: 1px solid #30363d; background: #161b22; margin-top: 10px; cursor: crosshair; }
        #controls { margin: 10px; display: flex; gap: 15px; align-items: center; background: #21262d; padding: 10px; border-radius: 6px; }
        button { background: #238636; color: white; border: none; padding: 8px 12px; border-radius: 4px; cursor: pointer; }
        button:hover { background: #2ea043; }
        .info { font-size: 12px; color: #8b949e; }
    </style>
</head>
<body>

<div id="controls">
    <button onclick="toggleSupplyRestriction()">Tech-Restriktion (Halbleiter) Umschalten</button>
    <button onclick="resetScenario()">Szenario Zurücksetzen</button>
    <div class="info">
        <b>Steuerung:</b> Linksklick = Einheit auswählen | Rechtsklick = Zielpunkt setzen | Taste WASD/Pfeile = Gewählte Einheit bewegen
    </div>
</div>

<canvas id="simCanvas" width="1000" height="600"></canvas>

<script>
const canvas = document.getElementById('simCanvas');
const ctx = canvas.getContext('2d');

// --- SIMULATION ZUSTAND & PROPORTIONEN ---
let supplyRestrictionActive = false;
let selectedUnit = null;

// Strategische Knotenpunkte (Position & Strategischer Wert V)
const strategicPoints = [
    { name: "Kurilen / Okhotsk", x: 750, y: 150, value: 85 },
    { name: "Taiwan-Straße", x: 250, y: 450, value: 95 },
    { name: "Hormuz-Passage", x: 150, y: 200, value: 75 }
];

// Akteure & Einheiten (Proportionale Massen, Kräfte & Kosten)
class Unit {
    constructor(id, name, faction, x, y, strength, techDependency, unitCost) {
        this.id = id;
        this.name = name;
        this.faction = faction; // 'RED' (Offensiv), 'BLUE' (Defensiv/Asymmetrisch)
        this.x = x;
        this.y = y;
        this.vx = 0;
        this.vy = 0;
        this.targetX = x;
        this.targetY = y;
        this.strength = strength;           // Truppenstärke / Kapazität P
        this.maxStrength = strength;
        this.techDependency = techDependency; // Abhängigkeit von Re-Export-Chips (0 bis 1)
        this.unitCost = unitCost;           // Proportionale Kosten pro Einheit
        this.radius = Math.max(8, Math.sqrt(strength) * 1.5);
        this.speed = 2.0;
    }

    // Effektive Kampfkraft berechnen
    getEffectivePower() {
        let techFactor = 1.0;
        if (supplyRestrictionActive && this.faction === 'RED') {
            techFactor = 1.0 - (this.techDependency * 0.75); // 75% Leistungseinbruch bei Chip-Sperre
        }
        return this.strength * techFactor;
    }

    update() {
        // 1. Automatische Bewegung zum Zielpunkt (Vektor-Mathematik)
        let dx = this.targetX - this.x;
        let dy = this.targetY - this.y;
        let dist = Math.hypot(dx, dy);

        if (dist > 2) {
            this.vx = (dx / dist) * this.speed;
            this.vy = (dy / dist) * this.speed;
            this.x += this.vx;
            this.y += this.vy;
        } else {
            this.vx = 0;
            this.vy = 0;
        }

        // 2. Proportionale Radien-Anpassung
        this.radius = Math.max(6, Math.sqrt(Math.max(0, this.strength)) * 1.5);
    }

    draw() {
        ctx.save();
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        
        // Farben basierend auf Fraktion und Status
        if (this.faction === 'RED') ctx.fillStyle = '#f85149';
        else ctx.fillStyle = '#58a6ff';

        ctx.fill();
        ctx.lineWidth = selectedUnit === this ? 3 : 1;
        ctx.strokeStyle = selectedUnit === this ? '#f2cc60' : '#30363d';
        ctx.stroke();

        // Beschriftung & Status
        ctx.fillStyle = '#c9d1d9';
        ctx.font = '11px monospace';
        ctx.fillText(`${this.name}`, this.x - 20, this.y - this.radius - 12);
        
        let power = this.getEffectivePower().toFixed(1);
        ctx.fillStyle = (supplyRestrictionActive && this.faction === 'RED') ? '#ffa657' : '#7ee787';
        ctx.fillText(`P: ${power} | C: $${this.unitCost}k`, this.x - 30, this.y - this.radius - 2);

        ctx.restore();
    }
}

let units = [];

function initScenario() {
    units = [
        new Unit(1, "RU Naval Group", 'RED', 700, 100, 100, 0.90, 150),   // Hohe Chip-Abhängigkeit (90%), teuer
        new Unit(2, "CN Patrol Flotilla", 'RED', 300, 400, 120, 0.40, 80),
        new Unit(3, "JP Interceptor Wing", 'BLUE', 650, 250, 70, 0.05, 3), // Asymmetrische Terra-A1 Drohnen ($3k)
        new Unit(4, "UA/JP Defense Hub", 'BLUE', 200, 250, 80, 0.10, 5)
    ];
    selectedUnit = null;
}

// --- INTERAKTIONEN & WECHSELWIRKUNGEN (LANCHESTER + GRAVITATION) ---
function processPhysicsAndCombat() {
    const G_geo = 0.05;

    for (let i = 0; i < units.length; i++) {
        let u1 = units[i];

        // Gravitative Anziehung zu strategischen Knotenpunkten
        strategicPoints.forEach(pt => {
            let dx = pt.x - u1.x;
            let dy = pt.y - u1.y;
            let r2 = dx * dx + dy * dy + 400;
            let force = G_geo * (u1.getEffectivePower() * pt.value) / r2;
            
            // Subtile automatische Drift in Richtung strategischer Interessen
            u1.x += (dx / Math.sqrt(r2)) * force * 0.1;
            u1.y += (dy / Math.sqrt(r2)) * force * 0.1;
        });

        // Interaktionen zwischen feindlichen Einheiten
        for (let j = i + 1; j < units.length; j++) {
            let u2 = units[j];
            if (u1.faction === u2.faction) continue;

            let dx = u2.x - u1.x;
            let dy = u2.y - u1.y;
            let dist = Math.hypot(dx, dy);

            // Gefechts-Reichweite
            if (dist < 80) {
                // Abnutzung basierend auf Effektivitäts-Verhältnis (Kosten-Asymmetrie)
                let p1 = u1.getEffectivePower();
                let p2 = u2.getEffectivePower();

                // Asymmetrischer Kostenfaktor (Künstliche Abfang-Effizienz)
                let costRatio1 = u2.unitCost / u1.unitCost; 
                let costRatio2 = u1.unitCost / u2.unitCost;

                u1.strength -= (p2 * 0.005 * costRatio2);
                u2.strength -= (p1 * 0.005 * costRatio1);
            }
        }
    }

    // Einheiten entfernen, wenn Stärke verbraucht ist
    units = units.filter(u => u.strength > 0);
}

// --- CANVAS RENDER LOOP ---
function render() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // 1. Strategische Punkte zeichnen
    strategicPoints.forEach(pt => {
        ctx.beginPath();
        ctx.arc(pt.x, pt.y, 25, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(56, 139, 253, 0.1)';
        ctx.fill();
        ctx.strokeStyle = '#388bfd';
        ctx.stroke();
        ctx.fillStyle = '#8b949e';
        ctx.font = '10px monospace';
        ctx.fillText(`${pt.name} (V=${pt.value})`, pt.x - 40, pt.y + 40);
    });

    // 2. Physik & Gefechte aktualisieren
    processPhysicsAndCombat();

    // 3. Einheiten updaten und zeichnen
    units.forEach(u => {
        u.update();
        u.draw();
        
        // Vektorlinie zum Zielort zeichnen
        if (Math.hypot(u.targetX - u.x, u.targetY - u.y) > 5) {
            ctx.beginPath();
            ctx.moveTo(u.x, u.y);
            ctx.lineTo(u.targetX, u.targetY);
            ctx.strokeStyle = 'rgba(255, 255, 255, 0.15)';
            ctx.setLineDash([4, 4]);
            ctx.stroke();
            ctx.setLineDash([]);
        }
    });

    // Overall Status Display
    ctx.fillStyle = '#c9d1d9';
    ctx.font = '12px monospace';
    ctx.fillText(`Halbleiter-Sanktionen: ${supplyRestrictionActive ? "AKTIV (Lieferketten unterbrochen)" : "INAKTIV"}`, 20, 30);

    requestAnimationFrame(render);
}

// --- INPUT EVENT HANDLER (FIX FÜR ANWÄHLEN & BEWEGEN) ---
canvas.addEventListener('click', (e) => {
    const rect = canvas.getBoundingClientRect();
    const clickX = e.clientX - rect.left;
    const clickY = e.clientY - rect.top;

    // Prüfen, ob eine Einheit angeklickt wurde
    let found = false;
    units.forEach(u => {
        let dist = Math.hypot(clickX - u.x, clickY - u.y);
        if (dist <= u.radius + 5) {
            selectedUnit = u;
            found = true;
        }
    });

    if (!found) selectedUnit = null;
});

canvas.addEventListener('contextmenu', (e) => {
    e.preventDefault(); // Verhindert Kontextmenü
    if (!selectedUnit) return;

    const rect = canvas.getBoundingClientRect();
    selectedUnit.targetX = e.clientX - rect.left;
    selectedUnit.targetY = e.clientY - rect.top;
});

window.addEventListener('keydown', (e) => {
    if (!selectedUnit) return;
    const step = 15;
    
    // Manuelle Tasten-Steuerung
    if (e.key === 'a' || e.key === 'ArrowLeft')  selectedUnit.targetX -= step;
    if (e.key === 'd' || e.key === 'ArrowRight') selectedUnit.targetX += step;
    if (e.key === 'w' || e.key === 'ArrowUp')    selectedUnit.targetY -= step;
    if (e.key === 's' || e.key === 'ArrowDown')  selectedUnit.targetY += step;
    
    // Position sofort nachführen für direktes Gefühl
    selectedUnit.x = selectedUnit.targetX;
    selectedUnit.y = selectedUnit.targetY;
});

function toggleSupplyRestriction() {
    supplyRestrictionActive = !supplyRestrictionActive;
}

function resetScenario() {
    initScenario();
}

// Start
initScenario();
render();
</script>
