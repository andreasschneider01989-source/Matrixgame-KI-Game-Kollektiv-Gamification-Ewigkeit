package ordner1;

import javax.swing.*;
import java.awt.*;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import java.util.ArrayList;
import java.util.List;
import java.util.Random;

public class MainGame extends JPanel {

    public List<Unit> unitList = new ArrayList<>();
    public Unit selectedUnit = null;
    
    // Rundensteuerung: 1 = Mensch (Team 1 - Blau), 2 = Taktischer KI-Bot (Team 2 - Rot)
    public int currentTurnTeam = 1; 
    public boolean gameIsOver = false;

    int FRAME_WIDTH = 1920;
    int FRAME_HEIGHT = 1080;

    double zoomFactor = 1.0;
    double zoomCenterX = 0;
    double zoomCenterY = 0;
    static final double ZOOM_STEP = 1.2; 
    double feinheit = 50;
    double PAN_STEP = feinheit * zoomFactor;

    public MainGame() {
        setPreferredSize(new Dimension(FRAME_WIDTH, FRAME_HEIGHT));
        setBackground(Color.BLACK);

        addMouseListener(new MouseAdapter() {
            @Override
            public void mousePressed(MouseEvent e) {
                if (currentTurnTeam == 1 && !gameIsOver) {
                    handleHumanClick(e.getX(), e.getY());
                }
            }
        });
    }

    // --- MENSCHLICHE STEUERUNG (TEAM 1) ---
    private void handleHumanClick(int screenX, int screenY) {
        double worldX = (screenX - getWidth() / 2.0) / zoomFactor - zoomCenterX;
        double worldY = (screenY - getHeight() / 2.0) / zoomFactor - zoomCenterY;
        
        int clickedGridX = (int) Math.round(worldX);
        int clickedGridY = (int) Math.round(worldY);

        if (selectedUnit == null) {
            for (Unit u : unitList) {
                if (u.team == 1 && u.leben > 0 && Math.round(u.posX) == clickedGridX && Math.round(u.posY) == clickedGridY) {
                    selectedUnit = u;
                    repaint();
                    return;
                }
            }
        } else {
            int dx = Math.abs((int) Math.round(selectedUnit.posX) - clickedGridX);
            int dy = Math.abs((int) Math.round(selectedUnit.posY) - clickedGridY);
            int manhattanDist = dx + dy;

            // Prüfen, ob das Ziel in Reichweite für Bewegung (Distanz 1) oder Angriff (Reichweite der Unit) ist
            Unit targetAtField = null;
            for (Unit u : unitList) {
                if (u.leben > 0 && Math.round(u.posX) == clickedGridX && Math.round(u.posY) == clickedGridY) {
                    targetAtField = u;
                    break;
                }
            }

            if (targetAtField == null && manhattanDist == 1) {
                // Bewegung ausführen
                System.out.println("Unit " + selectedUnit.id + " (" + selectedUnit.typ + ") bewegt sich von (" + (int)selectedUnit.posX + "," + (int)selectedUnit.posY + ") nach (" + clickedGridX + "," + clickedGridY + ")");
                selectedUnit.posX = clickedGridX;
                selectedUnit.posY = clickedGridY;
                selectedUnit = null;
                finishHumanTurn();
            } else if (targetAtField != null && targetAtField.team != selectedUnit.team) {
                // Angriff prüfen (innerhalb der Waffenreichweite)
                if (manhattanDist <= selectedUnit.reichweite) {
                    selectedUnit.attackieren(targetAtField);
                    selectedUnit = null;
                    finishHumanTurn();
                } else {
                    System.out.println("Ziel ist außerhalb der Reichweite (" + selectedUnit.reichweite + ").");
                    selectedUnit = null;
                }
            } else {
                // Selektion wechseln oder aufheben
                selectedUnit = null;
                for (Unit u : unitList) {
                    if (u.team == 1 && u.leben > 0 && Math.round(u.posX) == clickedGridX && Math.round(u.posY) == clickedGridY) {
                        selectedUnit = u;
                        break;
                    }
                }
                repaint();
            }
        }
    }

    private void finishHumanTurn() {
        unitList.removeIf(u -> u.leben <= 0);
        repaint();
        if (checkWinConditions()) return;

        currentTurnTeam = 2;
        repaint();
        new Thread(this::executeAITurn).start();
    }

    // --- VERBesserter TAKTISCHER KI-ZUG (TEAM 2) ---
    public void executeAITurn() {
        try {
            Thread.sleep(600); // Taktische Denkpause
        } catch (InterruptedException e) {
            e.printStackTrace();
        }

        int[][] directions = {{0, 1}, {0, -1}, {1, 0}, {-1, 0}};

        List<Unit> aiUnits = new ArrayList<>();
        for (Unit u : unitList) {
            if (u.team == 2 && u.leben > 0) aiUnits.add(u);
        }

        for (Unit ai : aiUnits) {
            if (ai.leben <= 0 || gameIsOver) continue;

            // 1. Priorität: Gegner in Angriffsreichweite attackieren
            Unit bestTarget = null;
            double lowestHealth = Double.MAX_VALUE;

            for (Unit u : unitList) {
                if (u.team == 1 && u.leben > 0) {
                    int dist = Math.abs((int)Math.round(ai.posX) - (int)Math.round(u.posX)) + 
                               Math.abs((int)Math.round(ai.posY) - (int)Math.round(u.posY));
                    
                    if (dist <= ai.reichweite) {
                        // Priorisiere König oder Einheiten mit wenig Leben
                        if ("King".equals(u.typ)) {
                            bestTarget = u;
                            break;
                        }
                        if (u.leben < lowestHealth) {
                            lowestHealth = u.leben;
                            bestTarget = u;
                        }
                    }
                }
            }

            if (bestTarget != null) {
                ai.attackieren(bestTarget);
            } else {
                // 2. Kein Ziel in Reichweite -> Finde nächsten Feind und rücke taktisch vor
                Unit nearestEnemy = null;
                double minDistance = Double.MAX_VALUE;
                for (Unit u : unitList) {
                    if (u.team == 1 && u.leben > 0) {
                        double dist = Math.hypot(ai.posX - u.posX, ai.posY - u.posY);
                        if (dist < minDistance) {
                            minDistance = dist;
                            nearestEnemy = u;
                        }
                    }
                }

                if (nearestEnemy != null) {
                    int bestX = (int) Math.round(ai.posX);
                    int bestY = (int) Math.round(ai.posY);
                    double shortestDist = minDistance;

                    for (int[] d : directions) {
                        int nx = (int) Math.round(ai.posX) + d[0];
                        int ny = (int) Math.round(ai.posY) + d[1];

                        boolean occupied = false;
                        for (Unit u : unitList) {
                            if (u.leben > 0 && Math.round(u.posX) == nx && Math.round(u.posY) == ny) {
                                occupied = true;
                                break;
                            }
                        }

                        if (!occupied) {
                            double newDist = Math.hypot(nx - nearestEnemy.posX, ny - nearestEnemy.posY);
                            if (newDist < shortestDist) {
                                shortestDist = newDist;
                                bestX = nx;
                                bestY = ny;
                            }
                        }
                    }

                    if (bestX != (int)Math.round(ai.posX) || bestY != (int)Math.round(ai.posY)) {
                        System.out.println("KI-Unit " + ai.id + " (" + ai.typ + ") bewegt sich von (" + (int)ai.posX + "," + (int)ai.posY + ") nach (" + bestX + "," + bestY + ")");
                        ai.posX = bestX;
                        ai.posY = bestY;
                    }
                }
            }
        }

        unitList.removeIf(u -> u.leben <= 0);
        repaint();

        if (!checkWinConditions()) {
            currentTurnTeam = 1;
            repaint();
        }
    }

    private boolean checkWinConditions() {
        boolean k1 = false, k2 = false;
        for (Unit u : unitList) {
            if ("King".equals(u.typ) && u.leben > 0) {
                if (u.team == 1) k1 = true;
                if (u.team == 2) k2 = true;
            }
        }
        if (!k1 && !gameIsOver) {
            gameIsOver = true;
            System.out.println("Der König von Team 1 wurde vernichtet! Team 2 (KI) hat gewonnen!");
            return true;
        }
        if (!k2 && !gameIsOver) {
            gameIsOver = true;
            System.out.println("Der König von Team 2 wurde vernichtet! Team 1 (Du) hat gewonnen! [LEVEL 1 GESCHAFFT]");
            return true;
        }
        return false;
    }

