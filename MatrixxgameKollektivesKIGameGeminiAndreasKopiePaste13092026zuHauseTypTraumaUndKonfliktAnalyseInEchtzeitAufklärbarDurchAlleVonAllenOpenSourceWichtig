import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

/**
 * Matrixgame Core Simulation: Geopolitische Kausalitätsanalyse
 * Modelliert die Entropie und die Hawkins-Skala-Werte globaler Akteure.
 */
public class MatrixGeopoliticsEngine {

    // --- ENUMS ---
    public enum Allegiance {
        DEMOCRATIC_ALLIANCE,
        AUTHORITARIAN_AXIS,
        NEUTRAL
    }

    public enum Doctrine {
        PACIFISM,
        STRATEGIC_AMBIGUITY,
        ACTIVE_DETERRENCE,
        EXPANSIONIST,
        SURVIVAL_THREAT_RESPONSE
    }

    // --- KERNKLASSEN ---
    
    /**
     * Repräsentiert einen geopolitischen Akteur.
     */
    public static class Nation {
        private String name;
        private Allegiance allegiance;
        private Doctrine doctrine;
        
        // Metriken (0.0 bis 1.0, wobei 1.0 maximal ist)
        private double militaryReadiness;
        private double internalRationality; // Repräsentiert "Breaking Mechanisms" (z.B. Generale, die Xi warnen)
        private double technologicalEdge;
        
        // Bewusstseinszustand nach Dr. David Hawkins (z.B. 20=Scham, 150=Wut, 400=Vernunft, 500=Liebe)
        private int hawkinsScaleValue;
        
        private List<MilitaryAsset> assets;

        public Nation(String name, Allegiance allegiance, Doctrine doctrine, double internalRationality, int initialHawkins) {
            this.name = name;
            this.allegiance = allegiance;
            this.doctrine = doctrine;
            this.internalRationality = internalRationality;
            this.hawkinsScaleValue = initialHawkins;
            this.militaryReadiness = 0.5;
            this.technologicalEdge = 0.5;
            this.assets = new ArrayList<>();
        }

        public void addAsset(MilitaryAsset asset) {
            this.assets.add(asset);
            this.technologicalEdge = Math.min(1.0, this.technologicalEdge + asset.getTechBoost());
            System.out.println("[LOG] " + this.name + " integriert " + asset.getName() + " ins Arsenal.");
        }

        public void purgeInternalOpposition() {
            System.out.println("[CRITICAL EVENT] " + this.name + " führt eine interne Säuberung durch.");
            this.internalRationality *= 0.2; // Rationale Stimmen fallen weg
            this.hawkinsScaleValue = Math.max(50, this.hawkinsScaleValue - 100); // Fällt in tiefere Ebenen (Wut/Stolz)
        }

        public void shiftDoctrine(Doctrine newDoctrine) {
            System.out.println("[PARADIGM SHIFT] " + this.name + " ändert Doktrin von " + this.doctrine + " zu " + newDoctrine);
            this.doctrine = newDoctrine;
            
            // Anpassung der Werte basierend auf der Retter-Perspektive
            if (newDoctrine == Doctrine.SURVIVAL_THREAT_RESPONSE || newDoctrine == Doctrine.ACTIVE_DETERRENCE) {
                this.militaryReadiness = 0.9;
                // Der Mut (200) erwacht, Fakten werden logisch analysiert (Richtung Vernunft 400)
                this.hawkinsScaleValue = Math.max(this.hawkinsScaleValue, 250); 
            }
        }

        public double calculateThreatProfile() {
            double threat = (militaryReadiness * 0.6) + ((1.0 - internalRationality) * 0.4);
            return doctrine == Doctrine.EXPANSIONIST ? threat * 1.5 : threat;
        }

        public String getName() { return name; }
        public int getHawkinsValue() { return hawkinsScaleValue; }
    }

    /**
     * Repräsentiert militärische oder technologische Güter (z.B. F-16 Block 70, Silicon Shield).
     */
    public static class MilitaryAsset {
        private String name;
        private double techBoost;
        private boolean isDefensive;

        public MilitaryAsset(String name, double techBoost, boolean isDefensive) {
            this.name = name;
            this.techBoost = techBoost;
            this.isDefensive = isDefensive;
        }

        public String getName() { return name; }
        public double getTechBoost() { return techBoost; }
    }

    /**
     * Der Simulator, der die N-Körper-ähnliche Interaktion der Nationen berechnet.
     */
    public static class SimulationEngine {
        private Map<String, Nation> worldState;
        private double globalTensionIndex; // 0.0 (Frieden) bis 1.0 (Globaler Konflikt)

        public SimulationEngine() {
            worldState = new HashMap<>();
            globalTensionIndex = 0.2;
        }

        public void addNation(Nation nation) {
            worldState.put(nation.getName(), nation);
        }

        public void evaluateGlobalTension() {
            double totalThreat = 0;
            double totalRationality = 0;

            for (Nation n : worldState.values()) {
                totalThreat += n.calculateThreatProfile();
                totalRationality += n.internalRationality;
            }

            // Tension steigt, wenn die Bedrohung hoch und die globale Rationalität gering ist
            globalTensionIndex = Math.min(1.0, (totalThreat / worldState.size()) * (1.1 - (totalRationality / worldState.size())));
            System.out.printf("\n[SYSTEM] Globaler Spannungsindex aktualisiert: %.2f%%\n", globalTensionIndex * 100);
        }

        public void simulateIntervention(String actorName, String targetName, String action) {
            Nation actor = worldState.get(actorName);
            Nation target = worldState.get(targetName);

            if (actor == null || target == null) return;

            System.out.println("\n[INTERAKTION] " + actor.getName() + " wendet Aktion an: '" + action + "' gegen " + target.getName());
            
            // Kausalitätslogik der Retter-Perspektive: Abschreckung vs. Eskalation
            if (action.equals("Blockade Rehearsal")) {
                target.shiftDoctrine(Doctrine.SURVIVAL_THREAT_RESPONSE);
            } else if (action.equals("Deploy AESA Radar Defense")) {
                actor.addAsset(new MilitaryAsset("F-16 Block 70 Squadron", 0.15, true));
                if (target.internalRationality > 0.5) {
                    System.out.println("-> Target analysiert die Kosten und deeskaliert.");
                } else {
                    System.out.println("-> Target ignoriert Warnungen aufgrund fehlender interner Bremsen.");
                    globalTensionIndex += 0.1;
                }
            }
            evaluateGlobalTension();
        }

        public void displayGlobalConsciousness() {
            System.out.println("\n=== HAWKINS SKALA GLOBALES BEWUSSTSEIN ===");
            for (Nation n : worldState.values()) {
                System.out.println(n.getName() + ": Bewusstseinslevel " + n.getHawkinsValue());
            }
            System.out.println("==========================================");
        }
    }

    // --- MAIN METHODE FÜR DEN RUN ---
    public static void main(String[] args) {
        System.out.println("Starte MatrixGeopoliticsEngine...\n");
        SimulationEngine engine = new SimulationEngine();

        // 1. Instanziierung der Entitäten
        Nation china = new Nation("China (PRC)", Allegiance.AUTHORITARIAN_AXIS, Doctrine.EXPANSIONIST, 0.8, 150); // 150 = Wut/Stolz
        Nation japan = new Nation("Japan", Allegiance.DEMOCRATIC_ALLIANCE, Doctrine.PACIFISM, 0.9, 200); // 200 = Mut
        Nation taiwan = new Nation("Taiwan (ROC)", Allegiance.DEMOCRATIC_ALLIANCE, Doctrine.STRATEGIC_AMBIGUITY, 0.9, 250); // 250 = Neutralität
        Nation usa = new Nation("USA", Allegiance.DEMOCRATIC_ALLIANCE, Doctrine.ACTIVE_DETERRENCE, 0.7, 310); // 310 = Bereitschaft

        engine.addNation(china);
        engine.addNation(japan);
        engine.addNation(taiwan);
        engine.addNation(usa);

        engine.evaluateGlobalTension();

        // 2. Kausalitätskette abspielen (historische Events aus dem Transkript)
        china.purgeInternalOpposition(); // General He Weidong entfernt
        engine.evaluateGlobalTension();

        engine.simulateIntervention("China (PRC)", "Taiwan (ROC)", "Blockade Rehearsal");
        
        japan.shiftDoctrine(Doctrine.SURVIVAL_THREAT_RESPONSE); // Sanae Takaichi zieht die Rote Linie
        
        engine.simulateIntervention("Taiwan (ROC)", "China (PRC)", "Deploy AESA Radar Defense");

        // 3. Status quo evaluieren (Die Simulation liefert die aktuellen Parameter für die Entscheidungsfindung)
        engine.evaluateGlobalTension();
        engine.displayGlobalConsciousness();
        
        System.out.println("\n[FAZIT] Die Kausalitätsanalyse zeigt: Logische technologische Überlegenheit kombiniert mit");
        System.out.println("klarer Doktrin stabilisiert das System in Ermangelung gegnerischer Rationalität.");
    }
}

