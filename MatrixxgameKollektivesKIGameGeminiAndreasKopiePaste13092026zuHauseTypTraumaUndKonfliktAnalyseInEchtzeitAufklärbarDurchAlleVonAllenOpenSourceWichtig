        public Move(int unitId, int fromX, int fromY, int toX, int toY, int targetUnitId) {
            this.unitId = unitId;
            this.fromX = fromX;
            this.fromY = fromY;
            this.toX = toX;
            this.toY = toY;
            this.isAttack = true;
            this.targetUnitId = targetUnitId;
        }
