    // Umrechnung von Bildschirm-Klicks in Welt-/Grid-Koordinaten unter Berücksichtigung von Zoom & Pan
    private void handleGridClick(int screenX, int screenY) {
        // Inverse Transformation von Screen zu Weltkoordinaten
        double worldX = (screenX - getWidth() / 2.0) / zoomFactor - zoomCenterX;
        double worldY = (screenY - getHeight() / 2.0) / zoomFactor - zoomCenterY;
        
        int clickedGridX = (int) Math.round(worldX);
        int clickedGridY = (int) Math.round(worldY);

        if (selectedUnit == null) {
            // Versuche, eine Einheit an dieser Position zu finden (Team 1 als Spieler)
            for (Unit u : unitList) {
                if (u.leben > 0 && Math.round(u.posX) == clickedGridX && Math.round(u.posY) == clickedGridY) {
                    selectedUnit = u;
                    System.out.println("Einheit ID " + u.id + " ausgewählt.");
                    repaint();
                    return;
                }
            }
        } else {
            // Prüfe, ob der Klick ein gültiger orthogonaler Schritt ist (1 Feld nach oben, unten, links, rechts)
            int dx = Math.abs((int) Math.round(selectedUnit.posX) - clickedGridX);
            int dy = Math.abs((int) Math.round(selectedUnit.posY) - clickedGridY);

            if ((dx == 1 && dy == 0) || (dx == 0 && dy == 1)) {
                // Prüfe, ob das Feld frei ist oder ein Gegner dort steht
                Unit targetAtField = null;
                for (Unit u : unitList) {
                    if (u.leben > 0 && Math.round(u.posX) == clickedGridX && Math.round(u.posY) == clickedGridY) {
                        targetAtField = u;
                        break;
                    }
                }

                if (targetAtField == null) {
                    // Bewege die Einheit schachartig auf das freie Feld
                    selectedUnit.posX = clickedGridX;
                    selectedUnit.posY = clickedGridY;
                    System.strPrint("Einheit bewegt nach: " + clickedGridX + ", " + clickedGridY);
                } else if (targetAtField.team != selectedUnit.team) {
                    // Attackiere den Gegner in Reichweite
                    selectedUnit.attackieren(targetAtField);
                    System.out.println("Einheit attackiert Ziel!");
                }

                // Selektion nach dem Zug aufheben
                selectedUnit = null;
                repaint();
            } else {
                // Bei ungültigem Klick Auswahl aufheben oder neu wählen
                selectedUnit = null;
                for (Unit u : unitList) {
                    if (u.leben > 0 && Math.round(u.posX) == clickedGridX && Math.round(u.posY) == clickedGridY) {
                        selectedUnit = u;
                        break;
                    }
                }
                repaint();
            }
        }
