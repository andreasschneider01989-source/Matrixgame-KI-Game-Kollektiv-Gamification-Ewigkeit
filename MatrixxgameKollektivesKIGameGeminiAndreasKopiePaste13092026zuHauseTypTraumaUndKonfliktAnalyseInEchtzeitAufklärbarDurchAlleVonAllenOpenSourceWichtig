// 3. Minimax mit Alpha-Beta-Pruning (Für harte taktische Konfliktlösung)
class MinimaxAI {
    public double minimax(GameState state, int depth, double alpha, double beta, boolean isMaximizingPlayer) {
        if (depth == 0 || state.isTerminal()) {
            return state.evaluateState();
        }

        if (isMaximizingPlayer) {
            double maxEval = Double.NEGATIVE_INFINITY;
            for (GameState child : state.getPossibleMoves(true)) {
                double eval = minimax(child, depth - 1, alpha, beta, false);
                maxEval = Math.max(maxEval, eval);
                alpha = Math.max(alpha, eval);
                if (beta <= alpha) break; // Alpha-Beta Pruning
            }
            return maxEval;
        } else {
            double minEval = Double.POSITIVE_INFINITY;
            for (GameState child : state.getPossibleMoves(false)) {
                double eval = minimax(child, depth - 1, alpha, beta, true);
                minEval = Math.min(minEval, eval);
                beta = Math.min(beta, eval);
                if (beta <= alpha) break; // Alpha-Beta Pruning
            }
            return minEval;
        }
    }
}

