    public static class Unit {
        public final int id;
        public final int team; // 1 = Spieler, 2 = KI
        public final UnitType type;
        public int x, y;
        public double health;
        public final double maxHealth;

        public Unit(int id, int team, UnitType type, int x, int y, double health) {
            this.id = id;
            this.team = team;
            this.type = type;
            this.x = x;
            this.y = y;
            this.health = health;
            this.maxHealth = health;
