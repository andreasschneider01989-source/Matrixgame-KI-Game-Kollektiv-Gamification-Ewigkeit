import java.util.ArrayList;
import java.util.List;
import java.util.Random;

public class MCTS {

    /**
     * Schnittstelle für den Spielzustand (Game State), die von jeder konkreten 
     * Spiel-Engine (z.B. Tak, Tic-Tac-Toe, Go) implementiert werden muss.
     */
    public interface GameState {
        boolean isTerminal();
        List<Move> getLegalMoves();
        GameState applyMove(Move move);
        int getWinner(); // 1 = Spieler 1 gewinnt, -1 = Spieler 2, 0 = Unentschieden
        int getCurrentPlayer();
    }

    /**
     * Marker-Schnittstelle für Spielzüge.
     */
    public interface Move {
        // Implementierungsspezifische Zugdaten
    }

    /**
     * Repräsentiert einen Knoten im Suchbaum.
     */
    public static class Node {
        public GameState state;
        public Move move;
        public Node parent;
        public List<Node> children;
        public List<Move> untriedMoves;
        public int visits;
        public double wins;

        public Node(GameState state, Move move, Node parent) {
            this.state = state;
            this.move = move;
            this.parent = parent;
            this.children = new ArrayList<>();
            this.untriedMoves = new ArrayList<>(state.getLegalMoves());
            this.visits = 0;
            this.wins = 0.0;
        }

        public boolean isFullyExpanded() {
            return untriedMoves.isEmpty();
        }

        public boolean isTerminal() {
            return state.isTerminal();
        }

        /**
         * Wählt das beste Kind anhand der UCB1-Formel (Exploration vs. Exploitation).
         */
        public Node bestChild(double cParam) {
            Node best = null;
            double bestValue = -Double.MAX_VALUE;
            int parentVisits = this.visits;

            for (Node child : children) {
                // UCB1 Berechnung
                double exploitation = child.wins / (child.visits + 1e-6);
                double exploration = cParam * Math.sqrt(Math.log(parentVisits + 1) / (child.visits + 1e-6));
                double ucb1 = exploitation + exploration;

                if (ucb1 > bestValue) {
                    bestValue = ucb1;
                    best = child;
                }
            }
            return best;
        }
    }

    private final int iterations;
    private final double cParam;
    private final Random random = new Random();

    public MCTS(int iterations, double cParam) {
        this.iterations = iterations;
        this.cParam = cParam; // Standardwert typischerweise sqrt(2)
    }

    /**
     * Führt die MCTS-Iteration aus und gibt den optimalen nächsten Zug zurück.
     */
    public Move search(GameState initialState) {
        Node root = new Node(initialState, null, null);

        for (int i = 0; i < iterations; i++) {
            // 1. Selection
            Node node = select(root);

            // 2. Expansion
            if (!node.isTerminal() && !node.isFullyExpanded()) {
                node = expand(node);
            }

            // 3. Simulation (Rollout)
            double result = simulate(node.state);

            // 4. Backpropagation
            backpropagate(node, result);
        }

        // Wähle den robustesten Kindknoten (meisten Besuche)
        Node bestNode = null;
        int maxVisits = -1;
        for (Node child : root.children) {
            if (child.visits > maxVisits) {
                maxVisits = child.visits;
                bestNode = child;
            }
        }
        return bestNode != null ? bestNode.move : null;
    }

    private Node select(Node node) {
        while (!node.isTerminal()) {
            if (!node.isFullyExpanded()) {
                return node;
            } else {
                node = node.bestChild(cParam);
                if (node == null) break;
            }
        }
        return node;
    }

    private Node expand(Node node) {
        if (node.untriedMoves.isEmpty()) return node;
        int index = random.nextInt(node.untriedMoves.size());
        Move move = node.untriedMoves.remove(index);
        GameState nextState = node.state.applyMove(move);
        Node childNode = new Node(nextState, move, node);
        node.children.add(childNode);
        return childNode;
    }

    private double simulate(GameState state) {
        GameState currentState = state;
        while (!currentState.isTerminal()) {
            List<Move> legalMoves = currentState.getLegalMoves();
            if (legalMoves.isEmpty()) break;
            Move randomMove = legalMoves.get(random.nextInt(legalMoves.size()));
            currentState = currentState.applyMove(randomMove);
        }
        int winner = currentState.getWinner();
        if (winner == 0) return 0.5; // Unentschieden
        return (winner > 0) ? 1.0 : 0.0;
    }

    private void backpropagate(Node node, double result) {
        Node current = node;
        while (current != null) {
            current.visits++;
            current.wins += result;
            current = current.parent;
        }
    }
}

