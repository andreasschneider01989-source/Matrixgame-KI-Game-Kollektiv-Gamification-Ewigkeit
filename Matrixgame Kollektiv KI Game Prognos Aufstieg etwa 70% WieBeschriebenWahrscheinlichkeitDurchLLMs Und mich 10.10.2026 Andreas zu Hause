              + "Zielfortschritt %.1f | Antrieb-Modellwert %.1f",
                joy, happiness, interest, motivation, discipline,
                vitality, goalProgress, intrinsicDrive());
        }
    }

    enum Action {
        LEARN,       // lernen oder ein Problem bearbeiten
        REST,        // Erholung
