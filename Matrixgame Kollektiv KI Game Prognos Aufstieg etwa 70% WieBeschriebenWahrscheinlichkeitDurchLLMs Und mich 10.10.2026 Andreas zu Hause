        State copy() {
            State s = new State();
            s.joy = joy;
            s.happiness = happiness;
            s.interest = interest;
            s.motivation = motivation;
            s.discipline = discipline;
            s.autonomy = autonomy;
            s.competence = competence;
            s.vitality = vitality;
            s.goalProgress = goalProgress;
            s.cooperation = cooperation;
            return s;
        }

        String summary() {
            return String.format(Locale.GERMANY,
                "Freude %.1f | Wohlbefinden %.1f | Interesse %.1f | "
