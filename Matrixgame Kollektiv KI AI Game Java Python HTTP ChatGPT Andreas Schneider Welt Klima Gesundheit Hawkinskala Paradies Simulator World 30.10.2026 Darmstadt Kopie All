python_core = r'''"""MATRIXGAME Earth Simulator 0.1 — simplified educational model.
Standard-library only. Not a validated climate or ecological forecast.
"""
from dataclasses import dataclass
from random import Random

@dataclass
class Cell:
    water: float
    soil: float
    vegetation: float
    temperature_c: float

class EarthModel:
    def __init__(self, width=32, height=20, seed=7):
        self.width, self.height = width, height
        self.rng = Random(seed)
        self.tick = 0
        self.grid = []
        for y in range(height):
            row = []
            for x in range(width):
                water = min(1, max(0, .25 + .12*self.rng.random()
                                   + .12*(1 + __import__('math').sin(x*.25))/2))
                row.append(Cell(water, .45 + .3*self.rng.random(),
                                .15 + .35*water, 25 + 4*self.rng.random()))
            self.grid.append(row)

    def step(self):
        import math
        updated = []
        for row in self.grid:
            new_row = []
            for c in row:
                evaporation = max(.003, .012 + max(0, c.temperature_c-22)*.0015)
                water = max(0, min(1, c.water-evaporation))
                stress = max(0, min(1, (c.temperature_c-34)/15))
                growth = .025*water*c.soil*(1-stress)
                vegetation = max(0, min(1, c.vegetation+growth-.009*(1-water)-.012*stress))
                soil = max(0, min(1, c.soil+.0015*c.vegetation-.0008*(1-water)))
                temperature = c.temperature_c + .11 + (1-water)*.035 - vegetation*.045
                new_row.append(Cell(water, soil, vegetation, temperature))
            updated.append(new_row)
        self.grid = updated
        self.tick += 1
        return self.metrics()

    def metrics(self):
        cells = [c for row in self.grid for c in row]
        n = len(cells)
        return {
            "tick": self.tick,
            "mean_temperature_c": sum(c.temperature_c for c in cells)/n,
            "mean_water": sum(c.water for c in cells)/n,
            "mean_soil": sum(c.soil for c in cells)/n,
            "mean_vegetation": sum(c.vegetation for c in cells)/n,
        }

if __name__ == "__main__":
    model = EarthModel()
    for _ in range(10):
        print(model.step())
'''

