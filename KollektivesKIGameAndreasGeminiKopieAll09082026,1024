1. Matrix-Knotenpunkte: Die Genetik der Einheiten

Wir definieren abstrakte Knoten, die mathematische Operationen und Werte darstellen. Diese Knoten können zufällig generiert, von dir als Spieler gezielt zusammengebaut oder durch Evolution (Mutation) verändert werden.
Java

package p1;

import java.util.Random;

// Abstrakte Basisklasse für alle Knoten (Abstract Syntax Tree)
public abstract class MatrixNode {
    public abstract double evaluate();
    public abstract String getExpression();
}

// Ein Blatt-Knoten, der einen festen Wert oder eine Variable repräsentiert
class ValueNode extends MatrixNode {
    private double value;

    public ValueNode(double value) {
        this.value = value;
    }

    @Override
    public double evaluate() {
        return value;
    }

    @Override
    public String getExpression() {
        return String.format("%.2f", value);
    }
}

// Ein Operations-Knoten (Node Left, Node Right)
class OperationNode extends MatrixNode {
    private MatrixNode left;
    private MatrixNode right;
    private char operator; // '+', '-', '*', '/'

    public OperationNode(MatrixNode left, MatrixNode right, char operator) {
        this.left = left;
        this.right = right;
        this.operator = operator;
    }

    @Override
    public double evaluate() {
        double lVal = left.evaluate();
        double rVal = right.evaluate();
        switch (operator) {
            case '+': return lVal + rVal;
            case '-': return lVal - rVal;
            case '*': return lVal * rVal;
            case '/': return rVal != 0 ? lVal / rVal : 0; // Division by zero protection
            default: return 0;
        }
    }

    @Override
    public String getExpression() {
        return "(" + left.getExpression() + " " + operator + " " + right.getExpression() + ")";
    }
}

2. Unit Fight Simulator: Evolution durch Gleichungen

Jede Kampfeinheit (Unit) berechnet ihre Statuswerte (z.B. Angriffskraft oder Verteidigung) basierend auf den ihr innewohnenden Gleichungsbäumen. Der Erfolg einer Einheit wird in Punkten pro Zeit (Fitness) gemessen.
Java

class FightUnit {
    private String name;
    private MatrixNode attackEquation;
    private MatrixNode defenseEquation;
    private double currentLife;
    private int survivedTicks; // Für Punkte pro Zeit (Fitness)

    public FightUnit(String name, MatrixNode attackEquation, MatrixNode defenseEquation) {
        this.name = name;
        this.attackEquation = attackEquation;
        this.defenseEquation = defenseEquation;
        this.currentLife = 100.0;
        this.survivedTicks = 0;
    }

    public double getAttackPower() {
        return attackEquation.evaluate();
    }

    public double getDefensePower() {
        return defenseEquation.evaluate();
    }

    public void takeDamage(double incomingDamage) {
        double netDamage = incomingDamage - getDefensePower();
        if (netDamage > 0) {
            currentLife -= netDamage;
        }
    }

    public boolean isAlive() {
        return currentLife > 0;
    }

    public void addSurvivalTick() {
        if (isAlive()) survivedTicks++;
    }

    // Gamifizierung: Bewertung der Effizienz
    public double calculatePointsPerTime() {
        return (getAttackPower() + getDefensePower()) * survivedTicks;
    }

    public void printStats() {
        System.out.println("Unit: " + name);
        System.out.println(" ATK Equation: " + attackEquation.getExpression() + " = " + getAttackPower());
        System.out.println(" DEF Equation: " + defenseEquation.getExpression() + " = " + getDefensePower());
        System.out.println(" Punkte/Zeit-Fitness: " + calculatePointsPerTime());
    }
}

