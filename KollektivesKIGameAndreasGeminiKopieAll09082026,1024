        this.x = x;
        this.y = y;
        this.z = z;
        this.masse = masse;
        this.vx = 0; this.vy = 0; this.vz = 0;
    }

    public void berechneWechselwirkung(QuantenKugel andereKugel, double G, double dt) {
        // 1. Der 3D-Distanzoperator (Satz des Pythagoras im Raum)
        double dx = andereKugel.x - this.x;
        double dy = andereKugel.y - this.y;
        double dz = andereKugel.z - this.z;
        double r = Math.sqrt(dx*dx + dy*dy + dz*dz);
        
        /* 
         * Schwellenwert-Prüfung zur Vermeidung einer Division durch Null.
