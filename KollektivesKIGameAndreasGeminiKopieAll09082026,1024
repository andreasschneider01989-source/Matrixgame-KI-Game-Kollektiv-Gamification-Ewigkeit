    private static final double MASS_LEPTON_SHELL = 511.0;  // Elektronen-Analogie

    public OctetCluster(double centerX, double centerY, double centerZ, double radius) {
        
        // 1. Der Kern (2 Massekugeln, sehr nah beieinander)
        MasseKugel core1 = new MasseKugel(centerX - 5, centerY, centerZ, 0, 0, 0, 
