        bodies.add(core1);
        bodies.add(core2);

        // 2. Die Schale (6 Massekugeln rotieren um den Kern)
        for (int i = 0; i < 6; i++) {
            double angle = Math.toRadians(i * (360.0 / 6));
            
            double px = centerX + radius * Math.cos(angle);
            double py = centerY + radius * Math.sin(angle);
            
            // Orbitale Geschwindigkeit basierend auf Gravitationskonstante G berechnen
            double v = Math.sqrt(0.01 * (MASS_BOSON_CORE * 2) / radius); 
            double vx = -v * Math.sin(angle);
            double vy = v * Math.cos(angle);

            MasseKugel shellLepton = new MasseKugel(px, py, centerZ, vx, vy, 0, 
                                                    MASS_LEPTON_SHELL, 6, Color.BLUE, true);
            bodies.add(shellLepton);
        }
    }

    public List<MasseKugel> getClusterBodies() {
        return bodies;
    }
}

