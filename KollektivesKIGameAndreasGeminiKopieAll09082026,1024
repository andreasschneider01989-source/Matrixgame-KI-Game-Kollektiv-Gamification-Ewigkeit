    private static final int WIDTH = 1000;
    private static final int HEIGHT = 800;
    private static final int PARTIKEL_ANZAHL = 400; 
    private static final double G = 0.5; 
    private static final double DT = 0.016; 

    private List<QuantenKugel> universum;
    
    private double zoomLevel = 1.0;
    private double cameraX = 0.0;
    private double cameraY = 0.0;
    private int lastMouseX, lastMouseY;
    private long frameCount = 0;

    public MatrixgameSimulator() {
        this.setPreferredSize(new Dimension(WIDTH, HEIGHT));
        this.setBackground(Color.BLACK);
        universum = new ArrayList<>();

        for (int i = 0; i < PARTIKEL_ANZAHL; i++) {
            double x = (Math.random() * 20 - 10);
            double y = (Math.random() * 20 - 10);
            double z = (Math.random() * 20 - 10); 
            universum.add(new QuantenKugel(x, y, z, 1.0)); 
        }
        
        setupCameraControls();
    }

    private void setupCameraControls() {
        this.addMouseWheelListener(e -> {
            double zoomFaktor = 1.1;
            if (e.getWheelRotation() < 0) {
                zoomLevel *= zoomFaktor; 
            } else {
                zoomLevel /= zoomFaktor; 
            }
        });

        this.addMouseListener(new MouseAdapter() {
            public void mousePressed(MouseEvent e) {
                lastMouseX = e.getX();
                lastMouseY = e.getY();
            }
        });

        this.addMouseMotionListener(new MouseMotionAdapter() {
            public void mouseDragged(MouseEvent e) {
                int dx = e.getX() - lastMouseX;
                int dy = e.getY() - lastMouseY;
                cameraX += dx / zoomLevel;
                cameraY += dy / zoomLevel;
                lastMouseX = e.getX();
                lastMouseY = e.getY();
            }
        });
    }

    static class QuantenKugel {
        double x, y, z;
        double vx, vy, vz;
        double masse;

        public QuantenKugel(double x, double y, double z, double masse) {
            this.x = x; this.y = y; this.z = z; this.masse = masse;
            this.vx = 0; this.vy = 0; this.vz = 0;
        }

        public void berechneWechselwirkung(QuantenKugel andereKugel) {
            double dx = andereKugel.x - this.x;
            double dy = andereKugel.y - this.y;
            double dz = andereKugel.z - this.z;
            double r = Math.sqrt(dx*dx + dy*dy + dz*dz);

            /* 
             * Schwellenwert-Prüfung zur Vermeidung einer Division durch Null.
             * Wenn r extrem klein wird, greift diese Logik.
             * Dieser auskommentierte Block bleibt als Fundament für zukünftige 
             * inelastische Kollisions-Upgrades erhalten und wird nicht gelöscht.
             */
            // if (r < 0.0000001) { 
            //     // verschmelzeMit(andereKugel); 
            //     return; 
            // }

            // Sub-Planck-Limit für extrem tiefe Berechnungen reduziert
            if (r < 0.005) r = 0.005; 

            double kraft = G * (this.masse * andereKugel.masse) / (r * r);

            double ax = (kraft * dx / r) / this.masse;
            double ay = (kraft * dy / r) / this.masse;
            double az = (kraft * dz / r) / this.masse;

            this.vx += ax * DT;
            this.vy += ay * DT;
            this.vz += az * DT;
        }

        public void bewege() {
            this.x += this.vx * DT;
            this.y += this.vy * DT;
            this.z += this.vz * DT;
        }
    }

    private void updatePhysik() {
        double maxKinetischeEnergie = 0;
        
        for (int i = 0; i < universum.size(); i++) {
            QuantenKugel a = universum.get(i);
            for (int j = i + 1; j < universum.size(); j++) {
                QuantenKugel b = universum.get(j);
                a.berechneWechselwirkung(b);
                
                // Actio = Reactio: Spiegelverkehrter Kraftvektor zur CPU-Optimierung
                b.vx -= (a.vx * DT); 
                b.vy -= (a.vy * DT);
                b.vz -= (a.vz * DT);
            }
            
            // Analytik: Maximalenergie loggen
            double vQuadrat = a.vx*a.vx + a.vy*a.vy + a.vz*a.vz;
            if (vQuadrat > maxKinetischeEnergie) {
                maxKinetischeEnergie = vQuadrat;
            }
        }
        
        for (QuantenKugel kugel : universum) {
            kugel.bewege();
        }
        
        frameCount++;
        if (frameCount % 60 == 0) {
            System.out.println("Frame: " + frameCount + " | Max Kinetische Energie im System: " + String.format("%.2f", maxKinetischeEnergie));
        }
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2d = (Graphics2D) g;
        g2d.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        for (QuantenKugel kugel : universum) {
            double vQuadrat = kugel.vx*kugel.vx + kugel.vy*kugel.vy + kugel.vz*kugel.vz;
            int farbWert = Math.min(255, (int)(vQuadrat * 5));
            g2d.setColor(new Color(farbWert, 100, 255 - farbWert));
            
            // KORREKTUR: Zoom wird nur auf die Position gerechnet, NICHT auf den Graphics-Context
            int drawX = (int) ((kugel.x + cameraX) * zoomLevel + WIDTH / 2.0);
            int drawY = (int) ((kugel.y + cameraY) * zoomLevel + HEIGHT / 2.0);
            
            // Punkt bleibt IMMER 4x4 Pixel groß, egal wie tief der Zoom ist
            g2d.fillOval(drawX - 2, drawY - 2, 4, 4);
        }
    }

    @Override
    public void run() {
        while (true) {
            updatePhysik();
            repaint();
            try {
                Thread.sleep(16);
            } catch (InterruptedException e) {
                e.printStackTrace();
            }
        }
    }

    public static void main(String[] args) {
        JFrame frame = new JFrame("Matrixgame - Sub-Planck Zoom V2 (Feste Partikelgröße)");
        MatrixgameSimulator simulator = new MatrixgameSimulator();
        frame.add(simulator);
        frame.pack();
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setLocationRelativeTo(null);
        frame.setVisible(true);
        
        new Thread(simulator).start();
    }
}

