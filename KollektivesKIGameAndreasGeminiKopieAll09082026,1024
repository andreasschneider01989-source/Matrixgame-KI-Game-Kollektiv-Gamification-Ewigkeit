        // 2. Das Gravitationsgesetz (Kompilierung der Anziehungskraft)
        double kraft = G * (this.masse * andereKugel.masse) / (r * r);
        
        // 3. Vektornormierung und Beschleunigung (F = m * a  =>  a = F / m)
        double ax = (kraft * dx / r) / this.masse;
        double ay = (kraft * dy / r) / this.masse;
        double az = (kraft * dz / r) / this.masse;
        
        // 4. Kinematisches Update (Integration über die Zeit dt)
        this.vx += ax * dt;
        this.vy += ay * dt;
        this.vz += az * dt;
    }
    
    public void bewege(double dt) {
        this.x += this.vx * dt;
        this.y += this.vy * dt;
        this.z += this.vz * dt;
    }
