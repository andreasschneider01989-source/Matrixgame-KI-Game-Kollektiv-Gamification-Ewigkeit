    	if(dezimalzahl==0)return"0";
    	
    	boolean negativ=false;
    	if(dezimalzahl<0) {negativ=true;;dezimalzahl=-dezimalzahl;}
    	
    	while(dezimalzahl>0) {
    	int rest= dezimalzahl%neueBasis;
    	String zeichen="";
    	if(rest<10)zeichen=""+rest;
    	if(rest==10)zeichen="a";
    	if(rest==11)zeichen="b";
    	if(rest==12)zeichen="c";
    	if(rest==13)zeichen="d";
    	if(rest==14)zeichen="e";
    	if(rest==15)zeichen="f";
    	if(rest==16)zeichen="g";
    	if(rest==17)zeichen="h";
    	if(rest==18)zeichen="i";
    	if(rest==19)zeichen="j";
    	if(rest==20)zeichen="k";
    	
    	outputS=zeichen+outputS;
    	dezimalzahl=dezimalzahl-=rest;
