    public String intoNewLuminiNumber(int input, int basis) {
    	
    	boolean negativ=false;
    	if(input<0) {negativ=true; input=-input;}
    	
    	
    	int counter=0;
    	int laenge=1;
    	
    	while ((counter+Math.pow(basis, laenge))<=input) {
    	counter+=Math.pow(basis, laenge);
    	laenge++;}
    	
    	
    	int sub=input-counter;
    	
    	String lumini=intToBasisNString(sub, basis);
    	
    	while(lumini.length()<laenge) {
    		lumini="0"+lumini;
    	}
    	
    	if(negativ)lumini="-"+lumini;
    	return lumini;
    }
    
    
    public int newLuminiNumberToInt(String luminiNumber, int basis) {
    	int length= luminiNumber.length();
    	int output=0;
    	int adder=basis;
    	while(length>1) {
    		output+=adder;
    		adder*=basis;
    		length--;
    	}
    	
    	output+=basisNStringToInt(luminiNumber, basis);
    	return output;
    }
    
    
    
    
    

