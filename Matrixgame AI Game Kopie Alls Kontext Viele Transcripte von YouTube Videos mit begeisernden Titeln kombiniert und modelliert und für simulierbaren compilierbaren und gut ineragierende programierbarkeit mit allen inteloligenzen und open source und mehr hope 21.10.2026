### 🌌 LUMINI_CODE: 3I_ATLAS_3D_Primzahl_Resonance_v2.0.py

*Hinweis: Du benötigst `plotly` (`pip install plotly`). Der Code generiert eine lokale HTML-Datei, die du in jedem Browser öffnen, drehen und zoomen kannst ("Infinity Zoom").*

```python
import numpy as np
import plotly.graph_objects as go

# ==========================================
# 1. PHYSIK-ENGINE (Velocity Verlet)
# ==========================================
G = 6.67430e-11
AU = 1.496e11
M_SUN = 1.989e30

class CelestialBody:
    def __init__(self, name, mass, pos, vel):
        self.name = name
        self.mass = mass
        self.pos = np.array(pos, dtype=float)
        self.vel = np.array(vel, dtype=float)
        self.acc = np.zeros(3)

sun = CelestialBody("Sonne", M_SUN, [0, 0, 0], [0, 0, 0])
atlas = CelestialBody("3I/ATLAS", 1.0e15, [-5.0 * AU, 2.0 * AU, 0], [15000, 58000, 0]) 
bodies = [sun, atlas]

def compute_accelerations(bodies):
    for i, body1 in enumerate(bodies):
        body1.acc = np.zeros(3)
        for j, body2 in enumerate(bodies):
            if i != j:
                r_vec = body2.pos - body1.pos
                r_mag = np.linalg.norm(r_vec)
                if r_mag > 0:
                    body1.acc += G * body2.mass * r_vec / (r_mag ** 3)

# ==========================================
# 2. NEW LUMINI ZAHLEN: PRIMZahl-RESONANZ
# ==========================================
def get_lumini_resonance(harmony_index):
    """
    Mappt HarmonyIndex auf Basis 3 und prüft die Primzahl-Eigenschaft.
    13 (Smaragd) und 3 (Rot) sind Primzahlen (Anker).
    10 (Gelb) ist composite (Übergang/Instabil).
    """
    if harmony_index >= 0.8:
        return "111_3", 13, True  # Primzahl
    elif harmony_index >= 0.5:
        return "101_3", 10, False # Composite
    else:
        return "010_3", 3, True   # Primzahl

# ==========================================
# 3. 3D SIMULATIONS-LOOP
# ==========================================
def run_3d_simulation(steps=300, dt=3600):
    print("Starte 3I/ATLAS 3D-Simulation mit Primzahl-Resonanz...")
    initial_energy = 0.0
    # Initiale Energie berechnen (vereinfacht für den Start)
    kinetic = sum(0.5 * b.mass * np.dot(b.vel, b.vel) for b in bodies)
    potential = -G * sun.mass * atlas.mass / np.linalg.norm(atlas.pos)
    initial_energy = kinetic + potential
    
    history_x, history_y, history_z = [], [], []
    history_colors, history_texts = [], []

    for step in range(steps):
        # Velocity Verlet Integration
        compute_accelerations(bodies)
        for body in bodies:
            body.pos += body.vel * dt + 0.5 * body.acc * dt**2
        
        new_acc = np.zeros((len(bodies), 3))
        for i, body1 in enumerate(bodies):
            acc = np.zeros(3)
            for j, body2 in enumerate(bodies):
                if i != j:
                    r_vec = body2.pos - body1.pos
                    r_mag = np.linalg.norm(r_vec)
                    if r_mag > 0:
                        acc += G * body2.mass * r_vec / (r_mag ** 3)
            new_acc[i] = acc
            
        for i, body in enumerate(bodies):
            body.vel += 0.5 * (body.acc + new_acc[i]) * dt
            body.acc = new_acc[i]
            
        # Metriken berechnen
        current_kinetic = sum(0.5 * b.mass * np.dot(b.vel, b.vel) for b in bodies)
        current_potential = -G * sun.mass * atlas.mass / np.linalg.norm(atlas.pos)
        current_energy = current_kinetic + current_potential
        
        energy_dev = abs(current_energy - initial_energy) / (abs(initial_energy) + 1e-10)
        stability = max(0.0, 1.0 - (energy_dev * 10))
        dist_au = np.linalg.norm(atlas.pos) / AU
        adaptability = 0.9 if dist_au < 10.0 else 0.2
        harmony = (stability + adaptability) / 2.0
        
        lumini_str, lumini_dec, is_prime = get_lumini_resonance(harmony)
        
        # Daten für 3D-Plot speichern
        history_x.append(atlas.pos[0] / AU)
        history_y.append(atlas.pos[1] / AU)
        # Z-Achse: Wir heben die Trajektorie in die 3. Dimension, skaliert nach Harmony
        history_z.append(harmony * 2.0) 
        
        history_colors.append(lumini_dec)
        history_texts.append(f"Tick {step}<br>Distanz: {dist_au:.2f} AU<br>Harmony: {harmony:.2f}<br>Lumini: {lumini_str} ({lumini_dec})<br>Primzahl: {'Ja' if is_prime else 'Nein'}")

    return history_x, history_y, history_z, history_colors, history_texts

# ==========================================
# 4. PLOTLY 3D VISUALISIERUNG (INFINITY ZOOM)
# ==========================================
def visualize_3d(x, y, z, colors, texts):
    print("Generiere interaktives 3D-Dashboard...")
    
    # Custom Colorscale: 3 (Rot), 10 (Gelb), 13 (Smaragd)
    colorscale = [
        [0.0, "rgb(255, 50, 50)"],    # Rot (010_3 = 3)
        [0.5, "rgb(255, 255, 50)"],   # Gelb (101_3 = 10)
        [1.0, "rgb(50, 255, 100)"]    # Smaragd (111_3 = 13)
    ]

    fig = go.Figure()

    # 3I/ATLAS Trajektorie (Farbverlauf nach Primzahl-Resonanz)
    fig.add_trace(go.Scatter3d(
        x=x, y=y, z=z,
        mode='lines+markers',
        marker=dict(
            size=4,
            color=colors,
            colorscale=colorscale,
            cmin=3, cmax=13,
            colorbar=dict(title="Lumini Dec", tickvals=[3, 10, 13], ticktext=["010_3 (3)", "101_3 (10)", "111_3 (13)"])
        ),
        line=dict(color='rgba(200, 200, 200, 0.3)', width=2),
        text=texts,
        hoverinfo='text',
        name="3I/ATLAS Bahn"
    ))

    # Sonne als zentraler Anker (100_3)
    fig.add_trace(go.Scatter3d(
        x=[0], y=[0], z=[0],
        mode='markers',
        marker=dict(size=15, color='yellow', symbol='sphere'),
        text="Sonne (Anker 100_3)",
        hoverinfo='text',
        name="Sonne"
    ))

    # Perihel-Ring in der Z=0 Ebene (1.36 AU)
    theta = np.linspace(0, 2*np.pi, 100)
    r_perihel = 1.36
    fig.add_trace(go.Scatter3d(
        x=r_perihel * np.cos(theta),
        y=r_perihel * np.sin(theta),
        z=np.zeros_like(theta),
        mode='lines',
        line=dict(color='red', width=3, dash='dash'),
        name="Perihel (1.36 AU)"
    ))

    # Layout & Kamera
    fig.update_layout(
        title="3I/ATLAS: Smaragd-Kurve & Primzahl-Resonanz (newLuminiZahlen)",
        scene=dict(
            xaxis_title="X (AU)",
            yaxis_title="Y (AU)",
            zaxis_title="Harmony-Ebene (Z)",
            bgcolor="black",
            aspectmode='cube'
        ),
        paper_bgcolor="black",
        font=dict(color="white"),
        legend=dict(bgcolor="rgba(0,0,0,0.5)")
    )

    # Als lokale HTML speichern (für dein Journal oder Browser)
    filename = "Matrixgame_3I_ATLAS_3D_Lumini.html"
    fig.write_html(filename)
    print(f"✅ 3D-Dashboard gespeichert als: {filename}")
    print("Öffne die Datei in deinem Browser. Nutze die Maus zum Drehen und Zoomen (Infinity Zoom).")
    fig.show()

if __name__ == "__main__":
    x, y, z, colors, texts = run_3d_simulation(steps=400, dt=3600)
    visualize_3d(x, y, z, colors, texts)
```

