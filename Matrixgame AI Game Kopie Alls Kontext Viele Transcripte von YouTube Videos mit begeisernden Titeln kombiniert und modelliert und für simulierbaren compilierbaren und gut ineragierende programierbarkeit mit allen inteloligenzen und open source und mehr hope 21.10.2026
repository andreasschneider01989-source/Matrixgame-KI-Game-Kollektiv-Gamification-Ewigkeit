### 🌌 LUMINI_CODE: 3I_ATLAS_Stewardship_Simulator_v1.0.py

import numpy as np

# ==========================================
# 1. KONSTANTEN & INITIALISIERUNG (3I/ATLAS)
# ==========================================
G = 6.67430e-11  # Gravitationskonstante
AU = 1.496e11    # Astronomische Einheit in Metern
M_SUN = 1.989e30 # Sonnenmasse in kg

class CelestialBody:
    def __init__(self, name, mass, pos, vel):
        self.name = name
        self.mass = mass
        self.pos = np.array(pos, dtype=float)
        self.vel = np.array(vel, dtype=float)
        self.acc = np.zeros(3)

# Initialisierung: Sonne (Zentrum) und 3I/ATLAS (hyperbolische Bahn)
# Annahme: Annäherung aus dem negativen X-Bereich, Perihel bei ~1.36 AU
sun = CelestialBody("Sonne", M_SUN, [0, 0, 0], [0, 0, 0])
# 3I/ATLAS: Masse (fiktiv erhöht für What-If-Szenario, z.B. 10x Asteroidenmasse), 
# Startposition weit entfernt, Geschwindigkeit ~58 km/s relativ zur Sonne
atlas = CelestialBody("3I/ATLAS", 1.0e15, [-5.0 * AU, 2.0 * AU, 0], [15000, 58000, 0]) 

bodies = [sun, atlas]

# ==========================================
# 2. PHYSIK-ENGINE: VELOCITY VERLET (Memory #24)
# ==========================================
def compute_accelerations(bodies):
    for i, body1 in enumerate(bodies):
        body1.acc = np.zeros(3)
        for j, body2 in enumerate(bodies):
            if i != j:
                r_vec = body2.pos - body1.pos
                r_mag = np.linalg.norm(r_vec)
                if r_mag > 0:
                    body1.acc += G * body2.mass * r_vec / (r_mag ** 3)

def compute_total_energy(bodies):
    kinetic = 0.0
    potential = 0.0
    for i, body1 in enumerate(bodies):
        kinetic += 0.5 * body1.mass * np.dot(body1.vel, body1.vel)
        for j, body2 in enumerate(bodies):
            if i < j:
                r_mag = np.linalg.norm(body2.pos - body1.pos)
                if r_mag > 0:
                    potential -= G * body1.mass * body2.mass / r_mag
    return kinetic + potential

# ==========================================
# 3. STEWARDSHIP-METRIC: HARMONY INDEX
# ==========================================
def calculate_harmony_index(initial_energy, current_energy, time_step):
    """
    Der HarmonyIndex bewertet, ob das System stabil bleibt (Smaragd-Kurve) 
    oder in chaotische Zerstörung/Ejektion kippt (Rote Kurve).
    """
    # 1. Energieerhaltung als Basis für Stabilität (S)
    energy_deviation = abs(current_energy - initial_energy) / (abs(initial_energy) + 1e-10)
    stability_score = max(0.0, 1.0 - (energy_deviation * 10)) # Strafe für große Abweichungen
    
    # 2. Distanz-Check: Verlässt das Objekt das System chaotisch? (A)
    dist = np.linalg.norm(atlas.pos)
    if dist > 10.0 * AU:
        adaptability_score = 0.2 # Chaotische Ejektion
    else:
        adaptability_score = 0.9 # Stabile Passage oder Resonanz
        
    # HarmonyIndex = Durchschnitt aus Stabilität und Adaptabilität
    harmony = (stability_score + adaptability_score) / 2.0
    return harmony

# ==========================================
# 4. OXFORD BIFURCATION NAVIGATOR (Integration)
# ==========================================
class HogenMetric:
    def __init__(self, s, a, k, j):
        self.S, self.A, self.K, self.J = s, a, k, j

def evaluate_simulation_step(harmony_index):
    print("\n--- MATRIXGAME STEWARDSHIP-ANALYSE ---")
    if harmony_index < 0.4:
        metric = HogenMetric(0.2, 0.3, 0.4, 0.1)
        rho = 0.8 # Hoher Widerstand durch Chaos/Instabilität
        action = "WARNUNG: Chaotische Divergenz erkannt. Aktiviere Korrekturmanöver oder reduziere Masse-Parameter."
    else:
        metric = HogenMetric(0.95, 0.9, 0.85, 0.9)
        rho = 0.1 # Niedriger Widerstand, optimale Balance
        action = "BESTÄTIGT: Smaragd-Kurve aktiv. System zeigt stabile Resonanz und Erhaltung der Struktur."
    
    phi_score = (metric.S * metric.A * metric.K * metric.J) / (1 + rho)
    print(f"HarmonyIndex     : {harmony_index:.3f}")
    print(f"Phi-Score        : {phi_score:.3f} (Widerstand rho={rho:.1f})")
    print(f"Lumini-Aktion    : {action}")
    print(f"Hashtag-Spur     : #Lumini #Qwen #3I_ATLAS #StewardshipMetric #LokaleKI")

# ==========================================
# 5. SIMULATIONS-LOOP (Didaktischer Testlauf)
# ==========================================
def run_simulation(steps=100, dt=3600): # dt = 1 Stunde in Sekunden
    print("Starte 3I/ATLAS N-Body-Simulation mit Velocity-Verlet & HarmonyIndex...")
    initial_energy = compute_total_energy(bodies)
    
    for step in range(steps):
        # Velocity Verlet Integration
        compute_accelerations(bodies)
        for body in bodies:
            body.pos += body.vel * dt + 0.5 * body.acc * dt**2
        
        new_acc = np.zeros((len(bodies), 3))
        for i, body1 in enumerate(bodies):
            acc = np.zeros(3)
            for j, body2 in enumerate(bodies):
                if i != j:
                    r_vec = body2.pos - body1.pos
                    r_mag = np.linalg.norm(r_vec)
                    if r_mag > 0:
                        acc += G * body2.mass * r_vec / (r_mag ** 3)
            new_acc[i] = acc
            
        for i, body in enumerate(bodies):
            body.vel += 0.5 * (body.acc + new_acc[i]) * dt
            body.acc = new_acc[i]
            
        # Alle 20 Schritte Stewardship-Check
        if step % 20 == 0:
            current_energy = compute_total_energy(bodies)
            harmony = calculate_harmony_index(initial_energy, current_energy, step * dt)
            dist_au = np.linalg.norm(atlas.pos) / AU
            print(f"\n[Tick {step}] Distanz: {dist_au:.2f} AU")
            evaluate_simulation_step(harmony)

# Starte den Test
if __name__ == "__main__":
    run_simulation(steps=100, dt=3600)


