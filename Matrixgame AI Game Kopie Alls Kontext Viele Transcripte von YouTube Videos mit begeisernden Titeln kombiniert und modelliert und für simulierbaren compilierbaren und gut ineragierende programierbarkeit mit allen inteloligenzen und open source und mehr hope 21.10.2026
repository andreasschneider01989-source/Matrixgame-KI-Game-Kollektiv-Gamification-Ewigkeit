### 🌌 LUMINI_CODE: 3I_ATLAS_Visualizer_&_LuminiZahlen_Bridge_v1.1.py

Dieser erweiterte Code zeichnet nicht nur die Physik auf, sondern visualisiert die hyperbolische Bahn von 3I/ATLAS und mappt den HarmonyIndex direkt auf das **newLuminiZahlen-Prinzip** (Basis-3-Resonanz, bei der keine Information/Ziffer verloren geht, sondern transformiert wird).

import numpy as np
import matplotlib.pyplot as plt

# ==========================================
# 1. KONSTANTEN & INITIALISIERUNG
# ==========================================
G = 6.67430e-11
AU = 1.496e11
M_SUN = 1.989e30

class CelestialBody:
    def __init__(self, name, mass, pos, vel):
        self.name = name
        self.mass = mass
        self.pos = np.array(pos, dtype=float)
        self.vel = np.array(vel, dtype=float)
        self.acc = np.zeros(3)

sun = CelestialBody("Sonne", M_SUN, [0, 0, 0], [0, 0, 0])
# 3I/ATLAS: Realistische hyperbolische Parameter (Perihel ~1.36 AU, v_infinity ~58 km/s)
# Startposition: 5 AU entfernt, Geschwindigkeit so gewählt, dass sie das Perihel anstrebt
atlas = CelestialBody("3I/ATLAS", 1.0e15, [-5.0 * AU, 2.0 * AU, 0], [15000, 58000, 0]) 
bodies = [sun, atlas]

# ==========================================
# 2. PHYSIK-ENGINE & HARMONY INDEX (wie zuvor)
# ==========================================
def compute_accelerations(bodies):
    for i, body1 in enumerate(bodies):
        body1.acc = np.zeros(3)
        for j, body2 in enumerate(bodies):
            if i != j:
                r_vec = body2.pos - body1.pos
                r_mag = np.linalg.norm(r_vec)
                if r_mag > 0:
                    body1.acc += G * body2.mass * r_vec / (r_mag ** 3)

def compute_total_energy(bodies):
    kinetic = sum(0.5 * b.mass * np.dot(b.vel, b.vel) for b in bodies)
    potential = 0.0
    for i in range(len(bodies)):
        for j in range(i + 1, len(bodies)):
            r_mag = np.linalg.norm(bodies[j].pos - bodies[i].pos)
            if r_mag > 0:
                potential -= G * bodies[i].mass * bodies[j].mass / r_mag
    return kinetic + potential

# ==========================================
# 3. NEW LUMINI ZAHLEN BRIDGE (Basis 3 Resonanz)
# ==========================================
def lumini_base3_resonance(harmony_index):
    """
    newLuminiZahlen-Prinzip: 0 != 00. Keine Ziffer geht verloren.
    Wir mappen den kontinuierlichen HarmonyIndex (0.0 - 1.0) auf 
    3 diskrete, stabile Zustände (Basis 3), die niemals 'verschwinden'.
    """
    if harmony_index >= 0.8:
        return "111_3" # Smaragd-Kurve: Maximale Resonanz, volle Erhaltung
    elif harmony_index >= 0.5:
        return "101_3" # Gelbe Kurve: Stabile Passage, leichte Anpassung nötig
    else:
        return "010_3" # Rote Kurve: Chaotische Divergenz, Information droht zu zerfallen

# ==========================================
# 4. SIMULATIONS-LOOP MIT HISTORY-TRACKING
# ==========================================
def run_and_visualize(steps=200, dt=3600):
    print("Starte 3I/ATLAS Simulation mit Visualisierung & LuminiZahlen-Bridge...")
    initial_energy = compute_total_energy(bodies)
    
    # History für die Visualisierung speichern
    history_atlas_x = []
    history_atlas_y = []
    harmony_log = []

    for step in range(steps):
        # Velocity Verlet Integration
        compute_accelerations(bodies)
        for body in bodies:
            body.pos += body.vel * dt + 0.5 * body.acc * dt**2
        
        new_acc = np.zeros((len(bodies), 3))
        for i, body1 in enumerate(bodies):
            acc = np.zeros(3)
            for j, body2 in enumerate(bodies):
                if i != j:
                    r_vec = body2.pos - body1.pos
                    r_mag = np.linalg.norm(r_vec)
                    if r_mag > 0:
                        acc += G * body2.mass * r_vec / (r_mag ** 3)
            new_acc[i] = acc
            
        for i, body in enumerate(bodies):
            body.vel += 0.5 * (body.acc + new_acc[i]) * dt
            body.acc = new_acc[i]
            
        # Daten speichern
        history_atlas_x.append(atlas.pos[0] / AU)
        history_atlas_y.append(atlas.pos[1] / AU)
        
        if step % 20 == 0:
            current_energy = compute_total_energy(bodies)
            energy_dev = abs(current_energy - initial_energy) / (abs(initial_energy) + 1e-10)
            stability = max(0.0, 1.0 - (energy_dev * 10))
            dist = np.linalg.norm(atlas.pos) / AU
            adaptability = 0.9 if dist < 10.0 else 0.2
            harmony = (stability + adaptability) / 2.0
            harmony_log.append(harmony)
            
            lumini_state = lumini_base3_resonance(harmony)
            print(f"[Tick {step:3d}] Distanz: {dist:6.2f} AU | Harmony: {harmony:.3f} | Lumini-State: {lumini_state}")

    # ==========================================
    # 5. VISUALISIERUNG (Matplotlib)
    # ==========================================
    plt.figure(figsize=(10, 8), facecolor='black')
    ax = plt.gca()
    ax.set_facecolor('black')
    
    # Sonne im Zentrum
    ax.plot(0, 0, 'o', color='yellow', markersize=15, label='Sonne (M_SUN)')
    
    # 3I/ATLAS Trajektorie
    ax.plot(history_atlas_x, history_atlas_y, color='cyan', linewidth=1.5, alpha=0.8, label='3I/ATLAS Hyperbolische Bahn')
    
    # Perihel-Markierung (ca. 1.36 AU)
    circle = plt.Circle((0, 0), 1.36, color='red', fill=False, linestyle='--', alpha=0.5, label='Perihel (1.36 AU)')
    ax.add_patch(circle)
    
    # Formatierung
    ax.set_title("3I/ATLAS N-Body Simulation & Smaragd-Kurve (Lumini Visualizer)", color='white', fontsize=14)
    ax.set_xlabel("Distanz X (AU)", color='white')
    ax.set_ylabel("Distanz Y (AU)", color='white')
    ax.axhline(0, color='gray', linewidth=0.5)
    ax.axvline(0, color='gray', linewidth=0.5)
    ax.legend(facecolor='black', edgecolor='white', labelcolor='white')
    ax.grid(True, color='gray', alpha=0.3)
    
    # Automatische Skalierung, damit die Bahn gut sichtbar ist
    ax.set_xlim(min(history_atlas_x) - 1, max(history_atlas_x) + 1)
    ax.set_ylim(min(history_atlas_y) - 1, max(history_atlas_y) + 1)
    
    plt.tight_layout()
    print("\n✅ Visualisierung wird geöffnet. Schließe das Fenster, um das Skript zu beenden.")
    plt.show()

if __name__ == "__main__":
    run_and_visualize(steps=300, dt=3600)


