from pathlib import Path

code = r'''"""
Matrixgame / Lumini: 3I/ATLAS – 3D-Bahn, JSON-Bridge und Lumini-String
Wissenschaftliche Einordnung:
- Idealisiertes Sonne-Objekt-Zweikörpermodell, Sonne fest im Ursprung.
- Hyperbelparameter q=1.36 AU, e=6.14 sind Modellwerte; bitte mit aktuellen
  Ephemeriden/Orbitdaten abgleichen, bevor dies als reale Bahn verwendet wird.
- HarmonyIndex und Lumini-Codierung sind Spielmetriken, keine physikalischen Messgrößen.
Installation: pip install numpy plotly
Start: python lumini_3i_atlas_bridge.py
"""

from __future__ import annotations
import json
from pathlib import Path
import numpy as np

G = 6.67430e-11
AU = 1.495978707e11
M_SUN = 1.98847e30
MU = G * M_SUN

Q_AU = 1.36
ECCENTRICITY = 6.14
DT_DAYS = 0.25
SPAN_DAYS = 400.0
OUT_JSON = "Matrixgame_3I_ATLAS_Lumini.json"
OUT_HTML = "Matrixgame_3I_ATLAS_3D_Lumini.html"


def acceleration(r_m: np.ndarray) -> np.ndarray:
    """Sonnenbeschleunigung im idealisierten Zweikörpermodell."""
    radius = np.linalg.norm(r_m)
    if radius == 0:
        raise ValueError("Position darf nicht im Sonnenzentrum liegen.")
    return -MU * r_m / radius**3


def integrate_branch(r0: np.ndarray, v0: np.ndarray, dt: float, steps: int):
    """Velocity-Verlet für eine Zeitrichtung; dt darf negativ sein."""
    r = r0.astype(float).copy()
    v = v0.astype(float).copy()
    a = acceleration(r)
    rows = []
    for i in range(steps + 1):
        radius = np.linalg.norm(r)
        speed2 = float(np.dot(v, v))
        specific_energy = 0.5 * speed2 - MU / radius
        rows.append((i * dt, *r, *v, radius, specific_energy))
        if i == steps:
            break
        r_next = r + v * dt + 0.5 * a * dt**2
        a_next = acceleration(r_next)
        v_next = v + 0.5 * (a + a_next) * dt
        r, v, a = r_next, v_next, a_next
    return rows


def lumini_state(harmony: float):
    """Didaktische Schwellen-Codierung; keine Aussage über Naturgesetze."""
    if harmony >= 0.8:
        return {"ternary": "111", "decimal": 13, "is_prime": True, "label": "Smaragd"}
    if harmony >= 0.5:
        return {"ternary": "101", "decimal": 10, "is_prime": False, "label": "Übergang"}
    return {"ternary": "010", "decimal": 3, "is_prime": True, "label": "Rot"}


def build_data():
    q = Q_AU * AU
    # Geschwindigkeit im Perihel einer Hyperbel: vp = sqrt(mu*(1+e)/q)
    vp = np.sqrt(MU * (1.0 + ECCENTRICITY) / q)
    r0 = np.array([q, 0.0, 0.0])
    v0 = np.array([0.0, vp, 0.0])

    dt = DT_DAYS * 86400.0
    steps = int(SPAN_DAYS / DT_DAYS)
    backward = integrate_branch(r0, v0, -dt, steps)
    forward = integrate_branch(r0, v0, dt, steps)
    # Rückwärtszweig umdrehen und Perihel nicht doppelt aufnehmen
    rows = list(reversed(backward[1:])) + forward

    e0 = rows[len(backward)-1][-1]
    output = []
    for idx, row in enumerate(rows):
        t, x, y, z, vx, vy, vz, radius, energy = row
        distance_au = radius / AU
        relative_energy_error = abs(energy - e0) / max(abs(e0), 1e-30)
        numerical_integrity = max(0.0, 1.0 - min(relative_energy_error * 1000.0, 1.0))
        # Transparente, frei gewählte Spielmetrik: näher am Perihel = höherer Umweltfaktor.
        proximity_score = 1.0 / (1.0 + max(distance_au - Q_AU, 0.0) / 5.0)
        harmony = float(np.clip(0.5 * numerical_integrity + 0.5 * proximity_score, 0.0, 1.0))
        state = lumini_state(harmony)
        output.append({
            "time_days_from_perihelion": round(t / 86400.0, 4),
            "x_au": float(x / AU), "y_au": float(y / AU), "z_au": float(z / AU),
            "distance_au": float(distance_au),
            "speed_km_s": float(np.sqrt(vx*vx + vy*vy + vz*vz) / 1000.0),
            "specific_energy_j_kg": float(energy),
            "relative_energy_error": float(relative_energy_error),
            "harmony_index_model": harmony,
            "lumini": state
        })
    return output, vp / 1000.0


def write_json(rows, perihelion_speed):
    payload = {
        "title": "Matrixgame 3I/ATLAS Lumini Bridge",
        "model": "idealized Sun-object two-body hyperbola; Sun fixed at origin",
        "assumptions": {
            "perihelion_distance_au": Q_AU,
            "eccentricity": ECCENTRICITY,
            "perihelion_speed_km_s": perihelion_speed,
            "time_span_days_each_side": SPAN_DAYS,
            "time_step_days": DT_DAYS,
            "harmony_index": "illustrative game metric, not a physical observable",
            "lumini_encoding": "threshold-based base-3 labels; not evidence of cosmic resonance"
        },
        "trajectory": rows,
        "lumini_string": "".join(str(item["lumini"]["decimal"]) + "-" for item in rows).rstrip("-")
    }
    Path(OUT_JSON).write_text(json.dumps(payload, indent=2), encoding="utf-8")
    return payload


def write_plot(rows):
    try:
        import plotly.graph_objects as go
    except ImportError:
        print("Plotly fehlt. Installiere es mit: pip install plotly")
        return

    x = [r["x_au"] for r in rows]
    y = [r["y_au"] for r in rows]
    z = [r["harmony_index_model"] * 2.0 for r in rows]
    colors = [r["lumini"]["decimal"] for r in rows]
    hover = [
        f"t = {r['time_days_from_perihelion']:.1f} Tage<br>"
        f"Distanz = {r['distance_au']:.3f} AU<br>"
        f"Tempo = {r['speed_km_s']:.2f} km/s<br>"
        f"HarmonyIndex (Spielmetrik) = {r['harmony_index_model']:.3f}<br>"
        f"Lumini = {r['lumini']['ternary']}_3 = {r['lumini']['decimal']}<br>"
        f"Primzahl: {'Ja' if r['lumini']['is_prime'] else 'Nein'}"
        for r in rows
    ]

    fig = go.Figure()
    fig.add_trace(go.Scatter3d(
        x=x, y=y, z=z, mode="lines+markers",
        marker=dict(size=2, color=colors, colorscale=[
            [0.0, "rgb(255,70,70)"], [0.5, "rgb(255,220,60)"],
            [1.0, "rgb(50,220,130)"]],
            cmin=3, cmax=13,
            colorbar=dict(title="Lumini-Zahl", tickvals=[3, 10, 13],
                          ticktext=["010₃ = 3", "101₃ = 10", "111₃ = 13"])),
        line=dict(color="rgba(190,190,190,0.45)", width=3),
        text=hover, hoverinfo="text", name="Modellbahn"
    ))
    theta = np.linspace(0, 2*np.pi, 160)
    fig.add_trace(go.Scatter3d(
        x=Q_AU*np.cos(theta), y=Q_AU*np.sin(theta), z=np.zeros_like(theta),
        mode="lines", line=dict(color="red", width=4, dash="dash"),
        name=f"Perihel-Abstand {Q_AU:.2f} AU"
    ))
    fig.add_trace(go.Scatter3d(
        x=[0], y=[0], z=[0], mode="markers",
        marker=dict(size=7, color="gold"), name="Sonne"
    ))
    fig.update_layout(
        title="3I/ATLAS – Modellbahn + Lumini-Spielmetrik",
        scene=dict(xaxis_title="X (AU)", yaxis_title="Y (AU)",
                   zaxis_title="HarmonyIndex × 2 (Spielachse)",
                   aspectmode="data"),
        template="plotly_dark"
    )
    fig.write_html(OUT_HTML, include_plotlyjs=True)
    print(f"3D-Dashboard: {Path(OUT_HTML).resolve()}")


def main():
    rows, vp = build_data()
    payload = write_json(rows, vp)
    write_plot(rows)
    print(f"JSON-Bridge: {Path(OUT_JSON).resolve()}")
    print(f"Modellierte Perihelgeschwindigkeit: {vp:.2f} km/s")
    print(f"Datensätze: {len(rows)}")
    print(f"Lumini-String (erste 20 Zustände): {'-'.join(str(r['lumini']['decimal']) for r in rows[:20])}")
    print("Hinweis: Spielmetrik und Lumini-String sind symbolische Ausgaben, keine astronomischen Messwerte.")


if __name__ == "__main__":
    main()
'''
path = Path("/mnt/data/lumini_3i_atlas_bridge.py")
path.write_text(code, encoding="utf-8")
